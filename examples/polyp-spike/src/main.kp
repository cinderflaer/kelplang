// A GTK4 window built entirely out of FFI bindings: opaque handles for the
// GObjects, `str` for the C strings, and one Kelp closure as the button's
// click handler. Compile-only: there is no display here, and the point is that
// the binary links.
//
// `ui` is the display domain (gap 6); a GTK call names no display argument, so
// the grant is the wildcard and nothing narrower is accepted
// (kelp wiki page libraries/polyp.md).
impl "gtk" caps(ui = ["*"])
impl "std/str"

fun main() {
    val app = gtk.gtk_application_new("dev.xenoo.polyp_spike", 0)
    val window = gtk.gtk_application_window_new(app)
    gtk.gtk_window_set_title(window, "polyp-spike")

    // An owned capture, so the closure really carries an environment: the
    // native side owns it from the call below until GTK runs the destroy
    // notify, which is the closure's drop.
    val tag: String = "polyp-spike: button clicked"
    val on_click = fun (b: gtk.Widget) {
        print(str.len(tag))
    }

    val button = gtk.gtk_button_new_with_label("Click")
    gtk.connect(button, "clicked", on_click, 0)
    gtk.gtk_window_set_child(window, button)
    gtk.gtk_window_present(window)

    // argv[0] is the program name and argv[1] is the NULL g_strsplit writes.
    val argv = gtk.g_strsplit("polyp-spike", " ", -1)

    // A null handle is the default GLib main context, which is what a null
    // `GMainContext*` argument means. The wrapper spells it because the handle
    // operation is legal only in the `[extern.*]` module.
    gtk.g_main_context_iteration(gtk.null_main_context(), 0)

    val status = gtk.g_application_run(app, 1, argv)

    gtk.g_strfreev(argv)
    gtk.g_object_unref(button)
    gtk.g_object_unref(app)
    print(status)
}
