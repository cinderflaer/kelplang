// A todo list on keyed rows, over Polyp v3.
//
// The program itself is `app.kp`: the model, the view, the update and the scripted input the smoke
// run drives it with. This file is only the GTK side: it opens the window, installs the stylesheet,
// arms the script and prints the summary `examples/polyp-todo/smoke.sh` reads. The same `app.kp` is
// run on the headless backend by `examples/polyp-core-test`, which is how the two backends are
// compared.
//
// `src/deps/polyp/` is a link to examples/polyp/ in this repository; a real consumer copies the
// library there. See examples/polyp/README.md.
impl "deps/polyp/core"
impl "deps/polyp/lib" caps(ui = ["*"])
impl "app"
impl "std/env"
impl "std/str"

fun smoke_enabled().R: bool {
    val value = env.get("POLYP_SMOKE")
    return str.eq(value.as_str(), "1")
}

// The stylesheet is the only styling hook, and `todo-done` is the class the view puts on a
// completed row.
fun install_css() {
    polyp.css(".todo-app { padding: 2px; }\n.todo-done { color: #6b7280; }\n.todo-pending { color: #111827; }\n")
}

// With POLYP_SMOKE=1 the program drives itself on the schedule `app.script` lists.
fun arm_smoke() {
    var steps = app.script()
    var i: usize = 0
    while i < steps.len() {
        val step = steps.get(i)
        polyp.schedule(delay_ms = step.delay_ms, event = core.clone_event(step.event))
        i += 1
    }
}

// The report's sink: the GTK program prints each line the way the smoke script reads it.
fun say(line: str) {
    print(line)
}

fun main() {
    if smoke_enabled() {
        arm_smoke()
    }
    install_css()
    val final = polyp.run(
        title = "polyp todo",
        width = 420,
        height = 360,
        init = app.initial(),
        view = app.view,
        update = app.update,
    )
    val entry = polyp.entry_text(0)
    app.report(final, entry.as_str(), say)
}
