// A todo list on keyed rows, over Polyp v2.
//
// Three things v2 makes possible and this example shows: every row is one
// keyed child of the scrolled list, so ticking a row updates its checkbox and
// removing one row leaves the widgets of the others untouched; the entry keeps
// the focus and the text the user typed across every patch; and the whole list
// ends in a counted state the smoke test reads line by line.
//
// The key is the item's own id, never its position: that is what makes a row
// the same row after a move or a removal above it, which is exactly what
// reconciliation by key means. A key derived from the index would hand one
// row's widgets to its neighbour.
//
// `src/deps/polyp/` is a link to examples/polyp/ in this repository; a real
// consumer copies the library there. See examples/polyp/README.md.
impl "deps/polyp/lib" caps(ui = ["*"])
impl "std/env"
impl "std/fmt"
impl "std/str"

datac Todo(val id: i32, val title: String, var done: bool)

// `marks` records `polyp.stats().created` after each action, which is the smoke
// test's evidence that adding, ticking, moving and removing reuse widgets
// rather than rebuild the list. It is a diagnostic field, not application
// state, and it is the only reason the model carries more than the list.
datac Model(
    var draft: String,
    var items: List<Todo>,
    var next_id: i32,
    var marks: List<i32>,
)

// Every action names an item by id, not by position, for the same reason the
// view keys by id.
enum Msg {
    Changed(val text: String)
    Add
    Toggle(val id: i32)
    MoveUp(val id: i32)
    Remove(val id: i32)
}

// The constructor the entry's `on_change` is: a top-level `fun`, so nothing is
// captured and the type is exactly `fun(String).R: Msg`.
fun changed(text: String).R: Msg = Msg.Changed(text = String.from_str(text.as_str()))

fun find_index(s: Model, id: i32).R: i32 {
    var i: usize = 0
    while i < s.items.len() {
        if s.items.get(i).id == id {
            return i.to_i32()
        }
        i += 1
    }
    return -1
}

fun done_count(s: Model).R: i32 {
    var n: i32 = 0
    var i: usize = 0
    while i < s.items.len() {
        if s.items.get(i).done {
            n += 1
        }
        i += 1
    }
    return n
}

fun fraction(s: Model).R: f64 {
    val total = s.items.len()
    if total == 0 {
        return 0.0
    }
    return done_count(s).to_f64() / total.to_f64()
}

// One keyed row per item: the checkbox, the title and the two buttons are the
// row's children, and the key is the item's id. The class depends on the
// item's state, which is the one thing CSS here is used for.
fun view(s: Model).R: polyp.Node<Msg> {
    return polyp.column { k ->
        k.spacing(8)
        k.margin(12)
        k.class("todo-app")
        k.row { r ->
            r.spacing(6)
            r.expand()
            r.entry(s.draft.as_str(), changed)
            r.button("add", Msg.Add)
        }
        k.separator()
        k.expand()
        k.scrolled { sc ->
            sc.spacing(4)
            sc.margin(4)
            var i: usize = 0
            while i < s.items.len() {
                val item = s.items.get(i)
                val key = fmt.int(item.id.to_i64())
                if item.done {
                    sc.class("todo-done")
                } else {
                    sc.class("todo-pending")
                }
                sc.keyed(key.as_str()) { r ->
                    r.spacing(6)
                    r.checkbox("", item.done, Msg.Toggle(id = item.id))
                    r.expand()
                    r.text(item.title.as_str())
                    r.button("^", Msg.MoveUp(id = item.id))
                    r.button("x", Msg.Remove(id = item.id))
                }
                i += 1
            }
        }
        k.progress(fraction(s))
    }
}

fun mark(state: mut Model) {
    state.marks.push(polyp.stats().created)
}

fun update(state: mut Model, msg: Msg) {
    when msg {
        Changed(text) -> {
            state.draft = String.from_str(text.as_str())
        }
        Add -> {
            val draft_now = String.from_str(state.draft.as_str())
            val has_draft = !str.is_empty(draft_now.as_str())
            if has_draft {
                val id = state.next_id
                state.next_id = id + 1
                state.items.push(Todo(id = id, title = draft_now, done = false))
                state.draft = String.from_str("")
            }
            mark(state)
        }
        Toggle(id) -> {
            val at = find_index(state, id)
            if at >= 0 {
                val u = at.to_usize()
                val was = state.items.get(u).done
                val title = String.from_str(state.items.get(u).title.as_str())
                state.items.set(u, Todo(id = id, title = title, done = !was))
            }
            mark(state)
        }
        MoveUp(id) -> {
            val at = find_index(state, id)
            if at > 0 {
                val item = state.items.remove(at.to_usize())
                state.items.insert((at - 1).to_usize(), item)
            }
            mark(state)
        }
        Remove(id) -> {
            val at = find_index(state, id)
            if at >= 0 {
                val gone = state.items.remove(at.to_usize())
            }
            mark(state)
        }
    }
}

fun smoke_enabled().R: bool {
    val value = env.get("POLYP_SMOKE")
    return str.eq(value.as_str(), "1")
}

// With POLYP_SMOKE=1 the program drives itself: it focuses the entry, types
// three titles through the entry's real `changed` signal, adds each one, ticks
// the second row's checkbox, moves the third row up, removes the row that is
// now the middle one, and quits. The scheduled ids are slot ids: the entry and
// the add button are slots 0 and 1, and each row takes three more in creation
// order (checkbox, move, remove), so the first row is 2/3/4, the second 5/6/7
// and the third 8/9/10. A slot id is stable for the widget that owns it, which
// is why these survive the list changing under them.
fun arm_smoke() {
    polyp.schedule_focus_entry(delay_ms = 100, index = 0)
    polyp.schedule_set_entry(delay_ms = 150, index = 0, new_text = "alpha")
    polyp.schedule_post(delay_ms = 200, id = 1)
    polyp.schedule_set_entry(delay_ms = 250, index = 0, new_text = "beta")
    polyp.schedule_post(delay_ms = 300, id = 1)
    polyp.schedule_set_entry(delay_ms = 350, index = 0, new_text = "gamma")
    polyp.schedule_post(delay_ms = 400, id = 1)
    polyp.schedule_post(delay_ms = 450, id = 5)
    polyp.schedule_post(delay_ms = 500, id = 9)
    polyp.schedule_post(delay_ms = 550, id = 10)
    polyp.schedule_quit(delay_ms = 650)
}

// The stylesheet is the only styling hook, and `todo-done` is the class the
// view puts on a completed row.
fun install_css() {
    polyp.css(".todo-app { padding: 2px; }\n.todo-done { color: #6b7280; }\n.todo-pending { color: #111827; }\n")
}

// The final state, then the library's counters. Every line is deterministic,
// which is what examples/polyp-todo/smoke.sh reads.
fun main() {
    if smoke_enabled() {
        arm_smoke()
    }
    install_css()
    val final = polyp.run(
        title = "polyp todo",
        width = 420,
        height = 360,
        init = Model(draft = String.from_str(""), items = List.empty(), next_id = 1, marks = List.empty()),
        view = view,
        update = update,
    )
    print(final.items.len())
    var i: usize = 0
    while i < final.items.len() {
        print(final.items.get(i).title)
        print(final.items.get(i).done)
        i += 1
    }
    var m: usize = 0
    while m < final.marks.len() {
        print(final.marks.get(m))
        m += 1
    }
    val st = polyp.stats()
    print(st.created)
    print(st.updated)
    print(st.removed)
    print(st.live)
    print(polyp.focus_present())
    print(polyp.focus_survived())
    print(polyp.entries_built())
    print(polyp.entry_text(0))
    print(final.draft)
    // A final marker, so the empty draft line above is not the last line: a
    // shell strips trailing newlines, and this keeps it.
    print("end")
}
