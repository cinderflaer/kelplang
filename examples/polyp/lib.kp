// Polyp, the application-facing module: the v1/v2 surface over the core and one backend.
//
// Everything that decides what the screen should be lives in `core.kp`, and everything that draws
// it lives in a backend (`gtk_backend.kp` here, `headless_backend.kp` for tests). This module is
// the thin, stable surface an application imports: the builder, `run`, the stylesheet hook, the
// scheduled-input helpers and the counters. plan/polyp-v3.md is the design.
impl "deps/polyp/core"
impl "deps/polyp/diag"
impl "deps/polyp/gtk_backend" caps(ui = ["*"])
impl "std/str"

// `GTK_ORIENTATION_*`, kept here because v2 exported them.
pub const HORIZONTAL: i32 = gtk_backend.HORIZONTAL
pub const VERTICAL: i32 = gtk_backend.VERTICAL

// Block-taking constructors, so app code reads
// `polyp.column { k -> k.text(s.title) k.button("+1", Msg.Inc) }`.
pub fun column<M>(block: scoped fun(mut core.Children<M>)).return: core.Node<M> = core.column(block)

pub fun row<M>(block: scoped fun(mut core.Children<M>)).return: core.Node<M> = core.row(block)

// The plain constructors, the two spellings v1 had. `polyp.Node<M>` is `core.Node<M>` now, so an
// application imports `deps/polyp/core` for the type it writes in a `view` signature.
pub fun plain_column<M>(children: move List<core.Node<M>>).return: core.Node<M> = core.plain_column(children)
pub fun plain_row<M>(children: move List<core.Node<M>>).return: core.Node<M> = core.plain_row(children)
pub fun text<M>(text: move String).return: core.Node<M> = core.text(text)
pub fun button<M>(label: move String, on_click: move M).return: core.Node<M> = core.button(label, on_click)

// The loop, on the GTK backend. `init` is moved in and the final state is returned, so a caller can
// read what the run left behind without a second sharing mechanism.
pub fun run<S, M>(title: str, width: i32, height: i32, init: move S, view: fun (S).return: core.Node<M>, update: fun (mut S, M)).return: S {
    var backend = gtk_backend.open(title = title, width = width, height = height)
    val final = core.run(backend = backend, init = init, view = view, update = update)
    diag.capture(backend)
    gtk_backend.close(backend)
    return final
}

// An application stylesheet. `gtk_init` is idempotent, so calling this before `run` is fine.
pub fun css(text: str) {
    gtk_backend.css(text)
}

// One scheduled input, for a program with no user: the GTK backend arms a timeout for it.
pub fun schedule(delay_ms: u32, event: core.Event) {
    gtk_backend.schedule(delay_ms = delay_ms, event = event)
}

// The v2 spellings, each one event.
pub fun schedule_post(delay_ms: u32, id: i32) {
    schedule(delay_ms = delay_ms, event = core.Event.Post(id = id))
}

pub fun schedule_quit(delay_ms: u32) {
    schedule(delay_ms = delay_ms, event = core.Event.Quit)
}

pub fun schedule_set_entry(delay_ms: u32, index: i32, new_text: str) {
    schedule(delay_ms = delay_ms, event = core.Event.Edit(index = index, text = String.from_str(new_text)))
}

pub fun schedule_focus_entry(delay_ms: u32, index: i32) {
    schedule(delay_ms = delay_ms, event = core.Event.Focus(index = index))
}

// The counters the smoke runs read: how many widgets were ever built, how many matched widgets were
// patched in place, how many were destroyed, and how many are alive now.
pub fun stats().return: core.Stats = core.stats()

// Whether every patch kept the focus widget it found.
pub fun focus_survived().return: bool = core.focus_survived()

// Whether a patch ever found a focus widget, so a run can tell "the focus stayed" from "there was
// no focus to keep".
pub fun focus_present().return: bool = core.focus_present()

// How many `Entry` widgets this process has built.
pub fun entries_built().return: i32 = core.entries_built()

// The live text of the index-th entry of the tree the run finished with, or "" when there was no
// such entry.
pub fun entry_text(index: i32).return: String = diag.entry_text(index)
