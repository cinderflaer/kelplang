// The GTK4 binding Polyp builds its widgets with. Every function is an
// `extern fun` bound to a real symbol by the consumer's coral.toml, whose
// `[extern."deps/polyp/gtk"]` section is pasted from examples/polyp/README.md;
// the header there supplies the C prototypes and `pkg_config = "gtk4"` the
// include and link paths.
//
// GTK spells every `GtkWidget*` as one C type. Kelp's opaque handles are
// nominal, so the shapes the loop actually distinguishes are named after what
// they are and their parent chains say how they relate: a `Window` is a
// `Widget`, a `BoxWidget` is too, and all three are `Object`s, so any of them
// converts up to the base for `g_object_unref`. The ABI is the same pointer
// either way. `gtk_box_new` really returns `GtkWidget*` in the header and is
// declared as the `BoxWidget` it is, which is why `gtk_box_append` takes one
// without a downcast (a `cast` is legal only in the module holding the
// `[extern.*]` section, and the loop is one module up).
pub extern type Object
pub extern type Widget: Object
pub extern type Window: Widget
pub extern type BoxWidget: Widget

// `GMainContext*`, whose null value is the default context.
pub extern type MainContext

pub extern fun gtk_init()
pub extern fun gtk_window_new().R: Window
pub extern fun gtk_window_set_title(win: Window, title: str)
pub extern fun gtk_window_set_default_size(win: Window, width: i32, height: i32)
pub extern fun gtk_window_set_child(win: Window, child: Widget)
pub extern fun gtk_window_present(win: Window)

pub extern fun gtk_box_new(orientation: i32, spacing: i32).R: BoxWidget
pub extern fun gtk_box_append(box: BoxWidget, child: Widget)

pub extern fun gtk_label_new(text: str).R: Widget
pub extern fun gtk_button_new_with_label(label: str).R: Widget

// `g_object_unref` takes a `gpointer`, so the one binding takes the base
// `Object` and every widget converts up to it.
pub extern fun g_object_unref(obj: Object)

// `g_main_context_iteration(context, may_block)`: a null `GMainContext*` means
// the default context, and `null_main_context` is how this module spells that
// null handle (`MainContext.null()` is legal only here, where the extern
// section is).
pub extern fun g_main_context_iteration(context: MainContext, may_block: i32).R: i32
pub fun null_main_context().R: MainContext = MainContext.null()

// `g_signal_connect_data(instance, signal, c_handler, data, destroy, flags)`.
// The closure parameter expands in place into `(c_handler, data, destroy)`,
// which is GLib's own order, so the Kelp signature is the C one with those
// three collapsed into one. The generated call is cast to the expansion's
// types, so `GCallback` and `GClosureNotify` need no cast written here.
//
// Two bindings because the handler's return is part of the closure's type:
// `clicked` wants a `unit` handler, `close-request` a `gboolean`. Both reach
// the same C symbol.
pub extern fun connect(instance: Widget, signal: str, handler: move closure(Widget), flags: i32).R: u64
pub extern fun connect_ret(instance: Widget, signal: str, handler: move closure(Window).R: i32, flags: i32).R: u64

// `g_timeout_add_full(priority, interval, function, data, notify)`: the closure
// expands into `(function, data, notify)` and the declaration has no argument
// after it. The handler returns `G_SOURCE_REMOVE` (0) to fire once.
pub extern fun g_timeout_add_full(priority: i32, interval: u32, handler: move closure().R: i32).R: u32
