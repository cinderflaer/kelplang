// The display a soft backend draws onto (Polyp v3 stage 3).
//
// This is the whole contract between the framework and an operating system: four functions and
// the framebuffer the platform owns. `examples/polyp/PLATFORM.md` is the plain-terms version.
// Nothing here allocates, dereferences a pixel or names a `std` module, so the module is off a
// consumer's `[unsafe]` list and a freestanding platform may implement it.
impl "deps/polyp/soft/damage"
impl "deps/polyp/soft/event"
impl "deps/polyp/soft/fb"
impl "std/option"

pub trait Platform {
    // Show the framebuffer. `dirty` lists exactly the rectangles the backend painted this frame,
    // in no particular order; a platform that cannot composite may ignore it and present the
    // whole surface. It is never called with an empty list.
    fun mut Self.present(fb: fb.Fb, dirty: &damage.Damage)

    // The platform's monotonic clock, in milliseconds. The backend uses it only to pace the
    // scripted input a `HeadlessPlatform` plays; a real platform returns its own clock.
    fun Self.now_ms().R: u64

    // The next input event, oldest first, or `None` when the queue is empty. A frame drains the
    // queue completely, so returning one event per call is the whole contract.
    fun mut Self.poll_event().R: option.Option<event.Event>

    // The framebuffer the platform owns. Pixels are `0xAARRGGBB` `u32`, `stride_px` is in
    // pixels and may exceed `width`, and the backend writes only inside `width x height`.
    fun Self.framebuffer().R: fb.Fb
}
