static FONT_SHAPES: [u8; 240] = [0x3E, 0x3E, 0x3E, 0x3E, 0x3E, 0x3E, 0x22, 0x22, 0x22, 0x3E, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x30, 0x3C, 0x3E, 0x3C, 0x30, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x06, 0x1E, 0x3E, 0x1E, 0x06, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x1C, 0x22, 0x22, 0x22, 0x1C, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x7F, 0x41, 0x41, 0x41, 0x7F, 0x1C, 0x3E, 0x3E, 0x3E, 0x1C,]
// END GENERATED GLYPH TABLES

// The replacement box for everything with no glyph.
const REPLACEMENT: [u8; 5] = [127, 65, 65, 65, 127]

// One bit per row, so the glyph builder never has to shift a `u8` by a runtime amount.
const ROW_BIT: [u8; 8] = [1, 2, 4, 8, 16, 32, 64, 128]

// The glyph index of a byte, or -1 when it has none (the ASCII table only; `glyph_column_cp` is the
// general lookup).
pub fun glyph_index(b: u8).return: i32 {
    if b < 32 || b > 126 {
        return -1
    }
    return (b - 32).to_i32()
}

// Column `ci` of the glyph for the byte `b`, with the replacement box for anything outside ASCII.
pub fun glyph_column(b: u8, ci: i32).return: u8 = glyph_column_cp(b.to_i32(), ci)

// Column `ci` of the glyph for code point `cp`: the ASCII table, then the generated blocks, and the
// replacement box for every code point with no drawing. The low bit is the top row.
pub fun glyph_column_cp(cp: i32, ci: i32).return: u8 {
    if cp >= 32 && cp <= 126 {
        return FONT.get(i = ((cp - 32) * 5 + ci).to_usize())
    }
    if cp >= 0xA0 && cp <= 0xFF {
        return FONT_LATIN1.get(i = ((cp - 0xA0) * 5 + ci).to_usize())
    }
    if cp >= 0x100 && cp <= 0x17F {
        return FONT_LATINA.get(i = ((cp - 0x100) * 5 + ci).to_usize())
    }
    if cp >= 0x391 && cp <= 0x3C9 {
        return FONT_GREEK.get(i = ((cp - 0x391) * 5 + ci).to_usize())
    }
    if cp >= 0x400 && cp <= 0x45F {
        return FONT_CYRILLIC.get(i = ((cp - 0x400) * 5 + ci).to_usize())
    }
    if cp >= 0x2010 && cp <= 0x2027 {
        return FONT_PUNCT.get(i = ((cp - 0x2010) * 5 + ci).to_usize())
    }
    if cp == 0x20AC {
        return FONT_EURO.get(i = ci.to_usize())
    }
    if cp >= 0x2190 && cp <= 0x2195 {
        return FONT_ARROWS.get(i = ((cp - 0x2190) * 5 + ci).to_usize())
    }
    if cp >= 0x2500 && cp <= 0x2551 {
        return FONT_BOX.get(i = ((cp - 0x2500) * 5 + ci).to_usize())
    }
    if cp >= 0x25A0 && cp <= 0x25CF {
        return FONT_SHAPES.get(i = ((cp - 0x25A0) * 5 + ci).to_usize())
    }
    return REPLACEMENT.get(i = ci.to_usize())
}

// Whether `cp` has a real drawing (anything else is drawn as the replacement box).
pub fun has_glyph(cp: i32).return: bool {
    var same = true
    var ci: i32 = 0
    while ci < GLYPH_W {
        if glyph_column_cp(cp, ci) != REPLACEMENT.get(i = ci.to_usize()) {
            same = false
        }
        ci += 1
    }
    return !same
}

// Pixels written by one glyph at `scale`, through `draw.blit_mask8`. `mask` holds at most
// 5 * 4 by 7 * 4 coverage bytes, which is every scale the public entry point allows.
fun draw_glyph(
    f: fb.Fb,
    c: &draw.ClipStack,
    x: i32,
    y: i32,
    cp: i32,
    scale: i32,
    color: u32,
).return: usize {
    val gw: i32 = GLYPH_W * scale
    var mask: [u8; 560] = [0; 560]
    var ci: i32 = 0
    while ci < GLYPH_W {
        val col: u8 = glyph_column_cp(cp, ci)
        var rj: i32 = 0
        while rj < GLYPH_H {
            val on: u8 = col & ROW_BIT.get(i = rj.to_usize())
            if on != 0 {
                var sy: i32 = 0
                while sy < scale {
                    var sx: i32 = 0
                    while sx < scale {
                        val idx: i32 = (rj * scale + sy) * gw + (ci * scale + sx)
                        mask.set(i = idx.to_usize(), v = 255)
                        sx += 1
                    }
                    sy += 1
                }
            }
            rj += 1
        }
        ci += 1
    }
    val mp: Ptr<[u8; 560]> = Ptr.from_ref(&mask)
    val mbytes: Ptr<u8> = mp.cast<u8>()
    return draw.blit_mask8(f, c, x, y, gw, GLYPH_H * scale, mbytes, color)
}

// The width of one line, saturating rather than wrapping: code points * 6 * scale in `i64`, then
// narrowed with `fb.clamp_i32`. A code point is one cell wide, a malformed run is one cell.
pub fun text_width(s: &str, scale: i32).return: i32 {
    val n: i64 = utf8.count(s).to_i64()
    val w: i64 = n * (ADVANCE * scale).to_i64()
    return fb.clamp_i32(w)
}

pub fun text_height(scale: i32).return: i32 = GLYPH_H * scale

// Draw a line left to right at `(x, y)`, one pen step of `6 * scale` per UTF-8 unit. The scale is a
// contract: outside 1..=4 the call panics instead of reading a mask the glyph builder did not
// size for. Malformed bytes are one replacement box per malformed run, never a panic or a read
// past the end of the string.
pub fun draw_text(
    f: fb.Fb,
    c: &draw.ClipStack,
    x: i32,
    y: i32,
    s: &str,
    scale: i32,
    color: u32,
).return: usize {
    if scale < 1 || scale > MAX_SCALE {
        panic("text scale must be in 1..=4")
    }
    val n: usize = str.len(s)
    var pen: i32 = x
    var count: usize = 0
    var i: usize = 0
    while i < n {
        val r = utf8.decode(s, i)
        count += draw_glyph(f, c, pen, y, utf8.unit_cp(r), scale, color)
        pen += ADVANCE * scale
        i += utf8.unit_len(r)
    }
    return count
}
