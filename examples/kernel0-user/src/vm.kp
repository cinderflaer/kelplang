impl "std/option"

// Sv39 page tables, in the language. The constants, the VPN split, the PTE
// encoding and the `satp` encoding are the RISC-V privileged spec's, and the
// only machine-level operations the module needs are a `Ptr<u64>` volatile
// load or store and the two CSRs `satp` and `sfence.vma`. The compiler's whole
// part is `unsafe` and inline asm, so this is ordinary Kelp arithmetic on
// addresses it was handed (`plan/address-spaces.md`).
//
// Kernel stage 11 adds `user_page_pa`: the same walk with the U and R bits
// demanded, which is the only way a syscall reads memory an untrusted program
// named (`plan/syscall-abi.md`).
const PAGE_SIZE: usize = 4096
const ENTRIES: usize = 512

// The PTE bit positions (privileged spec table 4.3). A leaf has one of R/W/X
// set, so an entry with V set and R|W|X clear points at the next table.
pub const PTE_V: u64 = 1
pub const PTE_R: u64 = 2
pub const PTE_W: u64 = 4
pub const PTE_X: u64 = 8
pub const PTE_U: u64 = 16
pub const PTE_G: u64 = 32
pub const PTE_A: u64 = 64
pub const PTE_D: u64 = 128
pub const PTE_LEAF: u64 = 14

const SATP_MODE_SV39: usize = 8

// Level 2 is the root table, level 0 holds the leaves.
const TOP_LEVEL: usize = 2

// The frame allocator hands out one zeroed page at a time, bumping a cursor
// over the linker script's `__frames_start`..`__frames_end` region. Zeroed is
// not a convenience: a fresh table's absent entries have to read as invalid, so
// a frame that arrived with the loader's leftovers would send the walker into a
// garbage address. Nothing here frees a frame; unmap clears a leaf but leaves
// its tables allocated.
//
// The language has no spelling for a linker-script symbol, so the two bounds
// arrive through `la` in an asm template, exactly as the compiler's own `_start`
// stub reaches `__stack_top`.
static mut FRAME_CURSOR: usize = 0

pub fun frames_start().return: usize = unsafe {
    asm("la {0}, __frames_start", out("r") _)
}

pub fun frames_end().return: usize = unsafe {
    asm("la {0}, __frames_end", out("r") _)
}

// The next free frame, or 0 when the region is exhausted. Zero is never a
// frame, so the caller reads it as failure and every other return as success.
pub fun alloc_frame().return: usize {
    unsafe {
        val next: usize = frames_start() + FRAME_CURSOR
        if next + PAGE_SIZE > frames_end() {
            0
        } else {
            FRAME_CURSOR = FRAME_CURSOR + PAGE_SIZE
            val words: Ptr<u64> = Ptr.from_addr(next)
            var i: usize = 0
            while i < ENTRIES {
                words.offset(i.to_isize()).write_volatile(0)
                i = i + 1
            }
            next
        }
    }
}

fun read_pte(table: usize, index: usize).return: u64 {
    unsafe {
        val p: Ptr<u64> = Ptr.from_addr(table)
        p.offset(index.to_isize()).read_volatile()
    }
}

fun write_pte(table: usize, index: usize, value: u64) {
    unsafe {
        val p: Ptr<u64> = Ptr.from_addr(table)
        p.offset(index.to_isize()).write_volatile(value)
    }
}

// The VPN index for `level`, bits 12+9*level through 20+9*level of the address.
fun vpn(va: usize, level: usize).return: usize {
    (va >> (12 + 9 * level)) & (ENTRIES - 1)
}

pub fun page_offset(va: usize).return: usize {
    va & (PAGE_SIZE - 1)
}

// The VPN split, named the way the spec names the three fields.
pub fun vpn0(va: usize).return: usize = vpn(va, 0)
pub fun vpn1(va: usize).return: usize = vpn(va, 1)
pub fun vpn2(va: usize).return: usize = vpn(va, 2)

// The physical page number a PTE names, as a byte address.
pub fun pte_ppn(entry: u64).return: usize {
    ((entry >> 10) << 12).to_usize()
}

pub fun pte_flags(entry: u64).return: u64 {
    entry & 1023
}

pub fun pte_valid(entry: u64).return: bool {
    entry & PTE_V != 0
}

pub fun pte_is_leaf(entry: u64).return: bool {
    entry & PTE_LEAF != 0
}

// `(pa >> 12) << 10` is the PPN field, PTE bits 53:10; `flags` is the
// permission bits and nothing else. The caller sets A and D for a leaf,
// because a kernel with no fault-driven access tracking can only make them
// true up front.
pub fun pte_encode(pa: usize, flags: u64).return: u64 {
    ((pa >> 12).to_u64() << 10) | flags
}

// `satp` for Sv39: mode 8 in bits 63:60, ASID 0 in bits 59:44, the root
// table's PPN in bits 43:0 (`plan/address-spaces.md`).
pub fun satp_encode(root: usize).return: usize {
    (SATP_MODE_SV39 << 60) | (root >> 12)
}

pub fun satp_mode(satp: usize).return: usize {
    satp >> 60
}

pub fun satp_asid(satp: usize).return: usize {
    (satp >> 44) & 0xFFFF
}

pub fun satp_ppn(satp: usize).return: usize {
    satp & 0xFFFFFFFFFFF
}

// Walk to the level-0 table for `va`, installing and linking a fresh table at
// every absent non-leaf entry. Zero answers "no", either because a frame ran
// out or because a superpage already covers the address: this walker never
// splits one, so a caller that meets one has made a layout mistake.
fun walk(root: usize, va: usize).return: usize {
    var table: usize = root
    var level: usize = TOP_LEVEL
    while level > 0 {
        val entry: u64 = read_pte(table, vpn(va, level))
        if entry & PTE_V == 0 {
            val fresh: usize = alloc_frame()
            if fresh == 0 {
                return 0
            }
            write_pte(table, vpn(va, level), pte_encode(fresh, PTE_V))
            table = fresh
        } else {
            if entry & PTE_LEAF != 0 {
                return 0
            }
            table = pte_ppn(entry)
        }
        level = level - 1
    }
    return table
}

// Map one 4 KiB page. `flags` are the R/W/X/U/G bits; V, A and D are added
// here. False means no frame was available or a superpage was in the way.
pub fun map_page(root: usize, va: usize, pa: usize, flags: u64).return: bool {
    val table: usize = walk(root, va)
    if table == 0 {
        return false
    }
    write_pte(table, vpn0(va), pte_encode(pa, flags | PTE_V | PTE_A | PTE_D))
    return true
}

pub fun map_range(root: usize, va: usize, pa: usize, len: usize, flags: u64).return: bool {
    var offset: usize = 0
    while offset < len {
        if map_page(root, va + offset, pa + offset, flags) == false {
            return false
        }
        offset = offset + PAGE_SIZE
    }
    return true
}

// Clear the leaf for `va`, answering true only when a valid leaf was there.
// A cleared entry needs `flush_tlb` before the walker's view is trustworthy.
pub fun unmap_page(root: usize, va: usize).return: bool {
    var table: usize = root
    var level: usize = TOP_LEVEL
    while level > 0 {
        val entry: u64 = read_pte(table, vpn(va, level))
        if entry & PTE_V == 0 || entry & PTE_LEAF != 0 {
            return false
        }
        table = pte_ppn(entry)
        level = level - 1
    }
    if read_pte(table, vpn0(va)) & PTE_V == 0 {
        return false
    }
    write_pte(table, vpn0(va), 0)
    return true
}

// The physical address `va` currently names, or `None`. A leaf at any level is
// honoured, so a 2 MiB or 1 GiB superpage translates as the spec says, with the
// bits the superpage ignores taken from `va`.
pub fun translate(root: usize, va: usize).return: option.Option<usize> {
    var table: usize = root
    var level: usize = TOP_LEVEL
    while true {
        val entry: u64 = read_pte(table, vpn(va, level))
        if entry & PTE_V == 0 {
            return option.Option.None
        }
        if entry & PTE_LEAF != 0 {
            val mask: usize = (1 << (12 + 9 * level)) - 1
            return option.Option.Some(value = pte_ppn(entry) | (va & mask))
        }
        if level == 0 {
            return option.Option.None
        }
        table = pte_ppn(entry)
        level = level - 1
    }
    return option.Option.None
}

// The physical address of `va`, but only when the leaf that maps it is a
// user-readable page: `PTE_U` and `PTE_R` both set. A mapped kernel leaf (the
// identity map is in every program's table) answers `None`, so this is what
// stops a syscall from trusting a pointer that names kernel memory. The R bit
// is checked rather than W or X because the only use is to copy bytes out.
pub fun user_page_pa(root: usize, va: usize).return: option.Option<usize> {
    var table: usize = root
    var level: usize = TOP_LEVEL
    while true {
        val entry: u64 = read_pte(table, vpn(va, level))
        if entry & PTE_V == 0 {
            return option.Option.None
        }
        if entry & PTE_LEAF != 0 {
            if entry & PTE_U == 0 || entry & PTE_R == 0 {
                return option.Option.None
            }
            val mask: usize = (1 << (12 + 9 * level)) - 1
            return option.Option.Some(value = pte_ppn(entry) | (va & mask))
        }
        if level == 0 {
            return option.Option.None
        }
        table = pte_ppn(entry)
        level = level - 1
    }
    return option.Option.None
}

// Install the table and drop every cached translation, because a store to a
// page-table entry is not ordered against the MMU's own read of it.
pub fun enable_paging(root: usize) {
    unsafe {
        asm("csrw satp, {0}", in("r") satp_encode(root))
        asm("sfence.vma zero, zero")
    }
}

pub fun flush_tlb() {
    unsafe {
        asm("sfence.vma zero, zero")
    }
}
