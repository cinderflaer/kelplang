impl "std/str"

// The NS16550 UART QEMU's riscv64 `virt` machine puts at 0x10000000. THR
// (offset 0) is the byte to send; LSR (offset 5) bit 5 is set while the
// transmit holding register is empty, so a byte is written only after that bit
// reads back set. Every access goes through `Ptr<u8>` and is volatile so the
// compiler can neither merge, reorder nor elide it, and nothing else about the
// device is checked: the base, the offsets and the bit are the driver's own
// claim about the hardware (kernel stage 1, `plan/unsafe-and-pointers.md`).
//
// The kernel writes two kinds of text: its own `str` literals, and the bytes a
// syscall copied into the kernel buffer, which are not a `str` and carry their
// length. `puts_bytes` is the second.

const UART_BASE: usize = 0x10000000
const LSR_OFFSET: usize = 5

pub fun putc(c: u8) {
    unsafe {
        val lsr: Ptr<u8> = Ptr.from_addr(UART_BASE + LSR_OFFSET)
        // v1 has no bitwise operators, so bit 5 of LSR is `(value / 32) % 2`.
        while (lsr.read_volatile() / 32) % 2 == 0 {}
        val thr: Ptr<u8> = Ptr.from_addr(UART_BASE)
        thr.write_volatile(c)
    }
}

pub fun puts(s: str) {
    val n = str.len(s)
    var i: usize = 0
    while i < n {
        putc(str.byte(s, i))
        i = i + 1
    }
}

// A length-tagged buffer that is not a `str`: the syscall copy's bytes, and the
// digits `put_dec` just built.
pub fun puts_bytes(p: Ptr<u8>, len: usize) {
    var i: usize = 0
    while i < len {
        putc(unsafe { p.offset(i.to_isize()).read_volatile() })
        i = i + 1
    }
}

// `scause`, an exit code and a length are printed in decimal, so the kernel has
// one decimal printer rather than a hex one per site. Zero is a single digit
// and not an empty string, which is why it is handled before the loop.
pub fun put_dec(value: usize) {
    if value == 0 {
        putc(48)
        return
    }
    var digits: [u8; 20] = [0; 20]
    val bytes: Ptr<[u8; 20]> = Ptr.from_ref(&digits)
    val p: Ptr<u8> = bytes.cast<u8>()
    var n: usize = value
    var i: usize = 0
    while n > 0 {
        unsafe {
            p.offset(i.to_isize()).write_volatile((48 + n % 10).to_u8())
        }
        n = n / 10
        i = i + 1
    }
    while i > 0 {
        i = i - 1
        putc(unsafe { p.offset(i.to_isize()).read_volatile() })
    }
}

// `wfi` has no Kelp spelling (kernel stage 5, `plan/inline-asm.md`), and the
// compiler's `_start` stub already loops on it if the entry returns; this is
// the same halt written in the language, so the kernel names its own stop.
pub fun halt() {
    while true {
        unsafe {
            asm("wfi")
        }
    }
}
