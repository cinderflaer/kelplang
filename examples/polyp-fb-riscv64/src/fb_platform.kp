// The scripted platform the framebuffer kernels run on (Polyp v3 stage 4).
//
// It is the "custom operating system with a framebuffer" case the whole v3 design aims at: it owns
// a `static mut [u32; N]` surface, hands it to the soft backend as an `fb.Fb`, counts the presents
// it is asked for, and keeps a fake clock. There is no timer device on this machine, so the clock
// advances 100 ms per presented frame and `poll_event` answers from a timed script against it,
// exactly as `soft/headless_platform.kp` does. The todo scenario drives the programmatic
// `core.Event` channel, so the platform's own script is empty here; the machinery is the same as
// the hosted platform's, which is what makes a platform-level script portable.
//
// The surface is in `.bss` and the compiler's `_start` stub zeroes it, so it starts black, the way
// `HeadlessPlatform` zeroes its own buffer.
impl "deps/polyp/soft/damage"
impl "deps/polyp/soft/event"
impl "deps/polyp/soft/fb"
impl "deps/polyp/soft/platform"
impl "std/option"

// 320x200, the resolution the hosted run is compared at.
pub const FB_W: i32 = 320
pub const FB_H: i32 = 200
pub const FB_PIXELS: usize = 64000

// The script the platform plays. Eight is more than any test needs and keeps the platform a
// value, not a heap allocation.
const MAX_SCRIPT: usize = 8

static mut FRAME: [u32; FB_PIXELS] = [0; FB_PIXELS]

// One scripted platform event and the clock it is released at, the same pair `HeadlessPlatform`
// holds.
pub datac Timed(val at: u64, val ev: event.Event)

pub datac FbPlatform(
    var f: fb.Fb,
    var script: [Timed; MAX_SCRIPT],
    var script_len: usize,
    var cursor: usize,
    var time_ms: u64,
    var frames: i32,
    var presented: i32,
    // Polyp v4: `auto_clock` is the v3 behaviour (a presented frame is 100 ms); a program that drives
    // the clock itself turns it off and calls `advance_ms`, which also schedules the `Tick` event
    // the backend's timers and animations read.
    var auto_clock: bool,
    var tick_due: bool,
)

pub fun new().return: FbPlatform {
    val base: Ptr<[u32; FB_PIXELS]> = unsafe { Ptr.from_mut(FRAME) }
    val pixels: Ptr<u32> = base.cast<u32>()
    return FbPlatform(
        f = fb.new(pixels = pixels, width = FB_W, height = FB_H, stride_px = FB_W),
        script = [Timed(at = 0, ev = event.Event.Key(code = 0, mods = 0)); MAX_SCRIPT],
        script_len = 0,
        cursor = 0,
        time_ms = 0,
        frames = 0,
        presented = 0,
        auto_clock = true,
        tick_due = false,
    )
}

// Queue one platform event for a later clock, the way a real input driver would deliver it.
fun mut FbPlatform.push_at(at: u64, ev: move event.Event) {
    if script_len >= MAX_SCRIPT {
        return
    }
    script.set(i = script_len, v = Timed(at = at, ev = ev))
    script_len += 1
}

fun FbPlatform.frame_count().return: i32 = frames

// Take the clock over from the per-present auto advance: from now on it moves only through
// `advance_ms`, which is the clock a Polyp v4 scenario scripts.
fun mut FbPlatform.set_auto_clock(on: bool) {
    auto_clock = on
}

// Advance the clock by `ms` and tell the backend at the next poll: this is what a timer interrupt
// handler does on a real kernel (record the new time, queue one `Tick`).
fun mut FbPlatform.advance_ms(ms: u64) {
    time_ms += ms
    tick_due = true
}

// Where the surface is, for the ramfb registration: the display device needs the physical address
// and the stride, in pixels, of the memory it scans out. The cast is a separate binding because a
// method with type arguments cannot be written on a call expression (`plan/user-ffi-gap-analysis.md`).
pub fun framebuffer_addr().return: usize {
    val base: Ptr<[u32; FB_PIXELS]> = unsafe { Ptr.from_mut(FRAME) }
    val bytes: Ptr<u8> = base.cast<u8>()
    return bytes.addr()
}

pub fun framebuffer_stride().return: i32 = FB_W

fun FbPlatform.presented_count().return: i32 = presented

fun FbPlatform.clock().return: u64 = time_ms

impl platform.Platform for FbPlatform {
    fun mut Self.present(fb: fb.Fb, dirty: &damage.Damage) {
        // The trait hands the surface over; this platform counts the presents and what they were
        // handed, the way the hosted one records the rectangles it was shown.
        val _ = fb.width
        frames += 1
        presented = dirty.count().to_i32()
        // No timer device: one presented frame is 100 ms of this platform's clock.
        if auto_clock {
            time_ms += 100
        }
    }

    fun Self.now_ms().return: u64 = time_ms

    // No timer device and no requirement for a deadline here: the millisecond clock is the whole of
    // it, and this stage's deadline is a hosted feature (`plan/polyp-v3.md`, stage 5).
    fun mut Self.now_us().return: u64 = time_ms * 1000

    fun mut Self.poll_event().return: option.Option<event.Event> {
        if tick_due {
            tick_due = false
            return option.Option.Some(value = event.Event.Tick(now_us = time_ms * 1000))
        }
        if cursor >= script_len {
            return option.Option.None
        }
        val t = script.get(i = cursor)
        if t.at > time_ms {
            return option.Option.None
        }
        cursor += 1
        return option.Option.Some(value = event.clone(t.ev))
    }

    fun Self.framebuffer().return: fb.Fb = fb.new(pixels = f.pixels, width = f.width, height = f.height, stride_px = f.stride_px)
}
