// Polyp on bare metal, riscv64 (Polyp v3 stage 4).
//
// This is the whole of the operating system the renderer needs: a UART, a `static mut` framebuffer,
// a bump arena behind the manifest's `[target] alloc`/`dealloc`, and a panic handler. The program
// it runs is the same one the hosted run runs: `deps/todo/app` is the todo model, view and update,
// `deps/todo/scenario` is the shared driver, and `deps/polyp/backends/soft/soft_backend` with the stage-2 raster
// is the same code the hosted soft backend is. Nothing here draws a pixel itself.
//
// One step line is printed per frame, then the report `examples/polyp-todo/smoke.sh` reads, so the
// equivalence test can compare both the pixels (`checksum`) and the state machine (the report) with
// the hosted run.
impl "deps/polyp/core/core"
impl "deps/polyp/backends/soft/soft_backend"
impl "deps/todo/app"
impl "deps/todo/scenario"
impl "fb_platform"
impl "ramfb" caps(mmio = ["0x10100000+0x20"])
impl "uart" caps(mmio = ["0x10000000+0x100"])
impl "std/str"

const ARENA_BYTES: usize = 1048576

// A bump arena for the heap types. `List`, `String` and `Box` allocate and free through `alloc` and
// `dealloc`, so the image links no libc; the arena is `.bss`, which the `_start` stub zeroes.
static mut ARENA: [u8; ARENA_BYTES] = [0; ARENA_BYTES]
static mut USED: usize = 0

// `align` is always a power of two (every type's alignment the compiler asks for is), so the
// round-up is a divide and multiply rather than a bit mask: v1 has no bitwise operators.
fun align_up(value: usize, align: usize).return: usize {
    return ((value + align - 1) / align) * align
}

// The project's allocator: a block of `ARENA`, aligned for the caller, or the null pointer when the
// arena is full. `check_alloc` in the compiler turns that null into `kp_panic("out of memory")`, so
// a failed allocation never dereferences null. A bump allocator never reclaims, which is why the
// run has to fit in the arena at once; `dealloc` exists only to satisfy the hook.
fun alloc(size: usize, align: usize).return: Ptr<u8> {
    val out: Ptr<u8> = unsafe {
        val start: usize = align_up(USED, align)
        if start + size > ARENA_BYTES {
            Ptr.null()
        } else {
            USED = start + size
            val arena: Ptr<[u8; ARENA_BYTES]> = Ptr.from_mut(ARENA)
            val base: Ptr<u8> = arena.cast<u8>()
            base.byte_offset(start.to_isize())
        }
    }
    return out
}

fun dealloc(_p: Ptr<u8>, _size: usize, _align: usize) {
}

// One line out: the step lines and the report both come through here, so a kernel line is the same
// bytes a hosted `print` writes.
fun emit_line(line: str) {
    uart.puts(line)
    uart.putc(10)
}

section(".text.boot") fun kmain() {
    var platform = fb_platform.new()
    var backend = soft_backend.new()

    // Stage 4's stretch: register the surface with QEMU's `ramfb` device through fw_cfg, so a
    // monitor `screendump` shows what the renderer draws. `ramfb.setup` returns 0 when the device
    // took the surface; the one line is a diagnostic for the boot log.
    val ramfb_code = ramfb.setup(
        pixels = fb_platform.framebuffer_addr(),
        width = fb_platform.FB_W,
        height = fb_platform.FB_H,
        stride_px = fb_platform.framebuffer_stride(),
    )
    uart.puts("ramfb ")
    uart.putc(48 + ramfb_code.to_u8())
    uart.putc(10)

    val final = scenario.drive(backend = backend, platform = platform, emit = emit_line)

    // The counters and the entry text the report reads. `core.publish` fills the atomics; the entry
    // text comes from the display itself, because this project does not carry `diag` (its snapshot
    // is a `pd`, which a freestanding build refuses).
    core.publish(backend)
    var entry: String = String.from_str("")
    val ids = backend.entry_ids()
    if ids.len() > 0 {
        entry = backend.entry_text(ids.get(0))
    }
    app.report(final, entry.as_str(), emit_line)
    uart.puts("done\n")
    uart.halt()
}

// The handler `[target] panic` names: every bounds and overflow check, and a failed allocation,
// calls this with the static message the check was written with.
fun kp_panic(msg: str) {
    uart.puts("panic: ")
    uart.puts(msg)
    uart.putc(10)
    uart.halt()
}
