/target
/bench/*/build
/.pi/

# `kelpc build`/`kelpc run` write the emitted C and the binary into the
# working directory when no `-o` is given. Build output, not source: the
# compiler is Rust and the stdlib is `.kp`, so a `.c` file outside
# `kelpc/runtime/` is build output.
*.c

# `kelpc/runtime/` is the one exception, and it is a staging post rather than a
# destination (MK7 §8). It holds the C the compiler still emits as its runtime,
# now kept as reviewed files instead of Rust string literals, because the
# runtime track is replacing each piece with Kelp and the differential test for
# a replacement has to compile the C it is comparing against — which needs a
# file with a path, not a `const` inside the compiler binary.
!kelpc/runtime/
!kelpc/runtime/*.c

# Stray `kelpc build` output. With no `-o`, the driver writes the binary *and*
# the emitted C into `build/` (as of `fc7a2bf`), which this file ignores — but
# before that it wrote them into the working directory itself, and the `.c` half
# was hidden by the `*.c` rule above while the binary half, having no extension,
# was matched by nothing. Ten of them were committed across six commits (0.2.0
# through the `View` work). They are ignored by name so that a build produced by
# an older `kelpc` cannot re-add one; a *new* stray name still shows up as `??`
# in `git status` rather than vanishing into a blanket rule.
/build/
/bitwise
/borrow_provenance_and_arms
/lit
/lit2
/literal_operand_typing
/mutparam
/ok
/scanner
/view
/view1
