//! Callback-shaped operations on `List<T>`: `map`, `filter`, `each`, `any`, `all` and friends.
/* std/list, the callback-shaped operations on the builtin `List<T>` (A-4).

   The element-wise API (`len`, `get`, `push`, `sort`, …) is built into the
   compiler, because a list is monomorphized and its methods are generated C
   per element type (syntax.md §12.1). What lives here is the other half: the
   operations that need a *function value*, which the compiler cannot generate
   without knowing what the callback returns. They are free functions in a
   module, exactly like `str.*` and `math.*`, `list.map(xs, f)`.

   Every callback takes a *borrow* of the element and is a **closure**
   (`closure fun(&T) => U`), so a call never moves an element out of the list, the
   same functions work for `Copy` and owned element types, and a callback may
   capture a binding from the frame that passes it (A-4 phase E). A plain
   function value, a declared `fun`, or a literal that captured nothing, is
   widened into a closure at the call, through a generated shim, so passing one
   allocates nothing. Where a function has to hand an element out
   by value, it is offered for a `Copy` element and is a compile error at any
   other instantiation, the rule `List.get` and `option.unwrap` already
   follow, and the honest edge of a language where reading an owned element out
   of a list is not expressible. */
impl "std/option"

/// The list of `f(x)` for every `x`. Works for any element type: the result is
/// built from what `f` returns, and nothing is taken out of `xs`.
fun map<T, U>(xs: &List<T>, f: closure fun(&T) => U) => List<U> {
    var out: List<U> = List.empty()
    var i: int = 0
    while i < xs.len() {
        out.push(f(xs.get(i)))
        i += 1
    }
    return out
}

/// The elements `f` accepts, in order. `T` must be `Copy`: an accepted element
/// is read out of `xs` by value.
fun filter<T>(xs: &List<T>, f: closure fun(&T) => bool) => List<T> {
    var out: List<T> = List.empty()
    var i: int = 0
    while i < xs.len() {
        if f(xs.get(i)) {
            out.push(xs.get(i))
        }
        i += 1
    }
    return out
}

/// Run `f` over every element, in order, for its effect. Works for any element
/// type.
fun each<T>(xs: &List<T>, f: closure fun(&T)) {
    var i: int = 0
    while i < xs.len() {
        f(xs.get(i))
        i += 1
    }
}

/// The index of the first element `f` accepts, or `None`. Works for any element
/// type, the index is the value, and no element is read out.
fun find_index<T>(xs: &List<T>, f: closure fun(&T) => bool) => option.Option<int> {
    var i: int = 0
    while i < xs.len() {
        if f(xs.get(i)) {
            return option.Option.Some(value = i)
        }
        i += 1
    }
    return option.Option.None
}

/// Whether `f` accepts any element, the predicate form of `find_index`, for a
/// caller that does not care which one. Works for any element type.
fun any<T>(xs: &List<T>, f: closure fun(&T) => bool) => bool {
    var i: int = 0
    while i < xs.len() {
        if f(xs.get(i)) {
            return true
        }
        i += 1
    }
    return false
}

/// Whether `f` accepts every element. Works for any element type.
fun all<T>(xs: &List<T>, f: closure fun(&T) => bool) => bool {
    var i: int = 0
    while i < xs.len() {
        if !f(xs.get(i)) {
            return false
        }
        i += 1
    }
    return true
}
