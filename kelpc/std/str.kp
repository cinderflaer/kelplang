impl "std/mem"
impl "std/option"
impl "std/result"

/* The three operations on a `&str` that Kelp cannot express: its byte length, a
   byte at an index, and a borrow of the suffix starting at an index. All
   three bodies are compiler-supplied; the public wrappers below are ordinary
   Kelp code, and they are what callers see.

   The bounds checks live in the compiler-supplied bodies (see `externs.rs`)
   rather than here, so there is exactly one of each and no call site can
   forget it. */
extern fun byte_len_raw(s: &str).R: usize
extern fun byte_at_raw(s: &str, i: usize).R: u8
extern fun slice_from_raw(s: &str, from: usize).R: &str

// Byte length, not character count — see `char_count`, which counts
// continuation bytes as parts of the same character.
fun len(s: &str).R: usize = byte_len_raw(s)

// The byte at `i`.
// Panics: if `i` is out of bounds.
fun byte(s: &str, i: usize).R: u8 = byte_at_raw(s, i)

fun is_empty(s: &str).R: bool = len(s) == 0

// The tail of `s` starting at byte `from` — a view, not a copy, which is
// what `&str` return elision makes possible: the result borrows `s`.
// Panics: if `from` is past the end.
fun substring(s: &str, from: usize).R: &str = slice_from_raw(s, from)

/// How many characters a `&str` has: bytes that do not continue a UTF-8
/// sequence.
fun char_count(s: &str).R: usize {
    val n = len(s)
    var count: usize = 0
    var i: usize = 0
    while i < n {
        // A byte in 128..191 is a UTF-8 continuation; everything else starts
        // a character. (No bitwise operators in v1, so this is a range test.)
        val c = byte(s, i)
        if c < 128 || c >= 192 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// The index of `needle` in `s`, or `None`. The old `Match(ok, at)` datac is
// gone: a failure that carries no reason is an `Option`, which is what makes
// `if let Some(at) = ...` and `?` usable at the call site instead of an `ok`
// flag (MK5-S6-M1).
fun index_of(s: &str, needle: &str).R: option.Option<usize> {
    val ls = len(s)
    val ln = len(needle)
    if ln == 0 {
        return option.Option.Some(value = 0)
    }
    if ln > ls {
        return option.Option.None
    }
    var i: usize = 0
    while i + ln <= ls {
        if starts_with_at(s, needle, i) {
            return option.Option.Some(value = i)
        }
        i = i + 1
    }
    return option.Option.None
}

// Whether `needle` occurs in `s` starting exactly at byte `at`. Private to
// the module in practice (nothing outside needs the offset form).
fun starts_with_at(s: &str, needle: &str, at: usize).R: bool {
    val ln = len(needle)
    var i: usize = 0
    while i < ln {
        if byte(s, at + i) != byte(needle, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun starts_with(s: &str, prefix: &str).R: bool {
    if len(prefix) > len(s) {
        return false
    }
    return starts_with_at(s, prefix, 0)
}

fun ends_with(s: &str, suffix: &str).R: bool {
    val ls = len(s)
    val lf = len(suffix)
    if lf > ls {
        return false
    }
    return starts_with_at(s, suffix, ls - lf)
}

fun contains(s: &str, needle: &str).R: bool {
    return option.is_some(o = index_of(s, needle))
}

// Text equality, which `==` deliberately does not provide for `str` (it
// would compare addresses — see `infer.rs::comparable`).
fun eq(a: &str, b: &str).R: bool {
    if len(a) != len(b) {
        return false
    }
    val n = len(a)
    var i: usize = 0
    while i < n {
        if byte(a, i) != byte(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Byte-wise ordering, the `<` that `str` deliberately does not have: `eq` above
// explains why `==` compares addresses rather than bytes, and the same argument
// applies to every other operator, so a caller that has to *order* text has to
// say which order it means. This is the answer that matches `List<T>.sort` on a
// `List<u8>`: compare at the first byte that differs, and when one text is a
// prefix of the other the shorter one is less.
//
// It is here rather than in each caller because the catalogue already wrote it
// once: `fpl/json` has a private `str_less` with this exact rule in its doc
// comment, used by `write_sorted` to order keys. A consumer that sorts a
// `List<String>` had no way to help it, because a library cannot import a
// sibling library and std had no comparison to offer. Bytes, not codepoints, so
// the answer is stable for any UTF-8 input and costs no allocation.
fun less(a: &str, b: &str).R: bool {
    val na = len(a)
    val nb = len(b)
    var i: usize = 0
    val limit = if nb < na { nb } else { na }
    while i < limit {
        val ca = byte(a, i)
        val cb = byte(b, i)
        if ca != cb {
            return ca < cb
        }
        i = i + 1
    }
    return na < nb
}

fun is_space(c: u8).R: bool = c == 32 || c == 9 || c == 10 || c == 13

// The decimal-digit predicate that pairs with `is_space`.
//
// The catalogue wrote it seven times before std had it. Two libraries with a
// private copy: `fpl/json` (line 1444, beside a second inline check at 1790) and
// `fpl/decimal`. Two spelling it as two magic numbers instead of two literals:
// `fpl/encoding` (three times: the `0`-`9` arm of a base64 value, of an
// unreserved-URL test, and of `hex_value`) and `fpl/httpx` (once, in the same URL
// test). One implementation is one place to be right about the endpoints, and
// `c >= '0' && c <= '9'` is the spelling that can be read. ASCII only, like
// `to_upper` and `is_space`.
fun is_digit(c: u8).R: bool = c >= '0' && c <= '9'

// Leading whitespace is skipped by advancing the pointer, so this is a view
// of `s` rather than a copy.
fun trim_start(s: &str).R: &str {
    val n = len(s)
    var i: usize = 0
    while i < n && is_space(byte(s, i)) {
        i = i + 1
    }
    return slice_from_raw(s, i)
}

// Trailing whitespace is *truncation*, which a `&str` (a NUL-terminated C
// string) cannot represent — there is nowhere to put the terminator. So the
// end-trimming functions return an owned `String` and allocate, while the
// start-trimming ones stay views. This is the one place M6.3 diverges from
// the plan's `str` sketch.
fun trim_end(s: &str).R: String {
    val n = len(s)
    var end: usize = n
    while end > 0 && is_space(byte(s, end - 1)) {
        end = end - 1
    }
    return prefix(s, end)
}

// The first `n` bytes of `s`, as an owned copy. Truncation cannot be a view:
// a `&str` is a NUL-terminated C string, and there is nowhere in the original
// buffer to put a terminator.
// Panics: if `n` is past the end of `s`.
fun prefix(s: &str, n: usize).R: String {
    var out = mem.alloc(n)
    var i: usize = 0
    while i < n {
        out.set(i, byte(s, i))
        i = i + 1
    }
    return String.from_bytes(out)
}

fun trim(s: &str).R: String = trim_end(trim_start(s))

// Non-ASCII bytes are copied through unchanged: upper-casing arbitrary
// Unicode needs a character table, which v1 has no place to put.
fun to_upper(s: &str).R: String {
    val n = len(s)
    var out = mem.alloc(n)
    var i: usize = 0
    while i < n {
        val c = byte(s, i)
        if c >= 97 && c <= 122 {
            out.set(i, c - 32)
        } else {
            out.set(i, c)
        }
        i = i + 1
    }
    return String.from_bytes(out)
}

fun to_lower(s: &str).R: String {
    val n = len(s)
    var out = mem.alloc(n)
    var i: usize = 0
    while i < n {
        val c = byte(s, i)
        if c >= 65 && c <= 90 {
            out.set(i, c + 32)
        } else {
            out.set(i, c)
        }
        i = i + 1
    }
    return String.from_bytes(out)
}

// `s` repeated `n` times.
fun repeat(s: &str, n: usize).R: String {
    val ls = len(s)
    var out = mem.alloc(ls * n)
    var i: usize = 0
    while i < n {
        var j: usize = 0
        while j < ls {
            out.set(i * ls + j, byte(s, j))
            j = j + 1
        }
        i = i + 1
    }
    return String.from_bytes(out)
}

// Copies bytes [from, to) of `s` into a fresh owned `String`. A range that
// is neither a prefix nor a suffix cannot be a view (a `&str` is a
// NUL-terminated C string), so it is copied — the same reason `prefix`
// allocates.
fun copy_range(s: &str, from: usize, to: usize).R: String {
    var out = mem.alloc(to - from)
    var i: usize = 0
    while i < to - from {
        out.set(i, byte(s, from + i))
        i = i + 1
    }
    return String.from_bytes(out)
}

// Splits `s` on every occurrence of `sep`. An empty `sep` yields one piece
// (the whole string) rather than an infinite number of empty ones.
//
// The last piece is always returned, including the empty one after a
// trailing separator: "a," splits into ["a", ""].
fun split(s: &str, sep: &str).R: List<String> {
    var out: List<String> = List.empty()
    val ls = len(s)
    val lsep = len(sep)
    if lsep == 0 {
        out.push(String.from_str(s))
        return out
    }
    var start: usize = 0
    var i: usize = 0
    while i + lsep <= ls {
        if starts_with_at(s, sep, i) {
            out.push(copy_range(s, start, i))
            i = i + lsep
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(copy_range(s, start, ls))
    return out
}

// Copies `src` into `dst` at byte offset `at` and returns the offset just
// past the end. The pieces of `join` cannot be written with one `String`
// operation, so this is the byte-level form it is built from.
fun copy_into(dst: mut Bytes, at: usize, src: &str).R: usize {
    val n = len(src)
    var i: usize = 0
    while i < n {
        dst.set(at + i, byte(src, i))
        i = i + 1
    }
    return at + n
}

// `parts` joined with `sep` between them. A growable `String` (S1) means the
// pieces can simply be appended: C1 sized the result first and copied once,
// because buffers were fixed-size then.
fun join(parts: List<String>, sep: &str).R: String {
    val count = parts.len()
    val lsep = len(sep)
    var out = String.with_capacity(count * lsep)
    var i: usize = 0
    while i < count {
        if i > 0 {
            out.push_str(sep)
        }
        out.push_str(parts.get(i).as_str())
        i = i + 1
    }
    return out
}

// --- S1: building text, converting numbers ---------------------------------
//
// Everything below is ordinary Kelp on top of the growable buffer
// (`String.push`/`push_str`/`with_capacity`) and the integer conversions
// (`n.to_u8()`), except the three numeric primitives that genuinely need C:
// `snprintf` for the float format, and `strtoll`/`strtoull`/`strtod` for
// parsing. There is no `+` operator for `str` (open item 40): concatenation
// is the function below.

// `a` followed by `b`. The allocation is visible in the signature, which is
// the reason this is not an operator.
fun concat(a: &str, b: &str).R: String {
    var out = String.with_capacity(len(a) + len(b))
    out.push_str(a)
    out.push_str(b)
    return out
}

// Decimal text for an unsigned value. Digits are produced least-significant
// first into a scratch buffer and copied back out in reverse: `%`/`/` on
// `u64` and one checked `to_u8` per digit is the whole algorithm.
fun from_u64(n: u64).R: String {
    if n == 0 {
        return String.from_str("0")
    }
    var rev = String.with_capacity(20)
    var v = n
    while v > 0 {
        rev.push((v % 10 + 48).to_u8())
        v = v / 10
    }
    val digits = rev.as_str()
    var out = String.with_capacity(rev.len())
    var i = rev.len()
    while i > 0 {
        i = i - 1
        out.push(byte(digits, i))
    }
    return out
}

// Decimal text for a signed value. The digits are taken in `i64`, with each
// remainder made positive before it is narrowed, so `i64`'s minimum needs no
// special case — converting it to `u64` first would panic (it is negative),
// and negating it in `i64` would overflow.
fun from_i64(n: i64).R: String {
    if n == 0 {
        return String.from_str("0")
    }
    var neg = false
    var v = n
    if v < 0 {
        neg = true
    }
    var rev = String.with_capacity(20)
    while v != 0 {
        var d = v % 10
        if d < 0 {
            d = 0 - d
        }
        rev.push((d + 48).to_u8())
        v = v / 10
    }
    val digits = rev.as_str()
    var out = String.with_capacity(21)
    if neg {
        out.push(45)
    }
    var i = rev.len()
    while i > 0 {
        i = i - 1
        out.push(byte(digits, i))
    }
    return out
}

// `x` with `decimals` digits after the point, via one `snprintf("%.*f")`.
// `decimals` is not clamped: it is what the caller asked for.
extern fun from_f64_raw(x: f64, decimals: i32).R: String

fun from_f64(x: f64, decimals: i32).R: String = from_f64_raw(x, decimals)

// Why a parse failed (MK5-S6-M1). `Invalid` covers everything the C
// conversion refused, including a value that does not fit the type: the
// primitives report one bit, so a finer reason would have to come from them.
// A payload-less variant is still a variant, which is what lets the failure
// ride in a `Result` and be matched by name.
enum ParseErr {
    Empty
    Invalid
}

// `Ok(v)` only when the *whole* string is one number: no trailing characters,
// no whitespace, no empty string, and a value that fits. The numeric
// conversion itself is one C primitive per type.
extern fun parse_i64_raw(s: &str, out: mut i64).R: bool
extern fun parse_u64_raw(s: &str, out: mut u64).R: bool
extern fun parse_f64_raw(s: &str, out: mut f64).R: bool

fun parse_i64(s: &str).R: result.Result<i64, ParseErr> {
    var v: i64 = 0
    val ok = parse_i64_raw(s, out = v)
    if !ok {
        return result.Result.Err(error = parse_err(s))
    }
    return result.Result.Ok(value = v)
}

fun parse_u64(s: &str).R: result.Result<u64, ParseErr> {
    var v: u64 = 0
    val ok = parse_u64_raw(s, out = v)
    if !ok {
        return result.Result.Err(error = parse_err(s))
    }
    return result.Result.Ok(value = v)
}

// Accepts what `strtod` accepts, minus leading whitespace: decimal and
// exponent forms, and `inf`/`nan`.
fun parse_f64(s: &str).R: result.Result<f64, ParseErr> {
    var v: f64 = 0.0
    val ok = parse_f64_raw(s, out = v)
    if !ok {
        return result.Result.Err(error = parse_err(s))
    }
    return result.Result.Ok(value = v)
}

// The one distinction the primitives leave visible: an empty string is not a
// malformed one.
fun parse_err(s: &str).R: ParseErr {
    if len(s) == 0 {
        return ParseErr.Empty
    }
    return ParseErr.Invalid
}

// Every non-overlapping occurrence of `from` replaced by `to`. An empty
// `from` matches nothing (rather than every position), so the result is a
// copy of `s`.
fun replace(s: &str, from: &str, to: &str).R: String {
    val lf = len(from)
    if lf == 0 {
        return String.from_str(s)
    }
    val ls = len(s)
    var out = String.with_capacity(ls)
    var i: usize = 0
    while i < ls {
        if i + lf <= ls && starts_with_at(s, from, i) {
            out.push_str(to)
            i = i + lf
        } else {
            out.push(byte(s, i))
            i = i + 1
        }
    }
    return out
}

// The byte offset of character `i`, or `len(s)` when there is no such
// character. A byte that does not continue a UTF-8 sequence starts a
// character (the same rule `char_count` uses).
fun byte_index(s: &str, i: usize).R: usize {
    val n = len(s)
    var chars: usize = 0
    var at: usize = 0
    while at < n {
        val c = byte(s, at)
        if c < 128 || c >= 192 {
            if chars == i {
                return at
            }
            chars = chars + 1
        }
        at = at + 1
    }
    return n
}

// The codepoint starting at byte `at`, decoded with arithmetic only — v1 has
// no bitwise operators, so the UTF-8 lead-byte masks are subtractions.
// A truncated sequence returns 0, the same value past-the-end returns.
fun decode_at(s: &str, at: usize).R: u32 {
    val n = len(s)
    val b0 = byte(s, at).to_u32()
    if b0 < 128 {
        return b0
    }
    var cp: u32 = 0
    var extra: usize = 0
    if b0 < 224 {
        cp = b0 - 192
        extra = 1
    } elif b0 < 240 {
        cp = b0 - 224
        extra = 2
    } else {
        cp = b0 - 240
        extra = 3
    }
    var k: usize = 0
    while k < extra {
        if at + 1 + k >= n {
            return 0
        }
        cp = cp * 64 + (byte(s, at + 1 + k).to_u32() - 128)
        k = k + 1
    }
    return cp
}

// The codepoint at character index `i`, or 0 when `i` is past the end.
fun char_at(s: &str, i: usize).R: u32 {
    val at = byte_index(s, i)
    if at >= len(s) {
        return 0
    }
    return decode_at(s, at)
}
