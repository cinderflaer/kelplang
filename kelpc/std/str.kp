//! Text: `&str` and `String` helpers, searching, trimming, splitting and number parsing.
impl "std/mem"
impl "std/option"
impl "std/result"

// BEGIN GENERATED: Unicode simple case table data (kelpc/tools/gen_case_table.pl)
// Unicode 16.0.0 simple case mappings, one entry per code point that changes.
// Generated: do not edit by hand; rerun the generator instead.
// Each table is one string of 16 lowercase hex digits per entry: the code
// point (8 digits), then its simple mapping (8 digits), sorted by code point.

/// The simple uppercase mapping of every code point that changes when uppercased.
/// Each entry is 16 hex digits: the code point, then its uppercase mapping.
const CASE_UPPER_DATA: str = ""
/// The simple lowercase mapping of every code point that changes when lowercased.
/// Each entry is 16 hex digits: the code point, then its lowercase mapping.
const CASE_LOWER_DATA: str = ""
// END GENERATED: Unicode simple case table data

/* The three operations on a `&str` that Kelp cannot express: its byte length, a
   byte at an index, and a borrow of the suffix starting at an index. All
   three bodies are compiler-supplied; the public wrappers below are ordinary
   Kelp code, and they are what callers see.

   The bounds checks live in the compiler-supplied bodies (see `externs.rs`)
   rather than here, so there is exactly one of each and no call site can
   forget it. */
extern fun byte_len_raw(s: &str) => int
extern fun byte_at_raw(s: &str, i: int) => u8
extern fun slice_from_raw(s: &str, from: int) => &str
extern fun byte_ptr_raw(s: &str) => Ptr<u8>

/// Byte length, not character count, see `char_count`, which counts
/// continuation bytes as parts of the same character.
fun len(s: &str) => int = byte_len_raw(s)

/// The byte at `i`.
/// Panics: if `i` is out of bounds.
fun byte(s: &str, i: int) => u8 = byte_at_raw(s, i)

/// The address of the first byte of `s`, which is the NUL-terminated literal
/// itself. Reading through the pointer needs `unsafe`, like any other `Ptr`;
/// taking it does not. This is what a driver that has to hand text to a device
/// walks with `len`/`byte`, and the one `str` operation whose whole body is the
/// identity.
fun ptr(s: &str) => Ptr<u8> = byte_ptr_raw(s)

/// Whether `s` has no bytes.
fun is_empty(s: &str) => bool = len(s) == 0

/// The tail of `s` starting at byte `from`, a view, not a copy, which is
/// what `&str` return elision makes possible: the result borrows `s`.
/// Panics: if `from` is past the end.
fun substring(s: &str, from: int) => &str = slice_from_raw(s, from)

/// How many characters a `&str` has: bytes that do not continue a UTF-8
/// sequence.
fun char_count(s: &str) => int {
    val sv = s.view()
    val n = sv.len()
    var count: int = 0
    var i: int = 0
    while i < n {
        // A byte in 128..191 is a UTF-8 continuation; everything else starts
        // a character. (No bitwise operators in v1, so this is a range test.)
        val c = sv.get(i)
        if c < 128 || c >= 192 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

/// The index of `needle` in `s`, or `None`. The old `Match(ok, at)` datac is
/// gone: a failure that carries no reason is an `Option`, which is what makes
/// `if let Some(at) = ...` and `?` usable at the call site instead of an `ok`
/// flag (MK5-S6-M1).
fun index_of(s: &str, needle: &str) => option.Option<int> {
    // Both views are taken once, here. `starts_with_at` takes a `str` and so
    // re-measures the whole haystack (a `strlen`) at every position, which made
    // a search O(n) per byte.
    val sv = s.view()
    val nv = needle.view()
    val ls = sv.len()
    val ln = nv.len()
    if ln == 0 {
        return option.Option.Some(value = 0)
    }
    if ln > ls {
        return option.Option.None
    }
    var i: int = 0
    while i + ln <= ls {
        if view_starts_with_at(sv, nv, i) {
            return option.Option.Some(value = i)
        }
        i = i + 1
    }
    return option.Option.None
}

/// Whether `needle` occurs in `s` starting exactly at byte `at`. Private to
/// the module in practice (nothing outside needs the offset form).
fun starts_with_at(s: &str, needle: &str, at: int) => bool {
    val sv = s.view()
    val nv = needle.view()
    val ln = nv.len()
    var i: int = 0
    while i < ln {
        if sv.get(at + i) != nv.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Whether `s` begins with `prefix`.
fun starts_with(s: &str, prefix: &str) => bool {
    if len(prefix) > len(s) {
        return false
    }
    return starts_with_at(s, prefix, 0)
}

/// Whether `s` ends with `suffix`.
fun ends_with(s: &str, suffix: &str) => bool {
    val ls = len(s)
    val lf = len(suffix)
    if lf > ls {
        return false
    }
    return starts_with_at(s, suffix, ls - lf)
}

/// Whether `needle` occurs in `s`.
fun contains(s: &str, needle: &str) => bool {
    return option.is_some(o = index_of(s, needle))
}

/// Text equality, which `==` deliberately does not provide for `str` (it
/// would compare addresses, see `infer.rs::comparable`).
fun eq(a: &str, b: &str) => bool = a.view().eq(b.view())

/// Byte-wise ordering, the `<` that `str` deliberately does not have: `eq` above
/// explains why `==` compares addresses rather than bytes, and the same argument
/// applies to every other operator, so a caller that has to *order* text has to
/// say which order it means. This is the answer that matches `List<T>.sort` on a
/// `List<u8>`: compare at the first byte that differs, and when one text is a
/// prefix of the other the shorter one is less.
///
/// It is here rather than in each caller because the catalogue already wrote it
/// once: `fpl/json` has a private `str_less` with this exact rule in its doc
/// comment, used by `write_sorted` to order keys. A consumer that sorts a
/// `List<String>` had no way to help it, because a library cannot import a
/// sibling library and std had no comparison to offer. Bytes, not codepoints, so
/// the answer is stable for any UTF-8 input and costs no allocation.
fun less(a: &str, b: &str) => bool {
    val av = a.view()
    val bv = b.view()
    val na = av.len()
    val nb = bv.len()
    var i: int = 0
    val limit = if nb < na { nb } else { na }
    while i < limit {
        val ca = av.get(i)
        val cb = bv.get(i)
        if ca != cb {
            return ca < cb
        }
        i = i + 1
    }
    return na < nb
}

/// Whether the byte `c` is a space, tab, newline or carriage return.
fun is_space(c: u8) => bool = c == 32 || c == 9 || c == 10 || c == 13

/// The decimal-digit predicate that pairs with `is_space`.
///
/// The catalogue wrote it seven times before std had it. Two libraries with a
/// private copy: `fpl/json` (line 1444, beside a second inline check at 1790) and
/// `fpl/decimal`. Two spelling it as two magic numbers instead of two literals:
/// `fpl/encoding` (three times: the `0`-`9` arm of a base64 value, of an
/// unreserved-URL test, and of `hex_value`) and `fpl/httpx` (once, in the same URL
/// test). One implementation is one place to be right about the endpoints, and
/// `c >= '0' && c <= '9'` is the spelling that can be read. ASCII only, like
/// `to_upper` and `is_space`.
fun is_digit(c: u8) => bool = c >= '0' && c <= '9'

/// Leading whitespace is skipped by advancing the pointer, so this is a view
/// of `s` rather than a copy.
fun trim_start(s: &str) => &str {
    val sv = s.view()
    val n = sv.len()
    var i: int = 0
    while i < n && is_space(sv.get(i)) {
        i = i + 1
    }
    return slice_from_raw(s, i)
}

/// Trailing whitespace is *truncation*, which a `&str` (a NUL-terminated C
/// string) cannot represent, there is nowhere to put the terminator. So the
/// end-trimming functions return an owned `String` and allocate, while the
/// start-trimming ones stay views. This is the one place M6.3 diverges from
/// the plan's `str` sketch.
fun trim_end(s: &str) => String {
    val sv = s.view()
    val n = sv.len()
    var end: int = n
    while end > 0 && is_space(sv.get(end - 1)) {
        end = end - 1
    }
    return prefix(s, end)
}

/// The first `n` bytes of `s`, as an owned copy. Truncation cannot be a view:
/// a `&str` is a NUL-terminated C string, and there is nowhere in the original
/// buffer to put a terminator.
/// Panics: if `n` is past the end of `s`.
fun prefix(s: &str, n: int) => String {
    val sv = s.view()
    var out = mem.alloc(n)
    var i: int = 0
    while i < n {
        out.set(i, sv.get(i))
        i = i + 1
    }
    return String.from_bytes(out)
}

/// `s` without leading and trailing whitespace.
fun trim(s: &str) => String = trim_end(trim_start(s))

/// The byte width of the well-formed UTF-8 sequence that starts at byte `i` of
/// `sv`, from 1 to 4. Zero when the bytes there are not one: a stray
/// continuation byte, an overlong or surrogate encoding, or a sequence cut off
/// by the end of the string.
fun utf8_width(sv: View, i: int) => int {
    val n = sv.len()
    val b0 = sv.get(i)
    var w: int = 0
    if b0 < 128 {
        return 1
    } elif b0 >= 194 && b0 <= 223 {
        w = 2
    } elif b0 >= 224 && b0 <= 239 {
        w = 3
    } elif b0 >= 240 && b0 <= 244 {
        w = 4
    } else {
        return 0
    }
    if i + w > n {
        return 0
    }
    // The second byte has narrower bounds after a lead byte that would
    // otherwise allow an overlong encoding or a surrogate.
    var lo: u8 = 128
    var hi: u8 = 191
    if b0 == 224 {
        lo = 160
    }
    if b0 == 237 {
        hi = 159
    }
    if b0 == 240 {
        lo = 144
    }
    if b0 == 244 {
        hi = 143
    }
    var k: int = 1
    while k < w {
        val b = sv.get(i + k)
        if b < lo || b > hi {
            return 0
        }
        lo = 128
        hi = 191
        k = k + 1
    }
    return w
}

/// The codepoint of the `w`-byte well-formed sequence at byte `i` of `sv`,
/// where `w` is what `utf8_width` returned for it.
fun utf8_decode(sv: View, i: int, w: int) => u32 {
    val b0 = sv.get(i).to_u32()
    if w == 1 {
        return b0
    }
    var cp: u32 = 0
    if w == 2 {
        cp = b0 - 192
    } elif w == 3 {
        cp = b0 - 224
    } else {
        cp = b0 - 240
    }
    var k: int = 1
    while k < w {
        cp = cp * 64 + (sv.get(i + k).to_u32() - 128)
        k = k + 1
    }
    return cp
}

/// The number of bytes the UTF-8 encoding of `cp` takes.
fun utf8_len(cp: u32) => int {
    if cp < 128 {
        return 1
    } elif cp < 2048 {
        return 2
    } elif cp < 65536 {
        return 3
    }
    return 4
}

/// Writes the UTF-8 encoding of `cp` into `dst` from byte `at`, and returns
/// how many bytes it wrote.
fun utf8_put(dst: mut Bytes, at: int, cp: u32) => int {
    val w = utf8_len(cp)
    if w == 1 {
        dst.set(at, cp.to_byte())
    } elif w == 2 {
        dst.set(at, (192 + cp / 64).to_byte())
        dst.set(at + 1, (128 + cp % 64).to_byte())
    } elif w == 3 {
        dst.set(at, (224 + cp / 4096).to_byte())
        dst.set(at + 1, (128 + (cp / 64) % 64).to_byte())
        dst.set(at + 2, (128 + cp % 64).to_byte())
    } else {
        dst.set(at, (240 + cp / 262144).to_byte())
        dst.set(at + 1, (128 + (cp / 4096) % 64).to_byte())
        dst.set(at + 2, (128 + (cp / 64) % 64).to_byte())
        dst.set(at + 3, (128 + cp % 64).to_byte())
    }
    return w
}

/// `s` with each codepoint replaced by its simple case mapping: the uppercase
/// one when `upper`, the lowercase one otherwise. Bytes that are not
/// well-formed UTF-8 are copied unchanged.
///
/// A simple mapping can change the length of a sequence (U+023A lowercases to
/// a three-byte sequence), so the output is sized by a first pass over `s`.
fun map_case(s: &str, upper: bool) => String {
    val sv = s.view()
    val n = sv.len()
    var size: int = 0
    var i: int = 0
    while i < n {
        val w = utf8_width(sv, i)
        if w == 0 {
            size = size + 1
            i = i + 1
        } else {
            val cp = utf8_decode(sv, i, w)
            val m = if upper { case_upper_cp(cp) } else { case_lower_cp(cp) }
            size = size + utf8_len(m)
            i = i + w
        }
    }
    var out = mem.alloc(size)
    var o: int = 0
    i = 0
    while i < n {
        val w = utf8_width(sv, i)
        if w == 0 {
            out.set(o, sv.get(i))
            o = o + 1
            i = i + 1
        } else {
            val cp = utf8_decode(sv, i, w)
            val m = if upper { case_upper_cp(cp) } else { case_lower_cp(cp) }
            o = o + utf8_put(out, o, m)
            i = i + w
        }
    }
    return String.from_bytes(out)
}

/// `s` with every letter that has a simple uppercase mapping in Unicode
/// uppercased: Latin, Greek, Cyrillic and the rest of the table in
/// `kelpc/std/str.kp`'s generated block. Only simple mappings are applied, so
/// U+00DF (sharp s) stays as it is, since its full uppercase is two letters.
fun to_upper(s: &str) => String = map_case(s, true)

/// `s` with every letter that has a simple lowercase mapping in Unicode
/// lowercased, by the same table as `to_upper`. U+0130 (dotted capital I)
/// lowercases to U+0069 under the simple mapping, not to two codepoints.
fun to_lower(s: &str) => String = map_case(s, false)

/// Whether byte `at` of `sv` can begin a codepoint: true at the end of the
/// string, and wherever the byte is not a UTF-8 continuation byte (128 to 191).
fun is_codepoint_start(sv: View, at: int) => bool {
    if at >= sv.len() {
        return true
    }
    val b = sv.get(at)
    return b < 128 || b >= 192
}

/// The bytes [from, to) of `s`, as a fresh owned `String`, with both ends
/// checked to fall on codepoint boundaries. A boundary is where a codepoint
/// begins, or the end of `s`; a byte offset inside a multi-byte codepoint is
/// refused, since the piece would hold half a character.
/// Panics: when `to` is past the end of `s`, when `from` is past `to`, or when
/// either end lies inside a codepoint. Byte-offset helpers such as `copy_range`
/// and `prefix` do not check, and keep their byte semantics.
fun slice(s: &str, from: int, to: int) => String {
    val sv = s.view()
    if to > sv.len() {
        panic("str.slice: end is past the end of the string")
    }
    if from > to {
        panic("str.slice: start is after end")
    }
    if !is_codepoint_start(sv, from) {
        val msg = bad_boundary_message(from)
        panic(msg)
    }
    if !is_codepoint_start(sv, to) {
        val msg = bad_boundary_message(to)
        panic(msg)
    }
    return copy_range(s, from, to)
}

/// The panic text for a byte offset inside a codepoint.
fun bad_boundary_message(at: int) => String {
    val digits = from_u64(at.to_u64())
    val head = concat("str.slice: byte ", digits.as_str())
    return concat(head, " is inside a codepoint")
}

// BEGIN GENERATED: Unicode simple case lookup (kelpc/tools/gen_case_table.pl)
// Lookup over the table data above. A code point with no entry maps to itself.

/// The eight hex digits at byte `at` of `data`, read as a u32.
fun case_hex32(data: &str, at: int) => u32 {
    var acc: u32 = 0
    var k: int = 0
    while k < 8 {
        val c = byte(data, at + k).to_u32()
        var d: u32 = 0
        if c >= 97 { d = c - 87 } else { d = c - 48 }
        acc = acc * 16 + d
        k = k + 1
    }
    return acc
}

/// The mapping of `cp` in `data` (a table built as above), or `cp` itself.
fun case_lookup(data: &str, cp: u32) => u32 {
    var lo: int = 0
    var hi: int = len(data) / 16
    while lo < hi {
        val mid = lo + (hi - lo) / 2
        val key = case_hex32(data, mid * 16)
        if key == cp { return case_hex32(data, mid * 16 + 8) }
        if key < cp { lo = mid + 1 } else { hi = mid }
    }
    return cp
}

/// The simple uppercase mapping of code point `cp`, or `cp` itself.
fun case_upper_cp(cp: u32) => u32 = case_lookup(CASE_UPPER_DATA, cp)

/// The simple lowercase mapping of code point `cp`, or `cp` itself.
fun case_lower_cp(cp: u32) => u32 = case_lookup(CASE_LOWER_DATA, cp)
// END GENERATED: Unicode simple case lookup

/// `s` repeated `n` times.
fun repeat(s: &str, n: int) => String {
    val sv = s.view()
    val ls = sv.len()
    var out = mem.alloc(ls * n)
    var i: int = 0
    while i < n {
        var j: int = 0
        while j < ls {
            out.set(i * ls + j, sv.get(j))
            j = j + 1
        }
        i = i + 1
    }
    return String.from_bytes(out)
}

/// Copies bytes [from, to) of `s` into a fresh owned `String`. A range that
/// is neither a prefix nor a suffix cannot be a view (a `&str` is a
/// NUL-terminated C string), so it is copied, the same reason `prefix`
/// allocates.
fun copy_range(s: &str, from: int, to: int) => String {
    val sv = s.view()
    var out = mem.alloc(to - from)
    var i: int = 0
    while i < to - from {
        out.set(i, sv.get(from + i))
        i = i + 1
    }
    return String.from_bytes(out)
}

/// Splits `s` on every occurrence of `sep`. An empty `sep` yields one piece
/// (the whole string) rather than an infinite number of empty ones.
///
/// The last piece is always returned, including the empty one after a
/// trailing separator: "a," splits into ["a", ""].
fun split(s: &str, sep: &str) => List<String> {
    var out: List<String> = List.empty()
    // One `strlen` for each of the two arguments, up front: `starts_with_at` and `copy_range`
    // each take a `str` and re-derive its length, which made a split O(n) per position.
    val sv = s.view()
    val nv = sep.view()
    val ls = sv.len()
    val lsep = nv.len()
    if lsep == 0 {
        out.push(String.from_str(s))
        return out
    }
    // The first byte of `sep` is compared before the call: almost every position fails there,
    // and the full comparison is a call with a bounds-checked loop per position.
    val first = nv.get(0)
    var start: int = 0
    var i: int = 0
    while i + lsep <= ls {
        if sv.get(i) == first && view_starts_with_at(sv, nv, i) {
            out.push(sv.slice(start, i).to_string())
            i = i + lsep
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(sv.slice(start, ls).to_string())
    return out
}

/// `starts_with_at` on views whose lengths are already known.
fun view_starts_with_at(sv: View, nv: View, at: int) => bool {
    val ln = nv.len()
    var i: int = 0
    while i < ln {
        if sv.get(at + i) != nv.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Copies `src` into `dst` at byte offset `at` and returns the offset just
/// past the end. The pieces of `join` cannot be written with one `String`
/// operation, so this is the byte-level form it is built from.
fun copy_into(dst: mut Bytes, at: int, src: &str) => int {
    val sv = src.view()
    val n = sv.len()
    var i: int = 0
    while i < n {
        dst.set(at + i, sv.get(i))
        i = i + 1
    }
    return at + n
}

/// `parts` joined with `sep` between them. A growable `String` (S1) means the
/// pieces can simply be appended: C1 sized the result first and copied once,
/// because buffers were fixed-size then.
fun join(parts: List<String>, sep: &str) => String {
    val count = parts.len()
    val lsep = len(sep)
    var out = String.with_capacity(count * lsep)
    var i: int = 0
    while i < count {
        if i > 0 {
            out.push_str(sep)
        }
        out.push_str(parts.get(i).as_str())
        i = i + 1
    }
    return out
}

// --- S1: building text, converting numbers ---------------------------------
//
// Everything below is ordinary Kelp on top of the growable buffer
// (`String.push`/`push_str`/`with_capacity`) and the integer conversions
// (`n.to_byte()`), except the three numeric primitives that genuinely need C:
// `snprintf` for the float format, and `strtoll`/`strtoull`/`strtod` for
// parsing. There is no `+` operator for `str` (open item 40): concatenation
// is the function below.

/// `a` followed by `b`. The allocation is visible in the signature, which is
/// the reason this is not an operator.
fun concat(a: &str, b: &str) => String {
    var out = String.with_capacity(len(a) + len(b))
    out.push_str(a)
    out.push_str(b)
    return out
}

/// Decimal text for an unsigned value. Digits are produced least-significant
/// first into a 20-byte scratch array on the stack and pushed back out in
/// reverse: `%`/`/` on `u64` and one checked `to_byte` per digit is the whole
/// algorithm, and the only allocation is the result.
fun from_u64(n: u64) => String {
    if n == 0 {
        return String.from_str("0")
    }
    var rev: [u8; 20] = [0; 20]
    var count: int = 0
    var v = n
    while v > 0 {
        rev.set(count, (v % 10 + 48).to_byte())
        count = count + 1
        v = v / 10
    }
    var out = String.with_capacity(count)
    var i = count
    while i > 0 {
        i = i - 1
        out.push(rev.get(i))
    }
    return out
}

/// Decimal text for a signed value. The digits are taken in `i64`, with each
/// remainder made positive before it is narrowed, so `i64`'s minimum needs no
/// special case, converting it to `u64` first would panic (it is negative),
/// and negating it in `i64` would overflow. Like `from_u64` it collects the
/// digits in a stack array (at most 19 for an `i64`), so the result is the
/// only allocation.
fun from_i64(n: i64) => String {
    if n == 0 {
        return String.from_str("0")
    }
    var neg = false
    var v = n
    if v < 0 {
        neg = true
    }
    var rev: [u8; 20] = [0; 20]
    var count: int = 0
    while v != 0 {
        var d = v % 10
        if d < 0 {
            d = 0 - d
        }
        rev.set(count, (d + 48).to_byte())
        count = count + 1
        v = v / 10
    }
    var out = String.with_capacity(21)
    if neg {
        out.push(45)
    }
    var i = count
    while i > 0 {
        i = i - 1
        out.push(rev.get(i))
    }
    return out
}

// `x` with `decimals` digits after the point, via one `snprintf("%.*f")`.
// `decimals` is not clamped: it is what the caller asked for.
extern fun from_f64_raw(x: f64, decimals: i32) => String

/// `x` written with `decimals` digits after the point.
fun from_f64(x: f64, decimals: i32) => String = from_f64_raw(x, decimals)

/// Why a parse failed (MK5-S6-M1). `Invalid` covers everything the C
/// conversion refused, including a value that does not fit the type: the
/// primitives report one bit, so a finer reason would have to come from them.
/// A payload-less variant is still a variant, which is what lets the failure
/// ride in a `Result` and be matched by name.
enum ParseErr {
    /// The text was empty.
    Empty
    /// The text is not a number.
    Invalid
}

// `Ok(v)` only when the *whole* string is one number: no trailing characters,
// no whitespace, no empty string, and a value that fits. The numeric
// conversion itself is one C primitive per type.
extern fun parse_i64_raw(s: &str, out: mut i64) => bool
extern fun parse_u64_raw(s: &str, out: mut u64) => bool
extern fun parse_f64_raw(s: &str, out: mut f64) => bool

/// Parses `s` as a signed 64-bit integer.
fun parse_i64(s: &str) => result.Result<i64, ParseErr> {
    var v: i64 = 0
    val ok = parse_i64_raw(s, out = v)
    if !ok {
        return result.Result.Err(error = parse_err(s))
    }
    return result.Result.Ok(value = v)
}

/// Parses `s` as an unsigned 64-bit integer.
fun parse_u64(s: &str) => result.Result<u64, ParseErr> {
    var v: u64 = 0
    val ok = parse_u64_raw(s, out = v)
    if !ok {
        return result.Result.Err(error = parse_err(s))
    }
    return result.Result.Ok(value = v)
}

/// Accepts what `strtod` accepts, minus leading whitespace: decimal and
/// exponent forms, and `inf`/`nan`.
fun parse_f64(s: &str) => result.Result<f64, ParseErr> {
    var v: f64 = 0.0
    val ok = parse_f64_raw(s, out = v)
    if !ok {
        return result.Result.Err(error = parse_err(s))
    }
    return result.Result.Ok(value = v)
}

/// The one distinction the primitives leave visible: an empty string is not a
/// malformed one.
fun parse_err(s: &str) => ParseErr {
    if len(s) == 0 {
        return ParseErr.Empty
    }
    return ParseErr.Invalid
}

/// Every non-overlapping occurrence of `from` replaced by `to`. An empty
/// `from` matches nothing (rather than every position), so the result is a
/// copy of `s`.
fun replace(s: &str, from: &str, to: &str) => String {
    val fv = from.view()
    val lf = fv.len()
    if lf == 0 {
        return String.from_str(s)
    }
    val sv = s.view()
    val ls = sv.len()
    var out = String.with_capacity(ls)
    var i: int = 0
    while i < ls {
        if i + lf <= ls && view_starts_with_at(sv, fv, i) {
            out.push_str(to)
            i = i + lf
        } else {
            out.push(sv.get(i))
            i = i + 1
        }
    }
    return out
}

/// The byte offset of character `i`, or `len(s)` when there is no such
/// character. A byte that does not continue a UTF-8 sequence starts a
/// character (the same rule `char_count` uses).
fun byte_index(s: &str, i: int) => int {
    val sv = s.view()
    val n = sv.len()
    var chars: int = 0
    var at: int = 0
    while at < n {
        val c = sv.get(at)
        if c < 128 || c >= 192 {
            if chars == i {
                return at
            }
            chars = chars + 1
        }
        at = at + 1
    }
    return n
}

/// The codepoint starting at byte `at`, decoded with arithmetic only, v1 has
/// no bitwise operators, so the UTF-8 lead-byte masks are subtractions.
/// A truncated sequence returns 0, the same value past-the-end returns.
fun decode_at(s: &str, at: int) => u32 {
    val sv = s.view()
    val n = sv.len()
    val b0 = sv.get(at).to_u32()
    if b0 < 128 {
        return b0
    }
    var cp: u32 = 0
    var extra: int = 0
    if b0 < 224 {
        cp = b0 - 192
        extra = 1
    } elif b0 < 240 {
        cp = b0 - 224
        extra = 2
    } else {
        cp = b0 - 240
        extra = 3
    }
    var k: int = 0
    while k < extra {
        if at + 1 + k >= n {
            return 0
        }
        cp = cp * 64 + (sv.get(at + 1 + k).to_u32() - 128)
        k = k + 1
    }
    return cp
}

/// The codepoint at character index `i`, or 0 when `i` is past the end.
fun char_at(s: &str, i: int) => u32 {
    val at = byte_index(s, i)
    if at >= len(s) {
        return 0
    }
    return decode_at(s, at)
}
