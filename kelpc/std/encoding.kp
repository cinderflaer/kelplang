impl "std/str"
impl "std/option"
impl "std/result"
impl "std/fmt"

/* std/encoding: base64, base32, base58, hex and percent encoding, plus
   `sha1`.

   Five alphabets, and nothing here touches the outside world, so the module
   is ungated. Every encoder takes `&Bytes` and returns `String`, every decoder
   takes `&str` and returns `Result<Bytes, DecodeErr>`: one alphabet table per
   scheme, one failure case, no half-success.

   The one hash is here for the same reason the encoders are: no resource, no
   state, and bytes in for bytes out. `sha1` exists because the WebSocket
   handshake needs it (`std/ws`'s `Sec-WebSocket-Accept`) and RFC 6455 fixes
   the function, not because a digest is recommended: SHA-1 is not collision
   resistant any more, and nothing here uses it for authentication.

   The same handful of encoders used to exist three times over, in `fpl/encoding`
   and again inside `fpl/httpx`'s and `std/http`'s private copies. This is the
   module boundary those copies were waiting for.

   Percent-encoding is the URL form: a space is `%20`, so a space never becomes
   `+`. The `application/x-www-form-urlencoded` form, where `+` *is* a space, is
   the separate `form_encode`/`form_decode` pair. Keeping them apart is the
   point: guessing which one a caller meant is how a `%2B` turns into a space. */

/// The base64 alphabet (RFC 4648 section 4): `A`-`Z`, `a`-`z`, `0`-`9`, `+` and `/`.
const B64_ALPHABET: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
/// The base32 alphabet (RFC 4648 section 6): `A`-`Z`, then `2`-`7`.
const B32_ALPHABET: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
/// The base58 alphabet, Bitcoin's: digits and letters with `0`, `O`, `I` and `l` left out.
const B58_ALPHABET: str = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

/// One failure for every decoder here: the input is not in the alphabet, or its
/// shape is not the one the scheme defines. The decoders carry no position, so
/// there is nothing for a richer error to say.
enum DecodeErr {
    /// The input is not valid for the scheme.
    Invalid
}

/// The character for a 6-bit value. The alphabet is A-Z, a-z, 0-9, `+`, `/` in
/// that order, so the value maps by range. The `str.byte` lookup it replaces
/// scanned the alphabet for its NUL on every character. A value past 63 still
/// goes through that lookup, so it panics exactly as before.
fun b64_char(v: u8) => u8 {
    if v < 26 {
        return v + 65
    }
    if v < 52 {
        return v - 26 + 97
    }
    if v < 62 {
        return v - 52 + 48
    }
    if v == 62 {
        return 43
    }
    if v == 63 {
        return 47
    }
    return str.byte(B64_ALPHABET, v.to_usize())
}

/// The 6-bit value a base64 character encodes, or `None` for `=` and anything
/// outside the alphabet.
fun b64_value(c: u8) => option.Option<u8> {
    if c >= 65 && c <= 90 {
        return option.Option.Some(value = c - 65)
    }
    if c >= 97 && c <= 122 {
        return option.Option.Some(value = c - 97 + 26)
    }
    if str.is_digit(c) {
        return option.Option.Some(value = c - 48 + 52)
    }
    if c == 43 {
        return option.Option.Some(value = 62)
    }
    if c == 47 {
        return option.Option.Some(value = 63)
    }
    return option.Option.None
}

/// The base64 text for `data`, RFC 4648 standard alphabet, padded with `=`.
fun base64_encode(data: &Bytes) => String {
    val n = data.len()
    var out = String.with_capacity((n + 2) / 3 * 4)
    var i: usize = 0
    while i + 3 <= n {
        val b0 = data.get(i)
        val b1 = data.get(i + 1)
        val b2 = data.get(i + 2)
        out.push(b64_char(b0 >> 2))
        out.push(b64_char(((b0 & 3) << 4) | (b1 >> 4)))
        out.push(b64_char(((b1 & 15) << 2) | (b2 >> 6)))
        out.push(b64_char(b2 & 63))
        i = i + 3
    }
    val rem = n - i
    if rem == 1 {
        val b0 = data.get(i)
        out.push(b64_char(b0 >> 2))
        out.push(b64_char((b0 & 3) << 4))
        out.push('=')
        out.push('=')
    } elif rem == 2 {
        val b0 = data.get(i)
        val b1 = data.get(i + 1)
        out.push(b64_char(b0 >> 2))
        out.push(b64_char(((b0 & 3) << 4) | (b1 >> 4)))
        out.push(b64_char((b1 & 15) << 2))
        out.push('=')
    }
    return out
}

/// The bytes `text` decodes to. `Err(Invalid)` on a length that is not a
/// multiple of 4, a character outside the alphabet, or `=` anywhere but the
/// last one or two positions. Whitespace is not skipped: trim first if the
/// source may contain line breaks.
fun base64_decode(text: &str) => result.Result<Bytes, DecodeErr> {
    val tv = text.view()
    val n = tv.len()
    if n == 0 {
        return result.Result.Ok(value = Bytes.empty())
    }
    if n % 4 != 0 {
        return result.Result.Err(error = DecodeErr.Invalid)
    }
    var out = Bytes.empty()
    var i: usize = 0
    while i < n {
        val c0 = tv.get(i)
        val c1 = tv.get(i + 1)
        val c2 = tv.get(i + 2)
        val c3 = tv.get(i + 3)

        val v0o = b64_value(c0)
        val v1o = b64_value(c1)
        if option.is_none(o = v0o) || option.is_none(o = v1o) {
            return result.Result.Err(error = DecodeErr.Invalid)
        }
        val v0 = option.unwrap(o = v0o)
        val v1 = option.unwrap(o = v1o)
        out.push((v0 << 2) | (v1 >> 4))

        val last = i + 4 == n
        if c2 == '=' {
            if !last || c3 != '=' {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
        } else {
            val v2o = b64_value(c2)
            if option.is_none(o = v2o) {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
            val v2 = option.unwrap(o = v2o)
            out.push(((v1 & 15) << 4) | (v2 >> 2))

            if c3 == '=' {
                if !last {
                    return result.Result.Err(error = DecodeErr.Invalid)
                }
            } else {
                val v3o = b64_value(c3)
                if option.is_none(o = v3o) {
                    return result.Result.Err(error = DecodeErr.Invalid)
                }
                val v3 = option.unwrap(o = v3o)
                out.push(((v2 & 3) << 6) | v3)
            }
        }
        i = i + 4
    }
    return result.Result.Ok(value = out)
}

/// The character for a 5-bit value. The alphabet is A-Z then 2-7, so the value
/// maps by range. A value past 31 still goes through the `str.byte` lookup, so it
/// panics exactly as before.
fun b32_char(v: u8) => u8 {
    if v < 26 {
        return v + 65
    }
    if v < 32 {
        return v - 26 + 50
    }
    return str.byte(B32_ALPHABET, v.to_usize())
}

/// The 5-bit value a base32 character encodes, or `None` for `=` and anything
/// outside the alphabet. Lowercase is refused rather than folded: RFC 4648's
/// reference encoder emits uppercase, and TOTP secrets are uppercased by the
/// tools that print them.
fun b32_value(c: u8) => option.Option<u8> {
    if c >= 65 && c <= 90 {
        return option.Option.Some(value = c - 65)
    }
    if c >= 50 && c <= 55 {
        return option.Option.Some(value = c - 50 + 26)
    }
    return option.Option.None
}

/// The base32 text for `data`, RFC 4648 §6 alphabet (`A`-`Z` then `2`-`7`),
/// padded with `=` to a multiple of 8 characters.
fun base32_encode(data: &Bytes) => String {
    val n = data.len()
    if n == 0 {
        return String.empty()
    }
    val out_len = (n + 4) / 5 * 8
    var out = String.with_capacity(out_len)
    var buffer: u32 = 0
    var bits: u32 = 0
    var i: usize = 0
    while i < n {
        // Keep the low 12 bits only: `bits` is 0-4 when the inner loop ends,
        // so `bits + 8` is at most 12 and everything above is consumed.
        buffer = ((buffer << 8) | data.get(i).to_u32()) & 4095
        bits = bits + 8
        while bits >= 5 {
            bits = bits - 5
            out.push(b32_char(((buffer >> bits) & 31).to_u8()))
        }
        i = i + 1
    }
    if bits > 0 {
        out.push(b32_char(((buffer << (5 - bits)) & 31).to_u8()))
    }
    while out.len() < out_len {
        out.push('=')
    }
    return out
}

/// `Err(Invalid)` on a length that is not a multiple of 8, a character outside
/// the alphabet, `=` before the final group, or a final group whose length and
/// leftover bits do not match one of the RFC 4648 cases (2, 4, 5 or 7
/// characters of data). The leftover bits must be zero, as the reference
/// decoder requires.
fun base32_decode(text: &str) => result.Result<Bytes, DecodeErr> {
    val tv = text.view()
    val n = tv.len()
    if n == 0 {
        return result.Result.Ok(value = Bytes.empty())
    }
    if n % 8 != 0 {
        return result.Result.Err(error = DecodeErr.Invalid)
    }
    var out = Bytes.empty()
    var buffer: u32 = 0
    var bits: u32 = 0
    var padded = false
    var seen_data = false
    var i: usize = 0
    while i < n {
        val c = tv.get(i)
        if c == '=' {
            padded = true
        } else {
            seen_data = true
            if padded {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
            val v = b32_value(c)
            if option.is_none(o = v) {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
            buffer = ((buffer << 5) | option.unwrap(o = v).to_u32()) & 8191
            bits = bits + 5
            if bits >= 8 {
                bits = bits - 8
                out.push(((buffer >> bits) & 255).to_u8())
            }
        }
        i = i + 1
    }
    if !seen_data {
        return result.Result.Err(error = DecodeErr.Invalid)
    }
    if bits >= 5 {
        return result.Result.Err(error = DecodeErr.Invalid)
    }
    if bits > 0 && (buffer & ((1 << bits) - 1)) != 0 {
        return result.Result.Err(error = DecodeErr.Invalid)
    }
    return result.Result.Ok(value = out)
}

/// The base58 character for a value, `0` to `57`. A value past 57 goes through the
/// `str.byte` lookup, so it panics.
fun b58_char(v: u8) => u8 = str.byte(B58_ALPHABET, v.to_usize())

/// The value of a base58 character, or `None` for anything outside the
/// Bitcoin alphabet (which drops `0`, `O`, `I` and `l`, so a transcribed value
/// cannot be read two ways).
fun b58_value(c: u8) => option.Option<u8> {
    if c >= 49 && c <= 57 {
        return option.Option.Some(value = c - 49)
    }
    if c >= 65 && c <= 72 {
        return option.Option.Some(value = c - 65 + 9)
    }
    if c >= 74 && c <= 78 {
        return option.Option.Some(value = c - 74 + 17)
    }
    if c >= 80 && c <= 90 {
        return option.Option.Some(value = c - 80 + 22)
    }
    if c >= 97 && c <= 107 {
        return option.Option.Some(value = c - 97 + 33)
    }
    if c >= 109 && c <= 122 {
        return option.Option.Some(value = c - 109 + 44)
    }
    return option.Option.None
}

/// The base58 text for `data`, Bitcoin alphabet, no padding. Encoding is long
/// division by 58 over the byte buffer rather than a bit split, because 58 is
/// not a power of two. Leading zero bytes become leading `1`s, as the usual
/// implementations do.
fun base58_encode(data: &Bytes) => String {
    val n = data.len()
    if n == 0 {
        return String.empty()
    }
    var zeros: usize = 0
    while zeros < n && data.get(zeros) == 0 {
        zeros = zeros + 1
    }
    var digits: List<u8> = List.empty()
    var i = zeros
    while i < n {
        var carry: u32 = data.get(i).to_u32()
        var j: usize = 0
        while j < digits.len() {
            val v = carry + digits.get(j).to_u32() * 256
            digits.set(j, (v % 58).to_u8())
            carry = v / 58
            j = j + 1
        }
        while carry > 0 {
            digits.push((carry % 58).to_u8())
            carry = carry / 58
        }
        i = i + 1
    }
    var out = String.with_capacity(zeros + digits.len())
    var z: usize = 0
    while z < zeros {
        out.push('1')
        z = z + 1
    }
    var k = digits.len()
    while k > 0 {
        k = k - 1
        out.push(b58_char(digits.get(k)))
    }
    return out
}

/// `Err(Invalid)` on a character outside the alphabet. An empty string decodes
/// to empty `Bytes`; `"1"` decodes to one zero byte.
fun base58_decode(text: &str) => result.Result<Bytes, DecodeErr> {
    val tv = text.view()
    val n = tv.len()
    if n == 0 {
        return result.Result.Ok(value = Bytes.empty())
    }
    var zeros: usize = 0
    while zeros < n && tv.get(zeros) == '1' {
        zeros = zeros + 1
    }
    var acc: List<u8> = List.empty()
    var i = zeros
    while i < n {
        val v = b58_value(tv.get(i))
        if option.is_none(o = v) {
            return result.Result.Err(error = DecodeErr.Invalid)
        }
        var carry: u32 = option.unwrap(o = v).to_u32()
        var j: usize = 0
        while j < acc.len() {
            val x = carry + acc.get(j).to_u32() * 58
            acc.set(j, (x & 255).to_u8())
            carry = x >> 8
            j = j + 1
        }
        while carry > 0 {
            acc.push((carry & 255).to_u8())
            carry = carry >> 8
        }
        i = i + 1
    }
    var out = Bytes.empty()
    var z: usize = 0
    while z < zeros {
        out.push(0)
        z = z + 1
    }
    var k = acc.len()
    while k > 0 {
        k = k - 1
        out.push(acc.get(k))
    }
    return result.Result.Ok(value = out)
}

/// The uppercase hex digit for a nibble (`0` to `15`), as an ASCII byte.
fun hex_upper(nibble: u8) => u8 {
    if nibble < 10 {
        return nibble + 48
    }
    return nibble - 10 + 65
}

/// The lowercase hex digit for a nibble (`0` to `15`), as an ASCII byte.
fun hex_lower(nibble: u8) => u8 {
    if nibble < 10 {
        return nibble + 48
    }
    return nibble - 10 + 97
}

/// The value of a hex digit in either case, or `None` for any other byte.
fun hex_value(c: u8) => option.Option<u8> {
    if str.is_digit(c) {
        return option.Option.Some(value = c - 48)
    }
    if c >= 97 && c <= 102 {
        return option.Option.Some(value = c - 97 + 10)
    }
    if c >= 65 && c <= 70 {
        return option.Option.Some(value = c - 65 + 10)
    }
    return option.Option.None
}

/// Lowercase, two characters per byte. `std/fmt.hex` prints one `u64` without
/// leading zeros; this is the spelling for a buffer.
fun hex_encode(data: &Bytes) => String {
    val n = data.len()
    var out = String.with_capacity(n * 2)
    var i: usize = 0
    while i < n {
        val b = data.get(i)
        out.push(hex_lower(b >> 4))
        out.push(hex_lower(b & 15))
        i = i + 1
    }
    return out
}

/// Accepts either case. `Err(Invalid)` on an odd length or a non-hex character.
/// No `0x` prefix and no separators are accepted.
fun hex_decode(text: &str) => result.Result<Bytes, DecodeErr> {
    val tv = text.view()
    val n = tv.len()
    if n % 2 != 0 {
        return result.Result.Err(error = DecodeErr.Invalid)
    }
    var out = Bytes.empty()
    var i: usize = 0
    while i < n {
        val hi = hex_value(tv.get(i))
        val lo = hex_value(tv.get(i + 1))
        if option.is_none(o = hi) || option.is_none(o = lo) {
            return result.Result.Err(error = DecodeErr.Invalid)
        }
        out.push(((option.unwrap(o = hi) << 4) | option.unwrap(o = lo)).to_u8())
        i = i + 2
    }
    return result.Result.Ok(value = out)
}

/// A `hexdump -C`-shaped rendering: an 8-digit offset, 16 bytes per line in two
/// groups of eight, then the line's bytes as printable ASCII (`.`) for anything
/// outside `0x20`-`0x7e`. Lines are separated by `\n` with **no** trailing
/// newline, so `print(dump(b))` emits the lines and nothing more. An empty
/// buffer renders as the empty string.
fun dump(data: &Bytes) => String {
    val n = data.len()
    var out = String.empty()
    var off: usize = 0
    while off < n {
        if off > 0 {
            out.push('\n')
        }
        val raw_offset = fmt.hex(off.to_u64())
        val offset = fmt.pad_left(raw_offset, 8, '0')
        out.push_str(offset)
        out.push_str("  ")
        var i: usize = 0
        while i < 16 {
            if off + i < n {
                val b = data.get(off + i)
                out.push(hex_lower(b >> 4))
                out.push(hex_lower(b & 15))
                out.push(' ')
            } else {
                out.push_str("   ")
            }
            if i == 7 {
                out.push(' ')
            }
            i = i + 1
        }
        out.push(' ')
        out.push('|')
        var j: usize = 0
        while j < 16 && off + j < n {
            val b = data.get(off + j)
            if b >= 32 && b < 127 {
                out.push(b)
            } else {
                out.push('.')
            }
            j = j + 1
        }
        out.push('|')
        off = off + 16
    }
    return out
}

/// The RFC 3986 §2.3 unreserved set: letters, digits, `-`, `.`, `_`, `~`.
fun is_unreserved(c: u8) => bool {
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    if str.is_digit(c) {
        return true
    }
    return c == 45 || c == 46 || c == 95 || c == 126
}

/// `text` with every byte outside the unreserved set escaped as `%XX`,
/// uppercase hex. Operates on bytes, so UTF-8 multi-byte characters come out as
/// one `%XX` per byte, which is what a URL wants.
fun percent_encode(text: &str) => String {
    val tv = text.view()
    val n = tv.len()
    var out = String.with_capacity(n)
    var i: usize = 0
    while i < n {
        val c = tv.get(i)
        if is_unreserved(c) {
            out.push(c)
        } else {
            out.push('%')
            out.push(hex_upper(c >> 4))
            out.push(hex_upper(c & 15))
        }
        i = i + 1
    }
    return out
}

/// The reverse of `percent_encode`: `%XX` unescaped, `+` left alone (this is
/// URL percent-decoding, not `application/x-www-form-urlencoded`, which is the
/// one place the two schemes differ). `Err(Invalid)` on a trailing `%` or a `%`
/// not followed by two hex digits.
fun percent_decode(text: &str) => result.Result<String, DecodeErr> {
    val tv = text.view()
    val n = tv.len()
    var out = String.with_capacity(n)
    var i: usize = 0
    while i < n {
        val c = tv.get(i)
        if c == '%' {
            if i + 2 >= n {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
            val hi = hex_value(tv.get(i + 1))
            val lo = hex_value(tv.get(i + 2))
            if option.is_none(o = hi) || option.is_none(o = lo) {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
            val byte = (option.unwrap(o = hi) << 4) | option.unwrap(o = lo)
            out.push(byte)
            i = i + 3
        } else {
            out.push(c)
            i = i + 1
        }
    }
    return result.Result.Ok(value = out)
}

/* ----- SHA-1 (RFC 3174) ----- */

/// One left rotation by `n` bits. The call sites never pass 0, and the branch is
/// here because a shift by 32 is undefined in v1 (`design/syntax.md (kelp wiki)` 5), which is
/// what `rotl32(x, 0)` would otherwise be.
fun rotl32(x: u32, n: u32) => u32 {
    if n == 0 {
        return x
    }
    return (x << n) | (x >> (32 - n))
}

/// The 20-byte digest, big-endian, in the order `h0` to `h4` are finalized.
/// `encoding.hex_encode(sha1(data))` is the hex spelling.
///
/// RFC 3174 with no streaming state: the whole message is padded into one
/// buffer, because a WebSocket handshake key is 24 bytes of text and the
/// digest's other users in this tree are test vectors. A `Hasher` that takes
/// chunks belongs here the day something digests a file.
fun sha1(data: &Bytes) => Bytes {
    var msg = Bytes.empty()
    msg.append(data)
    msg.push(128)
    while msg.len() % 64 != 56 {
        msg.push(0)
    }
    // The bit length as eight big-endian bytes. `data.len()` cannot overflow
    // this on a machine that could hold the buffer: `usize` is at most 64 bits
    // and the multiply is exact up to 2^61 bytes.
    val bits: u64 = data.len().to_u64() * 8
    var i: usize = 0
    while i < 8 {
        msg.push(((bits >> ((7 - i).to_u64() * 8)) & 255).to_u8())
        i = i + 1
    }

    var h0: u32 = 0x67452301
    var h1: u32 = 0xEFCDAB89
    var h2: u32 = 0x98BADCFE
    var h3: u32 = 0x10325476
    var h4: u32 = 0xC3D2E1F0

    val n = msg.len()
    var off: usize = 0
    while off < n {
        // The 80-word schedule: 16 words from the block, then four XORs and a
        // rotation each. It is a `List<u32>` rather than 80 locals because the
        // loop that reads it is index-driven, and v1 has no array literal.
        var w: List<u32> = List.empty()
        var t: usize = 0
        while t < 16 {
            val b0 = msg.get(off + t * 4).to_u32()
            val b1 = msg.get(off + t * 4 + 1).to_u32()
            val b2 = msg.get(off + t * 4 + 2).to_u32()
            val b3 = msg.get(off + t * 4 + 3).to_u32()
            w.push((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
            t = t + 1
        }
        while t < 80 {
            val x = w.get(t - 3) ^ w.get(t - 8) ^ w.get(t - 14) ^ w.get(t - 16)
            w.push(rotl32(x, 1))
            t = t + 1
        }

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var j: usize = 0
        while j < 80 {
            var f: u32 = 0
            var k: u32 = 0
            if j < 20 {
                f = (b & c) | (~b & d)
                k = 0x5A827999
            } elif j < 40 {
                f = b ^ c ^ d
                k = 0x6ED9EBA1
            } elif j < 60 {
                f = (b & c) | (b & d) | (c & d)
                k = 0x8F1BBCDC
            } else {
                f = b ^ c ^ d
                k = 0xCA62C1D6
            }
            // Unsigned addition wraps, which is what SHA-1 is defined on.
            val temp = rotl32(a, 5) + f + e + k + w.get(j)
            e = d
            d = c
            c = rotl32(b, 30)
            b = a
            a = temp
            j = j + 1
        }

        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        off = off + 64
    }

    var out = Bytes.empty()
    push_u32_be(out, h0)
    push_u32_be(out, h1)
    push_u32_be(out, h2)
    push_u32_be(out, h3)
    push_u32_be(out, h4)
    return out
}

/// Appends `v` to `out` as four bytes, most significant first.
fun push_u32_be(out: mut Bytes, v: u32) {
    out.push(((v >> 24) & 255).to_u8())
    out.push(((v >> 16) & 255).to_u8())
    out.push(((v >> 8) & 255).to_u8())
    out.push((v & 255).to_u8())
}

/// The `application/x-www-form-urlencoded` encoder: same unreserved set as
/// `percent_encode`, and a space becomes `+` rather than `%20`. Everything else
/// is `%XX` in uppercase hex.
fun form_encode(text: &str) => String {
    val tv = text.view()
    val n = tv.len()
    var out = String.with_capacity(n)
    var i: usize = 0
    while i < n {
        val c = tv.get(i)
        if c == ' ' {
            out.push('+')
        } elif is_unreserved(c) {
            out.push(c)
        } else {
            out.push('%')
            out.push(hex_upper(c >> 4))
            out.push(hex_upper(c & 15))
        }
        i = i + 1
    }
    return out
}

/// The reverse of `form_encode`: `+` is a space, then `%XX` is unescaped. Use
/// `percent_decode` instead when `+` is data (a base64 body, a `+1` phone
/// number) rather than a space.
fun form_decode(text: &str) => result.Result<String, DecodeErr> {
    val tv = text.view()
    val n = tv.len()
    var out = String.with_capacity(n)
    var i: usize = 0
    while i < n {
        val c = tv.get(i)
        if c == '+' {
            out.push(' ')
            i = i + 1
        } elif c == '%' {
            if i + 2 >= n {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
            val hi = hex_value(tv.get(i + 1))
            val lo = hex_value(tv.get(i + 2))
            if option.is_none(o = hi) || option.is_none(o = lo) {
                return result.Result.Err(error = DecodeErr.Invalid)
            }
            out.push((option.unwrap(o = hi) << 4) | option.unwrap(o = lo))
            i = i + 3
        } else {
            out.push(c)
            i = i + 1
        }
    }
    return result.Result.Ok(value = out)
}
