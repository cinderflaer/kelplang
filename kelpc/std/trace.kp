//! Opt-in trace events and duration spans, gated by the `time` capability.
impl "std/io"
impl "std/time"
impl "std/str"
impl "std/fmt"

/// A started duration span. Finish it with `trace.end` at its end location.
datac Span(
    /// The span's name, copied at `begin` so the `end` record can repeat it.
    val name: String,
    /// The monotonic clock reading, in nanoseconds, when the span began.
    val start_ns: i64
)

/// Emits one trace event. Pass `source.file()` and `source.line()` so the
/// record names this call site rather than the implementation in `std/trace`.
fun event(file: &str, line: int, name: &str) {
    emit(kind = "event", file = file, line = line, name = name, elapsed_ns = -1)
}

/// Starts a duration span and emits its `begin` record.
fun begin(file: &str, line: int, name: &str) => Span {
    val start = time.nowMonoNs()
    emit(kind = "begin", file = file, line = line, name = name, elapsed_ns = -1)
    return Span(name = String.from_str(name), start_ns = start)
}

/// Ends `span` and emits its duration in nanoseconds at this call site.
fun end(file: &str, line: int, span: Span) {
    val elapsed = time.nowMonoNs() - span.start_ns
    emit(kind = "end", file = file, line = line, name = span.name.as_str(), elapsed_ns = elapsed)
}

/// Writes one tab-separated trace line to stderr: the record kind, the monotonic
/// time, the escaped `file:line` and the escaped name. A negative `elapsed_ns`
/// leaves out the final duration field, which only `end` records carry.
fun emit(kind: &str, file: &str, line: int, name: &str, elapsed_ns: i64) {
    val at = line.to_u64().toText()
    val time_ns = time.nowMonoNs().toText()
    val safe_file = escape(file)
    val safe_name = escape(name)
    val out = "trace\t${kind}\t${time_ns}\t${safe_file}:${at}\t${safe_name}"
    if elapsed_ns >= 0 {
        val elapsed = elapsed_ns.toText()
        val completed = "${out}\t${elapsed}"
        io.eprint(completed)
    } else {
        io.eprint(out)
    }
}

/// `text` with backslash, tab and newline written as `\\`, `\t` and `\n`, so one
/// trace record always stays on one line with its tab-separated fields intact.
fun escape(text: &str) => String {
    val slashes = str.replace(text, "\\", "\\\\")
    val tabs = str.replace(slashes, "\t", "\\t")
    return str.replace(tabs, "\n", "\\n")
}
