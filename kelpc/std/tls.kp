impl "std/net"
impl "std/option"
impl "std/list"
impl "std/result"
impl "std/str"

/* std/tls: TLS for `https` (MK5-S4b-M1, open item 37, decided 2026-09-26:
   link the system OpenSSL rather than vendor one). Client side only in v1:
   this module wraps an outbound connection after it is already open: it
   never dials one itself. Serving TLS (`server_config`, `accept`), client
   certificates and ALPN are the second half of the file; `kelp wiki page stdlib/tls.md`
   is their design note.

   Gated on `net`, the existing domain, not a new one. `https` is still
   network access, so a program that already writes
   `impl "std/http" caps(net = ["api.example.com:443"])` needs nothing new
   to reach an `https://` URL; the grant it already holds is the one that
   covers it, exactly as it covers `http://`. `stdlib.rs`'s `domain_of` maps
   this module to `"net"` the same way it maps `std/net` and `std/http`.

   **Why this module never calls `net.connect` itself.** A capability grant
   is resolved one hop from the program's own `impl` line: `net.connect`
   inside `std/http.kp` is checked against `caps_of("std/http")`, which is
   populated by whatever `impl "std/http" caps(net = [...])` the *importing
   program* wrote. If a `net.connect` were written here instead, it would be
   checked against `caps_of("std/tls")`, a slot only this module's own
   `impl "std/tls"` line (with no `caps()` clause, so empty) could ever
   populate, never the program's real grant. So the dial stays in
   `std/http.kp`, where the check already works today for plain `http`, and
   this module's `handshake` takes the socket *after* it is connected. That
   is also why this module's own `impl "std/net"` line above carries no
   `caps()` clause: it exists only so `TlsStream` can name `net.Socket` in a
   signature and so `shutdown` can name an fd. Nothing here dials, listens,
   or resolves a name, so nothing here needs a grant.

   **Certificate verification is on by default and not optional.** The
   system trust store (`SSL_CTX_set_default_verify_paths`, which honours
   `SSL_CERT_FILE` and `SSL_CERT_DIR`, the two overrides OpenSSL's compiled
   paths already read), `SSL_VERIFY_PEER`, and hostname verification against
   the name the caller wrote (`SSL_set1_host`): the same name `parse_url`
   split out and the same name the `net` grant was checked against, not
   whatever `getaddrinfo` resolved. A self-signed or mismatched certificate
   is a handshake failure, not a silent connection: there is no `insecure`
   flag, on purpose. `handshake_with` can *add* a private CA file or
   directory to the roots (`SSL_CTX_load_verify_locations`); it can never
   remove the requirement to verify, and it does not lower the TLS 1.2
   minimum. A failure is a value in the `try_` family (`Result<_, TlsError>`)
   and a panic in the plain family, whose message is the error's own text.

   `TlsStream` pairs a plain `fd` with the OpenSSL handle bound to it, not a
   `net.Socket`, because a `net.Socket` and its `TlsStream` would then be two
   owners of one descriptor. `shutdown` ends only the TLS session (so the
   peer sees a clean `close_notify` where the connection allows it) and frees
   the OpenSSL handle; it does not close `fd`. The caller closes the socket
   itself afterward with `net.close(net.Socket(fd = t.fd))`, exactly as it
   would for a plain connection, because the module import that holds the
   real `net` grant is the one that must make that call, per the note above.
   Nothing here closes on drop either, the same rule `net.Socket` and
   `net.Listener` follow.

   `handle` is an `extern type` handle (`TlsHandle`), not a `int`: a
   compiler-shipped std module may now declare one (a module the compiler
   ships is admitted by `stdlib.rs`'s source table in `resolve.rs`, since its
   extern bodies come from `externs.rs` rather than a manifest), and the
   OpenSSL `SSL*` crosses as an opaque value with nothing to compare or do
   arithmetic on. `TlsHandle.null()` and `is_null()` are not needed here: the
   only caller that wants "no handle" is `std/http`/`std/ws`, and they carry
   an `Option<TlsHandle>` whose `None` is that value. */

/// The `TlsError` code for an untrusted certificate.
///
/// The `TlsError` codes the C classifiers (`cdecl::C_HEADERS`) write
/// through `err_code`. They are the wire between the extern bodies and
/// `error_from`, so the two have to agree; the names are the mapping.
const ERR_UNTRUSTED: i32 = 1
/// The `TlsError` code for an expired or not yet valid certificate.
const ERR_EXPIRED: i32 = 2
/// The `TlsError` code for a certificate that does not match the host name.
const ERR_HOST_MISMATCH: i32 = 3
/// The `TlsError` code for a peer that does not speak TLS 1.2 or newer.
const ERR_PROTOCOL_TOO_OLD: i32 = 4
/// The `TlsError` code for a handshake that failed for another reason, with OpenSSL's text.
const ERR_HANDSHAKE: i32 = 5
/// The `TlsError` code for a stream that ended without a `close_notify`.
const ERR_PEER_CLOSED: i32 = 6
/// The `TlsError` code for an operation that timed out.
const ERR_TIMEOUT: i32 = 7
/// The `TlsError` code for any other I/O failure, with the socket's text.
const ERR_IO: i32 = 8

extern fun handshake_try_raw(fd: i32, host: &str, ca_pem: Bytes, timeout_ms: u64, alpn: Bytes, cert_pem: Bytes, key_pem: Bytes, err_code: mut i32, reason: mut String) => TlsHandle
extern fun server_ctx_try_raw(cert: Bytes, key: Bytes, ca: Bytes, alpn: Bytes, pass: Bytes, min13: i32, err_code: mut i32, reason: mut String) => TlsCtx
extern fun reload_try_raw(ctx: TlsCtx, cert: Bytes, key: Bytes, ca: Bytes, alpn: Bytes, pass: Bytes, min13: i32, err_code: mut i32, reason: mut String)
extern fun accept_try_raw(ctx: TlsCtx, fd: i32, timeout_ms: u64, err_code: mut i32, reason: mut String) => TlsHandle
extern fun ctx_free_raw(ctx: TlsCtx)
extern fun alpn_raw(handle: TlsHandle, out: mut String) => bool
extern fun peer_subject_raw(handle: TlsHandle, out: mut String) => bool
extern fun pending_raw(handle: TlsHandle) => int
extern fun set_timeout_raw(handle: TlsHandle, ms: u64)
extern fun write_try_raw(handle: TlsHandle, data: Bytes, err_code: mut i32, reason: mut String) => int
extern fun write_all_try_raw(handle: TlsHandle, data: Bytes, err_code: mut i32, reason: mut String) => int
extern fun read_try_raw(handle: TlsHandle, max: int, err_code: mut i32, reason: mut String) => Bytes
extern fun read_into_try_raw(handle: TlsHandle, buf: mut Bytes, at: int, err_code: mut i32, reason: mut String) => int
extern fun shutdown_try_raw(handle: TlsHandle, err_code: mut i32, reason: mut String)

/// An OpenSSL `SSL*` for one TLS session, carried as an opaque value.
///
/// It is not `Copy`, so passing one around is a borrow, and the `SSL*` is never freed twice.
///
/// A TLS session bound to a connected file descriptor. `handle` is the
/// OpenSSL `SSL*`, carried as an opaque `extern type` handle. Not `Copy`, so
/// passing one around is a borrow and there is never a silent second free of
/// the `SSL*`.
pub extern type TlsHandle

/// An OpenSSL `SSL_CTX*` for a server: the certificate chain, the key, the protocol floor, the ALPN list and
/// the client CAs. It is opaque for the same reason `TlsHandle` is.
///
/// A server's `SSL_CTX*`: certificate chain, key, protocol floor, ALPN list and
/// (for mTLS) the client CAs. Opaque for the same reason `TlsHandle` is.
pub extern type TlsCtx

/// A TLS session bound to a connected file descriptor.
datac TlsStream(
    /// The socket's file descriptor.
    val fd: i32,
    /// The OpenSSL session for that socket.
    val handle: TlsHandle,
)

/// Why a TLS operation failed, as a value a caller can branch on.
///
/// `HandshakeFailed` and `Io` carry OpenSSL's or the socket's own sentence. The other variants are the cases a
/// caller acts on differently: it may retry after `Timeout`, or ask the user to install a CA after `Untrusted`.
/// `PeerClosedUncleanly` is the truncation case, where the stream ended without a `close_notify`.
///
/// Why a TLS operation failed, as a value a caller can branch on.
///
/// `HandshakeFailed` and `Io` carry OpenSSL's or the socket's own sentence;
/// the rest are the cases worth naming because a caller acts on them
/// differently (retry after `Timeout`, ask the user to install a CA after
/// `Untrusted`, and so on). `PeerClosedUncleanly` is the truncation case: the
/// stream ended without a `close_notify`.
pub enum TlsError {
    /// The certificate is not trusted by the system store or by the configured CA.
    Untrusted
    /// The certificate has expired, or is not yet valid.
    Expired
    /// The certificate does not match the host name that was dialed.
    HostMismatch
    /// The peer does not speak TLS 1.2 or newer.
    ProtocolTooOld
    /// The handshake failed. `reason` is OpenSSL's sentence for it.
    HandshakeFailed(val reason: String)
    /// The stream ended without a `close_notify`, so the data may be truncated.
    PeerClosedUncleanly
    /// The operation timed out.
    Timeout
    /// Another I/O failure. `reason` is the socket's or OpenSSL's sentence for it.
    Io(val reason: String)
}

/// How to trust, and how long to wait for, one handshake.
///
/// An empty `ca_pem` means only the system store. Non-empty PEM text of one or more CA certificates adds them to the
/// roots, and cannot weaken verification. The runtime never opens a path for this: a file is read by the caller
/// through `std/tlsfile` and the `fs` grant. A `timeout_ms` of 0 means no timeout, as `SO_RCVTIMEO` does.
///
/// How to trust and how long to wait for one handshake. An empty `ca_pem`
/// means "only the system store"; non-empty PEM text of one or more CA
/// certificates *adds* them to the roots and cannot weaken verification. The
/// runtime never opens a path for this: the PEM comes in as bytes, so a file
/// is read by the caller through `std/tlsfile` and the `fs` grant
/// (`tlsfile.readPem`). A `timeout_ms` of 0 is "no timeout", which is
/// `SO_RCVTIMEO`'s own meaning.
pub datac TlsOptions(
    /// PEM text of extra CA certificates to trust, or empty for the system store only.
    val ca_pem: Bytes,
    /// The handshake and read deadline in milliseconds, or 0 for none.
    val timeout_ms: u64,
)

/// The options `handshake` uses: the system store, no extra CA and no timeout.
///
/// The options `handshake` uses: the system store, no extra CA, no timeout.
fun default_options() => TlsOptions = TlsOptions(
    ca_pem = Bytes.empty(),
    timeout_ms = 0,
)

/// The typed error for one error code and reason that an extern body wrote.
///
/// The typed error for one `err_code`/`reason` pair an extern body wrote.
fun error_from(code: i32, reason: move String) => TlsError {
    if code == ERR_UNTRUSTED {
        return TlsError.Untrusted
    }
    if code == ERR_EXPIRED {
        return TlsError.Expired
    }
    if code == ERR_HOST_MISMATCH {
        return TlsError.HostMismatch
    }
    if code == ERR_PROTOCOL_TOO_OLD {
        return TlsError.ProtocolTooOld
    }
    if code == ERR_PEER_CLOSED {
        return TlsError.PeerClosedUncleanly
    }
    if code == ERR_TIMEOUT {
        return TlsError.Timeout
    }
    if code == ERR_HANDSHAKE {
        return TlsError.HandshakeFailed(reason = reason)
    }
    return TlsError.Io(reason = reason)
}

/// Retired (#375): the camelCase `errorText` is the name. Kept for one cycle.
fun error_text(e: move TlsError) => String = errorText(e)

/// The text a `TlsError` is reported with.
///
/// The panicking forms panic with this text, and a `try_` caller that only wants to log an error gets the same words.
///
/// The text a `TlsError` is reported with: the panicking wrappers panic with
/// this, and a `try_` caller that only wants to log one gets exactly what
/// they would have printed. `HandshakeFailed` and `Io` return OpenSSL's or
/// the socket's own words, so the detail is not thrown away.
fun errorText(e: move TlsError) => String = when e {
    Untrusted -> "tls: the certificate is not trusted by the system store"
    Expired -> "tls: the certificate has expired or is not yet valid"
    HostMismatch -> "tls: the certificate does not match the host name"
    ProtocolTooOld -> "tls: the peer does not speak TLS 1.2 or newer"
    HandshakeFailed(reason) -> reason
    PeerClosedUncleanly -> "tls: the peer closed the connection without a close_notify"
    Timeout -> "tls: the operation timed out"
    Io(reason) -> reason
}

/// Retired (#375): the camelCase `handshakeWith` is the name. Kept for one cycle.
fun handshake_with(s: net.Socket, host: &str, opts: TlsOptions) => result.Result<TlsStream, TlsError> = handshakeWith(s, host, opts)

/// Performs the TLS client handshake over a connected socket, with the options given, or returns why it could not.
///
/// `host` is used for SNI and for the certificate's host name check. It should be the host the caller dialed, not an
/// address that `getaddrinfo` produced.
///
/// Performs the TLS client handshake over an already-connected socket, with
/// `opts`' private CA and timeout, or returns why it could not. `host` is
/// used for SNI and for the certificate's hostname check; it should be
/// exactly the host the caller dialed, the same string `net.connect` and the
/// capability check both saw, not an address `getaddrinfo` produced.
///
/// The socket is consumed by value (as `net.Socket` is always passed), and
/// its descriptor lives on inside the returned `TlsStream`; there is no
/// remaining `Socket` to close separately afterward, only the `TlsStream`.
fun handshakeWith(s: net.Socket, host: &str, opts: TlsOptions) => result.Result<TlsStream, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val handle = handshake_try_raw(
        s.fd,
        host,
        opts.ca_pem.clone(),
        opts.timeout_ms,
        Bytes.empty(),
        Bytes.empty(),
        Bytes.empty(),
        &mut code,
        &mut reason,
    )
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = TlsStream(fd = s.fd, handle = handle))
}

/// The fallible handshake with the default options, for a caller that can act on an untrusted certificate.
///
/// The fallible form of `handshake` with the default options, for a caller
/// that has somewhere to go when the peer's certificate is not trusted.
fun handshake(s: net.Socket, host: &str) => result.Result<TlsStream, TlsError> = handshakeWith(
    s,
    host,
    default_options(),
)

/// Retired (#375): the camelCase `handshakeTimeout` is the name. Kept for one cycle.
fun handshake_timeout(s: net.Socket, host: &str, ms: u64) => result.Result<TlsStream, TlsError> = handshakeTimeout(s, host, ms)

/// The fallible handshake with a deadline in milliseconds. A silent peer gives `Err(Timeout)` instead of a hang.
///
/// The deadline stays on the socket for the reads and writes that follow.
///
/// The fallible handshake with a deadline in milliseconds, applied as
/// `SO_RCVTIMEO`/`SO_SNDTIMEO` before the handshake starts. A silent peer is
/// then `Err(Timeout)` instead of a hang, and the settings stay on the socket
/// for the reads and writes that follow.
fun handshakeTimeout(s: net.Socket, host: &str, ms: u64) => result.Result<TlsStream, TlsError> = handshakeWith(
    s,
    host,
    TlsOptions(ca_pem = Bytes.empty(), timeout_ms = ms),
)

/// Retired (#375): the camelCase `setTimeout` is the name. Kept for one cycle.
fun set_timeout(t: TlsStream, ms: u64) { setTimeout(t, ms) }

/// Sets the receive and send timeouts on the stream's socket. `ms` of 0 means no timeout.
///
/// Panics if the socket options cannot be set.
///
/// Sets the receive and send timeouts on the stream's socket, so a blocking
/// read on a silent peer gives up instead of hanging forever. `ms` of 0 means
/// "no timeout". The handshake's own timeout is set before it starts; this is
/// the call for the reads and writes that follow.
///
/// Panics: if the socket options cannot be set.
fun setTimeout(t: TlsStream, ms: u64) {
    set_timeout_raw(t.handle, ms)
}

/// Panics with the text of a failed TLS read or write that returns bytes.
fun fail_bytes(e: move TlsError) => Bytes {
    val text = errorText(e)
    panic(text)
}

/// Writes some of `data` and returns how many bytes were written, or why the write failed. Like `net.send`, it may write fewer bytes than given.
///
/// One `SSL_write`, or why it failed: like `net.send`, it may write fewer
/// bytes than given.
fun write(t: TlsStream, data: Bytes) => result.Result<int, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val n = write_try_raw(t.handle, data, &mut code, &mut reason)
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = n)
}

/// Retired (#375): the camelCase `writeAll` is the name. Kept for one cycle.
fun write_all(t: TlsStream, data: Bytes) => result.Result<int, TlsError> = writeAll(t, data)

/// Writes the whole buffer, looping over short writes, or returns why it stopped.
///
/// The whole buffer, looping over short writes, or why it stopped: the TLS
/// twin of `net.sendAll`.
fun writeAll(t: TlsStream, data: Bytes) => result.Result<int, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val n = write_all_try_raw(t.handle, data, &mut code, &mut reason)
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = n)
}

/// Reads up to `max` bytes, whatever is available. A clean `close_notify` is `Ok` with an empty `Bytes`. A stream that
/// ends without one is `Err(PeerClosedUncleanly)`.
///
/// One `SSL_read`: up to `max` bytes, whatever is available. A clean
/// `close_notify` is `Ok` with an empty `Bytes`; a stream that ends without
/// one is `Err(PeerClosedUncleanly)`.
fun read(t: TlsStream, max: int) => result.Result<Bytes, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val data = read_try_raw(t.handle, max, &mut code, &mut reason)
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = data)
}

/// Retired (#375): the camelCase `readInto` is the name. Kept for one cycle.
fun read_into(t: TlsStream, buf: mut Bytes, at: int) => result.Result<int, TlsError> = readInto(t, buf, at)

/// Fills `buf` from byte `at` onward and returns how many bytes arrived, 0 on a clean close, or why the read failed.
///
/// It is the TLS form of `net.recvInto`, for a message of known size.
///
/// Fills `buf` from byte `at` onward, returning how many bytes arrived (0 on
/// a clean close), or why the read failed: the TLS form of
/// `net.recvInto`, for a message of known size.
fun readInto(t: TlsStream, buf: mut Bytes, at: int) => result.Result<int, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val n = read_into_try_raw(t.handle, buf, at, &mut code, &mut reason)
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = n)
}

/// Ends the TLS session, sending `close_notify` when the connection allows it, and frees the OpenSSL handle.
///
/// The handle is freed either way. The socket is not closed; see `shutdown`.
///
/// Ends the TLS session (sending `close_notify` when the connection allows
/// it) and frees the OpenSSL handle, or returns why `close_notify` did not go
/// out. The handle is freed either way. It does not close `t.fd`; see
/// `shutdown` for the closing sequence.
fun shutdown(t: TlsStream) => result.Result<bool, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    shutdown_try_raw(t.handle, &mut code, &mut reason)
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = true)
}

// ===== ALPN, client certificates and serving (st3) =====
//
// `kelp wiki page stdlib/tls.md` is the design note. This module takes certificates and
// keys as PEM *bytes*: it must not import `std/fs`, because a module that names
// `fs.read` needs the `fs` grant from every program that imports it, and
// every `https` client does. `std/tlsfile` is the thin layer that reads the
// files through the `fs` gate and calls the `_pem` functions here; the C side
// only ever sees PEM bytes. A private key is never put in an
// error text. The library does not check the key file's permissions: keep it
// `0600`, owned by the serving user.

/// The lowest protocol version a server accepts. TLS 1.2 is the default and the floor of the client too.
///
/// The lowest protocol version a server accepts. TLS 1.2 is the default and the
/// floor of the client too; there is no way to go lower.
pub enum TlsVersion {
    /// TLS 1.2 or newer.
    Tls12
    /// TLS 1.3 only.
    Tls13
}

/// What a server needs besides its certificate.
///
/// Build a value with the methods below and hand it to `server_config_pem_with`.
///
/// What a server needs besides its certificate. A value, built with the methods
/// below and handed to `server_config_with`, so a `ServerConfig` itself has
/// nothing left to change once it exists.
pub datac ServerOptions(
    /// The lowest TLS version, as 12 or 13.
    val floor: i32,
    /// The offered protocols in wire form, or empty for none.
    val alpn_list: Bytes,
    /// PEM text of client CA certificates, or empty when client certificates are not required.
    val ca_pem: Bytes,
    /// The handshake deadline in milliseconds, or 0 to wait forever.
    val timeout_ms: u64,
    /// The pass phrase of an encrypted private key, or empty for none.
    val key_pass: Bytes,
)

/// A built server configuration. It is immutable, and one OpenSSL `SSL_CTX*` serves every thread.
///
/// A config is shared by reference, or by copying its handle into a worker. `free` ends it. Nothing is freed on drop.
///
/// A built server configuration. Immutable; one `SSL_CTX*` that OpenSSL lets
/// every thread make sessions from, so a config is shared by reference or by
/// copying its handle into a worker. `free` ends it; like every handle here,
/// nothing is freed on drop.
pub datac ServerConfig(
    /// The OpenSSL context that new handshakes use.
    val ctx: TlsCtx,
    /// The deadline that `accept` applies to each handshake, in milliseconds.
    val handshake_timeout_ms: u64,
)

/// Retired (#375): the camelCase `serverOptions` is the name. Kept for one cycle.
fun server_options() => ServerOptions = serverOptions()

/// The options `server_config_pem` uses: TLS 1.2 or newer, no ALPN, no client certificates and a 10 second handshake.
///
/// The options of `server_config`: TLS 1.2 or newer, no ALPN, no client
/// certificates, a 10 s handshake.
fun serverOptions() => ServerOptions = ServerOptions(
    floor = 12,
    alpn_list = Bytes.empty(),
    ca_pem = Bytes.empty(),
    timeout_ms = 10000,
    key_pass = Bytes.empty(),
)

/// The TLS version number, as 12 or 13, that a version selects.
fun TlsVersion.floor_code() => i32 = when self {
    Tls12 -> 12
    Tls13 -> 13
}

/// Retired (#375): the camelCase `minVersion` is the name. Kept for one cycle.
fun ServerOptions.min_version(v: TlsVersion) => ServerOptions = self.minVersion(v)

/// The options with the lowest accepted TLS version set to `v`.
fun ServerOptions.minVersion(v: TlsVersion) => ServerOptions = ServerOptions(
    floor = v.floor_code(),
    alpn_list = alpn_list.clone(),
    ca_pem = ca_pem.clone(),
    timeout_ms = timeout_ms,
    key_pass = key_pass.clone(),
)

/// The options with the protocols this server speaks, in order of preference, such as `"h2"` and `"http/1.1"`.
///
/// The first one the client also offers is chosen. An empty name, or one longer than 255 bytes, makes `server_config_pem_with` return an error.
///
/// The protocols this server speaks, in order of preference (`"h2"`,
/// `"http/1.1"`). The first one the client also offers is chosen; no overlap
/// fails the handshake. A name that is empty or longer than 255 bytes is not a
/// protocol: it makes `server_config_with` return an error.
fun ServerOptions.alpn(protocols: &List<String>) => ServerOptions = ServerOptions(
    floor = floor,
    alpn_list = alpn_wire(protocols),
    ca_pem = ca_pem.clone(),
    timeout_ms = timeout_ms,
    key_pass = key_pass.clone(),
)

/// Retired (#375): the camelCase `requireClientCertPem` is the name. Kept for one cycle.
fun ServerOptions.require_client_cert_pem(ca_pem: Bytes) => ServerOptions = self.requireClientCertPem(ca_pem)

/// The options that verify client certificates against the CA certificates in this PEM text, and refuse a connection without one.
///
/// Text with no certificate in it is rejected when the configuration is built.
///
/// Verify client certificates against the CA(s) in this PEM text, and refuse a
/// connection that has none. Text with no certificate in it is rejected when
/// the configuration is built. `tlsfile.require_client_cert` reads a file.
fun ServerOptions.requireClientCertPem(ca_pem: Bytes) => ServerOptions = ServerOptions(
    floor = floor,
    alpn_list = alpn_list.clone(),
    ca_pem = ca_pem.clone(),
    timeout_ms = timeout_ms,
    key_pass = key_pass.clone(),
)

/// Retired (#375): the camelCase `handshakeTimeoutMs` is the name. Kept for one cycle.
fun ServerOptions.handshake_timeout_ms(ms: u64) => ServerOptions = self.handshakeTimeoutMs(ms)

/// The options with the handshake deadline set to `ms` milliseconds. 0 waits forever.
///
/// The handshake deadline `accept` applies; 0 waits forever.
fun ServerOptions.handshakeTimeoutMs(ms: u64) => ServerOptions = ServerOptions(
    floor = floor,
    alpn_list = alpn_list.clone(),
    ca_pem = ca_pem.clone(),
    timeout_ms = ms,
    key_pass = key_pass.clone(),
)

/// Retired (#375): the camelCase `keyPassword` is the name. Kept for one cycle.
fun ServerOptions.key_password(phrase: &str) => ServerOptions = self.keyPassword(phrase)

/// The options with the pass phrase of an encrypted private key set to `phrase`.
///
/// The phrase is never put in an error text. It lives only in these options, so drop them once the configuration is built.
///
/// The pass phrase of an encrypted private key (PEM `ENCRYPTED PRIVATE KEY` or
/// the older `Proc-Type: 4,ENCRYPTED` form). Without one an encrypted key is
/// refused with a fixed sentence; with a wrong one the same sentence says the
/// key is malformed or the phrase wrong. The phrase is never put in an error
/// text, and it lives only in these options: drop them once the configuration
/// is built.
fun ServerOptions.keyPassword(phrase: &str) => ServerOptions = ServerOptions(
    floor = floor,
    alpn_list = alpn_list.clone(),
    ca_pem = ca_pem.clone(),
    timeout_ms = timeout_ms,
    key_pass = Bytes.from_str(phrase),
)

/// The wire form of an ALPN list: each name behind its length byte. A name that cannot be sent leaves a zero length, which the C side refuses.
///
/// The wire form of an ALPN list: each name behind its length byte. A name that
/// cannot be sent leaves a zero length, which the C side refuses.
fun alpn_wire(protocols: &List<String>) => Bytes {
    var out = Bytes.empty()
    var i: int = 0
    while i < protocols.len() {
        val name = protocols.get(i)
        val n = str.len(name.as_str())
        if n == 0 || n > 255 {
            out.push(0)
        } else {
            out.push(n.to_byte())
            var k: int = 0
            while k < n {
                out.push(str.byte(name.as_str(), k))
                k = k + 1
            }
        }
        i = i + 1
    }
    return out
}

