fun TlsStream.pending() => int = pending_raw(handle)

/// The client's options with ALPN and a client certificate.
///
/// `TlsOptions` keeps its two fields, because fixtures build it by position, so these options live here.
///
/// The client's options with ALPN and a client certificate: `TlsOptions` keeps
/// its two fields (fixtures build it positionally), so these live here.
pub datac TlsClientOptions(
    /// PEM text of extra CA certificates to trust, or empty for the system store only.
    val ca_pem: Bytes,
    /// The handshake and read deadline in milliseconds, or 0 for none.
    val timeout_ms: u64,
    /// The offered protocols in wire form, or empty for none.
    val alpn_list: Bytes,
    /// PEM text of the client certificate chain, or empty for none.
    val cert_pem: Bytes,
    /// PEM text of the client's private key, or empty for none.
    val key_pem: Bytes,
)

