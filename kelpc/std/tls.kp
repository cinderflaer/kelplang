fun server_config_pem(cert_chain_pem: Bytes, key_pem: Bytes) => result.Result<ServerConfig, TlsError> = serverConfigPem(cert_chain_pem, key_pem)

/// A server configuration from a certificate chain, leaf first, and its private key, both PEM text, with the default options.
///
/// A malformed PEM, or a key that does not belong to the certificate, is `HandshakeFailed` with a fixed sentence. It never panics,
/// and the key never appears in the text.
///
/// A server configuration from a certificate chain (leaf first) and its private
/// key, both PEM text, with the default options. A malformed PEM or a key that
/// does not belong to the certificate is `HandshakeFailed` with a fixed
/// sentence. Never a panic, and never the key in the text. `tlsfile.server_config`
/// is the same from two file paths.
fun serverConfigPem(cert_chain_pem: Bytes, key_pem: Bytes) => result.Result<ServerConfig, TlsError> {
    return serverConfigPemWith(cert_chain_pem, key_pem, serverOptions())
}

/// Retired (#375): the camelCase `serverConfigPemWith` is the name. Kept for one cycle.
fun server_config_pem_with(cert: Bytes, key: Bytes, opts: &ServerOptions) => result.Result<ServerConfig, TlsError> = serverConfigPemWith(cert, key, opts)

/// A server configuration from a certificate chain and key, with the given options: a TLS floor, ALPN, required client certificates and the handshake deadline.
///
/// `server_config_pem` with options: a TLS floor, ALPN, required client
/// certificates, the handshake deadline.
fun serverConfigPemWith(cert: Bytes, key: Bytes, opts: &ServerOptions) => result.Result<ServerConfig, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val min13: i32 = if opts.floor == 13 { 1 } else { 0 }
    val ctx = server_ctx_try_raw(
        cert,
        key,
        opts.ca_pem.clone(),
        opts.alpn_list.clone(),
        opts.key_pass.clone(),
        min13,
        &mut code,
        &mut reason,
    )
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = ServerConfig(ctx = ctx, handshake_timeout_ms = opts.timeout_ms))
}

/// Retired (#375): the camelCase `reloadPem` is the name. Kept for one cycle.
must_use fun ServerConfig.reload_pem(cert: Bytes, key: Bytes, opts: &ServerOptions) => option.Option<TlsError> = self.reloadPem(cert, key, opts)

/// Replaces the certificate and key that new handshakes use, from PEM text, with the options given.
///
/// A renewal is a reload on the live configuration: nothing is re-accepted and no thread has to stop. Connections already
/// established keep the certificate they started with. If the new material is malformed, does not match or the phrase is wrong,
/// the old certificate stays in force and the failure is returned. `None` means success. The handshake deadline is not changed.
///
/// Replaces the certificate and key this configuration hands to *new*
/// handshakes, from PEM text, with the options given (the floor, ALPN, client CA
/// and pass phrase are taken from `opts`, so a reload may change them too). A
/// renewal is `reload_pem` on the live configuration: nothing is re-accepted and
/// no thread has to be stopped. Connections already established keep the
/// certificate they started with. If the new material is malformed, does not
/// match, or the phrase is wrong, the old certificate stays in force and the
/// failure is the value (`None` is success). `ServerConfig.handshakeTimeoutMs`
/// is not changed by a reload.
must_use fun ServerConfig.reloadPem(cert: Bytes, key: Bytes, opts: &ServerOptions) => option.Option<TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val min13: i32 = if opts.floor == 13 { 1 } else { 0 }
    reload_try_raw(
        ctx,
        cert,
        key,
        opts.ca_pem.clone(),
        opts.alpn_list.clone(),
        opts.key_pass.clone(),
        min13,
        &mut code,
        &mut reason,
    )
    if code != 0 {
        return option.Option.Some(value = error_from(code, reason))
    }
    return option.Option.None
}

/// Ends the configuration. Sessions made from it keep working until they end, because OpenSSL counts the references.
///
/// Ends the configuration. Sessions already made from it keep working until
/// they end; OpenSSL counts the references.
fun ServerConfig.free() {
    ctx_free_raw(ctx)
}

/// The server handshake over a socket that `net.accept` returned, within the configuration's deadline.
///
/// Failures are values. An untrusted client certificate is `Untrusted`, an expired one is `Expired`, and a missing certificate, no common
/// ALPN protocol or a version below the floor is `HandshakeFailed`. A silent client is `Timeout`.
///
/// The server handshake over a socket `net.accept` returned, within the
/// configuration's deadline. The descriptor lives on in the returned
/// `TlsStream`, as for `handshake`. Failures are values: a client
/// certificate from another CA is `Untrusted`, an expired one `Expired`, a
/// missing one, no common ALPN protocol or a version below the floor is
/// `HandshakeFailed`, a silent client is `Timeout`.
fun accept(config: &ServerConfig, s: net.Socket) => result.Result<TlsStream, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val handle = accept_try_raw(config.ctx, s.fd, config.handshake_timeout_ms, &mut code, &mut reason)
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = TlsStream(fd = s.fd, handle = handle))
}

/// The protocol that ALPN settled on, on a server or a client stream, or `None` when nothing was negotiated.
///
/// The protocol ALPN settled on, on a server or a client stream; `None` when
/// nothing was negotiated.
fun TlsStream.alpn() => option.Option<String> {
    var out = String.empty()
    if alpn_raw(handle, &mut out) {
        return option.Option.Some(value = out)
    }
    return option.Option.None
}

