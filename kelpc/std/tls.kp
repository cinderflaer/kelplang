fun handshake_opts(s: net.Socket, host: &str, opts: &TlsClientOptions) => result.Result<TlsStream, TlsError> = handshakeOpts(s, host, opts)

/// The client handshake with every option.
///
/// It verifies the same way, checks the host name in the same way and keeps the TLS 1.2 floor, and adds ALPN and a client certificate when the options carry them.
///
/// The client handshake with every option, `handshake_with`'s superset:
/// the same verification, hostname check and TLS 1.2 floor, plus ALPN and a
/// client certificate when the options carry them.
fun handshakeOpts(s: net.Socket, host: &str, opts: &TlsClientOptions) => result.Result<TlsStream, TlsError> {
    var code: i32 = 0
    var reason = String.empty()
    val handle = handshake_try_raw(
        s.fd,
        host,
        opts.ca_pem.clone(),
        opts.timeout_ms,
        opts.alpn_list.clone(),
        opts.cert_pem.clone(),
        opts.key_pem.clone(),
        &mut code,
        &mut reason,
    )
    if code != 0 {
        return result.Result.Err(error = error_from(code, reason))
    }
    return result.Result.Ok(value = TlsStream(fd = s.fd, handle = handle))
}

