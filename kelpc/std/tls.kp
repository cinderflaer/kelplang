/// The subject of the peer's certificate in RFC 2253 form (`CN=client`): the
/// authenticated client on a server stream that required a client certificate.
/// `None` when the peer presented none.
fun TlsStream.peerCertSubject() => option.Option<String> {
    var out = String.empty()
    if peer_subject_raw(handle, &mut out) {
        return option.Option.Some(value = out)
    }
    return option.Option.None
}

