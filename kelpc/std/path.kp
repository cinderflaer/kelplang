impl "std/mem"
impl "std/str"

/* `/` is the separator on every platform in the API; a `\` translation
   belongs at the syscall boundary, not here (stdlib plan, `path` section). */
fun is_absolute(s: &str).R: bool = str.len(s) > 0 && str.byte(s, 0) == 47

// Purely lexical normalization: `//` collapses, `.` is dropped, `..` pops a
// segment. It is *the same C function* the capability checker uses (M7),
// which is the plan's requirement — the security-relevant normalization must
// exist once, not twice.
// Panics: if the path is not absolute, or escapes its own root via `..`.
extern fun normalize_raw(s: &str).R: String

fun normalize(s: &str).R: String = normalize_raw(s)

// `p` as an absolute, normalized path: `p` alone when it is already absolute,
// otherwise `base` with `p` appended, in both cases run through `normalize` so
// that `.` and `..` are resolved before the result reaches a capability check
// (which only accepts an absolute path free of `..`).
//
// `base` must be absolute, and the pair must not climb above `/`.
// Panics: if `base` is not absolute, or the join escapes the filesystem root.
fun absolute(base: &str, p: &str).R: String {
    if is_absolute(p) {
        return normalize(p)
    }
    val joined = join(base, p)
    return normalize(joined.as_str())
}

// The byte index just past the last `/`, or 0 when the path has none. A
// path with no separator has no directory part at all, so `file_name`
// reports the whole string — which is what every other path library does.
fun last_sep(s: &str).R: usize {
    val n = str.len(s)
    var i: usize = n
    while i > 0 {
        if str.byte(s, i - 1) == 47 {
            return i
        }
        i = i - 1
    }
    return 0
}

// The final component: a *view* of the tail, so no allocation.
fun file_name(s: &str).R: &str = str.substring(s, last_sep(s))

// The text after the last `.` in the final component, or the empty string.
fun extension(s: &str).R: &str {
    val start = last_sep(s)
    val n = str.len(s)
    var i: usize = n
    while i > start {
        if str.byte(s, i - 1) == 46 {
            return str.substring(s, i)
        }
        i = i - 1
    }
    return str.substring(s, n)
}

// The final component without its extension: `"a/b.txt"` becomes `"b"`. A
// leading dot is part of the name, not an extension (".bashrc" has no
// extension), so its stem is the whole name. Owned rather than a view: this
// is a *prefix* of the string, and a prefix cannot be a view (the same
// reason `parent` below allocates).
fun stem(s: &str).R: String {
    val start = last_sep(s)
    val n = str.len(s)
    var cut: usize = n
    var i: usize = n
    while i > start {
        if str.byte(s, i - 1) == 46 && i - 1 > start {
            cut = i - 1
            i = start
        } else {
            i = i - 1
        }
    }
    if cut < n {
        return str.copy_range(s, start, cut)
    }
    return str.copy_range(s, start, n)
}

// Whether the final component ends with `.ext`.
fun has_extension(s: &str, ext: &str).R: bool = str.eq(extension(s), ext)

// `s` split into its non-empty components on `/`: a leading, trailing or
// doubled separator contributes no empty piece, so `"/a//b/"` is `["a",
// "b"]`. Absolute-ness is not recorded; the components are.
fun split(s: &str).R: List<String> {
    var out: List<String> = List.empty()
    val n = str.len(s)
    var start: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || str.byte(s, i) == 47 {
            if i > start {
                out.push(str.copy_range(s, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

// Every part joined with `/`, left to right, so a later absolute part
// replaces everything before it — `join`'s rule, applied repeatedly.
fun join_all(parts: List<String>).R: String {
    var out = String.empty()
    var first = true
    var i: usize = 0
    while i < parts.len() {
        val part = parts.get(i).as_str()
        if is_absolute(part) {
            out = String.from_str(part)
            first = false
        } elif first {
            out.push_str(part)
            first = false
        } else {
            out.push_str("/")
            out.push_str(part)
        }
        i = i + 1
    }
    return out
}

// The directory part, as an owned copy: a prefix cannot be a view (see
// `str.trim_end` on why truncation allocates). The empty string means "no
// directory part", which is the honest answer for a bare file name.
fun parent(s: &str).R: String {
    val end = last_sep(s)
    if end == 0 {
        return String.empty()
    }
    var cut: usize = end - 1
    while cut > 1 && str.byte(s, cut - 1) == 47 {
        cut = cut - 1
    }
    return str.prefix(s, cut)
}

// `a` joined with `b`, with exactly one `/` between them, and without
// copying either side's bytes twice. An absolute `b` replaces `a`, which is
// what every other path library does. The result is not normalized; use
// `absolute` when the caller needs one that a capability check will accept.
fun join(a: &str, b: &str).R: String {
    if is_absolute(b) {
        return String.from_str(b)
    }
    val la = str.len(a)
    val lb = str.len(b)
    val sep: usize = if la > 0 && str.byte(a, la - 1) == 47 { 0 } else { 1 }
    var out = mem.alloc(la + lb + sep)
    var i: usize = 0
    while i < la {
        out.set(i, str.byte(a, i))
        i = i + 1
    }
    if sep == 1 {
        out.set(la, 47)
    }
    var j: usize = 0
    while j < lb {
        out.set(la + sep + j, str.byte(b, j))
        j = j + 1
    }
    return String.from_bytes(out)
}
