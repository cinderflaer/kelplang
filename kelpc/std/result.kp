// std/result — `Result<T, E>`, and the helpers the language can express
// (MK5-S6-M1).
//
// `Ok`/`Err` is the other shape `?` understands (`syntax.md` §5), and the one
// that carries a reason: a function returns `Result<T, E>` when the caller may
// want to know *why* it failed, and `expr?` propagates the `E` unchanged into
// the enclosing function's `Result<_, E>`.
//
// The combinators take a function value (A-4) and read the payload through a
// *borrow*, so a callback never takes ownership: `map`'s is
// `fun(&T).R: U`. The arm that has to *rebuild* the other side of the result
// is the one with the `Copy` requirement — `map` rebuilds `Err`, so its `E`
// must be `Copy`; `map_err` rebuilds `Ok`, so its `T` must be.
//
// What is deliberately absent, and why:
//
// - `unwrap_or`/`unwrap`/`unwrap_err` hand a payload out by value, which needs
//   a move out of the enum, so they are offered for a `Copy` payload and are a
//   compile error at any other instantiation.
// - There is no error *conversion*: `?` requires the operand's failure payload
//   type and the enclosing function's to be identical, so `From`-style lifting
//   of one error into another is where a trait would go (A-12).

enum Result<T, E> {
    Ok(val value: T)
    Err(val error: E)
}

// Whether the result is a success.
fun is_ok<T, E>(r: &Result<T, E>).R: bool = when r {
    Ok(_) -> true
    Err(_) -> false
}

// Whether the result is a failure.
fun is_err<T, E>(r: &Result<T, E>).R: bool = when r {
    Ok(_) -> false
    Err(_) -> true
}

// The success payload, or `fallback`. `T` must be `Copy`.
fun unwrap_or<T, E>(r: &Result<T, E>, fallback: T).R: T = when r {
    Ok(v) -> v
    Err(_) -> fallback
}

// The success payload, or a panic naming the call. `T` must be `Copy`.
fun unwrap<T, E>(r: &Result<T, E>).R: T {
    if let Ok(v) = r {
        return v
    }
    panic("Result.unwrap: value is Err")
}

// The failure payload, or a panic naming the call. `E` must be `Copy`.
fun unwrap_err<T, E>(r: &Result<T, E>).R: E {
    if let Err(e) = r {
        return e
    }
    panic("Result.unwrap_err: value is Ok")
}

// The success payload, or a panic carrying `message`. `T` must be `Copy`.
fun expect<T, E>(r: &Result<T, E>, message: &str).R: T {
    if let Ok(v) = r {
        return v
    }
    panic(message)
}

// The failure payload, or a panic carrying `message`. `E` must be `Copy`.
fun expect_err<T, E>(r: &Result<T, E>, message: &str).R: E {
    if let Err(e) = r {
        return e
    }
    panic(message)
}

// Transform the success payload through `f`. `E` must be `Copy`: the failure
// arm rebuilds `Err` out of the borrow it was handed.
fun map<T, U, E>(r: &Result<T, E>, f: fun(&T).R: U).R: Result<U, E> = when r {
    Ok(v) -> Result.Ok(value = f(v))
    Err(e) -> Result.Err(error = e)
}

// Transform the failure payload through `f`. `T` must be `Copy`, for the
// mirror-image reason.
fun map_err<T, E, F>(r: &Result<T, E>, f: fun(&E).R: F).R: Result<T, F> = when r {
    Ok(v) -> Result.Ok(value = v)
    Err(e) -> Result.Err(error = f(e))
}

// Chain a second fallible step: `f` returns a `Result` itself, which is what
// makes a sequence of fallible steps readable without nesting `if let`.
// `E` must be `Copy`, since the failure arm rebuilds `Err`.
fun and_then<T, U, E>(r: &Result<T, E>, f: fun(&T).R: Result<U, E>).R: Result<U, E> = when r {
    Ok(v) -> f(v)
    Err(e) -> Result.Err(error = e)
}

// The result, or `f(e)` when it failed. `T` must be `Copy`, since the success
// arm rebuilds `Ok`.
fun or_else<T, E, F>(r: &Result<T, E>, f: fun(&E).R: Result<T, F>).R: Result<T, F> = when r {
    Ok(v) -> Result.Ok(value = v)
    Err(e) -> f(e)
}

// Run `f` over the success payload, if there is one, and discard the result.
// Works for any `T`.
fun each<T, E>(r: &Result<T, E>, f: fun(&T)) {
    when r {
        Ok(v) -> f(v)
        Err(_) -> {}
    }
}
