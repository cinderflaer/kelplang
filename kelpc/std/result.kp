//! `Result<T, E>`: the outcome of a fallible step, with its helpers.
/* std/result, `Result<T, E>`, and the helpers the language can express
   (MK5-S6-M1).

   `Ok`/`Err` is the other shape `?` understands (`syntax.md` §5), and the one
   that carries a reason: a function returns `Result<T, E>` when the caller may
   want to know *why* it failed, and `expr?` propagates the `E` unchanged into
   the enclosing function's `Result<_, E>`.

   The combinators take a callback (A-4) and read the payload through a
   *borrow*, so a callback never takes ownership: `map`'s is
   `closure fun(&T) => U`. It is a *closure* (A-4 phase E), so it may capture a
   binding from the frame that passes it; a plain function value is widened
   into one at the call through a generated shim, so passing a declared `fun`
   still allocates nothing. The arm that has to *rebuild* the other side of the
   result is why `map` and `map_err` take the result with `move` (A-11): the
   payload they hand back is the payload they were given, which is a partial
   move out of the owned result. Every other helper here reads through a borrow
   and stays `Copy`-only on the side it has to rebuild.

   What is deliberately absent, and why:

   - `unwrap`/`unwrap_err` hand a payload out by value and their receiver is a
     borrow, so they are offered for a `Copy` payload only; the owned form of
     "hand it out" is `map`/`map_err` (which give the payload back inside a
     result) or a `when` on an owned result. `unwrap_or` is the same for its
     success payload, and see the rule below for the error it drops.
   - There is no error *conversion*: `?` requires the operand's failure payload
     type and the enclosing function's to be identical, so `From`-style lifting
     of one error into another is where a trait would go (A-12). */

/// The outcome of a fallible step: `Ok` holds the value, `Err` the error.
enum Result<T, E> {
    /// The step succeeded with a value.
    Ok(val value: T)
    /// The step failed with an error.
    Err(val error: E)
}

/// Whether the result is a success: `result.is_ok(r)` is `r.is_ok()`.
fun is_ok<T, E>(r: &Result<T, E>) => bool = r.is_ok()

/// Whether the result is a failure: `result.is_err(r)` is `r.is_err()`.
fun is_err<T, E>(r: &Result<T, E>) => bool = r.is_err()

/// The success payload, or `fallback`. `T` must be `Copy`: the receiver is a
/// borrow, so an owned payload cannot be handed out of it; read one with a
/// `when` over an owned result, or hand it on inside a result with `map`.
/// `result.unwrap_or(r = r, fallback = 0)` is `r.unwrap_or(0)`.
fun unwrap_or<T, E>(r: &Result<T, E>, fallback: T) => T = r.unwrap_or(fallback)

/// The success payload, or a panic naming the call. `T` must be `Copy`.
fun unwrap<T, E>(r: &Result<T, E>) => T {
    if let Ok(v) = r {
        return v
    }
    panic("Result.unwrap: value is Err")
}

/// The failure payload, or a panic naming the call. `E` must be `Copy`.
fun unwrap_err<T, E>(r: &Result<T, E>) => E {
    if let Err(e) = r {
        return e
    }
    panic("Result.unwrap_err: value is Ok")
}

/// The success payload, or a panic carrying `message`. `T` must be `Copy`.
fun expect<T, E>(r: &Result<T, E>, message: &str) => T {
    if let Ok(v) = r {
        return v
    }
    panic(message)
}

/// The failure payload, or a panic carrying `message`. `E` must be `Copy`.
fun expect_err<T, E>(r: &Result<T, E>, message: &str) => E {
    if let Err(e) = r {
        return e
    }
    panic(message)
}

/// Transform the success payload through `f`. The result is taken with `move`:
/// the failure arm hands back the `E` it was given, which is a partial move out
/// of the owned result, so an owned error type works.
fun map<T, U, E>(r: move Result<T, E>, f: closure fun(&T) => U) => Result<U, E> = when r {
    Ok(v) -> Result.Ok(value = f(v))
    Err(e) -> Result.Err(error = e)
}

/// Transform the failure payload through `f`. The result is taken with `move`,
/// for the mirror-image reason: the success arm hands back the `T` it was given.
fun map_err<T, E, F>(r: move Result<T, E>, f: closure fun(&E) => F) => Result<T, F> = when r {
    Ok(v) -> Result.Ok(value = v)
    Err(e) -> Result.Err(error = f(e))
}

// ---- methods ----
//
// The borrowing helpers, also callable on a value: `r.is_ok()`, `r.and_then(f)`,
// `r.unwrap_or(0)`. The ones that take the result with `move` (`map`, `map_err`)
// stay free functions: a method always borrows its receiver. The free `is_ok`,
// `is_err` and `unwrap_or` stay as the module's public spelling; each one calls
// its method.
//
// The rule for an error a default hides. `unwrap_or` drops the `Err` payload
// without reading it, logging it or passing it on, so its `E` needs no `Copy`.
// Use it only where the error carries nothing the caller needs: an optional
// setting, a parse with a plain default. Where the error matters, use `when`,
// `?` or `map_err`.

/// Whether the result is a success.
fun Result<T, E>.is_ok() => bool = when self {
    Ok(_) -> true
    Err(_) -> false
}

/// Whether the result is a failure.
fun Result<T, E>.is_err() => bool = when self {
    Ok(_) -> false
    Err(_) -> true
}

/// The success payload, or `fallback`, for a `Copy` success payload. The `Err`
/// payload is dropped: see the rule above the methods.
fun Result<T, E>.unwrap_or(fallback: T) => T = when self {
    Ok(v) -> v
    Err(_) -> fallback
}

/// Chain a second fallible step: `f` returns a `Result` itself, which is what
/// makes a sequence of fallible steps readable without nesting `if let`.
/// `E` must be `Copy`, since the failure arm rebuilds `Err`.
fun Result<T, E>.and_then<U>(f: closure fun(&T) => Result<U, E>) => Result<U, E> = when self {
    Ok(v) -> f(v)
    Err(e) -> Result.Err(error = e)
}

/// The result, or `f(e)` when it failed. `T` must be `Copy`, since the success
/// arm rebuilds `Ok`.
fun Result<T, E>.or_else<F>(f: closure fun(&E) => Result<T, F>) => Result<T, F> = when self {
    Ok(v) -> Result.Ok(value = v)
    Err(e) -> f(e)
}

/// Run `f` over the success payload, if there is one, and discard the result.
/// Works for any `T`.
fun Result<T, E>.each(f: closure fun(&T)) {
    when self {
        Ok(v) -> f(v)
        Err(_) -> {}
    }
}
