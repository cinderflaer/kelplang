//! Filesystem access, gated by the `fs` capability.
impl "std/str"
impl "std/path"
impl "std/io"
impl "std/result"
impl "std/option"

/* std/fs: the gated filesystem namespace (M7).

   The domain gate is compile-time: a module without the `fs` capability
   cannot *name* `fs.read` at all (resolution fails), and a module that does
   hold it gets its patterns compiled in as constant data, checked against
   every path argument at each call site before the syscall runs. The raw
   syscalls are the externs below; everything a caller sees is ordinary Kelp.

   Paths are `/`-separated on every platform in this API (the plan's `path`
   section): translating to `\` belongs at the syscall boundary.

   Symlinks appear twice here. The capability check *resolves* one before
   matching (`realpath`, and the rule each gated module's header states),
   because a link is not a name the author chose, so a link inside the grant
   that points outside it is denied. And `fs.symlink` *creates* one (MK5-S2-M2), with
   both of its paths checked against the grant, so a grant stays closed under
   link creation: a module can only make a link whose target it could also
   name. `target` has to be absolute, like every other path this API takes,
   because the check normalizes before it matches and only an absolute path
   normalizes at all. `fs.is_symlink` and `fs.read_link` (`lstat`/`readlink`) let
   a caller see a link as a link and read its target, and `walk`/`remove_all`
   stop at one rather than descending through it (MISSING-cK4hT). */

extern fun write_raw(path: &str, data: Bytes)
extern fun write_text_raw(path: &str, text: String)
extern fun remove_raw(path: &str)
extern fun rename_raw(from: &str, to: &str)
extern fun mkdir_raw(path: &str)
extern fun mkdir_all_raw(path: &str)
extern fun append_raw(path: &str, data: Bytes)
extern fun sync_raw(path: &str)
extern fun list_raw(path: &str) => String
extern fun open_raw(path: &str, mode: &str) => i32
extern fun copy_raw(from: &str, to: &str)
extern fun symlink_raw(target: &str, link: &str)
extern fun touch_raw(path: &str)
extern fun mtime_raw(path: &str) => i64
extern fun mode_raw(path: &str) => u32
extern fun set_mode_raw(path: &str, mode: u32)
// `stat` once, into out-parameters: an `extern` returns one value and a
// `datac`-returning body would have to name the generated C struct.
extern fun metadata_raw(path: &str, size: mut u64, mtime: mut i64, mode: mut u32, is_dir: mut bool, is_file: mut bool)

// The panicking raw read: the primitive the capability tests name directly. The
// fallible `read` is the one callers use.
extern fun read_raw(path: &str) => Bytes

// The fallible twins of `read_raw`/`open_raw`. Neither panics: the failure is
// written through `err` (0 on success) and the return value is whatever shape
// "no value" takes (`try_read_raw` returns an empty `Bytes`, `try_open_raw` a
// negative descriptor), so the caller has one value to drop on either path.
extern fun try_read_raw(path: &str, err: mut i32) => Bytes
extern fun try_open_raw(path: &str, mode: &str, err: mut i32) => i32

// The fallible forms of the mutators. Each writes the `errno` through `err` (0
// on success) instead of panicking.
extern fun try_write_raw(path: &str, data: Bytes, err: mut i32)
extern fun try_write_text_raw(path: &str, text: String, err: mut i32)
extern fun try_append_raw(path: &str, data: Bytes, err: mut i32)
extern fun try_remove_raw(path: &str, err: mut i32)
extern fun try_rename_raw(from: &str, to: &str, err: mut i32)
extern fun try_symlink_raw(target: &str, link: &str, err: mut i32)
extern fun try_mkdir_all_raw(path: &str, err: mut i32)
extern fun try_list_raw(path: &str, err: mut i32) => String

// Whether `data` is valid UTF-8. The same check `String.from_bytes` runs (and
// panics on), exposed so a fallible reader can ask before it copies.
extern fun utf8_valid_raw(data: &Bytes) => bool

/// A point-in-time view of one path (MK5-S5). `mode` is the low 12 permission
/// bits (`07777`), and `is_dir`/`is_file` are the two cases worth branching
/// on.
datac Metadata(
    /// The size in bytes.
    val size: u64,
    /// The last modification time, in seconds since the Unix epoch.
    val mtime: i64,
    /// The low 12 permission bits, as `set_mode` takes them.
    val mode: u32,
    /// Whether the path is a directory.
    val is_dir: bool,
    /// Whether the path is a regular file.
    val is_file: bool
)

/// The whole file, as owned bytes, or the reason it cannot be read. A scanner,
/// an indexer or a backup tool that skips what it may not read matches the
/// `Err`; a caller who wants a panic writes `result.expect(fs.read(path), "...")`. The
/// error carries the POSIX `errno` and its text (`io.IoErr`).
fun read(path: &str) => result.Result<Bytes, io.IoErr> {
    var err: i32 = 0
    val data = try_read_raw(path, &mut err)
    if err == 0 {
        return result.Result.Ok(value = data)
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `read` returns this result. Kept for one cycle.
fun try_read(path: &str) => result.Result<Bytes, io.IoErr> = read(path)

/// The whole file as text, or the reason it cannot be read. A file that is not
/// valid UTF-8 is a failure too: its `errno` is 0, because no syscall failed,
/// and `message` says so.
fun read_text(path: &str) => result.Result<String, io.IoErr> {
    var err: i32 = 0
    val data = try_read_raw(path, &mut err)
    if err != 0 {
        return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
    }
    if !utf8_valid_raw(data) {
        return result.Result.Err(error = io.IoErr(errno = 0, message = "fs.read_text: input is not valid utf-8"))
    }
    return result.Result.Ok(value = String.from_bytes(data))
}

/// Retired (issue #264): the plain `read_text` returns this result. Kept for one cycle.
fun try_read_text(path: &str) => result.Result<String, io.IoErr> = read_text(path)

/// Writing takes the bytes or the text by value: the data is handed over, not
/// borrowed, since the call consumes nothing else of it. It returns
/// `Result<unit, io.IoErr>`: `Ok(())` on success, and the POSIX `errno` and its
/// text on failure. `result.expect(fs.write(path, data), "...")` panics instead.
must_use fun write(path: &str, data: Bytes) => result.Result<unit, io.IoErr> {
    var err: i32 = 0
    try_write_raw(path, data, &mut err)
    if err == 0 {
        return result.Result.Ok(value = ())
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `write` returns this result. Kept for one cycle,
/// with the old `Option` shape: `None` on success, or the error.
must_use fun try_write(path: &str, data: Bytes) => option.Option<io.IoErr> {
    return when write(path, data) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// As `write`, for text. Returns `Result<unit, io.IoErr>`.
must_use fun write_text(path: &str, text: String) => result.Result<unit, io.IoErr> {
    var err: i32 = 0
    try_write_text_raw(path, text, &mut err)
    if err == 0 {
        return result.Result.Ok(value = ())
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `write_text` returns this result. Kept for one cycle.
must_use fun try_write_text(path: &str, text: String) => option.Option<io.IoErr> {
    return when write_text(path, text) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// The process's current working directory, absolute and free of `.`/`..`.
///
/// Gated on `fs` like every other name here, but it matches no pattern: it is
/// the domain's own view of where the process stands, and a caller cannot ask
/// for a different one. Turning a relative argument into a path the capability
/// check will accept is `path.absolute(fs.cwd(), arg)`.
/// Panics: if the kernel cannot report it.
extern fun cwd() => String = "cwd_raw"

/// Whether `path` exists.
extern fun exists(path: &str) => bool = "exists_raw"
/// Whether `path` is a regular file.
extern fun is_file(path: &str) => bool = "is_file_raw"
/// Whether `path` is a directory.
extern fun is_dir(path: &str) => bool = "is_dir_raw"

/// Whether `path` is itself a symlink. `is_file`/`is_dir` follow a link and
/// answer for what it points at; this is `lstat`, so it answers for the link,
/// and a broken link is `true` here and `false` for both of the others. The
/// path is normalized and symlink-resolved for the capability check like every
/// other `fs` path, so a link out of the grant is denied rather than reported.
extern fun is_symlink(path: &str) => bool = "is_symlink_raw"

/// The text `path` points at, exactly as it was stored: a relative target stays
/// relative (it is relative to the link's own directory), and a broken link
/// still has one.
/// Panics: if `path` is not a symlink, or cannot be read.
extern fun read_link(path: &str) => String = "read_link_raw"

/// Panics: if the file does not exist.
extern fun size(path: &str) => u64 = "size_raw"

/// Removes the file or the empty directory at `path`. Returns
/// `Result<unit, io.IoErr>`; `result.expect(fs.remove(path), "...")` panics instead.
must_use fun remove(path: &str) => result.Result<unit, io.IoErr> {
    var err: i32 = 0
    try_remove_raw(path, &mut err)
    if err == 0 {
        return result.Result.Ok(value = ())
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `remove` returns this result. Kept for one cycle.
must_use fun try_remove(path: &str) => option.Option<io.IoErr> {
    return when remove(path) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// Both paths are checked against the grant: `rename` is the one call with
/// two resource arguments. Returns `Result<unit, io.IoErr>`.
/// Panics: if either path is outside the granted capability (a check that is
/// compiled in, not a value).
must_use fun rename(from: &str, to: &str) => result.Result<unit, io.IoErr> {
    var err: i32 = 0
    try_rename_raw(from, to, &mut err)
    if err == 0 {
        return result.Result.Ok(value = ())
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `rename` returns this result. Kept for one cycle.
must_use fun try_rename(from: &str, to: &str) => option.Option<io.IoErr> {
    return when rename(from, to) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// One directory. `fs.mkdir_all` needs to walk prefixes of its path and is
/// deferred with the rest of the growable-path work.
/// Panics: if the directory cannot be created.
fun mkdir(path: &str) {
    mkdir_raw(path)
}

/// Appends `data` to the file, creating it if it does not exist. This is the
/// streaming primitive: it needs no growable buffer, only a buffer's worth of
/// data at a time, which is why it lands before the collections milestone that
/// `fs.append` was pencilled in with.
/// Returns `Result<unit, io.IoErr>`: the file cannot be opened or written.
must_use fun append(path: &str, data: Bytes) => result.Result<unit, io.IoErr> {
    var err: i32 = 0
    try_append_raw(path, data, &mut err)
    if err == 0 {
        return result.Result.Ok(value = ())
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `append` returns this result. Kept for one cycle.
must_use fun try_append(path: &str, data: Bytes) => option.Option<io.IoErr> {
    return when append(path, data) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// Forces everything written to the file so far out to storage. Without this a
/// timing is a timing of the page cache; with it, of the device.
/// Panics: if the file cannot be opened or synced.
fun sync(path: &str) {
    sync_raw(path)
}

/// The entries of one directory, sorted by name (`.` and `..` are dropped by
/// the raw walk). Each entry is a name, not a path: join it to a directory to
/// build something `fs` will accept.
///
/// Returning *N* items needed the growable sequence type, which is why this
/// arrived with the collections milestone rather than M7, the raw walk hands
/// back one newline-separated buffer (`str.split` then turns it into a
/// `List<String>`).
/// The entry names, or the reason the directory cannot be read (`errno` and its
/// text). A caller who wants a panic writes `result.expect(fs.list(path), "...")`.
fun list(path: &str) => result.Result<List<String>, io.IoErr> {
    var err: i32 = 0
    val raw = try_list_raw(path, &mut err)
    if err != 0 {
        return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
    }
    if str.len(raw) == 0 {
        var empty: List<String> = List.empty()
        return result.Result.Ok(value = empty)
    }
    return result.Result.Ok(value = str.split(raw, "\n"))
}

/// Retired (issue #264): the plain `list` returns this result. Kept for one cycle.
fun try_list(path: &str) => result.Result<List<String>, io.IoErr> = list(path)

// --- MK5-S5: breadth --------------------------------------------------------
//
// Everything below is ordinary Kelp over the primitives above, except the five
// new externs at the top of this file. The two recursive functions walk
// `p`refixed paths one component at a time; every path they build is passed
// through the same call-site capability check as a caller-written one,
// because the check sits on the public `fs` functions, not on the syscalls.

/// Creates every missing component of `path`, in order, treating an existing
/// component as success, so repeated setup is idempotent. The walk happens
/// inside one `extern` rather than in Kelp: the whole path is checked against the
/// grant once, at the call site, and a recursive Kelp version would have to check
/// each prefix, including the ones *above* the granted root (which is exactly
/// what a grant on `/var/lib/app/**` does not admit).
///
/// Returns `Result<unit, io.IoErr>`: the first directory along the way that
/// cannot be created is the error.
must_use fun mkdir_all(path: &str) => result.Result<unit, io.IoErr> {
    var err: i32 = 0
    try_mkdir_all_raw(path, &mut err)
    if err == 0 {
        return result.Result.Ok(value = ())
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `mkdir_all` returns this result. Kept for one cycle.
must_use fun try_mkdir_all(path: &str) => option.Option<io.IoErr> {
    return when mkdir_all(path) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// Removes `path`, recursively when it is a directory. A symlink is removed and
/// never descended into, `is_symlink` is checked before `is_dir`, so a link to a
/// directory is unlinked rather than walked into (BUG-a9Km4), and because every
/// child it does name is checked against the grant *after* resolution, a link
/// inside the grant that points outside it makes this panic instead of escaping.
/// `fs.symlink` cannot create such a link, since it checks both of its paths, but
/// one made by another tool can still be sitting in the tree.
///
/// Returns `Result<unit, io.IoErr>`: `Ok` when everything under `target` is
/// gone, or the first failure (`errno` and its text) with the rest left in
/// place. A link out of the grant that the walk reaches is still a capability
/// panic, not a value (open item 73).
///
/// The parameter is `target` rather than `path` because the module namespace
/// `path` is what the join below goes through, and a local binding shadows a
/// module name.
must_use fun remove_all(target: &str) => result.Result<unit, io.IoErr> {
    if is_symlink(target) {
        return remove(target)
    }
    if is_dir(target) {
        val listed = list(target)
        if let Err(e) = listed {
            return result.Result.Err(error = e)
        }
        if let Ok(entries) = listed {
            var i: int = 0
            while i < entries.len() {
                val child = path.join(target, entries.get(i).as_str())
                val failed = remove_all(child)
                if let Err(e) = failed {
                    return result.Result.Err(error = e)
                }
                i = i + 1
            }
        }
    }
    return remove(target)
}

/// Retired (issue #264): the plain `remove_all` returns this result. Kept for one cycle.
must_use fun try_remove_all(target: &str) => option.Option<io.IoErr> {
    return when remove_all(target) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// Every name under `dir`, recursively, each joined to its parent. A
/// depth-first walk driven by an explicit stack: `fs.list` is sorted per
/// directory, so the output is deterministic. A symlink is reported as an entry
/// and **not** descended into, so a link back up the tree cannot make the walk
/// run until the kernel refuses the path length (MISSING-cK4hT). Entries are
/// popped off the stack, which is also why the pending list is mutated without a
/// live borrow of itself (`List.get` would hold one for the whole loop body).
///
/// Panics: if any directory cannot be read.
fun walk(dir: &str) => List<String> {
    var out: List<String> = List.empty()
    var pending: List<String> = List.empty()
    pending.push(String.from_str(dir))
    while pending.len() > 0 {
        val current = pending.pop()
        val entries = result.expect(list(current), "fs.walk: a directory cannot be read")
        var i: int = 0
        while i < entries.len() {
            // Three joins, deliberately: a borrow of a local lasts to the end
            // of the block in v1, so the value `is_symlink`/`is_dir` probe
            // cannot then be moved into `pending`. `probe` stays put and is
            // dropped at the end of the iteration; the pushed value is a fresh
            // one.
            val name = path.join(current, entries.get(i).as_str())
            out.push(name)
            val probe = path.join(current, entries.get(i).as_str())
            val is_directory = !is_symlink(probe) && is_dir(probe)
            if is_directory {
                pending.push(path.join(current, entries.get(i).as_str()))
            }
            i = i + 1
        }
    }
    return out
}

/// Copies `from` to `to`, creating or truncating `to`. One `sendfile(2)`
/// loop, so a large file is never held in memory: a read/write loop would
/// buffer the whole thing at 20 GiB, and the repo already benchmarks that.
///
/// Both paths are checked against the grant: `copy`, like `rename`, is a
/// two-resource call.
/// Panics: if either path is outside the grant, or the copy fails.
fun copy(from: &str, to: &str) {
    copy_raw(from, to)
}

/// Creates `link` as a symlink whose contents are `target`. Both paths are
/// checked against the grant: `symlink`, like `rename` and `copy`, is a
/// two-resource call, so the link is created inside the grant and may only
/// point inside it as well. `target` must be absolute, for the reason every
/// path here must be; it does not have to exist yet, since a dangling link is a
/// legitimate thing to create.
///
/// Returns `Result<unit, io.IoErr>` when the link cannot be created. Panics:
/// if either path is outside the grant or `target` is not absolute (checks
/// that are compiled in, not values).
must_use fun symlink(target: &str, link: &str) => result.Result<unit, io.IoErr> {
    var err: i32 = 0
    try_symlink_raw(target, link, &mut err)
    if err == 0 {
        return result.Result.Ok(value = ())
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `symlink` returns this result. Kept for one cycle.
must_use fun try_symlink(target: &str, link: &str) => option.Option<io.IoErr> {
    return when symlink(target, link) {
        Ok(_) -> option.Option.None
        Err(e) -> option.Option.Some(value = e)
    }
}

/// Creates `path` when it is missing and sets its modification time to now
/// when it exists.
/// Panics: if the file cannot be created or its timestamp cannot be set.
fun touch(path: &str) {
    touch_raw(path)
}

/// Sets the permission bits of `path` to the low 12 bits of `mode` (the same
/// bits `Metadata.mode` reports), so `fs.set_mode(p, 493)` (octal 755) makes a downloaded
/// file executable.
///
/// Panics: if `path` is outside the grant or its mode cannot be changed.
fun set_mode(path: &str, mode: u32) {
    set_mode_raw(path, mode)
}

/// A `File` over `path`. `mode` is one of `"r"`, `"w"`, `"a"`, `"rw"`; the
/// returned value is `std/io`'s `File`, so `fs.open` is the bridge from a
/// path to the descriptor API. `"w"` and `"a"` create, `"rw"` creates and
/// does not truncate.
///
/// A `File` over `path`, or the reason it cannot be opened, with the same
/// error type as `read`. An unknown mode is a failure with `errno` `EINVAL`
/// (22), not a panic. A caller who wants a panic writes
/// `result.expect(fs.open(path, mode), "...")`.
fun open(path: &str, mode: &str) => result.Result<io.File, io.IoErr> {
    var err: i32 = 0
    val fd = try_open_raw(path, mode, &mut err)
    if err == 0 {
        return result.Result.Ok(value = io.File(fd = fd))
    }
    return result.Result.Err(error = io.IoErr(errno = err, message = io.errno_text(err)))
}

/// Retired (issue #264): the plain `open` returns this result. Kept for one cycle.
fun try_open(path: &str, mode: &str) => result.Result<io.File, io.IoErr> = open(path, mode)

/// Every line of a text file, without the line endings and without the empty
/// string a trailing newline would otherwise leave at the end (the same shape
/// `io.read_lines` produces).
///
/// Panics: if the file cannot be read or is not valid utf-8.
fun read_lines(path: &str) => List<String> {
    val text = result.expect(read_text(path), "fs.read_lines: the file cannot be read or is not valid utf-8")
    val s = text.as_str()
    if str.len(s) == 0 {
        var empty: List<String> = List.empty()
        return empty
    }
    val parts = str.split(s, "\n")
    if str.len(parts.get(parts.len() - 1).as_str()) == 0 {
        return parts.slice(0, parts.len() - 1)
    }
    return parts
}

/// A fresh, empty file whose name starts with `prefix` (the `XXXXXX` suffix
/// is filled in by `mkstemp`). The prefix is what the grant is checked
/// against, so the random suffix cannot escape it; the file is created, not
/// just named.
///
/// Panics: if the file cannot be created.
extern fun temp_path(prefix: &str) => String = "temp_path_raw"

/// The whole of `Metadata` from one `stat`, so a walk that measures every entry
/// pays one syscall per entry rather than the five this used to charge.
///
/// Panics: if the path cannot be stat-ed.
fun metadata(path: &str) => Metadata {
    var size: u64 = 0
    var mtime: i64 = 0
    var mode: u32 = 0
    var is_dir: bool = false
    var is_file: bool = false
    metadata_raw(path, &mut size, &mut mtime, &mut mode, &mut is_dir, &mut is_file)
    return Metadata(size = size, mtime = mtime, mode = mode, is_dir = is_dir, is_file = is_file)
}
