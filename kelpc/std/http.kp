impl "std/mem"
impl "std/net"
impl "std/tls"
impl "std/str"
impl "std/fmt"
impl "std/option"
impl "std/result"

/* std/http — an HTTP/1.1 client (S4). Ungated itself, and it *holds* `net`:
   the grant that governs its connections is the one its importer wrote
   (`impl "std/http" caps(net = ["api.example.com:443"])`), and the
   runtime check that follows uses those patterns, not any of its own. Because
   naming `net.connect` needs the `net` domain, a project that imports this
   module without delegating gets a compile error naming the module, not a
   client that fails at runtime.

   What this module owns, beyond request/response text:

    * **Keep-alive.** HTTP/1.1 is persistent by default, so the client does not
      send `Connection: close`; a connection goes back into the pool when the
      body was completely framed and the server did not ask to close.
    * **Framing, all of it.** `Content-Length`, `Transfer-Encoding: chunked`, a
      bodyless response, and the read-to-end-of-file fallback — the only case
      that costs a connection.
    * **The pool.** `http_pool` in `coral.toml` is how many kept-alive connections
      per `host:port` a program keeps (default 4; `0` disables pooling). The
      ceiling is spliced in by the compiler at the `const` below, and the pool
      is lazy: nothing connects until a request needs it.

   A `Lease` is a *ticket*, not an owner. The pool holds every descriptor; a
   lease is permission to use one for one exchange, and `release` consumes it.
   Since a `datac` is never `Copy`, releasing twice or using a lease after
   release is a compile error. That is the reason to have the pool in Kelp rather
   than in C: the ownership check is the borrow checker's, and it is free.

   **`https` (MK5-S4b-M1, open item 37)**: on the system OpenSSL, via
   `std/tls`. Every place that used to hold a `net.Socket` now holds a `Conn`
   (below) instead, which is a plain socket or a TLS session over one — the
   dial, the pool, the redirect follower and the framing reader do not care
   which, because `conn_send_all`/`conn_recv`/`conn_recv_into`/`conn_close`
   dispatch on it once. This module still does the dialing and the closing
   (`net.connect`, `net.close`): `std/tls`'s own header comment explains why
   it cannot do either itself, and why a program's existing
   `impl "std/http" caps(net = [...])` line, unchanged, is what covers an
   `https://` URL too — `https` is network access under the same grant, not
   a second capability to ask for.

   Not here, deliberately: gzip, HTTP/2, cookies, proxies,
   `Expect: 100-continue`, idle reaping, and serving TLS (client only). */

const DEFAULT_PORT: u16 = 80
const DEFAULT_HTTPS_PORT: u16 = 443
const DEFAULT_TIMEOUT_MS: u64 = 30000
const DEFAULT_MAX_REDIRECTS: i32 = 5

// The project's connection ceiling, from `coral.toml`'s `http_pool` key. The
// compiler substitutes the number here *before* this text is lexed, so a
// project with no manifest gets the compiler default. `0` means "no pooling":
// every exchange gets a fresh connection and nothing is kept.
const pool_size: usize = __KELP_HTTP_POOL__

datac Url(val scheme: String, val host: String, val port: u16, val path: String)

datac Header(val name: String, val value: String)

datac Response(val status: i32, val headers: List<Header>, val body: Bytes, val reusable: bool)

// The `X-RateLimit-*` bucket headers, bundled (MISSING-p5Xtr). Discord is the
// worked example the issue names, and its five headers — `Limit`,
// `Remaining`, `Reset`, `Reset-After`, `Bucket` — are also what GitHub and
// Twitch send under the same names, so those are the names this module uses
// rather than inventing its own vocabulary. `Global` and `Scope`, which
// Discord sends only on some `429`s and nowhere else, are left out: this is a
// bucket reader, not the whole of Discord's rate-limit protocol.
//
// Every field is an `Option` because no server is required to send all five
// (`Limit`/`Remaining` are the two nearly everyone sends; a per-route
// `Bucket` hash is closer to Discord's own scheme), and a response that sends
// none of them is not a parse failure — `Response.rate_limit()` on a plain
// `200` returns a `RateLimit` of five `None`s.
//
// `reset` and `reset_after` are `f64`, not `u64`: Discord's own docs give
// them with fractional seconds (`"X-RateLimit-Reset-After": "0.253"`), and a
// caller that only wants whole seconds can round.
datac RateLimit(
    val limit: option.Option<u64>,
    val remaining: option.Option<u64>,
    val reset: option.Option<f64>,
    val reset_after: option.Option<f64>,
    val bucket: option.Option<String>,
)

datac Request(val method: String, val url: String, val headers: List<Header>, val body: Bytes)

// `timeout_ms = 0` is "no timeout" (that is what `SO_RCVTIMEO` of zero means),
// which is deliberate: a program that wants to wait forever can say so.
datac Client(val timeout_ms: u64, val max_redirects: i32, val follow_redirects: bool)

// Why a fallible request failed, as a value a caller can branch on
// (MISSING-p7Kdm). The variants split on the one question a retry needs
// answered: **could the server have seen the request?**
//
// `Dial`: nothing was sent. The name did not resolve, the connection was
// refused, or (for `https`) the TLS handshake failed, so retrying any method
// is safe. `Exchange`: the connection was open and the request may have
// reached the server: a send failed, the peer reset or closed before the
// response was complete, a read timed out, or the response was malformed (a bad
// status line, a bad `Content-Length` or chunk). Retrying an idempotent
// request is the caller's call, and a `POST` is not safe to repeat without
// knowing more. `Redirects`: the chain was longer than the client allows; the
// requests before it did complete.
//
// Every `reason` is the text the panicking form panics with, so a caller that
// logs it prints what `send` would have printed on stderr.
enum HttpErr {
    Dial(val reason: String)
    Exchange(val reason: String)
    Redirects(val reason: String)
}

fun http_err_reason(e: move HttpErr).R: String = when e {
    Dial(reason) -> reason
    Exchange(reason) -> reason
    Redirects(reason) -> reason
}

// The panicking end of every fallible call below: one `panic` over the reason,
// so the two forms cannot report different causes.
fun fail_http<T>(e: move HttpErr).R: T {
    val reason = http_err_reason(e)
    panic(reason.as_str())
}

fun exchange_failed<T>(text: &str).R: result.Result<T, HttpErr> {
    return result.Result.Err(error = HttpErr.Exchange(reason = String.from_str(text)))
}

// A set of kept-alive connections to one `host:port`, keyed on the host **as
// written** — never on a resolved address, because the capability check
// matches the string the author wrote (S3's rule), and two spellings of one
// address can fall under different grants.
//
// `idle` holds the descriptors of connections that are open and not in use, and
// `size` is how many of those the pool agrees to *keep*. That is the standard
// "max idle" reading rather than a hard cap on open connections: a request that
// arrives while every kept connection is busy gets a fresh one, and `release`
// decides afterwards whether there is room to keep it. A program therefore
// never fails because its pool was small, which is worth more than a strict
// ceiling.
datac Pool(
    val host: String,
    val port: u16,
    val size: usize,
    val timeout_ms: u64,
    var idle: List<Conn>,
)

// Permission to use one pooled connection for one exchange. `fd`/`tls_handle`
// *are* the pair the pool hands out (a `Lease` and a `Conn` carry the same
// two fields; `Lease.conn` is the conversion), and `reused` says whether the
// connection was already open. Nothing here is owned, and `release` takes the
// lease by value, so the value is gone afterwards: releasing twice, or using a
// lease after release, does not compile. That check is the reason to have the
// pool in Kelp rather than in C — it is the borrow checker's, and it is free.
datac Lease(val fd: i32, val tls_handle: option.Option<tls.TlsHandle>, val reused: bool)

// One open connection, plain or TLS. `tls_handle` is the OpenSSL `SSL*` from
// `tls.handshake`, carried as the opaque `tls.TlsHandle`; a plain connection
// is `None` and a TLS one is `Some`, so there is no integer sentinel and no
// handle has to be invented for "not TLS".
//
// Everywhere this module used to hold a `net.Socket` it holds a `Conn`
// instead: the dial, the pool, redirect-following and the framing reader
// (`Cursor`) do not need to know which kind of connection they were handed,
// because `conn_send_all`/`conn_recv`/`conn_recv_into`/`conn_close` below are
// the one place that dispatches on it.
datac Conn(val fd: i32, val tls_handle: option.Option<tls.TlsHandle>)

fun Conn.is_tls().R: bool = when tls_handle {
    Some(_) -> true
    None -> false
}

// The TLS stream over this connection. Only legal after `is_tls()`, which is
// what every caller below checks first; the `panic` is unreachable and exists
// only because a handle has no null value to unwrap here.
fun Conn.tls().R: tls.TlsStream {
    if let Some(h) = tls_handle {
        return tls.TlsStream(fd = fd, handle = h)
    }
    panic("http: this connection is not TLS")
}

// Panics: as `tls.write_all`/`net.send_all`.
fun conn_send_all(c: Conn, data: Bytes).R: usize {
    if c.is_tls() {
        return tls.write_all(c.tls(), data)
    }
    return net.send_all(net.Socket(fd = c.fd), data)
}

// Panics: as `tls.read`/`net.recv`.
fun conn_recv(c: Conn, max: usize).R: Bytes {
    if c.is_tls() {
        return tls.read(c.tls(), max)
    }
    return net.recv(net.Socket(fd = c.fd), max)
}

// Panics: as `tls.read_into`/`net.recv_into`.
fun conn_recv_into(c: Conn, buf: mut Bytes, at: usize).R: usize {
    if c.is_tls() {
        return tls.read_into(c.tls(), buf, at)
    }
    return net.recv_into(net.Socket(fd = c.fd), buf, at)
}

// The fallible twins of the three calls above. A failure is `Exchange`: the
// connection was open, so the request may have reached the server.
fun conn_send_all_try(c: Conn, data: Bytes).R: result.Result<usize, HttpErr> {
    if c.is_tls() {
        return when tls.try_write_all(c.tls(), data) {
            Ok(n) -> result.Result.Ok(value = n)
            Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = tls.error_text(e)))
        }
    }
    return when net.try_send_all(net.Socket(fd = c.fd), data) {
        Ok(n) -> result.Result.Ok(value = n)
        Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = e.reason))
    }
}

fun conn_recv_try(c: Conn, max: usize).R: result.Result<Bytes, HttpErr> {
    if c.is_tls() {
        return when tls.try_read(c.tls(), max) {
            Ok(b) -> result.Result.Ok(value = b)
            Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = tls.error_text(e)))
        }
    }
    return when net.try_recv(net.Socket(fd = c.fd), max) {
        Ok(b) -> result.Result.Ok(value = b)
        Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = e.reason))
    }
}

fun conn_recv_into_try(c: Conn, buf: mut Bytes, at: usize).R: result.Result<usize, HttpErr> {
    if c.is_tls() {
        return when tls.try_read_into(c.tls(), buf, at) {
            Ok(n) -> result.Result.Ok(value = n)
            Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = tls.error_text(e)))
        }
    }
    return when net.try_recv_into(net.Socket(fd = c.fd), buf, at) {
        Ok(n) -> result.Result.Ok(value = n)
        Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = e.reason))
    }
}

// Ends the TLS session first (so the peer sees a clean `close_notify`, not a
// bare TCP reset) and then closes the socket. A plain connection just closes
// the socket. The shutdown is best effort: a peer that has already gone away
// is routine at the end of a connection, so the `Err` is dropped rather than
// panicked, the same contract `std/tls`'s own header gives it. Panics: as
// `net.close`.
fun conn_close(c: Conn) {
    if c.is_tls() {
        val _ended = tls.try_shutdown(c.tls())
    }
    net.close(net.Socket(fd = c.fd))
}

// Dials `host:port` and, for `https`, performs the TLS handshake — the one
// place a connection is actually made, called from a fresh exchange and from
// a pool's checkout alike.
//
// Panics: if the connection fails, the capability denies the host, or (for
// `https`) the handshake fails.
fun connect_configured(host: &str, port: u16, timeout_ms: u64, use_tls: bool).R: Conn {
    val up = when connect_configured_try(host, port, timeout_ms, use_tls) {
        Ok(c) -> c
        Err(e) -> fail_http(e)
    }
    return up
}

// The fallible dial: a refused or unresolvable dial, or a failed TLS handshake
// (the socket is closed first), is `HttpErr.Dial`, because nothing has been
// sent yet.
//
// Panics: if the capability denies the host. That check is compiled into the
// caller and has no value-returning form, exactly as `net.try_connect`'s.
fun connect_configured_try(host: &str, port: u16, timeout_ms: u64, use_tls: bool).R: result.Result<Conn, HttpErr> {
    val dialed = net.try_connect(host, port)
    return when dialed {
        Ok(sock) -> finish_dial(sock, host, timeout_ms, use_tls)
        Err(e) -> result.Result.Err(error = HttpErr.Dial(reason = e.reason))
    }
}

fun finish_dial(sock: net.Socket, host: &str, timeout_ms: u64, use_tls: bool).R: result.Result<Conn, HttpErr> {
    var s = net.Socket(fd = sock.fd)
    if timeout_ms > 0 {
        s.set_timeout(timeout_ms)
    }
    if use_tls {
        return when tls.try_handshake(s, host) {
            Ok(t) -> result.Result.Ok(value = Conn(fd = t.fd, tls_handle = option.Option.Some(value = t.handle)))
            Err(e) -> {
                net.close(s)
                result.Result.Err(error = HttpErr.Dial(reason = tls.error_text(e)))
            }
        }
    }
    return result.Result.Ok(value = Conn(fd = s.fd, tls_handle = option.Option.None))
}

// The read cursor for one response: bytes already received, and how far into
// them we are. It refills from the connection when it runs dry. It holds the
// connection's plain scalar fields rather than a `Conn` itself — the same
// reason `net.Socket` used to be unpacked to `fd: i32` here — because no
// `datac` is `Copy`, and a parameter is always a borrow: `Cursor(conn = c,
// ...)` would need to move `c`'s referent out of that borrow to store it,
// which does not compile. `fd` is `i32` and `tls_handle` is a handle the type
// system tracks (an `Option`, so its `None` is a real "not TLS" value rather
// than a sentinel), so reading the two off the borrow and rebuilding a `Conn`
// locally in each method below (`Conn(fd = fd, tls_handle = tls_handle)`)
// costs nothing and needs no move.
datac Cursor(val fd: i32, val tls_handle: option.Option<tls.TlsHandle>, var buf: Bytes, var start: usize)

fun Cursor.conn().R: Conn = Conn(fd = fd, tls_handle = tls_handle)

// ----- URLs -----

// The default port for a scheme this module knows: 80 for `http`, 443 for
// `https`. Panics: never — `parse_url` has already rejected anything else by
// the time this is called.
fun default_port_for(scheme: &str).R: u16 {
    if str.eq(scheme, "https") {
        return DEFAULT_HTTPS_PORT
    }
    return DEFAULT_PORT
}

// Whether `u` is an `https` URL — the one place that question is asked as a
// named call instead of a `str.eq` scattered at each site that needs it.
fun url_is_https(u: Url).R: bool = str.eq(u.scheme.as_str(), "https")

// Parses an absolute `http://` or `https://` URL. Panics: if there is no
// scheme, no host, or the scheme is anything else.
//
// The port is split at the *first* `:`, so an IPv6 literal is not expressible
// here either — the same rule `net`'s capability patterns follow, for the same
// reason: a host that contains the port separator would be ambiguous.
fun parse_url(s: &str).R: Url {
    val sep = option.expect(
        o = str.index_of(s, "://"),
        message = "http.parse_url: URL must start with 'http://' or 'https://' (no scheme found)",
    )
    val scheme = str.prefix(s, sep)
    if !str.eq(scheme.as_str(), "http") && !str.eq(scheme.as_str(), "https") {
        panic("http.parse_url: only 'http' and 'https' are supported")
    }
    val rest = str.substring(s, sep + 3)
    return split_authority(rest, scheme.as_str())
}

// Splits `host[:port][/path]` — the part after `://`. The path is everything
// from the first `/`, so a query string without a path (`host?a=b`) parses as
// part of the authority and fails there rather than silently losing the query.
fun split_authority(rest: &str, scheme: &str).R: Url {
    if str.is_empty(rest) {
        panic("http.parse_url: URL has no host")
    }
    val slash = str.index_of(rest, "/")
    if let Some(at) = slash {
        val authority = str.prefix(rest, at)
        val path = str.substring(rest, at)
        return make_url(authority, path, scheme)
    }
    val whole = str.prefix(rest, str.len(rest))
    return make_url(whole, "/", scheme)
}

fun make_url(authority: String, path: &str, scheme: &str).R: Url {
    if str.is_empty(authority.as_str()) {
        panic("http.parse_url: URL has no host")
    }
    val colon = str.index_of(authority.as_str(), ":")
    if let Some(at) = colon {
        // Bound to a place first: `str.substring` hands back a borrow of its
        // argument, and a borrow-returning call needs a variable or a field,
        // not a call result.
        val text = authority.as_str()
        val host = str.prefix(text, at)
        val port_text = str.substring(text, at + 1)
        return Url(
            scheme = String.from_str(scheme),
            host = host,
            port = parse_port(port_text),
            path = String.from_str(path),
        )
    }
    return Url(
        scheme = String.from_str(scheme),
        host = authority.clone(),
        port = default_port_for(scheme),
        path = String.from_str(path),
    )
}

fun parse_port(text: &str).R: u16 {
    if str.is_empty(text) {
        panic("http.parse_url: URL has an empty port")
    }
    val p = result.expect(
        r = str.parse_u64(text),
        message = "http.parse_url: URL port is not a number",
    )
    if p > 65535 {
        panic("http.parse_url: URL port is out of range")
    }
    return p.to_u16()
}

// ----- headers -----

// ASCII case-insensitive comparison. Header names are case-insensitive, the
// values here are ASCII by construction, and `str.to_lower` is ASCII-only
// (open item 48), so this is exactly as correct as the case operations
// underneath it.
fun name_eq(a: &str, b: &str).R: bool {
    if str.len(a) != str.len(b) {
        return false
    }
    val la = str.to_lower(a)
    val lb = str.to_lower(b)
    return str.eq(la.as_str(), lb.as_str())
}

fun empty_headers().R: List<Header> {
    var hs: List<Header> = List.empty()
    return hs
}

fun Response.has_header(name: &str).R: bool {
    var i: usize = 0
    while i < headers.len() {
        val h = headers.get(i)
        if name_eq(h.name.as_str(), name) {
            return true
        }
        i = i + 1
    }
    return false
}

// The first matching header's value, or an empty `String` when absent — v1
// has no `Option`, so absence is the empty string and `has_header` is the
// honest test.
//
// The result is *owned*, which is a deviation from the API sketch that had it
// return `&str`, and it is forced by two v1 facts rather than chosen: `&str`
// return elision roots at a parameter or a local, so a borrow reached through
// `List.get` cannot be handed back (`return headers.get(i).value.as_str()`
// fails the place rule, and binding the element first makes the root that
// binding instead of `self`), and a `list`-less view type does not exist yet.
// One allocation per lookup, until the length-carrying view (open item 44)
// makes the borrow expressible.
fun Response.header(name: &str).R: String {
    var i: usize = 0
    while i < headers.len() {
        val h = headers.get(i)
        if name_eq(h.name.as_str(), name) {
            return String.from_str(h.value.as_str())
        }
        i = i + 1
    }
    return String.empty()
}

fun Response.is_ok().R: bool = status >= 200 && status < 300

// The body as owned text. Panics: if the bytes are not valid utf-8
// (`String.from_bytes` validates). The body is cloned first because the
// response is borrowed here, and a field of a borrow cannot be moved out.
fun Response.text().R: String = String.from_bytes(body.clone())

// The `Retry-After` header, in seconds — `None` when it is absent, or when it
// names an HTTP-date instead of a delay (MISSING-p5Xtr). The date form
// (`Retry-After: Fri, 31 Dec 1999 23:59:59 GMT`) needs a calendar parser this
// module does not have: `std/time` (M7) is the gated clock namespace, and
// turning a date into a delay needs `now()` from it, which would put a second
// capability on every `std/http` program on the strength of a header real
// APIs rarely send that way (Discord, the worked example, always sends the
// seconds form). So the date form is read like any other malformed value: to
// `None`, the same answer as no header at all.
fun Response.retry_after().R: option.Option<u64> {
    val text = header_value(headers, "retry-after")
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    val parsed = str.parse_u64(text.as_str())
    return when parsed {
        Ok(seconds) -> option.Option.Some(value = seconds)
        Err(_) -> option.Option.None
    }
}

// The `X-RateLimit-*` bucket headers, bundled: a caller reading one after a
// `429` (or checking ahead of one) wants what all five have to say in one
// read, not five separate scans of `headers` — see `RateLimit`'s own comment
// for why these are the five and why each is an `Option`.
fun Response.rate_limit().R: RateLimit = RateLimit(
    limit = header_u64(headers, "x-ratelimit-limit"),
    remaining = header_u64(headers, "x-ratelimit-remaining"),
    reset = header_f64(headers, "x-ratelimit-reset"),
    reset_after = header_f64(headers, "x-ratelimit-reset-after"),
    bucket = header_opt(headers, "x-ratelimit-bucket"),
)

// ----- request text -----

// The whole request head, ending with the blank line. `Content-Length` is sent
// only when there is a body: `Content-Length: 0` on a `GET` is legal but
// unusual, and some servers object to it.
//
// No `Connection` header is sent on purpose. HTTP/1.1 is persistent unless the
// client asks otherwise, and staying silent is what lets the server's own
// `Connection: close` (if it sends one) be the single source of truth.
fun build_head(method: &str, u: Url, headers: List<Header>, body_len: usize).R: String {
    var out = String.with_capacity(256)
    out.push_str(method)
    out.push_str(" ")
    out.push_str(u.path.as_str())
    out.push_str(" HTTP/1.1\r\nHost: ")
    out.push_str(u.host.as_str())
    if u.port != default_port_for(u.scheme.as_str()) {
        out.push_str(":")
        // A formatted number is an owned temporary, so its `&str` view has to
        // be bound before it can be used: `fmt.uint(n).as_str()` taken as an
        // argument is the "temporary would be freed" error.
        val port_text = fmt.uint(u.port.to_u64())
        out.push_str(port_text.as_str())
    }
    out.push_str("\r\n")
    var i: usize = 0
    while i < headers.len() {
        out.push_str(headers.get(i).name.as_str())
        out.push_str(": ")
        out.push_str(headers.get(i).value.as_str())
        out.push_str("\r\n")
        i = i + 1
    }
    if body_len > 0 {
        out.push_str("Content-Length: ")
        val len_text = fmt.uint(body_len.to_u64())
        out.push_str(len_text.as_str())
        out.push_str("\r\n")
    }
    out.push_str("\r\n")
    return out
}

// ----- the response cursor -----

// Makes at least one byte available, refilling from the socket if needed.
//
// Fallible core; `ensure` is the panicking form. The `usize` is always 0: a
// `Result<unit, E>` has no success value to write (MISSING-n6Bsc).
fun mut Cursor.try_ensure().R: result.Result<usize, HttpErr> {
    if start >= buf.len() {
        val chunk = conn_recv_try(self.conn(), 4096)?
        if chunk.is_empty() {
            return exchange_failed("http: the connection closed inside the response body")
        }
        buf.clear()
        start = 0
        buf.append(chunk)
    }
    return result.Result.Ok(value = 0)
}

// Panics: if the peer closed instead of sending the rest of the body.
fun mut Cursor.ensure() {
    val done = when self.try_ensure() {
        Ok(n) -> n
        Err(e) -> fail_http(e)
    }
}

// One line, up to and including the `LF`; the `LF` is consumed and a `CR` is
// dropped. Dropping every `CR` rather than only a trailing one is safe here
// because neither a chunk size nor a header value may contain one — and it
// avoids a `String` truncation that does not exist yet.
fun mut Cursor.try_read_line().R: result.Result<String, HttpErr> {
    var out = String.empty()
    var going = true
    while going {
        self.try_ensure()?
        val c = buf.get(start)
        start = start + 1
        if c == 10 {
            going = false
        } else {
            if c != 13 {
                out.push(c)
            }
        }
    }
    return result.Result.Ok(value = out)
}

// Panics: as `ensure`.
fun mut Cursor.read_line().R: String {
    val line = when self.try_read_line() {
        Ok(l) -> l
        Err(e) -> fail_http(e)
    }
    return line
}

// Consumes one line and discards it: the `CRLF` after a chunk's data. This
// exists because discarding an owned `String` in statement position is
// rejected ("a non-tail statement that produces an owned value"), and there is
// no `_ =` to say "drop this".
fun mut Cursor.try_skip_line().R: result.Result<usize, HttpErr> {
    var going = true
    while going {
        self.try_ensure()?
        val c = buf.get(start)
        start = start + 1
        if c == 10 {
            going = false
        }
    }
    return result.Result.Ok(value = 0)
}

// Panics: as `ensure`.
fun mut Cursor.skip_line() {
    val done = when self.try_skip_line() {
        Ok(n) -> n
        Err(e) -> fail_http(e)
    }
}

// Exactly `n` bytes: whatever the cursor already holds, then direct reads into
// a buffer sized for the whole thing. Reading straight into the destination
// means the socket can never over-read past the body, which is what makes a
// pooled connection safe to reuse afterwards.
fun mut Cursor.try_read_exact(n: usize).R: result.Result<Bytes, HttpErr> {
    var out = mem.alloc(n)
    var got: usize = 0
    while got < n && start < buf.len() {
        out.set(got, buf.get(start))
        start = start + 1
        got = got + 1
    }
    if start >= buf.len() {
        buf.clear()
        start = 0
    }
    while got < n {
        val k = conn_recv_into_try(self.conn(), out, got)?
        if k == 0 {
            return exchange_failed("http: the connection closed before the whole body arrived")
        }
        got = got + k
    }
    return result.Result.Ok(value = out)
}

// Panics: if the peer closes before `n` bytes have arrived.
fun mut Cursor.read_exact(n: usize).R: Bytes {
    val body = when self.try_read_exact(n) {
        Ok(b) -> b
        Err(e) -> fail_http(e)
    }
    return body
}

// Everything up to end of file. Only for a response with no framing at all,
// which is also the case that cannot be pooled: the connection is spent
// finding the end of the body. With a timeout set, a peer that keeps the
// connection open turns this into `net.recv`'s "timed out" failure rather than
// a hang, which is the documented cost of an unframed response.
fun mut Cursor.try_read_to_end().R: result.Result<Bytes, HttpErr> {
    var out = Bytes.empty()
    while start < buf.len() {
        out.push(buf.get(start))
        start = start + 1
    }
    buf.clear()
    start = 0
    var going = true
    while going {
        val chunk = conn_recv_try(self.conn(), 4096)?
        if chunk.is_empty() {
            going = false
        } else {
            out.append(chunk)
        }
    }
    return result.Result.Ok(value = out)
}

// Panics: if a read fails.
fun mut Cursor.read_to_end().R: Bytes {
    val body = when self.try_read_to_end() {
        Ok(b) -> b
        Err(e) -> fail_http(e)
    }
    return body
}

// One hex digit, or -1 when the byte is not one.
fun hex_value(c: u8).R: i64 {
    if str.is_digit(c) {
        return (c - 48).to_i64()
    }
    if c >= 97 && c <= 102 {
        return (c - 87).to_i64()
    }
    if c >= 65 && c <= 70 {
        return (c - 55).to_i64()
    }
    return -1
}

// One hex digit. Panics: if the byte is not one.
fun hex_digit(c: u8).R: u32 {
    val v = hex_value(c)
    if v < 0 {
        panic("http: chunk size is not a hexadecimal number")
    }
    return v.to_u32()
}

// A chunk size: hex digits, optionally followed by `;extension`, which is
// ignored. A malformed size is an `Exchange` failure: the response is broken.
fun parse_hex_try(text: &str).R: result.Result<usize, HttpErr> {
    if str.is_empty(text) {
        return exchange_failed("http: empty chunk size")
    }
    var value: usize = 0
    var digits: usize = 0
    val tv = text.view()
    val n = tv.len()
    var i: usize = 0
    while i < n {
        val c = tv.get(i)
        if c == 59 {
            i = n
        } else {
            val d = hex_value(c)
            if d < 0 {
                return exchange_failed("http: chunk size is not a hexadecimal number")
            }
            value = value * 16 + d.to_usize()
            digits = digits + 1
            i = i + 1
        }
    }
    if digits == 0 {
        return exchange_failed("http: chunk size has no digits")
    }
    return result.Result.Ok(value = value)
}

// Panics: if there are no digits, or a digit is not hexadecimal.
fun parse_hex(text: &str).R: usize {
    val v = when parse_hex_try(text) {
        Ok(n) -> n
        Err(e) -> fail_http(e)
    }
    return v
}

// Decodes a chunked body: a hex size line, that many bytes, a `CRLF`, repeated
// until a zero size, then trailers until a blank line. This is what keep-alive
// makes mandatory: with a persistent connection there is no other way to find
// where a chunked body stops, and reading to end of file would block until the
// server closed a connection it intends to keep.
fun mut Cursor.try_read_chunked().R: result.Result<Bytes, HttpErr> {
    var out = Bytes.empty()
    var going = true
    while going {
        val size_text = self.try_read_line()?
        val size = parse_hex_try(size_text.as_str())?
        if size == 0 {
            going = false
        } else {
            val piece = self.try_read_exact(size)?
            out.append(piece)
            val skipped = self.try_skip_line()?
        }
    }
    var trailing = true
    while trailing {
        val line = self.try_read_line()?
        if str.is_empty(line.as_str()) {
            trailing = false
        }
    }
    return result.Result.Ok(value = out)
}

// Panics: on a malformed chunk or a peer that closes early.
fun mut Cursor.read_chunked().R: Bytes {
    val body = when self.try_read_chunked() {
        Ok(b) -> b
        Err(e) -> fail_http(e)
    }
    return body
}

// ----- response reading -----

// The offset just past the blank line that ends the header block, or 0 when it
// has not arrived yet. 0 is a usable sentinel because a header block can never
// end at offset 0 — the terminator alone is four bytes.
//
// This scans **bytes**, and that is not an optimization. `Bytes.as_str()`
// validates utf-8, and the buffer holds whatever arrived alongside the
// headers — so the first response with a binary body would panic right here,
// before the headers had even been located. Every synthetic test had an
// all-ASCII body, which is why it took `examples/download.kp` (a 200 KB image)
// to find this.
fun find_head_end(b: Bytes).R: usize {
    val n = b.len()
    var i: usize = 0
    while i + 4 <= n {
        if b.get(i) == 13 && b.get(i + 1) == 10 && b.get(i + 2) == 13 && b.get(i + 3) == 10 {
            return i + 4
        }
        i = i + 1
    }
    return 0
}

// The header block as text: the bytes before the terminator, copied and
// validated in one step, since `String.from_bytes` *adopts* the buffer instead
// of copying it. A header block that is not valid utf-8 is a malformed
// response, and this is where that becomes loud rather than producing a
// `String` that lies about its own invariant.
fun head_text(b: Bytes, end: usize).R: String {
    val n = end - 4
    var raw = mem.alloc(n)
    var i: usize = 0
    while i < n {
        raw.set(i, b.get(i))
        i = i + 1
    }
    return String.from_bytes(raw)
}

// The status line: `HTTP/1.1 200 OK`. Only the code matters here; the reason
// phrase may be absent or anything at all. A line with no code, or a code that
// is not a number, is an `Exchange` failure: the response is malformed.
fun parse_status_line_try(line: &str).R: result.Result<i32, HttpErr> {
    val sp = str.index_of(line, " ")
    if let Some(first) = sp {
        val rest = str.substring(line, first + 1)
        val sp2 = str.index_of(rest, " ")
        if let Some(at) = sp2 {
            val code_text = str.prefix(rest, at)
            return status_code_try(code_text.as_str())
        }
        return status_code_try(rest)
    }
    return exchange_failed("http: malformed status line (no status code)")
}

// Panics: if the line has no code, or the code is not a number.
fun parse_status_line(line: &str).R: i32 {
    val code = when parse_status_line_try(line) {
        Ok(c) -> c
        Err(e) -> fail_http(e)
    }
    return code
}

fun status_code_try(text: &str).R: result.Result<i32, HttpErr> {
    val parsed = str.parse_u64(text)
    if let Ok(p) = parsed {
        if p > 999 {
            return exchange_failed("http: the status code is out of range")
        }
        return result.Result.Ok(value = p.to_i32())
    }
    return exchange_failed("http: the status code is not a number")
}

fun status_code(text: &str).R: i32 {
    val code = when status_code_try(text) {
        Ok(c) -> c
        Err(e) -> fail_http(e)
    }
    return code
}

// Every header line after the status line, name and value split at the first
// `:`, both trimmed. A line with no `:` is skipped rather than treated as an
// error: HTTP allows a recipient to ignore what it does not understand.
fun parse_headers(lines: List<String>).R: List<Header> {
    var hs: List<Header> = List.empty()
    var i: usize = 1
    while i < lines.len() {
        val text = lines.get(i).as_str()
        if !str.is_empty(text) {
            val colon = str.index_of(text, ":")
            if let Some(at) = colon {
                val name = str.prefix(text, at)
                val value = str.trim(str.substring(text, at + 1))
                hs.push(Header(name = name, value = value))
            }
        }
        i = i + 1
    }
    return hs
}

fun header_value(hs: List<Header>, name: &str).R: String {
    var i: usize = 0
    while i < hs.len() {
        if name_eq(hs.get(i).name.as_str(), name) {
            return String.from_str(hs.get(i).value.as_str())
        }
        i = i + 1
    }
    return String.empty()
}

// A header's value as `u64`, or `None`. Absent and malformed are the same
// answer here: there is nothing to distinguish "the server didn't send this"
// from "the server sent something that isn't a number", and a caller only
// cares that it has no number to use either way (used for `Retry-After` and
// the integer `X-RateLimit-*` fields, MISSING-p5Xtr).
fun header_u64(hs: List<Header>, name: &str).R: option.Option<u64> {
    val text = header_value(hs, name)
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    val parsed = str.parse_u64(text.as_str())
    return when parsed {
        Ok(v) -> option.Option.Some(value = v)
        Err(_) -> option.Option.None
    }
}

// As `header_u64`, but `f64` — for `X-RateLimit-Reset` and
// `X-RateLimit-Reset-After`, which carry fractional seconds on the API this
// module was designed against.
fun header_f64(hs: List<Header>, name: &str).R: option.Option<f64> {
    val text = header_value(hs, name)
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    val parsed = str.parse_f64(text.as_str())
    return when parsed {
        Ok(v) -> option.Option.Some(value = v)
        Err(_) -> option.Option.None
    }
}

// A header's value as an owned `String`, or `None` for an absent header —
// unlike `Response.header`, which answers "" either way, this is for a caller
// that needs to tell "absent" apart from "present and empty" (used for
// `X-RateLimit-Bucket`, an opaque string with no numeric fallback).
fun header_opt(hs: List<Header>, name: &str).R: option.Option<String> {
    val text = header_value(hs, name)
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    return option.Option.Some(value = text)
}

// `-1` for absent, which is not a legal `Content-Length` — an absent header is
// not a parse failure, and the value is a count whose every non-negative value
// is meaningful, so there is nothing for an `Option` to add here. A header that
// is present and not a number is an `Exchange` failure.
fun content_length_try(hs: List<Header>).R: result.Result<i64, HttpErr> {
    val text = header_value(hs, "content-length")
    if str.is_empty(text.as_str()) {
        return result.Result.Ok(value = -1)
    }
    val parsed = str.parse_u64(text.as_str())
    if let Ok(p) = parsed {
        return result.Result.Ok(value = p.to_i64())
    }
    return exchange_failed("http: Content-Length is not a number")
}

// Panics: if the header is present and not a number.
fun content_length_of(hs: List<Header>).R: i64 {
    val n = when content_length_try(hs) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return n
}

fun is_chunked(hs: List<Header>).R: bool {
    val raw = header_value(hs, "transfer-encoding")
    val text = str.to_lower(raw.as_str())
    return str.contains(text.as_str(), "chunked")
}

fun wants_close(hs: List<Header>).R: bool {
    val raw = header_value(hs, "connection")
    val text = str.to_lower(raw.as_str())
    return str.contains(text.as_str(), "close")
}

// One whole response off one socket: header block, framing decision, body.
//
// Everything is a local because there is no destructuring: a helper that
// returned `(status, headers, cursor)` would have to be taken apart to be
// used, and no syntax does that. So the framing lives in `Cursor`'s methods
// and the parsing lives in the helpers above, while the assembly of the
// `Response` happens here, where every piece is still a plain binding.
//
// Fallible core: every failure is an `HttpErr.Exchange`.
fun read_response_try(c: Conn).R: result.Result<Response, HttpErr> {
    var buf = Bytes.empty()
    var end: usize = 0
    var eof = false
    while end == 0 && !eof {
        val chunk = conn_recv_try(c, 4096)?
        if chunk.is_empty() {
            eof = true
        } else {
            buf.append(chunk)
            end = find_head_end(buf)
        }
    }
    if end == 0 {
        return exchange_failed("http: the connection closed before the response headers arrived")
    }
    var status: i32 = 0
    var hs: List<Header> = List.empty()
    {
        val head_only = head_text(buf, end)
        val lines = str.split(head_only.as_str(), "\r\n")
        status = parse_status_line_try(lines.get(0).as_str())?
        hs = parse_headers(lines)
    }
    val chunked = is_chunked(hs)
    val len = content_length_try(hs)?
    val close = wants_close(hs)
    var cursor = Cursor(fd = c.fd, tls_handle = c.tls_handle, buf = buf, start = end)
    var body = Bytes.empty()
    if chunked {
        body = cursor.try_read_chunked()?
    } else {
        if len >= 0 {
            body = cursor.try_read_exact(len.to_usize())?
        } else {
            body = cursor.try_read_to_end()?
        }
    }
    // Reusable means: the body was completely framed (so the next byte on the
    // wire is the start of the next response) and the server did not ask to
    // close. Anything else and the connection is spent.
    val reusable = !close && (chunked || len >= 0)
    return result.Result.Ok(value = Response(status = status, headers = hs, body = body, reusable = reusable))
}

// Panics: on a peer that closes early, a malformed status line, a
// non-numeric `Content-Length`, a malformed chunk, or a read failure.
fun read_response(c: Conn).R: Response {
    val r = when read_response_try(c) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

// ----- one exchange, and redirects -----

// A full round trip on one socket: send the head and body, read the response.
// The socket's timeout is set by whoever opened it, not here, because a pooled
// connection is configured once on connect rather than on every request.
//
// Fallible core: a failed send or response read is an `HttpErr.Exchange`.
fun one_exchange_try(c: Conn, method: &str, u: Url, headers: List<Header>, body: Bytes).R: result.Result<Response, HttpErr> {
    val head = build_head(method, u, headers, body.len())
    conn_send_all_try(c, head.into_bytes())?
    // Unconditional: `send_all` of an empty buffer writes nothing, and this
    // avoids an `if` without an `else` whose body is a `usize` expression.
    conn_send_all_try(c, body)?
    return read_response_try(c)
}

// Panics: if the send or the response read fails.
fun one_exchange(c: Conn, method: &str, u: Url, headers: List<Header>, body: Bytes).R: Response {
    val r = when one_exchange_try(c, method, u, headers, body) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

// 301/302/303 become `GET` with no body (the historical behavior every browser
// implements); 307/308 preserve the method and body, which is exactly why they
// were standardized.
fun keep_body_on(status: i32).R: bool = status == 307 || status == 308

fun is_redirect(status: i32).R: bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

// A `Location` that is not absolute is resolved against the URL that produced
// the redirect. Only the scheme, host and port are inherited; the pool key
// and the capability check both use the resulting URL's own host, so a
// redirect to another name is a *different* connection needing its own
// grant. Inheriting `base.scheme` (not always `http`) is what keeps a
// relative redirect on an `https` connection from silently downgrading to
// plain `http` — an *absolute* `Location`, returned unchanged just above,
// is the only way a redirect actually crosses schemes.
fun absolute_url(base: Url, loc: &str).R: String {
    if str.starts_with(loc, "http://") || str.starts_with(loc, "https://") {
        return String.from_str(loc)
    }
    var out = String.with_capacity(64)
    out.push_str(base.scheme.as_str())
    out.push_str("://")
    out.push_str(base.host.as_str())
    out.push_str(":")
    val port_text = fmt.uint(base.port.to_u64())
    out.push_str(port_text.as_str())
    if str.starts_with(loc, "/") {
        out.push_str(loc)
    } else {
        out.push_str("/")
        out.push_str(loc)
    }
    return out
}

// Whether to follow this response, and where to. Panics: if the redirect chain
// is longer than the client allows — a loop is a malformed server, and v1 has
// no `Result` to report it with.
// Where a redirect chain goes next, or an empty string for "do not follow".
//
// The next URL is *returned by a call* (`absolute_url`) rather than carried in
// a `datac`, so the join rule lives in one place and every caller gets a
// freshly built value.
//
// Panics: if the chain is longer than the client allows.
fun follow_url(client: Client, base: Url, resp: Response, hops: i32).R: String {
    val next = when follow_url_try(client, base, resp, hops) {
        Ok(u) -> u
        Err(e) -> fail_http(e)
    }
    return next
}

// The fallible core of `follow_url`: a chain longer than the client allows is
// `HttpErr.Redirects`.
fun follow_url_try(client: Client, base: Url, resp: Response, hops: i32).R: result.Result<String, HttpErr> {
    if !client.follow_redirects {
        return result.Result.Ok(value = String.empty())
    }
    if !is_redirect(resp.status) {
        return result.Result.Ok(value = String.empty())
    }
    val loc = resp.header("location")
    if str.is_empty(loc.as_str()) {
        return result.Result.Ok(value = String.empty())
    }
    if hops <= 0 {
        return result.Result.Err(error = HttpErr.Redirects(reason = String.from_str("http: too many redirects")))
    }
    return result.Result.Ok(value = absolute_url(base, loc.as_str()))
}

fun default_client().R: Client = Client(
    timeout_ms = DEFAULT_TIMEOUT_MS,
    max_redirects = DEFAULT_MAX_REDIRECTS,
    follow_redirects = true,
)

// One request on a fresh connection, following redirects. Every hop connects
// again, which is the correct behavior for a redirect that changes host and
// the only option without a pool to consult.
//
// Panics: if the connection fails, the capability denies the host, the
// response is malformed, or the redirect chain is too long. `try_send` is the
// same call with every one of those but the capability denial as a value.
fun Client.send(req: Request).R: Response {
    val r = when self.try_send(req) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

// `send`, with the failures as an `HttpErr` (MISSING-p7Kdm): `Dial` when nothing
// was sent, `Exchange` when the request may have reached the server, `Redirects`
// for a chain that is too long.
//
// Panics: if the capability denies the host, or the URL is malformed. Both are
// mistakes in the program rather than conditions of the network, and the
// capability check has no value-returning form.
fun Client.try_send(req: Request).R: result.Result<Response, HttpErr> = send_fresh_try(
    self,
    req.method.clone(),
    req.url.clone(),
    req.headers,
    req.body.clone(),
    self.max_redirects,
)

fun send_fresh(
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: Response {
    val r = when send_fresh_try(client, method, url_text, headers, body, hops) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

fun send_fresh_try(
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: result.Result<Response, HttpErr> {
    val u = parse_url(url_text.as_str())
    val s = connect_configured_try(u.host.as_str(), u.port, client.timeout_ms, url_is_https(u))?
    val got = one_exchange_try(s, method.as_str(), u, headers, body)
    conn_close(s)
    val resp = got?
    // The redirect decision is one helper; the *tail* is written here because
    // `resp` is an owned local here and a returned borrow cannot leave. With no
    // function values in v1, that tail is written at each call site.
    val next = follow_url_try(client, u, resp, hops)?
    if str.is_empty(next.as_str()) {
        return result.Result.Ok(value = resp)
    }
    if keep_body_on(resp.status) {
        return send_fresh_try(client, method, next, headers, body, hops - 1)
    }
    return send_fresh_try(client, String.from_str("GET"), next, headers, Bytes.empty(), hops - 1)
}

// A single exchange on a connection the caller already holds: parse the URL,
// send, read. This is the concurrency-ready primitive — no pool and no client
// are named while it runs — and `Client.send`/`Pool.send` are the redirect
// loops built on top of it.
//
// Panics: as `one_exchange`, plus a malformed URL.
fun exchange(c: Conn, req: Request).R: Response {
    val u = parse_url(req.url.as_str())
    return one_exchange(c, req.method.as_str(), u, req.headers, req.body)
}

// `exchange`, with a failed send or response read as an `HttpErr.Exchange`.
//
// Panics: on a malformed URL.
fun exchange_try(c: Conn, req: Request).R: result.Result<Response, HttpErr> {
    val u = parse_url(req.url.as_str())
    return one_exchange_try(c, req.method.as_str(), u, req.headers, req.body)
}

// ----- the pool -----

// The pool for one `host:port`. The ceiling and the timeout come from the
// program's configuration (`http_pool`) and the default client; nothing is
// connected here, so creating a pool costs nothing.
fun pool(host: &str, port: u16).R: Pool = Pool(
    host = String.from_str(host),
    port = port,
    size = pool_size,
    timeout_ms = DEFAULT_TIMEOUT_MS,
    idle = empty_idle(),
)

fun empty_idle().R: List<Conn> {
    var l: List<Conn> = List.empty()
    return l
}

fun Pool.size().R: usize = size

// How many connections the pool is keeping right now.
fun Pool.len().R: usize = idle.len()

fun Lease.conn().R: Conn = Conn(fd = fd, tls_handle = tls_handle)

// Opens up to `size` connections now, so the first request does not pay for
// them. Optional by design: eager connecting is what makes a pool hurt startup,
// so it is a call a program makes rather than the default. `use_tls` has to be
// given here because a `Pool` is not itself keyed on a scheme — only on
// `host:port` — so warming has no request to read it from the way `checkout`
// does; the caller says how it means to use the pool.
//
// The pool's fields are copied into locals first and the idle count is read
// inside a block. That is not decoration: a shared borrow created in a *binding
// initializer* stays live to the end of the block (the lexical lifetimes open
// item 30 records), and `idle.push` needs the pool exclusively a line later.
//
// Panics: if a connection fails.
fun mut Pool.warm(use_tls: bool) {
    val h = host.clone()
    val p = port
    val t = timeout_ms
    val cap = size
    var i: usize = 0
    {
        i = idle.len()
    }
    while i < cap {
        val c = connect_configured(h.as_str(), p, t, use_tls)
        idle.push(c)
        i = i + 1
    }
}

// Hands out a connection: an idle one if there is one, a fresh one if there is
// not. The pool never refuses — the ceiling governs how many connections are
// *kept*, not how many may be in flight — so a caller holding two leases simply
// gets two connections, and only one of them is kept on release. An idle
// connection is reused only when its scheme is the one asked for: a kept
// connection of the other scheme (one `host:port` answering both `http` and
// `https`) is closed and replaced by a fresh one, so an `https` request is
// never sent over a plain connection and the reverse.
//
// Panics: if connecting fails.
fun mut Pool.checkout(use_tls: bool).R: Lease {
    val l = when self.try_checkout(use_tls) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return l
}

// `checkout`, with a failed dial as `HttpErr.Dial`.
//
// Panics: if the capability denies the host.
fun mut Pool.try_checkout(use_tls: bool).R: result.Result<Lease, HttpErr> {
    if !idle.is_empty() {
        val c = idle.pop()
        if c.is_tls() == use_tls {
            return result.Result.Ok(value = Lease(fd = c.fd, tls_handle = c.tls_handle, reused = true))
        }
        conn_close(c)
    }
    val h = host.clone()
    val p = port
    val t = timeout_ms
    val c = connect_configured_try(h.as_str(), p, t, use_tls)?
    return result.Result.Ok(value = Lease(fd = c.fd, tls_handle = c.tls_handle, reused = false))
}

// Gives a connection back. `release` consumes the lease, so this cannot happen
// twice. A connection that is not reusable — an unframed body, or a server that
// said `Connection: close` — is closed instead of kept, and so is one beyond
// the ceiling: the pool keeps at most `size`.
//
// Panics: if closing a connection fails.
fun mut Pool.release(lease: Lease, reusable: bool) {
    if reusable && idle.len() < size {
        idle.push(lease.conn())
    } else {
        conn_close(lease.conn())
    }
}

// Panics: if closing a connection fails.
fun mut Pool.close_all() {
    var going = true
    while going {
        if idle.is_empty() {
            going = false
        } else {
            val c = idle.pop()
            conn_close(c)
        }
    }
}

fun pool_matches(p: Pool, u: Url).R: bool {
    if p.size == 0 {
        return false
    }
    return str.eq(p.host.as_str(), u.host.as_str()) && p.port == u.port
}

fun mut Pool.send(req: Request).R: Response {
    val r = when self.try_send(req) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

// `send`, with the failures as an `HttpErr` (MISSING-p7Kdm), as `Client.try_send`
// reports them. A connection that failed mid-exchange is closed and not put
// back, so a pool never hands out a connection a failure left half read. An
// `Exchange` failure on a *reused* connection is the classic stale keep-alive
// (the server closed an idle connection before this request reached it), which
// is why a caller that retries an idempotent request once on `Exchange` is
// doing the ordinary thing.
//
// Panics: as `Client.try_send`.
fun mut Pool.try_send(req: Request).R: result.Result<Response, HttpErr> {
    val c = default_client()
    return pooled_hop_try(
        self,
        c,
        req.method.clone(),
        req.url.clone(),
        req.headers,
        req.body.clone(),
        c.max_redirects,
    )
}

fun pooled_hop(
    p: mut Pool,
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: Response {
    val r = when pooled_hop_try(p, client, method, url_text, headers, body, hops) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

fun pooled_hop_try(
    p: mut Pool,
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: result.Result<Response, HttpErr> {
    val u = parse_url(url_text.as_str())
    if pool_matches(p, u) {
        val lease = p.try_checkout(url_is_https(u))?
        val c = lease.conn()
        val got = one_exchange_try(c, method.as_str(), u, headers, body)
        if result.is_err(got) {
            p.release(lease, false)
            return got
        }
        val resp = got?
        p.release(lease, resp.reusable)
        val next = follow_url_try(client, u, resp, hops)?
        if str.is_empty(next.as_str()) {
            return result.Result.Ok(value = resp)
        }
        if keep_body_on(resp.status) {
            return pooled_hop_try(p, client, method, next, headers, body, hops - 1)
        }
        return pooled_hop_try(
            p,
            client,
            String.from_str("GET"),
            next,
            headers,
            Bytes.empty(),
            hops - 1,
        )
    }
    val s = connect_configured_try(u.host.as_str(), u.port, client.timeout_ms, url_is_https(u))?
    val got = one_exchange_try(s, method.as_str(), u, headers, body)
    conn_close(s)
    val resp = got?
    val next = follow_url_try(client, u, resp, hops)?
    if str.is_empty(next.as_str()) {
        return result.Result.Ok(value = resp)
    }
    if keep_body_on(resp.status) {
        return pooled_hop_try(p, client, method, next, headers, body, hops - 1)
    }
    return pooled_hop_try(
        p,
        client,
        String.from_str("GET"),
        next,
        headers,
        Bytes.empty(),
        hops - 1,
    )
}

// ----- the one-liners -----

// A `GET` on a fresh connection, no pool. Pooling is opt-in through an
// explicit `Pool` because a process-wide default pool would be shared mutable
// state, and threads (T1) would then need a lock around every request — see
// the plan's open item 61.
//
// Panics: if the connection fails, the capability denies the host, or the
// response is malformed.
fun get(url: &str).R: Response {
    val c = default_client()
    return c.send(make_get(url))
}

// `get`, with the failures as an `HttpErr` (`Client.try_send`).
fun try_get(url: &str).R: result.Result<Response, HttpErr> {
    val c = default_client()
    return c.try_send(make_get(url))
}

fun make_get(url: &str).R: Request = Request(
    method = String.from_str("GET"),
    url = String.from_str(url),
    headers = empty_headers(),
    body = Bytes.empty(),
)

// Panics: as `get`.
fun post_text(url: &str, body: &str, content_type: &str).R: Response {
    var hs: List<Header> = List.empty()
    hs.push(Header(name = String.from_str("Content-Type"), value = String.from_str(content_type)))
    val req = Request(
        method = String.from_str("POST"),
        url = String.from_str(url),
        headers = hs,
        body = Bytes.from_str(body),
    )
    val c = default_client()
    return c.send(req)
}
