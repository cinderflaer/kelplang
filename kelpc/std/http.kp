//! An HTTP/1.1 client and server over `std/net` and `std/tls`.
impl "std/mem"
impl "std/net"
impl "std/tls"
impl "std/str"
impl "std/fmt"
impl "std/option"
impl "std/result"
impl "std/encoding"
impl "std/thread"

/* std/http — an HTTP/1.1 client (S4). Ungated itself, and it *holds* `net`:
   the grant that governs its connections is the one its importer wrote
   (`impl "std/http" caps(net = ["api.example.com:443"])`), and the
   runtime check that follows uses those patterns, not any of its own. Because
   naming `net.connect` needs the `net` domain, a project that imports this
   module without delegating gets a compile error naming the module, not a
   client that fails at runtime.

   What this module owns, beyond request/response text:

    * **Keep-alive.** HTTP/1.1 is persistent by default, so the client does not
      send `Connection: close`; a connection goes back into the pool when the
      body was completely framed and the server did not ask to close.
    * **Framing, all of it.** `Content-Length`, `Transfer-Encoding: chunked`, a
      bodyless response, and the read-to-end-of-file fallback — the only case
      that costs a connection.
    * **The pool.** `http_pool` in `coral.toml` is how many kept-alive connections
      per `host:port` a program keeps (default 4; `0` disables pooling). The
      ceiling is spliced in by the compiler at the `const` below, and the pool
      is lazy: nothing connects until a request needs it.

   A `Lease` is a *ticket*, not an owner. The pool holds every descriptor; a
   lease is permission to use one for one exchange, and `release` consumes it.
   Since a `datac` is never `Copy`, releasing twice or using a lease after
   release is a compile error. That is the reason to have the pool in Kelp rather
   than in C: the ownership check is the borrow checker's, and it is free.

   **`https` (MK5-S4b-M1, open item 37)**: on the system OpenSSL, via
   `std/tls`. Every place that used to hold a `net.Socket` now holds a `Conn`
   (below) instead, which is a plain socket or a TLS session over one — the
   dial, the pool, the redirect follower and the framing reader do not care
   which, because `conn_send_all`/`conn_recv`/`conn_recv_into`/`conn_close`
   dispatch on it once. This module still does the dialing and the closing
   (`net.connect`, `net.close`): `std/tls`'s own header comment explains why
   it cannot do either itself, and why a program's existing
   `impl "std/http" caps(net = [...])` line, unchanged, is what covers an
   `https://` URL too — `https` is network access under the same grant, not
   a second capability to ask for.

   **The server (st2)** is at the end of this file: `listen`/`serve`, `Limits`,
   `ServerRequest`/`ServerResponse`. It shares the client's `Header` and
   framing helpers and is held on `net` the same way. `plan/http-server.md`
   is its design note.

   **HTTPS serving and client certificates (st3)**: `serve_tls`/`serve_tls_n`/
   `serve_tls_on` serve over a `tls.ServerConfig`, and `try_get_tls`/`get_tls`/
   `Client.try_send_tls` take `tls.TlsClientOptions` (private CA, mTLS, ALPN);
   `plan/tls-server.md`.

   Not here, deliberately: gzip, HTTP/2, cookies, proxies, `Expect:
   100-continue` on the client. (Idle reaping is `Pool.set_idle_timeout` and
   `Pool.close_idle`.) */

/// The port for `http` URLs.
const DEFAULT_PORT: u16 = 80
/// The port for `https` URLs.
const DEFAULT_HTTPS_PORT: u16 = 443
/// The default connect and read timeout, in milliseconds.
const DEFAULT_TIMEOUT_MS: u64 = 30000
/// How many redirects a client follows by default.
const DEFAULT_MAX_REDIRECTS: i32 = 5

/// The project's connection ceiling, from `coral.toml`'s `http_pool` key. The
/// compiler substitutes the number here *before* this text is lexed, so a
/// project with no manifest gets the compiler default. `0` means "no pooling":
/// every exchange gets a fresh connection and nothing is kept.
const pool_size: usize = __KELP_HTTP_POOL__

/// A parsed URL.
datac Url(val scheme: String, val host: String, val port: u16, val path: String)

/// One HTTP header.
datac Header(val name: String, val value: String)

/// A received HTTP response.
datac Response(val status: i32, val headers: List<Header>, val body: Bytes, val reusable: bool)

/// The `X-RateLimit-*` bucket headers, bundled (MISSING-p5Xtr). Discord is the
/// worked example the issue names, and its five headers — `Limit`,
/// `Remaining`, `Reset`, `Reset-After`, `Bucket` — are also what GitHub and
/// Twitch send under the same names, so those are the names this module uses
/// rather than inventing its own vocabulary. `Global` and `Scope`, which
/// Discord sends only on some `429`s and nowhere else, are left out: this is a
/// bucket reader, not the whole of Discord's rate-limit protocol.
///
/// Every field is an `Option` because no server is required to send all five
/// (`Limit`/`Remaining` are the two nearly everyone sends; a per-route
/// `Bucket` hash is closer to Discord's own scheme), and a response that sends
/// none of them is not a parse failure — `Response.rate_limit()` on a plain
/// `200` returns a `RateLimit` of five `None`s.
///
/// `reset` and `reset_after` are `f64`, not `u64`: Discord's own docs give
/// them with fractional seconds (`"X-RateLimit-Reset-After": "0.253"`), and a
/// caller that only wants whole seconds can round.
datac RateLimit(
    /// The quota for the window.
    val limit: option.Option<u64>,
    /// Requests left in the window.
    val remaining: option.Option<u64>,
    /// When the window resets, as a Unix time.
    val reset: option.Option<f64>,
    /// Seconds until the window resets.
    val reset_after: option.Option<f64>,
    /// The server's name for the bucket.
    val bucket: option.Option<String>,
)

/// An HTTP request to send.
datac Request(val method: String, val url: String, val headers: List<Header>, val body: Bytes)

/// `timeout_ms = 0` is "no timeout" (that is what `SO_RCVTIMEO` of zero means),
/// which is deliberate: a program that wants to wait forever can say so.
datac Client(val timeout_ms: u64, val max_redirects: i32, val follow_redirects: bool)

/// Why a fallible request failed, as a value a caller can branch on
/// (MISSING-p7Kdm). The variants split on the one question a retry needs
/// answered: **could the server have seen the request?**
///
/// `Dial`: nothing was sent. The name did not resolve, the connection was
/// refused, or (for `https`) the TLS handshake failed, so retrying any method
/// is safe. `Exchange`: the connection was open and the request may have
/// reached the server: a send failed, the peer reset or closed before the
/// response was complete, a read timed out, or the response was malformed (a bad
/// status line, a bad `Content-Length` or chunk). Retrying an idempotent
/// request is the caller's call, and a `POST` is not safe to repeat without
/// knowing more. `Redirects`: the chain was longer than the client allows; the
/// requests before it did complete.
///
/// Every `reason` is the text the panicking form panics with, so a caller that
/// logs it prints what `send` would have printed on stderr.
enum HttpErr {
    /// The connection could not be made.
    Dial(val reason: String)
    /// The request or response failed on the wire.
    Exchange(val reason: String)
    /// Too many redirects.
    Redirects(val reason: String)
}

/// The reason text inside an `HttpErr`.
fun http_err_reason(e: move HttpErr).R: String = when e {
    Dial(reason) -> reason
    Exchange(reason) -> reason
    Redirects(reason) -> reason
}

/// The panicking end of every fallible call below: one `panic` over the reason,
/// so the two forms cannot report different causes.
fun fail_http<T>(e: move HttpErr).R: T {
    val reason = http_err_reason(e)
    panic(reason.as_str())
}

/// An `Exchange` error carrying `text`.
fun exchange_failed<T>(text: &str).R: result.Result<T, HttpErr> {
    return result.Result.Err(error = HttpErr.Exchange(reason = String.from_str(text)))
}

/// A set of kept-alive connections to one `host:port`, keyed on the host **as
/// written** — never on a resolved address, because the capability check
/// matches the string the author wrote (S3's rule), and two spellings of one
/// address can fall under different grants.
///
/// `idle` holds the descriptors of connections that are open and not in use, and
/// `size` is how many of those the pool agrees to *keep*. That is the standard
/// "max idle" reading rather than a hard cap on open connections: a request that
/// arrives while every kept connection is busy gets a fresh one, and `release`
/// decides afterwards whether there is room to keep it. A program therefore
/// never fails because its pool was small, which is worth more than a strict
/// ceiling.
datac Pool(
    /// The host the pool connects to.
    val host: String,
    /// The port the pool connects to.
    val port: u16,
    /// How many idle connections the pool keeps.
    val size: usize,
    /// The timeout for each exchange, in milliseconds.
    val timeout_ms: u64,
    /// The idle connections ready for reuse.
    var idle: List<Conn>,
    /// When each idle connection went idle, `net.mono_ms` time, in step with
    /// `idle` (same length, same order).
    var idle_since: List<i64>,
    /// How long a connection may stay idle before `checkout` closes it instead
    /// of reusing it, in milliseconds; 0 keeps them for good (the default).
    var idle_ms: u64,
)

/// Permission to use one pooled connection for one exchange. `fd`/`tls_handle`
/// *are* the pair the pool hands out (a `Lease` and a `Conn` carry the same
/// two fields; `Lease.conn` is the conversion), and `reused` says whether the
/// connection was already open. Nothing here is owned, and `release` takes the
/// lease by value, so the value is gone afterwards: releasing twice, or using a
/// lease after release, does not compile. That check is the reason to have the
/// pool in Kelp rather than in C — it is the borrow checker's, and it is free.
datac Lease(val fd: i32, val tls_handle: option.Option<tls.TlsHandle>, val reused: bool)

/// One open connection, plain or TLS. `tls_handle` is the OpenSSL `SSL*` from
/// `tls.handshake`, carried as the opaque `tls.TlsHandle`; a plain connection
/// is `None` and a TLS one is `Some`, so there is no integer sentinel and no
/// handle has to be invented for "not TLS".
///
/// Everywhere this module used to hold a `net.Socket` it holds a `Conn`
/// instead: the dial, the pool, redirect-following and the framing reader
/// (`Cursor`) do not need to know which kind of connection they were handed,
/// because `conn_send_all`/`conn_recv`/`conn_recv_into`/`conn_close` below are
/// the one place that dispatches on it.
datac Conn(val fd: i32, val tls_handle: option.Option<tls.TlsHandle>)

/// Whether the connection is encrypted.
fun Conn.is_tls().R: bool = when tls_handle {
    Some(_) -> true
    None -> false
}

/// The TLS stream over this connection. Only legal after `is_tls()`, which is
/// what every caller below checks first; the `panic` is unreachable and exists
/// only because a handle has no null value to unwrap here.
fun Conn.tls().R: tls.TlsStream {
    if let Some(h) = tls_handle {
        return tls.TlsStream(fd = fd, handle = h)
    }
    panic("http: this connection is not TLS")
}

/// Panics: as `tls.write_all`/`net.send_all`.
fun conn_send_all(c: Conn, data: Bytes).R: usize {
    if c.is_tls() {
        return tls.write_all(c.tls(), data)
    }
    return net.send_all(net.Socket(fd = c.fd), data)
}

/// Panics: as `tls.read`/`net.recv`.
fun conn_recv(c: Conn, max: usize).R: Bytes {
    if c.is_tls() {
        return tls.read(c.tls(), max)
    }
    return net.recv(net.Socket(fd = c.fd), max)
}

/// Panics: as `tls.read_into`/`net.recv_into`.
fun conn_recv_into(c: Conn, buf: mut Bytes, at: usize).R: usize {
    if c.is_tls() {
        return tls.read_into(c.tls(), buf, at)
    }
    return net.recv_into(net.Socket(fd = c.fd), buf, at)
}

/// The fallible twins of the three calls above. A failure is `Exchange`: the
/// connection was open, so the request may have reached the server.
fun conn_send_all_try(c: Conn, data: Bytes).R: result.Result<usize, HttpErr> {
    if c.is_tls() {
        return when tls.try_write_all(c.tls(), data) {
            Ok(n) -> result.Result.Ok(value = n)
            Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = tls.error_text(e)))
        }
    }
    return when net.try_send_all(net.Socket(fd = c.fd), data) {
        Ok(n) -> result.Result.Ok(value = n)
        Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = e.reason))
    }
}

/// Reads up to `max` bytes, or the error.
fun conn_recv_try(c: Conn, max: usize).R: result.Result<Bytes, HttpErr> {
    if c.is_tls() {
        return when tls.try_read(c.tls(), max) {
            Ok(b) -> result.Result.Ok(value = b)
            Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = tls.error_text(e)))
        }
    }
    return when net.try_recv(net.Socket(fd = c.fd), max) {
        Ok(b) -> result.Result.Ok(value = b)
        Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = e.reason))
    }
}

/// Reads into `buf` at `at`, returning the byte count or the error.
fun conn_recv_into_try(c: Conn, buf: mut Bytes, at: usize).R: result.Result<usize, HttpErr> {
    if c.is_tls() {
        return when tls.try_read_into(c.tls(), buf, at) {
            Ok(n) -> result.Result.Ok(value = n)
            Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = tls.error_text(e)))
        }
    }
    return when net.try_recv_into(net.Socket(fd = c.fd), buf, at) {
        Ok(n) -> result.Result.Ok(value = n)
        Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = e.reason))
    }
}

/// Ends the TLS session first (so the peer sees a clean `close_notify`, not a
/// bare TCP reset) and then closes the socket. A plain connection just closes
/// the socket. The shutdown is best effort: a peer that has already gone away
/// is routine at the end of a connection, so the `Err` is dropped rather than
/// panicked, the same contract `std/tls`'s own header gives it. Panics: as
/// `net.close`.
fun conn_close(c: Conn) {
    if c.is_tls() {
        val _ended = tls.try_shutdown(c.tls())
    }
    net.close(net.Socket(fd = c.fd))
}

/// Dials `host:port` and, for `https`, performs the TLS handshake — the one
/// place a connection is actually made, called from a fresh exchange and from
/// a pool's checkout alike.
///
/// Panics: if the connection fails, the capability denies the host, or (for
/// `https`) the handshake fails.
fun connect_configured(host: &str, port: u16, timeout_ms: u64, use_tls: bool).R: Conn {
    val up = when connect_configured_try(host, port, timeout_ms, use_tls) {
        Ok(c) -> c
        Err(e) -> fail_http(e)
    }
    return up
}

/// The fallible dial: a refused or unresolvable dial, or a failed TLS handshake
/// (the socket is closed first), is `HttpErr.Dial`, because nothing has been
/// sent yet.
///
/// Panics: if the capability denies the host. That check is compiled into the
/// caller and has no value-returning form, exactly as `net.try_connect`'s.
fun connect_configured_try(host: &str, port: u16, timeout_ms: u64, use_tls: bool).R: result.Result<Conn, HttpErr> {
    val dialed = net.try_connect(host, port)
    return when dialed {
        Ok(sock) -> finish_dial(sock, host, timeout_ms, use_tls)
        Err(e) -> result.Result.Err(error = HttpErr.Dial(reason = e.reason))
    }
}

/// Finishes a dialed socket into a connection, with TLS when asked.
fun finish_dial(sock: net.Socket, host: &str, timeout_ms: u64, use_tls: bool).R: result.Result<Conn, HttpErr> {
    var s = net.Socket(fd = sock.fd)
    if timeout_ms > 0 {
        s.set_timeout(timeout_ms)
    }
    if use_tls {
        return when tls.try_handshake(s, host) {
            Ok(t) -> result.Result.Ok(value = Conn(fd = t.fd, tls_handle = option.Option.Some(value = t.handle)))
            Err(e) -> {
                net.close(s)
                result.Result.Err(error = HttpErr.Dial(reason = tls.error_text(e)))
            }
        }
    }
    return result.Result.Ok(value = Conn(fd = s.fd, tls_handle = option.Option.None))
}

/// The read cursor for one response: bytes already received, and how far into
/// them we are. It refills from the connection when it runs dry. It holds the
/// connection's plain scalar fields rather than a `Conn` itself — the same
/// reason `net.Socket` used to be unpacked to `fd: i32` here — because no
/// `datac` is `Copy`, and a parameter is always a borrow: `Cursor(conn = c,
/// ...)` would need to move `c`'s referent out of that borrow to store it,
/// which does not compile. `fd` is `i32` and `tls_handle` is a handle the type
/// system tracks (an `Option`, so its `None` is a real "not TLS" value rather
/// than a sentinel), so reading the two off the borrow and rebuilding a `Conn`
/// locally in each method below (`Conn(fd = fd, tls_handle = tls_handle)`)
/// costs nothing and needs no move.
datac Cursor(val fd: i32, val tls_handle: option.Option<tls.TlsHandle>, var buf: Bytes, var start: usize)

/// The connection a cursor reads.
fun Cursor.conn().R: Conn = Conn(fd = fd, tls_handle = tls_handle)

// ----- URLs -----

/// The default port for a scheme this module knows: 80 for `http`, 443 for
/// `https`. Panics: never — `parse_url` has already rejected anything else by
/// the time this is called.
fun default_port_for(scheme: &str).R: u16 {
    if str.eq(scheme, "https") {
        return DEFAULT_HTTPS_PORT
    }
    return DEFAULT_PORT
}

/// Whether `u` is an `https` URL — the one place that question is asked as a
/// named call instead of a `str.eq` scattered at each site that needs it.
fun url_is_https(u: Url).R: bool = str.eq(u.scheme.as_str(), "https")

/// Parses an absolute `http://` or `https://` URL. Panics: if there is no
/// scheme, no host, or the scheme is anything else.
///
/// The port is split at the *first* `:`, so an IPv6 literal is not expressible
/// here either — the same rule `net`'s capability patterns follow, for the same
/// reason: a host that contains the port separator would be ambiguous.
fun parse_url(s: &str).R: Url {
    val sep = option.expect(
        o = str.index_of(s, "://"),
        message = "http.parse_url: URL must start with 'http://' or 'https://' (no scheme found)",
    )
    val scheme = str.prefix(s, sep)
    if !str.eq(scheme.as_str(), "http") && !str.eq(scheme.as_str(), "https") {
        panic("http.parse_url: only 'http' and 'https' are supported")
    }
    val rest = str.substring(s, sep + 3)
    return split_authority(rest, scheme.as_str())
}

/// Splits `host[:port][/path]` — the part after `://`. The path is everything
/// from the first `/`, so a query string without a path (`host?a=b`) parses as
/// part of the authority and fails there rather than silently losing the query.
fun split_authority(rest: &str, scheme: &str).R: Url {
    if str.is_empty(rest) {
        panic("http.parse_url: URL has no host")
    }
    val slash = str.index_of(rest, "/")
    if let Some(at) = slash {
        val authority = str.prefix(rest, at)
        val path = str.substring(rest, at)
        return make_url(authority, path, scheme)
    }
    val whole = str.prefix(rest, str.len(rest))
    return make_url(whole, "/", scheme)
}

/// Builds a `Url` from an authority, a path and a scheme.
fun make_url(authority: String, path: &str, scheme: &str).R: Url {
    if str.is_empty(authority.as_str()) {
        panic("http.parse_url: URL has no host")
    }
    val colon = str.index_of(authority.as_str(), ":")
    if let Some(at) = colon {
        // Bound to a place first: `str.substring` hands back a borrow of its
        // argument, and a borrow-returning call needs a variable or a field,
        // not a call result.
        val text = authority.as_str()
        val host = str.prefix(text, at)
        val port_text = str.substring(text, at + 1)
        return Url(
            scheme = String.from_str(scheme),
            host = host,
            port = parse_port(port_text),
            path = String.from_str(path),
        )
    }
    return Url(
        scheme = String.from_str(scheme),
        host = authority.clone(),
        port = default_port_for(scheme),
        path = String.from_str(path),
    )
}

/// Parses a port number, panicking when it is invalid.
fun parse_port(text: &str).R: u16 {
    if str.is_empty(text) {
        panic("http.parse_url: URL has an empty port")
    }
    val p = result.expect(
        r = str.parse_u64(text),
        message = "http.parse_url: URL port is not a number",
    )
    if p > 65535 {
        panic("http.parse_url: URL port is out of range")
    }
    return p.to_u16()
}

// ----- headers -----

/// ASCII case-insensitive comparison. Header names are case-insensitive, the
/// values here are ASCII by construction, and `str.to_lower` is ASCII-only
/// (open item 48), so this is exactly as correct as the case operations
/// underneath it.
fun name_eq(a: &str, b: &str).R: bool {
    if str.len(a) != str.len(b) {
        return false
    }
    val la = str.to_lower(a)
    val lb = str.to_lower(b)
    return str.eq(la.as_str(), lb.as_str())
}

/// An empty header list.
fun empty_headers().R: List<Header> {
    var hs: List<Header> = List.empty()
    return hs
}

/// Whether the response has a header called `name`.
fun Response.has_header(name: &str).R: bool {
    var i: usize = 0
    while i < headers.len() {
        val h = headers.get(i)
        if name_eq(h.name.as_str(), name) {
            return true
        }
        i = i + 1
    }
    return false
}

/// The first matching header's value, or an empty `String` when absent — v1
/// has no `Option`, so absence is the empty string and `has_header` is the
/// honest test.
///
/// The result is *owned*, which is a deviation from the API sketch that had it
/// return `&str`, and it is forced by two v1 facts rather than chosen: `&str`
/// return elision roots at a parameter or a local, so a borrow reached through
/// `List.get` cannot be handed back (`return headers.get(i).value.as_str()`
/// fails the place rule, and binding the element first makes the root that
/// binding instead of `self`), and a `list`-less view type does not exist yet.
/// One allocation per lookup, until the length-carrying view (open item 44)
/// makes the borrow expressible.
fun Response.header(name: &str).R: String {
    var i: usize = 0
    while i < headers.len() {
        val h = headers.get(i)
        if name_eq(h.name.as_str(), name) {
            return String.from_str(h.value.as_str())
        }
        i = i + 1
    }
    return String.empty()
}

/// Whether the status is 2xx.
fun Response.is_ok().R: bool = status >= 200 && status < 300

/// The body as owned text. Panics: if the bytes are not valid utf-8
/// (`String.from_bytes` validates). The body is cloned first because the
/// response is borrowed here, and a field of a borrow cannot be moved out.
fun Response.text().R: String = String.from_bytes(body.clone())

/// The `Retry-After` header, in seconds — `None` when it is absent, or when it
/// names an HTTP-date instead of a delay (MISSING-p5Xtr). The date form
/// (`Retry-After: Fri, 31 Dec 1999 23:59:59 GMT`) needs a calendar parser this
/// module does not have: `std/time` (M7) is the gated clock namespace, and
/// turning a date into a delay needs `now()` from it, which would put a second
/// capability on every `std/http` program on the strength of a header real
/// APIs rarely send that way (Discord, the worked example, always sends the
/// seconds form). So the date form is read like any other malformed value: to
/// `None`, the same answer as no header at all.
fun Response.retry_after().R: option.Option<u64> {
    val text = header_value(headers, "retry-after")
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    val parsed = str.parse_u64(text.as_str())
    return when parsed {
        Ok(seconds) -> option.Option.Some(value = seconds)
        Err(_) -> option.Option.None
    }
}

/// The `X-RateLimit-*` bucket headers, bundled: a caller reading one after a
/// `429` (or checking ahead of one) wants what all five have to say in one
/// read, not five separate scans of `headers` — see `RateLimit`'s own comment
/// for why these are the five and why each is an `Option`.
fun Response.rate_limit().R: RateLimit = RateLimit(
    limit = header_u64(headers, "x-ratelimit-limit"),
    remaining = header_u64(headers, "x-ratelimit-remaining"),
    reset = header_f64(headers, "x-ratelimit-reset"),
    reset_after = header_f64(headers, "x-ratelimit-reset-after"),
    bucket = header_opt(headers, "x-ratelimit-bucket"),
)

// ----- request text -----

/// The whole request head, ending with the blank line. `Content-Length` is sent
/// only when there is a body: `Content-Length: 0` on a `GET` is legal but
/// unusual, and some servers object to it.
///
/// No `Connection` header is sent on purpose. HTTP/1.1 is persistent unless the
/// client asks otherwise, and staying silent is what lets the server's own
/// `Connection: close` (if it sends one) be the single source of truth.
fun build_head(method: &str, u: Url, headers: List<Header>, body_len: usize).R: String {
    var out = String.with_capacity(256)
    out.push_str(method)
    out.push_str(" ")
    out.push_str(u.path.as_str())
    out.push_str(" HTTP/1.1\r\nHost: ")
    out.push_str(u.host.as_str())
    if u.port != default_port_for(u.scheme.as_str()) {
        out.push_str(":")
        // A formatted number is an owned temporary, so its `&str` view has to
        // be bound before it can be used: `fmt.uint(n).as_str()` taken as an
        // argument is the "temporary would be freed" error.
        val port_text = fmt.uint(u.port.to_u64())
        out.push_str(port_text.as_str())
    }
    out.push_str("\r\n")
    var i: usize = 0
    while i < headers.len() {
        out.push_str(headers.get(i).name.as_str())
        out.push_str(": ")
        out.push_str(headers.get(i).value.as_str())
        out.push_str("\r\n")
        i = i + 1
    }
    if body_len > 0 {
        out.push_str("Content-Length: ")
        val len_text = fmt.uint(body_len.to_u64())
        out.push_str(len_text.as_str())
        out.push_str("\r\n")
    }
    out.push_str("\r\n")
    return out
}

// ----- the response cursor -----

/// Makes at least one byte available, refilling from the socket if needed.
///
/// Fallible core; `ensure` is the panicking form. The `usize` is always 0: a
/// `Result<unit, E>` has no success value to write (MISSING-n6Bsc).
fun mut Cursor.try_ensure().R: result.Result<usize, HttpErr> {
    if start >= buf.len() {
        val chunk = conn_recv_try(self.conn(), 4096)?
        if chunk.is_empty() {
            return exchange_failed("http: the connection closed inside the response body")
        }
        buf.clear()
        start = 0
        buf.append(chunk)
    }
    return result.Result.Ok(value = 0)
}

/// Panics: if the peer closed instead of sending the rest of the body.
fun mut Cursor.ensure() {
    val done = when self.try_ensure() {
        Ok(n) -> n
        Err(e) -> fail_http(e)
    }
}

/// One line, up to and including the `LF`; the `LF` is consumed and a `CR` is
/// dropped. Dropping every `CR` rather than only a trailing one is safe here
/// because neither a chunk size nor a header value may contain one — and it
/// avoids a `String` truncation that does not exist yet.
fun mut Cursor.try_read_line().R: result.Result<String, HttpErr> {
    var out = String.empty()
    var going = true
    while going {
        self.try_ensure()?
        val c = buf.get(start)
        start = start + 1
        if c == 10 {
            going = false
        } else {
            if c != 13 {
                out.push(c)
            }
        }
    }
    return result.Result.Ok(value = out)
}

/// Panics: as `ensure`.
fun mut Cursor.read_line().R: String {
    val line = when self.try_read_line() {
        Ok(l) -> l
        Err(e) -> fail_http(e)
    }
    return line
}

/// Consumes one line and discards it: the `CRLF` after a chunk's data. This
/// exists because discarding an owned `String` in statement position is
/// rejected ("a non-tail statement that produces an owned value"), and there is
/// no `_ =` to say "drop this".
fun mut Cursor.try_skip_line().R: result.Result<usize, HttpErr> {
    var going = true
    while going {
        self.try_ensure()?
        val c = buf.get(start)
        start = start + 1
        if c == 10 {
            going = false
        }
    }
    return result.Result.Ok(value = 0)
}

/// Panics: as `ensure`.
fun mut Cursor.skip_line() {
    val done = when self.try_skip_line() {
        Ok(n) -> n
        Err(e) -> fail_http(e)
    }
}

/// Exactly `n` bytes: whatever the cursor already holds, then direct reads into
/// a buffer sized for the whole thing. Reading straight into the destination
/// means the socket can never over-read past the body, which is what makes a
/// pooled connection safe to reuse afterwards.
fun mut Cursor.try_read_exact(n: usize).R: result.Result<Bytes, HttpErr> {
    var out = mem.alloc(n)
    var got: usize = 0
    while got < n && start < buf.len() {
        out.set(got, buf.get(start))
        start = start + 1
        got = got + 1
    }
    if start >= buf.len() {
        buf.clear()
        start = 0
    }
    while got < n {
        val k = conn_recv_into_try(self.conn(), out, got)?
        if k == 0 {
            return exchange_failed("http: the connection closed before the whole body arrived")
        }
        got = got + k
    }
    return result.Result.Ok(value = out)
}

/// Panics: if the peer closes before `n` bytes have arrived.
fun mut Cursor.read_exact(n: usize).R: Bytes {
    val body = when self.try_read_exact(n) {
        Ok(b) -> b
        Err(e) -> fail_http(e)
    }
    return body
}

/// Everything up to end of file. Only for a response with no framing at all,
/// which is also the case that cannot be pooled: the connection is spent
/// finding the end of the body. With a timeout set, a peer that keeps the
/// connection open turns this into `net.recv`'s "timed out" failure rather than
/// a hang, which is the documented cost of an unframed response.
fun mut Cursor.try_read_to_end().R: result.Result<Bytes, HttpErr> {
    var out = Bytes.empty()
    while start < buf.len() {
        out.push(buf.get(start))
        start = start + 1
    }
    buf.clear()
    start = 0
    var going = true
    while going {
        val chunk = conn_recv_try(self.conn(), 4096)?
        if chunk.is_empty() {
            going = false
        } else {
            out.append(chunk)
        }
    }
    return result.Result.Ok(value = out)
}

/// Panics: if a read fails.
fun mut Cursor.read_to_end().R: Bytes {
    val body = when self.try_read_to_end() {
        Ok(b) -> b
        Err(e) -> fail_http(e)
    }
    return body
}

/// One hex digit, or -1 when the byte is not one.
fun hex_value(c: u8).R: i64 {
    if str.is_digit(c) {
        return (c - 48).to_i64()
    }
    if c >= 97 && c <= 102 {
        return (c - 87).to_i64()
    }
    if c >= 65 && c <= 70 {
        return (c - 55).to_i64()
    }
    return -1
}

/// One hex digit. Panics: if the byte is not one.
fun hex_digit(c: u8).R: u32 {
    val v = hex_value(c)
    if v < 0 {
        panic("http: chunk size is not a hexadecimal number")
    }
    return v.to_u32()
}

/// A chunk size: hex digits, optionally followed by `;extension`, which is
/// ignored. A malformed size is an `Exchange` failure: the response is broken.
fun parse_hex_try(text: &str).R: result.Result<usize, HttpErr> {
    if str.is_empty(text) {
        return exchange_failed("http: empty chunk size")
    }
    var value: usize = 0
    var digits: usize = 0
    val tv = text.view()
    val n = tv.len()
    var i: usize = 0
    while i < n {
        val c = tv.get(i)
        if c == 59 {
            i = n
        } else {
            val d = hex_value(c)
            if d < 0 {
                return exchange_failed("http: chunk size is not a hexadecimal number")
            }
            value = value * 16 + d.to_usize()
            digits = digits + 1
            i = i + 1
        }
    }
    if digits == 0 {
        return exchange_failed("http: chunk size has no digits")
    }
    return result.Result.Ok(value = value)
}

/// Panics: if there are no digits, or a digit is not hexadecimal.
fun parse_hex(text: &str).R: usize {
    val v = when parse_hex_try(text) {
        Ok(n) -> n
        Err(e) -> fail_http(e)
    }
    return v
}

/// Decodes a chunked body: a hex size line, that many bytes, a `CRLF`, repeated
/// until a zero size, then trailers until a blank line. This is what keep-alive
/// makes mandatory: with a persistent connection there is no other way to find
/// where a chunked body stops, and reading to end of file would block until the
/// server closed a connection it intends to keep.
fun mut Cursor.try_read_chunked().R: result.Result<Bytes, HttpErr> {
    var out = Bytes.empty()
    var going = true
    while going {
        val size_text = self.try_read_line()?
        val size = parse_hex_try(size_text.as_str())?
        if size == 0 {
            going = false
        } else {
            val piece = self.try_read_exact(size)?
            out.append(piece)
            val skipped = self.try_skip_line()?
        }
    }
    var trailing = true
    while trailing {
        val line = self.try_read_line()?
        if str.is_empty(line.as_str()) {
            trailing = false
        }
    }
    return result.Result.Ok(value = out)
}

/// Panics: on a malformed chunk or a peer that closes early.
fun mut Cursor.read_chunked().R: Bytes {
    val body = when self.try_read_chunked() {
        Ok(b) -> b
        Err(e) -> fail_http(e)
    }
    return body
}

// ----- response reading -----

/// The offset just past the blank line that ends the header block, or 0 when it
/// has not arrived yet. 0 is a usable sentinel because a header block can never
/// end at offset 0 — the terminator alone is four bytes.
///
/// This scans **bytes**, and that is not an optimization. `Bytes.as_str()`
/// validates utf-8, and the buffer holds whatever arrived alongside the
/// headers — so the first response with a binary body would panic right here,
/// before the headers had even been located. Every synthetic test had an
/// all-ASCII body, which is why it took `examples/download.kp` (a 200 KB image)
/// to find this.
fun find_head_end(b: Bytes).R: usize {
    val n = b.len()
    var i: usize = 0
    while i + 4 <= n {
        if b.get(i) == 13 && b.get(i + 1) == 10 && b.get(i + 2) == 13 && b.get(i + 3) == 10 {
            return i + 4
        }
        i = i + 1
    }
    return 0
}

/// The header block as text: the bytes before the terminator, copied and
/// validated in one step, since `String.from_bytes` *adopts* the buffer instead
/// of copying it. A header block that is not valid utf-8 is a malformed
/// response, and this is where that becomes loud rather than producing a
/// `String` that lies about its own invariant.
fun head_text(b: Bytes, end: usize).R: String {
    val n = end - 4
    var raw = mem.alloc(n)
    var i: usize = 0
    while i < n {
        raw.set(i, b.get(i))
        i = i + 1
    }
    return String.from_bytes(raw)
}

/// The status line: `HTTP/1.1 200 OK`. Only the code matters here; the reason
/// phrase may be absent or anything at all. A line with no code, or a code that
/// is not a number, is an `Exchange` failure: the response is malformed.
fun parse_status_line_try(line: &str).R: result.Result<i32, HttpErr> {
    val sp = str.index_of(line, " ")
    if let Some(first) = sp {
        val rest = str.substring(line, first + 1)
        val sp2 = str.index_of(rest, " ")
        if let Some(at) = sp2 {
            val code_text = str.prefix(rest, at)
            return status_code_try(code_text.as_str())
        }
        return status_code_try(rest)
    }
    return exchange_failed("http: malformed status line (no status code)")
}

/// Panics: if the line has no code, or the code is not a number.
fun parse_status_line(line: &str).R: i32 {
    val code = when parse_status_line_try(line) {
        Ok(c) -> c
        Err(e) -> fail_http(e)
    }
    return code
}

/// The status code of a status line, or the error.
fun status_code_try(text: &str).R: result.Result<i32, HttpErr> {
    val parsed = str.parse_u64(text)
    if let Ok(p) = parsed {
        if p > 999 {
            return exchange_failed("http: the status code is out of range")
        }
        return result.Result.Ok(value = p.to_i32())
    }
    return exchange_failed("http: the status code is not a number")
}

/// The status code of a status line.
fun status_code(text: &str).R: i32 {
    val code = when status_code_try(text) {
        Ok(c) -> c
        Err(e) -> fail_http(e)
    }
    return code
}

/// Every header line after the status line, name and value split at the first
/// `:`, both trimmed. A line with no `:` is skipped rather than treated as an
/// error: HTTP allows a recipient to ignore what it does not understand.
fun parse_headers(lines: List<String>).R: List<Header> {
    var hs: List<Header> = List.empty()
    var i: usize = 1
    while i < lines.len() {
        val text = lines.get(i).as_str()
        if !str.is_empty(text) {
            val colon = str.index_of(text, ":")
            if let Some(at) = colon {
                val name = str.prefix(text, at)
                val value = str.trim(str.substring(text, at + 1))
                hs.push(Header(name = name, value = value))
            }
        }
        i = i + 1
    }
    return hs
}

/// The value of header `name`, or an empty string.
fun header_value(hs: List<Header>, name: &str).R: String {
    var i: usize = 0
    while i < hs.len() {
        if name_eq(hs.get(i).name.as_str(), name) {
            return String.from_str(hs.get(i).value.as_str())
        }
        i = i + 1
    }
    return String.empty()
}

/// A header's value as `u64`, or `None`. Absent and malformed are the same
/// answer here: there is nothing to distinguish "the server didn't send this"
/// from "the server sent something that isn't a number", and a caller only
/// cares that it has no number to use either way (used for `Retry-After` and
/// the integer `X-RateLimit-*` fields, MISSING-p5Xtr).
fun header_u64(hs: List<Header>, name: &str).R: option.Option<u64> {
    val text = header_value(hs, name)
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    val parsed = str.parse_u64(text.as_str())
    return when parsed {
        Ok(v) -> option.Option.Some(value = v)
        Err(_) -> option.Option.None
    }
}

/// As `header_u64`, but `f64` — for `X-RateLimit-Reset` and
/// `X-RateLimit-Reset-After`, which carry fractional seconds on the API this
/// module was designed against.
fun header_f64(hs: List<Header>, name: &str).R: option.Option<f64> {
    val text = header_value(hs, name)
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    val parsed = str.parse_f64(text.as_str())
    return when parsed {
        Ok(v) -> option.Option.Some(value = v)
        Err(_) -> option.Option.None
    }
}

/// A header's value as an owned `String`, or `None` for an absent header —
/// unlike `Response.header`, which answers "" either way, this is for a caller
/// that needs to tell "absent" apart from "present and empty" (used for
/// `X-RateLimit-Bucket`, an opaque string with no numeric fallback).
fun header_opt(hs: List<Header>, name: &str).R: option.Option<String> {
    val text = header_value(hs, name)
    if str.is_empty(text.as_str()) {
        return option.Option.None
    }
    return option.Option.Some(value = text)
}

/// `-1` for absent, which is not a legal `Content-Length` — an absent header is
/// not a parse failure, and the value is a count whose every non-negative value
/// is meaningful, so there is nothing for an `Option` to add here. A header that
/// is present and not a number is an `Exchange` failure.
fun content_length_try(hs: List<Header>).R: result.Result<i64, HttpErr> {
    val text = header_value(hs, "content-length")
    if str.is_empty(text.as_str()) {
        return result.Result.Ok(value = -1)
    }
    val parsed = str.parse_u64(text.as_str())
    if let Ok(p) = parsed {
        return result.Result.Ok(value = p.to_i64())
    }
    return exchange_failed("http: Content-Length is not a number")
}

/// Panics: if the header is present and not a number.
fun content_length_of(hs: List<Header>).R: i64 {
    val n = when content_length_try(hs) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return n
}

/// Whether the headers announce a chunked body.
fun is_chunked(hs: List<Header>).R: bool {
    val raw = header_value(hs, "transfer-encoding")
    val text = str.to_lower(raw.as_str())
    return str.contains(text.as_str(), "chunked")
}

/// Whether the headers ask to close the connection.
fun wants_close(hs: List<Header>).R: bool {
    val raw = header_value(hs, "connection")
    val text = str.to_lower(raw.as_str())
    return str.contains(text.as_str(), "close")
}

/// One whole response off one socket: header block, framing decision, body.
///
/// Everything is a local because there is no destructuring: a helper that
/// returned `(status, headers, cursor)` would have to be taken apart to be
/// used, and no syntax does that. So the framing lives in `Cursor`'s methods
/// and the parsing lives in the helpers above, while the assembly of the
/// `Response` happens here, where every piece is still a plain binding.
///
/// Fallible core: every failure is an `HttpErr.Exchange`.
fun read_response_try(c: Conn).R: result.Result<Response, HttpErr> {
    var buf = Bytes.empty()
    var end: usize = 0
    var eof = false
    while end == 0 && !eof {
        val chunk = conn_recv_try(c, 4096)?
        if chunk.is_empty() {
            eof = true
        } else {
            buf.append(chunk)
            end = find_head_end(buf)
        }
    }
    if end == 0 {
        return exchange_failed("http: the connection closed before the response headers arrived")
    }
    var status: i32 = 0
    var hs: List<Header> = List.empty()
    {
        val head_only = head_text(buf, end)
        val lines = str.split(head_only.as_str(), "\r\n")
        status = parse_status_line_try(lines.get(0).as_str())?
        hs = parse_headers(lines)
    }
    val chunked = is_chunked(hs)
    val len = content_length_try(hs)?
    val close = wants_close(hs)
    var cursor = Cursor(fd = c.fd, tls_handle = c.tls_handle, buf = buf, start = end)
    var body = Bytes.empty()
    if chunked {
        body = cursor.try_read_chunked()?
    } else {
        if len >= 0 {
            body = cursor.try_read_exact(len.to_usize())?
        } else {
            body = cursor.try_read_to_end()?
        }
    }
    // Reusable means: the body was completely framed (so the next byte on the
    // wire is the start of the next response) and the server did not ask to
    // close. Anything else and the connection is spent.
    val reusable = !close && (chunked || len >= 0)
    return result.Result.Ok(value = Response(status = status, headers = hs, body = body, reusable = reusable))
}

/// Panics: on a peer that closes early, a malformed status line, a
/// non-numeric `Content-Length`, a malformed chunk, or a read failure.
fun read_response(c: Conn).R: Response {
    val r = when read_response_try(c) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

// ----- one exchange, and redirects -----

/// A full round trip on one socket: send the head and body, read the response.
/// The socket's timeout is set by whoever opened it, not here, because a pooled
/// connection is configured once on connect rather than on every request.
///
/// Fallible core: a failed send or response read is an `HttpErr.Exchange`.
fun one_exchange_try(c: Conn, method: &str, u: Url, headers: List<Header>, body: Bytes).R: result.Result<Response, HttpErr> {
    val head = build_head(method, u, headers, body.len())
    conn_send_all_try(c, head.into_bytes())?
    // Unconditional: `send_all` of an empty buffer writes nothing, and this
    // avoids an `if` without an `else` whose body is a `usize` expression.
    conn_send_all_try(c, body)?
    return read_response_try(c)
}

/// Panics: if the send or the response read fails.
fun one_exchange(c: Conn, method: &str, u: Url, headers: List<Header>, body: Bytes).R: Response {
    val r = when one_exchange_try(c, method, u, headers, body) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

/// 301/302/303 become `GET` with no body (the historical behavior every browser
/// implements); 307/308 preserve the method and body, which is exactly why they
/// were standardized.
fun keep_body_on(status: i32).R: bool = status == 307 || status == 308

/// Whether `status` is a redirect.
fun is_redirect(status: i32).R: bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

/// A `Location` that is not absolute is resolved against the URL that produced
/// the redirect. Only the scheme, host and port are inherited; the pool key
/// and the capability check both use the resulting URL's own host, so a
/// redirect to another name is a *different* connection needing its own
/// grant. Inheriting `base.scheme` (not always `http`) is what keeps a
/// relative redirect on an `https` connection from silently downgrading to
/// plain `http` — an *absolute* `Location`, returned unchanged just above,
/// is the only way a redirect actually crosses schemes.
fun absolute_url(base: Url, loc: &str).R: String {
    if str.starts_with(loc, "http://") || str.starts_with(loc, "https://") {
        return String.from_str(loc)
    }
    var out = String.with_capacity(64)
    out.push_str(base.scheme.as_str())
    out.push_str("://")
    out.push_str(base.host.as_str())
    out.push_str(":")
    val port_text = fmt.uint(base.port.to_u64())
    out.push_str(port_text.as_str())
    if str.starts_with(loc, "/") {
        out.push_str(loc)
    } else {
        out.push_str("/")
        out.push_str(loc)
    }
    return out
}

/// Whether to follow this response, and where to. Panics: if the redirect chain
/// is longer than the client allows — a loop is a malformed server, and v1 has
/// no `Result` to report it with.
/// Where a redirect chain goes next, or an empty string for "do not follow".
///
/// The next URL is *returned by a call* (`absolute_url`) rather than carried in
/// a `datac`, so the join rule lives in one place and every caller gets a
/// freshly built value.
///
/// Panics: if the chain is longer than the client allows.
fun follow_url(client: Client, base: Url, resp: Response, hops: i32).R: String {
    val next = when follow_url_try(client, base, resp, hops) {
        Ok(u) -> u
        Err(e) -> fail_http(e)
    }
    return next
}

/// The fallible core of `follow_url`: a chain longer than the client allows is
/// `HttpErr.Redirects`.
fun follow_url_try(client: Client, base: Url, resp: Response, hops: i32).R: result.Result<String, HttpErr> {
    if !client.follow_redirects {
        return result.Result.Ok(value = String.empty())
    }
    if !is_redirect(resp.status) {
        return result.Result.Ok(value = String.empty())
    }
    val loc = resp.header("location")
    if str.is_empty(loc.as_str()) {
        return result.Result.Ok(value = String.empty())
    }
    if hops <= 0 {
        return result.Result.Err(error = HttpErr.Redirects(reason = String.from_str("http: too many redirects")))
    }
    return result.Result.Ok(value = absolute_url(base, loc.as_str()))
}

/// A client with the default timeout and redirect limit.
fun default_client().R: Client = Client(
    timeout_ms = DEFAULT_TIMEOUT_MS,
    max_redirects = DEFAULT_MAX_REDIRECTS,
    follow_redirects = true,
)

/// One request on a fresh connection, following redirects. Every hop connects
/// again, which is the correct behavior for a redirect that changes host and
/// the only option without a pool to consult.
///
/// Panics: if the connection fails, the capability denies the host, the
/// response is malformed, or the redirect chain is too long. `try_send` is the
/// same call with every one of those but the capability denial as a value.
fun Client.send(req: Request).R: Response {
    val r = when self.try_send(req) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

/// `send`, with the failures as an `HttpErr` (MISSING-p7Kdm): `Dial` when nothing
/// was sent, `Exchange` when the request may have reached the server, `Redirects`
/// for a chain that is too long.
///
/// Panics: if the capability denies the host, or the URL is malformed. Both are
/// mistakes in the program rather than conditions of the network, and the
/// capability check has no value-returning form.
fun Client.try_send(req: Request).R: result.Result<Response, HttpErr> = send_fresh_try(
    self,
    req.method.clone(),
    req.url.clone(),
    req.headers,
    req.body.clone(),
    self.max_redirects,
)

/// Sends a request over a new connection.
fun send_fresh(
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: Response {
    val r = when send_fresh_try(client, method, url_text, headers, body, hops) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

/// Sends a request over a new connection, returning the error instead of panicking.
fun send_fresh_try(
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: result.Result<Response, HttpErr> {
    val u = parse_url(url_text.as_str())
    val s = connect_configured_try(u.host.as_str(), u.port, client.timeout_ms, url_is_https(u))?
    val got = one_exchange_try(s, method.as_str(), u, headers, body)
    conn_close(s)
    val resp = got?
    // The redirect decision is one helper; the *tail* is written here because
    // `resp` is an owned local here and a returned borrow cannot leave. With no
    // function values in v1, that tail is written at each call site.
    val next = follow_url_try(client, u, resp, hops)?
    if str.is_empty(next.as_str()) {
        return result.Result.Ok(value = resp)
    }
    if keep_body_on(resp.status) {
        return send_fresh_try(client, method, next, headers, body, hops - 1)
    }
    return send_fresh_try(client, String.from_str("GET"), next, headers, Bytes.empty(), hops - 1)
}

/// A single exchange on a connection the caller already holds: parse the URL,
/// send, read. This is the concurrency-ready primitive — no pool and no client
/// are named while it runs — and `Client.send`/`Pool.send` are the redirect
/// loops built on top of it.
///
/// Panics: as `one_exchange`, plus a malformed URL.
fun exchange(c: Conn, req: Request).R: Response {
    val u = parse_url(req.url.as_str())
    return one_exchange(c, req.method.as_str(), u, req.headers, req.body)
}

/// `exchange`, with a failed send or response read as an `HttpErr.Exchange`.
///
/// Panics: on a malformed URL.
fun exchange_try(c: Conn, req: Request).R: result.Result<Response, HttpErr> {
    val u = parse_url(req.url.as_str())
    return one_exchange_try(c, req.method.as_str(), u, req.headers, req.body)
}

// ----- the pool -----

/// The pool for one `host:port`. The ceiling and the timeout come from the
/// program's configuration (`http_pool`) and the default client; nothing is
/// connected here, so creating a pool costs nothing.
fun pool(host: &str, port: u16).R: Pool = Pool(
    host = String.from_str(host),
    port = port,
    size = pool_size,
    timeout_ms = DEFAULT_TIMEOUT_MS,
    idle = empty_idle(),
    idle_since = empty_stamps(),
    idle_ms = 0,
)

/// An empty idle-connection list.
fun empty_idle().R: List<Conn> {
    var l: List<Conn> = List.empty()
    return l
}

/// An empty list of idle timestamps.
fun empty_stamps().R: List<i64> {
    var l: List<i64> = List.empty()
    return l
}

/// How many idle connections the pool keeps.
fun Pool.size().R: usize = size

/// How many connections the pool is keeping right now.
fun Pool.len().R: usize = idle.len()

/// The connection a lease holds.
fun Lease.conn().R: Conn = Conn(fd = fd, tls_handle = tls_handle)

/// Opens up to `size` connections now, so the first request does not pay for
/// them. Optional by design: eager connecting is what makes a pool hurt startup,
/// so it is a call a program makes rather than the default. `use_tls` has to be
/// given here because a `Pool` is not itself keyed on a scheme — only on
/// `host:port` — so warming has no request to read it from the way `checkout`
/// does; the caller says how it means to use the pool.
///
/// The pool's fields are copied into locals first and the idle count is read
/// inside a block. That is not decoration: a shared borrow created in a *binding
/// initializer* stays live to the end of the block (the lexical lifetimes open
/// item 30 records), and `idle.push` needs the pool exclusively a line later.
///
/// Panics: if a connection fails.
fun mut Pool.warm(use_tls: bool) {
    val h = host.clone()
    val p = port
    val t = timeout_ms
    val cap = size
    var i: usize = 0
    {
        i = idle.len()
    }
    while i < cap {
        val c = connect_configured(h.as_str(), p, t, use_tls)
        idle.push(c)
        idle_since.push(net.mono_ms())
        i = i + 1
    }
}

/// Hands out a connection: an idle one if there is one, a fresh one if there is
/// not. The pool never refuses — the ceiling governs how many connections are
/// *kept*, not how many may be in flight — so a caller holding two leases simply
/// gets two connections, and only one of them is kept on release. An idle
/// connection is reused only when its scheme is the one asked for: a kept
/// connection of the other scheme (one `host:port` answering both `http` and
/// `https`) is closed and replaced by a fresh one, so an `https` request is
/// never sent over a plain connection and the reverse.
///
/// Panics: if connecting fails.
fun mut Pool.checkout(use_tls: bool).R: Lease {
    val l = when self.try_checkout(use_tls) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return l
}

/// `checkout`, with a failed dial as `HttpErr.Dial`.
///
/// Panics: if the capability denies the host.
fun mut Pool.try_checkout(use_tls: bool).R: result.Result<Lease, HttpErr> {
    while !idle.is_empty() {
        val c = idle.pop()
        val since = idle_since.pop()
        // Past the idle timeout the peer has probably closed it, and reusing it
        // would cost one failed request: close it and look at the next.
        val stale = idle_ms > 0 && (net.mono_ms() - since) >= idle_ms.to_i64()
        if !stale && c.is_tls() == use_tls {
            return result.Result.Ok(value = Lease(fd = c.fd, tls_handle = c.tls_handle, reused = true))
        }
        conn_close(c)
    }
    val h = host.clone()
    val p = port
    val t = timeout_ms
    val c = connect_configured_try(h.as_str(), p, t, use_tls)?
    return result.Result.Ok(value = Lease(fd = c.fd, tls_handle = c.tls_handle, reused = false))
}

/// Gives a connection back. `release` consumes the lease, so this cannot happen
/// twice. A connection that is not reusable — an unframed body, or a server that
/// said `Connection: close` — is closed instead of kept, and so is one beyond
/// the ceiling: the pool keeps at most `size`.
///
/// Panics: if closing a connection fails.
fun mut Pool.release(lease: Lease, reusable: bool) {
    if reusable && idle.len() < size {
        idle.push(lease.conn())
        idle_since.push(net.mono_ms())
    } else {
        conn_close(lease.conn())
    }
}

/// Panics: if closing a connection fails.
fun mut Pool.close_all() {
    var going = true
    while going {
        if idle.is_empty() {
            going = false
        } else {
            val c = idle.pop()
            val since = idle_since.pop()
            conn_close(c)
        }
    }
}

/// From now on `checkout` closes a kept connection that has been idle for
/// `ms` or longer instead of reusing it (0 turns it off again). Pick a value
/// below the server's own keep-alive timeout, so a connection the peer has
/// already closed is never the one chosen.
fun mut Pool.set_idle_timeout(ms: u64) {
    idle_ms = ms
}

/// Closes every kept connection that has been idle for `after_ms` or longer and
/// returns how many it closed. Call it from a program's own timer to cap the
/// descriptors a long-lived pool holds (a program that talks to many hosts
/// keeps `size` per host); `close_idle(0)` closes them all. The clock is
/// `net.mono_ms`, which `std/http` already reads for its own timeouts, so the
/// module needs no `time` grant.
///
/// Panics: if closing a connection fails.
fun mut Pool.close_idle(after_ms: u64).R: usize {
    val now = net.mono_ms()
    var kept_conns: List<Conn> = List.empty()
    var kept_since: List<i64> = List.empty()
    var closed: usize = 0
    // Popping is newest first, so the survivors are pushed back in reverse.
    while !idle.is_empty() {
        val c = idle.pop()
        val since = idle_since.pop()
        if (now - since) >= after_ms.to_i64() {
            conn_close(c)
            closed = closed + 1
        } else {
            kept_conns.push(c)
            kept_since.push(since)
        }
    }
    while !kept_conns.is_empty() {
        idle.push(kept_conns.pop())
        idle_since.push(kept_since.pop())
    }
    return closed
}

/// Whether a pool serves the host and port of `u`.
fun pool_matches(p: Pool, u: Url).R: bool {
    if p.size == 0 {
        return false
    }
    return str.eq(p.host.as_str(), u.host.as_str()) && p.port == u.port
}

/// Sends a request, reusing an idle connection when one is free.
fun mut Pool.send(req: Request).R: Response {
    val r = when self.try_send(req) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

/// `send`, with the failures as an `HttpErr` (MISSING-p7Kdm), as `Client.try_send`
/// reports them. A connection that failed mid-exchange is closed and not put
/// back, so a pool never hands out a connection a failure left half read. An
/// `Exchange` failure on a *reused* connection is the classic stale keep-alive
/// (the server closed an idle connection before this request reached it), which
/// is why a caller that retries an idempotent request once on `Exchange` is
/// doing the ordinary thing.
///
/// Panics: as `Client.try_send`.
fun mut Pool.try_send(req: Request).R: result.Result<Response, HttpErr> {
    val c = default_client()
    return pooled_hop_try(
        self,
        c,
        req.method.clone(),
        req.url.clone(),
        req.headers,
        req.body.clone(),
        c.max_redirects,
    )
}

/// Sends one hop of a request through the pool.
fun pooled_hop(
    p: mut Pool,
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: Response {
    val r = when pooled_hop_try(p, client, method, url_text, headers, body, hops) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

/// Sends one hop through the pool, returning the error.
fun pooled_hop_try(
    p: mut Pool,
    client: Client,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: result.Result<Response, HttpErr> {
    val u = parse_url(url_text.as_str())
    if pool_matches(p, u) {
        val lease = p.try_checkout(url_is_https(u))?
        val c = lease.conn()
        val got = one_exchange_try(c, method.as_str(), u, headers, body)
        if result.is_err(got) {
            p.release(lease, false)
            return got
        }
        val resp = got?
        p.release(lease, resp.reusable)
        val next = follow_url_try(client, u, resp, hops)?
        if str.is_empty(next.as_str()) {
            return result.Result.Ok(value = resp)
        }
        if keep_body_on(resp.status) {
            return pooled_hop_try(p, client, method, next, headers, body, hops - 1)
        }
        return pooled_hop_try(
            p,
            client,
            String.from_str("GET"),
            next,
            headers,
            Bytes.empty(),
            hops - 1,
        )
    }
    val s = connect_configured_try(u.host.as_str(), u.port, client.timeout_ms, url_is_https(u))?
    val got = one_exchange_try(s, method.as_str(), u, headers, body)
    conn_close(s)
    val resp = got?
    val next = follow_url_try(client, u, resp, hops)?
    if str.is_empty(next.as_str()) {
        return result.Result.Ok(value = resp)
    }
    if keep_body_on(resp.status) {
        return pooled_hop_try(p, client, method, next, headers, body, hops - 1)
    }
    return pooled_hop_try(
        p,
        client,
        String.from_str("GET"),
        next,
        headers,
        Bytes.empty(),
        hops - 1,
    )
}

// ----- https with a private CA, a client certificate or ALPN -----

/// The plain client's dial, with `tls.TlsClientOptions` for the handshake: a
/// private CA file, a client certificate (mTLS), ALPN. Verification stays
/// mandatory, as in `connect_configured_try`. A failed handshake is
/// `HttpErr.Dial`. Panics: if the capability denies the host.
fun connect_tls_try(host: &str, port: u16, timeout_ms: u64, opts: &tls.TlsClientOptions).R: result.Result<Conn, HttpErr> {
    val dialed = net.try_connect(host, port)
    return when dialed {
        Ok(sock) -> finish_dial_opts(sock, host, timeout_ms, opts)
        Err(e) -> result.Result.Err(error = HttpErr.Dial(reason = e.reason))
    }
}

/// Finishes a dialed socket into a connection using the given TLS options.
fun finish_dial_opts(sock: net.Socket, host: &str, timeout_ms: u64, opts: &tls.TlsClientOptions).R: result.Result<Conn, HttpErr> {
    var s = net.Socket(fd = sock.fd)
    if timeout_ms > 0 {
        s.set_timeout(timeout_ms)
    }
    return when tls.try_handshake_opts(s, host, opts) {
        Ok(t) -> result.Result.Ok(value = Conn(fd = t.fd, tls_handle = option.Option.Some(value = t.handle)))
        Err(e) -> {
            net.close(s)
            result.Result.Err(error = HttpErr.Dial(reason = tls.error_text(e)))
        }
    }
}

/// `Client.try_send` for a URL that may be `https`, with the TLS options above
/// applied to every `https` hop (a plain `http` hop ignores them). Every hop is
/// a fresh connection, as in `Client.try_send`.
fun Client.try_send_tls(req: Request, opts: &tls.TlsClientOptions).R: result.Result<Response, HttpErr> = send_tls_try(
    self,
    opts,
    req.method.clone(),
    req.url.clone(),
    req.headers,
    req.body.clone(),
    self.max_redirects,
)

/// Opens a connection for `u`.
fun dial_for(u: Url, timeout_ms: u64, opts: &tls.TlsClientOptions).R: result.Result<Conn, HttpErr> {
    if url_is_https(u) {
        return connect_tls_try(u.host.as_str(), u.port, timeout_ms, opts)
    }
    return connect_configured_try(u.host.as_str(), u.port, timeout_ms, false)
}

/// Sends a request over TLS, returning the error.
fun send_tls_try(
    client: Client,
    opts: &tls.TlsClientOptions,
    method: String,
    url_text: String,
    headers: List<Header>,
    body: Bytes,
    hops: i32,
).R: result.Result<Response, HttpErr> {
    val u = parse_url(url_text.as_str())
    val s = dial_for(u, client.timeout_ms, opts)?
    val got = one_exchange_try(s, method.as_str(), u, headers, body)
    conn_close(s)
    val resp = got?
    val next = follow_url_try(client, u, resp, hops)?
    if str.is_empty(next.as_str()) {
        return result.Result.Ok(value = resp)
    }
    if keep_body_on(resp.status) {
        return send_tls_try(client, opts, method, next, headers, body, hops - 1)
    }
    return send_tls_try(client, opts, String.from_str("GET"), next, headers, Bytes.empty(), hops - 1)
}

/// A `GET` with the TLS options: `try_get` for a private CA and mTLS.
fun try_get_tls(url: &str, opts: &tls.TlsClientOptions).R: result.Result<Response, HttpErr> {
    val c = default_client()
    return c.try_send_tls(make_get(url), opts)
}

/// Panics: as `get`, and if the TLS handshake fails.
fun get_tls(url: &str, opts: &tls.TlsClientOptions).R: Response {
    val r = when try_get_tls(url, opts) {
        Ok(v) -> v
        Err(e) -> fail_http(e)
    }
    return r
}

// ----- the one-liners -----

/// A `GET` on a fresh connection, no pool. Pooling is opt-in through an
/// explicit `Pool` because a process-wide default pool would be shared mutable
/// state, and threads (T1) would then need a lock around every request — see
/// the plan's open item 61.
///
/// Panics: if the connection fails, the capability denies the host, or the
/// response is malformed.
fun get(url: &str).R: Response {
    val c = default_client()
    return c.send(make_get(url))
}

/// `get`, with the failures as an `HttpErr` (`Client.try_send`).
fun try_get(url: &str).R: result.Result<Response, HttpErr> {
    val c = default_client()
    return c.try_send(make_get(url))
}

/// A GET request for `url`.
fun make_get(url: &str).R: Request = Request(
    method = String.from_str("GET"),
    url = String.from_str(url),
    headers = empty_headers(),
    body = Bytes.empty(),
)

/// Panics: as `get`.
fun post_text(url: &str, body: &str, content_type: &str).R: Response {
    var hs: List<Header> = List.empty()
    hs.push(Header(name = String.from_str("Content-Type"), value = String.from_str(content_type)))
    val req = Request(
        method = String.from_str("POST"),
        url = String.from_str(url),
        headers = hs,
        body = Bytes.from_str(body),
    )
    val c = default_client()
    return c.send(req)
}

// ===== multipart/form-data bodies (MISSING-j2Wka) =====
//
// A `Multipart` is a body under construction: `multipart(boundary)` starts one,
// `add_field`/`add_file` append a part each, and `finish` closes it and hands
// back the bytes. `content_type` is the header line value that must travel
// with that body. The boundary is the caller's, because this module has no
// randomness and a test wants a stable body; it must not occur inside any
// part, which `add_file` cannot check cheaply for arbitrary bytes, so pick a
// long one (RFC 2046: 1 to 70 characters from a small set).

/// A multipart/form-data body being built.
datac Multipart(val boundary: String, var out: Bytes, var parts: usize)

/// A boundary byte RFC 2046 allows: letters, digits and `'()+_,-./:=?`.
fun boundary_ok(c: u8).R: bool {
    if str.is_digit(c) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
        return true
    }
    return c == 39 || c == 40 || c == 41 || c == 43 || c == 95 || c == 44 || c == 45 || c == 46 || c == 47 || c == 58 || c == 61 || c == 63
}

/// A new multipart body. Panics: if `boundary` is empty, longer than 70 bytes
/// or holds a byte RFC 2046 does not allow in one.
fun multipart(boundary: &str).R: Multipart {
    val n = str.len(boundary)
    if n == 0 || n > 70 {
        panic("http.multipart: the boundary must be 1 to 70 bytes")
    }
    var i: usize = 0
    while i < n {
        if !boundary_ok(str.byte(boundary, i)) {
            panic("http.multipart: the boundary holds a byte that is not allowed")
        }
        i = i + 1
    }
    return Multipart(boundary = String.from_str(boundary), out = Bytes.empty(), parts = 0)
}

/// A header parameter value in quotes: `"` becomes `%22`, CR `%0D` and LF `%0A`,
/// which is what browsers send, so a name cannot end the parameter or the line.
fun multipart_quote(s: &str).R: String {
    val a = str.replace(s, "%", "%25")
    val b = str.replace(a.as_str(), "\"", "%22")
    val c = str.replace(b.as_str(), "\r", "%0D")
    return str.replace(c.as_str(), "\n", "%0A")
}

/// The opening of a part: the delimiter line and the `Content-Disposition`.
fun mut Multipart.begin_part(name: &str, filename: option.Option<String>) {
    var head = String.from_str("--")
    head.push_str(boundary.as_str())
    head.push_str("\r\nContent-Disposition: form-data; name=\"")
    val qn = multipart_quote(name)
    head.push_str(qn.as_str())
    head.push_str("\"")
    if let Some(f) = filename {
        head.push_str("; filename=\"")
        val qf = multipart_quote(f.as_str())
        head.push_str(qf.as_str())
        head.push_str("\"")
    }
    head.push_str("\r\n")
    out.append(Bytes.from_str(head.as_str()))
    parts = parts + 1
}

/// A text field.
fun mut Multipart.add_field(name: &str, value: &str) {
    self.begin_part(name, option.Option.None)
    out.append(Bytes.from_str("\r\n"))
    out.append(Bytes.from_str(value))
    out.append(Bytes.from_str("\r\n"))
}

/// A file part with its own `Content-Type`.
fun mut Multipart.add_file(name: &str, filename: &str, content_type: &str, data: Bytes) {
    self.begin_part(name, option.Option.Some(value = String.from_str(filename)))
    var ct = String.from_str("Content-Type: ")
    ct.push_str(content_type)
    ct.push_str("\r\n\r\n")
    out.append(Bytes.from_str(ct.as_str()))
    out.append(data)
    out.append(Bytes.from_str("\r\n"))
}

/// The `Content-Type` header value for this body.
fun Multipart.content_type().R: String {
    var ct = String.from_str("multipart/form-data; boundary=")
    ct.push_str(boundary.as_str())
    return ct
}

/// The finished body: every part, then the closing delimiter. Call it once,
/// after the last part.
fun mut Multipart.finish().R: Bytes {
    var tail = String.from_str("--")
    tail.push_str(boundary.as_str())
    tail.push_str("--\r\n")
    out.append(Bytes.from_str(tail.as_str()))
    return out.clone()
}

/// A POST of a finished multipart body to `url`, with the matching
/// `Content-Type`.
fun multipart_request(url: &str, form: mut Multipart).R: Request {
    var hs: List<Header> = List.empty()
    hs.push(Header(name = String.from_str("Content-Type"), value = form.content_type()))
    return Request(
        method = String.from_str("POST"),
        url = String.from_str(url),
        headers = hs,
        body = form.finish(),
    )
}

// ===== the server (st2) =====
//
// An HTTP/1.1 server over `std/net`, in this module because it shares the
// client's `Header` and header helpers. It is held on `net` exactly as the
// client is: `listen` is checked against the *port* of the importer's grant
// (`net = ["*:8080"]`), `accept` and the connection calls are not checked at
// all, and the module carries no policy of its own. `plan/http-server.md` is
// the design note: the limits, the status for each violation, what is not here.
//
// Nothing closes on drop (the rule `std/net` states): `ServerConn.close` and
// `Server.close` are the explicit ends, and `serve*` call them for you.

// ----- limits -----

/// What one server will accept from one client. Every field is a ceiling and
/// every violation is answered with its own status and a closed connection
/// (`plan/http-server.md`). The timeouts are *deadlines*, not per-read waits: a
/// client that trickles its request one byte at a time is cut off when the head
/// deadline passes, which a per-`recv` timeout would never do.
datac Limits(
    /// The longest request line accepted.
    val max_request_line: usize,
    /// The most header bytes accepted.
    val max_header_bytes: usize,
    /// The most headers accepted.
    val max_headers: usize,
    /// The largest body accepted.
    val max_body: usize,
    /// How long to wait for a request head, in milliseconds.
    val head_timeout_ms: u64,
    /// How long to wait for a body, in milliseconds.
    val body_timeout_ms: u64,
    /// How long a kept-alive connection may idle, in milliseconds.
    val idle_timeout_ms: u64,
    /// The most requests served on one connection.
    val max_requests_per_conn: usize,
)

/// 8 KiB request line, 16 KiB of headers, 100 headers, 1 MiB body, 10 s for the
/// head, 30 s for the body, 5 s idle between requests, 100 requests per
/// connection.
fun default_limits().R: Limits = Limits(
    max_request_line = 8192,
    max_header_bytes = 16384,
    max_headers = 100,
    max_body = 1048576,
    head_timeout_ms = 10000,
    body_timeout_ms = 30000,
    idle_timeout_ms = 5000,
    max_requests_per_conn = 100,
)

/// A copy with other timeouts: `Limits` is a `datac`, so a worker that needs its
/// own value rebuilds one.
fun Limits.with_timeouts(head_ms: u64, body_ms: u64, idle_ms: u64).R: Limits = Limits(
    max_request_line = max_request_line,
    max_header_bytes = max_header_bytes,
    max_headers = max_headers,
    max_body = max_body,
    head_timeout_ms = head_ms,
    body_timeout_ms = body_ms,
    idle_timeout_ms = idle_ms,
    max_requests_per_conn = max_requests_per_conn,
)

/// A copy of the limits.
fun Limits.dup().R: Limits = self.with_timeouts(head_timeout_ms, body_timeout_ms, idle_timeout_ms)

// ----- requests and responses -----

/// One parsed request. `path` and `query` are the two halves of `target` around
/// the first `?`, both still percent-encoded; `query_param` and `path_segments`
/// decode. A header name keeps the case the client wrote; lookups ignore case.
datac ServerRequest(
    /// The request method.
    val method: String,
    /// The raw request target.
    val target: String,
    /// The decoded path.
    val path: String,
    /// The query string.
    val query: String,
    /// The request headers.
    val headers: List<Header>,
    /// The request body.
    val body: Bytes,
)

/// What a handler returns. `Content-Length` and `Connection` are the server's:
/// a header of either name set here is dropped when the response is written.
datac ServerResponse(val status: i32, val headers: List<Header>, val body: Bytes)

/// Whether the list has a header called `name`.
fun headers_have(hs: List<Header>, name: &str).R: bool {
    var i: usize = 0
    while i < hs.len() {
        if name_eq(hs.get(i).name.as_str(), name) {
            return true
        }
        i = i + 1
    }
    return false
}

/// The value of header `name`, or an empty string.
fun ServerRequest.header(name: &str).R: String = header_value(headers, name)

/// Whether the request has a header called `name`.
fun ServerRequest.has_header(name: &str).R: bool = headers_have(headers, name)

/// The body as owned text. Panics: if the bytes are not valid utf-8.
fun ServerRequest.text().R: String = String.from_bytes(body.clone())

/// A decoded query value: `+` is a space, `%XX` is a byte. The text is kept as
/// written when it is not valid percent-encoding, since a handler would rather
/// see the raw parameter than lose it.
fun srv_decode_form(raw: &str).R: String {
    return when encoding.form_decode(raw) {
        Ok(s) -> s
        Err(_) -> String.from_str(raw)
    }
}

/// Percent-decodes a request path.
fun srv_decode_path(raw: &str).R: String {
    return when encoding.percent_decode(raw) {
        Ok(s) -> s
        Err(_) -> String.from_str(raw)
    }
}

/// The value of the first query parameter called `name`, percent-decoded, or
/// `None`. `?a` is `Some("")` for `a`; names are compared after decoding.
fun ServerRequest.query_param(name: &str).R: option.Option<String> {
    val pairs = str.split(query.as_str(), "&")
    var i: usize = 0
    while i < pairs.len() {
        val pair = pairs.get(i).as_str()
        if !str.is_empty(pair) {
            var key = String.empty()
            var val_text = String.empty()
            val eq = str.index_of(pair, "=")
            if let Some(at) = eq {
                key = str.prefix(pair, at)
                val_text = String.from_str(str.substring(pair, at + 1))
            } else {
                key = String.from_str(pair)
            }
            val decoded = srv_decode_form(key.as_str())
            if str.eq(decoded.as_str(), name) {
                return option.Option.Some(value = srv_decode_form(val_text.as_str()))
            }
        }
        i = i + 1
    }
    return option.Option.None
}

/// The non-empty `/`-separated pieces of the path, each percent-decoded, so
/// `/users/42/` is `["users", "42"]` and `/a%2Fb` is one segment `a/b`.
fun ServerRequest.path_segments().R: List<String> {
    val raw = str.split(path.as_str(), "/")
    var out: List<String> = List.empty()
    var i: usize = 0
    while i < raw.len() {
        val piece = raw.get(i).as_str()
        if !str.is_empty(piece) {
            out.push(srv_decode_path(piece))
        }
        i = i + 1
    }
    return out
}

/// The reason phrase for a status code.
fun srv_reason(code: i32).R: String {
    if code == 100 {
        return String.from_str("Continue")
    }
    if code == 200 {
        return String.from_str("OK")
    }
    if code == 201 {
        return String.from_str("Created")
    }
    if code == 202 {
        return String.from_str("Accepted")
    }
    if code == 204 {
        return String.from_str("No Content")
    }
    if code == 206 {
        return String.from_str("Partial Content")
    }
    if code == 301 {
        return String.from_str("Moved Permanently")
    }
    if code == 302 {
        return String.from_str("Found")
    }
    if code == 303 {
        return String.from_str("See Other")
    }
    if code == 304 {
        return String.from_str("Not Modified")
    }
    if code == 307 {
        return String.from_str("Temporary Redirect")
    }
    if code == 308 {
        return String.from_str("Permanent Redirect")
    }
    if code == 400 {
        return String.from_str("Bad Request")
    }
    if code == 401 {
        return String.from_str("Unauthorized")
    }
    if code == 403 {
        return String.from_str("Forbidden")
    }
    if code == 404 {
        return String.from_str("Not Found")
    }
    if code == 405 {
        return String.from_str("Method Not Allowed")
    }
    if code == 408 {
        return String.from_str("Request Timeout")
    }
    if code == 409 {
        return String.from_str("Conflict")
    }
    if code == 410 {
        return String.from_str("Gone")
    }
    if code == 411 {
        return String.from_str("Length Required")
    }
    if code == 413 {
        return String.from_str("Content Too Large")
    }
    if code == 414 {
        return String.from_str("URI Too Long")
    }
    if code == 415 {
        return String.from_str("Unsupported Media Type")
    }
    if code == 417 {
        return String.from_str("Expectation Failed")
    }
    if code == 422 {
        return String.from_str("Unprocessable Content")
    }
    if code == 429 {
        return String.from_str("Too Many Requests")
    }
    if code == 431 {
        return String.from_str("Request Header Fields Too Large")
    }
    if code == 500 {
        return String.from_str("Internal Server Error")
    }
    if code == 501 {
        return String.from_str("Not Implemented")
    }
    if code == 502 {
        return String.from_str("Bad Gateway")
    }
    if code == 503 {
        return String.from_str("Service Unavailable")
    }
    if code == 504 {
        return String.from_str("Gateway Timeout")
    }
    if code == 505 {
        return String.from_str("HTTP Version Not Supported")
    }
    return String.from_str("Unknown")
}

/// A response with a status, a content type and a body.
fun srv_response(code: i32, content_type: &str, body: move Bytes).R: ServerResponse {
    var hs: List<Header> = List.empty()
    if !str.is_empty(content_type) {
        hs.push(Header(name = String.from_str("Content-Type"), value = String.from_str(content_type)))
    }
    return ServerResponse(status = code, headers = hs, body = body)
}

/// `200` with a `text/plain; charset=utf-8` body.
fun ok_text(text: &str).R: ServerResponse = srv_response(200, "text/plain; charset=utf-8", Bytes.from_str(text))

/// `200` with an `application/json` body; the text is sent as written.
fun json(text: &str).R: ServerResponse = srv_response(200, "application/json", Bytes.from_str(text))

/// `200` with a `text/html; charset=utf-8` body.
fun html(text: &str).R: ServerResponse = srv_response(200, "text/html; charset=utf-8", Bytes.from_str(text))

/// An empty response with this status.
fun status(code: i32).R: ServerResponse = srv_response(code, "", Bytes.empty())

/// A 404 response.
fun not_found().R: ServerResponse = srv_response(404, "text/plain; charset=utf-8", Bytes.from_str("not found\n"))

/// `400` whose body is `message`.
fun bad_request(message: &str).R: ServerResponse = srv_response(400, "text/plain; charset=utf-8", Bytes.from_str(message))

/// A copy of the response with one more header. The original is borrowed, so
/// this copies its headers and body; use `add_header` to grow one in place.
fun ServerResponse.with_header(name: &str, value: &str).R: ServerResponse {
    var hs: List<Header> = List.empty()
    var i: usize = 0
    while i < headers.len() {
        val h = headers.get(i)
        hs.push(Header(name = String.from_str(h.name.as_str()), value = String.from_str(h.value.as_str())))
        i = i + 1
    }
    hs.push(Header(name = String.from_str(name), value = String.from_str(value)))
    return ServerResponse(status = status, headers = hs, body = body.clone())
}

/// Adds a header to the response.
fun mut ServerResponse.add_header(name: &str, value: &str) {
    headers.push(Header(name = String.from_str(name), value = String.from_str(value)))
}

// ----- the listener and the connection -----

/// A bound, listening socket. Nothing closes on drop: `close` is the end.
datac Server(val fd: i32)

/// Binds `port` on every interface (0 asks for a free one, `Server.port` says
/// which). Gated exactly as `net.listen`: the importer's grant must cover the
/// port. Panics: as `net.listen`.
fun listen(port: u16).R: Server {
    val l = net.listen(port)
    return Server(fd = l.fd)
}

/// As `listen`, bound to one host (`"127.0.0.1"` for loopback only). Gated as
/// `net.listen_on`: the importer's grant must cover the host and the port.
/// Panics: as `net.listen_on`.
fun listen_on(host: &str, port: u16).R: Server {
    val l = net.listen_on(host, port)
    return Server(fd = l.fd)
}

/// The port the server listens on.
fun Server.port().R: u16 {
    val l = net.Listener(fd = fd)
    return l.port()
}

/// Makes `accept`/`try_accept` give up after `ms` without a peer (0 = never).
/// The timeout belongs to the listening socket, so every thread accepting on it
/// sees it.
fun Server.set_accept_timeout(ms: u64) {
    var l = net.Listener(fd = fd)
    l.set_timeout(ms)
}

/// Stops listening.
fun Server.close() {
    val l = net.Listener(fd = fd)
    l.close()
}

/// One accepted connection: the descriptor, the bytes read ahead of the request
/// being parsed (pipelined requests wait here), and what the last request asked
/// of the response.
datac ServerConn(
    /// The socket descriptor.
    val fd: i32,
    /// Bytes read but not yet consumed.
    var buf: Bytes,
    /// Where unconsumed bytes start in `buf`.
    var start: usize,
    /// Requests served so far.
    var served: usize,
    /// Whether to close after this response.
    var close_after: bool,
    /// Whether the current request is a HEAD.
    var head_only: bool,
    /// Whether to send a keep-alive header.
    var keep_alive_header: bool,
    /// The TLS session, when encrypted.
    val tls_handle: option.Option<tls.TlsHandle>,
)

/// A fresh server connection state for `fd`.
fun new_conn(fd: i32).R: ServerConn = ServerConn(
    fd = fd,
    buf = Bytes.empty(),
    start = 0,
    served = 0,
    close_after = false,
    head_only = false,
    keep_alive_header = false,
    tls_handle = option.Option.None,
)

/// A connection whose TLS handshake (`tls.accept`) is done: every read, write
/// and the close go through the same `Conn` dispatch the client uses.
fun new_conn_tls(t: tls.TlsStream).R: ServerConn = ServerConn(
    fd = t.fd,
    buf = Bytes.empty(),
    start = 0,
    served = 0,
    close_after = false,
    head_only = false,
    keep_alive_header = false,
    tls_handle = option.Option.Some(value = t.handle),
)

/// The connection a server connection reads.
fun ServerConn.conn().R: Conn = Conn(fd = fd, tls_handle = tls_handle)

/// Decrypted bytes OpenSSL already holds for this connection (always 0 for a
/// plain one): the socket shows nothing readable while a whole record waits
/// there, so `fill` has to ask before it waits.
fun ServerConn.pending().R: usize {
    if let Some(h) = tls_handle {
        val t = tls.TlsStream(fd = fd, handle = h)
        return t.pending()
    }
    return 0
}

/// Blocks for the next client. Panics: if `accept` fails.
fun Server.accept().R: ServerConn {
    val l = net.Listener(fd = fd)
    val s = net.accept(l)
    return new_conn(s.fd)
}

/// `accept` with a failure as a value: a listener with an accept timeout
/// returns `Err` (reason `net.accept: timed out`) when nobody came.
fun Server.try_accept().R: result.Result<ServerConn, HttpErr> {
    val l = net.Listener(fd = fd)
    return when net.try_accept(l) {
        Ok(s) -> result.Result.Ok(value = new_conn(s.fd))
        Err(e) -> result.Result.Err(error = HttpErr.Exchange(reason = e.reason))
    }
}

/// An error is `HttpErr.Exchange` whose reason starts with the status code the
/// server answers with (`408 request timed out`); a reason that does not start
/// with one (the peer reset, or closed between requests) is answered with
/// nothing. `http_error_status` reads it back, `ServerConn.write_error` answers.
fun srv_err<T>(code: i32, text: &str).R: result.Result<T, HttpErr> {
    var r = String.with_capacity(64)
    val c = fmt.int(code.to_i64())
    r.push_str(c.as_str())
    r.push_str(" ")
    r.push_str(text)
    return result.Result.Err(error = HttpErr.Exchange(reason = r))
}

/// An error that sends no response.
fun srv_silent<T>(text: &str).R: result.Result<T, HttpErr> {
    return result.Result.Err(error = HttpErr.Exchange(reason = String.from_str(text)))
}

/// The status code that matches a failure reason.
fun srv_reason_status(reason: &str).R: i32 {
    if str.len(reason) < 4 {
        return 0
    }
    if str.byte(reason, 3) != 32 {
        return 0
    }
    var code: i32 = 0
    var i: usize = 0
    while i < 3 {
        val c = str.byte(reason, i)
        if !str.is_digit(c) {
            return 0
        }
        code = code * 10 + (c - 48).to_i32()
        i = i + 1
    }
    return code
}

/// The status a failed `read_request` is answered with, or 0 when it is not
/// answered at all (the peer is gone or merely idle).
fun http_error_status(e: &HttpErr).R: i32 {
    return when e {
        Dial(reason) -> srv_reason_status(reason.as_str())
        Exchange(reason) -> srv_reason_status(reason.as_str())
        Redirects(reason) -> srv_reason_status(reason.as_str())
    }
}

/// The message text of an `HttpErr`.
fun http_error_text(e: &HttpErr).R: String {
    return when e {
        Dial(reason) -> String.from_str(reason.as_str())
        Exchange(reason) -> String.from_str(reason.as_str())
        Redirects(reason) -> String.from_str(reason.as_str())
    }
}

/// Reads at most 4096 more bytes into the buffer, waiting no later than
/// `deadline` (a `net.mono_ms` reading). `Ok(0)` is the peer's end of stream;
/// a deadline that passes is `408`.
fun mut ServerConn.fill(deadline: i64).R: result.Result<usize, HttpErr> {
    val now = net.mono_ms()
    if now >= deadline {
        return srv_err(408, "the request did not arrive in time")
    }
    val sock = net.Socket(fd = fd)
    if self.pending() == 0 && !sock.wait_readable((deadline - now).to_u64()) {
        return srv_err(408, "the request did not arrive in time")
    }
    return when conn_recv_try(self.conn(), 4096) {
        Ok(b) -> {
            val n = b.len()
            buf.append(b)
            result.Result.Ok(value = n)
        }
        Err(e) -> {
            val text = http_error_text(&e)
            srv_silent(text.as_str())
        }
    }
}

/// Drops the bytes the previous request used, keeping the read-ahead.
fun mut ServerConn.compact() {
    if start == 0 {
        return
    }
    var rest = Bytes.empty()
    var i = start
    while i < buf.len() {
        rest.push(buf.get(i))
        i = i + 1
    }
    buf = rest
    start = 0
}

/// The bytes from `from` up to `to`.
fun srv_bytes_range(b: Bytes, from: usize, to: usize).R: Bytes {
    var out = Bytes.empty()
    var i = from
    while i < to {
        out.push(b.get(i))
        i = i + 1
    }
    return out
}

/// The end of the head: the offset just past the blank line, 0 while it has not
/// arrived, -1 when what has arrived can never be a head (a bare `LF`, a `CR`
/// with no `LF`, a control byte, a byte above 127, an empty line before the
/// request line). Everything a head holds is therefore plain ASCII, which is
/// what lets it become a `String` without a validation that could panic.
fun srv_scan_head(b: Bytes).R: i64 {
    val n = b.len()
    var line_start: usize = 0
    var i: usize = 0
    while i < n {
        val c = b.get(i)
        if c == 13 {
            if i + 1 >= n {
                return 0
            }
            if b.get(i + 1) != 10 {
                return -1
            }
            if i == line_start {
                if i == 0 {
                    return -1
                }
                return (i + 2).to_i64()
            }
            line_start = i + 2
            i = i + 2
        } else {
            if c == 10 || c == 127 || c >= 128 {
                return -1
            }
            if c < 32 && c != 9 {
                return -1
            }
            i = i + 1
        }
    }
    return 0
}

/// The offset of the first `LF`, or the buffer length when there is none.
fun srv_first_lf(b: Bytes).R: usize {
    var i: usize = 0
    while i < b.len() {
        if b.get(i) == 10 {
            return i
        }
        i = i + 1
    }
    return b.len()
}

/// An RFC 9110 token character: what a method or a header name is made of.
fun srv_tchar(c: u8).R: bool {
    if str.is_digit(c) {
        return true
    }
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    return c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

/// Whether `s` is a valid HTTP token.
fun srv_is_token(s: &str).R: bool {
    val n = str.len(s)
    if n == 0 {
        return false
    }
    var i: usize = 0
    while i < n {
        if !srv_tchar(str.byte(s, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

/// How many headers are called `name`.
fun srv_count_headers(hs: List<Header>, name: &str).R: usize {
    var n: usize = 0
    var i: usize = 0
    while i < hs.len() {
        if name_eq(hs.get(i).name.as_str(), name) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

/// Whether any `Connection` header lists `token` (compared lower-case).
fun srv_connection_has(hs: List<Header>, token: &str).R: bool {
    var i: usize = 0
    while i < hs.len() {
        if name_eq(hs.get(i).name.as_str(), "connection") {
            val low = str.to_lower(hs.get(i).value.as_str())
            val parts = str.split(low.as_str(), ",")
            var j: usize = 0
            while j < parts.len() {
                val part = str.trim(parts.get(j).as_str())
                if str.eq(part.as_str(), token) {
                    return true
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return false
}

/// The one `Content-Length` of a request: -1 when absent, otherwise the number.
/// Every value must be digits only, and repeated headers must agree
/// (a disagreement is how request smuggling starts); a value too long to be a
/// real size is answered as too large.
fun srv_content_length(hs: List<Header>) .R: result.Result<i64, HttpErr> {
    var found = false
    var value: i64 = -1
    var i: usize = 0
    while i < hs.len() {
        if name_eq(hs.get(i).name.as_str(), "content-length") {
            val text = hs.get(i).value.as_str()
            val n = str.len(text)
            if n == 0 {
                return srv_err(400, "empty Content-Length")
            }
            var v: i64 = 0
            var k: usize = 0
            while k < n {
                val c = str.byte(text, k)
                if !str.is_digit(c) {
                    return srv_err(400, "Content-Length is not a number")
                }
                if v < 1000000000000000 {
                    v = v * 10 + (c - 48).to_i64()
                }
                k = k + 1
            }
            if found && v != value {
                return srv_err(400, "conflicting Content-Length headers")
            }
            found = true
            value = v
        }
        i = i + 1
    }
    return result.Result.Ok(value = value)
}

/// The first value of a header, trimmed and lower-cased.
fun srv_header_token(hs: List<Header>, name: &str).R: String {
    val raw = header_value(hs, name)
    val trimmed = str.trim(raw.as_str())
    return str.to_lower(trimmed.as_str())
}

/// Whether a method must carry a body length.
fun srv_method_needs_length(m: &str).R: bool {
    return str.eq(m, "POST") || str.eq(m, "PUT") || str.eq(m, "PATCH")
}

/// One line of the chunked framing (a size line or a trailer), without its
/// `CRLF`. Waits for more bytes until `deadline`; a line longer than `max_len`
/// is `too_long`.
fun mut ServerConn.take_line(deadline: i64, max_len: usize, too_long: i32).R: result.Result<String, HttpErr> {
    var from = start
    while true {
        var i = from
        var at: usize = 0
        var found = false
        while i < buf.len() && !found {
            if buf.get(i) == 10 {
                at = i
                found = true
            }
            i = i + 1
        }
        if found {
            if at == start || buf.get(at - 1) != 13 {
                return srv_err(400, "malformed line in the body framing")
            }
            var out = String.empty()
            var k = start
            while k < at - 1 {
                val c = buf.get(k)
                if c < 32 || c >= 127 {
                    return srv_err(400, "malformed line in the body framing")
                }
                out.push(c)
                k = k + 1
            }
            start = at + 1
            return result.Result.Ok(value = out)
        }
        if buf.len() - start > max_len {
            return srv_err(too_long, "a line in the body framing is too long")
        }
        from = buf.len()
        val got = self.fill(deadline)?
        if got == 0 {
            return srv_silent("the connection closed inside the request body")
        }
    }
    return srv_silent("unreachable")
}

/// Makes `n` bytes available from `start`.
fun mut ServerConn.need(n: usize, deadline: i64).R: result.Result<usize, HttpErr> {
    while buf.len() - start < n {
        val got = self.fill(deadline)?
        if got == 0 {
            return srv_silent("the connection closed inside the request body")
        }
    }
    return result.Result.Ok(value = 0)
}

/// Parses a chunk-size line, refusing sizes over `max_body`.
fun srv_hex_size(text: &str, max_body: usize).R: result.Result<usize, HttpErr> {
    val n = str.len(text)
    var value: usize = 0
    var digits: usize = 0
    var i: usize = 0
    var going = true
    while i < n && going {
        val c = str.byte(text, i)
        if c == 59 {
            going = false
        } else {
            val d = hex_value(c)
            if d < 0 {
                return srv_err(400, "chunk size is not hexadecimal")
            }
            digits = digits + 1
            if digits > 12 {
                return srv_err(413, "chunk too large")
            }
            value = value * 16 + d.to_usize()
            i = i + 1
        }
    }
    if digits == 0 {
        return srv_err(400, "chunk size has no digits")
    }
    return result.Result.Ok(value = value)
}

/// A chunked body: size line, data, `CRLF`, repeated to the zero chunk, then
/// trailers (read and discarded, bounded by the header limit).
fun mut ServerConn.read_chunked(limits: &Limits, deadline: i64).R: result.Result<Bytes, HttpErr> {
    var out = Bytes.empty()
    var going = true
    while going {
        val size_line = self.take_line(deadline, 1024, 400)?
        val size = srv_hex_size(size_line.as_str(), limits.max_body)?
        if size == 0 {
            going = false
        } else {
            if out.len() + size > limits.max_body {
                return srv_err(413, "the request body is too large")
            }
            self.need(size + 2, deadline)?
            out.append(srv_bytes_range(buf, start, start + size))
            if buf.get(start + size) != 13 || buf.get(start + size + 1) != 10 {
                return srv_err(400, "a chunk is not followed by CRLF")
            }
            start = start + size + 2
        }
    }
    var trailer_bytes: usize = 0
    var trailing = true
    while trailing {
        val line = self.take_line(deadline, limits.max_header_bytes, 431)?
        if str.is_empty(line.as_str()) {
            trailing = false
        } else {
            trailer_bytes = trailer_bytes + str.len(line.as_str()) + 2
            if trailer_bytes > limits.max_header_bytes {
                return srv_err(431, "the trailers are too large")
            }
        }
    }
    return result.Result.Ok(value = out)
}

/// The next request on this connection, parsed and framed, or why not. See
/// `plan/http-server.md` for the status of every failure.
fun mut ServerConn.read_request(limits: &Limits).R: result.Result<ServerRequest, HttpErr> {
    self.compact()
    close_after = false
    head_only = false
    keep_alive_header = false
    // Waiting for the first byte of a request is the idle wait; the head
    // deadline starts when that byte arrives, so a client that connects and
    // trickles is cut off at the head deadline, not never.
    if buf.is_empty() {
        var idle = limits.head_timeout_ms
        if served > 0 {
            idle = limits.idle_timeout_ms
        }
        val first = self.fill(net.mono_ms() + idle.to_i64())
        when first {
            Ok(n) -> {
                if n == 0 {
                    return srv_silent("the peer closed the connection")
                }
            }
            Err(e) -> {
                if served > 0 {
                    return srv_silent("idle timeout")
                }
                return result.Result.Err(error = e)
            }
        }
    }
    val head_deadline = net.mono_ms() + limits.head_timeout_ms.to_i64()
    var end: usize = 0
    var scanning = true
    while scanning {
        val r = srv_scan_head(buf)
        if r < 0 {
            return srv_err(400, "malformed request head")
        }
        val eol = srv_first_lf(buf)
        if eol >= buf.len() {
            if buf.len() > limits.max_request_line {
                return srv_err(414, "the request line is too long")
            }
        } else {
            if eol > limits.max_request_line {
                return srv_err(414, "the request line is too long")
            }
            var seen = buf.len()
            if r > 0 {
                seen = r.to_usize()
            }
            if seen - (eol + 1) > limits.max_header_bytes {
                return srv_err(431, "the request headers are too large")
            }
        }
        if r > 0 {
            end = r.to_usize()
            scanning = false
        } else {
            val got = self.fill(head_deadline)?
            if got == 0 {
                return srv_silent("the connection closed inside the request head")
            }
        }
    }
    val text = head_text(buf, end)
    start = end
    val lines = str.split(text.as_str(), "\r\n")
    // The request line: METHOD SP target SP HTTP/1.x, single spaces.
    val parts = str.split(lines.get(0).as_str(), " ")
    if parts.len() != 3 {
        return srv_err(400, "malformed request line")
    }
    val method = String.from_str(parts.get(0).as_str())
    val target = String.from_str(parts.get(1).as_str())
    val version = parts.get(2).as_str()
    if !srv_is_token(method.as_str()) {
        return srv_err(400, "malformed request method")
    }
    if str.is_empty(target.as_str()) {
        return srv_err(400, "empty request target")
    }
    var http11 = false
    if str.eq(version, "HTTP/1.1") {
        http11 = true
    } elif str.eq(version, "HTTP/1.0") {
        http11 = false
    } else {
        // `HTTP/d.d` is a version this server does not speak; anything else
        // is not a version at all.
        if str.len(version) == 8 && str.starts_with(version, "HTTP/") && str.is_digit(str.byte(version, 5)) && str.byte(version, 6) == 46 && str.is_digit(str.byte(version, 7)) {
            return srv_err(505, "HTTP version not supported")
        }
        return srv_err(400, "malformed HTTP version")
    }
    if str.byte(target.as_str(), 0) != 47 {
        if !(str.eq(target.as_str(), "*") && str.eq(method.as_str(), "OPTIONS")) {
            return srv_err(400, "the request target must start with /")
        }
    }
    // The headers.
    var hs: List<Header> = List.empty()
    var i: usize = 1
    while i < lines.len() {
        val line = lines.get(i).as_str()
        if str.byte(line, 0) == 32 || str.byte(line, 0) == 9 {
            return srv_err(400, "folded header lines are not accepted")
        }
        val colon = str.index_of(line, ":")
        if let Some(at) = colon {
            val name = str.prefix(line, at)
            if !srv_is_token(name.as_str()) {
                return srv_err(400, "malformed header name")
            }
            val value = str.trim(str.substring(line, at + 1))
            hs.push(Header(name = name, value = value))
        } else {
            return srv_err(400, "a header line has no colon")
        }
        if hs.len() > limits.max_headers {
            return srv_err(431, "too many request headers")
        }
        i = i + 1
    }
    // Framing.
    val te_count = srv_count_headers(hs, "transfer-encoding")
    val cl_count = srv_count_headers(hs, "content-length")
    if te_count > 0 && cl_count > 0 {
        return srv_err(400, "Content-Length together with Transfer-Encoding")
    }
    if te_count > 1 {
        return srv_err(400, "more than one Transfer-Encoding header")
    }
    var chunked = false
    if te_count == 1 {
        val te = srv_header_token(hs, "transfer-encoding")
        if !str.eq(te.as_str(), "chunked") {
            return srv_err(501, "unknown transfer coding")
        }
        if !http11 {
            return srv_err(400, "Transfer-Encoding in an HTTP/1.0 request")
        }
        chunked = true
    }
    val cl = srv_content_length(hs)?
    if !chunked && cl < 0 && srv_method_needs_length(method.as_str()) {
        return srv_err(411, "a body needs Content-Length or chunked framing")
    }
    if !chunked && cl > limits.max_body.to_i64() {
        return srv_err(413, "the request body is too large")
    }
    var has_body = chunked
    if cl > 0 {
        has_body = true
    }
    // `Expect`.
    if headers_have(hs, "expect") {
        val ex = srv_header_token(hs, "expect")
        if !str.eq(ex.as_str(), "100-continue") {
            return srv_err(417, "unsupported Expect")
        }
        if http11 && has_body && buf.len() == start {
            val sent = conn_send_all_try(self.conn(), Bytes.from_str("HTTP/1.1 100 Continue\r\n\r\n"))
            if let Err(e) = sent {
                val text = http_error_text(&e)
                return srv_silent(text.as_str())
            }
        }
    }
    // The body.
    var body = Bytes.empty()
    if has_body {
        val body_deadline = net.mono_ms() + limits.body_timeout_ms.to_i64()
        if chunked {
            body = self.read_chunked(limits, body_deadline)?
        } else {
            val n = cl.to_usize()
            self.need(n, body_deadline)?
            body = srv_bytes_range(buf, start, start + n)
            start = start + n
        }
    }
    // What the client asked of the connection.
    served = served + 1
    if srv_connection_has(hs, "close") {
        close_after = true
    }
    if !http11 {
        if srv_connection_has(hs, "keep-alive") {
            keep_alive_header = true
        } else {
            close_after = true
        }
    }
    if served >= limits.max_requests_per_conn {
        close_after = true
    }
    if str.eq(method.as_str(), "HEAD") {
        head_only = true
    }
    var path = String.empty()
    var query = String.empty()
    val q = str.index_of(target.as_str(), "?")
    if let Some(at) = q {
        path = str.prefix(target.as_str(), at)
        query = String.from_str(str.substring(target.as_str(), at + 1))
    } else {
        path = String.from_str(target.as_str())
    }
    return result.Result.Ok(value = ServerRequest(
        method = method,
        target = target,
        path = path,
        query = query,
        headers = hs,
        body = body,
    ))
}

/// Asks for the connection to close after the response being written.
fun mut ServerConn.mark_close() {
    close_after = true
}

/// Whether the connection closes after this response.
fun ServerConn.wants_close().R: bool = close_after

/// Whether a header is safe to send.
fun srv_clean_header(h: Header).R: bool {
    val n = str.len(h.name.as_str())
    val v = str.len(h.value.as_str())
    var i: usize = 0
    while i < n {
        if !srv_tchar(str.byte(h.name.as_str(), i)) {
            return false
        }
        i = i + 1
    }
    var k: usize = 0
    while k < v {
        val c = str.byte(h.value.as_str(), k)
        if c == 13 || c == 10 || c == 0 {
            return false
        }
        k = k + 1
    }
    return n > 0
}

/// Writes one response: the status line, the headers (minus any header of
/// ours: `Content-Length`, `Transfer-Encoding`, `Connection`; and any whose
/// name or value could split the response), the framing the server owns, and
/// the body unless the request was `HEAD` or the status has none. A write that
/// fails because the peer is gone is an `Err`, never a panic.
fun mut ServerConn.write_response(resp: &ServerResponse).R: result.Result<usize, HttpErr> {
    val code = resp.status
    var out = String.with_capacity(256)
    out.push_str("HTTP/1.1 ")
    val code_text = fmt.int(code.to_i64())
    out.push_str(code_text.as_str())
    out.push_str(" ")
    val reason = srv_reason(code)
    out.push_str(reason.as_str())
    out.push_str("\r\n")
    var i: usize = 0
    while i < resp.headers.len() {
        val h = resp.headers.get(i)
        if name_eq(h.name.as_str(), "connection") {
            val low = str.to_lower(h.value.as_str())
            if str.contains(low.as_str(), "close") {
                close_after = true
            }
        } elif !name_eq(h.name.as_str(), "content-length") && !name_eq(h.name.as_str(), "transfer-encoding") {
            if srv_clean_header(Header(name = String.from_str(h.name.as_str()), value = String.from_str(h.value.as_str()))) {
                out.push_str(h.name.as_str())
                out.push_str(": ")
                out.push_str(h.value.as_str())
                out.push_str("\r\n")
            }
        }
        i = i + 1
    }
    val bodyless = code < 200 || code == 204 || code == 304
    if !bodyless {
        out.push_str("Content-Length: ")
        val len_text = fmt.uint(resp.body.len().to_u64())
        out.push_str(len_text.as_str())
        out.push_str("\r\n")
    }
    if close_after {
        out.push_str("Connection: close\r\n")
    } elif keep_alive_header {
        out.push_str("Connection: keep-alive\r\n")
    }
    out.push_str("\r\n")
    var wire = out.into_bytes()
    if !bodyless && !head_only {
        wire.append(resp.body.clone())
    }
    return conn_send_all_try(self.conn(), wire)
}

/// Answers a failed `read_request` with its status and the reason as text, and
/// marks the connection to close; does nothing when the failure has no status
/// (the peer is gone, or the connection was only idle).
fun mut ServerConn.write_error(e: &HttpErr).R: result.Result<usize, HttpErr> {
    val code = http_error_status(e)
    if code == 0 {
        return result.Result.Ok(value = 0)
    }
    val text = http_error_text(e)
    var message = String.with_capacity(64)
    message.push_str(str.substring(text.as_str(), 4))
    message.push_str("\n")
    close_after = true
    head_only = false
    val resp = srv_response(code, "text/plain; charset=utf-8", message.into_bytes())
    return self.write_response(&resp)
}

/// Ends the connection: half-closes so the peer reads the response and then end
/// of stream, reads and discards what the peer is still sending for a short,
/// bounded while (closing with unread data makes the kernel reset the
/// connection, which can destroy a response the client has not read yet), then
/// closes the descriptor.
fun ServerConn.close() {
    // A TLS connection ends its session first (`close_notify`), then goes
    // through the same half-close and drain: what is drained afterwards is
    // raw bytes, which is all it needs to be.
    if let Some(h) = tls_handle {
        val ended = tls.try_shutdown(tls.TlsStream(fd = fd, handle = h))
    }
    val sock = net.Socket(fd = fd)
    if net.try_shutdown_write(sock) {
        val until = net.mono_ms() + 250
        var drained: usize = 0
        var going = true
        while going {
            val now = net.mono_ms()
            if now >= until || drained > 1048576 {
                going = false
            } elif !sock.wait_readable((until - now).to_u64()) {
                going = false
            } else {
                when net.try_recv(sock, 4096) {
                    Ok(b) -> {
                        if b.is_empty() {
                            going = false
                        } else {
                            drained = drained + b.len()
                        }
                    }
                    Err(_) -> {
                        going = false
                    }
                }
            }
        }
    }
    net.close(sock)
}

// ----- serving -----

/// Serves one connection to its end and closes it. `budget` is the most
/// requests to answer (0 = no limit); the count returned is how many requests
/// got a response, an error response included. A request whose handler ran
/// counts even if the response could not be written.
fun mut ServerConn.serve(handler: fun(&ServerRequest).R: ServerResponse, limits: &Limits, budget: u64).R: u64 {
    var count: u64 = 0
    var going = true
    while going {
        val r = self.read_request(limits)
        when r {
            Ok(req) -> {
                val resp = handler(&req)
                count = count + 1
                if budget > 0 && count >= budget {
                    self.mark_close()
                }
                val w = self.write_response(&resp)
                if result.is_err(r = &w) {
                    going = false
                } elif self.wants_close() {
                    going = false
                }
            }
            Err(e) -> {
                if http_error_status(&e) > 0 {
                    count = count + 1
                    val w = self.write_error(&e)
                }
                going = false
            }
        }
    }
    self.close()
    return count
}

/// The accept loop on a listener you already hold: one connection at a time,
/// each served to its end, until `max_requests` requests have been answered
/// (0 = never stop) or, if the listener has an accept timeout, nobody came for
/// that long. Returns the count. A failed accept (a connection that died in the
/// queue) is skipped.
fun serve_on(server: &Server, handler: fun(&ServerRequest).R: ServerResponse, limits: &Limits, max_requests: u64).R: u64 {
    var total: u64 = 0
    var going = true
    while going {
        if max_requests > 0 && total >= max_requests {
            going = false
        } else {
            val acc = server.try_accept()
            when acc {
                Ok(c) -> {
                    var conn = c
                    var budget: u64 = 0
                    if max_requests > 0 {
                        budget = max_requests - total
                    }
                    total = total + conn.serve(handler, limits, budget)
                }
                Err(e) -> {
                    val text = http_error_text(&e)
                    if str.contains(text.as_str(), "timed out") {
                        going = false
                    } else {
                        thread.sleep_ms(5)
                    }
                }
            }
        }
    }
    return total
}

/// Listens on `port` and serves forever, one connection at a time, with the
/// default limits.
fun serve(port: u16, handler: fun(&ServerRequest).R: ServerResponse) {
    val s = listen(port)
    val limits = default_limits()
    val n = serve_on(&s, handler, &limits, 0)
}

/// As `serve`, returning once `max_requests` requests have been answered, with
/// the listener closed. This is what makes a server testable.
fun serve_n(port: u16, handler: fun(&ServerRequest).R: ServerResponse, max_requests: u64).R: u64 {
    val s = listen(port)
    val limits = default_limits()
    val n = serve_on(&s, handler, &limits, max_requests)
    s.close()
    return n
}

// ----- serving HTTPS -----

/// As `serve_on`, with every accepted connection put through the TLS server
/// handshake first (`tls.accept`, under the config's deadline). A client whose
/// handshake fails (no certificate where one is required, no common protocol, a
/// reset) costs that socket and nothing else: it is closed and the loop goes on.
/// The limits, statuses and per-connection rules are `serve_on`'s. `config` is
/// shared and never changed, so threads may serve from the same one.
fun serve_tls_on(server: &Server, config: &tls.ServerConfig, handler: fun(&ServerRequest).R: ServerResponse, limits: &Limits, max_requests: u64).R: u64 {
    var total: u64 = 0
    var going = true
    while going {
        if max_requests > 0 && total >= max_requests {
            going = false
        } else {
            val l = net.Listener(fd = server.fd)
            val acc = net.try_accept(l)
            when acc {
                Ok(sock) -> {
                    val hs = tls.accept(config, sock)
                    when hs {
                        Ok(t) -> {
                            var conn = new_conn_tls(t)
                            var budget: u64 = 0
                            if max_requests > 0 {
                                budget = max_requests - total
                            }
                            total = total + conn.serve(handler, limits, budget)
                        }
                        Err(_) -> {
                            net.close(sock)
                        }
                    }
                }
                Err(e) -> {
                    if str.contains(e.reason.as_str(), "timed out") {
                        going = false
                    } else {
                        thread.sleep_ms(5)
                    }
                }
            }
        }
    }
    return total
}

/// Listens on `port` and serves HTTPS forever, one connection at a time, with
/// the default limits. `net.listen` takes a port, not an address, and binds
/// every interface.
fun serve_tls(port: u16, config: &tls.ServerConfig, handler: fun(&ServerRequest).R: ServerResponse) {
    val s = listen(port)
    val limits = default_limits()
    val n = serve_tls_on(&s, config, handler, &limits, 0)
}

/// As `serve_tls`, returning once `max_requests` requests have been answered
/// (or, with an accept timeout set on the listener, nobody came): what makes an
/// HTTPS server testable.
fun serve_tls_n(port: u16, config: &tls.ServerConfig, handler: fun(&ServerRequest).R: ServerResponse, max_requests: u64).R: u64 {
    val s = listen(port)
    val limits = default_limits()
    val n = serve_tls_on(&s, config, handler, &limits, max_requests)
    s.close()
    return n
}

/// What a worker thread is handed: the shared listener's descriptor and its own
/// copy of the limits. The handler is a plain function value, so nothing
/// borrowed crosses the thread boundary.
datac Worker(val fd: i32, val handler: fun(&ServerRequest).R: ServerResponse, val limits: Limits)

/// The loop one server worker thread runs.
fun worker_main(w: move Worker).R: u64 {
    val s = Server(fd = w.fd)
    return serve_on(&s, w.handler, &w.limits, 0)
}

/// One thread per worker, spawned one inside the next so that the handles never
/// need a container (a `Thread` cannot be a list element): each level spawns its
/// worker, runs the rest, then joins its own.
fun run_workers(n: usize, fd: i32, handler: fun(&ServerRequest).R: ServerResponse, limits: &Limits).R: u64 {
    if n == 0 {
        return 0
    }
    val h = thread.spawn(worker_main, Worker(fd = fd, handler = handler, limits = limits.dup()))
    val rest = run_workers(n - 1, fd, handler, limits)
    val mine = when thread.join(h) {
        Ok(v) -> v
        Err(_) -> 0
    }
    return rest + mine
}

/// `workers` threads, each accepting on the listener you hold and serving one
/// connection at a time. With `idle_ms` above 0 a worker stops when no client
/// has connected for that long and the call returns the total requests
/// answered; with 0 it never returns. The listener is not closed.
fun serve_threaded_on(server: &Server, handler: fun(&ServerRequest).R: ServerResponse, limits: &Limits, workers: usize, idle_ms: u64).R: u64 {
    server.set_accept_timeout(idle_ms)
    return run_workers(workers, server.fd, handler, limits)
}

/// Listens on `port` and serves forever on `workers` threads, with the default
/// limits. A panic in a handler ends its worker thread, not the process.
fun serve_threaded(port: u16, handler: fun(&ServerRequest).R: ServerResponse, workers: usize) {
    val s = listen(port)
    val limits = default_limits()
    val n = serve_threaded_on(&s, handler, &limits, workers, 0)
}
