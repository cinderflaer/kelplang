//! The platform a program was built for.

/// The target operating system, as a lowercase name: `"linux"`, `"macos"`,
/// `"windows"`, `"freebsd"`, or `"unknown"`. It is fixed when the program is
/// built, not read from the machine it runs on.
extern fun os().return: str

/// The target CPU architecture: `"x86_64"`, `"aarch64"`, `"arm"`, `"riscv64"`,
/// `"x86"`, or `"unknown"`. Fixed when the program is built.
extern fun arch().return: str
