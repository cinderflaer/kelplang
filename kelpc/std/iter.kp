/* std/iter, the iterator protocol and the iterators that ship with it
   (`kelp wiki page language/iterators.md`).

   `for x in <expr>` over a `List<T>` or `[T; N]` is still the index walk
   (`syntax.md` 6.2). Everything else is walked through this trait: `next`
   hands back one owned item, and the loop stops on `None`. The trait is
   deliberately the *only* thing the compiler knows about here; a type opts in
   by implementing it, exactly as `Shape` opts into `area`.

   The module is pure Kelp and builds in a freestanding image when `std/option`
   does (kernel stage 4's allowed set). It is the reason `for` over a range
   costs no libc: `Range.next` is an ordinary method and the `for` is an
   ordinary `while` by the time either backend sees it.

   Adapters and the list iterator are at the end of the file. An adapter is a
   generic `datac` over the iterator it wraps and over that iterator's item
   (`TakeIter<I, T>`), and a generic type whose template declares
   `fun mut Name<...>.next().return: option.Option<Item>` is an `Iterator` by
   shape: it satisfies `I: Iterator` and names `I::Item`, with no generic trait
   impl (`plan/generic-trait-impls.md` is the general solution; this is the
   case the adapters need). A borrowing iterator value (`List.iter()` yielding
   `&T` through `.map`, `.filter`, ...) is still absent: a borrow into a list
   cannot outlive the iterator that handed it out without lifetime syntax, so
   the list iterators own their items. `for x in xs.iter()` is a desugar of
   `for x in xs`, not a value. */

impl "std/option"

/* The protocol `for` accepts over anything that is not a `List`/array.

   `next` takes `mut Self` because a stateful iterator advances through
   itself, and hands back an **owned** item, which is what makes
   `for x in it { }` bind `x` by value. */
pub trait Iterator {
    // What one `next()` yields.
    type Item
    fun mut Self.next().return: option.Option<Self::Item>
}

/* A half-open integer range, `[lo, hi)` stepping by `step`. The fields are
   `var` because `next` advances `lo`; `hi` and `step` stay put. */
pub datac Range(var lo: i64, val hi: i64, val step: i64)

impl Iterator for Range {
    type Item = i64
    fun mut Self.next().return: option.Option<i64> {
        // The emptiness test follows the step's direction, so a descending
        // range (`step < 0`) stops at `hi` from above rather than running on.
        if self.step > 0 {
            if self.lo >= self.hi {
                return option.Option.None
            }
        } else {
            if self.lo <= self.hi {
                return option.Option.None
            }
        }
        val v = self.lo
        self.lo += self.step
        return option.Option.Some(value = v)
    }
}

// `lo` to `hi`, one step at a time, half-open: `iter.range(0, 3)` yields 0, 1,
// 2, and an empty range yields nothing.
pub fun range(a: i64, b: i64).return: Range = Range(lo = a, hi = b, step = 1)

// The same with an explicit step; a negative one walks down from `a` to `b`.
pub fun range_step(a: i64, b: i64, step: i64).return: Range = Range(lo = a, hi = b, step = step)

/* How many items an iterator still holds, measured by draining it. */
pub fun count<I: Iterator>(it: move I).return: usize {
    var total: usize = 0
    // A parameter is an immutable binding, and `for` borrows the iterator it
    // walks, so an owned one is bound to a `var` first. (A `var` local or a
    // temporary needs no such step.)
    var cursor = it
    for _x in cursor {
        total += 1
    }
    return total
}

/* The sum of a range's items, for the one item type that can be added into an
   accumulator. `I::Item` is any type; an instantiation whose item is not an
   `i64` is a type error at the addition, which is the honest edge of an
   associated type with no equality constraint. */
pub fun sum_i64<I: Iterator>(it: move I).return: i64 {
    var total: i64 = 0
    var cursor = it
    for x in cursor {
        total += x
    }
    return total
}

/* Drain an iterator into a fresh list, in order. */
pub fun collect_list<I: Iterator>(it: move I).return: List<I::Item> {
    var out: List<I::Item> = List.empty()
    var cursor = it
    for x in cursor {
        out.push(x)
    }
    return out
}

// ---- the list iterator --------------------------------------------------------

/* An owned walk over a list, front to back. The list is held reversed so that
   `next` is a `pop`, which moves the element out: no element needs to be
   `Copy`, and nothing is shifted. */
pub datac ListIter<T>(var rest: List<T>)

fun mut ListIter<T>.next().return: option.Option<T> {
    if self.rest.is_empty() {
        return option.Option.None
    }
    return option.Option.Some(value = self.rest.pop())
}

/* The list's elements in order, moving the list into the iterator. */
pub fun into_iter<T>(xs: move List<T>).return: ListIter<T> {
    var rest = xs
    rest.reverse()
    return ListIter(rest = rest)
}

/* The elements of a borrowed list, cloned, for an element that can be copied.
   (An element that cannot be cloned walks with `into_iter`.) */
pub fun cloned<T>(xs: &List<T>).return: ListIter<T> {
    return into_iter(xs.clone())
}

// ---- adapters -------------------------------------------------------------------
//
// Each adapter takes its iterator by `move` and is itself an iterator, so they
// chain: `iter.take(iter.filter(iter.into_iter(xs), pred), 3)`. The second type
// parameter is the wrapped iterator's item, written out because a type's
// declaration cannot spell `I::Item`; the constructor functions fill it in.

pub datac MapIter<I, T, U>(var inner: I, val f: closure(&T).return: U)

fun mut MapIter<I, T, U>.next().return: option.Option<U> {
    val item = self.inner.next()
    return when item {
        Some(x) -> option.Option.Some(value = self.f(x))
        None -> option.Option.None
    }
}

/* Each item through `f`. */
pub fun map<I: Iterator, U>(it: move I, f: move closure(&I::Item).return: U).return: MapIter<I, I::Item, U> {
    return MapIter(inner = it, f = f)
}

pub datac FilterIter<I, T>(var inner: I, val pred: closure(&T).return: bool)

fun mut FilterIter<I, T>.next().return: option.Option<T> {
    while true {
        val item = self.inner.next()
        when item {
            Some(x) -> {
                if self.pred(x) {
                    return option.Option.Some(value = x)
                }
            }
            None -> {
                return option.Option.None
            }
        }
    }
}

/* The items for which `pred` holds. */
pub fun filter<I: Iterator>(it: move I, pred: move closure(&I::Item).return: bool).return: FilterIter<I, I::Item> {
    return FilterIter(inner = it, pred = pred)
}

pub datac TakeIter<I, T>(var inner: I, var left: usize)

fun mut TakeIter<I, T>.next().return: option.Option<T> {
    if self.left == 0 {
        return option.Option.None
    }
    self.left -= 1
    return self.inner.next()
}

/* At most the first `n` items. */
pub fun take<I: Iterator>(it: move I, n: usize).return: TakeIter<I, I::Item> {
    return TakeIter(inner = it, left = n)
}

pub datac SkipIter<I, T>(var inner: I, var left: usize)

fun mut SkipIter<I, T>.next().return: option.Option<T> {
    while self.left > 0 {
        self.left -= 1
        val dropped = self.inner.next()
        when dropped {
            Some(_) -> {}
            None -> {
                self.left = 0
            }
        }
    }
    return self.inner.next()
}

/* The items after the first `n`. */
pub fun skip<I: Iterator>(it: move I, n: usize).return: SkipIter<I, I::Item> {
    return SkipIter(inner = it, left = n)
}

pub datac EnumerateIter<I, T>(var inner: I, var index: usize)

fun mut EnumerateIter<I, T>.next().return: option.Option<(usize, T)> {
    val item = self.inner.next()
    return when item {
        Some(x) -> {
            val at = self.index
            self.index += 1
            option.Option.Some(value = (at, x))
        }
        None -> option.Option.None
    }
}

/* Each item with its position, counting from 0. */
pub fun enumerate<I: Iterator>(it: move I).return: EnumerateIter<I, I::Item> {
    return EnumerateIter(inner = it, index = 0)
}

pub datac ZipIter<A, B, T, U>(var left: A, var right: B)

fun mut ZipIter<A, B, T, U>.next().return: option.Option<(T, U)> {
    val a = self.left.next()
    val b = self.right.next()
    return when (a, b) {
        (Some(x), Some(y)) -> option.Option.Some(value = (x, y))
        else -> option.Option.None
    }
}

/* Pairs of items, stopping when either iterator does. */
pub fun zip<A: Iterator, B: Iterator>(a: move A, b: move B).return: ZipIter<A, B, A::Item, B::Item> {
    return ZipIter(left = a, right = b)
}

pub datac ChainIter<A, B, T>(var first: A, var second: B, var first_done: bool)

fun mut ChainIter<A, B, T>.next().return: option.Option<T> {
    if !self.first_done {
        val item = self.first.next()
        when item {
            Some(x) -> {
                return option.Option.Some(value = x)
            }
            None -> {
                self.first_done = true
            }
        }
    }
    return self.second.next()
}

/* All of `a`, then all of `b`; the two must yield the same item type. */
pub fun chain<A: Iterator, B: Iterator>(a: move A, b: move B).return: ChainIter<A, B, A::Item> {
    return ChainIter(first = a, second = b, first_done = false)
}

// ---- consumers --------------------------------------------------------------------

/* Whether `pred` holds for some item; stops at the first that does. */
pub fun any<I: Iterator>(it: move I, pred: closure(&I::Item).return: bool).return: bool {
    var cursor = it
    for x in cursor {
        if pred(x) {
            return true
        }
    }
    return false
}

/* Whether `pred` holds for every item; stops at the first that does not. */
pub fun all<I: Iterator>(it: move I, pred: closure(&I::Item).return: bool).return: bool {
    var cursor = it
    for x in cursor {
        if !pred(x) {
            return false
        }
    }
    return true
}

/* The first item for which `pred` holds. */
pub fun find<I: Iterator>(it: move I, pred: closure(&I::Item).return: bool).return: option.Option<I::Item> {
    var cursor = it
    for x in cursor {
        if pred(x) {
            return option.Option.Some(value = x)
        }
    }
    return option.Option.None
}

/* The last item, or `None` for an empty iterator. */
pub fun last<I: Iterator>(it: move I).return: option.Option<I::Item> {
    var cursor = it
    var out: option.Option<I::Item> = option.Option.None
    for x in cursor {
        out = option.Option.Some(value = x)
    }
    return out
}

/* `init` folded with `f` over the items, in order: `f(acc, &item)` is the next
   accumulator. */
pub fun fold<I: Iterator, A>(it: move I, init: move A, f: closure(&A, &I::Item).return: A).return: A {
    var cursor = it
    var acc = init
    for x in cursor {
        acc = f(acc, x)
    }
    return acc
}
