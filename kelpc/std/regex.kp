impl "std/str"
impl "std/option"
impl "std/result"

/* std/regex: a linear-time regular expression engine in pure Kelp.

   A pattern is parsed to an AST, compiled to a Thompson NFA program, and run
   by a Pike VM over bytes: a thread list with the capture slots carried per
   thread. Matching costs O(program size x input length) and no pattern can
   backtrack, so `(a+)+$` against thirty `a`s and a `b` is as cheap as `a$`.
   There are no backreferences and no lookaround (a pattern that writes one is
   refused at `compile`, with the construct named).

   The syntax and the semantics are written out in `kelp wiki page stdlib/regex.md`; this file
   is the implementation. In short: literals, `.`, classes `[a-z]`/`[^...]`,
   the escapes `\d \D \w \W \s \S \b \B \n \r \t \xHH`, anchors `^ $`, groups
   `( )` and `(?: )`, alternation, the repeats `* + ? {n} {n,} {n,m}` with their
   lazy forms, and the flags `i`, `s` and `m` (`(?i)`, `(?is)`, `(?i:...)`).
   Alternation and repetition are leftmost-first, as in Perl.

   Everything is bytes. A `&str` input is scanned through a `View`, so the
   length is read once; a pattern or an input with a NUL byte cannot be written
   as a `&str`, so `\x00` never matches there.

   A compiled `Regex` owns its scratch (the thread lists, the capture slots
   and the explicit stack) and allocates it once, at `compile`; matching
   allocates nothing per input byte. That scratch is state a match writes, so
   every matching method takes the `Regex` exclusively (`var re = ...`). */

/// The longest pattern, in bytes, that `compile` accepts.
const MAX_PATTERN: int = 4096
/// How deeply groups may nest. A deeper pattern is refused.
const MAX_DEPTH: i32 = 100
/// The largest count that a counted repeat `{n,m}` may name.
const MAX_REPEAT: i32 = 1000
/// The most instructions that a compiled program may hold.
/// The compiled program may not exceed this many instructions (counted repeats
/// are expanded), and the scratch (instructions x capture slots) may not exceed
/// MAX_SCRATCH slots, which bounds a compiled regex to about 16 MiB.
const MAX_PROG: int = 50000
/// The most scratch slots (instructions times capture slots) that a compiled
/// regex may hold.
const MAX_SCRATCH: int = 2000000

/// Opcode: match the byte in `ax`.
const OP_CHAR: i32 = 0
/// Opcode: match the byte in `ax` ignoring ASCII case. `ax` holds the lowercase
/// byte.
const OP_CHARF: i32 = 1
/// Opcode: match any byte except a newline.
const OP_ANY: i32 = 2
/// Opcode: match any byte.
const OP_ANYALL: i32 = 3
/// Opcode: match a byte in the class whose bitmap starts at `ax` times 32.
const OP_CLASS: i32 = 4
/// Opcode: fork into two threads. `ax` is the first, higher priority, thread.
const OP_SPLIT: i32 = 5
/// Opcode: continue at the instruction `ax`.
const OP_JMP: i32 = 6
/// Opcode: record the current position in capture slot `ax`.
const OP_SAVE: i32 = 7
/// Opcode: continue only where the zero-width assertion `ax` holds.
const OP_ASSERT: i32 = 8
/// Opcode: the pattern has matched.
const OP_MATCH: i32 = 9

/// Node kind: a concatenation. `na` heads the chain of its children.
const N_CAT: i32 = 0
/// Node kind: an alternation. `na` heads the chain of its branches.
const N_ALT: i32 = 1
/// Node kind: a repeat of `na` with minimum `nb` and maximum `nc`, where -1
/// means no maximum. `nd` is 1 when greedy and 0 when lazy.
const N_REP: i32 = 2
/// Node kind: capture group number `nb` around `na`.
const N_GROUP: i32 = 3
/// Node kind: the literal byte `na`, folded to lowercase when `nb` is 1.
const N_BYTE: i32 = 4
/// Node kind: `.` without the `s` flag, which matches any byte but a newline.
const N_ANY: i32 = 5
/// Node kind: `.` with the `s` flag, which matches any byte.
const N_ANYALL: i32 = 6
/// Node kind: a character class, whose number is `na` in the class table.
const N_CLASS: i32 = 7
/// Node kind: the zero-width assertion `na`.
const N_ASSERT: i32 = 8

/// Assertion: the start of the text.
const A_BOL: i32 = 0
/// Assertion: the end of the text.
const A_EOL: i32 = 1
/// Assertion: the start of the text or just after a newline, for the `m` flag.
const A_BOL_M: i32 = 2
/// Assertion: the end of the text or just before a newline, for the `m` flag.
const A_EOL_M: i32 = 3
/// Assertion: a word boundary, as in `\b`.
const A_WORD: i32 = 4
/// Assertion: not a word boundary, as in `\B`.
const A_NWORD: i32 = 5

/// Flag bit: case-insensitive matching.
const F_I: i32 = 1
/// Flag bit: `.` also matches a newline.
const F_S: i32 = 2
/// Flag bit: `^` and `$` also match at newlines.
const F_M: i32 = 4

/// The error that `compile` returns for a pattern it refuses.
/// Why a pattern was refused: what is wrong with it, and the byte offset in the
/// pattern where the parser noticed.
datac RegexErr(
    /// What is wrong with the pattern, in words.
    val message: String,
    /// The byte offset in the pattern where the problem was noticed.
    val offset: int,
)

/// One match: the byte range `[start, end)` of the input and a copy of its
/// text.
/// One match: the byte range `[start, end)` of the input and a copy of its text.
datac Match(
    /// The byte offset where the match begins.
    val start: int,
    /// The byte offset just past the match.
    val end: int,
    /// The matched bytes, as a string.
    val text: String,
)

/// The groups of one match. Group 0 is the whole match.
/// The groups of one match. Group 0 is the whole match.
datac Captures(
    /// The text that was searched.
    val text: String,
    /// The start and end byte offsets of each group, two entries per group,
    /// with -1 for a group that did not take part.
    val slots: List<i32>,
)

/// The parser, the AST arena and the program under construction.
/// The parser, the AST arena and the program under construction. The AST is
/// held in parallel lists (a node is an index), and the children of a
/// concatenation or an alternation are a chain linked through `nnext`, so that
/// neither the parser nor the emitter recurses on anything but nesting depth.
datac Parser(
    /// The bytes of the pattern being parsed.
    val pat: List<u8>,
    /// The next byte to read.
    var pos: int,
    /// Whether a problem has been noted. Parsing then stops.
    var failed: bool,
    /// The message for the problem, once `failed` is set.
    var emsg: String,
    /// The byte offset of the problem.
    var eoff: int,
    /// The current group nesting depth.
    var depth: i32,
    /// The next capture group number. Group 0 is the whole match, so this
    /// starts at 1.
    var ncap: i32,
    /// The flags in force: `F_I`, `F_S` and `F_M` bits.
    var flags: i32,
    /// The node kind of each AST node.
    var nk: List<i32>,
    /// The first operand of each AST node: a child, a class number or a value,
    /// by kind.
    var na: List<i32>,
    /// The second operand of each AST node.
    var nb: List<i32>,
    /// The third operand of each AST node.
    var nc: List<i32>,
    /// The fourth operand of each AST node.
    var nd: List<i32>,
    /// The next sibling in a concatenation or alternation chain, or -1 at the
    /// end.
    var nnext: List<i32>,
    /// The bitmaps of the character classes, 32 bytes (256 bits) each.
    var classes: List<u8>,
    /// The opcode of each compiled instruction.
    var op: List<i32>,
    /// The first operand of each compiled instruction.
    var ax: List<i32>,
    /// The second operand of each compiled instruction.
    var ay: List<i32>
)

/// A compiled pattern with its reusable scratch.
/// A compiled pattern with its reusable scratch.
datac Regex(
    /// The opcode of each instruction.
    val op: List<i32>,
    /// The first operand of each instruction.
    val ax: List<i32>,
    /// The second operand of each instruction.
    val ay: List<i32>,
    /// The bitmaps of the character classes, 32 bytes each.
    val classes: List<u8>,
    /// The number of capture groups, including group 0.
    val ngroups: int,
    /// Scratch: the program counters of the two thread lists.
    var tl_pc: List<i32>,
    /// Scratch: the capture slots of each thread in the thread lists.
    var tl_cap: List<i32>,
    /// Scratch: how many threads each thread list holds.
    var cnt: List<int>,
    /// Scratch: the generation in which each instruction was last added to a
    /// list.
    var mark: List<i64>,
    /// Scratch: the current generation. Bumping it clears `mark` without a
    /// sweep.
    var gen: i64,
    /// Scratch: the explicit stack of `add_thread`, holding instructions and
    /// capture restores.
    var stk_a: List<i32>,
    /// Scratch: the saved slot values on the stack of `add_thread`.
    var stk_b: List<i32>,
    /// Scratch: the capture slots of the thread being advanced.
    var wcap: List<i32>,
    /// The capture slots of the last match, with -1 where a slot is unset.
    var res: List<i32>,
    /// The VM steps taken so far. See `steps`.
    var nsteps: i64
)

/// Whether `b` is an ASCII letter, digit or underscore, the bytes that `\w`
/// matches.
fun is_word_byte(b: u8) => bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
}

/// Whether `b` is ASCII white space: a space, or a byte from tab to carriage
/// return.
fun is_space_byte(b: u8) => bool {
    return b == 32 || (b >= 9 && b <= 13)
}

/// The value of the hexadecimal digit `c`, or -1 when `c` is not one.
fun hex_value(c: u8) => i32 {
    if c >= '0' && c <= '9' {
        return (c - '0').to_i32()
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a').to_i32() + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A').to_i32() + 10
    }
    return -1
}

/// Whether `c` begins a repeat operator: `*`, `+`, `?` or `{`.
fun is_quant_byte(c: u8) => bool = c == '*' || c == '+' || c == '?' || c == '{'

// ---------------------------------------------------------------------------
// Parser

/// Notes the first problem, with its message and byte offset. Later calls
/// change nothing.
fun mut Parser.fail(msg: &str, off: int) {
    if !failed {
        failed = true
        emsg = String.from_str(msg)
        eoff = off
    }
}

/// Adds an AST node with the given kind and operands, and returns its index.
fun mut Parser.node(kind: i32, a: i32, b: i32, c: i32, d: i32) => i32 {
    nk.push(kind)
    na.push(a)
    nb.push(b)
    nc.push(c)
    nd.push(d)
    nnext.push(-1)
    return (nk.len() - 1).to_i32()
}

/// Adds an empty character class and returns its number.
fun mut Parser.new_class() => i32 {
    val idx = classes.len() / 32
    var i: int = 0
    while i < 32 {
        classes.push(0)
        i += 1
    }
    return idx.to_i32()
}

/// Sets bit `b` in the class whose bitmap starts at byte `base`.
fun mut Parser.set_bit(base: int, b: int) {
    val at = base + (b >> 3)
    val m: u8 = 1 << (b & 7).to_byte()
    classes.set(at, classes.get(at) | m)
}

/// Whether bit `b` is set in the class whose bitmap starts at byte `base`.
fun Parser.has_bit(base: int, b: int) => bool {
    val m: u8 = 1 << (b & 7).to_byte()
    return classes.get(base + (b >> 3)) & m != 0
}

/// Adds the bytes of one predefined class (`d`, `w` or `s`, or the complement
/// when `negate` is set) to a class.
/// Adds the bytes of `\d`, `\w` or `\s` (`kind` is the letter), or of the
/// complement for `\D \W \S`, to the class at `base`.
fun mut Parser.add_pred(base: int, kind: u8, negate: bool) {
    var b: int = 0
    while b < 256 {
        val c = b.to_byte()
        var p = false
        if kind == 'd' {
            p = c >= '0' && c <= '9'
        } else if kind == 'w' {
            p = is_word_byte(c)
        } else {
            p = is_space_byte(c)
        }
        if p != negate {
            self.set_bit(base, b)
        }
        b += 1
    }
}

/// Adds the other case of every ASCII letter in the class at `base`, so
/// matching ignores case.
/// An ASCII case fold of a finished class: every letter whose other case is in
/// the class gets added.
fun mut Parser.fold_class(base: int) {
    var c: int = 97
    while c <= 122 {
        if self.has_bit(base, c) || self.has_bit(base, c - 32) {
            self.set_bit(base, c)
            self.set_bit(base, c - 32)
        }
        c += 1
    }
}

/// Complements the class at `base`, so a byte it held is dropped and any other
/// is added.
fun mut Parser.invert_class(base: int) {
    var i: int = 0
    while i < 32 {
        classes.set(base + i, ~classes.get(base + i))
        i += 1
    }
}

/// The byte that the escape at `at` stands for. -2 means the escape is not a
/// single byte, and -1 means a failure.
/// The byte an escape that is a single byte stands for, after the backslash at
/// `at`; -1 when it is not one (the caller decides what that means). Leaves
/// `pos` just past what it consumed. `in_class` allows only what a class may
/// hold.
fun mut Parser.escape_byte(at: int) => i32 {
    val n = pat.len()
    if at + 1 >= n {
        self.fail("trailing backslash", at)
        return -1
    }
    val c = pat.get(at + 1)
    if c == 'n' {
        pos = at + 2
        return 10
    }
    if c == 'r' {
        pos = at + 2
        return 13
    }
    if c == 't' {
        pos = at + 2
        return 9
    }
    if c == 'x' {
        if at + 3 < n && hex_value(pat.get(at + 2)) >= 0 && hex_value(pat.get(at + 3)) >= 0 {
            pos = at + 4
            return hex_value(pat.get(at + 2)) * 16 + hex_value(pat.get(at + 3))
        }
        self.fail("invalid \\x escape: two hexadecimal digits are required", at)
        return -1
    }
    if c >= '1' && c <= '9' {
        self.fail("backreferences are not supported", at)
        return -1
    }
    // An escaped punctuation byte is that byte.
    if c < 128 && !is_word_byte(c) && c > 32 && c < 127 {
        pos = at + 2
        return c.to_i32()
    }
    return -2
}

/// Notes the failure for the unknown escape at `at`, and names it in the
/// message.
fun mut Parser.bad_escape(at: int) {
    val c = pat.get(at + 1)
    var msg = String.from_str("invalid escape '\\")
    if c >= 32 && c < 127 {
        msg.push(c)
    } else {
        msg.push_str("?")
    }
    msg.push_str("'")
    self.fail(msg.as_str(), at)
}

/// Reads one item of a class at `pos` and returns its byte. Returns -1 when the
/// item was a predefined set that was added directly.
/// One item of a character class: a byte (0..255), or -1 when it was a `\d`-style
/// set that has been added to the class directly (or on failure).
fun mut Parser.class_atom(base: int) => i32 {
    val at = pos
    val c = pat.get(at)
    if c != '\\' {
        pos = at + 1
        return c.to_i32()
    }
    if at + 1 < pat.len() {
        val e = pat.get(at + 1)
        if e == 'd' || e == 'w' || e == 's' {
            self.add_pred(base, e, false)
            pos = at + 2
            return -1
        }
        if e == 'D' || e == 'W' || e == 'S' {
            self.add_pred(base, e + 32, true)
            pos = at + 2
            return -1
        }
    }
    val b = self.escape_byte(at)
    if b == -2 {
        self.bad_escape(at)
        return -1
    }
    return b
}

/// Parses a bracketed class that starts at `pos`, and returns its node or -1 on
/// failure.
fun mut Parser.parse_class() => i32 {
    val n = pat.len()
    val open = pos
    pos += 1
    var neg = false
    if pos < n && pat.get(pos) == '^' {
        neg = true
        pos += 1
    }
    val ci = self.new_class()
    val base = ci.to_int() * 32
    var first = true
    var done = false
    while !done && !failed {
        if pos >= n {
            self.fail("unclosed character class", open)
        } else if pat.get(pos) == ']' && !first {
            pos += 1
            done = true
        } else {
            first = false
            val lo = self.class_atom(base)
            if !failed && lo >= 0 {
                if pos + 1 < n && pat.get(pos) == '-' && pat.get(pos + 1) != ']' {
                    pos += 1
                    val hi = self.class_atom(base)
                    if !failed {
                        if hi < 0 || hi < lo {
                            self.fail("invalid character class range", open)
                        } else {
                            var x = lo
                            while x <= hi {
                                self.set_bit(base, x.to_int())
                                x += 1
                            }
                        }
                    }
                } else {
                    self.set_bit(base, lo.to_int())
                }
            }
        }
    }
    if failed {
        return -1
    }
    if flags & F_I != 0 {
        self.fold_class(base)
    }
    if neg {
        self.invert_class(base)
    }
    return self.node(N_CLASS, ci, 0, 0, 0)
}

/// Parses an escape that is outside a class, and returns its node or -1 on
/// failure.
fun mut Parser.parse_escape() => i32 {
    val at = pos
    val n = pat.len()
    if at + 1 >= n {
        self.fail("trailing backslash", at)
        return -1
    }
    val c = pat.get(at + 1)
    if c == 'd' || c == 'w' || c == 's' || c == 'D' || c == 'W' || c == 'S' {
        val ci = self.new_class()
        if c >= 'a' {
            self.add_pred(ci.to_int() * 32, c, false)
        } else {
            self.add_pred(ci.to_int() * 32, c + 32, true)
        }
        pos = at + 2
        return self.node(N_CLASS, ci, 0, 0, 0)
    }
    if c == 'b' {
        pos = at + 2
        return self.node(N_ASSERT, A_WORD, 0, 0, 0)
    }
    if c == 'B' {
        pos = at + 2
        return self.node(N_ASSERT, A_NWORD, 0, 0, 0)
    }
    val b = self.escape_byte(at)
    if b == -2 {
        self.bad_escape(at)
        return -1
    }
    if b < 0 {
        return -1
    }
    return self.byte_node(b.to_byte())
}

/// Makes the node for the literal byte `b`.
/// A literal byte, folded when the case-insensitive flag is on.
fun mut Parser.byte_node(b: u8) => i32 {
    var f: i32 = 0
    var v = b
    if flags & F_I != 0 {
        if b >= 'A' && b <= 'Z' {
            v = b + 32
            f = 1
        } else if b >= 'a' && b <= 'z' {
            f = 1
        }
    }
    return self.node(N_BYTE, v.to_i32(), f, 0, 0)
}

/// Parses a group that starts at `(`. Returns its node, -2 for a flag group, or
/// -1 on failure.
/// `(` ... `)`. Returns a node, or -2 for a flag group `(?i)` that makes no
/// node, or -1 on failure.
fun mut Parser.parse_group() => i32 {
    val n = pat.len()
    val open = pos
    pos += 1
    var cap: i32 = -1
    val saved = flags
    var scoped = false
    if pos < n && pat.get(pos) == '?' {
        if pos + 1 >= n {
            self.fail("unclosed group", open)
            return -1
        }
        val c = pat.get(pos + 1)
        if c == ':' {
            pos += 2
        } else if c == '=' || c == '!' {
            self.fail("lookaround is not supported", open)
            return -1
        } else if c == '<' {
            if pos + 2 < n && (pat.get(pos + 2) == '=' || pat.get(pos + 2) == '!') {
                self.fail("lookaround is not supported", open)
            } else {
                self.fail("named groups are not supported", open)
            }
            return -1
        } else if c == 'P' {
            self.fail("named groups are not supported", open)
            return -1
        } else {
            // A flag group: letters, then `)` (flags for the rest of the
            // enclosing group) or `:` (flags for this group only).
            pos += 1
            var f = flags
            var more = true
            while more && !failed {
                if pos >= n {
                    self.fail("unclosed group", open)
                } else {
                    val l = pat.get(pos)
                    if l == 'i' {
                        f = f | F_I
                        pos += 1
                    } else if l == 's' {
                        f = f | F_S
                        pos += 1
                    } else if l == 'm' {
                        f = f | F_M
                        pos += 1
                    } else if l == ')' || l == ':' {
                        more = false
                    } else {
                        var msg = String.from_str("unknown group flag '")
                        if l >= 32 && l < 127 {
                            msg.push(l)
                        } else {
                            msg.push_str("?")
                        }
                        msg.push_str("'")
                        self.fail(msg.as_str(), pos)
                    }
                }
            }
            if failed {
                return -1
            }
            if pat.get(pos) == ')' {
                pos += 1
                flags = f
                return -2
            }
            pos += 1
            flags = f
            scoped = true
        }
    } else {
        cap = ncap
        ncap += 1
    }
    if depth + 1 > MAX_DEPTH {
        self.fail("nesting is too deep (limit 100)", open)
        return -1
    }
    depth += 1
    val inner = self.parse_alt()
    depth -= 1
    if failed {
        return -1
    }
    if pos >= n || pat.get(pos) != ')' {
        self.fail("unclosed group", open)
        return -1
    }
    pos += 1
    flags = saved
    if cap < 0 {
        return inner
    }
    return self.node(N_GROUP, inner, cap, 0, 0)
}

/// Reads a decimal number at `pos`, capped at 100000, and returns it.
fun mut Parser.parse_number() => i32 {
    var v: i32 = 0
    val n = pat.len()
    while pos < n && pat.get(pos) >= '0' && pat.get(pos) <= '9' {
        if v < 100000 {
            v = v * 10 + (pat.get(pos) - '0').to_i32()
        }
        pos += 1
    }
    return v
}

/// Applies a repeat operator after `atom`, if one follows, and returns the
/// repeat node.
/// The repeat operators after an atom.
fun mut Parser.parse_quant(atom: i32) => i32 {
    val n = pat.len()
    if pos >= n {
        return atom
    }
    val at = pos
    val c = pat.get(pos)
    var mn: i32 = 0
    var mx: i32 = -1
    if c == '*' {
        pos += 1
    } else if c == '+' {
        mn = 1
        pos += 1
    } else if c == '?' {
        mx = 1
        pos += 1
    } else if c == '{' {
        pos += 1
        if pos >= n || pat.get(pos) < '0' || pat.get(pos) > '9' {
            self.fail("invalid repeat: expected {n}, {n,} or {n,m}", at)
            return -1
        }
        mn = self.parse_number()
        mx = mn
        if pos < n && pat.get(pos) == ',' {
            pos += 1
            if pos < n && pat.get(pos) >= '0' && pat.get(pos) <= '9' {
                mx = self.parse_number()
            } else {
                mx = -1
            }
        }
        if pos >= n || pat.get(pos) != '}' {
            self.fail("invalid repeat: expected {n}, {n,} or {n,m}", at)
            return -1
        }
        pos += 1
        if mn > MAX_REPEAT || mx > MAX_REPEAT {
            self.fail("repeat count is too large (limit 1000)", at)
            return -1
        }
        if mx >= 0 && mx < mn {
            self.fail("invalid repeat: the lower bound is greater than the upper bound", at)
            return -1
        }
    } else {
        return atom
    }
    var greedy: i32 = 1
    if pos < n && pat.get(pos) == '?' {
        greedy = 0
        pos += 1
    }
    if pos < n && is_quant_byte(pat.get(pos)) {
        self.fail("nested repetition operator", pos)
        return -1
    }
    return self.node(N_REP, atom, mn, mx, greedy)
}

/// Parses one atom at `pos`: a group, class, escape, anchor, `.` or literal
/// byte.
/// One atom, or -2 for a flag group, or -1 on failure.
fun mut Parser.parse_atom() => i32 {
    val n = pat.len()
    val c = pat.get(pos)
    if c == '(' {
        return self.parse_group()
    }
    if c == '[' {
        return self.parse_class()
    }
    if c == '\\' {
        return self.parse_escape()
    }
    if c == '.' {
        pos += 1
        if flags & F_S != 0 {
            return self.node(N_ANYALL, 0, 0, 0, 0)
        }
        return self.node(N_ANY, 0, 0, 0, 0)
    }
    if c == '^' {
        pos += 1
        if flags & F_M != 0 {
            return self.node(N_ASSERT, A_BOL_M, 0, 0, 0)
        }
        return self.node(N_ASSERT, A_BOL, 0, 0, 0)
    }
    if c == '$' {
        pos += 1
        if flags & F_M != 0 {
            return self.node(N_ASSERT, A_EOL_M, 0, 0, 0)
        }
        return self.node(N_ASSERT, A_EOL, 0, 0, 0)
    }
    if is_quant_byte(c) {
        self.fail("nothing to repeat", pos)
        return -1
    }
    pos += 1
    if c >= 192 {
        // A multi-byte UTF-8 character is one atom: its bytes in sequence.
        val first = self.byte_node(c)
        var last = first
        val head = self.node(N_CAT, first, 0, 0, 0)
        while pos < n && pat.get(pos) >= 128 && pat.get(pos) < 192 {
            val nx = self.byte_node(pat.get(pos))
            nnext.set(last.to_int(), nx)
            last = nx
            pos += 1
        }
        return head
    }
    return self.byte_node(c)
}

/// Parses a concatenation up to a `|`, a `)` or the end, and returns its node.
fun mut Parser.parse_cat() => i32 {
    val n = pat.len()
    val head = self.node(N_CAT, -1, 0, 0, 0)
    var last: i32 = -1
    var go = true
    while go && pos < n && !failed {
        val c = pat.get(pos)
        if c == '|' || c == ')' {
            go = false
        } else {
            var atom = self.parse_atom()
            if !failed && atom != -2 {
                atom = self.parse_quant(atom)
            }
            if !failed && atom >= 0 {
                if last < 0 {
                    na.set(head.to_int(), atom)
                } else {
                    nnext.set(last.to_int(), atom)
                }
                last = atom
            }
        }
    }
    return head
}

/// Parses alternatives separated by `|`, and returns the node for them.
fun mut Parser.parse_alt() => i32 {
    val n = pat.len()
    val first = self.parse_cat()
    if failed {
        return -1
    }
    if pos < n && pat.get(pos) == '|' {
        var tail = first
        while pos < n && pat.get(pos) == '|' && !failed {
            pos += 1
            val nx = self.parse_cat()
            nnext.set(tail.to_int(), nx)
            tail = nx
        }
        if failed {
            return -1
        }
        return self.node(N_ALT, first, 0, 0, 0)
    }
    return first
}

// ---------------------------------------------------------------------------
// Code generation

/// Appends an instruction and returns its index. Fails when the program is too
/// large.
fun mut Parser.emit(o: i32, x: i32, y: i32) => int {
    if op.len() >= MAX_PROG {
        self.fail("pattern is too large (the compiled program is limited to 50000 instructions)", 0)
        return 0
    }
    op.push(o)
    ax.push(x)
    ay.push(y)
    return op.len() - 1
}

/// Appends an instruction and ignores its index.
/// `emit` for a caller that does not need the instruction's index.
fun mut Parser.put(o: i32, x: i32, y: i32) {
    val at = self.emit(o, x, y)
}

/// Points the split at `s` to its body and its exit. The body is the first
/// choice when `greedy` is set.
fun mut Parser.set_split(s: int, body: int, out: int, greedy: bool) {
    if greedy {
        ax.set(s, body.to_i32())
        ay.set(s, out.to_i32())
    } else {
        ax.set(s, out.to_i32())
        ay.set(s, body.to_i32())
    }
}

/// Emits the code for the repeat node `n`: its required copies, then the
/// optional or unbounded tail.
fun mut Parser.emit_rep(n: int) {
    val c = na.get(n)
    val mn = nb.get(n)
    val mx = nc.get(n)
    val greedy = nd.get(n) == 1
    var i: i32 = 0
    if mx == -1 {
        if mn == 0 {
            val s = self.emit(OP_SPLIT, 0, 0)
            self.emit_node(c)
            self.put(OP_JMP, s.to_i32(), 0)
            self.set_split(s, s + 1, op.len(), greedy)
        } else {
            while i < mn - 1 && !failed {
                self.emit_node(c)
                i += 1
            }
            val start = op.len()
            self.emit_node(c)
            val s = self.emit(OP_SPLIT, 0, 0)
            self.set_split(s, start, s + 1, greedy)
        }
    } else {
        while i < mn && !failed {
            self.emit_node(c)
            i += 1
        }
        var ss: List<int> = List.empty()
        i = mn
        while i < mx && !failed {
            val s = self.emit(OP_SPLIT, 0, 0)
            ss.push(s)
            self.emit_node(c)
            i += 1
        }
        val end = op.len()
        var k: int = 0
        while k < ss.len() {
            self.set_split(ss.get(k), ss.get(k) + 1, end, greedy)
            k += 1
        }
    }
}

/// Emits the code for the AST node `n`.
fun mut Parser.emit_node(n: i32) {
    if failed {
        return
    }
    val i = n.to_int()
    val k = nk.get(i)
    if k == N_CAT {
        var c = na.get(i)
        while c >= 0 && !failed {
            self.emit_node(c)
            c = nnext.get(c.to_int())
        }
    } else if k == N_ALT {
        var js: List<int> = List.empty()
        var alt = na.get(i)
        while alt >= 0 && !failed {
            val nx = nnext.get(alt.to_int())
            if nx >= 0 {
                val s = self.emit(OP_SPLIT, 0, 0)
                ax.set(s, (s + 1).to_i32())
                self.emit_node(alt)
                js.push(self.emit(OP_JMP, 0, 0))
                ay.set(s, op.len().to_i32())
            } else {
                self.emit_node(alt)
            }
            alt = nx
        }
        val end = op.len().to_i32()
        var q: int = 0
        while q < js.len() {
            ax.set(js.get(q), end)
            q += 1
        }
    } else if k == N_REP {
        self.emit_rep(i)
    } else if k == N_GROUP {
        val slot = nb.get(i) * 2
        self.put(OP_SAVE, slot, 0)
        self.emit_node(na.get(i))
        self.put(OP_SAVE, slot + 1, 0)
    } else if k == N_BYTE {
        if nb.get(i) == 1 {
            self.put(OP_CHARF, na.get(i), 0)
        } else {
            self.put(OP_CHAR, na.get(i), 0)
        }
    } else if k == N_ANY {
        self.put(OP_ANY, 0, 0)
    } else if k == N_ANYALL {
        self.put(OP_ANYALL, 0, 0)
    } else if k == N_CLASS {
        self.put(OP_CLASS, na.get(i), 0)
    } else {
        self.put(OP_ASSERT, na.get(i), 0)
    }
}

/// Returns the error result for a pattern refused with `msg` at byte `off`.
fun refuse(msg: &str, off: int) => result.Result<Regex, RegexErr> {
    return result.Result.Err(error = RegexErr(message = String.from_str(msg), offset = off))
}

/// Parses and compiles a pattern into a `Regex`.
/// Compiles `pattern`. The error carries the message and the byte offset of the
/// problem. A pattern longer than 4096 bytes, nested deeper than 100 groups, with
/// a counted repeat above 1000, with a backreference or lookaround, or too large
/// once its repeats are expanded, is refused.
fun compile(pattern: &str) => result.Result<Regex, RegexErr> {
    val pv = pattern.view()
    val n = pv.len()
    if n > MAX_PATTERN {
        return refuse("pattern is too long (limit 4096 bytes)", MAX_PATTERN)
    }
    var p = Parser(
        pat = List.empty(),
        pos = 0,
        failed = false,
        emsg = String.empty(),
        eoff = 0,
        depth = 0,
        ncap = 1,
        flags = 0,
        nk = List.empty(),
        na = List.empty(),
        nb = List.empty(),
        nc = List.empty(),
        nd = List.empty(),
        nnext = List.empty(),
        classes = List.empty(),
        op = List.empty(),
        ax = List.empty(),
        ay = List.empty()
    )
    var i: int = 0
    while i < n {
        p.pat.push(pv.get(i))
        i += 1
    }
    val root = p.parse_alt()
    if !p.failed && p.pos < n {
        p.fail("unmatched ')'", p.pos)
    }
    if !p.failed {
        p.put(OP_SAVE, 0, 0)
        p.emit_node(root)
        p.put(OP_SAVE, 1, 0)
        p.put(OP_MATCH, 0, 0)
    }
    if p.failed {
        return result.Result.Err(error = RegexErr(message = p.emsg.clone(), offset = p.eoff))
    }
    val np = p.op.len()
    val ng = p.ncap.to_int()
    val nslots = ng * 2
    if np * nslots > MAX_SCRATCH {
        return refuse("pattern is too large (instructions x capture slots over the 2000000 limit)", 0)
    }
    var tl_pc: List<i32> = List.empty()
    var mark: List<i64> = List.empty()
    var stk_a: List<i32> = List.empty()
    var stk_b: List<i32> = List.empty()
    i = 0
    while i < np * 2 {
        tl_pc.push(0)
        i += 1
    }
    i = 0
    while i < np {
        mark.push(0)
        i += 1
    }
    i = 0
    while i < np * 2 + 8 {
        stk_a.push(0)
        stk_b.push(0)
        i += 1
    }
    var tl_cap: List<i32> = List.empty()
    i = 0
    while i < np * 2 * nslots {
        tl_cap.push(-1)
        i += 1
    }
    var wcap: List<i32> = List.empty()
    var res: List<i32> = List.empty()
    i = 0
    while i < nslots {
        wcap.push(-1)
        res.push(-1)
        i += 1
    }
    var cnt: List<int> = List.empty()
    cnt.push(0)
    cnt.push(0)
    val re = Regex(
        op = p.op,
        ax = p.ax,
        ay = p.ay,
        classes = p.classes,
        ngroups = ng,
        tl_pc = tl_pc,
        tl_cap = tl_cap,
        cnt = cnt,
        mark = mark,
        gen = 0,
        stk_a = stk_a,
        stk_b = stk_b,
        wcap = wcap,
        res = res,
        nsteps = 0
    )
    return result.Result.Ok(value = re)
}

// ---------------------------------------------------------------------------
// The Pike VM

/// Whether the zero-width assertion `kind` holds at byte `pos` of `text`.
fun Regex.assert_ok(kind: i32, text: View, pos: int) => bool {
    val n = text.len()
    if kind == A_BOL {
        return pos == 0
    }
    if kind == A_EOL {
        return pos == n
    }
    if kind == A_BOL_M {
        return pos == 0 || text.get(pos - 1) == 10
    }
    if kind == A_EOL_M {
        return pos == n || text.get(pos) == 10
    }
    var before = false
    var after = false
    if pos > 0 {
        before = is_word_byte(text.get(pos - 1))
    }
    if pos < n {
        after = is_word_byte(text.get(pos))
    }
    if kind == A_WORD {
        return before != after
    }
    return before == after
}

/// Adds a thread at `pc0` to a list, following every zero-width instruction on
/// the way.
/// Adds the thread at `pc0` and everything reachable from it without consuming
/// a byte to the list `side`, in priority order. The thread's captures are in
/// `wcap` and are the same when the call returns. Iterative: the stack holds
/// explore entries (pc >= 0) and capture restores (a < 0: slot -a-1 gets the
/// value in `stk_b`), and each instruction is expanded once per list.
fun mut Regex.add_thread(side: int, pc0: i32, pos: int, text: View, nsl: int) {
    val np = op.len()
    stk_a.set(0, pc0)
    stk_b.set(0, 0)
    var sp: int = 1
    while sp > 0 {
        sp -= 1
        val a = stk_a.get(sp)
        if a < 0 {
            wcap.set((0 - a - 1).to_int(), stk_b.get(sp))
        } else {
            val pc = a.to_int()
            if mark.get(pc) != gen {
                mark.set(pc, gen)
                nsteps += 1
                val o = op.get(pc)
                if o == OP_JMP {
                    stk_a.set(sp, ax.get(pc))
                    sp += 1
                } else if o == OP_SPLIT {
                    stk_a.set(sp, ay.get(pc))
                    sp += 1
                    stk_a.set(sp, ax.get(pc))
                    sp += 1
                } else if o == OP_SAVE {
                    val slot = ax.get(pc).to_int()
                    if slot < nsl {
                        stk_a.set(sp, -1 - slot.to_i32())
                        stk_b.set(sp, wcap.get(slot))
                        sp += 1
                        wcap.set(slot, pos.to_i32())
                    }
                    stk_a.set(sp, pc.to_i32() + 1)
                    sp += 1
                } else if o == OP_ASSERT {
                    if self.assert_ok(ax.get(pc), text, pos) {
                        stk_a.set(sp, pc.to_i32() + 1)
                        sp += 1
                    }
                } else {
                    val j = cnt.get(side)
                    val slot = side * np + j
                    tl_pc.set(slot, pc.to_i32())
                    var k: int = 0
                    while k < nsl {
                        tl_cap.set(slot * nsl + k, wcap.get(k))
                        k += 1
                    }
                    cnt.set(side, j + 1)
                }
            }
        }
    }
}

/// Runs the program over `text` from byte `start`, and reports whether it
/// matched.
/// Runs the program over `text` from byte `start`, unanchored at the start. True
/// when there is a match, whose first `nsl` capture slots are then in `res`.
/// `early` stops at the first match found (enough for a yes/no answer).
fun mut Regex.run(text: View, start: int, nsl: int, early: bool) => bool {
    val n = text.len()
    val np = op.len()
    gen += 1
    cnt.set(0, 0)
    cnt.set(1, 0)
    var side: int = 0
    var matched = false
    var pos = start
    var running = true
    while running {
        if !matched {
            var k: int = 0
            while k < nsl {
                wcap.set(k, -1)
                k += 1
            }
            self.add_thread(side, 0, pos, text, nsl)
        }
        val cn = cnt.get(side)
        if matched && cn == 0 {
            running = false
        } else {
            val nside = 1 - side
            gen += 1
            cnt.set(nside, 0)
            var c: i32 = -1
            if pos < n {
                c = text.get(pos).to_i32()
            }
            var j: int = 0
            while j < cn {
                nsteps += 1
                val slot = side * np + j
                val pc = tl_pc.get(slot).to_int()
                val o = op.get(pc)
                if o == OP_MATCH {
                    var k: int = 0
                    while k < nsl {
                        res.set(k, tl_cap.get(slot * nsl + k))
                        k += 1
                    }
                    matched = true
                    // Every thread after this one has lower priority: drop them.
                    j = cn
                } else {
                    var ok = false
                    if c >= 0 {
                        if o == OP_CHAR {
                            ok = c == ax.get(pc)
                        } else if o == OP_CHARF {
                            ok = (c | 32) == ax.get(pc)
                        } else if o == OP_ANY {
                            ok = c != 10
                        } else if o == OP_ANYALL {
                            ok = true
                        } else {
                            val bit: u8 = 1 << (c & 7).to_byte()
                            ok = classes.get(ax.get(pc).to_int() * 32 + (c >> 3).to_int()) & bit != 0
                        }
                    }
                    if ok {
                        var k: int = 0
                        while k < nsl {
                            wcap.set(k, tl_cap.get(slot * nsl + k))
                            k += 1
                        }
                        self.add_thread(nside, pc.to_i32() + 1, pos + 1, text, nsl)
                    }
                    j += 1
                }
            }
            side = nside
            if early && matched {
                running = false
            } else if pos >= n {
                running = false
            } else {
                pos += 1
            }
        }
    }
    return matched
}

// ---------------------------------------------------------------------------
// The API

/// The VM steps taken since `compile` or the last `reset_steps`.
/// The number of VM steps taken since `compile` or the last `reset_steps`: one
/// per instruction expanded and one per thread advanced. It is the measure of
/// work the linearity tests assert on.
fun Regex.steps() => i64 = nsteps

/// Retired (#375): the camelCase `resetSteps` is the name. Kept for one cycle.
fun mut Regex.reset_steps() { self.resetSteps() }

/// Sets the VM step count back to zero.
fun mut Regex.resetSteps() {
    nsteps = 0
}

/// Retired (#375): the camelCase `groupCount` is the name. Kept for one cycle.
fun Regex.group_count() => int = self.groupCount()

/// The number of capture groups, not counting group 0.
/// The number of capture groups, not counting group 0 (the whole match).
fun Regex.groupCount() => int = ngroups - 1

/// Retired (#375): the camelCase `isMatch` is the name. Kept for one cycle.
fun mut Regex.is_match(text: &str) => bool = self.isMatch(text)

/// Whether the pattern matches anywhere in `text`.
/// Whether the pattern matches anywhere in `text`.
fun mut Regex.isMatch(text: &str) => bool {
    return self.run(text.view(), 0, 2, true)
}

/// Retired (#375): the camelCase `findAt` is the name. Kept for one cycle.
fun mut Regex.find_at(text: &str, start: int) => option.Option<Match> = self.findAt(text, start)

/// The leftmost match at or after byte `start`, if any.
/// The leftmost match at or after byte `start`, if any. `^` and `\b` still look
/// at the whole text, so a search that resumes mid-text sees its true context.
fun mut Regex.findAt(text: &str, start: int) => option.Option<Match> {
    val tv = text.view()
    if start > tv.len() {
        return option.Option.None
    }
    if !self.run(tv, start, 2, false) {
        return option.Option.None
    }
    val s = res.get(0).to_int()
    val e = res.get(1).to_int()
    return option.Option.Some(value = Match(start = s, end = e, text = tv.slice(s, e).to_string()))
}

/// The leftmost match in `text`, if any.
fun mut Regex.find(text: &str) => option.Option<Match> {
    return self.findAt(text, 0)
}

/// The leftmost match in `text`, with the span of every group.
/// The leftmost match with every group's span, if any.
fun mut Regex.captures(text: &str) => option.Option<Captures> {
    val tv = text.view()
    val nsl = ngroups * 2
    if !self.run(tv, 0, nsl, false) {
        return option.Option.None
    }
    var slots: List<i32> = List.empty()
    var k: int = 0
    while k < nsl {
        slots.push(res.get(k))
        k += 1
    }
    return option.Option.Some(value = Captures(text = tv.to_string(), slots = slots))
}

/// Retired (#375): the camelCase `findAll` is the name. Kept for one cycle.
fun mut Regex.find_all(text: &str) => List<Match> = self.findAll(text)

/// Every non-overlapping match in `text`, from left to right.
/// Every non-overlapping match, left to right. After an empty match the search
/// resumes one byte further on, so the result is finite.
fun mut Regex.findAll(text: &str) => List<Match> {
    val tv = text.view()
    val n = tv.len()
    var out: List<Match> = List.empty()
    var pos: int = 0
    while pos <= n {
        if self.run(tv, pos, 2, false) {
            val s = res.get(0).to_int()
            val e = res.get(1).to_int()
            out.push(Match(start = s, end = e, text = tv.slice(s, e).to_string()))
            if e == s {
                pos = e + 1
            } else {
                pos = e
            }
        } else {
            pos = n + 1
        }
    }
    return out
}

/// Appends the replacement template `rep` to `out`, with groups taken from the
/// match in `res`.
/// Appends the replacement template `rep` for the match in `res`: `$0`..`$9` is
/// that group's text (nothing when it did not take part or does not exist),
/// `$$` is a dollar sign, and any other `$` is literal.
fun Regex.expand(out: mut String, tv: View, rep: View, nsl: int) {
    val m = rep.len()
    var i: int = 0
    while i < m {
        val c = rep.get(i)
        if c == '$' && i + 1 < m {
            val d = rep.get(i + 1)
            if d == '$' {
                out.push('$')
                i += 2
            } else if d >= '0' && d <= '9' {
                val g = (d - '0').to_int()
                if g * 2 + 1 < nsl {
                    val s = res.get(g * 2)
                    val e = res.get(g * 2 + 1)
                    if s >= 0 && e >= s {
                        var q = s.to_int()
                        while q < e.to_int() {
                            out.push(tv.get(q))
                            q += 1
                        }
                    }
                }
                i += 2
            } else {
                out.push(c)
                i += 1
            }
        } else {
            out.push(c)
            i += 1
        }
    }
}

/// Replaces the first match in `text`, or every match when `all` is set.
fun mut Regex.replace_impl(text: &str, replacement: &str, all: bool) => String {
    val tv = text.view()
    val rv = replacement.view()
    val n = tv.len()
    var nsl: int = 2
    var i: int = 0
    while i + 1 < rv.len() {
        if rv.get(i) == '$' && rv.get(i + 1) >= '0' && rv.get(i + 1) <= '9' {
            nsl = ngroups * 2
        }
        i += 1
    }
    var out = String.with_capacity(n)
    var last: int = 0
    var pos: int = 0
    while pos <= n {
        if self.run(tv, pos, nsl, false) {
            val s = res.get(0).to_int()
            val e = res.get(1).to_int()
            var q = last
            while q < s {
                out.push(tv.get(q))
                q += 1
            }
            self.expand(out, tv, rv, nsl)
            last = e
            if e == s {
                pos = e + 1
            } else {
                pos = e
            }
            if !all {
                pos = n + 1
            }
        } else {
            pos = n + 1
        }
    }
    var q = last
    while q < n {
        out.push(tv.get(q))
        q += 1
    }
    return out
}

/// Replaces the first match in `text`.
/// `text` with the first match replaced by `replacement` (see `expand` for `$1`).
fun mut Regex.replace(text: &str, replacement: &str) => String {
    return self.replace_impl(text, replacement, false)
}

/// Retired (#375): the camelCase `replaceAll` is the name. Kept for one cycle.
fun mut Regex.replace_all(text: &str, replacement: &str) => String = self.replaceAll(text, replacement)

/// Replaces every match in `text`.
fun mut Regex.replaceAll(text: &str, replacement: &str) => String {
    return self.replace_impl(text, replacement, true)
}

/// Splits `text` at each match. The pieces are the text between the matches.
/// The pieces of `text` between matches, so one more than the number of matches.
fun mut Regex.split(text: &str) => List<String> {
    val tv = text.view()
    val n = tv.len()
    var out: List<String> = List.empty()
    var last: int = 0
    var pos: int = 0
    while pos <= n {
        if self.run(tv, pos, 2, false) {
            val s = res.get(0).to_int()
            val e = res.get(1).to_int()
            out.push(tv.slice(last, s).to_string())
            last = e
            if e == s {
                pos = e + 1
            } else {
                pos = e
            }
        } else {
            pos = n + 1
        }
    }
    out.push(tv.slice(last, n).to_string())
    return out
}

/// The number of groups, including group 0.
fun Captures.len() => int = slots.len() / 2

/// The text of group `i`, or `None` when the group did not take part or does
/// not exist.
/// The text of group `i`, or `None` when the group did not take part in the
/// match or does not exist.
fun Captures.get(i: int) => option.Option<String> {
    if i * 2 + 1 >= slots.len() {
        return option.Option.None
    }
    val s = slots.get(i * 2)
    val e = slots.get(i * 2 + 1)
    if s < 0 || e < s {
        return option.Option.None
    }
    return option.Option.Some(value = text.view().slice(s.to_int(), e.to_int()).to_string())
}

/// The span and the text of group `i`, as a `Match`, or `None` when it did not
/// take part.
/// The span and text of group `i`, as a `Match`.
fun Captures.span(i: int) => option.Option<Match> {
    if i * 2 + 1 >= slots.len() {
        return option.Option.None
    }
    val s = slots.get(i * 2)
    val e = slots.get(i * 2 + 1)
    if s < 0 || e < s {
        return option.Option.None
    }
    val su = s.to_int()
    val eu = e.to_int()
    return option.Option.Some(value = Match(start = su, end = eu, text = text.view().slice(su, eu).to_string()))
}

/// Retired (#375): the camelCase `isMatch` is the name. Kept for one cycle.
fun is_match(pattern: &str, text: &str) => bool = isMatch(pattern, text)

/// Compiles `pattern` and reports whether it matches anywhere in `text`.
/// Whether `pattern` matches anywhere in `text`. Panics when the pattern does not
/// compile: a literal pattern in the source is a bug, not an input.
fun isMatch(pattern: &str, text: &str) => bool {
    val r = compile(pattern)
    if let Ok(re0) = r {
        var re = re0
        return re.isMatch(text)
    }
    if let Err(e) = r {
        panic(str.concat("regex.is_match: ", e.message.as_str()))
    }
    return false
}
