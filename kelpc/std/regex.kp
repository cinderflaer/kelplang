impl "std/str"
impl "std/option"
impl "std/result"

/* std/regex: a linear-time regular expression engine in pure Kelp.

   A pattern is parsed to an AST, compiled to a Thompson NFA program, and run
   by a Pike VM over bytes: a thread list with the capture slots carried per
   thread. Matching costs O(program size x input length) and no pattern can
   backtrack, so `(a+)+$` against thirty `a`s and a `b` is as cheap as `a$`.
   There are no backreferences and no lookaround (a pattern that writes one is
   refused at `compile`, with the construct named).

   The syntax and the semantics are written out in `plan/regex.md`; this file
   is the implementation. In short: literals, `.`, classes `[a-z]`/`[^...]`,
   the escapes `\d \D \w \W \s \S \b \B \n \r \t \xHH`, anchors `^ $`, groups
   `( )` and `(?: )`, alternation, the repeats `* + ? {n} {n,} {n,m}` with their
   lazy forms, and the flags `i`, `s` and `m` (`(?i)`, `(?is)`, `(?i:...)`).
   Alternation and repetition are leftmost-first, as in Perl.

   Everything is bytes. A `&str` input is scanned through a `View`, so the
   length is read once; a pattern or an input with a NUL byte cannot be written
   as a `&str`, so `\x00` never matches there.

   A compiled `Regex` owns its scratch (the thread lists, the capture slots
   and the explicit stack) and allocates it once, at `compile`; matching
   allocates nothing per input byte. That scratch is state a match writes, so
   every matching method takes the `Regex` exclusively (`var re = ...`). */

const MAX_PATTERN: usize = 4096
const MAX_DEPTH: i32 = 100
const MAX_REPEAT: i32 = 1000
// The compiled program may not exceed this many instructions (counted repeats
// are expanded), and the scratch (instructions x capture slots) may not exceed
// MAX_SCRATCH slots, which bounds a compiled regex to about 16 MiB.
const MAX_PROG: usize = 50000
const MAX_SCRATCH: usize = 2000000

const OP_CHAR: i32 = 0
const OP_CHARF: i32 = 1
const OP_ANY: i32 = 2
const OP_ANYALL: i32 = 3
const OP_CLASS: i32 = 4
const OP_SPLIT: i32 = 5
const OP_JMP: i32 = 6
const OP_SAVE: i32 = 7
const OP_ASSERT: i32 = 8
const OP_MATCH: i32 = 9

const N_CAT: i32 = 0
const N_ALT: i32 = 1
const N_REP: i32 = 2
const N_GROUP: i32 = 3
const N_BYTE: i32 = 4
const N_ANY: i32 = 5
const N_ANYALL: i32 = 6
const N_CLASS: i32 = 7
const N_ASSERT: i32 = 8

const A_BOL: i32 = 0
const A_EOL: i32 = 1
const A_BOL_M: i32 = 2
const A_EOL_M: i32 = 3
const A_WORD: i32 = 4
const A_NWORD: i32 = 5

const F_I: i32 = 1
const F_S: i32 = 2
const F_M: i32 = 4

// Why a pattern was refused: what is wrong with it, and the byte offset in the
// pattern where the parser noticed.
datac RegexErr(val message: String, val offset: usize)

// One match: the byte range `[start, end)` of the input and a copy of its text.
datac Match(val start: usize, val end: usize, val text: String)

// The groups of one match. Group 0 is the whole match.
datac Captures(val text: String, val slots: List<i32>)

// The parser, the AST arena and the program under construction. The AST is
// held in parallel lists (a node is an index), and the children of a
// concatenation or an alternation are a chain linked through `nnext`, so that
// neither the parser nor the emitter recurses on anything but nesting depth.
datac Parser(
    val pat: List<u8>,
    var pos: usize,
    var failed: bool,
    var emsg: String,
    var eoff: usize,
    var depth: i32,
    var ncap: i32,
    var flags: i32,
    var nk: List<i32>,
    var na: List<i32>,
    var nb: List<i32>,
    var nc: List<i32>,
    var nd: List<i32>,
    var nnext: List<i32>,
    var classes: List<u8>,
    var op: List<i32>,
    var ax: List<i32>,
    var ay: List<i32>
)

// A compiled pattern with its reusable scratch.
datac Regex(
    val op: List<i32>,
    val ax: List<i32>,
    val ay: List<i32>,
    val classes: List<u8>,
    val ngroups: usize,
    var tl_pc: List<i32>,
    var tl_cap: List<i32>,
    var cnt: List<usize>,
    var mark: List<i64>,
    var gen: i64,
    var stk_a: List<i32>,
    var stk_b: List<i32>,
    var wcap: List<i32>,
    var res: List<i32>,
    var nsteps: i64
)

fun is_word_byte(b: u8).return: bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
}

fun is_space_byte(b: u8).return: bool {
    return b == 32 || (b >= 9 && b <= 13)
}

fun hex_value(c: u8).return: i32 {
    if c >= '0' && c <= '9' {
        return (c - '0').to_i32()
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a').to_i32() + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A').to_i32() + 10
    }
    return -1
}

fun is_quant_byte(c: u8).return: bool = c == '*' || c == '+' || c == '?' || c == '{'

// ---------------------------------------------------------------------------
// Parser

fun mut Parser.fail(msg: &str, off: usize) {
    if !failed {
        failed = true
        emsg = String.from_str(msg)
        eoff = off
    }
}

fun mut Parser.node(kind: i32, a: i32, b: i32, c: i32, d: i32).return: i32 {
    nk.push(kind)
    na.push(a)
    nb.push(b)
    nc.push(c)
    nd.push(d)
    nnext.push(-1)
    return (nk.len() - 1).to_i32()
}

fun mut Parser.new_class().return: i32 {
    val idx = classes.len() / 32
    var i: usize = 0
    while i < 32 {
        classes.push(0)
        i += 1
    }
    return idx.to_i32()
}

fun mut Parser.set_bit(base: usize, b: usize) {
    val at = base + (b >> 3)
    val m: u8 = 1 << (b & 7).to_u8()
    classes.set(at, classes.get(at) | m)
}

fun Parser.has_bit(base: usize, b: usize).return: bool {
    val m: u8 = 1 << (b & 7).to_u8()
    return classes.get(base + (b >> 3)) & m != 0
}

// Adds the bytes of `\d`, `\w` or `\s` (`kind` is the letter), or of the
// complement for `\D \W \S`, to the class at `base`.
fun mut Parser.add_pred(base: usize, kind: u8, negate: bool) {
    var b: usize = 0
    while b < 256 {
        val c = b.to_u8()
        var p = false
        if kind == 'd' {
            p = c >= '0' && c <= '9'
        } elif kind == 'w' {
            p = is_word_byte(c)
        } else {
            p = is_space_byte(c)
        }
        if p != negate {
            self.set_bit(base, b)
        }
        b += 1
    }
}

// An ASCII case fold of a finished class: every letter whose other case is in
// the class gets added.
fun mut Parser.fold_class(base: usize) {
    var c: usize = 97
    while c <= 122 {
        if self.has_bit(base, c) || self.has_bit(base, c - 32) {
            self.set_bit(base, c)
            self.set_bit(base, c - 32)
        }
        c += 1
    }
}

fun mut Parser.invert_class(base: usize) {
    var i: usize = 0
    while i < 32 {
        classes.set(base + i, ~classes.get(base + i))
        i += 1
    }
}

// The byte an escape that is a single byte stands for, after the backslash at
// `at`; -1 when it is not one (the caller decides what that means). Leaves
// `pos` just past what it consumed. `in_class` allows only what a class may
// hold.
fun mut Parser.escape_byte(at: usize).return: i32 {
    val n = pat.len()
    if at + 1 >= n {
        self.fail("trailing backslash", at)
        return -1
    }
    val c = pat.get(at + 1)
    if c == 'n' {
        pos = at + 2
        return 10
    }
    if c == 'r' {
        pos = at + 2
        return 13
    }
    if c == 't' {
        pos = at + 2
        return 9
    }
    if c == 'x' {
        if at + 3 < n && hex_value(pat.get(at + 2)) >= 0 && hex_value(pat.get(at + 3)) >= 0 {
            pos = at + 4
            return hex_value(pat.get(at + 2)) * 16 + hex_value(pat.get(at + 3))
        }
        self.fail("invalid \\x escape: two hexadecimal digits are required", at)
        return -1
    }
    if c >= '1' && c <= '9' {
        self.fail("backreferences are not supported", at)
        return -1
    }
    // An escaped punctuation byte is that byte.
    if c < 128 && !is_word_byte(c) && c > 32 && c < 127 {
        pos = at + 2
        return c.to_i32()
    }
    return -2
}

fun mut Parser.bad_escape(at: usize) {
    val c = pat.get(at + 1)
    var msg = String.from_str("invalid escape '\\")
    if c >= 32 && c < 127 {
        msg.push(c)
    } else {
        msg.push_str("?")
    }
    msg.push_str("'")
    self.fail(msg.as_str(), at)
}

// One item of a character class: a byte (0..255), or -1 when it was a `\d`-style
// set that has been added to the class directly (or on failure).
fun mut Parser.class_atom(base: usize).return: i32 {
    val at = pos
    val c = pat.get(at)
    if c != '\\' {
        pos = at + 1
        return c.to_i32()
    }
    if at + 1 < pat.len() {
        val e = pat.get(at + 1)
        if e == 'd' || e == 'w' || e == 's' {
            self.add_pred(base, e, false)
            pos = at + 2
            return -1
        }
        if e == 'D' || e == 'W' || e == 'S' {
            self.add_pred(base, e + 32, true)
            pos = at + 2
            return -1
        }
    }
    val b = self.escape_byte(at)
    if b == -2 {
        self.bad_escape(at)
        return -1
    }
    return b
}

fun mut Parser.parse_class().return: i32 {
    val n = pat.len()
    val open = pos
    pos += 1
    var neg = false
    if pos < n && pat.get(pos) == '^' {
        neg = true
        pos += 1
    }
    val ci = self.new_class()
    val base = ci.to_usize() * 32
    var first = true
    var done = false
    while !done && !failed {
        if pos >= n {
            self.fail("unclosed character class", open)
        } elif pat.get(pos) == ']' && !first {
            pos += 1
            done = true
        } else {
            first = false
            val lo = self.class_atom(base)
            if !failed && lo >= 0 {
                if pos + 1 < n && pat.get(pos) == '-' && pat.get(pos + 1) != ']' {
                    pos += 1
                    val hi = self.class_atom(base)
                    if !failed {
                        if hi < 0 || hi < lo {
                            self.fail("invalid character class range", open)
                        } else {
                            var x = lo
                            while x <= hi {
                                self.set_bit(base, x.to_usize())
                                x += 1
                            }
                        }
                    }
                } else {
                    self.set_bit(base, lo.to_usize())
                }
            }
        }
    }
    if failed {
        return -1
    }
    if flags & F_I != 0 {
        self.fold_class(base)
    }
    if neg {
        self.invert_class(base)
    }
    return self.node(N_CLASS, ci, 0, 0, 0)
}

fun mut Parser.parse_escape().return: i32 {
    val at = pos
    val n = pat.len()
    if at + 1 >= n {
        self.fail("trailing backslash", at)
        return -1
    }
    val c = pat.get(at + 1)
    if c == 'd' || c == 'w' || c == 's' || c == 'D' || c == 'W' || c == 'S' {
        val ci = self.new_class()
        if c >= 'a' {
            self.add_pred(ci.to_usize() * 32, c, false)
        } else {
            self.add_pred(ci.to_usize() * 32, c + 32, true)
        }
        pos = at + 2
        return self.node(N_CLASS, ci, 0, 0, 0)
    }
    if c == 'b' {
        pos = at + 2
        return self.node(N_ASSERT, A_WORD, 0, 0, 0)
    }
    if c == 'B' {
        pos = at + 2
        return self.node(N_ASSERT, A_NWORD, 0, 0, 0)
    }
    val b = self.escape_byte(at)
    if b == -2 {
        self.bad_escape(at)
        return -1
    }
    if b < 0 {
        return -1
    }
    return self.byte_node(b.to_u8())
}

// A literal byte, folded when the case-insensitive flag is on.
fun mut Parser.byte_node(b: u8).return: i32 {
    var f: i32 = 0
    var v = b
    if flags & F_I != 0 {
        if b >= 'A' && b <= 'Z' {
            v = b + 32
            f = 1
        } elif b >= 'a' && b <= 'z' {
            f = 1
        }
    }
    return self.node(N_BYTE, v.to_i32(), f, 0, 0)
}

// `(` ... `)`. Returns a node, or -2 for a flag group `(?i)` that makes no
// node, or -1 on failure.
fun mut Parser.parse_group().return: i32 {
    val n = pat.len()
    val open = pos
    pos += 1
    var cap: i32 = -1
    val saved = flags
    var scoped = false
    if pos < n && pat.get(pos) == '?' {
        if pos + 1 >= n {
            self.fail("unclosed group", open)
            return -1
        }
        val c = pat.get(pos + 1)
        if c == ':' {
            pos += 2
        } elif c == '=' || c == '!' {
            self.fail("lookaround is not supported", open)
            return -1
        } elif c == '<' {
            if pos + 2 < n && (pat.get(pos + 2) == '=' || pat.get(pos + 2) == '!') {
                self.fail("lookaround is not supported", open)
            } else {
                self.fail("named groups are not supported", open)
            }
            return -1
        } elif c == 'P' {
            self.fail("named groups are not supported", open)
            return -1
        } else {
            // A flag group: letters, then `)` (flags for the rest of the
            // enclosing group) or `:` (flags for this group only).
            pos += 1
            var f = flags
            var more = true
            while more && !failed {
                if pos >= n {
                    self.fail("unclosed group", open)
                } else {
                    val l = pat.get(pos)
                    if l == 'i' {
                        f = f | F_I
                        pos += 1
                    } elif l == 's' {
                        f = f | F_S
                        pos += 1
                    } elif l == 'm' {
                        f = f | F_M
                        pos += 1
                    } elif l == ')' || l == ':' {
                        more = false
                    } else {
                        var msg = String.from_str("unknown group flag '")
                        if l >= 32 && l < 127 {
                            msg.push(l)
                        } else {
                            msg.push_str("?")
                        }
                        msg.push_str("'")
                        self.fail(msg.as_str(), pos)
                    }
                }
            }
            if failed {
                return -1
            }
            if pat.get(pos) == ')' {
                pos += 1
                flags = f
                return -2
            }
            pos += 1
            flags = f
            scoped = true
        }
    } else {
        cap = ncap
        ncap += 1
    }
    if depth + 1 > MAX_DEPTH {
        self.fail("nesting is too deep (limit 100)", open)
        return -1
    }
    depth += 1
    val inner = self.parse_alt()
    depth -= 1
    if failed {
        return -1
    }
    if pos >= n || pat.get(pos) != ')' {
        self.fail("unclosed group", open)
        return -1
    }
    pos += 1
    flags = saved
    if cap < 0 {
        return inner
    }
    return self.node(N_GROUP, inner, cap, 0, 0)
}

fun mut Parser.parse_number().return: i32 {
    var v: i32 = 0
    val n = pat.len()
    while pos < n && pat.get(pos) >= '0' && pat.get(pos) <= '9' {
        if v < 100000 {
            v = v * 10 + (pat.get(pos) - '0').to_i32()
        }
        pos += 1
    }
    return v
}

// The repeat operators after an atom.
fun mut Parser.parse_quant(atom: i32).return: i32 {
    val n = pat.len()
    if pos >= n {
        return atom
    }
    val at = pos
    val c = pat.get(pos)
    var mn: i32 = 0
    var mx: i32 = -1
    if c == '*' {
        pos += 1
    } elif c == '+' {
        mn = 1
        pos += 1
    } elif c == '?' {
        mx = 1
        pos += 1
    } elif c == '{' {
        pos += 1
        if pos >= n || pat.get(pos) < '0' || pat.get(pos) > '9' {
            self.fail("invalid repeat: expected {n}, {n,} or {n,m}", at)
            return -1
        }
        mn = self.parse_number()
        mx = mn
        if pos < n && pat.get(pos) == ',' {
            pos += 1
            if pos < n && pat.get(pos) >= '0' && pat.get(pos) <= '9' {
                mx = self.parse_number()
            } else {
                mx = -1
            }
        }
        if pos >= n || pat.get(pos) != '}' {
            self.fail("invalid repeat: expected {n}, {n,} or {n,m}", at)
            return -1
        }
        pos += 1
        if mn > MAX_REPEAT || mx > MAX_REPEAT {
            self.fail("repeat count is too large (limit 1000)", at)
            return -1
        }
        if mx >= 0 && mx < mn {
            self.fail("invalid repeat: the lower bound is greater than the upper bound", at)
            return -1
        }
    } else {
        return atom
    }
    var greedy: i32 = 1
    if pos < n && pat.get(pos) == '?' {
        greedy = 0
        pos += 1
    }
    if pos < n && is_quant_byte(pat.get(pos)) {
        self.fail("nested repetition operator", pos)
        return -1
    }
    return self.node(N_REP, atom, mn, mx, greedy)
}

// One atom, or -2 for a flag group, or -1 on failure.
fun mut Parser.parse_atom().return: i32 {
    val n = pat.len()
    val c = pat.get(pos)
    if c == '(' {
        return self.parse_group()
    }
    if c == '[' {
        return self.parse_class()
    }
    if c == '\\' {
        return self.parse_escape()
    }
    if c == '.' {
        pos += 1
        if flags & F_S != 0 {
            return self.node(N_ANYALL, 0, 0, 0, 0)
        }
        return self.node(N_ANY, 0, 0, 0, 0)
    }
    if c == '^' {
        pos += 1
        if flags & F_M != 0 {
            return self.node(N_ASSERT, A_BOL_M, 0, 0, 0)
        }
        return self.node(N_ASSERT, A_BOL, 0, 0, 0)
    }
    if c == '$' {
        pos += 1
        if flags & F_M != 0 {
            return self.node(N_ASSERT, A_EOL_M, 0, 0, 0)
        }
        return self.node(N_ASSERT, A_EOL, 0, 0, 0)
    }
    if is_quant_byte(c) {
        self.fail("nothing to repeat", pos)
        return -1
    }
    pos += 1
    if c >= 192 {
        // A multi-byte UTF-8 character is one atom: its bytes in sequence.
        val first = self.byte_node(c)
        var last = first
        val head = self.node(N_CAT, first, 0, 0, 0)
        while pos < n && pat.get(pos) >= 128 && pat.get(pos) < 192 {
            val nx = self.byte_node(pat.get(pos))
            nnext.set(last.to_usize(), nx)
            last = nx
            pos += 1
        }
        return head
    }
    return self.byte_node(c)
}

fun mut Parser.parse_cat().return: i32 {
    val n = pat.len()
    val head = self.node(N_CAT, -1, 0, 0, 0)
    var last: i32 = -1
    var go = true
    while go && pos < n && !failed {
        val c = pat.get(pos)
        if c == '|' || c == ')' {
            go = false
        } else {
            var atom = self.parse_atom()
            if !failed && atom != -2 {
                atom = self.parse_quant(atom)
            }
            if !failed && atom >= 0 {
                if last < 0 {
                    na.set(head.to_usize(), atom)
                } else {
                    nnext.set(last.to_usize(), atom)
                }
                last = atom
            }
        }
    }
    return head
}

fun mut Parser.parse_alt().return: i32 {
    val n = pat.len()
    val first = self.parse_cat()
    if failed {
        return -1
    }
    if pos < n && pat.get(pos) == '|' {
        var tail = first
        while pos < n && pat.get(pos) == '|' && !failed {
            pos += 1
            val nx = self.parse_cat()
            nnext.set(tail.to_usize(), nx)
            tail = nx
        }
        if failed {
            return -1
        }
        return self.node(N_ALT, first, 0, 0, 0)
    }
    return first
}

// ---------------------------------------------------------------------------
// Code generation

fun mut Parser.emit(o: i32, x: i32, y: i32).return: usize {
    if op.len() >= MAX_PROG {
        self.fail("pattern is too large (the compiled program is limited to 50000 instructions)", 0)
        return 0
    }
    op.push(o)
    ax.push(x)
    ay.push(y)
    return op.len() - 1
}

// `emit` for a caller that does not need the instruction's index.
fun mut Parser.put(o: i32, x: i32, y: i32) {
    val at = self.emit(o, x, y)
}

fun mut Parser.set_split(s: usize, body: usize, out: usize, greedy: bool) {
    if greedy {
        ax.set(s, body.to_i32())
        ay.set(s, out.to_i32())
    } else {
        ax.set(s, out.to_i32())
        ay.set(s, body.to_i32())
    }
}

fun mut Parser.emit_rep(n: usize) {
    val c = na.get(n)
    val mn = nb.get(n)
    val mx = nc.get(n)
    val greedy = nd.get(n) == 1
    var i: i32 = 0
    if mx == -1 {
        if mn == 0 {
            val s = self.emit(OP_SPLIT, 0, 0)
            self.emit_node(c)
            self.put(OP_JMP, s.to_i32(), 0)
            self.set_split(s, s + 1, op.len(), greedy)
        } else {
            while i < mn - 1 && !failed {
                self.emit_node(c)
                i += 1
            }
            val start = op.len()
            self.emit_node(c)
            val s = self.emit(OP_SPLIT, 0, 0)
            self.set_split(s, start, s + 1, greedy)
        }
    } else {
        while i < mn && !failed {
            self.emit_node(c)
            i += 1
        }
        var ss: List<usize> = List.empty()
        i = mn
        while i < mx && !failed {
            val s = self.emit(OP_SPLIT, 0, 0)
            ss.push(s)
            self.emit_node(c)
            i += 1
        }
        val end = op.len()
        var k: usize = 0
        while k < ss.len() {
            self.set_split(ss.get(k), ss.get(k) + 1, end, greedy)
            k += 1
        }
    }
}

fun mut Parser.emit_node(n: i32) {
    if failed {
        return
    }
    val i = n.to_usize()
    val k = nk.get(i)
    if k == N_CAT {
        var c = na.get(i)
        while c >= 0 && !failed {
            self.emit_node(c)
            c = nnext.get(c.to_usize())
        }
    } elif k == N_ALT {
        var js: List<usize> = List.empty()
        var alt = na.get(i)
        while alt >= 0 && !failed {
            val nx = nnext.get(alt.to_usize())
            if nx >= 0 {
                val s = self.emit(OP_SPLIT, 0, 0)
                ax.set(s, (s + 1).to_i32())
                self.emit_node(alt)
                js.push(self.emit(OP_JMP, 0, 0))
                ay.set(s, op.len().to_i32())
            } else {
                self.emit_node(alt)
            }
            alt = nx
        }
        val end = op.len().to_i32()
        var q: usize = 0
        while q < js.len() {
            ax.set(js.get(q), end)
            q += 1
        }
    } elif k == N_REP {
        self.emit_rep(i)
    } elif k == N_GROUP {
        val slot = nb.get(i) * 2
        self.put(OP_SAVE, slot, 0)
        self.emit_node(na.get(i))
        self.put(OP_SAVE, slot + 1, 0)
    } elif k == N_BYTE {
        if nb.get(i) == 1 {
            self.put(OP_CHARF, na.get(i), 0)
        } else {
            self.put(OP_CHAR, na.get(i), 0)
        }
    } elif k == N_ANY {
        self.put(OP_ANY, 0, 0)
    } elif k == N_ANYALL {
        self.put(OP_ANYALL, 0, 0)
    } elif k == N_CLASS {
        self.put(OP_CLASS, na.get(i), 0)
    } else {
        self.put(OP_ASSERT, na.get(i), 0)
    }
}

fun refuse(msg: &str, off: usize).return: result.Result<Regex, RegexErr> {
    return result.Result.Err(error = RegexErr(message = String.from_str(msg), offset = off))
}

// Compiles `pattern`. The error carries the message and the byte offset of the
// problem. A pattern longer than 4096 bytes, nested deeper than 100 groups, with
// a counted repeat above 1000, with a backreference or lookaround, or too large
// once its repeats are expanded, is refused.
fun compile(pattern: &str).return: result.Result<Regex, RegexErr> {
    val pv = pattern.view()
    val n = pv.len()
    if n > MAX_PATTERN {
        return refuse("pattern is too long (limit 4096 bytes)", MAX_PATTERN)
    }
    var p = Parser(
        pat = List.empty(),
        pos = 0,
        failed = false,
        emsg = String.empty(),
        eoff = 0,
        depth = 0,
        ncap = 1,
        flags = 0,
        nk = List.empty(),
        na = List.empty(),
        nb = List.empty(),
        nc = List.empty(),
        nd = List.empty(),
        nnext = List.empty(),
        classes = List.empty(),
        op = List.empty(),
        ax = List.empty(),
        ay = List.empty()
    )
    var i: usize = 0
    while i < n {
        p.pat.push(pv.get(i))
        i += 1
    }
    val root = p.parse_alt()
    if !p.failed && p.pos < n {
        p.fail("unmatched ')'", p.pos)
    }
    if !p.failed {
        p.put(OP_SAVE, 0, 0)
        p.emit_node(root)
        p.put(OP_SAVE, 1, 0)
        p.put(OP_MATCH, 0, 0)
    }
    if p.failed {
        return result.Result.Err(error = RegexErr(message = p.emsg.clone(), offset = p.eoff))
    }
    val np = p.op.len()
    val ng = p.ncap.to_usize()
    val nslots = ng * 2
    if np * nslots > MAX_SCRATCH {
        return refuse("pattern is too large (instructions x capture slots over the 2000000 limit)", 0)
    }
    var tl_pc: List<i32> = List.empty()
    var mark: List<i64> = List.empty()
    var stk_a: List<i32> = List.empty()
    var stk_b: List<i32> = List.empty()
    i = 0
    while i < np * 2 {
        tl_pc.push(0)
        i += 1
    }
    i = 0
    while i < np {
        mark.push(0)
        i += 1
    }
    i = 0
    while i < np * 2 + 8 {
        stk_a.push(0)
        stk_b.push(0)
        i += 1
    }
    var tl_cap: List<i32> = List.empty()
    i = 0
    while i < np * 2 * nslots {
        tl_cap.push(-1)
        i += 1
    }
    var wcap: List<i32> = List.empty()
    var res: List<i32> = List.empty()
    i = 0
    while i < nslots {
        wcap.push(-1)
        res.push(-1)
        i += 1
    }
    var cnt: List<usize> = List.empty()
    cnt.push(0)
    cnt.push(0)
    val re = Regex(
        op = p.op,
        ax = p.ax,
        ay = p.ay,
        classes = p.classes,
        ngroups = ng,
        tl_pc = tl_pc,
        tl_cap = tl_cap,
        cnt = cnt,
        mark = mark,
        gen = 0,
        stk_a = stk_a,
        stk_b = stk_b,
        wcap = wcap,
        res = res,
        nsteps = 0
    )
    return result.Result.Ok(value = re)
}

// ---------------------------------------------------------------------------
// The Pike VM

fun Regex.assert_ok(kind: i32, text: View, pos: usize).return: bool {
    val n = text.len()
    if kind == A_BOL {
        return pos == 0
    }
    if kind == A_EOL {
        return pos == n
    }
    if kind == A_BOL_M {
        return pos == 0 || text.get(pos - 1) == 10
    }
    if kind == A_EOL_M {
        return pos == n || text.get(pos) == 10
    }
    var before = false
    var after = false
    if pos > 0 {
        before = is_word_byte(text.get(pos - 1))
    }
    if pos < n {
        after = is_word_byte(text.get(pos))
    }
    if kind == A_WORD {
        return before != after
    }
    return before == after
}

// Adds the thread at `pc0` and everything reachable from it without consuming
// a byte to the list `side`, in priority order. The thread's captures are in
// `wcap` and are the same when the call returns. Iterative: the stack holds
// explore entries (pc >= 0) and capture restores (a < 0: slot -a-1 gets the
// value in `stk_b`), and each instruction is expanded once per list.
fun mut Regex.add_thread(side: usize, pc0: i32, pos: usize, text: View, nsl: usize) {
    val np = op.len()
    stk_a.set(0, pc0)
    stk_b.set(0, 0)
    var sp: usize = 1
    while sp > 0 {
        sp -= 1
        val a = stk_a.get(sp)
        if a < 0 {
            wcap.set((0 - a - 1).to_usize(), stk_b.get(sp))
        } else {
            val pc = a.to_usize()
            if mark.get(pc) != gen {
                mark.set(pc, gen)
                nsteps += 1
                val o = op.get(pc)
                if o == OP_JMP {
                    stk_a.set(sp, ax.get(pc))
                    sp += 1
                } elif o == OP_SPLIT {
                    stk_a.set(sp, ay.get(pc))
                    sp += 1
                    stk_a.set(sp, ax.get(pc))
                    sp += 1
                } elif o == OP_SAVE {
                    val slot = ax.get(pc).to_usize()
                    if slot < nsl {
                        stk_a.set(sp, -1 - slot.to_i32())
                        stk_b.set(sp, wcap.get(slot))
                        sp += 1
                        wcap.set(slot, pos.to_i32())
                    }
                    stk_a.set(sp, pc.to_i32() + 1)
                    sp += 1
                } elif o == OP_ASSERT {
                    if self.assert_ok(ax.get(pc), text, pos) {
                        stk_a.set(sp, pc.to_i32() + 1)
                        sp += 1
                    }
                } else {
                    val j = cnt.get(side)
                    val slot = side * np + j
                    tl_pc.set(slot, pc.to_i32())
                    var k: usize = 0
                    while k < nsl {
                        tl_cap.set(slot * nsl + k, wcap.get(k))
                        k += 1
                    }
                    cnt.set(side, j + 1)
                }
            }
        }
    }
}

// Runs the program over `text` from byte `start`, unanchored at the start. True
// when there is a match, whose first `nsl` capture slots are then in `res`.
// `early` stops at the first match found (enough for a yes/no answer).
fun mut Regex.run(text: View, start: usize, nsl: usize, early: bool).return: bool {
    val n = text.len()
    val np = op.len()
    gen += 1
    cnt.set(0, 0)
    cnt.set(1, 0)
    var side: usize = 0
    var matched = false
    var pos = start
    var running = true
    while running {
        if !matched {
            var k: usize = 0
            while k < nsl {
                wcap.set(k, -1)
                k += 1
            }
            self.add_thread(side, 0, pos, text, nsl)
        }
        val cn = cnt.get(side)
        if matched && cn == 0 {
            running = false
        } else {
            val nside = 1 - side
            gen += 1
            cnt.set(nside, 0)
            var c: i32 = -1
            if pos < n {
                c = text.get(pos).to_i32()
            }
            var j: usize = 0
            while j < cn {
                nsteps += 1
                val slot = side * np + j
                val pc = tl_pc.get(slot).to_usize()
                val o = op.get(pc)
                if o == OP_MATCH {
                    var k: usize = 0
                    while k < nsl {
                        res.set(k, tl_cap.get(slot * nsl + k))
                        k += 1
                    }
                    matched = true
                    // Every thread after this one has lower priority: drop them.
                    j = cn
                } else {
                    var ok = false
                    if c >= 0 {
                        if o == OP_CHAR {
                            ok = c == ax.get(pc)
                        } elif o == OP_CHARF {
                            ok = (c | 32) == ax.get(pc)
                        } elif o == OP_ANY {
                            ok = c != 10
                        } elif o == OP_ANYALL {
                            ok = true
                        } else {
                            val bit: u8 = 1 << (c & 7).to_u8()
                            ok = classes.get(ax.get(pc).to_usize() * 32 + (c >> 3).to_usize()) & bit != 0
                        }
                    }
                    if ok {
                        var k: usize = 0
                        while k < nsl {
                            wcap.set(k, tl_cap.get(slot * nsl + k))
                            k += 1
                        }
                        self.add_thread(nside, pc.to_i32() + 1, pos + 1, text, nsl)
                    }
                    j += 1
                }
            }
            side = nside
            if early && matched {
                running = false
            } elif pos >= n {
                running = false
            } else {
                pos += 1
            }
        }
    }
    return matched
}

// ---------------------------------------------------------------------------
// The API

// The number of VM steps taken since `compile` or the last `reset_steps`: one
// per instruction expanded and one per thread advanced. It is the measure of
// work the linearity tests assert on.
fun Regex.steps().return: i64 = nsteps

fun mut Regex.reset_steps() {
    nsteps = 0
}

// The number of capture groups, not counting group 0 (the whole match).
fun Regex.group_count().return: usize = ngroups - 1

// Whether the pattern matches anywhere in `text`.
fun mut Regex.is_match(text: &str).return: bool {
    return self.run(text.view(), 0, 2, true)
}

// The leftmost match at or after byte `start`, if any. `^` and `\b` still look
// at the whole text, so a search that resumes mid-text sees its true context.
fun mut Regex.find_at(text: &str, start: usize).return: option.Option<Match> {
    val tv = text.view()
    if start > tv.len() {
        return option.Option.None
    }
    if !self.run(tv, start, 2, false) {
        return option.Option.None
    }
    val s = res.get(0).to_usize()
    val e = res.get(1).to_usize()
    return option.Option.Some(value = Match(start = s, end = e, text = tv.slice(s, e).to_string()))
}

fun mut Regex.find(text: &str).return: option.Option<Match> {
    return self.find_at(text, 0)
}

// The leftmost match with every group's span, if any.
fun mut Regex.captures(text: &str).return: option.Option<Captures> {
    val tv = text.view()
    val nsl = ngroups * 2
    if !self.run(tv, 0, nsl, false) {
        return option.Option.None
    }
    var slots: List<i32> = List.empty()
    var k: usize = 0
    while k < nsl {
        slots.push(res.get(k))
        k += 1
    }
    return option.Option.Some(value = Captures(text = tv.to_string(), slots = slots))
}

// Every non-overlapping match, left to right. After an empty match the search
// resumes one byte further on, so the result is finite.
fun mut Regex.find_all(text: &str).return: List<Match> {
    val tv = text.view()
    val n = tv.len()
    var out: List<Match> = List.empty()
    var pos: usize = 0
    while pos <= n {
        if self.run(tv, pos, 2, false) {
            val s = res.get(0).to_usize()
            val e = res.get(1).to_usize()
            out.push(Match(start = s, end = e, text = tv.slice(s, e).to_string()))
            if e == s {
                pos = e + 1
            } else {
                pos = e
            }
        } else {
            pos = n + 1
        }
    }
    return out
}

// Appends the replacement template `rep` for the match in `res`: `$0`..`$9` is
// that group's text (nothing when it did not take part or does not exist),
// `$$` is a dollar sign, and any other `$` is literal.
fun Regex.expand(out: mut String, tv: View, rep: View, nsl: usize) {
    val m = rep.len()
    var i: usize = 0
    while i < m {
        val c = rep.get(i)
        if c == '$' && i + 1 < m {
            val d = rep.get(i + 1)
            if d == '$' {
                out.push('$')
                i += 2
            } elif d >= '0' && d <= '9' {
                val g = (d - '0').to_usize()
                if g * 2 + 1 < nsl {
                    val s = res.get(g * 2)
                    val e = res.get(g * 2 + 1)
                    if s >= 0 && e >= s {
                        var q = s.to_usize()
                        while q < e.to_usize() {
                            out.push(tv.get(q))
                            q += 1
                        }
                    }
                }
                i += 2
            } else {
                out.push(c)
                i += 1
            }
        } else {
            out.push(c)
            i += 1
        }
    }
}

fun mut Regex.replace_impl(text: &str, replacement: &str, all: bool).return: String {
    val tv = text.view()
    val rv = replacement.view()
    val n = tv.len()
    var nsl: usize = 2
    var i: usize = 0
    while i + 1 < rv.len() {
        if rv.get(i) == '$' && rv.get(i + 1) >= '0' && rv.get(i + 1) <= '9' {
            nsl = ngroups * 2
        }
        i += 1
    }
    var out = String.with_capacity(n)
    var last: usize = 0
    var pos: usize = 0
    while pos <= n {
        if self.run(tv, pos, nsl, false) {
            val s = res.get(0).to_usize()
            val e = res.get(1).to_usize()
            var q = last
            while q < s {
                out.push(tv.get(q))
                q += 1
            }
            self.expand(out, tv, rv, nsl)
            last = e
            if e == s {
                pos = e + 1
            } else {
                pos = e
            }
            if !all {
                pos = n + 1
            }
        } else {
            pos = n + 1
        }
    }
    var q = last
    while q < n {
        out.push(tv.get(q))
        q += 1
    }
    return out
}

// `text` with the first match replaced by `replacement` (see `expand` for `$1`).
fun mut Regex.replace(text: &str, replacement: &str).return: String {
    return self.replace_impl(text, replacement, false)
}

fun mut Regex.replace_all(text: &str, replacement: &str).return: String {
    return self.replace_impl(text, replacement, true)
}

// The pieces of `text` between matches, so one more than the number of matches.
fun mut Regex.split(text: &str).return: List<String> {
    val tv = text.view()
    val n = tv.len()
    var out: List<String> = List.empty()
    var last: usize = 0
    var pos: usize = 0
    while pos <= n {
        if self.run(tv, pos, 2, false) {
            val s = res.get(0).to_usize()
            val e = res.get(1).to_usize()
            out.push(tv.slice(last, s).to_string())
            last = e
            if e == s {
                pos = e + 1
            } else {
                pos = e
            }
        } else {
            pos = n + 1
        }
    }
    out.push(tv.slice(last, n).to_string())
    return out
}

fun Captures.len().return: usize = slots.len() / 2

// The text of group `i`, or `None` when the group did not take part in the
// match or does not exist.
fun Captures.get(i: usize).return: option.Option<String> {
    if i * 2 + 1 >= slots.len() {
        return option.Option.None
    }
    val s = slots.get(i * 2)
    val e = slots.get(i * 2 + 1)
    if s < 0 || e < s {
        return option.Option.None
    }
    return option.Option.Some(value = text.view().slice(s.to_usize(), e.to_usize()).to_string())
}

// The span and text of group `i`, as a `Match`.
fun Captures.span(i: usize).return: option.Option<Match> {
    if i * 2 + 1 >= slots.len() {
        return option.Option.None
    }
    val s = slots.get(i * 2)
    val e = slots.get(i * 2 + 1)
    if s < 0 || e < s {
        return option.Option.None
    }
    val su = s.to_usize()
    val eu = e.to_usize()
    return option.Option.Some(value = Match(start = su, end = eu, text = text.view().slice(su, eu).to_string()))
}

// Whether `pattern` matches anywhere in `text`. Panics when the pattern does not
// compile: a literal pattern in the source is a bug, not an input.
fun is_match(pattern: &str, text: &str).return: bool {
    val r = compile(pattern)
    if let Ok(re0) = r {
        var re = re0
        return re.is_match(text)
    }
    if let Err(e) = r {
        panic(str.concat("regex.is_match: ", e.message.as_str()))
    }
    return false
}
