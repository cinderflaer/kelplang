impl "std/fs"
impl "std/env"
impl "std/io"
impl "std/str"
impl "std/option"
impl "std/result"

/* std/tz: time zones over the system TZif database.

   A TZif file (RFC 8536) is the compiled form of the tz database: a header, a
   sorted list of transition instants with one time type each, a table of time
   types (a UTC offset, a DST flag, an abbreviation), and, for versions 2 to 4
   (which every file installed on a modern system is), a second block with
   64-bit instants followed by a POSIX TZ string. `tz.load` reads one from
   `$TZDIR` or `/usr/share/zoneinfo` and answers instants with it: the offset
   in force at an instant, the wall clock that instant names, the instant a
   wall clock names (`One`, `Ambiguous` or `Gap`), and a `strftime`-shaped
   formatter. Times before the first transition use the first time type whose
   DST flag is false; times at or after the last one use the footer's POSIX
   rule (`EST5EDT,M3.2.0,M11.1.0`), which is what keeps 2100 correct without
   the file growing a transition table out to it. Leap seconds are skipped,
   not applied, and `right/` is not read.

   Nothing is cached and nothing is embedded: one `load` is one file read, and
   the database is whatever the host has installed. `tz.utc()` and
   `tz.fixed(n)` are the two zones that need no file, and `tz.parse` is the
   parser itself, so a caller with TZif bytes in hand (a fixture, an archive
   member, a test) does not have to go through the filesystem.

   The read is a capability. `std/tz` reads through the `fs` gate and asks
   `std/env` for `TZDIR`, so an importer grants both domains on the `impl`
   line, with the whole-resource pattern or with the zoneinfo directory
   itself. The module holds nothing on its own account and widens no grant: a
   name with a leading `/`, a `..` segment or a NUL byte is refused before a
   path is built, and a read the OS refuses is `Err(Denied)`. A grant too
   narrow for a path is the compiler's own call-site panic rather than a
   returned error, which `kelp wiki page stdlib/tz.md` records (open item 73).

   The syntax, the decisions and the limits are written out in `kelp wiki page stdlib/tz.md`;
   this file is the implementation. */

/// The earliest instant the module accepts: 0001-01-01 00:00:00 UTC.
/// Instants outside the years 1 to 9999 are refused rather than wrapped: the
/// civil-date arithmetic and the `i32` year a `LocalTime` carries both need a
/// bound, and no time zone has a transition outside this range.
const MIN_INSTANT: i64 = -62135596800
/// The latest instant the module accepts: 9999-12-31 23:59:59 UTC.
const MAX_INSTANT: i64 = 253402300799

/// The number of seconds in a day.
const SECS_DAY: i64 = 86400
/// The number of seconds in an hour.
const SECS_HOUR: i64 = 3600
/// The number of seconds in a minute.
const SECS_MINUTE: i64 = 60

/// The most transitions that a file may hold.
/// Caps on what a single file may ask the parser to allocate: a corrupt or
/// hostile header can name four billion transitions, and the block-length check
/// below is what refuses one that does not actually fit in the file.
const MAX_TRANSITIONS: int = 200000
/// The most time types that a file may hold.
const MAX_TYPES: int = 256
/// The largest abbreviation block, in bytes, that a file may hold.
const MAX_CHARS: int = 65536

/// The three-letter English weekday names, Sunday first, with no gaps between
/// them.
/// The English 3-letter tables `%a` and `%b` print from. There is no locale in
/// this module (kelp wiki page stdlib/tz.md, Limits).
const WDAY_NAMES: str = "SunMonTueWedThuFriSat"
/// The three-letter English month names, January first, with no gaps between
/// them.
const MONTH_NAMES: str = "JanFebMarAprMayJunJulAugSepOctNovDec"

/// One UTC offset in force.
/// One offset in force: the seconds east of UTC, the abbreviation the database
/// carries, and whether it is a daylight offset.
datac Offset(
    /// Seconds east of UTC.
    val seconds: i32,
    /// The abbreviation the database carries, such as `EST` or `+0530`.
    val abbrev: String,
    /// Whether this is a daylight offset.
    val is_dst: bool,
)

/// A civil date, the shape the Hinnant day-number conversions hand back.
/// A civil date, the shape the Hinnant day-number conversions hand back.
datac Civil(
    /// The year.
    val year: i32,
    /// The month, from 1 to 12.
    val month: i32,
    /// The day of the month.
    val day: i32,
)

/// A wall clock reading.
/// A wall clock reading. `weekday` is 0 for Sunday through 6 for Saturday and
/// `yday` is 1 through 366, the numbering `localtime` itself uses.
datac LocalTime(
    /// The year.
    val year: i32,
    /// The month, from 1 to 12.
    val month: i32,
    /// The day of the month.
    val day: i32,
    /// The hour, from 0 to 23.
    val hour: i32,
    /// The minute, from 0 to 59.
    val minute: i32,
    /// The second, from 0 to 59.
    val second: i32,
    /// The day of the week: 0 for Sunday through 6 for Saturday.
    val weekday: i32,
    /// The day of the year, from 1 to 366.
    val yday: i32,
    /// The offset in force at this instant.
    val offset: Offset
)

/// What a wall clock reading names in a zone.
/// What a wall clock reading names. A local time the clock passes twice (set
/// back) is `Ambiguous` with both instants, earlier first; one it never passes
/// (set forward) is `Gap`.
enum Resolved {
    /// The reading names exactly one instant, `unix`.
    One(val unix: i64)
    /// The reading names two instants, the earlier first, because the clock
    /// passes it twice.
    Ambiguous(val first: i64, val second: i64)
    /// The reading names no instant, because the clock never passes it.
    Gap
}

/// Why a zone could not be loaded.
/// Why a zone could not be loaded. `NotFound` is a name with no file, or a
/// database directory that is not there; `Denied` is a name this API refuses to
/// turn into a path and a read the OS refused; `Corrupt` is a file that is not
/// a well-formed TZif file, with what is wrong with it.
enum TzErr {
    /// There is no such zone, or no database directory to look in.
    NotFound
    /// The name or the directory is refused, or the OS refused the read.
    Denied
    /// The file is not a well-formed TZif file.
    Corrupt(val message: String)
}

/// One transition rule of a POSIX TZ string.
/// One transition rule of a POSIX TZ string: `M3.2.0` (`kind` 0, `month`,
/// `week`, `day`), `J60` (`kind` 1, `n`) or `60` (`kind` 2, `n`), plus the time
/// of day it fires at and whether that time is UTC (a `-` prefix) rather than
/// local.
datac RuleDay(
    /// The form of the rule: 0 for `M`, 1 for `J` and 2 for a bare number.
    val kind: i32,
    /// The day number for `J` and bare rules, or 0 for `M` rules.
    val n: i32,
    /// The month for `M` rules, or 0 otherwise.
    val month: i32,
    /// The week of the month for `M` rules, where 5 means the last week.
    val week: i32,
    /// The weekday for `M` rules, where 0 is Sunday.
    val day: i32,
    /// The time of day in seconds, local unless `at_utc` is set.
    val at: i32,
    /// Whether `at` is UTC rather than local time.
    val at_utc: bool,
)

/// A parsed POSIX TZ string.
/// A parsed POSIX TZ string. `have` is false when there is none (a version 1
/// file, an empty footer, or a footer this parser does not understand), and
/// `have_dst` is false for a fixed-offset string like `IST-5:30`.
datac TzString(
    /// Whether there is a TZ string at all.
    val have: bool,
    /// Whether the string names a daylight zone with rules.
    val have_dst: bool,
    /// The standard offset, in seconds east of UTC.
    val std_off: i32,
    /// The standard abbreviation.
    val std_name: String,
    /// The daylight offset, in seconds east of UTC.
    val dst_off: i32,
    /// The daylight abbreviation.
    val dst_name: String,
    /// The rule that starts daylight time.
    val start: RuleDay,
    /// The rule that ends daylight time.
    val end: RuleDay
)

/// A time zone, loaded from a file or built in code.
/// A zone: the transition instants and the time type each one switches to, the
/// time type table, the type a time before the first transition uses, the
/// distinct offsets a wall-clock conversion has to try, and the footer rule.
datac Zone(
    /// The transition instants, in seconds since the Unix epoch, in order.
    val times: List<i64>,
    /// The time type that each transition switches to, as an index into `offs`.
    val at_type: List<u8>,
    /// The UTC offset of each time type, in seconds east of UTC.
    val offs: List<i32>,
    /// Whether each time type is a daylight one.
    val dsts: List<bool>,
    /// The abbreviation of each time type.
    val names: List<String>,
    /// The time type that a time before the first transition uses.
    val default_type: i32,
    /// The distinct offsets that a wall-clock conversion has to try.
    val uniques: List<i32>,
    /// The footer rule, which applies after the last transition.
    val tz: TzString
)

/// The six counts that a TZif header holds.
/// The six counts of one header. A `mut` out-parameter because a function
/// returns one value and six are wanted; the parser is the only caller.
datac Counts(
    /// The number of UT or local indicators.
    var isutcnt: int,
    /// The number of standard or wall indicators.
    var isstdcnt: int,
    /// The number of leap second records.
    var leapcnt: int,
    /// The number of transitions.
    var timecnt: int,
    /// The number of local time types.
    var typecnt: int,
    /// The number of bytes of abbreviation characters.
    var charcnt: int
)

/// The TZif byte cursor, which reads big-endian values.
/// The TZif byte cursor. Every read is a bounds-checked `Bytes` accessor after
/// an explicit length test, so a truncated file is `Corrupt` rather than a
/// panic, and the first failure keeps its own message.
datac Reader(
    /// The file bytes.
    val data: Bytes,
    /// The offset of the next byte to read.
    var at: int,
    /// Whether a read has failed.
    var bad: bool,
    /// The reason for the first failure.
    var why: String,
)

/// The POSIX TZ string cursor, over a copy of the footer text.
/// The POSIX TZ string cursor, over a copy of the footer text.
datac TzParser(
    /// The bytes of the string.
    val chars: Bytes,
    /// The offset of the next byte to read.
    var at: int,
    /// Whether parsing has failed.
    var bad: bool,
)

/// Divides `a` by `b`, rounding toward negative infinity.
/// `/` and `%` truncate toward zero, and the civil-date algorithms need the
/// floor (they are written against Python's `//`). These two are the floor
/// versions, and everything below goes through them so the two agree.
fun floor_div(a: i64, b: i64) => i64 {
    var q = a / b
    if a % b != 0 && (a < 0) != (b < 0) {
        q = q - 1
    }
    return q
}

/// The remainder of `a` divided by `b`, with the sign of `b`.
fun floor_mod(a: i64, b: i64) => i64 {
    val m = a % b
    if m != 0 && (m < 0) != (b < 0) {
        return m + b
    }
    return m
}

/// Converts the civil date `y-m-d` to a day number, counting from 1970-01-01.
/// Days since 1970-01-01 for a proleptic Gregorian date (Howard Hinnant's
/// `days_from_civil`). Exact for every year the instant guard admits.
fun days_from_civil(y: i32, m: i32, d: i32) => i64 {
    val yy = if m <= 2 { y.to_i64() - 1 } else { y.to_i64() }
    val era = floor_div(yy, 400)
    val yoe = yy - era * 400
    val mp = if m > 2 { m.to_i64() - 3 } else { m.to_i64() + 9 }
    val doy = (153 * mp + 2) / 5 + d.to_i64() - 1
    val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

/// Converts a day number, counting from 1970-01-01, to a civil date.
/// The inverse of `days_from_civil`.
fun civil_from_days(z: i64) => Civil {
    val zz = z + 719468
    val era = floor_div(zz, 146097)
    val doe = zz - era * 146097
    val yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    val y = yoe + era * 400
    val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    val mp = (5 * doy + 2) / 153
    val d = doy - (153 * mp + 2) / 5 + 1
    val m = if mp < 10 { mp + 3 } else { mp - 9 }
    val year = if m <= 2 { y + 1 } else { y }
    return Civil(year = year.to_i32(), month = m.to_i32(), day = d.to_i32())
}

/// Whether `y` is a leap year in the Gregorian calendar.
fun is_leap_year(y: i32) => bool {
    val yy = y.to_i64()
    return (floor_mod(yy, 4) == 0 && floor_mod(yy, 100) != 0) || floor_mod(yy, 400) == 0
}

/// The number of days in month `m` of year `y`.
fun days_in_month(y: i32, m: i32) => i32 {
    if m == 2 {
        if is_leap_year(y) {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

// A footer's POSIX TZ string: the day and the instant each of its two rules
// fires at, and the DST window between them.

/// Whether `t` falls in the daylight window of the rules in `year`.
/// Whether `t` falls in the DST window of `year`. A window that crosses New
/// Year (the southern-hemisphere shape, where the end rule's day of the year is
/// before the start rule's) runs to `end(year + 1)`, so one call is one
/// interval and the caller can test three candidate years against it.
fun rule_window_has(start: &RuleDay, end: &RuleDay, std_off: i32, dst_off: i32, year: i32, t: i64) => bool {
    val s = rule_instant(start, std_off, year)
    val e = rule_instant(end, dst_off, year)
    if s <= e {
        return t >= s && t < e
    }
    val next = rule_instant(end, dst_off, year + 1)
    return t >= s && t < next
}

/// The UTC instant that the rule `r` fires at in `year`, given the offset `off`
/// in force before the change.
/// The UTC instant a rule fires at in `year`. The rule's day and its time of
/// day are a wall clock reading, converted with the offset in force *before*
/// the change (standard time for the start rule, daylight time for the end
/// rule), which is what POSIX says the `/time` field is measured in. A rule
/// whose time is prefixed with `-` is already UTC.
fun rule_instant(r: &RuleDay, off: i32, year: i32) => i64 {
    var at = r.at.to_i64()
    if !r.at_utc {
        at = at - off.to_i64()
    }
    return rule_day(r, year) * SECS_DAY + at
}

/// The day number that the rule `r` names in `year`.
/// The day number the rule names in `year`. `M<m>.<w>.<d>` is the `w`th `d` of
/// month `m`, where week 5 means the last one; `J<n>` is day `n` counting from
/// January 1 with February 29 never counted, so a leap year pushes the days
/// after it along by one; a bare `n` counts from zero *with* February 29.
fun rule_day(r: &RuleDay, year: i32) => i64 {
    if r.kind == 0 {
        val first = days_from_civil(year, r.month, 1)
        // 1970-01-01 was a Thursday, so `days + 4` is Sunday-based.
        val wd = floor_mod(first + 4, 7)
        var dom = 1 + floor_mod(r.day.to_i64() - wd, 7) + (r.week.to_i64() - 1) * 7
        val last = days_in_month(year, r.month).to_i64()
        if dom > last {
            dom = dom - 7
        }
        return days_from_civil(year, r.month, dom.to_i32())
    }
    val jan1 = days_from_civil(year, 1, 1)
    if r.kind == 1 {
        var day = jan1 + r.n.to_i64() - 1
        if is_leap_year(year) && day >= days_from_civil(year, 3, 1) {
            day = day + 1
        }
        return day
    }
    return jan1 + r.n.to_i64()
}

/// A placeholder rule, for a TZ string that has none.
/// The rule a TZ string that has none carries anyway: `no_tz` and a fixed offset
/// both name two, because every `TzString` has the fields.
fun default_rule() => RuleDay {
    return RuleDay(kind = 0, n = 0, month = 1, week = 1, day = 0, at = 7200, at_utc = false)
}

/// The TZ string of a zone with the name `name` and the one offset `off`, with
/// no daylight time.
/// The zone of a TZ string with no DST: one offset, all year, forever.
fun fixed_tz(name: &str, off: i32) => TzString {
    return TzString(
        have = true,
        have_dst = false,
        std_off = off,
        std_name = name,
        dst_off = 0,
        dst_name = String.empty(),
        start = default_rule(),
        end = default_rule()
    )
}

/// The TZ string of a zone with no footer rule.
fun no_tz() => TzString {
    return TzString(
        have = false,
        have_dst = false,
        std_off = 0,
        std_name = String.empty(),
        dst_off = 0,
        dst_name = String.empty(),
        start = default_rule(),
        end = default_rule()
    )
}

/// The offset that this TZ string gives at the instant `t`.
/// The offset a TZ string names at `t`, which is the whole of what a zone does
/// with an instant once its transition table is behind us.
fun TzString.offset_at(t: i64) => Offset {
    if !have_dst {
        return Offset(seconds = std_off, abbrev = std_name.clone(), is_dst = false)
    }
    // The year to try first, from the standard-time reading of `t`. Near New
    // Year that reading can name the neighbouring year in a zone whose DST is
    // in force across it (the southern shape), so the window is tested for
    // `year - 1`, `year` and `year + 1`: exactly one of them holds the window
    // that covers `t`, and the others answer false.
    val approx = floor_div(t + std_off.to_i64(), SECS_DAY)
    val y = civil_from_days(approx).year
    var dst = false
    var dy: i32 = -1
    while dy <= 1 {
        if rule_window_has(start, end, std_off, dst_off, y + dy, t) {
            dst = true
        }
        dy = dy + 1
    }
    if dst {
        return Offset(seconds = dst_off, abbrev = dst_name.clone(), is_dst = true)
    }
    return Offset(seconds = std_off, abbrev = std_name.clone(), is_dst = false)
}

/// Marks the parse as failed.
fun mut TzParser.fail() {
    self.bad = true
}

/// Returns the byte under the cursor without moving it, or -1 at the end.
/// The byte at the cursor, or -1 at the end, so a caller can compare against
/// the punctuation it expects.
fun TzParser.peek() => i32 {
    if at >= chars.len() {
        return -1
    }
    return chars.get(at).to_i32()
}

/// Reads an abbreviation at the cursor, and returns it.
/// An abbreviation: `<+1030>` (any bytes up to `>`) or a run of letters. The
/// empty string is a failure, and so is running off the end.
fun mut TzParser.ident() => String {
    var out = String.empty()
    if self.peek() == 60 {
        self.at = self.at + 1
        while true {
            val c = self.peek()
            if c < 0 {
                self.fail()
                return out
            }
            if c == 62 {
                self.at = self.at + 1
                return out
            }
            out.push(c.to_byte())
            self.at = self.at + 1
        }
    }
    while true {
        val c = self.peek()
        val letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        if !letter {
            if out.len() == 0 {
                self.fail()
            }
            return out
        }
        out.push(c.to_byte())
        self.at = self.at + 1
    }
}

/// Reads a decimal number at the cursor, and returns it.
/// A decimal run, refused when there is none and when it grows past anything a
/// TZ string can name (167 hours in the widest extension, a day of the year, a
/// time of day).
fun mut TzParser.number() => i64 {
    var n: i64 = 0
    var digits: i32 = 0
    while true {
        val c = self.peek()
        if c < 48 || c > 57 {
            if digits == 0 {
                self.fail()
            }
            return n
        }
        n = n * 10 + (c - 48).to_i64()
        if n > 1000000 {
            self.fail()
            return 0
        }
        digits = digits + 1
        self.at = self.at + 1
    }
}

/// Reads a signed `hh[:mm[:ss]]` time at the cursor, and returns it in seconds
/// as written.
/// `[+-]hh[:mm[:ss]]`, as written: the POSIX offset form, where the sign counts
/// hours *west*, which the caller flips into seconds east.
fun mut TzParser.hms() => i32 {
    var sign: i32 = 1
    if self.peek() == 45 {
        sign = -1
        self.at = self.at + 1
    } elif self.peek() == 43 {
        self.at = self.at + 1
    }
    val h = self.number()
    var m: i64 = 0
    var s: i64 = 0
    if self.peek() == 58 {
        self.at = self.at + 1
        m = self.number()
        if self.peek() == 58 {
            self.at = self.at + 1
            s = self.number()
        }
    }
    if self.bad {
        return 0
    }
    // Two weeks is the ceiling: glibc's own is 167 hours for an offset, and a
    // reading past this one is not a zone. The bound is also what keeps the
    // `i32` this returns, and its negation for a `/time`, in range.
    val total = sign.to_i64() * (h * 3600 + m * 60 + s)
    if total > 604800 || total < -604800 {
        self.fail()
        return 0
    }
    return total.to_i32()
}

/// Reads one transition rule, with its optional time, at the cursor of `p`.
/// One rule: `M<m>.<w>.<d>`, `J<n>` or `<n>`, and an optional `/<time>`. A
/// `-` before the time says it is UTC rather than local.
fun parse_rule(p: mut TzParser) => RuleDay {
    var kind: i32 = 0
    var n: i32 = 0
    var month: i32 = 0
    var week: i32 = 0
    var day: i32 = 0
    val c = p.peek()
    if c == 77 {
        p.at = p.at + 1
        month = p.number().to_i32()
        if p.peek() != 46 {
            p.fail()
        } else {
            p.at = p.at + 1
        }
        week = p.number().to_i32()
        if p.peek() != 46 {
            p.fail()
        } else {
            p.at = p.at + 1
        }
        day = p.number().to_i32()
        if month < 1 || month > 12 || week < 1 || week > 5 || day < 0 || day > 6 {
            p.fail()
        }
    } elif c == 74 {
        kind = 1
        p.at = p.at + 1
        n = p.number().to_i32()
        if n < 1 || n > 365 {
            p.fail()
        }
    } else {
        kind = 2
        n = p.number().to_i32()
        if n < 0 || n > 365 {
            p.fail()
        }
    }
    var at: i32 = 7200
    var at_utc = false
    if p.peek() == 47 {
        p.at = p.at + 1
        val v = p.hms()
        if v < 0 {
            at_utc = true
            at = -v
        } else {
            at = v
        }
    }
    return RuleDay(kind = kind, n = n, month = month, week = week, day = day, at = at, at_utc = at_utc)
}

/// Parses a POSIX TZ string. It returns the rules that it names, or no rules
/// when the text is not one this parser understands.
/// A footer's TZ string, or a TZ string that says "none" when the text is not
/// one this parser understands. A name with daylight time and no rules is
/// treated the same way rather than guessing a rule set the string does not
/// carry (kelp wiki page stdlib/tz.md, Limits).
fun parse_tz_string(text: &str) => TzString {
    val none = no_tz()
    var p = TzParser(chars = Bytes.from_str(text), at = 0, bad = false)
    val std_name = p.ident()
    if p.bad {
        return none
    }
    val std_west = p.hms()
    if p.bad {
        return none
    }
    val std_off = -std_west
    if p.at >= p.chars.len() {
        return fixed_tz(name = std_name.as_str(), off = std_off)
    }
    val dst_name = p.ident()
    if p.bad {
        return none
    }
    var dst_off = std_off + 3600
    if p.peek() != 44 {
        val dst_west = p.hms()
        if p.bad {
            return none
        }
        dst_off = -dst_west
    }
    if p.peek() != 44 {
        return none
    }
    p.at = p.at + 1
    val start = parse_rule(p)
    if p.peek() != 44 {
        p.fail()
    } else {
        p.at = p.at + 1
    }
    val end = parse_rule(p)
    if p.bad {
        return none
    }
    return TzString(
        have = true,
        have_dst = true,
        std_off = std_off,
        std_name = std_name,
        dst_off = dst_off,
        dst_name = dst_name,
        start = start,
        end = end
    )
}

// The TZif cursor and the file parser.

/// Records the first failure, with its reason `why`.
fun mut Reader.fail(why: &str) {
    if !self.bad {
        self.bad = true
        self.why = why
    }
}

/// Whether `n` more bytes are left to read. It fails with `what` when they are
/// not.
/// Whether `n` more bytes are there. Every read below starts with this, which is
/// what turns a truncated file into a message instead of a panic.
fun mut Reader.need(n: int, what: &str) => bool {
    if self.bad {
        return false
    }
    if self.at + n > self.data.len() {
        self.fail(why = what)
        return false
    }
    return true
}

/// Reads an unsigned 32-bit big-endian value, failing with `what` at the end of
/// the file.
fun mut Reader.u32(what: &str) => u32 {
    if !self.need(n = 4, what = what) {
        return 0
    }
    val v = self.data.read_u32_be(self.at)
    self.at = self.at + 4
    return v
}

/// Reads a signed 32-bit big-endian value.
fun mut Reader.i32(what: &str) => i32 {
    if !self.need(n = 4, what = what) {
        return 0
    }
    val v = self.data.read_i32_be(self.at)
    self.at = self.at + 4
    return v
}

/// Reads a signed 64-bit big-endian value.
fun mut Reader.i64(what: &str) => i64 {
    if !self.need(n = 8, what = what) {
        return 0
    }
    val v = self.data.read_i64_be(self.at)
    self.at = self.at + 8
    return v
}

/// Reads one byte.
fun mut Reader.u8(what: &str) => u8 {
    if !self.need(n = 1, what = what) {
        return 0
    }
    val v = self.data.get(self.at)
    self.at = self.at + 1
    return v
}

/// Reads the six header counts into `out`.
/// The six header counts, read at the cursor: `isutcnt`, `isstdcnt`, `leapcnt`,
/// `timecnt`, `typecnt`, `charcnt`, in the order the header writes them.
fun mut Reader.counts(what: &str, out: mut Counts) {
    out.isutcnt = self.u32(what = what).to_int()
    out.isstdcnt = self.u32(what = what).to_int()
    out.leapcnt = self.u32(what = what).to_int()
    out.timecnt = self.u32(what = what).to_int()
    out.typecnt = self.u32(what = what).to_int()
    out.charcnt = self.u32(what = what).to_int()
}

/// Whether the four bytes at `at` are the TZif magic.
fun magic_at(data: &Bytes, at: int) => bool {
    return data.get(at) == 84 && data.get(at + 1) == 90 && data.get(at + 2) == 105 && data.get(at + 3) == 102
}

/// The index of the first NUL byte from `from` up to `to`, or `to` when there
/// is none.
/// The byte offset of the NUL that ends an abbreviation, or `to` when there is
/// none.
fun nul_at(data: &Bytes, from: int, to: int) => int {
    var i = from
    while i < to {
        if data.get(i) == 0 {
            return i
        }
        i = i + 1
    }
    return to
}

/// The bytes from `from` up to `to`, as a string.
fun bytes_to_string(data: &Bytes, from: int, to: int) => String {
    var out = String.with_capacity(to - from)
    var i = from
    while i < to {
        out.push(data.get(i))
        i = i + 1
    }
    return out
}

/// Appends `v` to `xs` unless it is already there.
fun add_unique(xs: mut List<i32>, v: i32) {
    var found = false
    var i: int = 0
    while i < xs.len() {
        if xs.get(i) == v {
            found = true
        }
        i = i + 1
    }
    if !found {
        xs.push(v)
    }
}

/// The error result for a file that is not well formed, with the reason
/// `message`.
fun corrupt(message: &str) => result.Result<Zone, TzErr> {
    return result.Result.Err(error = TzErr.Corrupt(message = message))
}

/// The error result for a name or a read that is refused.
fun denied() => result.Result<Zone, TzErr> {
    return result.Result.Err(error = TzErr.Denied)
}

/// The error result for a zone that does not exist.
fun not_found() => result.Result<Zone, TzErr> {
    return result.Result.Err(error = TzErr.NotFound)
}

/// Parses the bytes of one TZif file into a `Zone`.
/// One TZif file, parsed. Versions 1 to 4 are accepted; the 64-bit block of a
/// version 2+ file is the one read, and the footer POSIX TZ string is parsed
/// afterwards (absent or unparsable leaves time after the last transition with
/// the last transition's type, which is what a version 1 file has anyway).
fun parse(data: move Bytes) => result.Result<Zone, TzErr> {
    if data.len() < 44 {
        return corrupt("the file is shorter than a TZif header")
    }
    if !magic_at(data, 0) {
        return corrupt("the file does not begin with the TZif magic")
    }
    val version = data.get(4)
    if version != 0 && version != 50 && version != 51 && version != 52 {
        return corrupt("the TZif version byte is not 0, '2', '3' or '4'")
    }
    var r = Reader(data = data, at = 20, bad = false, why = String.empty())
    var first = Counts(isutcnt = 0, isstdcnt = 0, leapcnt = 0, timecnt = 0, typecnt = 0, charcnt = 0)
    r.counts(what = "the header is truncated", out = first)
    if r.bad {
        return corrupt(r.why)
    }
    var use64 = false
    var block: int = 44
    if version != 0 {
        // Skip the 32-bit block, whose length the first header just gave us,
        // and read the second header there. `44 + block1` cannot overflow: the
        // counts are 32-bit and every term is a small multiple of one.
        val block1 = 4 * first.timecnt + first.timecnt + 6 * first.typecnt + first.charcnt + 8 * first.leapcnt + first.isstdcnt + first.isutcnt
        block = 44 + block1
        if block + 44 > r.data.len() {
            return corrupt("the file ends before the 64-bit header")
        }
        if !magic_at(r.data, block) {
            return corrupt("the second header does not begin with the TZif magic")
        }
        r.at = block + 20
        r.counts(what = "the second header is truncated", out = first)
        if r.bad {
            return corrupt(r.why)
        }
        use64 = true
        block = block + 44
    }
    val timecnt = first.timecnt
    val typecnt = first.typecnt
    val charcnt = first.charcnt
    if typecnt == 0 {
        return corrupt("the file has no time types")
    }
    if charcnt == 0 {
        return corrupt("the file has no abbreviation block")
    }
    if timecnt > MAX_TRANSITIONS {
        return corrupt("the file claims more transitions than any zone has")
    }
    if typecnt > MAX_TYPES {
        return corrupt("the file claims more time types than any zone has")
    }
    if charcnt > MAX_CHARS {
        return corrupt("the file claims a larger abbreviation block than any zone has")
    }
    val width: int = if use64 { 8 } else { 4 }
    val seconds = timecnt * width + timecnt + typecnt * 6 + charcnt + first.leapcnt * (width + 4) + first.isstdcnt + first.isutcnt
    if block + seconds > r.data.len() {
        return corrupt("the transition block runs past the end of the file")
    }
    r.at = block
    var times: List<i64> = List.empty()
    var i: int = 0
    while i < timecnt {
        if use64 {
            times.push(r.i64(what = "the file ends in the middle of a transition time"))
        } else {
            times.push(r.i32(what = "the file ends in the middle of a transition time").to_i64())
        }
        i = i + 1
    }
    if r.bad {
        return corrupt(r.why)
    }
    var at_type: List<u8> = List.empty()
    i = 0
    while i < timecnt {
        at_type.push(r.u8(what = "the file ends in the middle of a transition type"))
        i = i + 1
    }
    var offs: List<i32> = List.empty()
    var dsts: List<bool> = List.empty()
    var desigs: List<u8> = List.empty()
    i = 0
    while i < typecnt {
        val off = r.i32(what = "the file ends in the middle of a time type")
        val isdst = r.u8(what = "the file ends in the middle of a time type")
        val desig = r.u8(what = "the file ends in the middle of a time type")
        if isdst > 1 {
            return corrupt("a time type has a DST flag that is neither 0 nor 1")
        }
        if desig.to_int() >= charcnt {
            return corrupt("a time type names an abbreviation past the character block")
        }
        offs.push(off)
        dsts.push(isdst == 1)
        desigs.push(desig)
        i = i + 1
    }
    if r.bad {
        return corrupt(r.why)
    }
    i = 0
    while i < timecnt {
        if at_type.get(i).to_int() >= typecnt {
            return corrupt("a transition names a time type that does not exist")
        }
        i = i + 1
    }
    val char_at = block + timecnt * width + timecnt + typecnt * 6
    var names: List<String> = List.empty()
    i = 0
    while i < typecnt {
        val from = char_at + desigs.get(i).to_int()
        val to = char_at + charcnt
        val end = nul_at(r.data, from, to)
        if end == to {
            return corrupt("an abbreviation is not terminated by a NUL")
        }
        names.push(bytes_to_string(r.data, from, end))
        i = i + 1
    }
    // The leap-second table and the two indicator blocks sit between the
    // abbreviations and the footer, and are skipped rather than applied.
    var tz = no_tz()
    val tail = char_at + charcnt + first.leapcnt * (width + 4) + first.isstdcnt + first.isutcnt
    if use64 && tail < r.data.len() && r.data.get(tail) == 10 {
        var end = tail + 1
        while end < r.data.len() && r.data.get(end) != 10 {
            end = end + 1
        }
        if end == r.data.len() {
            return corrupt("the TZ string in the footer is not terminated by a newline")
        }
        val text = bytes_to_string(r.data, tail + 1, end)
        tz = parse_tz_string(text)
    }
    var uniques: List<i32> = List.empty()
    i = 0
    while i < typecnt {
        add_unique(xs = uniques, v = offs.get(i))
        i = i + 1
    }
    if tz.have {
        add_unique(xs = uniques, v = tz.std_off)
        if tz.have_dst {
            add_unique(xs = uniques, v = tz.dst_off)
        }
    }
    // The type a time before the first transition uses: the first one whose DST
    // flag is false, which is the rule `localtime` itself follows (type 0 when
    // every type is a daylight one).
    var default_type: i32 = 0
    var found = false
    i = 0
    while i < typecnt && !found {
        if !dsts.get(i) {
            default_type = i.to_i32()
            found = true
        }
        i = i + 1
    }
    return result.Result.Ok(value = Zone(
        times = times,
        at_type = at_type,
        offs = offs,
        dsts = dsts,
        names = names,
        default_type = default_type,
        uniques = uniques,
        tz = tz
    ))
}

// Loading: turning a zone name into a path, reading it, and choosing the
// directory it sits in.

/// Whether `name` is safe to join onto a database directory.
/// Whether a zone name may be turned into a path. A leading `/` would leave the
/// database root, a `..` segment would climb out of it, and a NUL would cut the
/// name the C string layer sees short of the one the caller wrote.
fun name_ok(name: &str) => bool {
    if str.len(name) == 0 {
        return false
    }
    if str.byte(name, 0) == 47 {
        return false
    }
    var i: int = 0
    while i < str.len(name) {
        if str.byte(name, i) == 0 {
            return false
        }
        i = i + 1
    }
    return !str.contains(name, "..")
}

/// Whether `dir` is an absolute directory path that is safe to use.
/// The same test for a directory the caller names or `$TZDIR` supplies: an
/// absolute path with no `..` and no NUL.
fun dir_ok(dir: &str) => bool {
    if str.len(dir) == 0 {
        return false
    }
    if str.byte(dir, 0) != 47 {
        return false
    }
    var i: int = 0
    while i < str.len(dir) {
        if str.byte(dir, i) == 0 {
            return false
        }
        i = i + 1
    }
    return !str.contains(dir, "..")
}

/// Joins a directory and a zone name into one path, with one slash between
/// them.
fun join_path(dir: &str, name: &str) => String {
    val sep = if str.byte(dir, str.len(dir) - 1) == 47 { "" } else { "/" }
    val head = str.concat(dir, sep)
    return str.concat(head, name)
}

/// Loads the zone `name` from the database in `dir`.
/// The zone named `name` under `dir`, which is the caller's own choice of
/// directory rather than `$TZDIR` or the system default.
fun load_in(dir: &str, name: &str) => result.Result<Zone, TzErr> {
    if !name_ok(name) {
        return denied()
    }
    if !dir_ok(dir) {
        return denied()
    }
    val path = join_path(dir, name)
    return read_zone(path)
}

/// Loads the zone `name` from the system database, trying `$TZDIR` first.
/// The zone named `name`: `$TZDIR` when it is set and usable, `/usr/share/
/// zoneinfo` otherwise. Both candidates are tried when the first names nothing,
/// which is what makes a machine with only one of them work without the caller
/// choosing.
fun load(name: &str) => result.Result<Zone, TzErr> {
    if str.len(name) == 0 {
        return not_found()
    }
    if !name_ok(name) {
        return denied()
    }
    var dirs: List<String> = List.empty()
    val tzdir = env.get("TZDIR")
    val usable = dir_ok(tzdir)
    if usable {
        dirs.push(tzdir)
    }
    dirs.push("/usr/share/zoneinfo")
    return load_from(dirs, name, 0)
}

/// Tries the directories from index `i` onward for the zone `name`.
/// `load`'s loop, as recursion: one candidate directory per frame, so a read
/// that fails can try the next one without an out-parameter or a sentinel.
fun load_from(dirs: &List<String>, name: &str, i: int) => result.Result<Zone, TzErr> {
    if i >= dirs.len() {
        return not_found()
    }
    val path = join_path(dirs.get(i).as_str(), name)
    val got = read_zone(path)
    return when got {
        Ok(zone) -> result.Result.Ok(value = zone)
        Err(e) -> next_or_stop(e = e, dirs = dirs, name = name, i = i)
    }
}

/// Decides whether a failed read should try the next directory.
/// Whether the next candidate directory is worth trying. A refusal ends the
/// search: the second directory is not a different grant question, and a file
/// that is corrupt is corrupt wherever it was found.
fun next_or_stop(e: TzErr, dirs: &List<String>, name: &str, i: int) => result.Result<Zone, TzErr> {
    return when e {
        NotFound -> load_from(dirs = dirs, name = name, i = i + 1)
        Denied -> denied()
        Corrupt(message) -> corrupt(message.as_str())
    }
}

/// Reads and parses the zone file at `path`.
/// One path: the bytes parsed, or the reason the caller should look elsewhere.
fun read_zone(path: &str) => result.Result<Zone, TzErr> {
    val data = fs.try_read(path)
    return when data {
        Ok(bytes) -> parse(bytes)
        Err(err) -> errno_tz(err.errno)
    }
}

/// Turns a read error number into the matching error.
/// A read failure as a `TzErr`: a permission failure is `Denied`, a missing
/// file (or a directory where a file was wanted) is `NotFound`, and anything
/// else is refused rather than guessed at.
fun errno_tz(errno: i32) => result.Result<Zone, TzErr> {
    if errno == 2 || errno == 20 || errno == 21 {
        return not_found()
    }
    return denied()
}

// The API: the two zones that need no file, `tz.parse`, `tz.load` and the
// `Zone` methods.

/// The zone for UTC, which needs no file.
/// The fixed zero offset under the name `UTC`.
fun utc() => Zone {
    var offs: List<i32> = List.empty()
    offs.push(0)
    var dsts: List<bool> = List.empty()
    dsts.push(false)
    var names: List<String> = List.empty()
    names.push("UTC")
    var uniques: List<i32> = List.empty()
    uniques.push(0)
    var times: List<i64> = List.empty()
    var at_type: List<u8> = List.empty()
    return Zone(
        times = times,
        at_type = at_type,
        offs = offs,
        dsts = dsts,
        names = names,
        default_type = 0,
        uniques = uniques,
        tz = no_tz()
    )
}

/// The zone with one fixed offset, `offset_seconds` east of UTC, and no file.
/// `offset_seconds` east of UTC, all year, forever. A fixed offset has no name
/// in the database, so `%Z` prints `UTC` for zero and the offset itself
/// (`+05:30`) otherwise.
fun fixed(offset_seconds: i32) => Zone {
    var offs: List<i32> = List.empty()
    offs.push(offset_seconds)
    var dsts: List<bool> = List.empty()
    dsts.push(false)
    var names: List<String> = List.empty()
    names.push(fixed_name(offset_seconds))
    var uniques: List<i32> = List.empty()
    uniques.push(offset_seconds)
    var times: List<i64> = List.empty()
    var at_type: List<u8> = List.empty()
    return Zone(
        times = times,
        at_type = at_type,
        offs = offs,
        dsts = dsts,
        names = names,
        default_type = 0,
        uniques = uniques,
        tz = no_tz()
    )
}

/// The name that `fixed` gives an offset: `UTC` for zero, otherwise a signed
/// `hh:mm`.
fun fixed_name(offset_seconds: i32) => String {
    if offset_seconds == 0 {
        return "UTC"
    }
    var out = String.empty()
    var secs = offset_seconds.to_i64()
    if secs < 0 {
        out.push('-')
        secs = -secs
    } else {
        out.push('+')
    }
    push_pad(out = out, value = secs / SECS_HOUR, width = 2)
    out.push(':')
    push_pad(out = out, value = (secs % SECS_HOUR) / SECS_MINUTE, width = 2)
    return out
}

/// The offset of the time type `i`.
/// The type table entry `i` as an `Offset`.
fun Zone.offset_of(i: i32) => Offset {
    val k = i.to_int()
    return Offset(seconds = offs.get(k), abbrev = names.get(k).clone(), is_dst = dsts.get(k))
}

/// Returns the offset in force at `unix_seconds`.
/// The offset in force at `unix_seconds`.
///
/// Panics: when the instant is outside the years 1 to 9999 this module works
/// in.
fun Zone.offset_at(unix_seconds: i64) => Offset {
    if unix_seconds < MIN_INSTANT || unix_seconds > MAX_INSTANT {
        panic("tz.offset_at: the instant is outside the years 1 to 9999 this module supports")
    }
    val n = times.len()
    if n == 0 {
        if tz.have {
            return tz.offset_at(unix_seconds)
        }
        return self.offset_of(default_type)
    }
    if unix_seconds < times.get(0) {
        return self.offset_of(default_type)
    }
    if tz.have && unix_seconds >= times.get(n - 1) {
        return tz.offset_at(unix_seconds)
    }
    // The last transition at or before the instant, by binary search: the
    // largest `i` with `times[i] <= unix_seconds`.
    var lo: int = 0
    var hi: int = n
    while lo < hi {
        val mid = (lo + hi) / 2
        if times.get(mid) <= unix_seconds {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return self.offset_of(at_type.get(lo - 1).to_i32())
}

/// Returns the wall clock reading at `unix_seconds`.
/// The wall clock `unix_seconds` names in this zone.
///
/// Panics: when the instant is outside the years 1 to 9999 this module works
/// in.
fun Zone.local_parts(unix_seconds: i64) => LocalTime {
    val off = self.offset_at(unix_seconds)
    val wall = unix_seconds + off.seconds.to_i64()
    val days = floor_div(wall, SECS_DAY)
    val rem = wall - days * SECS_DAY
    val date = civil_from_days(days)
    return LocalTime(
        year = date.year,
        month = date.month,
        day = date.day,
        hour = (rem / SECS_HOUR).to_i32(),
        minute = ((rem % SECS_HOUR) / SECS_MINUTE).to_i32(),
        second = (rem % SECS_MINUTE).to_i32(),
        weekday = floor_mod(days + 4, 7).to_i32(),
        yday = (days - days_from_civil(date.year, 1, 1) + 1).to_i32(),
        offset = off
    )
}

/// Returns the instant or instants that the wall clock `y-m-d h:mi:s` names in
/// this zone.
/// The instant or instants the wall clock `y-m-d h:mi:s` names. Every distinct
/// offset in the zone is tried and a candidate is kept only when the instant it
/// produces really does carry that offset, which is why `Gap` needs no case of
/// its own: across a spring-forward neither offset reproduces itself, and
/// across a fall-back both do.
///
/// Panics: when the date is not a real calendar date, when the time is not a
/// real time of day, or when the instant is outside the years 1 to 9999 this
/// module works in.
fun Zone.to_unix(y: i32, m: i32, d: i32, h: i32, mi: i32, s: i32) => Resolved {
    if m < 1 || m > 12 {
        panic("tz.to_unix: the month is not in 1..12")
    }
    if d < 1 || d > days_in_month(y, m) {
        panic("tz.to_unix: the day is not in this month")
    }
    if h < 0 || h > 23 || mi < 0 || mi > 59 || s < 0 || s > 59 {
        panic("tz.to_unix: the time of day is not a real one")
    }
    val total = days_from_civil(y, m, d) * SECS_DAY + h.to_i64() * SECS_HOUR + mi.to_i64() * SECS_MINUTE + s.to_i64()
    var first: i64 = 0
    var second: i64 = 0
    var hits: i32 = 0
    var i: int = 0
    while i < uniques.len() {
        val off = uniques.get(i)
        val cand = total - off.to_i64()
        if self.offset_at(cand).seconds == off {
            if hits == 0 {
                first = cand
            }
            if hits == 1 {
                second = cand
            }
            hits = hits + 1
        }
        i = i + 1
    }
    if hits == 0 {
        return Resolved.Gap
    }
    if hits == 1 {
        return Resolved.One(unix = first)
    }
    if first > second {
        return Resolved.Ambiguous(first = second, second = first)
    }
    return Resolved.Ambiguous(first = first, second = second)
}

/// Formats `unix_seconds` in this zone, with the `strftime`-style pattern
/// `fmt`.
/// The instant `unix_seconds` printed through `fmt`: `%Y` `%m` `%d` `%H` `%M`
/// `%S` `%z` `%Z` `%a` `%b` `%j` and `%%`. A `%` that introduces anything else
/// is copied through as it stands.
///
/// Panics: when the instant is outside the years 1 to 9999 this module works
/// in.
fun Zone.format(unix_seconds: i64, fmt: &str) => String {
    val lt = self.local_parts(unix_seconds)
    val fv = fmt.view()
    var out = String.with_capacity(fv.len() + 8)
    var i: int = 0
    while i < fv.len() {
        val c = fv.get(i)
        if c == 37 && i + 1 < fv.len() {
            format_spec(out = out, spec = fv.get(i + 1), lt = lt)
            i = i + 2
        } else {
            out.push(c)
            i = i + 1
        }
    }
    return out
}

/// Writes the text of one `%` conversion, for the letter `spec`.
/// One `%` conversion's text.
fun format_spec(out: mut String, spec: u8, lt: LocalTime) {
    if spec == 89 {
        if lt.year < 0 {
            out.push('-')
            push_pad(out = out, value = -lt.year.to_i64(), width = 4)
        } else {
            push_pad(out = out, value = lt.year.to_i64(), width = 4)
        }
    } elif spec == 109 {
        push_pad(out = out, value = lt.month.to_i64(), width = 2)
    } elif spec == 100 {
        push_pad(out = out, value = lt.day.to_i64(), width = 2)
    } elif spec == 72 {
        push_pad(out = out, value = lt.hour.to_i64(), width = 2)
    } elif spec == 77 {
        push_pad(out = out, value = lt.minute.to_i64(), width = 2)
    } elif spec == 83 {
        push_pad(out = out, value = lt.second.to_i64(), width = 2)
    } elif spec == 106 {
        push_pad(out = out, value = lt.yday.to_i64(), width = 3)
    } elif spec == 122 {
        var secs = lt.offset.seconds.to_i64()
        if secs < 0 {
            out.push('-')
            secs = -secs
        } else {
            out.push('+')
        }
        push_pad(out = out, value = secs / SECS_HOUR, width = 2)
        push_pad(out = out, value = (secs % SECS_HOUR) / SECS_MINUTE, width = 2)
    } elif spec == 90 {
        out.push_str(lt.offset.abbrev)
    } elif spec == 97 {
        push_three(out = out, table = WDAY_NAMES, index = lt.weekday)
    } elif spec == 98 {
        push_three(out = out, table = MONTH_NAMES, index = lt.month - 1)
    } elif spec == 37 {
        out.push('%')
    } else {
        out.push('%')
        out.push(spec)
    }
}

/// Appends `value` in decimal, padded on the left with zeros to `width` digits.
/// `value` in `width` decimal digits at least, zero-filled on the left.
fun push_pad(out: mut String, value: i64, width: int) {
    val digits = str.from_i64(value)
    var pad: int = 0
    if width > digits.len() {
        pad = width - digits.len()
    }
    var i: int = 0
    while i < pad {
        out.push('0')
        i = i + 1
    }
    out.push_str(digits)
}

/// Appends the three bytes of `table` at entry `index`.
/// Three bytes of `table` at `index`, the shape `%a` and `%b` print.
fun push_three(out: mut String, table: &str, index: i32) {
    val base = index * 3
    var k: i32 = 0
    while k < 3 {
        out.push(str.byte(table, (base + k).to_int()))
        k = k + 1
    }
}
