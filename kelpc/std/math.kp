/* std/math — arithmetic and the C library's transcendentals (M6.3).

   Two things here exist because the plan needed them: `const` (PI/E/TAU are
   compile-time values, not globals) and argument-type overloading
   (`abs`/`min`/`max`/`clamp` are declared once per numeric type and resolved
   at the call site by the argument's type — a rule available only to
   compiler-shipped modules, so user code gains no new complexity).

   The library functions are one-line externs: `sqrt` in C is already the
   function `sqrt`, and writing it in Kelp would mean reimplementing it. */

const PI: f64 = 3.141592653589793
const E: f64 = 2.718281828459045
const TAU: f64 = 6.283185307179586

extern fun sqrt_raw(x: f64).R: f64
extern fun pow_raw(base: f64, exp: f64).R: f64
extern fun floor_raw(x: f64).R: f64
extern fun ceil_raw(x: f64).R: f64
extern fun round_raw(x: f64).R: f64
extern fun trunc_raw(x: f64).R: f64
extern fun exp_raw(x: f64).R: f64
extern fun ln_raw(x: f64).R: f64
extern fun log2_raw(x: f64).R: f64
extern fun log10_raw(x: f64).R: f64
extern fun sin_raw(x: f64).R: f64
extern fun cos_raw(x: f64).R: f64
extern fun tan_raw(x: f64).R: f64
extern fun atan2_raw(y: f64, x: f64).R: f64
extern fun is_nan_raw(x: f64).R: bool
extern fun is_finite_raw(x: f64).R: bool

fun sqrt(x: f64).R: f64 = sqrt_raw(x)
fun pow(base: f64, exp: f64).R: f64 = pow_raw(base, exp)
fun floor(x: f64).R: f64 = floor_raw(x)
fun ceil(x: f64).R: f64 = ceil_raw(x)
fun round(x: f64).R: f64 = round_raw(x)
fun trunc(x: f64).R: f64 = trunc_raw(x)
fun exp(x: f64).R: f64 = exp_raw(x)
fun ln(x: f64).R: f64 = ln_raw(x)
fun log2(x: f64).R: f64 = log2_raw(x)
fun log10(x: f64).R: f64 = log10_raw(x)
fun sin(x: f64).R: f64 = sin_raw(x)
fun cos(x: f64).R: f64 = cos_raw(x)
fun tan(x: f64).R: f64 = tan_raw(x)
fun atan2(y: f64, x: f64).R: f64 = atan2_raw(y, x)
fun is_nan(x: f64).R: bool = is_nan_raw(x)
fun is_finite(x: f64).R: bool = is_finite_raw(x)

// `sign` is f64-only: an integer `sign` would return an integer, which is a
// different function, and nothing needs it yet.
fun sign(x: f64).R: f64 = if x < 0.0 { -1.0 } else { if x > 0.0 { 1.0 } else { 0.0 } }

// ---- overloaded -----------------------------------------------------------
// Same name, one declaration per numeric type. `infer.rs` picks the overload
// whose parameter types all match the first argument's type; the rule is
// gated to compiler-shipped modules (`is_std_module`), so it is invisible to
// user code and implies no user-defined overloading.

fun abs(x: i32).R: i32 = if x < 0 { -x } else { x }
fun abs(x: i64).R: i64 = if x < 0 { -x } else { x }
fun abs(x: f64).R: f64 = if x < 0.0 { -x } else { x }

fun min(a: i32, b: i32).R: i32 = if a < b { a } else { b }
fun min(a: i64, b: i64).R: i64 = if a < b { a } else { b }
fun min(a: f64, b: f64).R: f64 = if a < b { a } else { b }

fun max(a: i32, b: i32).R: i32 = if a > b { a } else { b }
fun max(a: i64, b: i64).R: i64 = if a > b { a } else { b }
fun max(a: f64, b: f64).R: f64 = if a > b { a } else { b }

fun clamp(x: i32, lo: i32, hi: i32).R: i32 = if x < lo { lo } else { if x > hi { hi } else { x } }
fun clamp(x: i64, lo: i64, hi: i64).R: i64 = if x < lo { lo } else { if x > hi { hi } else { x } }
fun clamp(x: f64, lo: f64, hi: f64).R: f64 = if x < lo { lo } else { if x > hi { hi } else { x } }
