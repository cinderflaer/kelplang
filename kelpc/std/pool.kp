/* std/pool: a thread pool (`kelp wiki page stdlib/sync.md` section 4, `kelp wiki page stdlib/sync.md`), in
   Kelp over `Mutex`/`Condvar` and `thread.spawn`. It is its own module because a
   module cannot call its own builtins by name (`thread.spawn` is reached through
   `impl "std/thread"`):

       fun pool.new(workers: i32) => Pool
       fun Pool.spawn(job: move closure fun())
       fun Pool.join()
       fun Pool.panicked() => i32

   `pool.new(n)` starts `n` worker threads that pull jobs from one FIFO queue.
   `spawn` queues a job (a closure that may capture values it owns: they move
   into the job), `join` stops accepting work, waits until every queued job has
   run and every worker has exited, and `Drop` calls it, so a pool that goes out
   of scope shuts down cleanly. A job that panics is counted in `panicked()` and
   does not take its worker with it.

   How a panic is survived: a Kelp panic ends the thread it happens in
   (`pthread_exit`, which runs the mutex cleanup handlers), and there is no
   unwinding to resume a frame. So the worker runs each job on a thread of its
   own and joins it; `Err` from that join is the panic, the worker counts it and
   takes the next job. The worker slot survives, and a poisoned lock or an
   abandoned frame is exactly what a panic in a plain `thread.spawn` leaves. A
   thread-local `jmp_buf` that `kelp_panic` could jump to was rejected: a
   `longjmp` out of a job would skip the cleanup handlers a `Mutex.lock` block
   pushed, leaving the mutex locked and unpoisoned.

   The job queue is a `Mutex<List<Job>>` that is only touched while the
   state mutex is held; a job reaches it through `Mutex.swap` for the reason the
   channel does (a scoped block cannot capture an owned value by move). */
impl "std/option"
impl "std/result"
impl "std/sync"
impl "std/thread"


/// The counters a pool and its workers share, guarded by the pool's `meta` mutex.
datac PoolMeta(
    /// Jobs waiting in the queue.
    var queued: usize,
    /// Jobs a worker is running now.
    var running: usize,
    /// Set by `join`: no more jobs are accepted.
    var stop: bool,
    /// Jobs that have panicked so far.
    var panicked: i32,
    /// Workers that have not exited yet.
    var alive: i32
)

/// A queued job, the closure a worker runs. The closure sits in a one-field `datac`
/// because a closure cannot be a list element.
datac Job(
    /// The closure to run.
    val run: closure fun()
)

/// The state a pool shares with its workers: the counters, the job queue and the
/// two condition variables.
datac PoolShared(
    /// The counters, guarded by this mutex.
    val meta: Mutex<PoolMeta>,
    /// The FIFO queue of jobs no worker has taken yet.
    val jobs: Mutex<List<Job>>,
    /// Signalled when a job is queued or the pool stops.
    val work: Condvar,
    /// Signalled when a job ends or a worker exits.
    val done: Condvar
)

/// A handle to the same pool state, for one more worker.
fun PoolShared.dup() => PoolShared {
    return PoolShared(meta = self.meta.share(), jobs = self.jobs.share(), work = self.work.share(), done = self.done.share())
}

/// A thread pool. Build one with `new`, queue work with `spawn`, and wait for it
/// with `join`. Dropping the pool joins it.
datac Pool(
    /// The state shared with the pool's workers.
    val shared: PoolShared
)

/// Runs one job. A worker starts it on a thread of its own, so a panic stays in that thread.
fun run_job(job: move Job) {
    val f = job.run
    f()
}

/// The worker loop: takes jobs from the queue until `join` stops the pool, and counts
/// each job that panics.
fun pool_worker(sh: move PoolShared) {
    var running = true
    while running {
        val job = sh.meta.wait_while(&sh.work, fun(s: &PoolMeta) => bool = s.queued == 0 && !s.stop) { s ->
            if s.queued > 0 {
                s.queued -= 1
                s.running += 1
                var jobs = sh.jobs.swap(List.empty())
                val first = jobs.remove(0)
                val none = sh.jobs.swap(jobs)
                option.Option.Some(value = first)
            } else {
                val nothing: option.Option<Job> = option.Option.None
                nothing
            }
        }
        when job {
            Some(f) -> {
                val h = thread.spawn(run_job, f)
                var failed = false
                when thread.join(h) {
                    Ok(_) -> {}
                    Err(_) -> failed = true
                }
                sh.meta.lock { s ->
                    s.running -= 1
                    if failed {
                        s.panicked += 1
                    }
                }
                sh.done.notify_all()
            }
            None -> running = false
        }
    }
    sh.meta.lock { s -> s.alive -= 1 }
    sh.done.notify_all()
}

/// Starts a pool of `workers` threads. The workers run until `join`.
///
/// Panics: if `workers` is less than 1.
fun new(workers: i32) => Pool {
    if workers < 1 {
        panic("pool.new: a pool needs at least one worker")
    }
    val meta = Mutex.new(PoolMeta(queued = 0, running = 0, stop = false, panicked = 0, alive = workers))
    val jobs: Mutex<List<Job>> = Mutex.new(List.empty())
    val shared = PoolShared(meta = meta, jobs = jobs, work = Condvar.new(), done = Condvar.new())
    var i: i32 = 0
    while i < workers {
        val h = thread.spawn(pool_worker, shared.dup())
        i += 1
    }
    return Pool(shared = shared)
}

/// Queues `job`. It runs on some worker, in FIFO order.
///
/// Panics: if the pool has been joined.
fun Pool.spawn(job: move closure fun()) {
    val staged: Mutex<List<Job>> = Mutex.new(List.of(Job(run = job)))
    val open = self.shared.meta.lock { s ->
        if s.stop {
            false
        } else {
            s.queued += 1
            var mine = staged.swap(List.empty())
            var jobs = self.shared.jobs.swap(List.empty())
            jobs.push(mine.remove(0))
            val none = self.shared.jobs.swap(jobs)
            true
        }
    }
    if !open {
        panic("Pool.spawn: the pool has been joined")
    }
    self.shared.work.notify_one()
}

/// Stops taking work, runs everything still queued, and waits for every worker to
/// exit. Safe to call twice; `Drop` calls it.
fun Pool.join() {
    self.shared.meta.lock { s -> s.stop = true }
    self.shared.work.notify_all()
    self.shared.meta.wait_while(&self.shared.done, fun(s: &PoolMeta) => bool = s.alive > 0) { s -> 0 }
}

/// How many jobs have panicked so far. A panicking job does not stop its worker.
fun Pool.panicked() => i32 {
    return self.shared.meta.lock { s -> s.panicked }
}

/// Joins the pool, so dropping it runs every queued job first.
fun mut Pool.drop() {
    self.join()
}
