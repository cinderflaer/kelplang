impl "std/io"
impl "std/result"
impl "std/str"

// std/process, running other programs (S2). Gated on the `process`
// capability.
//
// The grant names the *program*: `spawn`/`run` take the executable as a
// separate first argument, never as `argv[0]`, because that is what makes the
// capability check meaningful, one absolute path matched against the
// module's allowlist before the fork happens. The arguments are not checked
// and are not part of the grant: `process = ["/bin/sh"]` lets a module run
// `/bin/sh`, and what it then asks it to do is the module's business (which
// is why a shell is a broad grant to hand out).
//
// The check refuses anything that is not absolute, since it normalizes before
// it matches, so `execvp`'s `PATH` search is unreachable through this API and
// a bare program name is a *denial*, not a lookup. A caller that found a tool
// on `PATH` has to pass the absolute path it resolved; that is what makes the
// check a statement about one file.
//
// The check resolves symlinks before matching, like `fs` and unlike `net`:
// on a NixOS machine `/bin/sh` is a link into `/nix/store`, so the grant has
// to name the *resolved* path (`/nix/store/**`), not the name the caller
// wrote. That is the same rule `fs` follows, and for the same reason, a link
// is not a name the author chose.
//
// The primitives C supplies are fork/exec, pipe, waitpid, kill, `chdir` in the
// child, three path pre-checks and the saved `argv` globals; everything a
// caller sees is ordinary Kelp.

extern fun arg_at_raw(i: int) => String
extern fun spawn_raw(dir: &str, program: &str, args: List<String>, pid: mut i32, stdin_fd: mut i32, stdout_fd: mut i32, stderr_fd: mut i32)
extern fun spawn_inherit_raw(dir: &str, program: &str, args: List<String>, pid: mut i32)
extern fun reap_raw(pid: i32, block: bool, signal: mut i32) => i32
extern fun kill_raw(pid: i32, signal: i32)
extern fun exit_raw(code: i32)
extern fun exists_raw(path: &str) => bool
extern fun is_dir_raw(path: &str) => bool

/// A running (or finished) child. Its three streams are ordinary `File`s, so
/// `std/io` is the whole API for talking to it: write to `stdin`, read from
/// `stdout`, poll either. Nothing closes them on drop, a `Child` that goes
/// out of scope leaks three descriptors and, if it was never waited for, one
/// zombie.
///
/// `exited`/`code` are the wait state, so `is_running` and `wait` agree with
/// each other and a second `wait` is not a second `waitpid` on a reaped pid.
/// `signal` is the signal that killed the child, or 0 when it exited by itself;
/// `code` is then `128 + signal`, which a child's own `exit(143)` shares, so
/// `signal` is the field that tells the two apart.
datac Child(
    /// The child's process id.
    val pid: i32,
    /// The child's standard input. Write to it to feed the child.
    val stdin: io.File,
    /// The child's standard output. Read from it to see what the child wrote.
    val stdout: io.File,
    /// The child's standard error. Read from it to see the child's diagnostics.
    val stderr: io.File,
    /// True once the child has been waited for. `code` and `signal` are valid then.
    var exited: bool,
    /// The exit status, or `128 + signal` when the child was killed.
    var code: i32,
    /// The signal that killed the child, or 0 when it exited by itself.
    var signal: i32,
)

/// A finished child: its exit code, and everything it wrote to each stream,
/// buffered whole. Both streams are captured at once because a child that
/// fills its stderr pipe and blocks would deadlock a reader that drained only
/// stdout. The memory cost is the sum of the two streams; a program with
/// unbounded output should use `spawn` and read incrementally.
datac RunResult(
    /// The exit status, or `128 + signal` when the child was killed.
    val code: i32,
    /// The signal that killed the child, or 0 when it exited by itself.
    val signal: i32,
    /// Everything the child wrote to its standard output.
    val out: Bytes,
    /// Everything the child wrote to its standard error.
    val err: Bytes
)

/// Why a fallible start refused to run a program (MK5-S2-M2), the same conditions
/// the panicking forms report, as values a caller can branch on.
///
/// Each one is decided *before* the fork by a `stat`/`access` pre-check, which
/// is what keeps it honest: none of them can be confused with a program that
/// ran and exited with a matching code, and none of them means the child ever
/// started.
///
/// The one condition deliberately absent is "program is outside the grant".
/// That refusal is the compiler's, it happens at the *call site* before any of
/// this runs, and it panics: the check is compiled in per calling module and
/// has no value-returning form. It is also the one failure that is a manifest
/// error rather than a runtime condition, the grant named the wrong program,
/// which is why the panicking shape is the honest one for it. Making it a value
/// needs a non-panicking check mode in codegen (recorded in the Backlog part of `kelp wiki page meta/roadmap.md`,
/// "What the port hit").
enum ProcErr {
    /// The program does not exist.
    NotFound
    /// The program is not a regular file this process can execute.
    NotExecutable
    /// The working directory does not exist or is not a directory.
    DirNotFound
}

/// This process's own argv, including `argv[0]`.
///
/// Reading argv is itself behind the `process` gate: a grant with no patterns
/// (`caps(process = [])`) is enough to name `process.args`, since there is
/// no resource argument to match.
fun args() => List<String> {
    var out: List<String> = List.empty()
    val n = arg_count_raw()
    var i: int = 0
    while i < n {
        out.push(arg_at_raw(i))
        i = i + 1
    }
    return out
}

/// Retired (#375): the camelCase `argCount` is the name. Kept for one cycle.
fun arg_count() => int = argCount()

/// The number of entries in `args()`, `argv[0]` included.
extern fun argCount() => int = "arg_count_raw"

/// Starts `program` with `args` (not including the program itself), with the
/// child's working directory set to `dir`, and three fresh pipes. An empty
/// `dir` keeps the parent's working directory, and that is what `spawn` passes.
///
/// `chdir` runs in the *child*, between `fork` and `exec`, so the parent's own
/// directory is unchanged and no grant pattern's meaning moves, which is what
/// makes a per-call directory expressible at all, given that v1 still has no
/// process-wide `chdir`. `dir` is not a resource and is not checked against the
/// grant: a child's working directory changes the meaning of its own relative
/// paths only, and every grant pattern is absolute. A `dir` the child cannot
/// enter ends the child with code **126** and a message on its stderr, before
/// `exec`; 126 is reserved for that case, the way 127 is reserved for a failed
/// `exec`.
///
/// `program` is resolved by `execvp`, but the grant check has already refused
/// anything that is not absolute, so the `PATH` search never runs: the caller
/// passes the absolute path it resolved itself.
///
/// A failed `exec` is not a panic here, the child reports it on its own stderr
/// and exits 127, which is what `run` returns as the code.
///
/// Panics: if `program` is not absolute, is outside the granted capability, or
/// a pipe or the fork fails.
fun spawn(program: &str, args: List<String>, dir: &str = "") => Child {
    var pid: i32 = 0
    var in_fd: i32 = 0
    var out_fd: i32 = 0
    var err_fd: i32 = 0
    spawn_raw(
        dir,
        program,
        args,
        pid = pid,
        stdin_fd = in_fd,
        stdout_fd = out_fd,
        stderr_fd = err_fd,
    )
    return Child(
        pid = pid,
        stdin = io.File(fd = in_fd),
        stdout = io.File(fd = out_fd),
        stderr = io.File(fd = err_fd),
        exited = false,
        code = 0,
        signal = 0,
    )
}

/// Retired (#375): the camelCase `spawnIn` is the name. Kept for one cycle.
fun spawn_in(dir: &str, program: &str, args: List<String>) => Child = spawnIn(dir, program, args)

/// As `spawn` with `dir` written first. Kept for one cycle (issue #296).
fun spawnIn(dir: &str, program: &str, args: List<String>) => Child = spawn(program, args, dir)

/// Runs `program` to completion with its stdin closed and both output streams
/// captured, from the working directory `dir` (empty means the parent's).
///
/// A `dir` that is not a directory, and a program given as a path that does not
/// exist or is not executable, are the `Err` (`ProcErr`), decided before the
/// fork, so an `Err` always means the child never started. A program that starts and exits nonzero
/// is an `Ok` carrying its code. A caller who wants a panic writes
/// `result.expect(process.run(program, args), "...")`.
///
/// Panics: a `program` outside the granted capability (or a relative one, which
/// the check refuses), and a pipe or fork failure.
fun run(program: &str, args: List<String>, dir: &str = "") => result.Result<RunResult, ProcErr> {
    if !str.is_empty(dir) && !is_dir_raw(dir) {
        return result.Result.Err(error = ProcErr.DirNotFound)
    }
    // A bare name is looked up on PATH by the child, as it always was, and a
    // missing one exits 127 rather than failing here. A path is checked first.
    if str.indexOf(program, "/").isSome() {
        if !exists_raw(program) {
            return result.Result.Err(error = ProcErr.NotFound)
        }
        if !executable_raw(program) {
            return result.Result.Err(error = ProcErr.NotExecutable)
        }
    }
    return result.Result.Ok(value = run_captured(program, args, dir))
}

/// The capture of `run` once the program is known to start: it panics where
/// `spawn` does, and `run` has already refused the cases that are values.
fun run_captured(program: &str, args: List<String>, dir: &str) => RunResult {
    var child = spawn(program, args, dir)
    child.stdin.close()
    var out = Bytes.empty()
    var err = Bytes.empty()
    var out_open = true
    var err_open = true
    // Poll both pipes in turn: a 50 ms slice on each means neither can fill
    // and block the child while the other is being drained, and the loop ends
    // as soon as both report end of file. The timeout only paces the wait,
    // a long-lived child is still waited for indefinitely.
    while out_open || err_open {
        if out_open {
            if child.stdout.waitReadable(50) {
                val got = child.stdout.read(8192)
                if got.is_empty() {
                    out_open = false
                    child.stdout.close()
                } else {
                    out.append(got)
                }
            }
        }
        if err_open {
            if child.stderr.waitReadable(50) {
                val got = child.stderr.read(8192)
                if got.is_empty() {
                    err_open = false
                    child.stderr.close()
                } else {
                    err.append(got)
                }
            }
        }
    }
    val code = child.wait()
    return RunResult(code = code, signal = child.signal, out = out, err = err)
}

/// Retired (#375): the camelCase `runIn` is the name. Kept for one cycle.
fun run_in(dir: &str, program: &str, args: List<String>) => result.Result<RunResult, ProcErr> = runIn(dir, program, args)

/// As `run` with `dir` written first (issue #296).
fun runIn(dir: &str, program: &str, args: List<String>) => result.Result<RunResult, ProcErr> = run(program, args, dir)

/// Retired (#375): the camelCase `runInherit` is the name. Kept for one cycle.
fun run_inherit(program: &str, args: List<String>, dir: &str = "") => RunResult = runInherit(program, args, dir)

/// As `run_in`, but the child inherits this process's stdin, stdout and stderr
/// instead of getting pipes: its output appears as it is written, its two
/// streams interleave in the order it wrote them, and a child that asks
/// `isatty` sees what the parent sees. Nothing is captured, so the returned
/// `out` and `err` are empty; `code` and `signal` are the child's, as for `run`.
/// The parent's buffered output is flushed before the fork.
///
/// Panics: as `run_in`.
fun runInherit(program: &str, args: List<String>, dir: &str = "") => RunResult {
    var pid: i32 = 0
    spawn_inherit_raw(dir, program, args, pid = pid)
    var sig: i32 = 0
    val code = reap_raw(pid, true, &mut sig)
    return RunResult(code = code, signal = sig, out = Bytes.empty(), err = Bytes.empty())
}

/// Retired (#375): the camelCase `runInheritIn` is the name. Kept for one cycle.
fun run_inherit_in(dir: &str, program: &str, args: List<String>) => RunResult = runInheritIn(dir, program, args)

/// As `run_inherit` with `dir` written first. Kept for one cycle (issue #296).
fun runInheritIn(dir: &str, program: &str, args: List<String>) => RunResult = runInherit(program, args, dir)

/// Whether `program` is a regular file that could be executed: it exists, it is
/// not a directory or a dangling link, and it carries an execute bit for this
/// process. This is the pre-check `run` makes, and it is not the capability
/// check, that one is the compiler's, at the call site.
///
/// Because it takes a path, naming a program here is checked against the grant
/// like every other resource argument.
extern fun executable(program: &str) => bool = "executable_raw"

/// Retired (issue #264): the plain `run` returns this result. Kept for one cycle.
fun try_run(program: &str, args: List<String>, dir: &str = "") => result.Result<RunResult, ProcErr> = run(program, args, dir)

/// Retired (issue #264): the plain `run_in` returns this result. Kept for one cycle (issue #296).
fun try_run_in(dir: &str, program: &str, args: List<String>) => result.Result<RunResult, ProcErr> = runIn(dir, program, args)

/// Blocks until the child exits and returns its code: the exit status, or
/// `128 + signal` when it was killed (`signal` then holds the signal number).
/// A second call returns the first result rather than waiting again.
///
/// Panics: if `waitpid` fails.
fun mut Child.wait() => i32 {
    if exited {
        return code
    }
    var sig: i32 = 0
    code = reap_raw(pid, true, &mut sig)
    signal = sig
    exited = true
    return code
}

/// Retired (#375): the camelCase `isRunning` is the name. Kept for one cycle.
fun mut Child.is_running() => bool = self.isRunning()

/// Whether the child still runs. This is a non-blocking `waitpid`, so it also
/// *observes* an exit: after it returns false, `wait` returns the recorded
/// code without blocking.
///
/// Panics: if `waitpid` fails.
fun mut Child.isRunning() => bool {
    if exited {
        return false
    }
    var sig: i32 = 0
    val r = reap_raw(pid, false, &mut sig)
    if r == -1 {
        return true
    }
    code = r
    signal = sig
    exited = true
    return false
}

/// Sends `signal` to the child. `child.kill(9)` is SIGKILL; the signal
/// number is POSIX's, since translating names would need a table v1 has no
/// place to put.
///
/// Panics: if the signal cannot be sent.
fun Child.kill(signal: i32) {
    kill_raw(pid, signal)
}

/// Ends this process with `code`, immediately and without unwinding. Nothing
/// is flushed or freed: this is `exit(3)` from the C runtime, not a panic. This is
/// a process's authority over itself, so it needs no capability.
fun exit(code: i32) {
    exit_raw(code)
}

/// This process's id.
extern fun getpid() => i64 = "getpid_raw"
