impl "std/io"

// std/process — running other programs (S2). Gated on the `process`
// capability.
//
// The grant names the *program*: `spawn`/`run` take the executable as a
// separate first argument, never as `argv[0]`, because that is what makes the
// capability check meaningful — one absolute path matched against the
// module's allowlist before the fork happens. The arguments are not checked
// and are not part of the grant: `process = ["/bin/sh"]` lets a module run
// `/bin/sh`, and what it then asks it to do is the module's business (which
// is why a shell is a broad grant to hand out).
//
// The check resolves symlinks before matching, like `fs` and unlike `net`:
// on a NixOS machine `/bin/sh` is a link into `/nix/store`, so the grant has
// to name the *resolved* path (`/nix/store/**`), not the name the caller
// wrote. That is the same rule `fs` follows, and for the same reason — a link
// is not a name the author chose.
//
// The primitives C supplies are fork/exec, pipe, waitpid, kill and the saved
// `argv` globals; `spawn` and `run` themselves are ordinary Kelp.

extern fun arg_count_raw().R: usize
extern fun arg_at_raw(i: usize).R: String
extern fun spawn_raw(program: &str, args: List<String>, pid: mut i32, stdin_fd: mut i32, stdout_fd: mut i32, stderr_fd: mut i32)
extern fun reap_raw(pid: i32, block: bool).R: i32
extern fun kill_raw(pid: i32, signal: i32)
extern fun exit_raw(code: i32)
extern fun getpid_raw().R: i64

// A running (or finished) child. Its three streams are ordinary `File`s, so
// `std/io` is the whole API for talking to it: write to `stdin`, read from
// `stdout`, poll either. Nothing closes them on drop — a `Child` that goes
// out of scope leaks three descriptors and, if it was never waited for, one
// zombie.
//
// `exited`/`code` are the wait state, so `is_running` and `wait` agree with
// each other and a second `wait` is not a second `waitpid` on a reaped pid.
datac Child(
    val pid: i32,
    val stdin: io.File,
    val stdout: io.File,
    val stderr: io.File,
    var exited: bool,
    var code: i32,
)

// A finished child: its exit code, and everything it wrote to each stream,
// buffered whole. Both streams are captured at once because a child that
// fills its stderr pipe and blocks would deadlock a reader that drained only
// stdout. The memory cost is the sum of the two streams; a program with
// unbounded output should use `spawn` and read incrementally.
datac RunResult(val code: i32, val out: Bytes, val err: Bytes)

// This process's own argv, including `argv[0]`.
//
// Reading argv is itself behind the `process` gate: a grant with no patterns
// (`with caps(process = [])`) is enough to name `process.args`, since there is
// no resource argument to match.
fun args().R: List<String> {
    var out: List<String> = List.empty()
    val n = arg_count_raw()
    var i: usize = 0
    while i < n {
        out.push(arg_at_raw(i))
        i = i + 1
    }
    return out
}

fun arg_count().R: usize = arg_count_raw()

// Starts `program` with `args` (not including the program itself) and three
// fresh pipes. The child's stdin is the write end of one, its stdout and
// stderr the read ends of the others; the parent's ends of those are closed
// before this returns, so the child sees end of file as soon as the caller
// closes `stdin`.
//
// `program` is resolved by `execvp`, so a bare name searches `PATH`. The
// capability check happens *before* the fork: a program outside the grant
// never starts. A failed `exec` is not a panic here — the child reports it on
// its own stderr and exits 127, which is what `run` returns as the code.
//
// Panics: if `program` is not absolute, is outside the granted capability, or
// a pipe or the fork fails.
fun spawn(program: &str, args: List<String>).R: Child {
    var pid: i32 = 0
    var in_fd: i32 = 0
    var out_fd: i32 = 0
    var err_fd: i32 = 0
    spawn_raw(
        program,
        args,
        pid = pid,
        stdin_fd = in_fd,
        stdout_fd = out_fd,
        stderr_fd = err_fd,
    )
    return Child(
        pid = pid,
        stdin = io.File(fd = in_fd),
        stdout = io.File(fd = out_fd),
        stderr = io.File(fd = err_fd),
        exited = false,
        code = 0,
    )
}

// Runs `program` to completion with its stdin closed and both output streams
// captured. There is deliberately no `chdir` in v1: a process-wide working
// directory would make every grant pattern's meaning depend on mutable global
// state. A `spawn_in(dir, ...)` can arrive later if a real program needs one —
// and one did: Coral runs `git`/`cargo` inside specific directories, which
// `chdir` in the *child* (between `fork` and `exec`) answers without touching
// the parent's directory or any grant pattern's meaning. That, and the
// fallible shape for the panics below, are recorded in `backlog.md`, "What the
// port hit".
//
// Panics: as `spawn`. A *missing* binary is not one of them — the child's
// `execvp` fails, the child exits 127, and that is the code returned here; what
// panics is a `program` that is not absolute or is outside the grant, and a
// pipe or fork failure.
fun run(program: &str, args: List<String>).R: RunResult {
    var child = spawn(program, args)
    child.stdin.close()
    var out = Bytes.empty()
    var err = Bytes.empty()
    var out_open = true
    var err_open = true
    // Poll both pipes in turn: a 50 ms slice on each means neither can fill
    // and block the child while the other is being drained, and the loop ends
    // as soon as both report end of file. The timeout only paces the wait —
    // a long-lived child is still waited for indefinitely.
    while out_open || err_open {
        if out_open {
            if child.stdout.wait_readable(50) {
                val got = child.stdout.read(8192)
                if got.is_empty() {
                    out_open = false
                    child.stdout.close()
                } else {
                    out.append(got)
                }
            }
        }
        if err_open {
            if child.stderr.wait_readable(50) {
                val got = child.stderr.read(8192)
                if got.is_empty() {
                    err_open = false
                    child.stderr.close()
                } else {
                    err.append(got)
                }
            }
        }
    }
    val code = child.wait()
    return RunResult(code = code, out = out, err = err)
}

// Blocks until the child exits and returns its code: the exit status, or
// `128 + signal` when it was killed. A second call returns the first result
// rather than waiting again.
//
// Panics: if `waitpid` fails.
fun mut Child.wait().R: i32 {
    if exited {
        return code
    }
    code = reap_raw(pid, true)
    exited = true
    return code
}

// Whether the child still runs. This is a non-blocking `waitpid`, so it also
// *observes* an exit — after it returns false, `wait` returns the recorded
// code without blocking.
//
// Panics: if `waitpid` fails.
fun mut Child.is_running().R: bool {
    if exited {
        return false
    }
    val r = reap_raw(pid, false)
    if r == -1 {
        return true
    }
    code = r
    exited = true
    return false
}

// Sends `signal` to the child. `process.kill(pid, 9)` is SIGKILL; the signal
// number is POSIX's, since translating names would need a table v1 has no
// place to put.
//
// Panics: if the signal cannot be sent.
fun Child.kill(signal: i32) {
    kill_raw(pid, signal)
}

// Ends this process with `code`, immediately and without unwinding. Nothing
// is flushed or freed — `exit(3)` from the C runtime, not a panic. This is a
// process's authority over itself, so it needs no capability.
fun exit(code: i32) {
    exit_raw(code)
}

fun getpid().R: i64 = getpid_raw()
