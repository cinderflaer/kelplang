impl "std/fs"
impl "std/tls"
impl "std/result"
impl "std/str"

/* std/tlsfile: the file-reading layer over `std/tls`'s PEM-bytes functions
   (st3, `kelp wiki page stdlib/tls.md`).

   Why a module of its own: reading a file is the `fs` capability, and a
   module that names `fs.try_read` needs the `fs` grant from every program that
   imports it. `std/tls` is imported by every `https` client through
   `std/http`, so it cannot hold `std/fs`; this module can, because only a
   program that wants to load certificates from disk imports it, and it grants
   exactly the directory it means:

       impl "std/tlsfile" caps(fs = ["/etc/myapp/certs/..."])

   (a path pattern ending in the usual double-star wildcard)

   A file that cannot be read is `TlsError.Io` with the path and the system's
   reason; everything else is `std/tls`'s own typed error. A private key is
   never put in an error text. `read_pem` does not look at a key file's
   permissions; `read_key` (below) refuses one that group or others can read or
   write, so a key left at `0644` is a typed error rather than a silent leak. */

/// Reads the PEM bytes in `path` through the `fs` gate. A file that cannot be
/// read is `TlsError.Io` with the path and the system's reason. `what` names the
/// file's role for the sentence ("private key").
fun read_pem(path: &str, what: &str) => result.Result<Bytes, tls.TlsError> {
    return when fs.try_read(path) {
        Ok(b) -> result.Result.Ok(value = b)
        Err(e) -> {
            var text = String.with_capacity(96)
            text.push_str("tls: cannot read the ")
            text.push_str(what)
            text.push_str(" file ")
            text.push_str(path)
            text.push_str(": ")
            text.push_str(e.message)
            result.Result.Err(error = tls.TlsError.Io(reason = text))
        }
    }
}

// The three reads a TLS setup needs, named for their role in the error text.
// The bytes go to `tls.server_config_pem`, `ServerOptions.require_client_cert_pem`
// and `TlsClientOptions.client_cert_pem`:
//
//     val cert = tlsfile.read_pem(cert_path, "certificate chain")?
//     val key = tlsfile.read_pem(key_path, "private key")?
//     val cfg = tls.server_config_pem(cert, key)?
//
// (This module only reads; it cannot call into `std/tls`, whose functions are
// `net`-gated and would need that grant here too.)

/// The private CA certificates in `path`, read through the `fs` gate: the
/// module's grant decides which paths are readable, exactly as for `fs.read`,
/// and a path outside it is a typed `TlsError.Io` (the file is never opened).
/// Hand the bytes to `TlsClientOptions.with_ca_pem`:
///
///     val ca = tlsfile.ca_pem(ca_path)?
///     val opts = tls.client_options().with_ca_pem(ca)
///
/// A program with no `fs` grant cannot import this module, so it cannot make
/// the TLS runtime read a path at all.
fun ca_pem(path: &str) => result.Result<Bytes, tls.TlsError> = read_pem(path, "CA certificate")

/// The error for a CA directory that cannot be listed, or that holds no CA certificate.
fun ca_dir_error(dir: &str, reason: &str) => tls.TlsError {
    var text = String.with_capacity(96)
    text.push_str("tls: the directory ")
    text.push_str(dir)
    text.push_str(reason)
    return tls.TlsError.Io(reason = text)
}

/// The names in the CA directory `dir`, through the `fs` gate, or the typed error.
fun ca_dir_names(dir: &str) => result.Result<List<String>, tls.TlsError> {
    return when fs.try_list(dir) {
        Ok(names) -> result.Result.Ok(value = names)
        Err(e) -> {
            val why = str.concat(" cannot be listed: ", e.message.as_str())
            result.Result.Err(error = ca_dir_error(dir, why.as_str()))
        }
    }
}

/// The private CA certificates in every `.pem` and `.crt` file directly inside
/// `dir`, joined into one PEM text, for `TlsClientOptions.with_ca_pem`:
///
///     val ca = tlsfile.ca_dir_pem("/etc/myapp/ca.d")?
///     val opts = tls.client_options().with_ca_pem(ca)
///
/// Every file is read through the `fs` gate, one path at a time, so the grant
/// decides which of them may be read, exactly as for `ca_pem`. Other files in the
/// directory are never opened. The order of the files does not matter: trust
/// is the set of certificates. A directory with no `.pem` or `.crt` file is a
/// typed `TlsError.Io`, not an empty set of extra roots, so a wrong path cannot
/// fall back to the system store without a word.
fun ca_dir_pem(dir: &str) => result.Result<Bytes, tls.TlsError> {
    val names = ca_dir_names(dir)?
    var out = Bytes.empty()
    var found = false
    for name in names {
        if str.ends_with(name.as_str(), ".pem") || str.ends_with(name.as_str(), ".crt") {
            val slash = str.concat(dir, "/")
            val path = str.concat(slash.as_str(), name.as_str())
            val pem = read_pem(path.as_str(), "CA certificate")?
            out.append(pem)
            found = true
        }
    }
    if !found {
        return result.Result.Err(error = ca_dir_error(dir, " holds no .pem or .crt CA certificate"))
    }
    return result.Result.Ok(value = out)
}

/// The octal digits of the low nine permission bits, as `0644` prints them.
fun mode_text(mode: u32) => String {
    val bits = mode & 511
    var out = String.with_capacity(4)
    out.push_str("0")
    val a = str.from_u64((bits >> 6).to_u64())
    val b = str.from_u64(((bits >> 3) & 7).to_u64())
    val c = str.from_u64((bits & 7).to_u64())
    out.push_str(a)
    out.push_str(b)
    out.push_str(c)
    return out
}

/// A private key file, read through the `fs` gate after its permissions are
/// checked: any group or other bit (`mode & 0077`) is `TlsError.Io` naming the
/// file and its mode, and the file is not read. Fix it with `chmod 600`. A
/// file that is missing or unreadable is the same `Io` as `read_pem`'s. Hand the
/// bytes to `tls.server_config_pem`:
///
///     val key = tlsfile.read_key(key_path)?
fun read_key(path: &str) => result.Result<Bytes, tls.TlsError> {
    if fs.exists(path) {
        val m = fs.metadata(path)
        if (m.mode & 63) != 0 {
            var text = String.with_capacity(128)
            text.push_str("tls: the private key file ")
            text.push_str(path)
            text.push_str(" has mode ")
            val shown = mode_text(m.mode)
            text.push_str(shown)
            text.push_str(": group and others must have no access (chmod 600)")
            return result.Result.Err(error = tls.TlsError.Io(reason = text))
        }
    }
    return read_pem(path, "private key")
}
