// std/option — `Option<T>`, and the helpers the language can express (MK5-S6-M1).
//
// The enum is the point. `Some`/`None` is one of the two shapes the `?`
// operator understands (`syntax.md` §5) and the shape `if let` branches on, so
// a function that can fail exactly one way returns `Option<T>` and its caller
// writes `val x = f(...)?`.
//
// The combinators take a function value (A-4) and read the payload through a
// *borrow*: `map`'s callback is `fun(&T).R: U`, not `fun(T).R: U`, because a
// `when` arm binds an owned payload as a shared borrow. That is also why they
// work at every instantiation — a `Copy` payload is copied into the arm and
// auto-borrowed at the call, an owned one is already a borrow.
//
// What is deliberately absent, and why:
//
// - Anything that hands the payload *out* by value needs a move out of the
//   enum, and v1's `when` binds a payload as a borrow: so `unwrap_or`/`unwrap`
//   are offered for a `Copy` payload and are a compile error at any other
//   instantiation — the same rule `List.get` follows, and the reason there is
//   no `Option<String>.unwrap()`. `or_else` is in the same group: rebuilding
//   `Some` from the payload it was handed needs a copy.
// - `ok_or` (turning an `Option` into a `Result`) would have to move its
//   payload into `Ok`, which is that same missing piece.

enum Option<T> {
    Some(val value: T)
    None
}

// Whether the option holds a value.
fun is_some<T>(o: &Option<T>).R: bool = when o {
    Some(_) -> true
    None -> false
}

// Whether the option is empty.
fun is_none<T>(o: &Option<T>).R: bool = when o {
    Some(_) -> false
    None -> true
}

// The payload, or `fallback`. `T` must be `Copy`: the payload is borrowed, so
// an owned one cannot be handed out (use `if let`/`when` and read it through
// the borrow instead).
fun unwrap_or<T>(o: &Option<T>, fallback: T).R: T = when o {
    Some(v) -> v
    None -> fallback
}

// The payload, or a panic naming the call. `T` must be `Copy`, for the same
// reason `unwrap_or`'s must be.
fun unwrap<T>(o: &Option<T>).R: T {
    if let Some(v) = o {
        return v
    }
    panic("Option.unwrap: value is None")
}

// The payload, or a panic carrying `message` — the form the stdlib uses, where
// the message names the operation that failed rather than the accessor.
// `T` must be `Copy`.
fun expect<T>(o: &Option<T>, message: &str).R: T {
    if let Some(v) = o {
        return v
    }
    panic(message)
}

// Transform the payload through `f`, or pass `None` through. The callback
// borrows the payload, so this works for any `T`: the result is a fresh `U`.
fun map<T, U>(o: &Option<T>, f: fun(&T).R: U).R: Option<U> = when o {
    Some(v) -> Option.Some(value = f(v))
    None -> Option.None
}

// Chain a second fallible step: `and_then`'s callback returns an `Option`
// itself, which is what makes a sequence of fallible steps readable without
// nesting `if let`. Works for any `T`, for the same reason `map` does.
fun and_then<T, U>(o: &Option<T>, f: fun(&T).R: Option<U>).R: Option<U> = when o {
    Some(v) -> f(v)
    None -> Option.None
}

// The option, or `f()` when it is empty. `T` must be `Copy`: the `Some` arm
// rebuilds the payload out of the borrow it was handed, which is a copy.
fun or_else<T>(o: &Option<T>, f: fun().R: Option<T>).R: Option<T> = when o {
    Some(v) -> Option.Some(value = v)
    None -> f()
}

// Run `f` over the payload, if there is one, and discard the result — the
// `Unit` case of `map`, written as its own call so a side effect reads like
// one. Works for any `T`.
fun each<T>(o: &Option<T>, f: fun(&T)) {
    when o {
        Some(v) -> f(v)
        None -> {}
    }
}
