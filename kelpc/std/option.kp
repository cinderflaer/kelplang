//! `Option<T>`: a value that may be absent, with its helpers.
/* std/option, `Option<T>`, and the helpers the language can express (MK5-S6-M1).

   The enum is the point. `Some`/`None` is one of the two shapes the `?`
   operator understands (`syntax.md` §5) and the shape `if let` branches on, so
   a function that can fail exactly one way returns `Option<T>` and its caller
   writes `val x = f(...)?`.

   The combinators take a callback (A-4) and read the payload through a
   *borrow*: `map`'s callback is `closure(&T) => U`, not `closure(T) => U`,
   because a `when` arm over a borrow binds the payload as a shared borrow,
   never by value. That is also why they work at every instantiation: a `Copy`
   payload is copied into the arm and auto-borrowed at the call, an owned one is
   already a borrow.

   The callback is a *closure* (A-4 phase E), so it may capture a binding from
   the frame that passes it. A plain function value is widened into one at the
   call, through a generated shim, so passing a declared `fun` still allocates
   nothing.

   A helper that hands the payload *out* by value takes the option with `move`
   (A-11): `unwrap`, `expect` and `unwrap_or` read the payload of an owned
   option, which is a partial move of the local the caller gave up, and that is
   what makes `Option<String>.unwrap()` work. The move form is the caller's
   contract too: the option is consumed, so a caller that wants to keep it
   passes a fresh expression or matches it for a tag test only (a pattern that
   binds an owned payload takes it out just as `unwrap` does).

   What is deliberately absent, and why:

   - `ok_or` (turning an `Option` into a `Result`) would have to move its
     payload into `Ok`, and its receiver is a borrow (`?` and `if let` cover
     the same ground without giving the option up).
   - `or_else` rebuilds `Some` from the payload it was handed, and its receiver
     is a borrow, so it stays `Copy`-only: an owned payload has to come out of
     an owned option, which is `unwrap_or`. */

/// A value that may be absent: `Some` holds it, `None` does not.
enum Option<T> {
    /// The value is present.
    Some(val value: T)
    /// There is no value.
    None
}

/// Whether the option holds a value.
fun is_some<T>(o: &Option<T>) => bool = when o {
    Some(_) -> true
    None -> false
}

/// Whether the option is empty.
fun is_none<T>(o: &Option<T>) => bool = when o {
    Some(_) -> false
    None -> true
}

/// The payload, or `fallback`. The option is taken with `move`, because either
/// answer is the caller's value: an owned payload is moved out and `fallback` is
/// handed on as it was given.
fun unwrap_or<T>(o: move Option<T>, fallback: move T) => T = when o {
    Some(v) -> v
    None -> fallback
}

/// The payload, or a panic naming the call. The option is taken with `move`,
/// for the same reason `unwrap_or`'s is.
fun unwrap<T>(o: move Option<T>) => T {
    if let Some(v) = o {
        return v
    }
    panic("Option.unwrap: value is None")
}

/// The payload, or a panic carrying `message`, the form the stdlib uses, where
/// the message names the operation that failed rather than the accessor. The
/// option is taken with `move`, for the same reason `unwrap_or`'s is.
fun expect<T>(o: move Option<T>, message: &str) => T {
    if let Some(v) = o {
        return v
    }
    panic(message)
}

/// Transform the payload through `f`, or pass `None` through. The callback
/// borrows the payload, so this works for any `T`: the result is a fresh `U`.
fun map<T, U>(o: &Option<T>, f: closure(&T) => U) => Option<U> = when o {
    Some(v) -> Option.Some(value = f(v))
    None -> Option.None
}

/// Chain a second fallible step: `and_then`'s callback returns an `Option`
/// itself, which is what makes a sequence of fallible steps readable without
/// nesting `if let`. Works for any `T`, for the same reason `map` does.
fun and_then<T, U>(o: &Option<T>, f: closure(&T) => Option<U>) => Option<U> = when o {
    Some(v) -> f(v)
    None -> Option.None
}

/// The option, or `f()` when it is empty. `T` must be `Copy`: the receiver is a
/// borrow and the `Some` arm rebuilds the payload out of it, which is a copy;
/// an owned payload comes out with `unwrap_or`, which takes the option with
/// `move`.
fun or_else<T>(o: &Option<T>, f: closure() => Option<T>) => Option<T> = when o {
    Some(v) -> Option.Some(value = v)
    None -> f()
}

/// Run `f` over the payload, if there is one, and discard the result, the
/// `Unit` case of `map`, written as its own call so a side effect reads like
/// one. Works for any `T`.
fun each<T>(o: &Option<T>, f: closure(&T)) {
    when o {
        Some(v) -> f(v)
        None -> {}
    }
}

// ---- method forms ----
//
// The borrowing helpers above, also callable on a value: `o.map(f)` is
// `option.map(o, f)`. The ones that take the option with `move`
// (`unwrap_or`, `unwrap`, `expect`) stay free functions: a method always
// borrows its receiver.

/// `o.is_some()`.
fun Option<T>.is_some() => bool = is_some(self)

/// `o.is_none()`.
fun Option<T>.is_none() => bool = is_none(self)

/// `o.map(f)`: see `map`.
fun Option<T>.map<U>(f: closure(&T) => U) => Option<U> = map(self, f)

/// `o.and_then(f)`: see `and_then`.
fun Option<T>.and_then<U>(f: closure(&T) => Option<U>) => Option<U> = and_then(self, f)

/// `o.or_else(f)`: see `or_else`.
fun Option<T>.or_else(f: closure() => Option<T>) => Option<T> = or_else(self, f)

/// `o.each(f)`: see `each`.
fun Option<T>.each(f: closure(&T)) {
    each(self, f)
}
