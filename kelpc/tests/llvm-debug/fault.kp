// The fixture of MK7 S4 (the MK7 record in `plan/done.md`): a program whose
// job is to fault, so a fault address exists for `gdb` to resolve to a `.kp`
// line.
//
// The fault is a signed division by a run-time zero, which traps with SIGFPE on
// this target. The divisor must be a value the pipeline cannot fold: at `-O2`
// (MK7 S6) a constant `0` is propagated, the division is removed as undefined
// behavior, and the program exits cleanly with no fault to place. `zero` is
// therefore `str.parse_i64("0")` unwrapped, whose body is an `extern` C object
// the LLVM pass pipeline cannot see into, so the `idiv` really executes. The
// faulting instruction belongs to the `return` of `divide` below.
impl "std/str"
impl "std/result"

fun divide(dividend: i64, divisor: i64).R: i64 {
    return dividend / divisor
}

fun main() {
    val zero: i64 = result.unwrap(str.parse_i64("0"))
    print(divide(10, zero))
}
