// Kernel gap 4's acceptance program. A 4 KiB `datac` copied by value and a
// `[u8; 4096]` array copied whole are the two shapes whose lowering is a
// library `mem*` call rather than a handful of registers; before the compiler
// emitted weak loop fallbacks of its own, this project linked with an undefined
// one and `ld.lld` refused it. The entry loops forever so nothing has to
// terminate: the test's claim is about what the object and the image contain,
// not about stdout.

datac Big(val bytes: [u8; 4096])

section(".text.boot") fun kmain() {
    var page = Big(bytes = [0; 4096])
    var copy: Big = page
    var arr: [u8; 4096] = [7; 4096]
    var arr2: [u8; 4096] = arr
    var acc: u64 = 1
    while true {
        acc = acc * 3 + copy.bytes.get(0).to_u64() + arr2.get(4095).to_u64()
    }
}
