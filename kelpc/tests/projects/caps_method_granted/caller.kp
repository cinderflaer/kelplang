impl "std/io"
impl "std/process"

pub fun probe().R: bool {
    var c = process.Child(
        pid = 1,
        stdin = io.File(fd = 0),
        stdout = io.File(fd = 1),
        stderr = io.File(fd = 2),
        exited = true,
        code = 7,
        signal = 0,
    )
    return c.wait() == 7 && !c.is_running()
}
