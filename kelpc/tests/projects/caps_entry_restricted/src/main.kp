// C-2: main calls 'fs' functions directly, inside the one pattern its own
// coral.toml [caps] section grants it. A successful run pins that a
// [caps]-restricted entry module can still reach what it *was* granted, not
// only that it is denied what it was not (caps_entry_ungranted,
// caps_entry_pattern_denied).
impl "std/fs"

fun main() {
    val note = "__KELP_SCRATCH__/kelp_caps_entry_restricted/note.txt"
    fs.write_text(note, String.from_str("hi"))
    print(fs.exists(note))
    val contents = fs.read_text(note)
    print(contents.as_str())
}
