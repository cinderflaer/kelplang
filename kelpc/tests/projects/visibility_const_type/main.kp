impl "lib"

// A-13 private-in-public: a `const`'s written type is part of what it
// states, and `lib` does not export `Hidden`. The same-module spelling of
// this position is not expressible at all, because the canonical order puts
// every `const` before every `datac` in a file, so the type is pinned
// through another module's private type.
pub const LIMIT: lib.Hidden = 0

fun main() {
    print(1)
}
