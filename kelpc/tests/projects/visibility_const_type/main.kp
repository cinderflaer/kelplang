impl "lib"

// A-13 private-in-public: a `const`'s written type is part of what it
// states, and `lib` does not export `Hidden`. A `const` may name a type
// from its own module (`pub const LIMIT: Hidden` with `datac Hidden` later
// in the file parses, and the rule refuses that one too), so this fixture
// pins the cross-module spelling, which reaches `Hidden` through the alias.
pub const LIMIT: lib.Hidden = 0

fun main() {
    print(1)
}
