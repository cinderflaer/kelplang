// Gap 1: "Block" is the base handle and "Buffer" a child. "malloc" returns a
// "Buffer" and "free" takes any "Block", so a "Buffer" argument upcasts to
// "Block" at the call. "view" reinterprets a "Block" back down to "Buffer"
// with no runtime check.
pub extern type Block
pub extern type Buffer: Block

pub extern fun malloc(size: usize).return: Buffer
pub extern fun free(block: Block)

pub fun view(block: Block).return: Buffer = Buffer.cast(block)
