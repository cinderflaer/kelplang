// MISSING-p5Xtr: `Response.retry_after()` and `Response.rate_limit()`. A
// `429` naming a delay and a spent bucket, then a plain `200` that names
// none of these headers, the second request is the "absent, not a panic"
// half of the fixture.
//
// The grant names the host as the URL spells it (S3's rule): `127.0.0.1`
// covers every port on it.
impl "std/http" caps(net = ["127.0.0.1:*"])
impl "std/process"
impl "std/str"
impl "std/result"
impl "std/option"

fun hdrs() => List<http.Header> {
    var l: List<http.Header> = List.empty()
    return l
}

// The harness passes the canned server's port as the first argument.
fun server_port() => u16 {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "server_port: argv[1] is not a port number",
    )
    return p.to_u16()
}

fun url_for(path: &str) => String {
    val port_text = str.from_u64(server_port().to_u64())
    var out = String.with_capacity(64)
    out.push_str("http://127.0.0.1:")
    out.push_str(port_text)
    out.push_str(path)
    return out
}

fun req_for(path: &str) => http.Request {
    val url = url_for(path)
    return http.Request(
        method = String.from_str("GET"),
        url = url,
        headers = hdrs(),
        body = Bytes.empty(),
    )
}

fun print_u64_opt(o: option.Option<u64>) {
    if let Some(v) = o {
        print(v)
    } else {
        print("none")
    }
}

fun print_f64_opt(o: option.Option<f64>) {
    if let Some(v) = o {
        print(v)
    } else {
        print("none")
    }
}

fun print_str_opt(o: option.Option<String>) {
    if let Some(v) = o {
        print(v)
    } else {
        print("none")
    }
}

fun main() {
    var pool = http.pool("127.0.0.1", server_port())

    // A 429 naming a delay and a spent per-route bucket.
    val limited = pool.send(req_for("/limited"))
    print(limited.status)
    print_u64_opt(limited.retry_after())
    val rl = limited.rate_limit()
    print_u64_opt(rl.limit)
    print_u64_opt(rl.remaining)
    print_f64_opt(rl.reset)
    print_f64_opt(rl.reset_after)
    print_str_opt(rl.bucket)

    // A plain 200 with none of these headers: absence reads clean, not as a
    // panic, and it is not confused with a present-but-zero header (the 429
    // above already showed `remaining = 0` printing as `0`, not `none`).
    val plain = pool.send(req_for("/plain"))
    print(plain.status)
    print_u64_opt(plain.retry_after())
    val rl2 = plain.rate_limit()
    print_u64_opt(rl2.limit)
    print_u64_opt(rl2.remaining)
    print_f64_opt(rl2.reset)
    print_f64_opt(rl2.reset_after)
    print_str_opt(rl2.bucket)

    pool.close_all()
}
