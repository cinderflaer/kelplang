impl "std/fs"
impl "std/result"

// The call counter decides which path the next call to `mk()` names, so the
// program itself shows whether the argument was read once or twice.
pd var n: i32 = 0

// Prints on every call, so a stdout with one `SIDE` is proof that the argument
// was evaluated once. Inside the grant the first time, `/etc/passwd` the second:
// the two evaluations a check-then-call pair would make differ, and the second
// is out of the grant.
fun mk() => str {
    print("SIDE")
    n = n + 1
    if n == 1 {
        return "__KELP_SCRATCH__/kelp_caps_double_eval/a"
    }
    return "/etc/passwd"
}

pub fun inside_once() => String = result.expect(fs.readText(mk()), "fs.read_text: the call failed")

// The control: a path out of the grant, the same on every evaluation.
pub fun outside() => String = result.expect(fs.readText("/etc/passwd"), "fs.read_text: the call failed")
