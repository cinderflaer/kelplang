impl "errors"
impl "std/result"

fun failing().return: result.Result<i32, errors.IoErr> {
    return result.Result.Err(error = errors.IoErr.Bad(code = 13))
}

fun outer().return: result.Result<i32, errors.AppErr> {
    val v = failing()?
    return result.Result.Ok(value = v)
}

fun main() {
    val r = outer()
    print(result.is_err(r = r))
}
