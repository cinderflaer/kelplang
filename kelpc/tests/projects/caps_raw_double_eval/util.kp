impl "std/fs"

// The call counter decides which path the next call to `mk()` names, so the
// program itself shows whether the argument was read once or twice.
pd var n: i32 = 0

fun mk() => str {
    print("SIDE")
    n = n + 1
    if n == 1 {
        return "__KELP_SCRATCH__/kelp_caps_raw_double_eval/a"
    }
    return "/etc/passwd"
}

pub fun inside_once() => int = fs.read_raw(mk()).len()

// The control: out of the grant on every evaluation, so the check denies and
// the denial names the primitive's own call site.
pub fun outside() => int = fs.read_raw("/etc/passwd").len()
