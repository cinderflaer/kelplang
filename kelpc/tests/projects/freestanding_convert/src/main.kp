impl "std/convert"
impl "std/result"
impl "uart" caps(mmio = ["0x10000000+0x100"])

enum IoErr {
    Bad(val code: i32)
}

datac AppErr(val code: i32)

impl convert.From<IoErr> for AppErr {
    fun from(value: IoErr).return: AppErr {
        return when value {
            Bad(code) -> AppErr(code = code + 100)
        }
    }
}

fun failing().return: result.Result<i32, IoErr> {
    return result.Result.Err(error = IoErr.Bad(code = 7))
}

fun outer().return: result.Result<i32, AppErr> {
    val v = failing()?
    return result.Result.Ok(value = v)
}

fun put_num(value: usize) {
    if value == 0 {
        uart.putc(48)
        return
    }
    var digits: [u8; 20] = [0; 20]
    var i: usize = 20
    var v: usize = value
    while v > 0 {
        i = i - 1
        digits.set(i = i, v = (48 + (v % 10)).to_u8())
        v = v / 10
    }
    while i < 20 {
        uart.putc(digits.get(i = i))
        i = i + 1
    }
}

fun line(label: str, value: usize) {
    uart.puts(label)
    put_num(value)
    uart.puts("\n")
}

section(".text.boot") fun kmain() {
    val r = outer()
    when r {
        Err(error) -> line(label = "converted ", value = error.code.to_usize())
        Ok(value) -> line(label = "ok ", value = value.to_usize())
    }
    uart.puts("done\n")
    uart.halt()
}

// The handler `[target] panic` names: a check that fires stops with the
// compiler's own message on the wire.
fun kp_panic(msg: str) {
    uart.puts("panic: ")
    uart.puts(msg)
    uart.puts("\n")
    uart.halt()
}
