// MK9-S1-M1 (roadmap B-1): main delegates the "env" domain coral.toml
// assigned "helper" to it, then calls the FFI-bound `kelp_pkg_triple(14)`.
// `pkg_config = "kelptest"` in the manifest supplies the `-I` that makes the
// generated C find `kelp_pkg_helper.h` and compile.
impl "helper" caps(env = ["*"])

fun main() {
    print(helper.kelp_pkg_triple(14))
}
