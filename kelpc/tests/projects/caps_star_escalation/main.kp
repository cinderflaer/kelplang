// `main` holds everything, but it delegates `mid` only one narrow `fs`
// pattern. `mid` then writes `caps(*)`, claiming the whole resource of every
// domain: it holds no wildcard, so the grant is refused and the refusal names
// the wildcard it claimed rather than one pattern.
impl "mid" caps(fs = ["/tmp/kelp_caps_star_esc/**"])

fun main() {
    print(mid.probe())
}
