// The `env` bodies are real (MK5-S5): read a granted name, and set/read/unset
// another. The grant covers exactly the two names used.
impl "std/str"
impl "std/env"

pub fun has_home().return: bool = env.has("HOME")

pub fun get_home_nonempty().return: bool {
    val v = env.get("HOME")
    return str.len(v.as_str()) > 0
}

pub fun set_read_unset().return: bool {
    env.set("KELP_ENV_PROBE", "value")
    val v = env.get("KELP_ENV_PROBE")
    val ok = str.eq(v.as_str(), "value")
    env.unset("KELP_ENV_PROBE")
    return ok && !env.has("KELP_ENV_PROBE")
}
