// Gap 4: a callback closure crossing into native code. The helper calls its
// callback twice and then its `destroy` notify, so the printed order proves the
// thunk reordered the native `(args..., user_data)` into the closure's own
// `(env, args...)`, and the environment the first closure captured an owned
// `String` into is freed exactly once. The second call passes a plain function
// value: it widens to a closure with no environment, which the destructor still
// frees the box for. Under AddressSanitizer (see `compile_and_run.rs`) a leaked
// or double-freed environment fails this fixture.
impl "helper" caps(env = ["*"])

fun plain(x: i32) {
    print(x)
}

fun main() {
    val tag = String.from_str("cb")
    val f = fun(x: i32) {
        print(tag.len())
        print(x)
    }
    print(helper.kelp_call_twice(f, 3))
    print(helper.kelp_call_twice(plain, 8))
}
