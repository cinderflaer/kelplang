impl "std/fs"
impl "std/io"
impl "std/process"

pub fun open_mode_ok().R: bool {
    val fd = fs.open_raw("__KELP_SCRATCH__/kelp_caps_raw_positions/note.txt", "r")
    val ok = fd >= 0
    io.File(fd = fd).close()
    return ok
}

// The directory `/tmp` is outside the grant on purpose: it is the child's
// working directory, which no pattern governs, and the granted program is
// argument 1.
pub fun spawn_raw_ok().R: bool {
    var pid: i32 = 0
    var fd_in: i32 = 0
    var fd_out: i32 = 1
    var fd_err: i32 = 2
    var args: List<String> = List.empty()
    args.push(String.from_str("-c"))
    args.push(String.from_str("exit 3"))
    process.spawn_raw("/tmp", "/bin/sh", args, pid, fd_in, fd_out, fd_err)
    return pid > 0
}
