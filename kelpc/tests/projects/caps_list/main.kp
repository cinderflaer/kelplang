// Collections behind the gate: `fs.list` returns a `List<String>`. The grant
// covers one scratch directory; the program clears it first (a recursive
// remove built on `fs.list` itself), then creates, lists and removes known
// contents, so the run is repeatable and depends on nothing already on disk.
impl "std/str"
impl "std/fs" caps(fs = ["__KELP_SCRATCH__/kelp_caps_list_test/**"])
impl "std/result"

fun path_of(dir: &str, name: &str) => String {
    var parts: List<String> = List.empty()
    parts.push(String.from_str(dir))
    parts.push(String.from_str("/"))
    parts.push(String.from_str(name))
    return str.join(parts, "")
}

fun clear(dir: &str) {
    if fs.exists(dir) {
        val entries = result.expect(fs.list(dir), "fs.list: the call failed")
        var i: int = 0
        while i < entries.len() {
            val p = path_of(dir, entries.get(i).as_str())
            if fs.is_dir(p) {
                clear(p)
            } else {
                result.expect(fs.remove(p), "fs.remove: the call failed")
            }
            i = i + 1
        }
        result.expect(fs.remove(dir), "fs.remove: the call failed")
    }
}

fun main() {
    val dir = "__KELP_SCRATCH__/kelp_caps_list_test"
    clear(dir)
    fs.mkdir(dir)
    result.expect(fs.write_text("__KELP_SCRATCH__/kelp_caps_list_test/b.txt", String.from_str("b")), "fs.write_text: the call failed")
    result.expect(fs.write_text("__KELP_SCRATCH__/kelp_caps_list_test/a.txt", String.from_str("a")), "fs.write_text: the call failed")
    fs.mkdir("__KELP_SCRATCH__/kelp_caps_list_test/sub")

    val entries = result.expect(fs.list(dir), "fs.list: the call failed")
    print(entries.len())
    print(str.join(entries, sep = ","))
    var i: int = 0
    while i < entries.len() {
        print!(entries.get(i).as_str())
        print!(" ")
        i = i + 1
    }
    print("")

    clear(dir)
    print(fs.exists(dir))
}
