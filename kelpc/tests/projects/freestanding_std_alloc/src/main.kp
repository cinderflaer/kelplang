impl "std/list"
impl "std/option"
impl "std/result"
impl "std/str"

static mut ARENA: [u8; 65536] = [0; 65536]
static mut USED: usize = 0

fun align_up(value: usize, align: usize) => usize {
    return ((value + align - 1) / align) * align
}

fun alloc(size: usize, align: usize) => Ptr<u8> {
    val out: Ptr<u8> = unsafe {
        val start: usize = align_up(USED, align)
        if start + size > 65536 {
            Ptr.null()
        } else {
            USED = start + size
            val arena: Ptr<[u8; 65536]> = Ptr.from_mut(ARENA)
            arena.cast<u8>().byte_offset(start.to_isize())
        }
    }
    return out
}

fun dealloc(p: Ptr<u8>, _size: usize, _align: usize) {
    unsafe {
        if p.is_null() == false {
            USED = USED
        }
    }
}

fun is_one(v: &i32) => bool {
    return v == 1
}

section(".text.boot") fun kmain() {
    var xs: List<i32> = List.empty()
    xs.push(1)

    // A declared `fun` widens into the callback closure, and a literal that
    // captures a local owns a heap environment; both are the allocator's.
    val any = list.any(xs = &xs, f = is_one)
    var factor: i32 = 3
    val doubled = list.map(xs = &xs, f = fun(x: &i32) => i32 = x * factor)
    val filtered = list.filter(xs = &xs, f = fun(x: &i32) => bool = x > 0)

    val text = str.from_u64(n = 42)
    val joined = str.concat(a = text.as_str(), b = "!")
    var s: String = joined.clone()
    s.push_str("?")

    val o: option.Option<i32> = option.Option.Some(value = 1)
    val mapped = o.map(fun(v: &i32) => i32 = v + 1)
    val r: result.Result<i32, i32> = result.Result.Ok(value = 1)
    val lifted = result.map(r = r, f = fun(v: &i32) => i32 = v + 1)

    var n: int = doubled.len() + filtered.len() + s.len()
    if any && option.isSome(o = &mapped) && result.isOk(r = &lifted) {
        n = n + 1
    }
    while true { n = n + 1 }
}
