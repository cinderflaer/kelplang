// Kernel stage 2 (MK9-S1-M2): the packed datac's size, alignment and field
// offsets. A packed struct of a u8, a u32 and a u16 is 7 bytes, aligned to 1,
// with `length` at byte 1 and `flags` at byte 5.
impl "helper"

fun main() {
    print(size_of<helper.Packed>())
    print(align_of<helper.Packed>())
    print(offset_of<helper.Packed>("length"))
    print(offset_of<helper.Packed>("flags"))
}
