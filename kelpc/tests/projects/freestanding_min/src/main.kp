// A freestanding entry point that does nothing but loop: the smallest program
// the LLVM backend can emit an ELF for that references no libc symbol and no
// runtime helper. `i` is perturbed each pass so the loop has no exit the
// optimizer can turn into a return.
//
// The `section(...)` clauses are the stage's other half: the entry goes in
// `.text.boot` (placed first by the linker script) and the integer-array const
// in `.rodata.boot`, so the script's placement is what the test reads back out
// of the ELF.
//
// A trait is exercised here on purpose (A-12 slice 2): dispatch is static, so
// the step below is an ordinary direct call and a bare-metal image grows no
// vtable, no witness and no undefined symbol for it.
trait Step {
    fun Self.step(v: u64).R: u64
}

datac Thrice(val factor: u64)

impl Step for Thrice {
    fun Self.step(v: u64).R: u64 = v * factor
}

section(".rodata.boot") const BOOT_MAGIC: [u8; 4] = [75, 69, 76, 80]

section(".text.boot") fun kmain() {
    val thrice = Thrice(factor = 3)
    var i: u64 = 1
    while true {
        i = thrice.step(i) + BOOT_MAGIC.get(i = 0).to_u64()
    }
}
