impl "std/process"

fun spawn_outside() {
    var pid: i32 = 0
    var fd_in: i32 = 0
    var fd_out: i32 = 1
    var fd_err: i32 = 2
    var args: List<String> = List.empty()
    args.push(String.from_str("-c"))
    args.push(String.from_str("exit 0"))
    process.spawn_raw(
        "/tmp/kelp_caps_raw_positions_denied",
        "/bin/sh",
        args,
        pid,
        fd_in,
        fd_out,
        fd_err,
    )
}
