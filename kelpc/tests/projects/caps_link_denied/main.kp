// The *target* of a symlink is a path like any other, so a link whose target
// is outside the grant is refused before `symlink(2)` runs. That is what keeps
// a grant closed under link creation: a module can only make a link whose
// target it could also name.
impl "util" caps(fs = ["__KELP_SCRATCH__/kelp_caps_link_denied/**"])

fun main() {
    util.escape()
}
