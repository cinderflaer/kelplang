impl "std/fs"

pub fun exercise() {
    val text = String.from_str("hello")
    fs.write_text("__KELP_SCRATCH__/kelp_caps_write/a.txt", text)
    print(fs.exists("__KELP_SCRATCH__/kelp_caps_write/a.txt"))
    print(fs.size("__KELP_SCRATCH__/kelp_caps_write/a.txt"))

    fs.rename("__KELP_SCRATCH__/kelp_caps_write/a.txt", "__KELP_SCRATCH__/kelp_caps_write/b.txt")
    print(fs.exists("__KELP_SCRATCH__/kelp_caps_write/a.txt"))
    val back = fs.read("__KELP_SCRATCH__/kelp_caps_write/b.txt")
    print(back)

    fs.remove("__KELP_SCRATCH__/kelp_caps_write/b.txt")
    print(fs.exists("__KELP_SCRATCH__/kelp_caps_write/b.txt"))

    fs.mkdir("__KELP_SCRATCH__/kelp_caps_write/sub")
    print(fs.is_dir("__KELP_SCRATCH__/kelp_caps_write/sub"))

    val bytes = Bytes.from_str("raw")
    fs.write("__KELP_SCRATCH__/kelp_caps_write/c.bin", bytes)
    print(fs.size("__KELP_SCRATCH__/kelp_caps_write/c.bin"))
}
