impl "std/fs"
impl "std/result"

pub fun exercise() {
    val text = String.from_str("hello")
    result.expect(fs.writeText("__KELP_SCRATCH__/kelp_caps_write/a.txt", text), "fs.write_text: the call failed")
    print(fs.exists("__KELP_SCRATCH__/kelp_caps_write/a.txt"))
    print(fs.size("__KELP_SCRATCH__/kelp_caps_write/a.txt"))

    result.expect(fs.rename("__KELP_SCRATCH__/kelp_caps_write/a.txt", "__KELP_SCRATCH__/kelp_caps_write/b.txt"), "fs.rename: the call failed")
    print(fs.exists("__KELP_SCRATCH__/kelp_caps_write/a.txt"))
    val back = result.expect(fs.read("__KELP_SCRATCH__/kelp_caps_write/b.txt"), "fs.read: the call failed")
    print(back)

    result.expect(fs.remove("__KELP_SCRATCH__/kelp_caps_write/b.txt"), "fs.remove: the call failed")
    print(fs.exists("__KELP_SCRATCH__/kelp_caps_write/b.txt"))

    fs.mkdir("__KELP_SCRATCH__/kelp_caps_write/sub")
    print(fs.isDir("__KELP_SCRATCH__/kelp_caps_write/sub"))

    val bytes = Bytes.from_str("raw")
    result.expect(fs.write("__KELP_SCRATCH__/kelp_caps_write/c.bin", bytes), "fs.write: the call failed")
    print(fs.size("__KELP_SCRATCH__/kelp_caps_write/c.bin"))
}
