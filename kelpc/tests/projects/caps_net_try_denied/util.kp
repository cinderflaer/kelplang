impl "std/net"

// As `caps_net_denied`'s `util`, with the fallible dial: this module holds
// `net` for `127.0.0.1:*` only, and `localhost` is the same machine under
// another name. The denial happens at the call site, before the dial, so the
// port need not be listening.
pub fun connect_by_another_name().return: i64 {
    val r = net.try_connect("localhost", 1)
    if let Ok(s) = r {
        net.close(s)
        return 0
    }
    return 1
}
