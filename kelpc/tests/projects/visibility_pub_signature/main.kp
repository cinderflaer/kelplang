impl "lib"
impl "std/option"

// The entry module's own exported type, named by an exported item.
pub datac Tag(val n: i32)

pub fun retag(t: Tag).return: Tag = Tag(n = t.n + 1)

// Another module's exported type, written through its alias.
pub fun shift(p: lib.Point).return: lib.Point = lib.Point(x = p.x + 1, y = p.y + 1)

// The generic instantiation on the far side of the boundary: `lib.Pair` is
// exported, so naming it with its arguments is naming an exported type.
pub fun first(p: lib.Pair<i32, i32>).return: i32 = p.a

// A compiler-shipped module exports every item (the transitional rule), so
// an exported signature may name one of its types.
pub fun count(o: option.Option<i32>).return: i32 {
    if let Some(v) = o {
        return v
    }
    return 0
}

fun main() {
    print(lib.origin().x)
    print(retag(t = Tag(n = 1)).n)
    print(shift(p = lib.Point(x = 1, y = 2)).x)
    print(first(p = lib.Pair(a = 5, b = 6)))
    print(count(o = option.Option.Some(value = 4)))
    print(lib.reveal(n = 7))
}
