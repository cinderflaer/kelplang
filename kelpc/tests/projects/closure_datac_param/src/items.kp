// A library's own type in a callback signature: the generated closure type is
// named after the parameter type, which for a module-qualified `&Item` is the
// case that used to mangle into `refitems.Item`, not a C identifier.
pub datac Item(val n: i64)

pub fun each(items: &List<Item>, f: closure(&Item)) {
    var i: usize = 0
    while i < items.len() {
        f(items.get(i))
        i += 1
    }
}

pub fun any_big(items: &List<Item>, f: closure(&Item) => bool) => bool {
    var i: usize = 0
    while i < items.len() {
        if f(items.get(i)) {
            return true
        }
        i += 1
    }
    false
}
