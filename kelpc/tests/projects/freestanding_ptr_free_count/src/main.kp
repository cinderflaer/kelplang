// `Ptr.free_count(count)` on a freestanding build with the allocator pair.
// The allocator pair: `coral.toml`'s `[target] alloc`/`dealloc` name the two
// functions below. `dealloc` records the byte size and alignment it receives,
// so the boot can show that `Ptr.free_count` hands back exactly what
// `Ptr.alloc` asked for.
impl "uart" caps(mmio = ["0x10000000+0x100"])

static mut HEAP: [u8; 256] = [0; 256]
static mut USED: usize = 0
static mut DEALLOCS: usize = 0
static mut LAST_BYTES: int = 0
static mut LAST_ALIGN: usize = 0

const HEAP_CAP: usize = 256

// The project's allocator. It returns an aligned pointer into `HEAP`, or the
// null pointer when the aligned request does not fit.
fun alloc(size: usize, align: usize) => Ptr<u8> {
    return unsafe {
        val misalign: usize = (USED % align)
        val padding: usize = (align - misalign) % align
        if padding > HEAP_CAP - USED {
            Ptr.null()
        } else {
            val start: usize = USED + padding
            if size > HEAP_CAP - start {
                Ptr.null()
            } else {
                USED = start + size
                val heap: Ptr<[u8; 256]> = Ptr.from_mut(HEAP)
                val base: Ptr<u8> = heap.cast<u8>()
                base.byte_offset(start.to_isize())
            }
        }
    }
}

// A bump allocator frees nothing, so `dealloc` only counts and records what it
// was given. A null pointer is not an allocation, so it is not counted.
fun dealloc(p: Ptr<u8>, size: usize, align: usize) {
    unsafe {
        if p.is_null() == false {
            DEALLOCS = DEALLOCS + 1
            LAST_BYTES = size.to_int()
            LAST_ALIGN = align
        }
    }
}

fun flag(value: bool) => int {
    if value {
        return 1
    }
    return 0
}

fun put_num(value: int) {
    if value == 0 {
        uart.putc(48)
        return
    }
    var digits: [u8; 20] = [0; 20]
    var i: int = 20
    var v: int = value
    while v > 0 {
        i = i - 1
        digits.set(i = i, v = (48 + (v % 10)).to_u8())
        v = v / 10
    }
    while i < 20 {
        uart.putc(digits.get(i = i))
        i = i + 1
    }
}

fun line(label: str, value: int) {
    uart.puts(label)
    put_num(value)
    uart.puts("\n")
}

// The handler `[target] panic` names.
fun kp_panic(msg: str) {
    uart.puts("panic: ")
    uart.puts(msg)
    uart.puts("\n")
    uart.halt()
}

section(".text.boot") fun kmain() {
    val p: Ptr<u32> = unsafe { Ptr.alloc<u32>(4) }
    line(label = "ptr ", value = flag(p.is_null()))
    unsafe {
        p.write(1234)
        line(label = "val ", value = p.read().to_int())
    }
    // Four u32 elements: the project's dealloc must get 16 bytes, aligned to 4.
    unsafe {
        p.free_count(4)
    }
    var bytes: int = 0
    var align: usize = 0
    var calls: int = 0
    unsafe {
        bytes = LAST_BYTES
        align = LAST_ALIGN
        calls = DEALLOCS.to_int()
    }
    line(label = "size ", value = bytes)
    line(label = "align ", value = align.to_int())
    line(label = "calls ", value = calls)
    // A null pointer owns no block, so freeing it reaches no dealloc.
    val nothing: Ptr<u32> = unsafe { Ptr.null() }
    unsafe {
        nothing.free_count(4)
        calls = DEALLOCS.to_int()
    }
    line(label = "null ", value = calls)
    uart.halt()
}
