impl "std/process"
impl "std/result"

fun sh(script: &str) => List<String> {
    var args: List<String> = List.empty()
    args.push(String.from_str("-c"))
    args.push(String.from_str(script))
    return args
}

pub fun run_sh(script: &str) => process.RunResult = result.expect(process.run("/bin/sh", sh(script)), "process.run: the call failed")

// A spawned child killed from outside reports the signal after `wait`.
pub fun spawn_killed() => i32 {
    var c = process.spawn("/bin/sh", sh("sleep 30"))
    c.kill(9)
    c.wait()
    return c.signal
}
