// Gap 1: an opaque handle is a pointer-sized Copy value with no readable
// contents and no arithmetic. It is legal here because coral.toml carries
// "[extern.\"mem\"]"; anywhere else the resolver refuses it. "malloc" returns
// one and "free" takes one back, both straight through the C trampoline.
pub extern type Buffer
pub extern fun malloc(size: int) => Buffer
pub extern fun free(buf: Buffer)
