// MK5-S5 fs breadth behind one grant: `mkdir_all`, `read_lines`, `metadata`,
// `copy`, `open`, `touch`, `walk`, `temp_path`, `remove_all`. The scratch
// directory is created and removed by the program, so the run depends on
// nothing already on disk.
impl "std/str"
impl "std/fs" caps(fs = ["/tmp/kelp_fs_breadth_test/**"])
impl "std/result"

fun main() {
    val root = "/tmp/kelp_fs_breadth_test"
    if fs.exists(root) {
        result.expect(fs.removeAll(root), "fs.remove_all: the call failed")
    }
    result.expect(fs.mkdirAll("/tmp/kelp_fs_breadth_test/a/b/c"), "fs.mkdir_all: the call failed")
    result.expect(fs.writeText("/tmp/kelp_fs_breadth_test/a/b/c/note.txt", String.from_str("line one\nline two\n")), "fs.write_text: the call failed")
    result.expect(fs.writeText("/tmp/kelp_fs_breadth_test/top.txt", String.from_str("top")), "fs.write_text: the call failed")

    val lines = fs.readLines("/tmp/kelp_fs_breadth_test/a/b/c/note.txt")
    print(lines.len())
    print(lines.get(0).as_str())
    print(lines.get(1).as_str())

    val m = fs.metadata("/tmp/kelp_fs_breadth_test/a/b/c/note.txt")
    print(m.size)
    print(m.is_file)
    print(m.is_dir)
    val d = fs.metadata("/tmp/kelp_fs_breadth_test/a")
    print(d.is_dir)
    print(d.is_file)

    fs.copy("/tmp/kelp_fs_breadth_test/top.txt", "/tmp/kelp_fs_breadth_test/copy.txt")
    {
        val f = result.expect(fs.open("/tmp/kelp_fs_breadth_test/copy.txt", "r"), "fs.open: the call failed")
        val data = f.readAll()
        print!(data.as_str())
        print("")
        f.close()
    }

    fs.touch("/tmp/kelp_fs_breadth_test/touched.txt")
    print(fs.exists("/tmp/kelp_fs_breadth_test/touched.txt"))

    val walked = fs.walk(root)
    print(walked.len())
    print(walked.get(walked.len() - 1).as_str())

    val tmp = fs.tempPath("/tmp/kelp_fs_breadth_test/tmp-")
    print(str.startsWith(tmp, "/tmp/kelp_fs_breadth_test/tmp-"))
    print(fs.isFile(tmp))

    result.expect(fs.removeAll(root), "fs.remove_all: the call failed")
    print(fs.exists(root))
}
