// Kernel stage 13's arena acceptance: a bare-metal riscv64 image that carves a
// static 4096-byte region into aligned allocations with the shipped
// `std/arena`, writes and reads sentinels through the returned pointers, checks
// the null answers exhaustion and an overflowing size give, and prints every
// result over the UART. The manifest configures no allocator: the arena is
// pure pointer arithmetic, so `std/arena` has to build here without one.
impl "uart"
impl "std/arena"

static mut ARENA: [u8; 4096] = [0; 4096]

fun flag(value: bool).R: usize {
    if value {
        return 1
    }
    return 0
}

fun put_num(value: usize) {
    if value == 0 {
        uart.putc(48)
        return
    }
    var digits: [u8; 20] = [0; 20]
    var i: usize = 20
    var v: usize = value
    while v > 0 {
        i = i - 1
        digits.set(i = i, v = (48 + (v % 10)).to_u8())
        v = v / 10
    }
    while i < 20 {
        uart.putc(digits.get(i = i))
        i = i + 1
    }
}

fun line(label: str, value: usize) {
    uart.puts(label)
    put_num(value)
    uart.puts("\n")
}

section(".text.boot") fun kmain() {
    val bp: Ptr<[u8; 4096]> = unsafe { Ptr.from_mut(ARENA) }
    val base: Ptr<u8> = bp.cast<u8>()
    var a: arena.Arena = arena.new(base = base, cap = 4096)

    // Bump alignment: a 3-byte request at align 16, then a 16-byte one at
    // align 64, so the second start is padded past the first.
    val p0: Ptr<u8> = a.alloc(size = 3, align = 16)
    val p1: Ptr<u8> = a.alloc(size = 16, align = 64)
    unsafe {
        p0.write(170)
        p1.write(187)
    }
    // The addresses are checked, not the offsets: `ARENA` is a `[u8; 4096]`
    // with no alignment of its own, so an arena that aligned only its offset
    // would answer 48 here, not 0.
    line(label = "p0 aligned ", value = flag(p0.addr() % 16 == 0))
    line(label = "p1 aligned ", value = flag(p1.addr() % 64 == 0))
    line(label = "ordered ", value = flag(p1.addr() > p0.addr()))
    line(label = "used seen ", value = flag(a.used() >= 3))
    line(label = "remain seen ", value = flag(a.remaining() <= 4096))
    unsafe {
        line(label = "read ", value = p0.read().to_usize())
    }

    // A request larger than what is left is the null pointer.
    val exhausted: Ptr<u8> = a.alloc(size = 4096, align = 1)
    line(label = "exhaust ", value = flag(exhausted.is_null()))

    // A size whose aligned end would wrap `usize` is the null pointer too.
    val max: usize = ~0
    val wrapped: Ptr<u8> = a.alloc(size = max, align = 1)
    line(label = "wrap ", value = flag(wrapped.is_null()))

    // `reset` makes the whole region available again.
    a.reset()
    line(label = "reset ", value = a.used())

    // `alloc_zeroed` hands back a block with every byte written to zero.
    val z: Ptr<u8> = a.alloc_zeroed(size = 4, align = 4)
    var sum: usize = 0
    unsafe {
        sum = z.read().to_usize() + z.offset(1).read().to_usize()
    }
    line(label = "zero ", value = sum)

    uart.halt()
}

// The handler `[target] panic` names: the arena's bad-align panic and every
// bounds and overflow check call it with the compiler's own message.
fun kp_panic(msg: str) {
    uart.puts("panic: ")
    uart.puts(msg)
    uart.puts("\n")
    uart.halt()
}
