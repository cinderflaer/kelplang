// The `View` operations the compiler lowers as byte loops: a slice of a `str`
// view, a byte read, and a length-aware comparison, all with no allocator.
fun kmain() {
    val v = "kelp".view()
    var n: int = v.len() + v.get(0).to_int()
    if v.slice(1, 3).eq("el".view()) {
        n = n + 1
    }
    while true { n = n + 1 }
}
