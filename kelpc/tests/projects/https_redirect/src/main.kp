// Release goal 1, hardening (case h): an `https` redirect to another local port.
// The harness starts two TLS servers with the same certificate, A answering `301`
// with an absolute `Location` on B. The follow-up is a second handshake on a
// second connection, and the body the program prints is B's own, so a redirect
// that kept the first connection, or dropped back to plain `http`, prints
// something else.
impl "std/http" caps(net = ["127.0.0.1:*"])
impl "std/process"
impl "std/result"
impl "std/str"

fun server_port() => u16 {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "server_port: argv[1] is not a port number",
    )
    return p.to_u16()
}

fun url_for(path: &str) => String {
    val port_text = str.from_u64(server_port().to_u64())
    var out = String.with_capacity(64)
    out.push_str("https://127.0.0.1:")
    out.push_str(port_text)
    out.push_str(path)
    return out
}

fun main() {
    val url = url_for("/start")
    val r = result.expect(http.get(url), "http.get: the call failed")
    print(r.status)
    print(r.body)
    print(r.is_ok())
}
