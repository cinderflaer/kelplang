// A-12 slice 4 in a bare-metal image: a trait with two implementations is
// dispatched through a `&dyn` (and a `&mut dyn`), and the output reaches the
// NS16550 UART. Nothing here allocates and nothing calls libc, which is what
// makes the vtables a `.rodata` table and the thunks ordinary code.
impl "std/str"
impl "uart" caps(mmio = ["0x10000000+0x100"])

trait Line {
    fun Self.write()
    fun Self.count() => i64
    fun mut Self.bump()
}

datac Hello()
datac Bye()

impl Line for Hello {
    fun Self.write() { uart.puts("hello from dyn\n") }
    fun Self.count() => i64 = 1
    fun mut Self.bump() { }
}

impl Line for Bye {
    fun Self.write() { uart.puts("bye from dyn\n") }
    fun Self.count() => i64 = 2
    fun mut Self.bump() { }
}

fun announce(l: &dyn Line) {
    l.write()
    uart.putc((b'0' + l.count().to_u8()))
    uart.putc(b'\n')
}

fun touch(l: &mut dyn Line) {
    l.bump()
}

section(".text.boot") fun kmain() {
    var h = Hello()
    val b = Bye()
    announce(&h)
    announce(&b)
    touch(&mut h)
    uart.halt()
}

fun kp_panic(msg: str) {
    uart.puts("panic: ")
    uart.puts(msg)
    uart.puts("\n")
    uart.halt()
}
