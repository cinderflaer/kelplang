// Kernel stage 12's rejection fixture: an allocator is configured, so `String`
// and its libc-free operations are legal, but `String.char_count` is not one of
// them, so the call is refused by name with "needs the hosted runtime".
static mut ARENA: [u8; 128] = [0; 128]

fun alloc(_size: usize, _align: usize) => Ptr<u8> {
    val arena: Ptr<[u8; 128]> = unsafe { Ptr.from_mut(ARENA) }
    val out: Ptr<u8> = arena.cast<u8>()
    return out
}

fun dealloc(_p: Ptr<u8>, _size: usize, _align: usize) {}

fun kmain() {
    val s = String.from_str("no")
    val n = s.char_count()
    if n == 2 {
    }
}
