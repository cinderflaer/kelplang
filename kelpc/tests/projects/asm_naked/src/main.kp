// Kernel stage 5: a `naked fun`'s whole body is one `asm`, and the asm returns:
// no prologue, no epilogue, no compiler-generated `ret`. The System V return
// register for an `i64` is `rax`, which is what the asm leaves 42 in, and the
// caller is an ordinary Kelp call.
naked fun forty_two() => i64 {
    asm("mov rax, 42\nret")
}

fun main() {
    print(forty_two())
}
