impl "std/io"
impl "std/process"

fun probe() => bool {
    var c = process.Child(
        pid = 1,
        stdin = io.File(fd = 0),
        stdout = io.File(fd = 1),
        stderr = io.File(fd = 2),
        exited = false,
        code = 0,
        signal = 0,
    )
    c.kill(signal = 0)
    return true
}
