// Gap 1: "fopen" returns a "File" that is null on failure, and "File.null()"
// is the null handle spelled directly. Both are tested with "is_null()",
// which is legal here because this module has an "[extern.\"file\"]" section.
pub extern type File

pub extern fun fopen(path: str, mode: str).R: File

pub fun missing().R: File = File.null()
pub fun is_null_file(f: File).R: bool = f.is_null()
