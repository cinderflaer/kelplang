// T45 twin: a body makes a Box, uses it only inside the body, and returns a
// number. The Box is a block value that never leaves the body, so the escape
// test accepts it.
fun count(n: i32) => i32 {
    val b = Box.of(n)
    return b.get() + 1
}

fun main() {
    print(count(4))
}
// stdout-begin
// stdout: 5
