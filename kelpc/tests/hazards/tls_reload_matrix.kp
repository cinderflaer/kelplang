// MISSING-Uc6Kj: encrypted keys, the key-file permission check and a live
// certificate reload. A hazard like `tls_server_matrix.kp`: it needs the PEM
// files `tests/tls_server.rs` makes (argv[2] is their directory) and it waits
// on sockets, every wait bounded. argv[1] is the scenario.
impl "std/net"
impl "std/process"
impl "std/str"
impl "std/fmt"
impl "std/result"
impl "std/option"
impl "std/thread"
impl "std/tls"
impl "std/tlsfile" caps(fs = ["/**"])

// Only scalars cross into the server thread: the descriptor and the round count.
datac Job(val fd: i32, val rounds: i32)

fun join3(a: &str, b: &str, c: &str) => String {
    var s = String.with_capacity(64)
    s.push_str(a)
    s.push_str(b)
    s.push_str(c)
    return s
}

fun path(dir: &str, name: &str) => String = join3(dir, "/", name)

fun say(s: &str) {
    print(s)
}

fun err_tag(e: &tls.TlsError) => String = when e {
    Untrusted -> String.from_str("untrusted")
    Expired -> String.from_str("expired")
    HostMismatch -> String.from_str("host_mismatch")
    ProtocolTooOld -> String.from_str("protocol_too_old")
    HandshakeFailed(_) -> String.from_str("handshake_failed")
    PeerClosedUncleanly -> String.from_str("peer_closed_uncleanly")
    Timeout -> String.from_str("timeout")
    Io(_) -> String.from_str("io")
}

fun pem(dir: &str, name: &str) => Bytes {
    val p = path(dir, name)
    return when tlsfile.read_pem(p, "file") {
        Ok(b) -> b
        Err(_) -> Bytes.empty()
    }
}

fun ca_bytes(dir: &str) => Bytes = pem(dir, "ca.pem")

// A configuration, as one line: "ok" or the error tag, plus "leak" when the
// pass phrase or the key text reached the error text.
fun config_line(label: &str, dir: &str, cert: &str, key: &str, phrase: &str) => String {
    var opts = tls.server_options()
    if str.len(phrase) > 0 {
        opts = opts.key_password(phrase)
    }
    val r = tls.server_config_pem_with(pem(dir, cert), pem(dir, key), &opts)
    var line = String.with_capacity(64)
    line.push_str(label)
    line.push_str(" ")
    when r {
        Ok(c) -> {
            line.push_str("ok")
            c.free()
        }
        Err(e) -> {
            val tmp_6857 = err_tag(&e)
            line.push_str(tmp_6857)
            val text = tls.error_text(e)
            if str.contains(text, "swordfish") || str.contains(text, "PRIVATE KEY") {
                line.push_str(" leak")
            }
        }
    }
    return line
}

fun encrypted_keys(dir: &str) {
    val line1 = config_line("encrypted with the phrase", dir, "server.pem", "server_enc.key", "swordfish")
    say(line1)
    val line2 = config_line("encrypted without a phrase", dir, "server.pem", "server_enc.key", "")
    say(line2)
    val line3 = config_line("encrypted with a wrong phrase", dir, "server.pem", "server_enc.key", "wrong")
    say(line3)
    val line4 = config_line("plain with a phrase", dir, "server.pem", "server.key", "swordfish")
    say(line4)
}

fun key_line(name: &str, p: &str) => String {
    val r = tlsfile.read_key(p)
    var line = String.with_capacity(64)
    line.push_str("key ")
    line.push_str(name)
    line.push_str(" ")
    when r {
        Ok(_) -> {
            line.push_str("ok")
        }
        Err(e) -> {
            val tag = err_tag(&e)
            line.push_str(tag)
            val text = tls.error_text(e)
            if str.contains(text, "0644") {
                line.push_str(" mode=0644")
            }
        }
    }
    return line
}

fun key_perms(dir: &str) {
    val good = path(dir, "server.key")
    val open = path(dir, "server_open.key")
    val gone = path(dir, "no_such.key")
    val a = key_line("good", good.as_str())
    say(a)
    val b = key_line("open", open.as_str())
    say(b)
    val c = key_line("gone", gone.as_str())
    say(c)
}

// The server thread owns the TLS configuration. A thread may take only scalars
// (a resource or a String cannot be its argument), so it loads the certificates
// itself from its own argv, and it does the live reloads itself between
// rounds. The client rounds stay on the main thread. Every result crosses back
// as one number, and the main thread prints the lines in order after the join.
//
// The result packs base-16 digits, low to high: done (1), accepted (16), the
// reload after round 1 (256), after round 2 (4096), after round 3 (65536).
// A reload digit is 0 for no error or the code `err_code` gives.
fun server_main(job: move Job) => u64 {
    val args = process.args()
    val dir = args.get(2).clone()
    val opts = tls.server_options()
    val built = tls.server_config_pem_with(pem(dir, "server.pem"), pem(dir, "server.key"), &opts)
    return when built {
        Ok(cfg) -> serve_rounds(cfg, job.fd, job.rounds, dir.as_str(), &opts)
        Err(_) -> 0
    }
}

// Accepts `rounds` connections on one configuration and answers each with an
// echo, and reloads it between rounds: the expired certificate after round 1,
// a mismatched key after round 2, the valid pair after round 3.
fun serve_rounds(cfg: tls.ServerConfig, fd: i32, rounds: i32, dir: &str, opts: &tls.ServerOptions) => u64 {
    val l = net.Listener(fd = fd)
    var done: u64 = 0
    var seen: u64 = 0
    var codes: u64 = 0
    var i: i32 = 0
    while i < rounds {
        i = i + 1
        val acc = net.accept(l)
        when acc {
            Ok(sock) -> {
                seen = seen + 1
                val hs = tls.accept(cfg, sock)
                when hs {
                    Ok(t) -> {
                        val got = tls.read(t, 64)
                        when got {
                            Ok(b) -> {
                                val w = tls.write_all(t, b)
                                done = done + 1
                            }
                            Err(_) -> {
                            }
                        }
                        val sd = tls.shutdown(t)
                        net.close(sock)
                    }
                    Err(_) -> {
                        net.close(sock)
                    }
                }
            }
            Err(_) -> {
            }
        }
        if i == 1 {
            codes = codes + 256 * reload_code(cfg.reload_pem(pem(dir, "expired.pem"), pem(dir, "server.key"), opts))
        }
        if i == 2 {
            codes = codes + 4096 * reload_code(cfg.reload_pem(pem(dir, "server.pem"), pem(dir, "other_server.key"), opts))
        }
        if i == 3 {
            codes = codes + 65536 * reload_code(cfg.reload_pem(pem(dir, "server.pem"), pem(dir, "server.key"), opts))
        }
    }
    cfg.free()
    return codes + seen * 16 + done
}

// The base-16 digit of `packed` at place `place` (1, 16, 256, ...).
fun digit(packed: u64, place: u64) => u64 = (packed / place) - ((packed / (place * 16)) * 16)

// The code of a reload result: 0 for none, otherwise a number `code_tag` names.
fun reload_code(r: move option.Option<tls.TlsError>) => u64 {
    return when r {
        Some(e) -> err_code(&e)
        None -> 0
    }
}

fun err_code(e: &tls.TlsError) => u64 = when e {
    Untrusted -> 1
    Expired -> 2
    HostMismatch -> 3
    ProtocolTooOld -> 4
    HandshakeFailed(_) -> 5
    PeerClosedUncleanly -> 6
    Timeout -> 7
    Io(_) -> 8
}

// The text a reload code prints as, the same words `err_tag` gives.
fun code_tag(code: u64) => String {
    if code == 0 {
        return String.from_str("none")
    }
    if code == 1 {
        return String.from_str("untrusted")
    }
    if code == 2 {
        return String.from_str("expired")
    }
    if code == 3 {
        return String.from_str("host_mismatch")
    }
    if code == 4 {
        return String.from_str("protocol_too_old")
    }
    if code == 5 {
        return String.from_str("handshake_failed")
    }
    if code == 6 {
        return String.from_str("peer_closed_uncleanly")
    }
    if code == 7 {
        return String.from_str("timeout")
    }
    return String.from_str("io")
}

fun reload_line(label: &str, code: u64) => String {
    var line = String.with_capacity(48)
    line.push_str(label)
    line.push_str(" ")
    val tag = code_tag(code)
    line.push_str(tag)
    return line
}

fun server_line(packed: u64) => String {
    val seen = digit(packed, 16)
    val done = digit(packed, 1)
    var line = String.with_capacity(48)
    line.push_str("server accepted ")
    val tmp_7007 = fmt.uint(seen)
    line.push_str(tmp_7007)
    line.push_str(" completed ")
    val tmp_9429 = fmt.uint(done)
    line.push_str(tmp_9429)
    return line
}

fun client_round(label: &str, dir: &str, port: u16) => String {
    val opts = tls.client_options().with_ca_pem(ca_bytes(dir)).with_timeout_ms(10000)
    val s = result.expect(net.connect("127.0.0.1", port), "net.connect: the call failed")
    val hs = tls.handshake_opts(s, "localhost", &opts)
    var line = String.with_capacity(64)
    line.push_str(label)
    line.push_str(" ")
    when hs {
        Ok(t) -> {
            val w = tls.write_all(t, Bytes.from_str("hello"))
            val r = tls.read(t, 64)
            when r {
                Ok(b) -> {
                    line.push_str("echo=")
                    val tmp_5147 = String.from_bytes(b)
                    line.push_str(tmp_5147)
                }
                Err(e) -> {
                    line.push_str("read ")
                    val tmp_6857 = err_tag(&e)
                    line.push_str(tmp_6857)
                }
            }
            val sd = tls.shutdown(t)
        }
        Err(e) -> {
            val tmp_6857 = err_tag(&e)
            line.push_str(tmp_6857)
        }
    }
    net.close(s)
    return line
}

fun reload(dir: &str) {
    val l = net.listen_on("127.0.0.1", 0)
    var lm = net.Listener(fd = l.fd)
    lm.set_timeout(10000)
    val port = l.port()
    val h = thread.spawn(server_main, Job(fd = l.fd, rounds = 4))
    val line6 = client_round("round 1", dir, port)
    val line8 = client_round("round 2", dir, port)
    val line10 = client_round("round 3", dir, port)
    val line12 = client_round("round 4", dir, port)
    when thread.join(h) {
        Ok(p) -> {
            val line7 = reload_line("reload expired", digit(p, 256))
            val line9 = reload_line("reload mismatched", digit(p, 4096))
            val line11 = reload_line("reload valid", digit(p, 65536))
            val line13 = server_line(p)
            say(line6)
            say(line7)
            say(line8)
            say(line9)
            say(line10)
            say(line11)
            say(line12)
            say(line13)
        }
        Err(_) -> {
            say("server thread failed")
        }
    }
    l.close()
}

// `listen_on` binds the host it is given: loopback answers on 127.0.0.1 and
// the port it reports is the one that was bound.
fun listen_host() {
    val l = net.listen_on("127.0.0.1", 0)
    val port = l.port()
    val c = result.expect(net.connect("127.0.0.1", port), "net.connect: the call failed")
    val s = result.expect(net.accept(l), "net.accept: the call failed")
    say("listen_on loopback accepted")
    net.close(c)
    net.close(s)
    l.close()
}

fun main() {
    val args = process.args()
    val mode = args.get(1).clone()
    val dir = args.get(2).clone()
    if str.eq(mode, "encrypted_keys") {
        encrypted_keys(dir)
    }
    if str.eq(mode, "key_perms") {
        key_perms(dir)
    }
    if str.eq(mode, "reload") {
        reload(dir)
    }
    if str.eq(mode, "listen_on") {
        listen_host()
    }
}
