// st2: the HTTP server under test. A hazard, not a fixture, because it waits for
// clients: `compile_and_run.rs` starts it on port 0, reads the port from its
// first stdout line, drives it from Rust over loopback, and every case ends when
// the program has answered `max_requests` requests (`serve_on`), so nothing here
// can run unbounded. argv: max_requests, max_body, head_ms, body_ms, idle_ms,
// max_requests_per_conn. The last stdout line is `served <n> fds <before> <after>`, the descriptor counts
// around the whole run, which must be equal (no leak, no double close).
impl "std/fmt"
impl "std/fs"
impl "std/io"

impl "std/option"
impl "std/process"
impl "std/result"
impl "std/str"
impl "std/http" caps(net = ["127.0.0.1:*"])

fun arg_u64(i: int) => u64 {
    val args = process.args()
    return result.expect(
        r = str.parseU64(args.get(i).as_str()),
        message = "http_server: an argument is not a number",
    )
}

fun say(text: &str) {
    val f = io.stdout()
    val a = f.writeStr(text)
    val b = f.writeStr("\n")
}

fun big() => http.ServerResponse {
    var b = Bytes.empty()
    var i: int = 0
    while i < 4194304 {
        b.push(97)
        i = i + 1
    }
    return http.ServerResponse(status = 200, headers = List.empty(), body = b)
}

fun echo(req: &http.ServerRequest) => http.ServerResponse {
    var hs: List<http.Header> = List.empty()
    hs.push(http.Header(name = String.from_str("Content-Type"), value = String.from_str("application/octet-stream")))
    return http.ServerResponse(status = 200, headers = hs, body = req.body.clone())
}

fun param(req: &http.ServerRequest, name: &str) => String {
    val v = req.queryParam(name)
    return when v {
        Some(s) -> s
        None -> String.from_str("<none>")
    }
}

fun handle(req: &http.ServerRequest) => http.ServerResponse {
    val segs = req.pathSegments()
    if segs.len() == 0 {
        return http.okText("hello")
    }
    val first = segs.get(0).as_str()
    if str.eq(first, "echo") {
        return echo(req)
    }
    if str.eq(first, "method") {
        var out = String.with_capacity(64)
        out.push_str(req.method)
        out.push_str(" ")
        out.push_str(req.target)
        out.push_str(" ")
        out.push_str(req.path)
        out.push_str(" ")
        out.push_str(req.query)
        return http.okText(out)
    }
    if str.eq(first, "users") && segs.len() == 2 {
        var out = String.with_capacity(64)
        out.push_str("{\"id\":\"")
        out.push_str(segs.get(1).as_str())
        out.push_str("\"}")
        return http.json(out)
    }
    if str.eq(first, "seg") {
        var out = String.with_capacity(64)
        var i: int = 0
        while i < segs.len() {
            if i > 0 {
                out.push_str("|")
            }
            out.push_str(segs.get(i).as_str())
            i = i + 1
        }
        return http.okText(out)
    }
    if str.eq(first, "q") {
        var out = String.with_capacity(64)
        val a = param(req, "name")
        val b = param(req, "n")
        val c = param(req, "missing")
        out.push_str(a)
        out.push_str(",")
        out.push_str(b)
        out.push_str(",")
        out.push_str(c)
        return http.html(out)
    }
    if str.eq(first, "hdr") {
        var out = String.with_capacity(64)
        val v = req.header("x-test")
        out.push_str(v)
        if req.hasHeader("X-TEST") {
            out.push_str("|has")
        }
        if !req.hasHeader("x-absent") {
            out.push_str("|absent")
        }
        val r = http.okText(out)
        return r.withHeader("X-Reply", "yes")
    }
    if str.eq(first, "nocontent") {
        return http.status(204)
    }
    if str.eq(first, "teapot") {
        return http.status(418)
    }
    if str.eq(first, "bad") {
        return http.badRequest("nope")
    }
    if str.eq(first, "close") {
        val r = http.okText("bye")
        return r.withHeader("Connection", "close")
    }
    if str.eq(first, "big") {
        return big()
    }
    if str.eq(first, "len") {
        val n = fmt.uint(req.body.len().to_u64())
        return http.okText(n)
    }
    return http.notFound()
}

fun fd_count() => int {
    val listing = result.expect(fs.list("/proc/self/fd"), "fs.list: the call failed")
    return listing.len()
}

fun main() {
    val before = fd_count()
    val s = http.listen(0)
    val port = fmt.uint(s.port().to_u64())
    say(port)
    val limits = http.Limits(
        max_request_line = 8192,
        max_header_bytes = 16384,
        max_headers = 100,
        max_body = arg_u64(2).to_int(),
        head_timeout_ms = arg_u64(3),
        body_timeout_ms = arg_u64(4),
        idle_timeout_ms = arg_u64(5),
        max_requests_per_conn = arg_u64(6).to_int(),
    )
    val n = http.serve_on(&s, handle, &limits, arg_u64(1))
    s.close()
    val after = fd_count()
    var line = String.from_str("served ")
    val t = fmt.uint(n)
    line.push_str(t)
    line.push_str(" fds ")
    val b = fmt.uint(before.to_u64())
    line.push_str(b)
    line.push_str(" ")
    val a = fmt.uint(after.to_u64())
    line.push_str(a)
    say(line)
}
