// `=>` is the arrow of a `when` over an enum, with a binding list and an `else` arm.
enum Shape {
    Circle(val r: i32)
    Rect(val w: i32, val h: i32)
}

fun area(s: &Shape) => i32 = when s {
    Circle(r) => r * r * 3
    Rect(w, h) => w * h
    else => 0
}

fun main() {
    print(area(Shape.Circle(r = 2)))
    print(area(Shape.Rect(w = 2, h = 5)))
}
