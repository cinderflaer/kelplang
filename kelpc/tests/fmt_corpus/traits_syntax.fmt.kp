// pins default-one-space-between-atoms: two atoms that share a line get one space between them unless another rule here removes it.
trait Shape {
    fun Self.area().return: f64
    fun Self.describe().return: f64 { return 0.0 }
    fun mut Self.scale(f: f64)
}

trait Named: Shape + Other {
    type Item
    fun Self.name().return: str
    fun Self.first().return: Self::Item
}

datac Circle(val r: f64)

impl Shape for Circle {
    fun Self.area().return: f64 = r * r
    fun mut Self.scale(f: f64) { r = r * f }
}

impl Named for i32 {
    fun Self.name().return: str = "n"
}

fun describe(s: &dyn Shape).return: f64 = s.area()
fun mutate(s: &mut dyn Shape) {}

fun area_of<T: Shape + Grow>(s: &T).return: f64 = s.area()

fun boxed(s: Box<dyn Shape>) {}

fun main() {}
