// pins comments-verbatim-bytes: a `/* ... */` comment is copied byte-for-byte — its own
// newlines and inner indentation included — and only the whitespace between
// tokens around it is rewritten.
/* a block comment at the
   top of the file */
fun main() {
    print("a")
    /* between two statements,
       on two lines */
    print("b") /* trailing */
    /* inline */ print("c")
    val n = add(a = 1,
                /* between arguments */ b = 2)
    print(n)
}
