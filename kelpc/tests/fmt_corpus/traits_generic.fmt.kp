// pins default-one-space-between-atoms: the generic-trait, static-method and trait-instance spelling shares lines too.
trait From<T> {
    fun from(value: T).return: Self
}

trait Into<T> {
    fun Self.into().return: T
}

datac AppErr(val code: i32)

impl From<i32> for AppErr {
    fun from(value: i32).return: AppErr = AppErr(code = value)
}

fun make<X: From<i32>>(v: i32).return: X {
    return X.from(value = v)
}

fun main() {}
