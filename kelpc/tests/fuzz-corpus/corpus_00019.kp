// fuzz seed 19; shapes: scalar, calls, owns, enum, try, strings, list_float, list_owned, closure, pd

pd val z_base = 9
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("data")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_add(a: i32, b: i32) => i32 = (a << 0)
fun z_scale(a: f64, b: f64) => f64 = ((7.5 + a) + (100.0 / 0.25))
fun z_mk(n: i32) => ZPoint = ZPoint(x = n, y = n + 1)
fun z_try(n: i32) => ZRes {
    if n > 0 {
        return ZRes.Ok(value = n)
    }
    return ZRes.Err(why = 0)
}
fun z_chain(n: i32) => ZRes {
    val v = z_try(n)?
    return ZRes.Ok(value = v + 1)
}
fun z_val(r: ZRes) => i32 = when r {
    Ok(v) -> v
    Err(_e) -> -1
}
fun z_msg_int(m: ZMsg) => i32 = when m {
    Num(n) -> n
    Text(t) -> t.len().to_i32()
    Nil -> -1
}
fun z_double(v: i32) => i32 = v * 2
fun z_apply(f: fun(i32) => i32, v: i32) => i32 = f(v)

fun main() {
    {
        val a = 19
        val b = (-37)
        val x = 0.0625
        val y = 0.0625
        print((-9))
        print((((a * (-19)) - ((-40) - b)) << 0))
        print(((3.75 * x) / 0.5))
        print(((!true) && (((b % 7) / 1) <= (-6))))
        if ((!true) && (((b % 7) / 1) <= (-6))) {
            print((b / 5))
        } else {
            print((a / 6))
        }
        var i = 0
        var acc = 0
        while i < 5 {
            if (((x <= (0.0625 - y)) && true) || ((b & (i << 3)) >= ((-10) & (7 | 22)))) {
                acc = acc + ((a % 5) - (a << 3))
            } else {
                acc = acc - (-38)
            }
            i = i + 1
        }
        print(acc)
        print(!(((3.75 - 0.25) + (0.25 / 3.75)) > ((0.0625 * 100.0) - (y / 10.0))))
    }

    {
        print(z_add(4, (-18)))
        print(z_add(z_add(29, 35), (-38)))
        print(z_scale(10.0, 0.125))
        val p = z_mk((-38))
        print(p.x)
        print(p.y)
    }

    {
        val row = ZRow(name = String.from_str("kelp"), tag = (-26), inner = ZLabel(text = String.from_str("yz")))
        print(row.name)
        print(row.tag)
        print(row.inner.text)
        print(row.inner.text.len())
        val owner = ZRow(name = String.from_str("text"), tag = 25, inner = ZLabel(text = String.from_str("beta")))
        val moved = owner
        print(moved.name)
        print(moved.inner.text)
    }

    {
        val s = ZShape.Empty
        when s {
            Circle(r) -> print(r)
            Rect(w, h) -> print(w * h)
            Empty -> print(0.0)
        }
        val m = ZMsg.Num(n = 2)
        when m {
            Num(n) -> print(n)
            Text(t) -> print(t)
            Nil -> print("nil")
        }
        if let Num(k) = m {
            print(k)
        } else {
            print(-1)
        }
        if let Circle(r) = s {
            print(r * 2.0)
        }
    }

    {
        print(z_val(r = z_try(13)))
        print(z_val(r = z_try(-5)))
        print(z_val(r = z_chain(13)))
        print(z_val(r = z_chain(-5)))
    }

    {
        var b = Bytes.empty()
        b.push(237)
        b.push(119)
        val tail = Bytes.from_str("x")
        b.append(tail)
        print(b.len())
        print(b.get(0))
        print(b.is_empty())
        val s = String.from_str("hi")
        print(s)
        print(s.len())
        val e = String.from_str("hi")
        print(e)
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(10.0)
        fs.push(10.0)
        fs.push(10.0)
        fs.push(100.0)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(100.0))
        print(fs.contains(10.0))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: usize = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var msgs: List<ZMsg> = List.empty()
        msgs.push(ZMsg.Text(s = String.from_str("x")))
        msgs.push(ZMsg.Num(n = 8))
        msgs.push(ZMsg.Nil)
        print(msgs.len())
        print(z_msg_int(m = msgs.get(0)))
        msgs.set(i = 1, v = ZMsg.Text(s = String.from_str("yz")))
        print(z_msg_int(m = msgs.get(1)))
        val taken = msgs.pop()
        print(z_msg_int(m = taken))
        msgs.clear()
        print(msgs.len())
        var labels: List<ZLabel> = List.empty()
        labels.push(ZLabel(text = String.from_str("yz")))
        labels.push(ZLabel(text = String.from_str("data")))
        print(labels.get(0).text)
        val last = labels.pop()
        print(last.text)
        labels.clear()
        print(labels.len())
    }

    {
        val s = String.from_str("text")
        val f = fun() => usize = s.len()
        print(f())
        val k = (-5)
        val g = fun(x: i32) => i32 = x + k
        print(g(34))
        val h = z_double
        print(h(34))
        print(z_apply(z_double, 34))
        print(z_apply(h, 34))
        var i = 0
        while i < 3 {
            val t = String.from_str("seed")
            val c = fun() => usize = t.len()
            print(c())
            i = i + 1
        }
    }

    {
        print(z_base)
        print(z_doubled)
        print(z_name)
        print(z_primes.len())
        print(z_primes.get(0))
        print(z_origin.x)
        print(z_origin.y)
        print(z_origin.x + z_origin.y)
    }

}
