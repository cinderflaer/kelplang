// fuzz seed 23; shapes: scalar, datac, enum, strings, list, list_float, list_owned, map, closure, pd

pd val z_base = 3
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("beta")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_psum(p: ZPoint).R: i32 = p.x + p.y
fun z_vsum(v: ZVec).R: f64 = v.x + v.y
fun z_msg_int(m: ZMsg).R: i32 = when m {
    Num(n) -> n
    Text(t) -> t.len().to_i32()
    Nil -> -1
}
fun z_double(v: i32).R: i32 = v * 2
fun z_apply(f: fun(i32).R: i32, v: i32).R: i32 = f(v)

fun main() {
    {
        val a = (-9)
        val b = (-16)
        val x = 1.5
        val y = 7.5
        print((2 & (a % 6)))
        print(((a / 6) | (((-34) & a) & (a ^ (-18)))))
        print(((x + 1.5) - (y * y)))
        print((!((-17) <= (a * ((-14) - (-1))))))
        if (!((-17) <= (a * ((-14) - (-1))))) {
            print((a * 18))
        } else {
            print((25 * 14))
        }
        var i = 0
        var acc = 0
        while i < 3 {
            if (!(false || false)) {
                acc = acc + b
            } else {
                acc = acc - ((b * (-24)) % 9)
            }
            i = i + 1
        }
        print(acc)
        print(!(!false))
    }

    {
        var p = ZPoint(x = (-37), y = 14)
        print(p.x)
        p.x = p.x + (-5)
        print(p.x)
        print(z_psum(p))
        val v = ZVec(x = 1.5, y = 7.5)
        print(z_vsum(v))
        val w = ZVec(x = 3.75, y = 7.5)
        print(w.x)
        print(z_vsum(w))
    }

    {
        val s = ZShape.Circle(r = 0.5)
        when s {
            Circle(r) -> print(r)
            Rect(w, h) -> print(w * h)
            Empty -> print(0.0)
        }
        val m = ZMsg.Num(n = 28)
        when m {
            Num(n) -> print(n)
            Text(t) -> print(t)
            Nil -> print("nil")
        }
        if let Num(k) = m {
            print(k)
        } else {
            print(-1)
        }
        if let Circle(r) = s {
            print(r * 2.0)
        }
    }

    {
        var b = Bytes.empty()
        b.push(201)
        b.push(40)
        val tail = Bytes.from_str("kelp")
        b.append(tail)
        print(b.len())
        print(b.get(0))
        print(b.is_empty())
        val s = String.from_str("yz")
        print(s)
        print(s.len())
        val e = String.from_str("beta")
        print(e)
    }

    {
        var xs: List<i32> = List.empty()
        print(xs.len())
        print(xs.is_empty())
        xs.push(22)
        xs.push((-19))
        xs.push(29)
        print(xs.get(0))
        xs.set(1, 1)
        print(xs.get(1))
        print(xs.pop())
        var i: usize = 0
        var sum = 0
        while i < xs.len() {
            sum = sum + xs.get(i)
            i += 1
        }
        print(sum)
        for v in xs {
            print(v)
        }
        xs.reverse()
        print(xs.get(0))
        xs.clear()
        print(xs.len())
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(0.0625)
        fs.push(2.25)
        fs.push(0.125)
        fs.push(0.125)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(0.125))
        print(fs.contains(0.0625))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: usize = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var msgs: List<ZMsg> = List.empty()
        msgs.push(ZMsg.Text(s = String.from_str("word")))
        msgs.push(ZMsg.Num(n = (-3)))
        msgs.push(ZMsg.Nil)
        print(msgs.len())
        print(z_msg_int(m = msgs.get(0)))
        msgs.set(i = 1, v = ZMsg.Text(s = String.from_str("alpha")))
        print(z_msg_int(m = msgs.get(1)))
        val taken = msgs.pop()
        print(z_msg_int(m = taken))
        msgs.clear()
        print(msgs.len())
        var labels: List<ZLabel> = List.empty()
        labels.push(ZLabel(text = String.from_str("beta")))
        labels.push(ZLabel(text = String.from_str("hi")))
        print(labels.get(0).text)
        val last = labels.pop()
        print(last.text)
        labels.clear()
        print(labels.len())
    }

    {
        var m: Map<i64, i32> = Map.new()
        print(m.len())
        m.insert(11, 24)
        m.insert(25, 19)
        print(m.len())
        print(m.get(11))
        print(m.has(25))
        print(m.has(5))
        print(m.get_or(5, 99))
        m.insert(11, (-30))
        print(m.get(11))
        print(m.remove(25))
        print(m.len())
        val ks = m.keys()
        var i: usize = 0
        while i < ks.len() {
            print(ks.get(i))
            i += 1
        }
        var bools: Map<bool, i64> = Map.new()
        bools.insert(true, 5)
        bools.insert(false, 7)
        print(bools.get(true))
        print(bools.len())
    }

    {
        val s = String.from_str("yz")
        val f = fun() .R: usize = s.len()
        print(f())
        val k = 40
        val g = fun(x: i32).R: i32 = x + k
        print(g((-31)))
        val h = z_double
        print(h((-31)))
        print(z_apply(z_double, (-31)))
        print(z_apply(h, (-31)))
        var i = 0
        while i < 3 {
            val t = String.from_str("alpha")
            val c = fun() .R: usize = t.len()
            print(c())
            i = i + 1
        }
    }

    {
        print(z_base)
        print(z_doubled)
        print(z_name)
        print(z_primes.len())
        print(z_primes.get(0))
        print(z_origin.x)
        print(z_origin.y)
        print(z_origin.x + z_origin.y)
    }

}
