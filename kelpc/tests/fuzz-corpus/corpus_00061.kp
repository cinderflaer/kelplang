// fuzz seed 61; shapes: scalar, datac, owns, try, strings, list, list_float, list_owned, map, refs, closure, pd

pd val z_base: i32 = 4
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("data")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_psum(p: ZPoint) => i32 = p.x + p.y
fun z_vsum(v: ZVec) => f64 = v.x + v.y
fun z_try(n: i32) => ZRes {
    if n > 0 {
        return ZRes.Ok(value = n)
    }
    return ZRes.Err(why = 0)
}
fun z_chain(n: i32) => ZRes {
    val v = z_try(n)?
    return ZRes.Ok(value = v + 1)
}
fun z_val(r: ZRes) => i32 = when r {
    Ok(v) -> v
    Err(_e) -> -1
}
fun z_msg_int(m: ZMsg) => i32 = when m {
    Num(n) -> n
    Text(t) -> t.len().to_i32()
    Nil -> -1
}
fun z_bump(p: mut i32, d: i32) {
    *p = *p + d
}
fun z_scale_f(p: mut f64, by: f64) {
    *p = *p * by
}
fun z_double(v: i32) => i32 = v * 2
fun z_apply(f: fun(i32) => i32, v: i32) => i32 = f(v)

fun main() {
    {
        val a: i32 = (-12)
        val b: i32 = 24
        val x = 0.125
        val y = 7.5
        print((((-30) - b) ^ (b + 4)))
        print((((a | 18) % 8) << 2))
        print((y + x))
        print(((!true) && (!((y / 3.75) == y))))
        if ((!true) && (!((y / 3.75) == y))) {
            print((a & (-32)))
        } else {
            print((-29))
        }
        var i: i32 = 0
        var acc: i32 = 0
        while i < 4 {
            if ((5 & (30 ^ i)) == ((i * i) / 7)) {
                acc = acc + (i | b)
            } else {
                acc = acc - ((-27) * a)
            }
            i = i + 1
        }
        print(acc)
        print(!(((2.25 / 0.125) != (y * x)) && true))
    }

    {
        var p = ZPoint(x = (-6), y = (-40))
        print(p.x)
        p.x = p.x + 4
        print(p.x)
        print(z_psum(p))
        val v = ZVec(x = 1.5, y = 100.0)
        print(z_vsum(v))
        val w = ZVec(x = 0.0625, y = 0.5)
        print(w.x)
        print(z_vsum(w))
    }

    {
        val row = ZRow(name = String.from_str("text"), tag = 6, inner = ZLabel(text = String.from_str("beta")))
        print(row.name)
        print(row.tag)
        print(row.inner.text)
        print(row.inner.text.len())
        val owner = ZRow(name = String.from_str("data"), tag = 16, inner = ZLabel(text = String.from_str("alpha")))
        val moved = owner
        print(moved.name)
        print(moved.inner.text)
    }

    {
        print(z_val(r = z_try(29)))
        print(z_val(r = z_try(-24)))
        print(z_val(r = z_chain(29)))
        print(z_val(r = z_chain(-24)))
    }

    {
        var b = Bytes.empty()
        b.push(243)
        b.push(16)
        val tail = Bytes.from_str("yz")
        b.append(tail)
        print(b.len())
        print(b.get(0))
        print(b.is_empty())
        val s = String.from_str("x")
        print(s)
        print(s.len())
        val e = String.from_str("alpha")
        print(e)
    }

    {
        var xs: List<i32> = List.empty()
        print(xs.len())
        print(xs.is_empty())
        xs.push((-4))
        xs.push(38)
        xs.push((-15))
        print(xs.get(0))
        xs.set(1, (-3))
        print(xs.get(1))
        print(xs.pop())
        var i: int = 0
        var sum: i32 = 0
        while i < xs.len() {
            sum = sum + xs.get(i)
            i += 1
        }
        print(sum)
        for v in xs {
            print(v)
        }
        xs.reverse()
        print(xs.get(0))
        xs.clear()
        print(xs.len())
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(0.125)
        fs.push(3.75)
        fs.push(1.5)
        fs.push(10.0)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(10.0))
        print(fs.contains(0.125))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: int = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var msgs: List<ZMsg> = List.empty()
        msgs.push(ZMsg.Text(s = String.from_str("x")))
        msgs.push(ZMsg.Num(n = 31))
        msgs.push(ZMsg.Nil)
        print(msgs.len())
        print(z_msg_int(m = msgs.get(0)))
        msgs.set(i = 1, v = ZMsg.Text(s = String.from_str("data")))
        print(z_msg_int(m = msgs.get(1)))
        val taken = msgs.pop()
        print(z_msg_int(m = taken))
        msgs.clear()
        print(msgs.len())
        var labels: List<ZLabel> = List.empty()
        labels.push(ZLabel(text = String.from_str("alpha")))
        labels.push(ZLabel(text = String.from_str("hi")))
        print(labels.get(0).text)
        val last = labels.pop()
        print(last.text)
        labels.clear()
        print(labels.len())
    }

    {
        var m: Map<i64, i32> = Map.new()
        print(m.len())
        m.insert(12, 27)
        m.insert(31, 31)
        print(m.len())
        print(m.get(12))
        print(m.has(31))
        print(m.has(31))
        print(m.get_or(31, 99))
        m.insert(12, (-32))
        print(m.get(12))
        print(m.remove(31))
        print(m.len())
        val ks = m.keys()
        var i: int = 0
        while i < ks.len() {
            print(ks.get(i))
            i += 1
        }
        var bools: Map<bool, i64> = Map.new()
        bools.insert(true, 5)
        bools.insert(false, 7)
        print(bools.get(true))
        print(bools.len())
    }

    {
        var n: i32 = 3
        z_bump(n, (-21))
        print(n)
        var f: f64 = 3.75
        z_scale_f(f, 2.25)
        print(f)
        val r = &n
        print(*r)
        var p = ZPoint(x = (-2), y = 0)
        val q = &p
        print((*q).x)
        p.y = p.y + (-21)
        print((*q).y)
    }

    {
        val s = String.from_str("text")
        val f = fun() => int = s.len()
        print(f())
        val k: i32 = (-11)
        val g = fun(x: i32) => i32 = x + k
        print(g((-20)))
        val h = z_double
        print(h((-20)))
        print(z_apply(z_double, (-20)))
        print(z_apply(h, (-20)))
        var i: i32 = 0
        while i < 3 {
            val t = String.from_str("data")
            val c = fun() => int = t.len()
            print(c())
            i = i + 1
        }
    }

    {
        print(z_base)
        print(z_doubled)
        print(z_name)
        print(z_primes.len())
        print(z_primes.get(0))
        print(z_origin.x)
        print(z_origin.y)
        print(z_origin.x + z_origin.y)
    }

}
