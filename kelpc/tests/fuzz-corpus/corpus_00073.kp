// fuzz seed 73; shapes: scalar, calls, datac, owns, enum, strings, list_float, list_owned, map, box, array, refs, closure

pd val z_base: i32 = 15
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("seed")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_add(a: i32, b: i32) => i32 = (((-14) & a) + (a - b))
fun z_scale(a: f64, b: f64) => f64 = ((0.0625 + b) * (b / 1.5))
fun z_mk(n: i32) => ZPoint = ZPoint(x = n, y = n + 1)
fun z_psum(p: ZPoint) => i32 = p.x + p.y
fun z_vsum(v: ZVec) => f64 = v.x + v.y
fun z_msg_int(m: ZMsg) => i32 = when m {
    Num(n) -> n
    Text(t) -> t.len().to_i32()
    Nil -> -1
}
fun z_pair_sum(p: [f64; 2]) => f64 = p.get(i = 0) + p.get(i = 1)
fun z_bump(p: mut i32, d: i32) {
    *p = *p + d
}
fun z_scale_f(p: mut f64, by: f64) {
    *p = *p * by
}
fun z_double(v: i32) => i32 = v * 2
fun z_apply(f: fun(i32) => i32, v: i32) => i32 = f(v)

fun main() {
    {
        val a: i32 = 23
        val b: i32 = 39
        val x = 1.5
        val y = 0.25
        print((((-7) << 3) << 2))
        print((-37))
        print(x)
        print((((y + 0.25) + (y + 0.0625)) == x))
        if (((y + 0.25) + (y + 0.0625)) == x) {
            print(((-7) ^ (-32)))
        } else {
            print((23 / 9))
        }
        var i: i32 = 0
        var acc: i32 = 0
        while i < 3 {
            if ((!((i ^ 16) <= ((-21) & 16))) || (true && ((10.0 - y) == (0.25 + 10.0)))) {
                acc = acc + ((b % 3) + (33 << 0))
            } else {
                acc = acc - (b ^ (36 | 8))
            }
            i = i + 1
        }
        print(acc)
        print(!((x - 10.0) > ((0.25 + 7.5) - (x / 100.0))))
    }

    {
        print(z_add(33, 18))
        print(z_add(z_add((-24), 23), 37))
        print(z_scale(0.25, 7.5))
        val p = z_mk((-15))
        print(p.x)
        print(p.y)
    }

    {
        var p = ZPoint(x = 23, y = (-35))
        print(p.x)
        p.x = p.x + (-13)
        print(p.x)
        print(z_psum(p))
        val v = ZVec(x = 2.25, y = 0.125)
        print(z_vsum(v))
        val w = ZVec(x = 100.0, y = 0.125)
        print(w.x)
        print(z_vsum(w))
    }

    {
        val row = ZRow(name = String.from_str("hi"), tag = 23, inner = ZLabel(text = String.from_str("yz")))
        print(row.name)
        print(row.tag)
        print(row.inner.text)
        print(row.inner.text.len())
        val owner = ZRow(name = String.from_str("x"), tag = 17, inner = ZLabel(text = String.from_str("hi")))
        val moved = owner
        print(moved.name)
        print(moved.inner.text)
    }

    {
        val s = ZShape.Circle(r = 0.5)
        when s {
            Circle(r) -> print(r)
            Rect(w, h) -> print(w * h)
            Empty -> print(0.0)
        }
        val m = ZMsg.Nil
        when m {
            Num(n) -> print(n)
            Text(t) -> print(t)
            Nil -> print("nil")
        }
        if let Num(k) = m {
            print(k)
        } else {
            print(-1)
        }
        if let Circle(r) = s {
            print(r * 2.0)
        }
    }

    {
        var b = Bytes.empty()
        b.push(18)
        b.push(131)
        val tail = Bytes.from_str("alpha")
        b.append(tail)
        print(b.len())
        print(b.get(0))
        print(b.is_empty())
        val s = String.from_str("yz")
        print(s)
        print(s.len())
        val e = String.from_str("kelp")
        print(e)
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(10.0)
        fs.push(7.5)
        fs.push(7.5)
        fs.push(0.5)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(0.5))
        print(fs.contains(10.0))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: int = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var msgs: List<ZMsg> = List.empty()
        msgs.push(ZMsg.Text(s = String.from_str("kelp")))
        msgs.push(ZMsg.Num(n = (-25)))
        msgs.push(ZMsg.Nil)
        print(msgs.len())
        print(z_msg_int(m = msgs.get(0)))
        msgs.set(i = 1, v = ZMsg.Text(s = String.from_str("yz")))
        print(z_msg_int(m = msgs.get(1)))
        val taken = msgs.pop()
        print(z_msg_int(m = taken))
        msgs.clear()
        print(msgs.len())
        var labels: List<ZLabel> = List.empty()
        labels.push(ZLabel(text = String.from_str("alpha")))
        labels.push(ZLabel(text = String.from_str("yz")))
        print(labels.get(0).text)
        val last = labels.pop()
        print(last.text)
        labels.clear()
        print(labels.len())
    }

    {
        var m: Map<i64, i32> = Map.new()
        print(m.len())
        m.insert(15, (-4))
        m.insert(31, (-7))
        print(m.len())
        print(m.get(15))
        print(m.has(31))
        print(m.has(7))
        print(m.get_or(7, 99))
        m.insert(15, (-13))
        print(m.get(15))
        print(m.remove(31))
        print(m.len())
        val ks = m.keys()
        var i: int = 0
        while i < ks.len() {
            print(ks.get(i))
            i += 1
        }
        var bools: Map<bool, i64> = Map.new()
        bools.insert(true, 5)
        bools.insert(false, 7)
        print(bools.get(true))
        print(bools.len())
    }

    {
        var b: Box<i32> = Box.empty()
        print(b.is_empty())
        b.set(29)
        print(b.get())
        print(b.take())
        print(b.is_empty())
        val lb = Box.of(ZLabel(text = String.from_str("hi")))
        print(lb.get().text)
        val nested = Box.of(Box.of(24))
        print(nested.get().get())
        var fb: Box<f64> = Box.empty()
        fb.set(0.125)
        print(fb.get())
    }

    {
        val xs: [i32; 3] = [20, 1, 22]
        print(xs.len())
        print(xs.get(i = 1))
        for v in xs {
            print(v)
        }
        var buf: [f64; 3] = [2.25, 2.25, 0.25]
        buf.set(i = 2, v = 2.25)
        print(buf.get(i = 2))
        val pair: [f64; 2] = [2.25, 0.25]
        print(z_pair_sum(pair))
        val grid: [[i32; 2]; 2] = [[10, 21], [32, (-17)]]
        print(grid.get(i = 1).get(i = 0))
        val pts: [ZPoint; 2] = [ZPoint(x = 20, y = 1), ZPoint(x = 22, y = 10)]
        print(pts.get(i = 0).x)
        print(pts.get(i = 1).y)
    }

    {
        var n: i32 = (-35)
        z_bump(n, 6)
        print(n)
        var f: f64 = 0.5
        z_scale_f(f, 7.5)
        print(f)
        val r = &n
        print(*r)
        var p = ZPoint(x = (-17), y = (-6))
        val q = &p
        print((*q).x)
        p.y = p.y + 6
        print((*q).y)
    }

    {
        val s = String.from_str("yz")
        val f = fun() => int = s.len()
        print(f())
        val k: i32 = 35
        val g = fun(x: i32) => i32 = x + k
        print(g((-30)))
        val h = z_double
        print(h((-30)))
        print(z_apply(z_double, (-30)))
        print(z_apply(h, (-30)))
        var i: i32 = 0
        while i < 3 {
            val t = String.from_str("kelp")
            val c = fun() => int = t.len()
            print(c())
            i = i + 1
        }
    }

}
