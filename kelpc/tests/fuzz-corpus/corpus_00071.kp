// fuzz seed 71; shapes: scalar, datac, owns, enum, try, list, list_float, list_owned, map, box, closure, pd

pd val z_base = 17
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("kelp")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_psum(p: ZPoint).return: i32 = p.x + p.y
fun z_vsum(v: ZVec).return: f64 = v.x + v.y
fun z_try(n: i32).return: ZRes {
    if n > 0 {
        return ZRes.Ok(value = n)
    }
    return ZRes.Err(why = 0)
}
fun z_chain(n: i32).return: ZRes {
    val v = z_try(n)?
    return ZRes.Ok(value = v + 1)
}
fun z_val(r: ZRes).return: i32 = when r {
    Ok(v) -> v
    Err(_e) -> -1
}
fun z_msg_int(m: ZMsg).return: i32 = when m {
    Num(n) -> n
    Text(t) -> t.len().to_i32()
    Nil -> -1
}
fun z_double(v: i32).return: i32 = v * 2
fun z_apply(f: fun(i32).return: i32, v: i32).return: i32 = f(v)

fun main() {
    {
        val a = 4
        val b = (-13)
        val x = 1.5
        val y = 1.5
        print(((a - a) % 4))
        print((((1 + (-21)) * (b + 0)) - ((b / 9) * ((-10) % 6))))
        print(0.0625)
        print((100.0 == 3.75))
        if (100.0 == 3.75) {
            print(((-30) % 9))
        } else {
            print((b / 8))
        }
        var i = 0
        var acc = 0
        while i < 6 {
            if ((y - y) > (x - x)) {
                acc = acc + ((8 | a) + ((-13) & b))
            } else {
                acc = acc - ((36 - i) & (30 * i))
            }
            i = i + 1
        }
        print(acc)
        print(!((x * (0.5 + y)) <= 0.5))
    }

    {
        var p = ZPoint(x = (-39), y = 28)
        print(p.x)
        p.x = p.x + (-3)
        print(p.x)
        print(z_psum(p))
        val v = ZVec(x = 0.5, y = 2.25)
        print(z_vsum(v))
        val w = ZVec(x = 1.5, y = 2.25)
        print(w.x)
        print(z_vsum(w))
    }

    {
        val row = ZRow(name = String.from_str("hi"), tag = 19, inner = ZLabel(text = String.from_str("text")))
        print(row.name)
        print(row.tag)
        print(row.inner.text)
        print(row.inner.text.len())
        val owner = ZRow(name = String.from_str("seed"), tag = (-29), inner = ZLabel(text = String.from_str("beta")))
        val moved = owner
        print(moved.name)
        print(moved.inner.text)
    }

    {
        val s = ZShape.Empty
        when s {
            Circle(r) -> print(r)
            Rect(w, h) -> print(w * h)
            Empty -> print(0.0)
        }
        val m = ZMsg.Num(n = (-37))
        when m {
            Num(n) -> print(n)
            Text(t) -> print(t)
            Nil -> print("nil")
        }
        if let Num(k) = m {
            print(k)
        } else {
            print(-1)
        }
        if let Circle(r) = s {
            print(r * 2.0)
        }
    }

    {
        print(z_val(r = z_try(15)))
        print(z_val(r = z_try(-22)))
        print(z_val(r = z_chain(15)))
        print(z_val(r = z_chain(-22)))
    }

    {
        var xs: List<i32> = List.empty()
        print(xs.len())
        print(xs.is_empty())
        xs.push((-18))
        xs.push(17)
        xs.push(12)
        print(xs.get(0))
        xs.set(1, (-16))
        print(xs.get(1))
        print(xs.pop())
        var i: usize = 0
        var sum = 0
        while i < xs.len() {
            sum = sum + xs.get(i)
            i += 1
        }
        print(sum)
        for v in xs {
            print(v)
        }
        xs.reverse()
        print(xs.get(0))
        xs.clear()
        print(xs.len())
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(0.5)
        fs.push(7.5)
        fs.push(0.125)
        fs.push(3.75)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(3.75))
        print(fs.contains(0.5))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: usize = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var msgs: List<ZMsg> = List.empty()
        msgs.push(ZMsg.Text(s = String.from_str("word")))
        msgs.push(ZMsg.Num(n = 12))
        msgs.push(ZMsg.Nil)
        print(msgs.len())
        print(z_msg_int(m = msgs.get(0)))
        msgs.set(i = 1, v = ZMsg.Text(s = String.from_str("hi")))
        print(z_msg_int(m = msgs.get(1)))
        val taken = msgs.pop()
        print(z_msg_int(m = taken))
        msgs.clear()
        print(msgs.len())
        var labels: List<ZLabel> = List.empty()
        labels.push(ZLabel(text = String.from_str("beta")))
        labels.push(ZLabel(text = String.from_str("data")))
        print(labels.get(0).text)
        val last = labels.pop()
        print(last.text)
        labels.clear()
        print(labels.len())
    }

    {
        var m: Map<i64, i32> = Map.new()
        print(m.len())
        m.insert(9, 9)
        m.insert(22, (-8))
        print(m.len())
        print(m.get(9))
        print(m.has(22))
        print(m.has(5))
        print(m.get_or(5, 99))
        m.insert(9, 18)
        print(m.get(9))
        print(m.remove(22))
        print(m.len())
        val ks = m.keys()
        var i: usize = 0
        while i < ks.len() {
            print(ks.get(i))
            i += 1
        }
        var bools: Map<bool, i64> = Map.new()
        bools.insert(true, 5)
        bools.insert(false, 7)
        print(bools.get(true))
        print(bools.len())
    }

    {
        var b: Box<i32> = Box.empty()
        print(b.is_empty())
        b.set((-15))
        print(b.get())
        print(b.take())
        print(b.is_empty())
        val lb = Box.of(ZLabel(text = String.from_str("kelp")))
        print(lb.get().text)
        val nested = Box.of(Box.of(24))
        print(nested.get().get())
        var fb: Box<f64> = Box.empty()
        fb.set(10.0)
        print(fb.get())
    }

    {
        val s = String.from_str("text")
        val f = fun() .return: usize = s.len()
        print(f())
        val k = 38
        val g = fun(x: i32).return: i32 = x + k
        print(g(16))
        val h = z_double
        print(h(16))
        print(z_apply(z_double, 16))
        print(z_apply(h, 16))
        var i = 0
        while i < 3 {
            val t = String.from_str("hi")
            val c = fun() .return: usize = t.len()
            print(c())
            i = i + 1
        }
    }

    {
        print(z_base)
        print(z_doubled)
        print(z_name)
        print(z_primes.len())
        print(z_primes.get(0))
        print(z_origin.x)
        print(z_origin.y)
        print(z_origin.x + z_origin.y)
    }

}
