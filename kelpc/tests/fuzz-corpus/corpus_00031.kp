// fuzz seed 31; shapes: scalar, calls, datac, owns, enum, list_float, list_owned, map, box, array, closure, pd

pd val z_base: i32 = 15
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("x")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_add(a: i32, b: i32) => i32 = ((-27) | (40 / 6))
fun z_scale(a: f64, b: f64) => f64 = 1.5
fun z_mk(n: i32) => ZPoint = ZPoint(x = n, y = n + 1)
fun z_psum(p: ZPoint) => i32 = p.x + p.y
fun z_vsum(v: ZVec) => f64 = v.x + v.y
fun z_msg_int(m: ZMsg) => i32 = when m {
    Num(n) -> n
    Text(t) -> t.len().to_i32()
    Nil -> -1
}
fun z_pair_sum(p: [f64; 2]) => f64 = p.get(i = 0) + p.get(i = 1)
fun z_double(v: i32) => i32 = v * 2
fun z_apply(f: fun(i32) => i32, v: i32) => i32 = f(v)

fun main() {
    {
        val a: i32 = 16
        val b: i32 = 35
        val x = 100.0
        val y = 2.25
        print(((21 & 27) & ((-38) / 9)))
        print(((((-27) ^ a) & 24) << 2))
        print(7.5)
        print(((((b % 5) < (-7)) && false) && ((a * 33) > (28 & (-32)))))
        if ((((b % 5) < (-7)) && false) && ((a * 33) > (28 & (-32)))) {
            print(((-39) + 14))
        } else {
            print((a / 7))
        }
        var i: i32 = 0
        var acc: i32 = 0
        while i < 6 {
            if (31 >= ((b % 4) / 5)) {
                acc = acc + i
            } else {
                acc = acc - (b << 0)
            }
            i = i + 1
        }
        print(acc)
        print(!(true || ((x - 3.75) <= (y / 10.0))))
    }

    {
        print(z_add(28, (-12)))
        print(z_add(z_add(15, 19), (-21)))
        print(z_scale(0.125, 0.5))
        val p = z_mk((-29))
        print(p.x)
        print(p.y)
    }

    {
        var p = ZPoint(x = 32, y = 3)
        print(p.x)
        p.x = p.x + (-15)
        print(p.x)
        print(z_psum(p))
        val v = ZVec(x = 10.0, y = 0.0625)
        print(z_vsum(v))
        val w = ZVec(x = 2.25, y = 0.0625)
        print(w.x)
        print(z_vsum(w))
    }

    {
        val row = ZRow(name = String.from_str("yz"), tag = 4, inner = ZLabel(text = String.from_str("x")))
        print(row.name)
        print(row.tag)
        print(row.inner.text)
        print(row.inner.text.len())
        val owner = ZRow(name = String.from_str("x"), tag = 30, inner = ZLabel(text = String.from_str("yz")))
        val moved = owner
        print(moved.name)
        print(moved.inner.text)
    }

    {
        val s = ZShape.Circle(r = 7.5)
        when s {
            Circle(r) -> print(r)
            Rect(w, h) -> print(w * h)
            Empty -> print(0.0)
        }
        val m = ZMsg.Text(s = String.from_str("word"))
        when m {
            Num(n) -> print(n)
            Text(t) -> print(t)
            Nil -> print("nil")
        }
        if let Num(k) = m {
            print(k)
        } else {
            print(-1)
        }
        if let Circle(r) = s {
            print(r * 2.0)
        }
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(0.0625)
        fs.push(100.0)
        fs.push(0.125)
        fs.push(0.25)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(0.25))
        print(fs.contains(0.0625))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: usize = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var msgs: List<ZMsg> = List.empty()
        msgs.push(ZMsg.Text(s = String.from_str("x")))
        msgs.push(ZMsg.Num(n = (-19)))
        msgs.push(ZMsg.Nil)
        print(msgs.len())
        print(z_msg_int(m = msgs.get(0)))
        msgs.set(i = 1, v = ZMsg.Text(s = String.from_str("text")))
        print(z_msg_int(m = msgs.get(1)))
        val taken = msgs.pop()
        print(z_msg_int(m = taken))
        msgs.clear()
        print(msgs.len())
        var labels: List<ZLabel> = List.empty()
        labels.push(ZLabel(text = String.from_str("kelp")))
        labels.push(ZLabel(text = String.from_str("text")))
        print(labels.get(0).text)
        val last = labels.pop()
        print(last.text)
        labels.clear()
        print(labels.len())
    }

    {
        var m: Map<i64, i32> = Map.new()
        print(m.len())
        m.insert(10, (-22))
        m.insert(27, 11)
        print(m.len())
        print(m.get(10))
        print(m.has(27))
        print(m.has(34))
        print(m.get_or(34, 99))
        m.insert(10, (-33))
        print(m.get(10))
        print(m.remove(27))
        print(m.len())
        val ks = m.keys()
        var i: usize = 0
        while i < ks.len() {
            print(ks.get(i))
            i += 1
        }
        var bools: Map<bool, i64> = Map.new()
        bools.insert(true, 5)
        bools.insert(false, 7)
        print(bools.get(true))
        print(bools.len())
    }

    {
        var b: Box<i32> = Box.empty()
        print(b.is_empty())
        b.set((-20))
        print(b.get())
        print(b.take())
        print(b.is_empty())
        val lb = Box.of(ZLabel(text = String.from_str("text")))
        print(lb.get().text)
        val nested = Box.of(Box.of(16))
        print(nested.get().get())
        var fb: Box<f64> = Box.empty()
        fb.set(0.0625)
        print(fb.get())
    }

    {
        val xs: [i32; 3] = [39, 35, 5]
        print(xs.len())
        print(xs.get(i = 1))
        for v in xs {
            print(v)
        }
        var buf: [f64; 3] = [1.5, 100.0, 0.25]
        buf.set(i = 2, v = 1.5)
        print(buf.get(i = 2))
        val pair: [f64; 2] = [100.0, 0.25]
        print(z_pair_sum(pair))
        val grid: [[i32; 2]; 2] = [[13, 38], [(-26), 13]]
        print(grid.get(i = 1).get(i = 0))
        val pts: [ZPoint; 2] = [ZPoint(x = 39, y = 35), ZPoint(x = 5, y = 13)]
        print(pts.get(i = 0).x)
        print(pts.get(i = 1).y)
    }

    {
        val s = String.from_str("word")
        val f = fun() => usize = s.len()
        print(f())
        val k: i32 = 27
        val g = fun(x: i32) => i32 = x + k
        print(g(6))
        val h = z_double
        print(h(6))
        print(z_apply(z_double, 6))
        print(z_apply(h, 6))
        var i: i32 = 0
        while i < 3 {
            val t = String.from_str("kelp")
            val c = fun() => usize = t.len()
            print(c())
            i = i + 1
        }
    }

    {
        print(z_base)
        print(z_doubled)
        print(z_name)
        print(z_primes.len())
        print(z_primes.get(0))
        print(z_origin.x)
        print(z_origin.y)
        print(z_origin.x + z_origin.y)
    }

}
