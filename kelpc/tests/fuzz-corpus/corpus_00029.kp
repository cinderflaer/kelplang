// fuzz seed 29; shapes: scalar, calls, datac, owns, try, strings, list_float, list_owned, box, array, refs, closure, pd

pd val z_base: i32 = 7
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("word")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_add(a: i32, b: i32) => i32 = ((33 | a) & ((-2) << 2))
fun z_scale(a: f64, b: f64) => f64 = ((a / 1.5) + (b * b))
fun z_mk(n: i32) => ZPoint = ZPoint(x = n, y = n + 1)
fun z_psum(p: ZPoint) => i32 = p.x + p.y
fun z_vsum(v: ZVec) => f64 = v.x + v.y
fun z_try(n: i32) => ZRes {
    if n > 0 {
        return ZRes.Ok(value = n)
    }
    return ZRes.Err(why = 0)
}
fun z_chain(n: i32) => ZRes {
    val v = z_try(n)?
    return ZRes.Ok(value = v + 1)
}
fun z_val(r: ZRes) => i32 = when r {
    Ok(v) -> v
    Err(_e) -> -1
}
fun z_msg_int(m: ZMsg) => i32 = when m {
    Num(n) -> n
    Text(t) -> t.len().to_i32()
    Nil -> -1
}
fun z_pair_sum(p: [f64; 2]) => f64 = p.get(i = 0) + p.get(i = 1)
fun z_bump(p: mut i32, d: i32) {
    *p = *p + d
}
fun z_scale_f(p: mut f64, by: f64) {
    *p = *p * by
}
fun z_double(v: i32) => i32 = v * 2
fun z_apply(f: fun(i32) => i32, v: i32) => i32 = f(v)

fun main() {
    {
        val a: i32 = 19
        val b: i32 = 35
        val x = 10.0
        val y = 100.0
        print((((-21) + a) % 1))
        print(((((-38) - (-18)) ^ (a / 7)) << 2))
        print(((0.25 + y) / 0.25))
        print(((((100.0 * 10.0) + (y * y)) <= ((x / 3.75) * (x * 7.5))) || (!true)))
        if ((((100.0 * 10.0) + (y * y)) <= ((x / 3.75) * (x * 7.5))) || (!true)) {
            print((-32))
        } else {
            print(b)
        }
        var i: i32 = 0
        var acc: i32 = 0
        while i < 5 {
            if (!(!((b ^ b) != ((-6) ^ 4)))) {
                acc = acc + (a | (10 << 3))
            } else {
                acc = acc - ((i | (-12)) * (b * 38))
            }
            i = i + 1
        }
        print(acc)
        print(!(x == 3.75))
    }

    {
        print(z_add(36, 12))
        print(z_add(z_add((-20), (-9)), (-32)))
        print(z_scale(0.0625, 10.0))
        val p = z_mk((-36))
        print(p.x)
        print(p.y)
    }

    {
        var p = ZPoint(x = 39, y = 4)
        print(p.x)
        p.x = p.x + (-6)
        print(p.x)
        print(z_psum(p))
        val v = ZVec(x = 2.25, y = 0.25)
        print(z_vsum(v))
        val w = ZVec(x = 1.5, y = 3.75)
        print(w.x)
        print(z_vsum(w))
    }

    {
        val row = ZRow(name = String.from_str("alpha"), tag = (-16), inner = ZLabel(text = String.from_str("word")))
        print(row.name)
        print(row.tag)
        print(row.inner.text)
        print(row.inner.text.len())
        val owner = ZRow(name = String.from_str("x"), tag = 23, inner = ZLabel(text = String.from_str("hi")))
        val moved = owner
        print(moved.name)
        print(moved.inner.text)
    }

    {
        print(z_val(r = z_try(48)))
        print(z_val(r = z_try(-17)))
        print(z_val(r = z_chain(48)))
        print(z_val(r = z_chain(-17)))
    }

    {
        var b = Bytes.empty()
        b.push(173)
        b.push(40)
        val tail = Bytes.from_str("word")
        b.append(tail)
        print(b.len())
        print(b.get(0))
        print(b.is_empty())
        val s = String.from_str("word")
        print(s)
        print(s.len())
        val e = String.from_str("word")
        print(e)
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(3.75)
        fs.push(2.25)
        fs.push(0.25)
        fs.push(0.25)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(0.25))
        print(fs.contains(3.75))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: int = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var msgs: List<ZMsg> = List.empty()
        msgs.push(ZMsg.Text(s = String.from_str("kelp")))
        msgs.push(ZMsg.Num(n = 40))
        msgs.push(ZMsg.Nil)
        print(msgs.len())
        print(z_msg_int(m = msgs.get(0)))
        msgs.set(i = 1, v = ZMsg.Text(s = String.from_str("seed")))
        print(z_msg_int(m = msgs.get(1)))
        val taken = msgs.pop()
        print(z_msg_int(m = taken))
        msgs.clear()
        print(msgs.len())
        var labels: List<ZLabel> = List.empty()
        labels.push(ZLabel(text = String.from_str("beta")))
        labels.push(ZLabel(text = String.from_str("word")))
        print(labels.get(0).text)
        val last = labels.pop()
        print(last.text)
        labels.clear()
        print(labels.len())
    }

    {
        var b: Box<i32> = Box.empty()
        print(b.is_empty())
        b.set((-22))
        print(b.get())
        print(b.take())
        print(b.is_empty())
        val lb = Box.of(ZLabel(text = String.from_str("beta")))
        print(lb.get().text)
        val nested = Box.of(Box.of(38))
        print(nested.get().get())
        var fb: Box<f64> = Box.empty()
        fb.set(1.5)
        print(fb.get())
    }

    {
        val xs: [i32; 3] = [(-10), 26, 4]
        print(xs.len())
        print(xs.get(i = 1))
        for v in xs {
            print(v)
        }
        var buf: [f64; 3] = [100.0, 0.25, 0.25]
        buf.set(i = 2, v = 100.0)
        print(buf.get(i = 2))
        val pair: [f64; 2] = [0.25, 0.25]
        print(z_pair_sum(pair))
        val grid: [[i32; 2]; 2] = [[8, (-25)], [17, 39]]
        print(grid.get(i = 1).get(i = 0))
        val pts: [ZPoint; 2] = [ZPoint(x = (-10), y = 26), ZPoint(x = 4, y = 8)]
        print(pts.get(i = 0).x)
        print(pts.get(i = 1).y)
    }

    {
        var n: i32 = (-32)
        z_bump(n, (-20))
        print(n)
        var f: f64 = 100.0
        z_scale_f(f, 0.0625)
        print(f)
        val r = &n
        print(*r)
        var p = ZPoint(x = 40, y = 27)
        val q = &p
        print((*q).x)
        p.y = p.y + (-20)
        print((*q).y)
    }

    {
        val s = String.from_str("text")
        val f = fun() => int = s.len()
        print(f())
        val k: i32 = 20
        val g = fun(x: i32) => i32 = x + k
        print(g((-4)))
        val h = z_double
        print(h((-4)))
        print(z_apply(z_double, (-4)))
        print(z_apply(h, (-4)))
        var i: i32 = 0
        while i < 3 {
            val t = String.from_str("hi")
            val c = fun() => int = t.len()
            print(c())
            i = i + 1
        }
    }

    {
        print(z_base)
        print(z_doubled)
        print(z_name)
        print(z_primes.len())
        print(z_primes.get(0))
        print(z_origin.x)
        print(z_origin.y)
        print(z_origin.x + z_origin.y)
    }

}
