// fuzz seed 17; shapes: scalar, calls, datac, owns, enum, try, strings, list, list_float, map, array, refs, closure, pd

pd val z_base: i32 = 18
pd val z_doubled = z_base * 2
pd val z_name = String.from_str("data")
pd val z_origin = ZPoint(x = z_base, y = z_doubled)
pd val z_primes = List.of(7)

datac ZPoint(var x: i32, var y: i32)

datac ZVec(val x: f64, val y: f64)

datac ZLabel(val text: String)

datac ZRow(val name: String, val tag: i32, val inner: ZLabel)

enum ZShape {
    Circle(val r: f64)
    Rect(val w: f64, val h: f64)
    Empty
}

enum ZMsg {
    Num(val n: i32)
    Text(val s: String)
    Nil
}

enum ZRes {
    Ok(val value: i32)
    Err(val why: i32)
}

fun z_add(a: i32, b: i32) => i32 = ((37 % 3) ^ (16 / 7))
fun z_scale(a: f64, b: f64) => f64 = ((a * 0.0625) / 10.0)
fun z_mk(n: i32) => ZPoint = ZPoint(x = n, y = n + 1)
fun z_psum(p: ZPoint) => i32 = p.x + p.y
fun z_vsum(v: ZVec) => f64 = v.x + v.y
fun z_try(n: i32) => ZRes {
    if n > 0 {
        return ZRes.Ok(value = n)
    }
    return ZRes.Err(why = 0)
}
fun z_chain(n: i32) => ZRes {
    val v = z_try(n)?
    return ZRes.Ok(value = v + 1)
}
fun z_val(r: ZRes) => i32 = when r {
    Ok(v) -> v
    Err(_e) -> -1
}
fun z_pair_sum(p: [f64; 2]) => f64 = p.get(i = 0) + p.get(i = 1)
fun z_bump(p: mut i32, d: i32) {
    *p = *p + d
}
fun z_scale_f(p: mut f64, by: f64) {
    *p = *p * by
}
fun z_double(v: i32) => i32 = v * 2
fun z_apply(f: fun(i32) => i32, v: i32) => i32 = f(v)

fun main() {
    {
        val a: i32 = (-37)
        val b: i32 = (-39)
        val x = 0.125
        val y = 2.25
        print(a)
        print((((b / 4) & (b - 29)) + ((b ^ 25) ^ (37 & (-12)))))
        print(((x / 0.25) + (3.75 / 0.25)))
        print(((((y * x) / 0.0625) != ((x + 0.5) + (x / 1.5))) && (!((y - y) != y))))
        if ((((y * x) / 0.0625) != ((x + 0.5) + (x / 1.5))) && (!((y - y) != y))) {
            print((b ^ b))
        } else {
            print((a - (-37)))
        }
        var i: i32 = 0
        var acc: i32 = 0
        while i < 6 {
            if (!(((b % 2) > (3 + b)) && ((30 & a) != (12 / 3)))) {
                acc = acc + ((29 << 1) % 8)
            } else {
                acc = acc - ((a << 2) ^ (-17))
            }
            i = i + 1
        }
        print(acc)
        print(!(((8 % 4) ^ (b + (-20))) != ((25 % 1) ^ (a * b))))
    }

    {
        print(z_add(23, (-9)))
        print(z_add(z_add(6, 17), (-1)))
        print(z_scale(0.125, 0.25))
        val p = z_mk(20)
        print(p.x)
        print(p.y)
    }

    {
        var p = ZPoint(x = (-10), y = (-38))
        print(p.x)
        p.x = p.x + (-1)
        print(p.x)
        print(z_psum(p))
        val v = ZVec(x = 10.0, y = 0.25)
        print(z_vsum(v))
        val w = ZVec(x = 1.5, y = 7.5)
        print(w.x)
        print(z_vsum(w))
    }

    {
        val row = ZRow(name = String.from_str("text"), tag = 15, inner = ZLabel(text = String.from_str("word")))
        print(row.name)
        print(row.tag)
        print(row.inner.text)
        print(row.inner.text.len())
        val owner = ZRow(name = String.from_str("kelp"), tag = (-6), inner = ZLabel(text = String.from_str("data")))
        val moved = owner
        print(moved.name)
        print(moved.inner.text)
    }

    {
        val s = ZShape.Rect(w = 0.125, h = 10.0)
        when s {
            Circle(r) -> print(r)
            Rect(w, h) -> print(w * h)
            Empty -> print(0.0)
        }
        val m = ZMsg.Nil
        when m {
            Num(n) -> print(n)
            Text(t) -> print(t)
            Nil -> print("nil")
        }
        if let Num(k) = m {
            print(k)
        } else {
            print(-1)
        }
        if let Circle(r) = s {
            print(r * 2.0)
        }
    }

    {
        print(z_val(r = z_try(4)))
        print(z_val(r = z_try(-41)))
        print(z_val(r = z_chain(4)))
        print(z_val(r = z_chain(-41)))
    }

    {
        var b = Bytes.empty()
        b.push(243)
        b.push(2)
        val tail = Bytes.from_str("word")
        b.append(tail)
        print(b.len())
        print(b.get(0))
        print(b.is_empty())
        val s = String.from_str("text")
        print(s)
        print(s.len())
        val e = String.from_str("kelp")
        print(e)
    }

    {
        var xs: List<i32> = List.empty()
        print(xs.len())
        print(xs.is_empty())
        xs.push((-31))
        xs.push((-1))
        xs.push((-32))
        print(xs.get(0))
        xs.set(1, (-13))
        print(xs.get(1))
        print(xs.pop())
        var i: int = 0
        var sum: i32 = 0
        while i < xs.len() {
            sum = sum + xs.get(i)
            i += 1
        }
        print(sum)
        for v in xs {
            print(v)
        }
        xs.reverse()
        print(xs.get(0))
        xs.clear()
        print(xs.len())
    }

    {
        var fs: List<f64> = List.empty()
        fs.push(7.5)
        fs.push(1.5)
        fs.push(7.5)
        fs.push(0.5)
        print(fs.len())
        print(fs.get(0))
        print(fs.get(3))
        print(fs.contains(0.5))
        print(fs.contains(7.5))
        fs.sort()
        print(fs.get(0))
        print(fs.get(3))
        val copy = fs.clone()
        print(copy.len())
        val mid = fs.slice(0, 2)
        print(mid.get(0))
        print(mid.get(1))
        var i: int = 0
        var s = 0.0
        while i < fs.len() {
            s = s + fs.get(i)
            i += 1
        }
        print(s)
        var narrow: List<f32> = List.empty()
        narrow.push(1.5)
        narrow.push(2.5)
        print(narrow.get(1))
        print(narrow.contains(2.5))
    }

    {
        var m: Map<i64, i32> = Map.new()
        print(m.len())
        m.insert(16, (-36))
        m.insert(35, 21)
        print(m.len())
        print(m.get(16))
        print(m.has(35))
        print(m.has(33))
        print(m.get_or(33, 99))
        m.insert(16, (-9))
        print(m.get(16))
        print(m.remove(35))
        print(m.len())
        val ks = m.keys()
        var i: int = 0
        while i < ks.len() {
            print(ks.get(i))
            i += 1
        }
        var bools: Map<bool, i64> = Map.new()
        bools.insert(true, 5)
        bools.insert(false, 7)
        print(bools.get(true))
        print(bools.len())
    }

    {
        val xs: [i32; 3] = [13, (-31), (-15)]
        print(xs.len())
        print(xs.get(i = 1))
        for v in xs {
            print(v)
        }
        var buf: [f64; 3] = [100.0, 0.0625, 3.75]
        buf.set(i = 2, v = 100.0)
        print(buf.get(i = 2))
        val pair: [f64; 2] = [0.0625, 3.75]
        print(z_pair_sum(pair))
        val grid: [[i32; 2]; 2] = [[35, 16], [(-21), (-7)]]
        print(grid.get(i = 1).get(i = 0))
        val pts: [ZPoint; 2] = [ZPoint(x = 13, y = (-31)), ZPoint(x = (-15), y = 35)]
        print(pts.get(i = 0).x)
        print(pts.get(i = 1).y)
    }

    {
        var n: i32 = (-13)
        z_bump(n, (-9))
        print(n)
        var f: f64 = 2.25
        z_scale_f(f, 7.5)
        print(f)
        val r = &n
        print(*r)
        var p = ZPoint(x = 13, y = (-6))
        val q = &p
        print((*q).x)
        p.y = p.y + (-9)
        print((*q).y)
    }

    {
        val s = String.from_str("yz")
        val f = fun() => int = s.len()
        print(f())
        val k: i32 = (-32)
        val g = fun(x: i32) => i32 = x + k
        print(g((-3)))
        val h = z_double
        print(h((-3)))
        print(z_apply(z_double, (-3)))
        print(z_apply(h, (-3)))
        var i: i32 = 0
        while i < 3 {
            val t = String.from_str("alpha")
            val c = fun() => int = t.len()
            print(c())
            i = i + 1
        }
    }

    {
        print(z_base)
        print(z_doubled)
        print(z_name)
        print(z_primes.len())
        print(z_primes.get(0))
        print(z_origin.x)
        print(z_origin.y)
        print(z_origin.x + z_origin.y)
    }

}
