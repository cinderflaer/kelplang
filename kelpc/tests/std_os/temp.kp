impl "std/os" caps(fs = ["__SCRATCH__/**"], machine = [])
impl "std/fs" caps(fs = ["__SCRATCH__/**"])
impl "std/str"
impl "std/result"

// A helper's temporary directory is removed when the helper returns, because
// the TempDir it owns is dropped at the end of its scope.
fun scoped() => String {
    val td = os.tempDir()
    val tpl = str.concat(td, "/kelp-s-XXXXXX")
    val dr = os.makeTempDir(tpl)
    let Ok(d) = &dr else { panic("no temporary directory") }
    val p = d.path()
    val file = str.concat(p, "/a.txt")
    result.expect(fs.writeText(file, String.from_str("x")), "fs.write_text: the call failed")
    return p
}

fun main() {
    val gone = scoped()
    print(fs.exists(gone))
    val td = os.tempDir()
    val tplK = str.concat(td, "/kelp-k-XXXXXX")
    val dk = os.makeTempDir(tplK)
    let Ok(d) = &dk else { panic("no temporary directory") }
    val q = d.path()
    print(fs.isDir(q))
    print(str.startsWith(q, "__SCRATCH__/"))
    val tplF = str.concat(td, "/kelp-f-XXXXXX")
    val ff = os.makeTempFile(tplF)
    let Ok(f) = &ff else { panic("no temporary file") }
    val fp = f.path()
    print(fs.isFile(fp))
    val badTpl = str.concat(td, "/bad")
    val bad = os.makeTempDir(badTpl)
    print(bad.isErr())
    val badFile = os.makeTempFile(badTpl)
    print(badFile.isErr())
    print(q)
    print(fp)
}
