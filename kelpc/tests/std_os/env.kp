impl "std/os" caps(env = ["OS_TEST_*"])
impl "std/str"

// The variables a grant names can be set, read, and removed. A variable the
// program never set is absent, and `None` says so, not an empty value.
fun main() {
    os.setEnvVar("OS_TEST_A", "one")
    val a = os.envVar("OS_TEST_A")
    print(a.isSome())
    let Some(value) = a else { panic("OS_TEST_A is unset") }
    print(value)
    os.unsetEnvVar("OS_TEST_A")
    val gone = os.envVar("OS_TEST_A")
    print(gone.isNone())
    val never = os.envVar("OS_TEST_NEVER_SET")
    print(never.isNone())
}
