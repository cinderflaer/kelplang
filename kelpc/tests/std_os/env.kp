impl "std/os" caps(env = ["OS_TEST_*"])
impl "std/str"

// The variables a grant names can be set, read, and removed. A variable the
// program never set is absent, and `None` says so, not an empty value.
fun main() {
    os.set_env_var("OS_TEST_A", "one")
    val a = os.env_var("OS_TEST_A")
    print(a.is_some())
    let Some(value) = a else { panic("OS_TEST_A is unset") }
    print(value)
    os.unset_env_var("OS_TEST_A")
    val gone = os.env_var("OS_TEST_A")
    print(gone.is_none())
    val never = os.env_var("OS_TEST_NEVER_SET")
    print(never.is_none())
}
