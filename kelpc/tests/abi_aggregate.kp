// BUG-vN4tR: a 24-byte `Bytes` crosses into the C runtime through the hidden
// pointer, not by value.
//
// The gate `kelpc/tests/run-llvm-abi.sh` links this program's object against a
// genuine C object (`kelpc/runtime/abi_aggregate.c`) that defines `mem.alloc`'s
// extern body with the pointer-spelled ABI the backend declares. It prints
// whatever that object returns, so the text `ZY` is proof the 24-byte aggregate
// crossed by the hidden pointer. The compiler's own body returns a zero-filled
// buffer, which prints as an empty line.
impl "std/mem"

fun main() {
    val b = mem.alloc(3)
    print(b)
}
