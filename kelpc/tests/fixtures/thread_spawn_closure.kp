// MK9-S3-M1 stage C1: the accepted `thread.spawn` shape with a *capturing
// closure* as the entry point, which is the third spelling the surface allows
// beside a declared `fun` and a `fun` literal that captured nothing. The literal
// names `base`, so it is a closure with an environment; the worker reads that
// environment and the join proves the capture crossed the thread boundary.
impl "std/thread"
impl "std/result"

fun main() {
    val base: i64 = 40
    val h = thread.spawn(fun(x: move i64).R: i64 = x + base, 2)
    when thread.join(h) {
        Ok(v) -> print(v)
        Err(e) -> print(e.message)
    }
}
