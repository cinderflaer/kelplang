// MK9-S3-M1 stage C1: the accepted `thread.spawn` shape with a `fun` literal as
// the entry point. A closure that captures values is refused in a hosted build (its
// environment would sit in the collected heap, which the collector does not scan
// for a thread), so the literal takes its constant in its body and the argument
// crosses the thread boundary.
impl "std/thread"
impl "std/result"

fun main() {
    val h = thread.spawn(fun(x: move i64).return: i64 = x + 40, 2)
    when thread.join(h) {
        Ok(v) -> print(v)
        Err(e) -> print(e.message)
    }
}
