// Manual memory blocks (decision 139, step 4): a List made inside a block is
// shared-pool memory, which the block cannot free, so it is refused by name.
impl "std/result"

datac Node(val value: i32)

fun make() => result.Result<i32, BlockError> {
    val n = block request: Node {
        val cell = request.box()?
        var items: List<i32> = List.empty()
        items.push(1)
        Node(value = cell.value + items.len().to_i32())
    }?
    return result.Result.Ok<i32, BlockError>(value = n.value)
}

fun main() {
    print(0)
}
