trait Describe {
    fun Self.describe() => i32
}

impl Describe for i32 {
    fun Self.describe() => i32 = self
}

datac Pair<A, B>(val a: A, val b: B)

impl<A: Describe, B: Describe> Describe for Pair<A, B> {
    fun Self.describe() => i32 {
        return self.a.describe() * 10 + self.b.describe()
    }
}

trait Doubled {
    fun Self.doubled() => i32
}

impl<T: Describe> Doubled for T {
    fun Self.doubled() => i32 {
        return self.describe() * 2
    }
}

fun twice<T: Doubled>(x: &T) => i32 {
    return x.doubled() + x.doubled()
}

fun main() {
    val n: i32 = 5
    print(twice(n))
    val p = Pair(a = 1, b = 2)
    print(twice(p))
}
