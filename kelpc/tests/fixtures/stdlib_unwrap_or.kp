impl "std/option"
impl "std/result"

// `unwrap_or` as a method on Option and Result (issue #311). A `Copy`
// payload uses the method form; an owned payload keeps the free form, which
// takes the option with `move`.

fun main() {
    val some: option.Option<i32> = option.Option.Some(value = 4)
    val none: option.Option<i32> = option.Option.None
    print(some.unwrapOr(0))
    print(none.unwrapOr(9))

    // The error is hidden by the default: the `Err` payload is dropped, so
    // its type needs no `Copy`.
    val ok: result.Result<i32, String> = result.Result.Ok(value = 3)
    val bad: result.Result<i32, String> = result.Result.Err(error = "bad")
    print(ok.unwrapOr(-1))
    print(bad.unwrapOr(-1))

    // The free forms still take their receiver as before.
    val name: option.Option<String> = option.Option.Some(value = "kelp")
    print(option.unwrapOr(o = name, fallback = "none"))
    val gone: option.Option<String> = option.Option.None
    print(option.unwrapOr(o = gone, fallback = "none"))
    print(result.unwrapOr(r = ok, fallback = 0))
    print(result.unwrapOr(r = bad, fallback = 0))
}
// stdout-begin
// stdout: 4
// stdout: 9
// stdout: 3
// stdout: -1
// stdout: kelp
// stdout: none
// stdout: 3
// stdout: 0
