impl "std/option"
impl "std/result"

// `unwrap_or` as a method on Option and Result (issue #311). A `Copy`
// payload uses the method form; an owned payload keeps the free form, which
// takes the option with `move`.

fun main() {
    val some: option.Option<i32> = option.Option.Some(value = 4)
    val none: option.Option<i32> = option.Option.None
    print(some.unwrap_or(0))
    print(none.unwrap_or(9))

    // The error is hidden by the default: the `Err` payload is dropped, so
    // its type needs no `Copy`.
    val ok: result.Result<i32, String> = result.Result.Ok(value = 3)
    val bad: result.Result<i32, String> = result.Result.Err(error = String.from_str("bad"))
    print(ok.unwrap_or(-1))
    print(bad.unwrap_or(-1))

    // The free forms still take their receiver as before.
    val name: option.Option<String> = option.Option.Some(value = String.from_str("kelp"))
    print(option.unwrap_or(o = name, fallback = String.from_str("none")))
    val gone: option.Option<String> = option.Option.None
    print(option.unwrap_or(o = gone, fallback = String.from_str("none")))
    print(result.unwrap_or(r = ok, fallback = 0))
    print(result.unwrap_or(r = bad, fallback = 0))
}
// stdout-begin
// stdout: 4
// stdout: 9
// stdout: 3
// stdout: -1
// stdout: kelp
// stdout: none
// stdout: 3
// stdout: 0
