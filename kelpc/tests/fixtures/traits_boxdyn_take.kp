// A-12 slice 7: moving the value out of an owned trait object is refused by
// name. `Box.take`/`Box.set` need a sized element, and an owned trait object
// has none; `get` borrows the trait back out instead.
trait Shape {
    fun Self.area() => f64
}

datac Circle(val r: f64)
impl Shape for Circle {
    fun Self.area() => f64 = r * r * 3.0
}

fun make() => Box<dyn Shape> = Box.of(Circle(r = 1.0))

fun main() {
    var b = make()
    val taken = b.take()
    print(taken.area())
}
