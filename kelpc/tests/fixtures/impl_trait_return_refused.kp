// A-20: `impl Trait` is not allowed in return position, and the refusal names
// the alternatives rather than reporting a parse error.
trait Shape {
    fun Self.area().return: i32
}

datac Square(val side: i32)

impl Shape for Square {
    fun Self.area().return: i32 = side * side
}

fun make().return: impl Shape = Square(side = 1)

fun main() {
    print(make().area())
}
