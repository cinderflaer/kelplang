// The `?` refusal is about the block the `defer` is written in. A `?` inside a
// `fun` literal belongs to the closure, which leaves on its own, so the outer
// block's `defer` is untouched by it.
impl "std/option"

fun g(x: i32) => option.Option<i32> = option.Option.Some(value = x)

fun main() {
    defer print("out")
    val c = fun(x: i32) => option.Option<i32> = {
        val v = g(x = x)?
        option.Option.Some(value = v + 1)
    }
    print(option.unwrap(o = c(3)))
}
// stdout-begin
// stdout: 4
// stdout: out
