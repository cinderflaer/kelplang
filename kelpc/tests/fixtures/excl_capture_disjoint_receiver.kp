// The receiver is a field of the owner and the block writes another field of it:
// `s.bag` and `s.count` are different places, so they do not conflict (this was
// refused while borrow roots were whole variables, MISSING-Sw9Hd).
datac Bag(var n: i32)
datac State(var count: i32, var bag: Bag)

fun mut Bag.each(f: scoped fun(i32)) {
    f(1)
    n += 1
}

fun main() {
    var s = State(count = 0, bag = Bag(n = 0))
    s.bag.each { x ->
        s.count += x
    }
    print(s.count)
}
// stdout-begin
// stdout: 1
