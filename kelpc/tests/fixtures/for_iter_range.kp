// `kelp wiki page language/iterators.md`: `for` over a `List`/array keeps the index walk, and
// everything else is the `Iterator` protocol. `Range` is the shipped iterator,
// and the loop is its `next()` desugar.
impl "std/iter"

fun main() {
    for i in iter.range(0, 5) {
        print(i)
    }
    // A step and a descending range are the same loop with a different step.
    for i in iter.rangeStep(0, 6, 2) {
        print(i)
    }
    for i in iter.rangeStep(3, 0, -1) {
        print(i)
    }
}
// stdout-begin
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 4
// stdout: 0
// stdout: 2
// stdout: 4
// stdout: 3
// stdout: 2
// stdout: 1
