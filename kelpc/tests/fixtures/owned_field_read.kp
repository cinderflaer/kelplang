// A partial move takes the field out, and the second statement then reaches
// through the field that is gone: `bag.xs` is a use of a moved value. The rule
// this fixture was written for is the same one, one step later: a shallow copy
// would leave the binding as a second owner of the buffer the copy holds, so
// the field has to be borrowed or held in a `Box` and taken, and a read that
// does take it clears the source.
datac Bag(val xs: List<i32>)

fun main() {
    var bag = Bag(xs = List.of(1))
    var stolen = bag.xs
    bag.xs.push(2)
    print(stolen.get(0))
}
