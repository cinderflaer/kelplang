// A partial move takes the field out, so what is left of the binding is a
// moved value: the second statement reaches through the field that is gone and
// `bag.xs` is a use of a moved value. The read that took the field cleared the
// source, so the binding is not a second owner of the buffer the moved value
// now holds; the moved field is only reachable as a moved value again.
datac Bag(val xs: List<i32>)

fun main() {
    var bag = Bag(xs = List.of(1))
    var stolen = bag.xs
    bag.xs.push(2)
    print(stolen.get(0))
}
