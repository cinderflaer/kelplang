impl "std/net"
impl "std/result"

// `poll` readiness: one thread can serve many sockets by asking which of them
// has something to say instead of blocking on one. Every wait here is bounded,
// which is the property that makes a loop possible at all.
fun main() {
    val l = net.listen(0)
    val port = l.port()
    val c = result.expect(net.connect("127.0.0.1", port), "net.connect: the call failed")
    val s = result.expect(net.accept(l), "net.accept: the call failed")

    // Nothing has been sent yet, so a short wait reports false. This is a
    // timeout rather than a hang, the whole point of `wait_readable`.
    print(s.waitReadable(10))
    // A freshly connected socket has room to write.
    print(c.waitWritable(1000))

    net.sendText(c, "now")
    print(s.waitReadable(2000))
    val got = result.expect(net.recv(s, 8), "net.recv: the call failed")
    print(got)

    // After the peer closes its writing half the socket is readable again, and
    // the read reports end of file, a readiness a loop must not spin on.
    result.expect(net.shutdownWrite(c), "net.shutdown_write: the call failed")
    print(s.waitReadable(2000))
    val eof = result.expect(net.recv(s, 8), "net.recv: the call failed")
    print(eof.is_empty())

    net.close(c)
    net.close(s)
    l.close()
}
// stdout-begin
// stdout: false
// stdout: true
// stdout: true
// stdout: now
// stdout: true
// stdout: true
