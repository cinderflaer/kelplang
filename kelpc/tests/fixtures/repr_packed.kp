// Kernel stage 2 (MK9-S1-M2): `repr(packed)` gives alignment 1 and no padding,
// which is a packed struct body in LLVM IR. The offsets and the total size are
// the ones the packed layout gives the same fields, and reading the fields back
// exercises the unaligned accesses the packed body produces.
repr(packed) datac Header(val kind: u8, val length: u32, val flags: u16)

fun main() {
    print(size_of<Header>())
    print(align_of<Header>())
    print(offset_of<Header>("kind"))
    print(offset_of<Header>("length"))
    print(offset_of<Header>("flags"))

    val h = Header(kind = 7, length = 0x11223344, flags = 0x5566)
    print(h.kind)
    print(h.length)
    print(h.flags)
}
// stdout-begin
// stdout: 7
// stdout: 1
// stdout: 0
// stdout: 1
// stdout: 5
// stdout: 7
// stdout: 287454020
// stdout: 21862
