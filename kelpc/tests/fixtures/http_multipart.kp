// MISSING-j2Wka: a multipart/form-data body is built, not sent. The program
// prints the content type, then the body with CR shown as `\r`, so the exact
// wire bytes are pinned; a hostile name cannot add a part or a header.
impl "std/http" caps(net = ["127.0.0.1:*"])
impl "std/mem"
impl "std/str"

fun main() {
    var form = http.multipart("xXboundaryXx")
    form.addField("content", "hello")
    form.addField("a\"b\r\nX: y", "v")
    form.addFile("file", "n\"ote.txt", "text/plain", Bytes.from_str("line1\nline2"))
    print(form.contentType())
    val req = http.multipartRequest("http://127.0.0.1:1/up", &mut form)
    val text = str.replace(req.body.as_str(), "\r", "\\r")
    print(text)
    print(req.headers.get(0).value)
    print(req.method)
}
// stdout-begin
// stdout: multipart/form-data; boundary=xXboundaryXx
// stdout: --xXboundaryXx\r
// stdout: Content-Disposition: form-data; name="content"\r
// stdout: \r
// stdout: hello\r
// stdout: --xXboundaryXx\r
// stdout: Content-Disposition: form-data; name="a%22b%0D%0AX: y"\r
// stdout: \r
// stdout: v\r
// stdout: --xXboundaryXx\r
// stdout: Content-Disposition: form-data; name="file"; filename="n%22ote.txt"\r
// stdout: Content-Type: text/plain\r
// stdout: \r
// stdout: line1
// stdout: line2\r
// stdout: --xXboundaryXx--\r
// stdout:
// stdout: multipart/form-data; boundary=xXboundaryXx
// stdout: POST
