trait Describe {
    fun Self.describe().return: i32
}

trait Shown {
    fun Self.shown().return: i32
}

impl Describe for i32 {
    fun Self.describe().return: i32 = self
}

impl<T: Shown> Describe for T {
    fun Self.describe().return: i32 {
        return 1
    }
}

fun main() {
    print(1)
}
