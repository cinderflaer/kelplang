// A-12 slice 6: a type implements one trait instance at most once, so a second
// `impl From<E> for T` is the coherence error.
impl "std/convert"

enum E {
    A(val x: i32)
}

datac T(val y: i32)

impl convert.From<E> for T {
    fun from(value: E).R: T = T(y = 1)
}

impl convert.From<E> for T {
    fun from(value: E).R: T = T(y = 2)
}

fun main() { }
