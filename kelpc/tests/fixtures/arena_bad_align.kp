// A non-power-of-two `align` is a programming error the arena refuses at the
// call: three is neither zero nor a power of two, so `alloc` reaches the module's
// `panic` and the message names the rule.
impl "std/arena"

fun main() {
    var buf: [u8; 64] = [0; 64]
    val bp: Ptr<[u8; 64]> = Ptr.from_ref(&buf)
    val base: Ptr<u8> = bp.cast<u8>()
    var a: arena.Arena = arena.new(base = base, cap = 64)
    val p: Ptr<u8> = a.alloc(size = 1, align = 3)
    print(p.is_null())
}
