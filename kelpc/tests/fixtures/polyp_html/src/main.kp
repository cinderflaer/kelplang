// The normal Polyp app of the HTML emit fixture: it opens a window. The view and the update are in
// `app.kp`, and `emit.kp` is the entry that `[build] emit = "html"` compiles instead of this file.
impl "deps/polyp/backends/gtk/polyp/lib" caps(ui = ["*"])
impl "app"

fun main() {
    val final = polyp.run(
        title = "polyp html",
        width = 320,
        height = 200,
        init = app.Counter(count = 2),
        view = app.view,
        update = app.update,
    )
}
