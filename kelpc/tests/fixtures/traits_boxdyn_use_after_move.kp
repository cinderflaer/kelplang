// A-12 slice 7: an owned trait object moves like any other owned value, so
// reading it after it moved is an error.
trait Shape {
    fun Self.area().R: f64
}

datac Circle(val r: f64)
impl Shape for Circle {
    fun Self.area().R: f64 = r * r * 3.0
}

fun make().R: Box<dyn Shape> = Box.of(Circle(r = 1.0))

fun main() {
    val b = make()
    val c = b
    print(b.is_empty())
    print(c.is_empty())
}
