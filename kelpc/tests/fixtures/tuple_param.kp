// MISSING-z2bB9: a tuple is an owned value, so a parameter of the type borrows
// it and `move (A, B)` takes ownership of the argument at the call site
// (`plan/syntax.md` 4 and 10.1). Every position of a borrow binds when it is
// `Copy`; an owned one out of a borrow is refused (`tuple_element_borrow.kp`).
fun sum(p: (i32, i32)) => i32 {
    val (lo, hi) = p
    return lo + hi
}

fun take(p: move (String, i32)) => i32 {
    val (text, n) = p
    print(text)
    return n
}

fun main() {
    print(sum((1, 2)))
    print(take(("moved", 7)))
}
// stdout-begin
// stdout: 3
// stdout: moved
// stdout: 7
