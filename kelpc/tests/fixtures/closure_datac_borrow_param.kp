// BUG-2: a closure whose parameter is a borrow of a module-declared `datac`.
// A closure typedef is emitted before the `datac`s (a `datac` field may hold a
// closure, so the closure type has to exist first) and so is the coercion
// environment beside it. Both named the parameter `const struct_Item*` — the
// `datac`'s typedef name, which is not declared until after them — instead of
// the forward-declared `struct tag_Item` a borrow has to be spelled with
// there, so `cc` rejected the program outright.
datac Item(val n: i64)

fun each(items: &List<Item>, f: closure(&Item)) {
    var i: usize = 0
    while i < items.len() {
        f(items.get(i))
        i += 1
    }
}

fun main() {
    var xs: List<Item> = List.empty()
    xs.push(Item(n = 1))
    each(xs, fun(x: &Item) = print(x.n))
}
