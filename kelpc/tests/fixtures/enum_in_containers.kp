// MK7 §5's enum slice: an `enum` is an ordinary aggregate, so it has to work
// as a container element, not only as a local. The two shapes below are the
// ones whose code paths differ: a `List` element is addressed by `elem_size`
// and marshalled by `elem_class`, and a `Box` element is an allocation of that
// size with the `Box`'s own drop calling the enum's generated one. A `Map` value
// of an enum is refused in a hosted build for now, so it is not in this fixture.
//
// The payload owns a `String`, so every one of these paths also has to run the
// per-`enum` drop that switches on the runtime tag and frees only the live
// variant's payload, the half of the slice a scalar-only enum would never
// reach. `tests/memory_gate.rs` is what proves the frees happen; this fixture
// pins the values.
//
// `Wrap` nests one enum inside another, which is the shape a parser's error
// type has: the outer drop switches on the outer tag and then calls the inner
// enum's own generated drop.
enum Maybe<T> {
    Yes(val value: T)
    No
}

enum Wrap {
    Held(val inner: Maybe<String>)
    Nothing
}

fun tell(m: &Maybe<String>) => int = when m {
    Yes(v) -> v.len()
    No -> 0
}

fun unwrap_or(m: &Maybe<i64>, fallback: i64) => i64 = when m {
    Yes(v) -> v
    No -> fallback
}

fun wrapped_len(w: &Wrap) => int = when w {
    Held(m) -> tell(m = m)
    Nothing -> 0
}

fun make(n: i64) => Maybe<String> = if n > 0 {
    Maybe.Yes(value = String.from_str(s = "held"))
} else {
    Maybe.No
}

fun main() {
    // A `List` whose element owns, built by push and read back through a
    // borrow (`get` is the borrowing form for a non-`Copy` element).
    var xs: List<Maybe<String>> = List.empty()
    xs.push(Maybe.Yes(value = String.from_str(s = "first")))
    xs.push(Maybe.No)
    print(xs.len())
    print(tell(m = xs.get(i = 0)))
    print(tell(m = xs.get(i = 1)))

    // Replacing an element drops the old one, and so does `pop`.
    xs.set(i = 0, v = Maybe.Yes(value = String.from_str(s = "second")))
    print(tell(m = xs.get(i = 0)))
    val taken = xs.pop()
    print(tell(m = taken))
    print(xs.len())

    // A `Box` element, which is the only one of the three whose drop is a
    // generated routine of its own.
    var b = Box.of(Maybe.Yes(value = String.from_str(s = "boxed")))
    print(tell(m = b.get()))
    b.set(v = Maybe.No)
    print(tell(m = b.get()))
    print(tell(m = b.take()))

    // An enum nested inside an enum, by value, each class of payload.
    val w = Wrap.Held(inner = Maybe.Yes(value = String.from_str(s = "nested")))
    print(wrapped_len(w = w))
    print(wrapped_len(w = Wrap.Nothing))
    val w2 = Wrap.Held(inner = Maybe.No)
    print(wrapped_len(w = w2))

    // A returned enum, dropped at the end of the statement that produced it.
    print(tell(m = make(n = 1)))
    print(tell(m = make(n = 0)))

    // A `List` of enums dropped wholesale, after a partial drain.
    var ys: List<Maybe<i64>> = List.empty()
    var i: i64 = 0
    while i < 4 {
        ys.push(Maybe.Yes(value = i * 3))
        i += 1
    }
    ys.push(Maybe.No)
    print(ys.len())
    print(unwrap_or(m = ys.get(i = 3), fallback = -1))
    print(unwrap_or(m = ys.get(i = 4), fallback = -1))
    ys.clear()
    print(ys.len())
}
// stdout-begin
// stdout: 2
// stdout: 5
// stdout: 0
// stdout: 6
// stdout: 0
// stdout: 1
// stdout: 5
// stdout: 0
// stdout: 0
// stdout: 6
// stdout: 0
// stdout: 0
// stdout: 4
// stdout: 0
// stdout: 5
// stdout: 9
// stdout: -1
// stdout: 0
