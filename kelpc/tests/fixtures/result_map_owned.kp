// A-11: `result.map`/`map_err` take the result with `move`, so the side they
// hand back may be owned. `map`'s `Err` arm moves the `datac` error out of the
// result it was given and into the `Err` it returns; `map_err`'s `Ok` arm moves
// the owned success payload the same way. The read of that projection clears
// the slot it came from, so the source's own drop frees nothing twice. The
// `Copy`-only rejection this replaces is `stdlib_combinators_owned_error.kp`.
impl "std/result"

datac Bad(val code: i32)

fun parse(n: i32) => result.Result<i32, Bad> {
    if n > 0 {
        return result.Result.Ok(value = n)
    }
    return result.Result.Err(error = Bad(code = n))
}

fun main() {
    // `map` over an owned success payload: the callback borrows the `String`
    // and the rebuilt `Ok` owns the result.
    val named: result.Result<String, Bad> = result.Result.Ok(value = String.from_str(s = "hello"))
    val len = result.map(r = named, f = fun(s: &String) => int = s.len())
    print(result.expect(r = len, message = "err"))

    // `map` over an owned error type, the case the borrow receiver could not
    // express.
    val failed: result.Result<i32, Bad> = result.map(r = parse(-3), f = fun(n: &i32) => i32 = n * 2)
    print(result.is_err(r = failed))

    // `map_err` over an owned success payload: the `Ok` arm moves the `String`
    // on, and the callback borrows the `Bad`.
    val kept: result.Result<String, Bad> = result.Result.Ok(value = String.from_str(s = "kept"))
    val renamed: result.Result<String, String> = result.map_err(r = kept, f = fun(e: &Bad) => String = String.from_str(s = "unused"))
    print(result.is_ok(r = renamed))

    // `map_err` over an owned error: the callback reads it through a borrow and
    // the rebuilt `Err` owns whatever it returns.
    val bad: result.Result<i32, Bad> = result.Result.Err(error = Bad(code = 7))
    val tagged: result.Result<i32, String> = result.map_err(
        r = bad,
        f = fun(e: &Bad) => String = String.from_str(s = "bad")
    )
    print(result.is_err(r = tagged))
}
// stdout-begin
// stdout: 5
// stdout: true
// stdout: true
// stdout: true
