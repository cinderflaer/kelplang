// A `fun` literal written directly as the `thread.spawn` entry captures the second
// handle to a Mutex<List<String>>. The worker pushes "item-0" to "item-999" under
// the lock; main keeps its own handle and prints the length and the last element
// after join: 1000, then item-999.
impl "std/thread"
impl "std/result"
impl "std/sync"
impl "std/fmt"

/// The text "item-<i>" as one owned String.
fun item_name(i: i64) => String {
    var s = String.from_str("item-")
    val digits = fmt.int(i)
    s.push_str(digits.as_str())
    return s
}

fun main() {
    val items: Mutex<List<String>> = Mutex.new(List.empty())
    val other = items.share()
    val h = thread.spawn(fun(u: move i64) => i64 {
        var i: i64 = 0
        while i < 1000 {
            other.lock { v ->
                v.push(item_name(i))
            }
            i += 1
        }
        return u
    }, 0)
    when thread.join(h) {
        Ok(_) -> {}
        Err(e) -> print(e.message)
    }
    items.lock { v ->
        print(v.len())
        print(v.get(v.len() - 1))
    }
}
