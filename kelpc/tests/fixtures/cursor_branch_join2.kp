// The other half of the branch join: `w` may point into `a`, so mutating `b`
// is refused even though the taken arm's value came from `a`. Both arms' roots
// are pinned, not only the one the condition happened to select.
impl "std/str"

fun main() {
    var a = String.from_str("alpha")
    var b = String.from_str("beta")
    val w = if a.len() > 0 { a.as_str() } else { b.as_str() }
    b = "changed"
    print(w)
}
