// The other half of `codegen_asm.rs::cap_check_refusal`: a gated call that
// names a *resource* still has a check the C backend would emit, so the asm
// backend must refuse it rather than emit it unchecked. This is the fixture
// that pins that direction. Its refusal today is the extern `fs.read` reaches
// (`std.fs.read_raw`: `generate` refuses a live extern with no routine before
// it generates a body, and every gated call with a resource argument reaches a
// syscall extern), so the message it reports is the extern's; the moment a
// syscall extern's body is lowered, this becomes the fixture that reports the
// capability-check message, and it must not join `ASM_BUILT_BASELINE` before
// the check itself is emitted.
//
// `fs.read` of an absolute path is checked against the module's `fs` grant, so
// this also documents that the grant is held by the fixture's own module.
impl "std/fs"

fun main() {
    fs.read("/kelp-no-such-path/caps-probe")
}
