// A local live across an outer loop *and* read/written inside an inner loop
// nested within it (the loop-widening correction the retired backend's stage 1
// recorded): `total` must keep the
// same physical location across every outer iteration, and the inner loop's
// own locals must not be assigned that location while it is still live.
fun grid_sum(rows: i32, cols: i32) => i32 {
    var total: i32 = 0
    var r: i32 = 0
    while r < rows {
        var c: i32 = 0
        while c < cols {
            total = total + r * cols + c
            c = c + 1
        }
        r = r + 1
    }
    return total
}

fun main() {
    print(grid_sum(3, 4))
}
// stdout-begin
// stdout: 66
