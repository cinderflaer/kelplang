// A trait implemented for builtin types that already carry methods (A-12 slice
// 3): the integer scalars and `String`. The impl has to be in the trait's own
// module, and a default may call a method of the same trait.

trait Doubler {
    fun Self.double() => i32
    fun Self.triple() => i32 { return self.double() + self.double() + self.double() }
}

trait Named {
    fun Self.label() => String
}

impl Doubler for i32 {
    fun Self.double() => i32 = self + self
}

impl Named for String {
    fun Self.label() => String = "a string"
}

fun twice<T: Doubler>(x: T) => i32 = x.double() + x.double()
fun label_of<T: Named>(s: &T) => String = s.label()

fun main() {
    val n: i32 = 6
    val five: i32 = 5
    print(twice(five))
    print(n.triple())
    val s = String.from_str("hi")
    print(label_of(s))
}
// stdout-begin
// stdout: 20
// stdout: 36
// stdout: a string
