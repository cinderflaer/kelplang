// MK9-S3-M1 stage C1: the panic gate. One worker panics; its joiner sees `Err`
// carrying the panic text, a second worker's work is intact, and the process
// exits 0. That is MK9 section 2's rule: a panic ends the thread it happened in,
// and the process ends when `main` ends.
impl "std/thread"
impl "std/atomic"
impl "std/result"

pd val counter: AtomicI64 = AtomicI64.new(0)

// The panicking worker: it does its increment first, so the total proves this
// worker's write landed before it died.
fun boom(c: &AtomicI64) => i64 {
    c.fetch_add(value = 1, order = atomic.Ordering.SeqCst)
    panic("worker exploded")
}

// The other worker: forty-one increments and a value, so the join's `Ok` has
// something to carry and the total is neither worker's alone.
fun work(c: &AtomicI64) => i64 {
    c.fetch_add(value = 41, order = atomic.Ordering.SeqCst)
    0
}

fun main() {
    val bad = thread.spawn(boom, &counter)
    val good = thread.spawn(work, &counter)
    when thread.join(bad) {
        Ok(v) -> print(v)
        Err(e) -> print(e.message)
    }
    when thread.join(good) {
        Ok(v) -> print(v)
        Err(e) -> print(e.message)
    }
    print(counter.load(order = atomic.Ordering.SeqCst))
}
// stdout-begin
// stdout: worker exploded
// stdout: 0
// stdout: 42
