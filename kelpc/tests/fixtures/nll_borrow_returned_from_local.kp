// A borrow still returned from the function. The borrowed owner is a local,
// not the first reference parameter the elided lifetime is tied to, so the
// return stays refused: a returned borrow tied to a frame-local owner would
// dangle the moment the frame pops.
impl "std/str"

fun first(xs: &String).return: &str {
    val local = String.from_str("x")
    val p = local.as_str()
    return p
}

fun main() {
    val s = String.from_str("hi")
    print(first(s))
}
