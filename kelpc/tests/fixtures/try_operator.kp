// MK5-S6-M1: the `?` operator. The operand has to be an enum shaped
// `Ok`/`Err` or `Some`/`None`, and the enclosing function has to return an
// enum of the same shape with the same failure payload type. The enum is
// recognized by that shape, not by its name, so this fixture declares its own.
enum Result<T, E> {
    Ok(val value: T)
    Err(val error: E)
}

enum Option<T> {
    Some(val value: T)
    None
}

fun half(n: i64).return: Result<i64, String> {
    if n % 2 != 0 {
        return Result.Err(error = String.from_str(s = "odd"))
    }
    return Result.Ok(value = n / 2)
}

// Two frames, both propagating: the failure crosses `quarter` unchanged.
fun quarter(n: i64).return: Result<i64, String> {
    val h = half(n = n)?
    return Result.Ok(value = h / 2)
}

// `?` on `Option`, and an owned success payload moved through it.
fun maybe_word(n: i64).return: Option<String> {
    if n < 0 {
        return Option.None
    }
    return Option.Some(value = String.from_str(s = "word"))
}

fun loud(n: i64).return: Option<String> {
    val w = maybe_word(n = n)?
    return Option.Some(value = String.from_str(s = w.as_str()))
}

fun res_len(r: &Result<i64, String>).return: i32 {
    if let Ok(v) = r {
        return v.to_i32()
    }
    if let Err(e) = r {
        return 0 - e.len().to_i32()
    }
    return 0
}

fun opt_len(o: &Option<String>).return: i32 {
    if let Some(v) = o {
        return v.len().to_i32()
    }
    return -1
}

// `?` mid-expression: the operand does not have to be a whole statement.
fun plus_half(n: i64).return: Result<i64, String> {
    return Result.Ok(value = 1 + half(n = n)?)
}

fun main() {
    print(res_len(r = quarter(n = 8)))
    print(res_len(r = quarter(n = 6)))
    print(res_len(r = quarter(n = 3)))

    print(opt_len(o = loud(n = 1)))
    print(opt_len(o = loud(n = -1)))

    // `?` in the middle of an expression, not only at the head of a statement.
    print(res_len(r = plus_half(n = 4)))
    print(res_len(r = plus_half(n = 5)))
}
