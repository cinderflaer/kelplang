// A-11: the owner is staged at the root of the field chain, so the String in
// `mkName().name` stays alive for the binding's scope.
datac Named(val name: String)

fun mkName() => Named = Named(name = "x")

fun main() {
    val s = mkName().name.as_str()
    print(s)
}
// stdout-begin
// stdout: x
