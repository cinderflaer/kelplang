// The borrow is still used after the mutation, so it is live at the `push`
// and the mutation is refused. This is the open-item-30 example with the two
// statements swapped.
impl "std/str"

fun main() {
    var names: List<String> = List.empty()
    names.push("alpha")
    val first = names.get(0)
    names.push("beta")
    print(first)
}
