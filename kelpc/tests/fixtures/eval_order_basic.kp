
pd var log = 0

datac P(var a: i32, var b: i32, var c: i32)

fun t(n: i32) => i32 {
    log = log * 10 + n
    n
}

fun three(a: i32, b: i32, c: i32) => i32 { a + b + c }

fun mk(n: i32) => P { P(a = n, b = 0, c = 0) }

fun P.plus(x: i32, y: i32) => i32 { a + x + y }

fun flush(label: str) {
    print("${label}: ${log}")
    log = 0
}

fun main() {
    print("x ${t(1)} ${t(2)} ${t(3)}")
    flush("tmpl")
    print("${three(t(1), t(2), t(3))}")
    flush("call")
    val s = t(1) * 10 + t(2) - t(3)
    flush("binop")
    val p = P(a = t(1), b = t(2), c = t(3))
    flush("ctor")
    val xs = [t(1), t(2), t(3)]
    flush("array")
    var l: List<i32> = List.empty()
    l.push(t(1))
    l.push(t(2))
    flush("push")
    val q = P(a = 0, b = 0, c = 0)
    val ok = t(1) > 5 && t(2) > 0
    flush("and")
    val ok2 = t(1) > 0 || t(2) > 0
    flush("or")
    var arr = [0, 0, 0]
    arr.set(i = t(1).to_usize(), v = t(2))
    flush("set")
    var p2 = P(a = 0, b = 0, c = 0)
    p2.a += t(7)
    flush("compound")
    print("${t(1)}${three(t(2), t(3), t(4))}${t(5)}")
    flush("nested")
    print("${t(1) + t(2) * t(3)} ${t(4)}")
    flush("arith")
    val r = mk(t(1)).plus(t(2), t(3))
    flush("recv")
    print("${mk(t(1)).plus(t(2), t(3))}")
    flush("recv2")
}
