// `?`'s early return is a `return`, so it has to free everything the frame
// still owns on its failure arm, `syntax.md` §10.3's "on every exit path
// including `return`" applies to the desugared one too. `try_drops_frame.kp`
// pins this shape, but its last function wraps the same code in a `fun`
// literal, and the asm backend refuses a function value by name, so that
// fixture cannot measure this backend. This one is the same mechanism without
// the closure: the frame owns a `String`, the `?` sits in an `if` expression,
// in an inner block, in a loop body and on a payload-less `Option`.
//
// A leak prints nothing, so `tests/memory_gate.rs`'s valgrind sweep over this
// binary is what actually proves the frees happen on the failure arm; the
// printed values pin that the *success* arm frees exactly once (nothing here
// double-frees, which the same sweep would catch as an invalid free).
enum Res {
    Ok(val value: i64)
    Err(val why: i64)
}

enum Opt {
    Some(val value: i64)
    None
}

fun ok(n: i64) => Res = Res.Ok(value = n)

fun fail(n: i64) => Res = Res.Err(why = n)

fun some_or(n: i64) => Opt = if n < 0 { Opt.None } else { Opt.Some(value = n) }

// One owned local, live at two `?` sites, one per branch of an `if`.
fun one(good: bool) => Res {
    var scratch = String.from_str(s = "scratch")
    scratch.push_str(s = "!")
    val v = if good { ok(n = 1)? } else { fail(n = 1)? }
    return Res.Ok(value = v + scratch.len().to_i64())
}

// The operand is a named local, several of them live at once.
fun via_local(good: bool) => Res {
    var pad = String.from_str(s = "pad")
    pad.push_str(s = "!")
    val r = if good { ok(n = 2) } else { fail(n = 2) }
    val v = r?
    return Res.Ok(value = v + pad.len().to_i64())
}

// Two live scopes: the `?` sits inside an inner block, and both the inner and
// the outer owned local die on its failure arm, innermost first.
fun nested(good: bool) => Res {
    var outer = String.from_str(s = "outer")
    val v = {
        var inner = String.from_str(s = "inner")
        inner.push_str(s = "!")
        val w = if good { ok(n = 3)? } else { fail(n = 3)? }
        outer.push_str(s = inner.as_str())
        w
    }
    return Res.Ok(value = v + outer.len().to_i64())
}

// `?` on a payload-less failure: the frame's locals are still the frame's.
fun option_frame(n: i64) => Opt {
    var held = String.from_str(s = "held")
    held.push_str(s = "!")
    val w = some_or(n = n)?
    return Opt.Some(value = w + held.len().to_i64())
}

// `?` inside a loop body: the body's own local and the function's are both live
// at the `?`, and the loop-body drop points must not run a second time after
// the early return leaves the function.
fun loop_frame(bad_at: i64) => Res {
    var i: i64 = 0
    var total = String.from_str(s = "t")
    while i < 3 {
        var step = String.from_str(s = "s")
        step.push_str(s = "!")
        if i == bad_at {
            val v = fail(n = 4)?
            return Res.Ok(value = v)
        }
        total.push_str(s = step.as_str())
        i += 1
    }
    return Res.Ok(value = total.len().to_i64())
}

fun res_value(r: &Res) => i64 = when r {
    Ok(v) -> v
    Err(_e) -> -1
}

fun opt_value(o: &Opt) => i64 = when o {
    Some(v) -> v
    None -> -1
}

fun main() {
    print(res_value(r = one(good = true)))
    print(res_value(r = one(good = false)))
    print(res_value(r = via_local(good = true)))
    print(res_value(r = via_local(good = false)))
    print(res_value(r = nested(good = true)))
    print(res_value(r = nested(good = false)))
    print(res_value(r = loop_frame(bad_at = 1)))
    print(res_value(r = loop_frame(bad_at = 9)))
    print(opt_value(o = option_frame(n = 1)))
    print(opt_value(o = option_frame(n = -1)))
}
// stdout-begin
// stdout: 9
// stdout: -1
// stdout: 6
// stdout: -1
// stdout: 14
// stdout: -1
// stdout: -1
// stdout: 7
// stdout: 6
// stdout: -1
