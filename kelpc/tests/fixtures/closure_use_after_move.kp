// A-4 phase E: a closure is not `Copy` (it owns an environment), so handing it
// to a `move closure(...)` parameter moves it, and using it afterwards is a
// use of a moved value.
fun take(f: move closure() => i32) => i32 = f()

fun main() {
    val k: i32 = 1
    val g = fun() => i32 = k
    print(take(g))
    print(g())
}
