datac Circle(var r: f64)

fun Circle.area() => f64 = 3.14159 * r * r

fun main() {
    val c = Circle(r = 2.0)
    print!("100% of {nothing} is 50%")
    print("")
    print("area = ${c.area()}")
    print("r=${c.r} doubled=${c.r * 2.0}")
    print!("no newline here")
    print("!")
}
// stdout-begin
// stdout: 100% of {nothing} is 50%
// stdout: area = 12.566360
// stdout: r=2.000000 doubled=4.000000
// stdout: no newline here!
