// MK7 §5 item 4, third slice: a `datac` whose C layout is 9-16 bytes, two
// `INTEGER` eightbytes, passed/returned in a register pair rather than the
// first two slices' single opaque eightbyte.
datac Pair3(var a: i64, var b: i64)

fun make3(a: i64, b: i64).return: Pair3 {
    return Pair3(a = a, b = b)
}

fun sum3(p: move Pair3).return: i64 {
    return p.a + p.b
}

fun main() {
    var p = make3(3, 4)
    print(p.a)
    print(p.b)
    p.a = 10
    print(p.a + p.b)
    print(sum3(make3(5, 6)))
}
