// Two iterator loops nest with independent cursors, exactly as two index walks
// do.
impl "std/iter"

fun main() {
    for a in iter.range(0, 3) {
        for b in iter.range(0, 3) {
            print!(a * 10 + b)
            print!(" ")
        }
    }
    print("")
}
// stdout-begin
// stdout: 0 1 2 10 11 12 20 21 22 
