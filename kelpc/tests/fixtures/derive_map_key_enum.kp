// lang-derive-eq: `derive(eq, hash)` on an `enum` makes two values equal when
// they are the same variant with equal payloads. The variants cover a unit
// variant, an integer payload and a `String` payload, so the derived `eq`
// has to tell a payload apart from a different variant.
derive(eq, hash)
enum Shape {
    Circle(val r: i32)
    Rect(val w: i32, val tag: String)
    Empty
}

fun main() {
    var m: Map<Shape, i32> = Map.empty()
    m.insert(key = Shape.Circle(r = 2), v = 1)
    m.insert(key = Shape.Rect(w = 2, tag = String.from_str(s = "a")), v = 2)
    m.insert(key = Shape.Empty, v = 3)
    m.insert(key = Shape.Circle(r = 3), v = 4)
    print(m.len())
    print(m.get(key = Shape.Rect(w = 2, tag = String.from_str(s = "a"))))
    print(m.has(key = Shape.Rect(w = 2, tag = String.from_str(s = "b"))))
    print(m.has(key = Shape.Circle(r = 2)))
    m.insert(key = Shape.Circle(r = 2), v = 5)
    print(m.len())
    print(m.get(key = Shape.Circle(r = 2)))
    print(m.remove(key = Shape.Empty))
    print(m.len())
}
