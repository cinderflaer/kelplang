// A `datac`/`enum` takes a derived order and a derived copy from its fields, so
// `sort`/`clone` are offered exactly when every field has one. A `List` field
// has neither, so this element is refused and the diagnostic names the reason
// rather than failing in codegen.
datac Bucket(val a: i32, val items: List<i32>)

fun main() {
    var items: List<i32> = List.empty()
    var bs: List<Bucket> = List.empty()
    bs.push(Bucket(a = 1, items = items))
    bs.sort()
}
