// `List.with_capacity(n)` sizes the buffer once; the list is otherwise an
// ordinary empty list and grows past the hint like any other.
fun main() {
    var xs: List<i64> = List.with_capacity(8)
    print(xs.len())
    var i: i64 = 0
    while i < 100 {
        xs.push(i * 2)
        i = i + 1
    }
    print(xs.len())
    print(xs.get(0))
    print(xs.get(99))

    var none: List<i64> = List.with_capacity(0)
    print(none.is_empty())
    none.push(7)
    print(none.get(0))

    var names: List<String> = List.with_capacity(3)
    names.push("a")
    names.push("b")
    print(names.len())
    print(names.get(1).as_str())
}
// stdout-begin
// stdout: 0
// stdout: 100
// stdout: 0
// stdout: 198
// stdout: true
// stdout: 7
// stdout: 2
// stdout: b
