// A-12: a key pair is declared on the type itself, because the map calls the
// two methods directly rather than instantiating a template, and the receiver
// is what names the type.
datac Pair<A, B>(val first: A, val second: B)

fun Pair<A, B>.hash() => u64 = 0

fun Pair<A, B>.eq(other: &Pair<A, B>) => bool = true

fun main() {
    var m: Map<Pair<i32, i32>, i32> = Map.new()
    m.insert(key = Pair<i32, i32>(first = 1, second = 2), v = 1)
}
