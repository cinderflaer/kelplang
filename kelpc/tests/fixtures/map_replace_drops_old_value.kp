// Inserting a key the map already holds replaces the value in place: the old
// value is dropped and the new one takes its slot. For a `String` value that
// drop is the whole point, and it is a check no stdout comparison can make,
// the value printed after a replace is the new one whether or not the old
// buffer was ever freed. The check is valgrind (`kelpc/tests/memory_gate.rs`
// sweeps every fixture): a replacement that leaked the old value is a leak,
// and one that freed the new value instead is a use-after-free on the next
// read. This fixture still prints, so a run is observable: the count at every
// step and every replaced value.
//
// One key is replaced twice (two values dropped for one entry) and another is
// removed and re-added, so the entry's key is dropped and re-stored exactly
// once as well.
impl "std/str"

fun main() {
    var m: Map<String> = Map.empty()
    m.insert("alpha", "one")
    m.insert("beta", "two")
    print(m.len())

    m.insert("alpha", "ONE")
    print(m.len())
    {
        val v = m.get("alpha")
        print(v)
    }

    m.insert("alpha", "1")
    print(m.len())
    {
        val v = m.get("alpha")
        print(v)
    }

    m.insert("beta", "TWO")
    {
        val v = m.get("beta")
        print(v)
    }
    print(m.len())

    val removed = m.remove("beta")
    print(removed)
    m.insert("beta", "two again")
    {
        val v = m.get("beta")
        print(v)
    }
    print(m.len())

    val vs = m.values()
    print(vs.len())
    print(vs.get(0).as_str())
    print(vs.get(1).as_str())
}
// stdout-begin
// stdout: 2
// stdout: 2
// stdout: ONE
// stdout: 2
// stdout: 1
// stdout: TWO
// stdout: 2
// stdout: TWO
// stdout: two again
// stdout: 2
// stdout: 2
// stdout: 1
// stdout: two again
