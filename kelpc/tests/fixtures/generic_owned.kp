// A-2: a generic type whose instantiation owns heap memory. Dropping the
// value frees only what is live, the payload's buffer and the list's elements,
// through the same `needs_drop` machinery a non-generic `datac` uses, because an
// instantiation *is* an ordinary declaration with a name like `Option<String>`.
// An enum held in a `datac` or as a `Map` value is refused in a hosted build for
// now, so those two shapes are not in this fixture.
enum Option<T> {
    Some(val value: T)
    None
}

fun text_len(o: &Option<String>) => int = when o {
    Some(v) -> v.len()
    None -> 0
}

fun main() {
    // An owned payload inside an instance.
    val a: Option<String> = Option.Some(value = String.from_str(s = "owned"))
    val b: Option<String> = Option.None
    print(text_len(o = a))
    print(text_len(o = b))

    // Instances as list elements.
    var xs: List<Option<i64>> = List.empty()
    xs.push(Option.Some(value = 11))
    xs.push(Option.None)
    print(xs.len())
}
// stdout-begin
// stdout: 5
// stdout: 0
// stdout: 2
