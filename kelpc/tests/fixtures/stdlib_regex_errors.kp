// std/regex refusals: every bad pattern is an Err carrying the message and the
// byte offset, never a panic and never a match.
impl "std/regex"
impl "std/option"
impl "std/result"
impl "std/str"

datac Stats(var run: i32, var bad: i32)

fun err_of(pat: &str) => String {
    val r = regex.compile(pat)
    var out = String.empty()
    if let Err(e) = r {
        out.push_str(e.message.as_str())
        out.push_str(" @")
        val n = str.from_u64(e.offset.to_u64())
        out.push_str(n.as_str())
    }
    if let Ok(re) = r {
        out.push_str("compiled")
    }
    return out
}

fun e(st: mut Stats, pat: &str, expect: &str) {
    val got = err_of(pat)
    st.run += 1
    if !str.eq(got.as_str(), expect) {
        st.bad += 1
        print("FAIL")
        print(str.len(pat))
        print(expect)
        print(got)
    }
}

fun main() {
    var st = Stats(run = 0, bad = 0)
    e(st, "(ab", "unclosed group @0")
    e(st, "a(b(c)", "unclosed group @1")
    e(st, "(?i", "unclosed group @0")
    e(st, "ab)", "unmatched ')' @2")
    e(st, "a\\qb", "invalid escape '\\q' @1")
    e(st, "\\", "trailing backslash @0")
    e(st, "[a\\qb]", "invalid escape '\\q' @2")
    e(st, "\\xZ1", "invalid \\x escape: two hexadecimal digits are required @0")
    e(st, "\\x4", "invalid \\x escape: two hexadecimal digits are required @0")
    e(st, "(?=a)", "lookaround is not supported @0")
    e(st, "(?!a)", "lookaround is not supported @0")
    e(st, "(?<=a)b", "lookaround is not supported @0")
    e(st, "(?<!a)b", "lookaround is not supported @0")
    e(st, "x(?<name>a)", "named groups are not supported @1")
    e(st, "(?P<name>a)", "named groups are not supported @0")
    e(st, "(a)\\1", "backreferences are not supported @3")
    e(st, "\\9", "backreferences are not supported @0")
    e(st, "[abc", "unclosed character class @0")
    e(st, "a[", "unclosed character class @1")
    e(st, "[z-a]", "invalid character class range @0")
    e(st, "[a-\\d]", "invalid character class range @0")
    e(st, "*a", "nothing to repeat @0")
    e(st, "a|*", "nothing to repeat @2")
    e(st, "(+)", "nothing to repeat @1")
    e(st, "{2}", "nothing to repeat @0")
    e(st, "a**", "nested repetition operator @2")
    e(st, "a+?+", "nested repetition operator @3")
    e(st, "a{2}{3}", "nested repetition operator @4")
    e(st, "a{", "invalid repeat: expected {n}, {n,} or {n,m} @1")
    e(st, "a{x}", "invalid repeat: expected {n}, {n,} or {n,m} @1")
    e(st, "a{,3}", "invalid repeat: expected {n}, {n,} or {n,m} @1")
    e(st, "a{2", "invalid repeat: expected {n}, {n,} or {n,m} @1")
    e(st, "a{3,2}", "invalid repeat: the lower bound is greater than the upper bound @1")
    e(st, "a{1001}", "repeat count is too large (limit 1000) @1")
    e(st, "a{1,1001}", "repeat count is too large (limit 1000) @1")
    e(st, "a{1000}", "compiled")
    e(st, "(?x)a", "unknown group flag 'x' @2")
    e(st, "(?-i)a", "unknown group flag '-' @2")
    e(st, "(?#c)", "unknown group flag '#' @2")
    e(st, "(a{1000}){1000}", "pattern is too large (the compiled program is limited to 50000 instructions) @0")

    // 4096 bytes is allowed, 4097 is not.
    var ok = String.empty()
    var i: usize = 0
    while i < 4096 {
        ok.push('a')
        i += 1
    }
    e(st, ok.as_str(), "compiled")
    ok.push('a')
    e(st, ok.as_str(), "pattern is too long (limit 4096 bytes) @4096")

    // Nesting: 100 groups is allowed, 101 is not.
    var deep = String.empty()
    i = 0
    while i < 100 {
        deep.push('(')
        i += 1
    }
    deep.push('a')
    i = 0
    while i < 100 {
        deep.push(')')
        i += 1
    }
    e(st, deep.as_str(), "compiled")
    var deeper = String.empty()
    deeper.push('(')
    deeper.push_str(deep.as_str())
    deeper.push(')')
    e(st, deeper.as_str(), "nesting is too deep (limit 100) @100")
    var ncdeep = String.empty()
    i = 0
    while i < 101 {
        ncdeep.push_str("(?:")
        i += 1
    }
    e(st, ncdeep.as_str(), "nesting is too deep (limit 100) @300")
    print("cases: ${st.run}, failed: ${st.bad}")
}
