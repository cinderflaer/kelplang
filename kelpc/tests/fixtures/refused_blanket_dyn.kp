trait Describe {
    fun Self.describe() => i32
}

impl Describe for i32 {
    fun Self.describe() => i32 = self
}

trait Tagged {
    fun Self.tag() => i32
}

impl<T: Describe> Tagged for T {
    fun Self.tag() => i32 {
        return self.describe() * 100
    }
}

fun main() {
    val n: i32 = 2
    val d: &dyn Tagged = &n
    print(d.tag())
}
