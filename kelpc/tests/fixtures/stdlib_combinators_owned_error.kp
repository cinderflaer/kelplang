// A-4 phase D limit: `result.map` rebuilds `Err` from the borrow it was handed,
// so its error type has to be `Copy` — and a `datac` never is. Moving one
// payload out of an owned enum is the partial-move rule v1 does not have yet,
// and the message says so by pointing at the module and its header comment.
impl "std/result"

datac Bad(val code: i32)

fun parse(n: i32).R: result.Result<i32, Bad> {
    if n > 0 {
        return result.Result.Ok(value = n)
    }
    return result.Result.Err(error = Bad(code = n))
}

fun main() {
    val ok = result.map(r = parse(21), f = fun(n: &i32).R: i32 = n * 2)
    print(result.expect(r = ok, message = "err"))
}
