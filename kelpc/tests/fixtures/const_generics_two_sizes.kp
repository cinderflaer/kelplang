// A-20: two instantiations of one const-generic ring buffer in one program.
// `Ring<4>` and `Ring<8>` are separate types with separate function copies, so
// the generated image holds two of everything (each `kelp_Ring__...__l__N__g__`
// symbol is emitted twice, once per length) and the two buffers keep their own
// state while the loop writes to both.
datac Ring<const N: usize>(var slot: [i32; N], var head: int, var count: int)

fun mut Ring<const N: usize>.push(v: i32) {
    slot.set(i = head, v = v)
    head = (head + 1) % N.to_int()
    if count < N.to_int() {
        count = count + 1
    }
}

fun Ring<const N: usize>.total() => i32 {
    var sum: i32 = 0
    var i: int = 0
    while i < N.to_int() {
        sum = sum + slot.get(i = i)
        i = i + 1
    }
    return sum
}

fun Ring<const N: usize>.rings() => int = N.to_int()

fun main() {
    var small = Ring<4>(slot = [0; 4], head = 0, count = 0)
    var big = Ring<8>(slot = [0; 8], head = 0, count = 0)
    var i: i32 = 0
    while i < 10 {
        small.push(v = i)
        big.push(v = i)
        i = i + 1
    }
    print(small.count)
    print(big.count)
    print(small.total())
    print(big.total())
    print(small.rings())
    print(big.rings())
}
// stdout-begin
// stdout: 4
// stdout: 8
// stdout: 30
// stdout: 44
// stdout: 4
// stdout: 8
