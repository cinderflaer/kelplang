// MISSING-hW5rB: `path.absolute` resolves a relative path against a base, and
// `fs.cwd` supplies the base a command-line file tool actually has. The
// resolved path is normalized, so it is what the capability check accepts.
impl "std/path"
impl "std/str"
impl "std/fs"

fun main() {
    print(path.absolute("/a/b", "c.txt"))
    print(path.absolute("/a/b", "../c.txt"))
    print(path.absolute("/a/b", "/abs/./x"))

    val here = fs.cwd()
    print(path.isAbsolute(here))
    val joined = path.absolute(here, "notes.txt")
    print(str.endsWith(joined, "/notes.txt"))
}
// stdout-begin
// stdout: /a/b/c.txt
// stdout: /a/c.txt
// stdout: /abs/x
// stdout: true
// stdout: true
