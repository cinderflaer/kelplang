// M6.3: `&str` return elision. `trim_start`, `substring` and `file_name` are
// views of their argument (no allocation); `trim` and `trim_end` truncate,
// which a `&str` cannot express, so they return an owned `String`.
//
// A `String` is not a `str`: passing one where a view is expected needs an
// explicit `.as_str()` (there is no deref coercion in v1), which is why the
// calls below go through it.
impl "std/str"
impl "std/option"

fun main() {
    val s = String.from_str("  hello  ")
    val v = s.as_str()
    val t = str.trim(v)
    print(t)
    print(str.len(t))

    val lead = str.trimStart(v)
    print(lead)
    print(str.len(lead))

    val tail = str.substring(t, 1)
    print(tail)
    print(str.startsWith(t, prefix = "hello"))
    print(str.endsWith(t, suffix = "lo"))
    print(str.contains(t, needle = "ell"))
    print(str.eq(t, b = "hello"))
    print(str.eq(t, b = "hellO"))
    val m = str.indexOf(t, needle = "l")
    if let Some(at) = m {
        print(at)
    }
    print(option.isNone(o = str.indexOf(t, needle = "z")))

    val b = Bytes.from_str("raw")
    print(b)
    print(str.charCount("héllo"))
    print(str.trim("  own  "))
}
// stdout-begin
// stdout: hello
// stdout: 5
// stdout: hello  
// stdout: 7
// stdout: ello
// stdout: true
// stdout: true
// stdout: true
// stdout: true
// stdout: false
// stdout: 2
// stdout: true
// stdout: raw
// stdout: 5
// stdout: own
