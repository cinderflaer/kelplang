// MISSING-p7Kdm: a TLS handshake that fails is `HttpErr.Dial`, because nothing
// was sent. argv[1] is the harness's TLS server, and the harness does NOT hand
// the client the server's self-signed certificate (`SSL_CERT_FILE` is left
// alone), so the certificate check refuses it. The panicking `http.get` would
// have died here; the fallible form reports it and the program goes on.
impl "std/http" caps(net = ["127.0.0.1:*"])
impl "std/process"
impl "std/str"
impl "std/result"

fun main() {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "argv[1] is not a port number",
    )
    val port_text = str.from_u64(p)
    val url = str.concat("https://127.0.0.1:", port_text.as_str())
    when http.try_get(url) {
        Ok(r) -> print("unexpected ok ${r.status}")
        Err(e) -> {
            when e {
                Dial(reason) -> print("dial ${str.contains(reason, "not trusted by the system store")}")
                Exchange(reason) -> print("unexpected exchange ${reason}")
                Redirects(reason) -> print("unexpected redirects")
            }
        }
    }
    print("survived")
}
