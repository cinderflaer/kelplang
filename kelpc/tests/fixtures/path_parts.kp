// M6.3: the `path` component functions. `file_name`/`extension` are views of
// their argument; `parent` truncates, so it allocates a `String`.
impl "std/path"

fun main() {
    val f = "/tmp/notes.txt"
    print(path.fileName(f))
    print(path.extension(f))
    val d = path.parent(f)
    print(d)
    print(path.fileName("bare.txt"))
    print(path.extension("bare.txt"))
    print(path.parent("bare.txt"))
    val j = path.join(a = "/var", b = "log")
    print(j)
    print(path.isAbsolute(f))
}
// stdout-begin
// stdout: notes.txt
// stdout: txt
// stdout: /tmp
// stdout: bare.txt
// stdout: txt
// stdout:
// stdout: /var/log
// stdout: true
