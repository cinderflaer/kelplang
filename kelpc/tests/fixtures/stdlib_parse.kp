// MK5-S6-M1: the parsers return `Result<T, str.ParseErr>` now. The whole
// string has to be one number, and the *reason* a failure failed is a variant,
// so `if let Err(e)` can tell an empty string from a malformed one.
impl "std/str"
impl "std/result"

// The reason, as a number, so the fixture can print it.
fun why(s: &str) => i32 {
    val r = str.parse_i64(s)
    if let Err(e) = r {
        if let Empty = e {
            return 1
        }
        if let Invalid = e {
            return 2
        }
    }
    return 0
}

fun main() {
    val a = str.parse_i64("123")
    print(result.is_ok(r = a))
    print(result.unwrap(r = a))
    val m = str.parse_i64("-9223372036854775808")
    print(result.is_ok(r = m))
    print(result.unwrap(r = m))
    print(result.is_err(r = str.parse_i64("9223372036854775808")))
    print(result.is_err(r = str.parse_i64("12x")))
    print(result.is_err(r = str.parse_i64("")))
    print(result.is_err(r = str.parse_i64(" 12")))
    print(why(s = ""))
    print(why(s = "12x"))
    print(why(s = "5"))

    val u = str.parse_u64("18446744073709551615")
    print(result.is_ok(r = u))
    print(str.from_u64(result.unwrap(r = u)))
    print(result.is_err(r = str.parse_u64("-1")))
    print(result.is_err(r = str.parse_u64("18446744073709551616")))

    val f = str.parse_f64("2.5e2")
    print(result.is_ok(r = f))
    print(result.unwrap(r = f))
    print(result.is_err(r = str.parse_f64("2.5x")))

    // Codepoint-level text: `char_at` is a character index, `byte_index` maps
    // it back, and a multi-byte character reports its codepoint (é = 233).
    print(str.char_at("héllo", 0))
    print(str.char_at("héllo", 1))
    print(str.byte_index("héllo", 2))
    print(str.char_at("abc", 9))
    print(str.char_count("héllo"))
}
// stdout-begin
// stdout: true
// stdout: 123
// stdout: true
// stdout: -9223372036854775808
// stdout: true
// stdout: true
// stdout: true
// stdout: true
// stdout: 1
// stdout: 2
// stdout: 0
// stdout: true
// stdout: 18446744073709551615
// stdout: true
// stdout: true
// stdout: true
// stdout: 250.000000
// stdout: true
// stdout: 104
// stdout: 233
// stdout: 3
// stdout: 0
// stdout: 5
