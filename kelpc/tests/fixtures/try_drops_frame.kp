// `?`'s early return is a `return`, so it has to free everything the frame
// still owns on its failure arm — `syntax.md` §10.3's "on every exit path
// including `return`" applies to the desugared one too. This fixture is the
// shape a recursive-descent parser hits everywhere: a frame that owns a
// partially built value and recurses with `?`. Before the fix every failure
// leaked the whole frame, and `heap_fixtures_are_double_free_and_leak_clean`
// in the end-to-end suite (AddressSanitizer) is what pins it — a leak prints
// nothing, so only the sanitizer can see it.
enum Res<T, E> {
    Ok(val value: T)
    Err(val error: E)
}

enum Opt<T> {
    Some(val value: T)
    None
}

fun ok(n: i64).return: Res<i64, String> {
    return Res.Ok(value = n)
}

fun fail(n: i64).return: Res<i64, String> {
    return Res.Err(error = String.from_str(s = "no"))
}

fun some_word(n: i64).return: Opt<String> {
    if n < 0 {
        return Opt.None
    }
    return Opt.Some(value = String.from_str(s = "word"))
}

// One owned local live at two `?` sites, one per branch of an `if` — so both
// the success and the failure path are exercised with the same frame.
fun one(good: bool).return: Res<i64, String> {
    var scratch = String.from_str(s = "scratch")
    scratch.push_str(s = "!")
    val v = if good { ok(n = 1)? } else { fail(n = 1)? }
    return Res.Ok(value = v + scratch.len().to_i64())
}

// The operand is a named local: its payload is moved onto the return path, so
// the frame's drop must not free what that payload now owns a second time.
fun via_local(good: bool).return: Res<i64, String> {
    var pad = String.from_str(s = "pad")
    pad.push_str(s = "!")
    val r = if good { ok(n = 2) } else { fail(n = 2) }
    val v = r?
    return Res.Ok(value = v + pad.len().to_i64())
}

// Two live scopes: the `?` sits inside the inner block, and both the inner and
// the outer local die on its failure arm, innermost first.
fun nested(good: bool).return: Res<i64, String> {
    var outer = String.from_str(s = "outer")
    val v = {
        var inner = String.from_str(s = "inner")
        inner.push_str(s = "!")
        val w = if good { ok(n = 3)? } else { fail(n = 3)? }
        outer.push_str(s = inner.as_str())
        w
    }
    return Res.Ok(value = v + outer.len().to_i64())
}

// `?` on `Option`: the failure carries no payload, but the frame's locals are
// still the frame's to free.
fun option_frame(n: i64).return: Opt<String> {
    var held = String.from_str(s = "held")
    held.push_str(s = "!")
    val w = some_word(n = n)?
    return Opt.Some(value = String.from_str(s = w.as_str()))
}

// `?` inside a loop body: the body's own local and the function's are both
// live at the `?`, and the loop-body drop points must not run a second time
// after the early return leaves the function.
fun loop_frame(bad_at: i64).return: Res<i64, String> {
    var i: i64 = 0
    var total = String.from_str(s = "t")
    while i < 3 {
        var step = String.from_str(s = "s")
        step.push_str(s = "!")
        if i == bad_at {
            val v = fail(n = 4)?
            return Res.Ok(value = v)
        }
        total.push_str(s = step.as_str())
        i += 1
    }
    return Res.Ok(value = total.len().to_i64())
}

// The same rule inside a `fun` literal's body: the early return leaves *that*
// generated function, so the drop plan is keyed by the closure's own key and
// `scratch` is freed on the failure arm.
fun closure_frame(good: bool).return: Res<i64, String> {
    val f = fun(flag: bool).return: Res<i64, String> {
        var scratch = String.from_str(s = "s")
        scratch.push_str(s = "!")
        val v = if flag { ok(n = 7)? } else { fail(n = 7)? }
        return Res.Ok(value = v + scratch.len().to_i64())
    }
    return f(good)
}

fun res_len(r: &Res<i64, String>).return: i32 {
    if let Ok(v) = r {
        return v.to_i32()
    }
    if let Err(e) = r {
        return 0 - e.len().to_i32()
    }
    return 0
}

fun opt_len(o: &Opt<String>).return: i32 {
    if let Some(v) = o {
        return v.len().to_i32()
    }
    return -1
}

fun main() {
    print(res_len(r = one(good = true)))
    print(res_len(r = one(good = false)))
    print(res_len(r = via_local(good = true)))
    print(res_len(r = via_local(good = false)))
    print(res_len(r = nested(good = true)))
    print(res_len(r = nested(good = false)))
    print(opt_len(o = option_frame(n = 1)))
    print(opt_len(o = option_frame(n = -1)))
    print(res_len(r = loop_frame(bad_at = 1)))
    print(res_len(r = loop_frame(bad_at = 9)))
    print(res_len(r = closure_frame(good = true)))
    print(res_len(r = closure_frame(good = false)))
}
