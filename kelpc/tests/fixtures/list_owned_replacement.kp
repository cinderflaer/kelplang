// The paths that *replace* an owned element rather than move one in or out:
// `List.of` with an owned element is the one-element constructor, and `set`
// frees the element it overwrites before it stores the new owner. Nothing
// else pins `set` on an element that owns memory — `list_owned.kp` sets only
// a two-`i32` `Pair`, whose drop is empty — so a `set` that stored the new
// `String` without dropping the old buffer leaks, and one that dropped the
// new one double-frees. The empty `String` at the end is the other end of the
// same path: a one-NUL buffer replacing a longer one.
fun main() {
    var words: List<String> = List.of(String.from_str("solo"))
    print(words.len())
    print(words.get(0))
    words.set(0, String.from_str("replacement"))
    print(words.get(0))
    words.push(String.from_str("tail"))
    words.set(1, String.from_str("other"))
    print(words.get(0))
    print(words.get(1))
    // Twice in a row on one index: each `set` owns the buffer the next one
    // frees.
    words.set(0, String.from_str("a"))
    words.set(0, String.from_str("b"))
    print(words.get(0))
    print(words.len())
    words.set(0, String.empty())
    print(words.get(0).len())
    print(words.len())
    words.clear()
    print(words.len())
}
