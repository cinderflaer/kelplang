// A block inside a block cannot capture the outer block's exclusive capture.
datac State(var count: i32)

fun each(f: scoped fun(i32)) {
    f(1)
}

fun main() {
    var s = State(count = 0)
    each { a ->
        s.count += a
        each { b ->
            s.count += b
        }
    }
    print(s.count)
}
