// The float half of a scalar borrow: `*p` and `*p = v` for an `f64` pointee,
// through a `mut f64` parameter and through an explicit `&mut` binding.
//
// The pointer is one integer register either way — only the load and the store
// change register file, `movsd` against the integer `mov` — which is why a
// `mut f64` parameter needed `int_regs_for`/`value_kind` to accept a reference
// to a float, and `ExprKind::Deref`/`Assign` to know the float mnemonics. A
// wrong register file here prints a plausible wrong number rather than failing
// to build, so it is in the differential gate as well.
fun scale(p: mut f64, by: f64) {
    *p = *p * by
}

fun main() {
    var x: f64 = 1.5
    scale(x, 2.0)
    print(x)

    val p = &mut x
    *p = *p + 0.25
    print(*p)
    print(x)
}
