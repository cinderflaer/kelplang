// Release goal 1, hardening (case b): partial reads and partial writes. The
// client builds a 1 MiB buffer and hands it to `write_all` in one call, while
// the server drains it one byte at a time; the server then answers with its own
// body one byte at a time and the client fills a buffer of that size through
// `read_into`. Both sides hash what they saw, so a short `SSL_write` or a read
// that lost a byte between records is a wrong SHA-1 on one side or the other.
// `argv[2]` is the reply's size in bytes.
impl "std/encoding"
impl "std/mem"
impl "std/net"
impl "std/process"
impl "std/result"
impl "std/str"
impl "std/tls"

// The payload the client sends, byte `i` of it, matching the harness's own copy.
fun payload_byte(i: usize).R: u8 = ((i * 31 + 7) % 256).to_u8()

fun payload(n: usize).R: Bytes {
    var b = mem.alloc(n)
    var i: usize = 0
    while i < n {
        b.set(i, payload_byte(i))
        i = i + 1
    }
    return b
}

fun err_name(e: move tls.TlsError).R: String = when e {
    Untrusted -> String.from_str("untrusted")
    Expired -> String.from_str("expired")
    HostMismatch -> String.from_str("host_mismatch")
    ProtocolTooOld -> String.from_str("protocol_too_old")
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> String.from_str("peer_closed_uncleanly")
    Timeout -> String.from_str("timeout")
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun fail(e: move tls.TlsError).R: tls.TlsStream {
    val text = err_name(e)
    panic(text.as_str())
}

fun fail_unit(e: move tls.TlsError) {
    val text = err_name(e)
    panic(text.as_str())
}

fun arg_port().R: u16 {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "tls_partial: argv[1] is not a port number",
    )
    return p.to_u16()
}

fun arg_reply_len().R: usize {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(2).as_str()),
        message = "tls_partial: argv[2] is not the reply length",
    )
    return p.to_usize()
}

fun main() {
    val reply_len = arg_reply_len()
    var s = net.connect("127.0.0.1", arg_port())
    s.set_timeout(30000)
    val hs = tls.try_handshake(s, "127.0.0.1")
    val t = when hs {
        Ok(v) -> v
        Err(e) -> fail(e)
    }
    val body = payload(1048576)
    val sent = tls.try_write_all(t, body)
    when sent {
        Ok(n) -> print(n)
        Err(e) -> fail_unit(e)
    }
    // Fill the whole reply through `read_into`, whose room is what the caller
    // sized: with the server writing one byte at a time this is many partial
    // reads, and `got` reaching the full length is the proof none was lost.
    var buf = mem.alloc(reply_len)
    var got: usize = 0
    var going = true
    while going {
        val r = tls.try_read_into(t, buf, got)
        when r {
            Ok(n) -> {
                if n == 0 {
                    going = false
                } else {
                    got = got + n
                }
            }
            Err(e) -> fail_unit(e)
        }
    }
    print(got)
    print(encoding.hex_encode(encoding.sha1(buf)))
    // Ending the session is what frees the `SSL*` the handshake allocated.
    val sd = tls.try_shutdown(t)
    net.close(s)
}
