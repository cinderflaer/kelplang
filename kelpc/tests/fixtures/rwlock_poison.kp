// A worker panics while it holds the write lock. The panic ends the worker with
// `pthread_exit`, the runtime's cleanup handler releases the write and marks the
// rwlock POISONED, and the main thread's next `write` panics with
// "rwlock poisoned" (a panic is not unwinding, so the worker's frame is
// abandoned, `plan/mk9-memory-model.md` section 2).
impl "std/thread"
impl "std/result"

pd val rw: RwLock<i64> = RwLock.new(0)

fun boom(r: &RwLock<i64>).R: i64 {
    r.write { v ->
        *v = 99
        panic("writer exploded")
    }
}

fun main() {
    val t = thread.spawn(boom, &rw)
    when thread.join(t) {
        Ok(_) -> print("joined")
        Err(e) -> print(e.message)
    }
    rw.write { v -> *v = 1 }
}
