pd val app_name = "shapes"
pd var hit_count = 0

fun label() => &str = app_name

fun banner() {
    print("[$app_name] hits = $hit_count")
}

fun unrelated(n: i32) => i32 = n * 2

fun main() {
    print(app_name)
    print(label())
    banner()
    print(unrelated(21))
}
// stdout-begin
// stdout: shapes
// stdout: shapes
// stdout: [shapes] hits = 0
// stdout: 42
