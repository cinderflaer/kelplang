fun main() {
    var m: Map<String, i32> = Map.new()
    m.insert("a", 1)
    m.insert("bb", 2)
    var total: i32 = 0
    for (k, v) in m {
        total += v
        print(k.len())
    }
    print(total)
    for (_, v) in m {
        print(v * 10)
    }
    var n: Map<i32, String> = Map.new()
    n.insert(7, String.from_str(s = "seven"))
    for (key, name) in n {
        print(key)
        print(name.len())
    }
}
