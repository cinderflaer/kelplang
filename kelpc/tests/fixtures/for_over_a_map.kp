fun main() {
    var m: Map<String, i32> = Map.empty()
    m.insert("a", 1)
    m.insert("bb", 2)
    var total: i32 = 0
    for (k, v) in m {
        total += v
        print(k.len())
    }
    print(total)
    for (_, v) in m {
        print(v * 10)
    }
    var n: Map<i32, String> = Map.empty()
    n.insert(7, "seven")
    for (key, name) in n {
        print(key)
        print(name.len())
    }
}
// stdout-begin
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 10
// stdout: 20
// stdout: 7
// stdout: 5
