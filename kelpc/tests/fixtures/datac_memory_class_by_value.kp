// MK7 §5 item 4, fourth slice: a `datac` whose C layout is over sixteen bytes
//, SysV `MEMORY` class, passed and received *by value*.
//
// The third slice returned one of these through the hidden-pointer convention
// and deliberately refused it as a parameter or argument, because a by-value
// `MEMORY`-class value needs somewhere addressable to live until the call
// executes. SysV's answer is the caller's outgoing argument area, and that is
// what this fixture exercises: the value goes on the stack, in memory, in
// declaration order, while the register arguments around it are numbered as if
// it were not there at all.
datac Quad(var a: i64, var b: i64, var c: i64)

fun make(a: i64, b: i64, c: i64).return: Quad = Quad(a = a, b = b, c = c)

fun sum(v: move Quad).return: i64 = v.a + v.b + v.c

// A `MEMORY`-class argument between two register arguments: the register
// numbering must not shift because of it (`n` in the first register, `m` in the
// second, the `Quad` on the stack).
fun between(n: i64, v: move Quad, m: i64).return: i64 = n + v.a + v.b + v.c + m

// Two of them in one call: each at its own offset, in argument order.
fun two(first: move Quad, second: move Quad).return: i64 = first.a * 100 + first.b * 10 + first.c + second.a * 100 + second.b * 10 + second.c

// A `MEMORY`-class argument after all six integer registers are already taken.
fun six(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, v: move Quad).return: i64 = a + b + c + d + e + f + v.a + v.b + v.c

// A `MEMORY`-class argument *and* a `MEMORY`-class return: the hidden return
// pointer takes `rdi`, and the argument still goes on the stack.
fun grow(v: move Quad, by: i64).return: Quad = Quad(a = v.a + by, b = v.b + by, c = v.c + by)

// A moved parameter is an ordinary owned local, so it can be copied into a
// mutable one, which is only a copy if the parameter really is the value
// rather than a pointer to the caller's copy.
fun bump(v: move Quad).return: i64 {
    var w = v
    w.c = w.c + 100
    return w.a + w.b + w.c
}

// A nine-to-sixteen-byte `datac` is two `INTEGER` eightbytes in a register pair,
// not a `MEMORY`-class one, so a call can put one in two integer registers
// while a `Quad` goes on the stack. The two mechanisms share a call and nothing
// else.
datac Pair3(var a: i64, var b: i64)

fun pair_and_quad(t: move Pair3, q: move Quad).return: i64 = t.a * 1000 + t.b * 100 + q.a * 10 + q.b

// ...and the same with a float argument, whose register file SysV numbers
// independently of the integer one (`x` in `xmm0`, `n` in `rdi`, the `Quad` on
// the stack).
fun float_and_quad(x: f64, n: i64, q: move Quad).return: i64 = n + q.a + q.b + q.c

fun main() {
    val q = make(1, 2, 3)
    print(sum(q))
    print(sum(make(4, 5, 6)))
    print(sum(Quad(a = 7, b = 8, c = 9)))
    print(between(10, Quad(a = 20, b = 30, c = 40), 50))
    print(two(make(1, 2, 3), Quad(a = 4, b = 5, c = 6)))
    print(six(1, 2, 3, 4, 5, 6, make(7, 8, 9)))
    val g = grow(make(1, 1, 1), 10)
    print(g.a)
    print(g.b)
    print(g.c)
    print(bump(make(1, 2, 3)))
    print(pair_and_quad(Pair3(a = 1, b = 2), Quad(a = 3, b = 4, c = 5)))
    print(float_and_quad(1.5, 7, Quad(a = 1, b = 2, c = 3)))
}
