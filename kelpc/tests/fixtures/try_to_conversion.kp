// MISSING-RbhdW: `try_to_<T>`, the fallible twin of `to_<T>`. A conversion that
// can lose a value hands back `Option<T>` instead of panicking, and the test
// for each bound is emitted from the same bounds the plain conversion checks,
// so the pair can never disagree about which values are out of range. The
// receiver is read once: `noisy()` counts its own calls, which is what makes a
// double evaluation visible in the output.
impl "std/option"
impl "std/result"

pd var calls_seen = 0

fun noisy(v: i64) => i64 {
    calls_seen = calls_seen + 1
    return v
}

// The payload, or `fail` when the conversion refused.
fun u8_or(o: option.Option<u8>, fail: u8) => u8 {
    if let Some(v) = o {
        return v
    }
    return fail
}

fun u32_or(o: option.Option<u32>, fail: u32) => u32 {
    if let Some(v) = o {
        return v
    }
    return fail
}

fun u64_or(o: option.Option<u64>, fail: u64) => u64 {
    if let Some(v) = o {
        return v
    }
    return fail
}

fun i32_or(o: option.Option<i32>, fail: i32) => i32 {
    if let Some(v) = o {
        return v
    }
    return fail
}

// `?` propagates `None` out of a function that returns `Option`, so the
// conversion composes with the rest of the error surface.
fun pick(n: i64) => option.Option<u8> {
    val v = n.try_to_u8()?
    return option.Option.Some(value = v)
}

fun main() {
    // The upper bound of an unsigned target, from a signed source.
    val lo: i64 = 255
    val hi: i64 = 256
    print(u8_or(o = lo.try_to_u8(), fail = 0))
    print(option.isNone(o = hi.try_to_u8()))

    // The lower bound of an unsigned target: only the sign can fail here, so
    // the emitted test is one comparison, not two.
    val neg: i64 = 0 - 1
    print(option.isNone(o = neg.try_to_u64()))
    print(u64_or(o = 7.try_to_u64(), fail = 0))

    // A signed target's own floor, and one below it.
    val deep: i64 = 0 - 2147483648
    print(i32_or(o = deep.try_to_i32(), fail = 0))
    print(option.isNone(o = (deep - 1).try_to_i32()))
    print(option.isNone(o = deep.try_to_u16()))

    // An unsigned source above a signed target: both bounds are reachable, so
    // the emitted test has to carry both.
    val wide: u32 = 4294967295
    print(option.isNone(o = wide.try_to_i32()))
    val small: u32 = 7
    print(i32_or(o = small.try_to_i32(), fail = 0))
    print(option.isNone(o = wide.try_to_u8()))

    // The narrowest source still has fallible targets below it.
    val sixteen: u16 = 65535
    print(option.isNone(o = sixteen.try_to_u8()))
    val fits: u16 = 255
    print(u8_or(o = fits.try_to_u8(), fail = 0))

    // A `u64` source: the upper bound is reachable only by a value no smaller
    // type can hold, and `usize` is the same width on this target.
    val big: u64 = 4294967296
    print(option.isNone(o = big.try_to_u32()))
    print(option.isNone(o = big.try_to_i32()))
    val ok: u64 = 7
    print(u32_or(o = ok.try_to_u32(), fail = 0))

    // A receiver that is a call is read once, whichever arm is taken.
    print(i32_or(o = noisy(v = 5).try_to_i32(), fail = 0))
    print(u8_or(o = noisy(v = 5).try_to_u8(), fail = 0))
    print(calls_seen)

    // The result in the positions an `Option` is used in: `if let`, a `when`
    // arm, and a `?` inside a function that returns the same shape.
    if let Some(v) = lo.try_to_u8() {
        print(v)
    }
    val matched = hi.try_to_u8()
    when matched {
        Some(v) -> print(v)
        None -> print("none")
    }
    val lifted = pick(n = 9)
    if let Some(v) = lifted {
        print(v)
    }
    print(option.isNone(o = pick(n = 900)))
}
// stdout-begin
// stdout: 255
// stdout: true
// stdout: true
// stdout: 7
// stdout: -2147483648
// stdout: true
// stdout: true
// stdout: true
// stdout: 7
// stdout: true
// stdout: true
// stdout: 255
// stdout: true
// stdout: true
// stdout: 7
// stdout: 5
// stdout: 5
// stdout: 2
// stdout: 255
// stdout: none
// stdout: 9
// stdout: true
