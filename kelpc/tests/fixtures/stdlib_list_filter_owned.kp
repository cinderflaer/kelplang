// A-4 phase D limit: `list.filter` reads an accepted element out of the list by
// value, so its element type has to be `Copy`. `list.map`/`each`/`any`/`all`/
// `find_index` are offered for any element type, because they never read one
// out.
impl "std/list"

fun main() {
    var names: List<String> = List.empty()
    names.push(String.from_str("ab"))
    val short = list.filter(xs = names, f = fun(s: &String).R: bool = s.len() < 3)
    print(short.len())
}
