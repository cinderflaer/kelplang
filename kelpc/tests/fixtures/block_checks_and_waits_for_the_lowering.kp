// Manual memory blocks (decision 139, step 3): a valid block checks. Its result
// is used with `?`, its box is bound by a `let` inside the block and not read, and the enclosing function returns `Result<_, BlockError>`.
// The lowering (step 4) is not built yet, so the program is refused after the
// checker accepts it.
impl "std/result"

datac Node(val value: i32)

fun make() => result.Result<i32, BlockError> {
    val n = block request: Node {
        val cell = request.box()?
        Node(value = 2)
    }?
    result.Result.Ok(value = n.value)
}

fun main() {
    print(0)
}
