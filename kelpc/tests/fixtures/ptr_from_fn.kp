// Kernel gap 2: `Ptr.from_fn(f)` is the address of a declared `fun` as a
// checked `Ptr<u8>`. Two distinct functions have distinct, non-null addresses,
// and asking for the same function twice gives the same address. Calling
// through the pointer is out of scope here; this only pins the address itself.
// The third function carries `align(16)`, so the backend has to lower the clause
// to a real function alignment.
fun a() => i32 = 1
fun b() => i32 = 2
align(16) fun c() => i32 = 3

fun main() {
    val pa = Ptr.from_fn(a).addr()
    val pa_again = Ptr.from_fn(a).addr()
    val pb = Ptr.from_fn(b).addr()
    // A `fun` literal that captures nothing is a plain `fun` value, so its
    // address is a function address like a declared function's.
    val sign = fun(x: i32) => i32 = x
    print(pa == pa_again)
    print(pa != pb)
    print(pa != 0)
    print(pb != 0)
    print(Ptr.from_fn(c).addr() != 0)
    print(Ptr.from_fn(sign).addr() != 0)
}
