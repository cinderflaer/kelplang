// MK7 §5's enum slice: the regression test for the register allocator's
// liveness pass, on the four node kinds this slice adds. `LiveAnalysis` has now
// twice handed two genuinely-live locals the *same* physical register because a
// node kind it did not walk made one of them look dead on declaration, a
// `StructLit` first, then `FieldAccess`/`Ref`/`Deref`. The failure mode is a
// wrong number, not a refusal, and it only appears when two locals are live
// *around* the node in question, so every function below keeps two scalars
// alive across the node kind it is named for and adds them back afterwards.
//
//   * `literal`, `EnumLit`: the payload reads `a`.
//   * `tagged` , `EnumTag` and `EnumField`: the scrutinee's tag is tested
//                  while `a` and `b` are both live, and the payload's value is
//                  read out of the union.
//   * `propagated`, `Try`: the `?` sits inside a binary operator, so `a` and
//                  `b` are live across the early return's own branch.
//   * `if_let` , MK5-S6-M1's `if let`, which desugars to a `when` inside an
//                  `if`: the condition is evaluated with `a` and `b` live and
//                  the binding is read inside the arm.
//   * `held`   , an enum-typed *local* live across a call: `hold` is built
//                  before `tagged` is called and read after it returns, so an
//                  enum local the call's own walk left out of the liveness
//                  pass would be handed to the next scalar.
//
// `if let` and an enum local live across a call were the two shapes this
// fixture did not reach, so both are here now: the pass is exercised on them,
// not only argued about.
//
// A register collision shows up as one of the sums being wrong, and the six
// functions between them cover the arithmetic both ways round so a swapped pair
// cannot cancel out.
enum Slot {
    Full(val n: i64)
    Empty
}

enum Res {
    Ok(val value: i64)
    Err(val why: i64)
}

fun literal(a: i64, b: i64) => i64 {
    val s = Slot.Full(n = a * 2)
    a + b * 3 + when s {
        Full(v) -> v
        Empty -> 0
    }
}

fun tagged(a: i64, b: i64, s: &Slot) => i64 = when s {
    Full(v) -> v + a * 5 + b * 7
    Empty -> a * 5 - b * 7
}

fun propagated(a: i64, b: i64, have: bool) => Res {
    val r = if have { Res.Ok(value = 5) } else { Res.Err(why = 0) }
    val v = r?
    return Res.Ok(value = a * 11 + b * 13 + v)
}

fun res_value(r: &Res) => i64 = when r {
    Ok(v) -> v
    Err(_e) -> -1
}

fun nested(a: i64, b: i64, s: &Slot) => i64 {
    val inner = Slot.Full(n = b)
    val outer = when s {
        Full(v) -> Slot.Full(n = v + a)
        Empty -> inner
    }
    return tagged(a = a, b = b, s = outer)
}

fun if_let(a: i64, b: i64, s: &Slot) => i64 {
    var acc = a * 2 + b
    if let Full(v) = s {
        acc = acc + v * 3
    }
    return acc + a * 5 - b * 7
}

fun held(a: i64, b: i64, s: &Slot) => i64 {
    val hold = Slot.Full(n = b)
    val extra = tagged(a = a, b = b, s = s)
    val back = when hold {
        Full(v) -> v * 11
        Empty -> 0
    }
    return extra + back + a * 13
}

fun main() {
    val full = Slot.Full(n = 100)
    val empty = Slot.Empty
    print(literal(a = 3, b = 4))
    print(tagged(a = 3, b = 4, s = full))
    print(tagged(a = 3, b = 4, s = empty))
    print(tagged(a = 4, b = 3, s = full))

    print(res_value(r = propagated(a = 1, b = 2, have = true)))
    print(res_value(r = propagated(a = 1, b = 2, have = false)))

    print(nested(a = 6, b = 7, s = full))
    print(nested(a = 6, b = 7, s = empty))

    print(if_let(a = 3, b = 4, s = full))
    print(if_let(a = 3, b = 4, s = empty))

    print(held(a = 3, b = 4, s = full))
    print(held(a = 6, b = 7, s = empty))
}
