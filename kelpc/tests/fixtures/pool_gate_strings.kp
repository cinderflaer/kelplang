// A pool of three workers runs 300 jobs, each pushing "job-<k>" onto a shared
// Mutex<List<String>>. After join the list holds 300 strings, and exactly one
// of them is "job-7".
impl "std/pool"
impl "std/fmt"
impl "std/str"

pd val gate: Mutex<List<String>> = Mutex.new(List.empty())

/// The text "job-<n>" as one owned String.
fun job_name(n: i64) => String {
    var s = String.from_str("job-")
    val digits = fmt.int(n)
    s.push_str(digits.as_str())
    return s
}

fun push_job(n: i64) {
    gate.lock { v ->
        v.push(job_name(n))
    }
}

fun main() {
    var p = pool.new(3)
    var k: i64 = 0
    while k < 300 {
        val n = k
        p.spawn(fun() {
            push_job(n)
        })
        k += 1
    }
    p.join()
    gate.lock { v ->
        print(v.len())
        var sevens = 0
        val target = String.from_str("job-7")
        for name in v.iter() {
            if str.eq(name.as_str(), target.as_str()) {
                sevens += 1
            }
        }
        print(sevens)
    }
}
// stdout-begin
// stdout: 300
// stdout: 1
