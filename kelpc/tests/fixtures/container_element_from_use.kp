// An empty container written without a type takes its element from the first
// operation that has to know it. `push`/`insert`/`set` decide it, from a nested
// block or a loop as well as from the next line, and a position that expects a
// container decides it too, whether that is a parameter or a return type.
fun count(xs: List<i32>) => int = xs.len()

fun empty_of() => List<i32> {
    var xs = List.empty()
    xs
}

fun main() {
    var xs = List.empty()
    xs.push(1)

    var src = List.empty()
    src.push(4)
    src.push(5)
    for n in src {
        xs.push(n)
    }
    {
        xs.push(6)
    }
    print("${xs.len()} ${xs.get(i = 3)}")

    var by_name = Map.empty()
    by_name.insert("a", 7)
    by_name.insert("b", 8)
    print("${by_name.len()} ${by_name.get(key = "b")}")

    var slot = Box.empty()
    slot.set(9)
    print("${slot.get()}")

    var from_arg = List.empty()
    print("${count(from_arg)}")
    print("${empty_of().len()}")
}
