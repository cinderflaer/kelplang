// A-12 slice 4: a `&dyn` binding forwards on to another function, and the
// binding keeps its referent borrowed.
trait Shape {
    fun Self.area().return: f64
}

datac Circle(val r: f64)
impl Shape for Circle { fun Self.area().return: f64 = r * r * 2.0 }

fun inner(s: &dyn Shape).return: f64 = s.area()
fun outer(s: &dyn Shape).return: f64 = inner(s) + inner(s)

fun main() {
    val c = Circle(r = 3.0)
    val d: &dyn Shape = &c
    print(outer(d))
    print(inner(&c))
}
