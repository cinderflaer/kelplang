// A worker takes a Sender, sends 1 and panics before it returns. The panic
// must not leave the Sender alive: its drop runs on the way out, so main sees
// the queued 1, then `Closed`, and never waits for a value that will not come.
impl "std/thread"
impl "std/result"
impl "std/sync"

fun worker(tx: move sync.Sender<i64>) {
    val back = tx.send(1)
    panic("worker gives up")
}

fun describe(r: move result.Result<i64, sync.RecvTimeout>) {
    when r {
        Ok(v) -> print(v)
        Err(e) -> when e {
            Timeout -> print("timeout")
            Closed -> print("closed")
        }
    }
}

fun main() {
    val (tx, rx) = sync.bounded<i64>(2)
    val h = thread.spawn(worker, tx)
    describe(rx.recv_timeout(20000))
    describe(rx.recv_timeout(20000))
    when thread.join(h) {
        Ok(_) -> {}
        Err(e) -> print(e.message)
    }
}
