// MISSING-z2bB9: a tuple takes the same derived deep copy and derived order a
// `datac` takes, field by field in position order. The copy is deep: the
// original list is cleared before the copy is read, so a shared buffer would be
// a use-after-free and this fixture is in the sanitizer pass for exactly that.
fun main() {
    var xs: List<(String, i32)> = List.empty()
    xs.push(("b", 2))
    xs.push(("a", 3))
    xs.push(("a", 1))

    var copy = xs.clone()
    xs.clear()
    print(copy.len())

    // The order is position by position: the text first, then the number.
    copy.sort()
    val (path0, n0) = copy.remove(i = 0)
    print(path0)
    print(n0)
    val (path1, n1) = copy.remove(i = 0)
    print(path1)
    print(n1)
    val (path2, n2) = copy.remove(i = 0)
    print(path2)
    print(n2)
    print(copy.len())

    // `slice` is the same deep copy over a range, on a nested tuple.
    var deep: List<((i32, i32), String)> = List.empty()
    deep.push(((3, 4), "kept"))
    var one = deep.slice(0, 1)
    deep.clear()
    val ((dx, dy), text) = one.pop()
    print(dx + dy)
    print(text)
}
// stdout-begin
// stdout: 3
// stdout: a
// stdout: 1
// stdout: a
// stdout: 3
// stdout: b
// stdout: 2
// stdout: 0
// stdout: 7
// stdout: kept
