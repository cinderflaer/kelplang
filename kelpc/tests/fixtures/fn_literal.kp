// A-4 phase C: anonymous `fun` literals, `fun(x: i32) => i32 = x * 2` written
// where an expression is expected. Each literal is one synthesized top-level
// function, so its body is checked like any other function's: it can use `?`
// against its own declared return type, and it owns (and drops) its `move`
// parameters. What it cannot do is see the enclosing scope, a name from one
// frame up is a *capture*, and captures are the next phase, not this one.
//
// This fixture is in the AddressSanitizer list: the `move` literal frees the
// buffer it is handed.
impl "std/option"

fun apply(f: fun(i32) => i32, x: i32) => i32 = f(x)

fun safe_div(a: i32, b: i32) => option.Option<i32> {
    if b == 0 {
        return option.Option.None
    }
    return option.Option.Some(value = a / b)
}

// A literal as a returned value: the function's declared type is the literal's
// type, spelled out.
fun doubler() => fun(i32) => i32 = fun(x: i32) => i32 = x * 2

datac Callbacks(val on_i32: fun(i32) => i32)

fun main() {
    val f = fun(x: i32) => i32 = x * 2
    print(f(21))
    print(apply(fun(x: i32) => i32 = x + 1, 5))

    // A block body, and `Unit` when no return type is written. A literal in
    // statement position is allowed and discarded.
    val g = fun(x: i32) {
        print(x)
    }
    g(7)

    // A literal's parameters take the same qualifiers a declaration's do.
    val h = fun(s: move String) => int = s.len()
    print(h("abcd"))

    // A literal inside a literal: each becomes its own function.
    val outer = fun(x: i32) => i32 {
        val inner = fun(y: i32) => i32 = y * 10
        return inner(x) + 1
    }
    print(outer(3))

    // A literal holding a `datac` field, and one returned from a function.
    val c = Callbacks(on_i32 = fun(x: i32) => i32 = x - 1)
    print(c.on_i32(10))
    val d = doubler()
    print(d(6))

    // `?` inside a literal propagates against the literal's own return type.
    val chain = fun(a: i32, b: i32) => option.Option<i32> {
        val q = safe_div(a, b)?
        return option.Option.Some(value = q + 1)
    }
    print(option.isNone(o = chain(1, 0)))
    print(option.expect(o = chain(9, 3), message = "unreachable"))
}
// stdout-begin
// stdout: 42
// stdout: 6
// stdout: 7
// stdout: 4
// stdout: 31
// stdout: 9
// stdout: 12
// stdout: true
// stdout: 4
