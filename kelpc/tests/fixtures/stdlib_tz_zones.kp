// std/tz over the host's TZif database: the transitions of four real zones,
// the half-hour and thirty-minute offsets, the footer POSIX rule at a far
// future date, and two wall clocks before the first transition of the 64-bit
// table. The database is not the program's to choose, so every check is guarded
// by a probe: a machine without it prints one line and exits 0 instead of
// failing, and the Rust test that runs this fixture skips the same way.
impl "std/tz" caps(fs = ["/**"], env = ["TZDIR"])
impl "std/fs"
impl "std/env"
impl "std/str"
impl "std/option"
impl "std/result"

datac Stats(var run: i32, var bad: i32)

fun t(st: mut Stats, name: &str, ok: bool) {
    st.run += 1
    if !ok {
        st.bad += 1
        print("FAIL")
        print(name)
    }
}

fun same(st: mut Stats, name: &str, value: String, expect: &str) {
    t(st, name, str.eq(value.as_str(), expect))
}

fun digits(n: i64) => String = str.from_i64(n)

fun label(r: &tz.Resolved) => String {
    var out = String.empty()
    if let One(u) = r {
        out.push_str("one ")
        val d = digits(u)
        out.push_str(d)
    } else if let Ambiguous(a, b) = r {
        out.push_str("ambiguous ")
        val da = digits(a)
        val db = digits(b)
        out.push_str(da)
        out.push(' ')
        out.push_str(db)
    } else {
        out.push_str("gap")
    }
    return out
}

// ---- is there a database? ---------------------------------------------------

fun has_zone(dir: String, name: &str) => bool {
    if dir.len() == 0 {
        return false
    }
    val head = str.concat(dir.as_str(), "/")
    val path = str.concat(head, name)
    return fs.isFile(path)
}

fun dir_of(name: &str) => String {
    val tzdir = env.get("TZDIR")
    if has_zone(tzdir, name) {
        return tzdir
    }
    val fallback = String.from_str("/usr/share/zoneinfo")
    if has_zone(fallback, name) {
        return fallback
    }
    return String.empty()
}

// One zone's checks, with a mode for the cases that have to be written
// differently in each.
fun check_new_york(st: mut Stats, z: &tz.Zone) {
    val before = z.offsetAt(1710053999)
    val after = z.offsetAt(1710054000)
    t(st, "ny est before the jump", before.seconds == -18000)
    same(st, "ny est name", before.abbrev.clone(), "EST")
    t(st, "ny edt at the jump", after.seconds == -14400)
    t(st, "ny edt is dst", after.is_dst)
    same(st, "ny edt name", after.abbrev.clone(), "EDT")

    val gap24 = z.toUnix(2024, 3, 10, 2, 30, 0)
    val amb24 = z.toUnix(2024, 11, 3, 1, 30, 0)
    val one24 = z.toUnix(2024, 3, 10, 1, 30, 0)
    same(st, "ny 2024 spring forward", label(gap24), "gap")
    same(st, "ny 2024 fall back", label(amb24), "ambiguous 1730611800 1730615400")
    same(st, "ny 2024 last est", label(one24), "one 1710052200")
    same(st, "ny 2025 spring forward", label(z.toUnix(2025, 3, 9, 2, 30, 0)), "gap")
    same(st, "ny 2025 fall back", label(z.toUnix(2025, 11, 2, 1, 30, 0)), "ambiguous 1762061400 1762065000")
    same(st, "ny 2026 spring forward", label(z.toUnix(2026, 3, 8, 2, 30, 0)), "gap")
    same(st, "ny 2026 fall back", label(z.toUnix(2026, 11, 1, 1, 30, 0)), "ambiguous 1793511000 1793514600")

    // 2100 is past the last transition in the file, so these two run on the
    // footer rule alone
    val summer = z.toUnix(2100, 6, 15, 12, 0, 0)
    val winter = z.toUnix(2100, 1, 15, 12, 0, 0)
    same(st, "ny footer summer", label(summer), "one 4116758400")
    same(st, "ny footer winter", label(winter), "one 4103715600")
    t(st, "ny footer summer offset", z.offsetAt(4116758400).seconds == -14400)
    t(st, "ny footer winter offset", z.offsetAt(4103715600).seconds == -18000)
    same(st, "ny footer summer Z", z.format(4116758400, "%Z"), "EDT")
    same(
        st,
        "ny footer summer stamp",
        z.format(4116758400, "%Y-%m-%d %H:%M:%S %z %a %b %j"),
        "2100-06-15 12:00:00 -0400 Tue Jun 166"
    )

    // before 1970, which the 64-bit table covers with its own transitions
    val moon = z.toUnix(1969, 7, 20, 20, 17, 0)
    same(st, "ny 1969", label(moon), "one -14168580")
    t(st, "ny 1969 offset", z.offsetAt(-14168580).seconds == -14400)
    same(st, "ny 1969 stamp", z.format(-14168580, "%Y-%m-%d %H:%M:%S %Z"), "1969-07-20 20:17:00 EDT")
    val e1900 = z.toUnix(1900, 1, 1, 0, 0, 0)
    same(st, "ny 1900", label(e1900), "one -2208970800")
    t(st, "ny 1900 offset", z.offsetAt(-2208970800).seconds == -18000)
    t(st, "ny 2000 is est", z.offsetAt(946702800).seconds == -18000)
}

fun check_berlin(st: mut Stats, z: &tz.Zone) {
    t(st, "ber cet before", z.offsetAt(1711846799).seconds == 3600)
    t(st, "ber cest at", z.offsetAt(1711846800).seconds == 7200)
    same(st, "ber spring forward", label(z.toUnix(2024, 3, 31, 2, 30, 0)), "gap")
    same(st, "ber fall back", label(z.toUnix(2024, 10, 27, 2, 30, 0)), "ambiguous 1729989000 1729992600")
    same(st, "ber summer stamp", z.format(1720000000, "%Y-%m-%d %H:%M:%S %z %Z"), "2024-07-03 11:46:40 +0200 CEST")
    // past the last transition: the footer rule
    t(st, "ber 2100 summer", z.offsetAt(4119328800).seconds == 7200)
    t(st, "ber 2100 winter", z.offsetAt(4103694000).seconds == 3600)
    same(st, "ber 2100 summer Z", z.format(4119328800, "%Z"), "CEST")
    same(st, "ber 1900", label(z.toUnix(1900, 1, 1, 0, 0, 0)), "one -2208992400")
}

fun check_kolkata(st: mut Stats, z: &tz.Zone) {
    t(st, "kol half hour", z.offsetAt(1700000000).seconds == 19800)
    same(st, "kol name", z.offsetAt(1700000000).abbrev.clone(), "IST")
    t(st, "kol not dst", !z.offsetAt(1700000000).is_dst)
    same(st, "kol z", z.format(0, "%z"), "+0530")
    same(st, "kol stamp", z.format(0, "%Y-%m-%d %H:%M:%S %Z"), "1970-01-01 05:30:00 IST")
    same(st, "kol 2024", label(z.toUnix(2024, 1, 1, 0, 0, 0)), "one 1704047400")
    same(st, "kol 1900", label(z.toUnix(1900, 1, 1, 0, 0, 0)), "one -2209008070")
    t(st, "kol 1900 was mmt", z.offsetAt(-2209008070).seconds == 19270)
    // a year with no DST at all, through the footer
    t(st, "kol 2100", z.offsetAt(4102444800).seconds == 19800)
}

fun check_lord_howe(st: mut Stats, z: &tz.Zone) {
    val jan = z.toUnix(2024, 1, 15, 12, 0, 0)
    val jul = z.toUnix(2024, 7, 15, 12, 0, 0)
    same(st, "lh january", label(jan), "one 1705280400")
    same(st, "lh july", label(jul), "one 1721007000")
    t(st, "lh summer offset", z.offsetAt(1705280400).seconds == 39600)
    t(st, "lh winter offset", z.offsetAt(1721007000).seconds == 37800)
    // the DST step is half an hour here, not a whole one
    t(st, "lh dst step is 30 minutes", z.offsetAt(1705280400).seconds - z.offsetAt(1721007000).seconds == 1800)
    same(st, "lh summer Z", z.offsetAt(1705280400).abbrev.clone(), "+11")
    same(st, "lh winter Z", z.offsetAt(1721007000).abbrev.clone(), "+1030")
    same(st, "lh spring forward", label(z.toUnix(2024, 10, 6, 2, 15, 0)), "gap")
    same(st, "lh fall back", label(z.toUnix(2024, 4, 7, 1, 45, 0)), "ambiguous 1712414700 1712416500")
    t(st, "lh at the jump", z.offsetAt(1712415600).seconds == 37800)
    t(st, "lh before the jump", z.offsetAt(1712415599).seconds == 39600)
    // 2100, on the footer rule, in both seasons
    t(st, "lh 2100 january", z.offsetAt(4103658000).seconds == 39600)
    t(st, "lh 2100 july", z.offsetAt(4119298200).seconds == 37800)
    t(st, "lh 2100 january is dst", z.offsetAt(4103658000).is_dst)
    same(st, "lh 2100 january Z", z.format(4103658000, "%Z"), "+11")
}

fun main() {
    var st = Stats(run = 0, bad = 0)
    var names: List<String> = List.of("America/New_York")
    names.push("Europe/Berlin")
    names.push("Asia/Kolkata")
    names.push("Australia/Lord_Howe")
    var missing = false
    var i: int = 0
    while i < names.len() {
        val dir = dir_of(names.get(i).as_str())
        if dir.len() == 0 {
            missing = true
        }
        i = i + 1
    }
    if missing {
        print("tz: no zoneinfo database")
        return
    }
    val ny = tz.load("America/New_York")
    val ber = tz.load("Europe/Berlin")
    val kol = tz.load("Asia/Kolkata")
    val lh = tz.load("Australia/Lord_Howe")
    if let Ok(z) = ny {
        check_new_york(st, z)
    } else {
        t(st, "new york loads", false)
    }
    if let Ok(z) = ber {
        check_berlin(st, z)
    } else {
        t(st, "berlin loads", false)
    }
    if let Ok(z) = kol {
        check_kolkata(st, z)
    } else {
        t(st, "kolkata loads", false)
    }
    if let Ok(z) = lh {
        check_lord_howe(st, z)
    } else {
        t(st, "lord howe loads", false)
    }
    print("cases: ${st.run}, failed: ${st.bad}")
}
