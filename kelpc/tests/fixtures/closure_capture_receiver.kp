// A-4 phase E: a literal inside a receiver-form method cannot capture the
// receiver's field. The receiver is borrowed, and a field cannot be moved out of
// a borrow, so the read is refused; the message names the two ways round it.
datac Counter(val n: i32)

fun Counter.bump() => i32 {
    val f = fun() => i32 = n + 1
    return f()
}

fun main() {
    val c = Counter(n = 1)
    print(c.bump())
}
