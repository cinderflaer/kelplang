// MISSING-z2bB9: a function hands back two things as one tuple value, and the
// caller takes it apart with a destructuring binding, so a pair no longer needs
// a one-shot `datac` (`plan/syntax.md` 3 and 4).
fun min_max(xs: &List<i32>) => (i32, i32) {
    var lo = xs.get(i = 0)
    var hi = xs.get(i = 0)
    var i: int = 0
    while i < xs.len() {
        val v = xs.get(i = i)
        if v < lo { lo = v }
        if v > hi { hi = v }
        i += 1
    }
    return (lo, hi)
}

fun main() {
    var xs: List<i32> = List.empty()
    xs.push(3)
    xs.push(9)
    xs.push(1)
    xs.push(7)

    val (lo, hi) = min_max(xs)
    print(lo)
    print(hi)
    print(hi - lo)
}
