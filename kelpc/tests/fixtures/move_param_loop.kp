// A-4: a moved parameter is an owned local, so moving it inside a loop is the
// same double move a local binding would be — the second iteration would have
// nothing to move.
fun consume(s: move String).R: usize = s.len()

fun main() {
    val a = String.from_str("x")
    var i = 0
    while i < 2 {
        print(consume(a))
        i += 1
    }
}
