// A-19: a `const` is folded while the compiler runs. It may call a plain
// `fun` whose own body stays inside what a constant can evaluate, but not one
// whose body does something a constant cannot be: `shout` prints, and a
// compile-time fold has no output to print to.
const BAD: i32 = shout()

fun shout().R: i32 {
    print("hi")
    1
}

fun main() {
    print(BAD)
}
