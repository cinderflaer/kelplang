// A-12 slice 7: `Box<dyn A + B>` is refused by name; a trait object names one
// trait, and the trait that combines them is a declared trait with `A` and `B`
// as supertraits.
trait A {
    fun Self.a() => i32
}

trait B {
    fun Self.b() => i32
}

fun take(s: Box<dyn A + B>) { }

fun main() { }
