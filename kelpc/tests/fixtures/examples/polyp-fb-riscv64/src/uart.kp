// The NS16550 UART QEMU's riscv64 `virt` machine puts at 0x10000000. THR (offset 0) is the byte to
// send; LSR (offset 5) bit 5 is set while the transmit holding register is empty, so a byte is
// written only after that bit reads back set. Every access goes through `Ptr<u8>` and is volatile,
// and nothing else about the device is checked: the base, the offsets and the bit are the driver's
// own claim about the hardware (kernel stage 1, `kelp wiki page language/unsafe.md`).
//
// This is the driver `examples/kernel0` carries, with the one addition Polyp needs: `puts` takes a
// `str`, and `str.len`/`str.byte` are the compiler's own byte loops (kernel stage 7), so a step
// line built by the scenario module reaches the serial port with no `strlen` between them.
impl "std/str"

const UART_BASE: usize = 0x10000000
const LSR_OFFSET: usize = 5

pub fun putc(c: u8) {
    unsafe {
        val lsr: Ptr<u8> = Ptr.from_addr(UART_BASE + LSR_OFFSET)
        // v1 has no bitwise operators, so bit 5 of LSR is `(value / 32) % 2`.
        while (lsr.read_volatile() / 32) % 2 == 0 {}
        val thr: Ptr<u8> = Ptr.from_addr(UART_BASE)
        thr.write_volatile(c)
    }
}

pub fun puts(s: str) {
    val n = str.len(s)
    var i: usize = 0
    while i < n {
        putc(str.byte(s, i))
        i = i + 1
    }
}

// `wfi` has no Kelp spelling (kernel stage 5, `kelp wiki page language/unsafe.md`), and the compiler's `_start`
// stub already loops on it if the entry returns; this is the same halt written in the language.
pub fun halt() {
    while true {
        unsafe {
            asm("wfi")
        }
    }
}
