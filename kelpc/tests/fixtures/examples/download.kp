//! download.kp, fetch a URL over HTTP and write the body to a file.
impl "std/http" caps(net = ["127.0.0.1:*"])
impl "std/fs"
impl "std/process"
impl "std/str"
impl "std/fmt"
impl "std/result"

fun usage() {
    print("usage: download <url> <output-path>")
}

fun fail(message: str, code: i32) {
    print(message)
    process.exit(code)
}

fun main() {
    val args = process.args()
    if args.len() != 3 {
        usage()
        process.exit(2)
    }
    val url = args.get(1)
    val out = args.get(2)

    // Panics if the URL has no host, is not `http`, or the connection fails /
    // the capability denies the host, all of which are the programmer's
    // problem, not a caller's. A *response* that says "no" is not a panic.
    val resp = result.expect(http.get(url.as_str()), "http.get: the call failed")

    if !resp.is_ok() {
        print!("download failed: HTTP ")
        print(resp.status)
        process.exit(1)
    }

    // A server that frames its body with `Content-Length` or chunked encoding
    // can be reused and is trustworthy; one that does neither is read to end of
    // file, which is legal but means the connection is spent. Either way the
    // body is complete, so report which it was rather than guessing.
    val declared = resp.header("content-length")
    if str.is_empty(declared) {
        print("no Content-Length: the body ends at end of file")
    } else {
        print("Content-Length: ${declared.as_str()}")
    }

    // `resp.body` is an owned `Bytes`, and `fs.write` takes it by borrow, so
    // this is the byte-exact path: no utf-8 validation, no text round trip. A
    // `String` in Kelp is validated utf-8 and could not hold an image.
    val part = str.concat(out.as_str(), ".part")
    result.expect(fs.write(part, resp.body), "fs.write: the call failed")
    fs.sync(part)
    result.expect(fs.rename(part, out.as_str()), "fs.rename: the call failed")

    // Read the size back off the disk rather than trusting the write: the
    // check that costs one syscall and catches the class of bug where a
    // download "succeeds" with a truncated file.
    //
    // `fs.size` is `u64` and `Bytes.len` is `int`, and there is no implicit
    // numeric conversion in Kelp, so the comparison needs the `to_u64`, widening,
    // therefore exact.
    val on_disk = fs.size(out.as_str())
    if on_disk != resp.body.len().to_u64() {
        fail("short write: the file is not what was downloaded", 3)
    }

    val bytes = fmt.uint(on_disk)
    var msg = String.empty()
    msg.push_str("wrote ")
    msg.push_str(bytes)
    msg.push_str(" bytes to ")
    msg.push_str(out.as_str())
    print(msg)
}
