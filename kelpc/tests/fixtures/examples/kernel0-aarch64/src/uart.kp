// The PL011 UART QEMU's aarch64 `virt` machine puts at 0x09000000. DR (offset
// 0) is the byte to send; FR (offset 0x18) bit 5 (TXFF) is set while the
// transmit FIFO is full, so a byte is written only after that bit reads back
// clear. Every access goes through `Ptr<u8>`/`Ptr<u32>` and is volatile so the
// compiler can neither merge, reorder nor elide it, and nothing else about the
// device is checked: the base, the offsets and the bit are the driver's own
// claim about the hardware (kernel stage 1, `language/unsafe.md` (kelp wiki)).
//
// Text arrives as a `str`, the same type a hosted program writes, and
// `str.len`/`str.byte` are the compiler's own byte loops (kernel stage 7,
// `language/kernel.md` (kelp wiki) gap 1), so no `strlen` and no `[u8; N]` copy sits
// between the caller and the device.
impl "std/str"

const UART_BASE: usize = 0x09000000
const FR_OFFSET: usize = 0x18

pub fun putc(c: u8) {
    unsafe {
        val fr: Ptr<u32> = Ptr.from_addr(UART_BASE + FR_OFFSET)
        // v1 has no bitwise operators, so bit 5 of FR is `(value / 32) % 2`.
        // TXFF is set while the FIFO is full, so the loop waits for it clear.
        while (fr.read_volatile() / 32) % 2 == 1 {}
        val dr: Ptr<u8> = Ptr.from_addr(UART_BASE)
        dr.write_volatile(c)
    }
}

pub fun puts(s: str) {
    val n = str.len(s)
    var i: usize = 0
    while i < n {
        putc(str.byte(s, i))
        i = i + 1
    }
}

// `wfe` has no Kelp spelling (kernel stage 5, `language/unsafe.md` (kelp wiki)), and the
// compiler's `_start` stub already loops on it if the entry returns; this is
// the same halt written in the language, so the kernel names its own stop.
pub fun halt() {
    while true {
        unsafe {
            asm("wfe")
        }
    }
}
