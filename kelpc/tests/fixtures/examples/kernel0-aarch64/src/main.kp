//! Kernel 0 on aarch64: the smallest thing that boots on bare metal and says
//! so. The message is a `str` literal in read-only data; the driver walks it one
//! byte at a time with `str.len`/`str.byte`.
impl "uart" caps(mmio = ["0x09000000+0x1000"])

section(".text.boot") fun kmain() {
    uart.puts("hello from kelp (aarch64)\n")
    uart.halt()
}

// The handler `[target] panic` names: every bounds and overflow check the
// compiler emits calls this with the static message the check was written
// with. It prints `panic: ` and the message, then loops, because a check that
// fired has no meaningful continuation.
fun kp_panic(msg: str) {
    uart.puts("panic: ")
    uart.puts(msg)
    uart.puts("\n")
    uart.halt()
}
