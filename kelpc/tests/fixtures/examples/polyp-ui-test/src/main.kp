//! Polyp v3 stage 3's tests, in plain Kelp with no display.
impl "deps/polyp/core/core"
impl "deps/polyp/backends/soft/soft/damage"
impl "deps/polyp/backends/soft/soft/event"
impl "deps/polyp/backends/soft/soft/fb"
impl "deps/polyp/backends/soft/soft/headless_platform"
impl "deps/polyp/backends/soft/soft/platform"
impl "deps/polyp/backends/soft/soft/ppm_platform" caps(fs = ["/**"], env = ["POLYP_DUMP_DIR"])
impl "deps/polyp/backends/soft/soft_backend"
impl "std/env"
impl "std/option"
impl "std/str"

const WINDOW_W: i32 = 400
const WINDOW_H: i32 = 300

fun changed(text: String) => i32 = 0

// The state is an owned `datac`, as every Polyp program's `Model` is, because `frame` reads the
// state through a `mut` parameter.
datac St(var n: i32)

fun rect4(x: i32, y: i32, w: i32, h: i32) => fb.Rect = fb.Rect(x = x, y = y, w = w, h = h)

fun nop(s: mut St, m: i32) {}

// The checkbox section's state and view: a checkbox that flips a flag and a button that counts a
// press, so Space and a click can be told apart from a no-op.
datac Cb(var checked: bool, var presses: i32)

fun cb_view(s: Cb) => core.Node<i32> {
    return core.column { k ->
        k.spacing(0)
        k.align(core.Align.Start)
        k.checkbox("tick", s.checked, 1)
        k.align(core.Align.Start)
        k.button("go", 2)
    }
}

fun cb_update(s: mut Cb, m: i32) {
    if m == 1 {
        s.checked = !s.checked
    }
    if m == 2 {
        s.presses += 1
    }
}

// A tree with one of every interactive widget, so hit-testing and focus order have something to
// walk: a text, a row of two buttons, an entry and a checkbox.
fun ui(s: St) => core.Node<i32> {
    return core.column { k ->
        k.spacing(0)
        k.text("title")
        k.row { r ->
            r.spacing(0)
            r.button("aa", 1)
            r.button("bb", 2)
        }
        k.entry("abcd", changed)
        k.checkbox("tick", false, 3)
    }
}

// Two texts whose rectangles are their own measured size, for the damage and layout sections.
fun two_texts(a: str, c: str) => core.Node<i32> {
    return core.column { k ->
        k.spacing(0)
        k.align(core.Align.Start)
        k.text(a)
        k.align(core.Align.Start)
        k.text(c)
    }
}

fun fnv_byte(h: u64, b: u8) => u64 = (h ^ b.to_u64()) * 1099511628211

// FNV-1a over every pixel outside `r`, which is the "outside is bit-identical" check.
fun digest_outside(p: &headless_platform.HeadlessPlatform, r: fb.Rect) => u64 {
    var h: u64 = 14695981039346656037
    var y: i32 = 0
    while y < p.height() {
        var x: i32 = 0
        while x < p.width() {
            if !fb.contains_point(r, x, y) {
                val px = p.pixel(x, y)
                h = fnv_byte(h, (px & 0xFF).to_u8())
                h = fnv_byte(h, ((px >> 8) & 0xFF).to_u8())
                h = fnv_byte(h, ((px >> 16) & 0xFF).to_u8())
                h = fnv_byte(h, ((px >> 24) & 0xFF).to_u8())
            }
            x += 1
        }
        y += 1
    }
    return h
}

// Push one event and run one frame, returning the tree the loop keeps. The state is a local,
// because `frame` reads it through a `mut` parameter and a `mut` parameter of a `Copy` scalar
// state hits a language limit the design note records.
fun step(b: mut soft_backend.SoftBackend, p: mut headless_platform.HeadlessPlatform, tree: move core.Node<i32>, ev: move event.Event) => core.Node<i32> {
    var st = St(n = 0)
    p.push(ev)
    return when soft_backend.frame(backend = b, platform = p, tree = tree, state = st, view = ui, update = nop) {
        Idle(t) -> t
        Changed(t) -> t
        Quit(t) -> t
    }
}

fun run_hit() {
    print("hit")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    val t = ui(St(n = 0))
    b.apply(core.create_all(&t))
    b.layout()
    var ids = b.interactive_ids()
    for item in ids {
        val id = item
        when b.rect_of_slot(id) {
            Some(r) -> {
                val cx = r.x + r.w / 2
                val cy = r.y + r.h / 2
                print(b.hit(cx, cy))
            }
            None -> print(-1)
        }
    }
    // A point in the text, which is not interactive, names nothing.
    print(b.hit(3, 3))
}

fun run_order() {
    print("order")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    var tree = ui(St(n = 0))
    b.apply(core.create_all(&tree))
    b.layout()
    var ids = b.interactive_ids()
    for item in ids {
        print(item)
    }
    // Tab from nothing focuses the first, then each in turn, then wraps.
    var k: i32 = 0
    while k < 5 {
        tree = step(b, p, tree, event.Event.Key(code = event.KEY_TAB, mods = 0))
        print(b.focus_id)
        k += 1
    }
    // Shift-Tab steps back one, and from the first wraps to the last.
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_TAB, mods = event.MOD_SHIFT))
    print(b.focus_id)
}

fun run_edit() {
    print("edit")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    var tree = ui(St(n = 0))
    b.apply(core.create_all(&tree))
    b.layout()
    val f = p.framebuffer()
    val d0 = b.paint(f)
    if d0.count() > 0 {
        p.present(f, d0)
    }
    val eids = b.entry_ids()
    val eid = eids.get(0)
    b.set_focus(eid)
    print(b.entry_text(eid))
    print(b.caret_of(eid))
    tree = step(b, p, tree, event.Event.Char(codepoint = 88))
    print(b.entry_text(eid))
    print(b.caret_of(eid))
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_RIGHT, mods = 0))
    tree = step(b, p, tree, event.Event.Char(codepoint = 89))
    print(b.entry_text(eid))
    print(b.caret_of(eid))
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_LEFT, mods = 0))
    print(b.caret_of(eid))
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_RIGHT, mods = 0))
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_HOME, mods = 0))
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_DELETE, mods = 0))
    print(b.entry_text(eid))
    print(b.caret_of(eid))
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_END, mods = 0))
    print(b.caret_of(eid))
    tree = step(b, p, tree, event.Event.Key(code = event.KEY_BACKSPACE, mods = 0))
    print(b.entry_text(eid))
    print(b.caret_of(eid))
}

fun run_damage() {
    print("damage")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    val t1 = two_texts("aaaa", "zzzz")
    b.apply(core.create_all(&t1))
    b.layout()
    val f = p.framebuffer()
    val d0 = b.paint(f)
    if d0.count() > 0 {
        p.present(f, d0)
    }
    // The first text is 4 bytes wide (24px) and 7px tall, at the origin.
    val label = rect4(0, 0, 24, 7)
    val before = digest_outside(p, label)
    b.reset_counts()
    val t2 = two_texts("bbbb", "zzzz")
    val patches = core.diff(t1, t2)
    b.apply(patches)
    b.layout()
    print(b.damage_count())
    val dmg = b.damage_rect(0)
    print(dmg.x)
    print(dmg.y)
    print(dmg.w)
    print(dmg.h)
    val f2 = p.framebuffer()
    val d1 = b.paint(f2)
    if d1.count() > 0 {
        p.present(f2, d1)
    }
    val after = digest_outside(p, label)
    if before == after {
        print("outside-same")
    } else {
        print("outside-changed")
    }
    print(b.measure_count())
    print(b.arrange_count())

    // An idle frame presents nothing.
    val frames_before = p.frame_count()
    var st = St(n = 0)
    val tick = soft_backend.frame(backend = b, platform = p, tree = t2, state = st, view = ui, update = nop)
    val frames_after = p.frame_count()
    print(frames_after - frames_before)
    when tick {
        Idle(_) -> {}
        Changed(_) -> {}
        Quit(_) -> {}
    }
}

fun run_hover() {
    print("hover")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    var tree = ui(St(n = 0))
    b.apply(core.create_all(&tree))
    b.layout()
    val f = p.framebuffer()
    val d0 = b.paint(f)
    if d0.count() > 0 {
        p.present(f, d0)
    }
    // A hover over the first button damages one rectangle, which is that button.
    val r0 = b.rect_of_slot(1)
    when r0 {
        Some(r) -> {
            tree = step(b, p, tree, event.Event.PointerMove(x = r.x + 2, y = r.y + 2))
            print(p.presented_count())
            val pr = p.presented_at(0)
            print(pr.x)
            print(pr.y)
            print(pr.w)
            print(pr.h)
        }
        None -> print(-1)
    }
    // Moving onto nothing un-hovers it, and damages the same widget again.
    tree = step(b, p, tree, event.Event.PointerMove(x = 399, y = 299))
    print(p.presented_count())
    val back = p.presented_at(0)
    print(back.x)
    print(back.w)
}

fun run_checkbox() {
    print("checkbox")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    var st = Cb(checked = false, presses = 0)
    var tree = cb_view(st)
    b.apply(core.create_all(&tree))
    b.layout()
    val f = p.framebuffer()
    val d0 = b.paint(f)
    if d0.count() > 0 {
        p.present(f, d0)
    }
    var ids = b.interactive_ids()
    val cid = ids.get(0)
    val bid = ids.get(1)
    // Space on the focused checkbox toggles it through its own message.
    b.set_focus(cid)
    p.push(event.Event.Key(code = event.KEY_SPACE, mods = 0))
    val t1 = soft_backend.frame(backend = b, platform = p, tree = tree, state = st, view = cb_view, update = cb_update)
    tree = when t1 {
        Idle(t) -> t
        Changed(t) -> t
        Quit(t) -> t
    }
    print(st.checked)
    // A click on the button activates it the same way.
    val r = b.rect_of_slot(bid)
    when r {
        Some(rr) -> {
            val cx = rr.x + rr.w / 2
            val cy = rr.y + rr.h / 2
            p.push(event.Event.PointerMove(x = cx, y = cy))
            p.push(event.Event.PointerDown(x = cx, y = cy, button = event.BUTTON_LEFT))
            p.push(event.Event.PointerUp(x = cx, y = cy, button = event.BUTTON_LEFT))
        }
        None -> {}
    }
    val t2 = soft_backend.frame(backend = b, platform = p, tree = tree, state = st, view = cb_view, update = cb_update)
    tree = when t2 {
        Idle(t) -> t
        Changed(t) -> t
        Quit(t) -> t
    }
    print(st.presses)
}

// A scroll area with far more content than the window, so the wheel moves and then clamps.
fun scroll_view(s: St) => core.Node<i32> {
    return core.column { k ->
        k.spacing(0)
        k.expand()
        k.scrolled { sc ->
            sc.spacing(0)
            var i = 0
            while i < 100 {
                sc.text("row")
                i += 1
            }
        }
    }
}

fun run_scroll() {
    print("scroll")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    var st = St(n = 0)
    var tree = scroll_view(st)
    b.apply(core.create_all(&tree))
    b.layout()
    val f = p.framebuffer()
    val d0 = b.paint(f)
    if d0.count() > 0 {
        p.present(f, d0)
    }
    val before = p.checksum()
    p.push(event.Event.PointerMove(x = 200, y = 150))
    p.push(event.Event.Scroll(dx = 0, dy = 50))
    val t1 = soft_backend.frame(backend = b, platform = p, tree = tree, state = st, view = scroll_view, update = nop)
    tree = when t1 {
        Idle(t) -> t
        Changed(t) -> t
        Quit(t) -> t
    }
    if p.checksum() != before {
        print("scrolled")
    } else {
        print("same")
    }
    // A wheel step past the end clamps and repaints once; a second one changes nothing.
    val n1 = p.frame_count()
    p.push(event.Event.Scroll(dx = 0, dy = 100000))
    val t2 = soft_backend.frame(backend = b, platform = p, tree = tree, state = st, view = scroll_view, update = nop)
    tree = when t2 {
        Idle(t) -> t
        Changed(t) -> t
        Quit(t) -> t
    }
    print(p.frame_count() - n1)
    val n2 = p.frame_count()
    p.push(event.Event.Scroll(dx = 0, dy = 100000))
    val t3 = soft_backend.frame(backend = b, platform = p, tree = tree, state = st, view = scroll_view, update = nop)
    tree = when t3 {
        Idle(t) -> t
        Changed(t) -> t
        Quit(t) -> t
    }
    print(p.frame_count() - n2)
}

fun run_layout() {
    print("layout")
    var p = headless_platform.new(width = WINDOW_W, height = WINDOW_H)
    var b = soft_backend.new()
    b.resize(WINDOW_W, WINDOW_H)
    val t1 = two_texts("aaaa", "zzzz")
    b.apply(core.create_all(&t1))
    b.layout()
    // Same width: one re-measure (the changed label), no re-arrange.
    b.reset_counts()
    val t2 = two_texts("bbbb", "zzzz")
    b.apply(core.diff(t1, t2))
    b.layout()
    print(b.measure_count())
    print(b.arrange_count())
    // Wider: the change reaches the column, so a re-arrange follows.
    b.reset_counts()
    val t3 = two_texts("bbbbbbbb", "zzzz")
    b.apply(core.diff(t2, t3))
    b.layout()
    print(b.measure_count())
    print(b.arrange_count())
}

// The PpmPlatform acceptance: one frame, one file.
fun run_ppm() {
    print("ppm")
    var p = ppm_platform.new(width = 64, height = 48)
    val dir = env.get("POLYP_DUMP_DIR")
    if str.is_empty(dir) {
        print("no-dir")
        return
    }
    var b = soft_backend.new()
    b.resize(64, 48)
    var tree = ui(St(n = 0))
    b.apply(core.create_all(&tree))
    b.layout()
    val f = p.framebuffer()
    val d0 = b.paint(f)
    if d0.count() > 0 {
        p.present(f, d0)
    }
    print(p.frame_count())
    print(p.presented_count())
}

fun main() {
    val mode = env.get("POLYP_UI_TEST")
    if str.eq(mode, "ppm") {
        run_ppm()
        return
    }
    run_hit()
    run_order()
    run_edit()
    run_damage()
    run_hover()
    run_checkbox()
    run_scroll()
    run_layout()
}
