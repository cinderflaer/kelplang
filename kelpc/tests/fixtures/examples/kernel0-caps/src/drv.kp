// The tiny driver for kernel stage 18: it takes a `Line` and a `Frame` and
// prints them. The two parameters are the receipts for the entry's claims, and
// the entry's `impl "drv" caps(...)` line is what gives this module the `irq`
// and `frames` domains. Without that grant `line.number()`, `frame.addr()` and
// `frame.offset(...)` would not resolve: every item of a capability module
// needs the domain, so possession of the value is not enough to read it.
impl "std/irq"
impl "std/frame"
impl "uart"

pub fun report(line: irq.Line, frame: frame.Frame) {
    uart.puts("line ")
    uart.put_dec(line.number().to_usize())
    uart.putc(10)

    uart.puts("frame ")
    uart.put_hex(frame.addr())
    uart.putc(10)

    uart.puts("offset ")
    uart.put_hex(frame.offset(16))
    uart.putc(10)
}
