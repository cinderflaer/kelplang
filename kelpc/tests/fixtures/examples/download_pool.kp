//! download_pool.kp, fetch a list of paths from one host concurrently, with
//! one keep-alive connection pool per worker thread (MK6-S2-M1: the payoff of
//! row 4 on the critical path, once threads existed to spend).
impl "std/thread"
impl "std/http" caps(net = ["*"])
impl "std/str"
impl "std/fmt"
impl "std/process"
impl "std/result"
impl "std/option"
impl "std/pool"

const WORKER_COUNT: usize = 4

// A thread takes only a scalar argument (a collected value is not scanned while a worker holds
// it), so each worker is handed its index and reads its own job from the command line.
datac FetchJob(val host: String, val port: u16, val paths: List<String>)
datac Outcome(val ok: int, val failed: int, val bytes: u64)

fun build_url(host: str, port: u16, path: str) => String {
    val port_str = port.to_u64().toText()
    return "http://${host}:${port_str}${path}"
}

// One worker's whole run: its own pool, one request per path in its own
// share, sequentially, the pool's keep-alive is what makes a sequential loop
// here as cheap as it is, since only the first request per worker pays for a
// handshake.
fun fetch_all(worker: int) => Outcome {
    val job = job_for(worker)
    var pool = http.pool(job.host, job.port)
    var ok: int = 0
    var failed: int = 0
    var bytes: u64 = 0
    for path in job.paths {
        val url = build_url(job.host, job.port, path.as_str())
        val req = http.Request(
            method = "GET",
            url = url,
            headers = http.empty_headers(),
            body = Bytes.empty(),
        )
        val resp = result.expect(pool.send(req), "pool.send: the call failed")
        if resp.isOk() {
            ok += 1
            bytes = bytes + resp.body.len().to_u64()
        } else {
            failed += 1
        }
    }
    return Outcome(ok = ok, failed = failed, bytes = bytes)
}

// The job of one worker, read from the command line: the host, the port and that worker's share.
fun job_for(worker: int) => FetchJob {
    val args = process.args()
    var paths: List<String> = List.empty()
    var i: int = 3
    while i < args.len() {
        paths.push(args.get(i).clone())
        i += 1
    }
    val port = when str.parseU64(args.get(2).as_str()) {
        Ok(v) -> v.to_u16()
        Err(_) -> 0
    }
    return FetchJob(host = args.get(1).clone(), port = port, paths = slice_for(&paths, worker))
}

// Every `worker`th path, starting at `worker`: a round-robin split decided
// entirely from the index, so it costs no coordination between the workers
// that will each get one slice.
fun slice_for(paths: List<String>, worker: int) => List<String> {
    var out: List<String> = List.empty()
    var i: int = worker
    while i < paths.len() {
        out.push(paths.get(i).clone())
        i = i + WORKER_COUNT.to_int()
    }
    return out
}

fun report(label: str, o: &Outcome) {
    var msg = String.empty()
    msg.push_str(label)
    msg.push_str(": ")
    val ok_str = o.ok.to_u64().toText()
    msg.push_str(ok_str)
    msg.push_str(" ok, ")
    val failed_str = o.failed.to_u64().toText()
    msg.push_str(failed_str)
    msg.push_str(" failed, ")
    val bytes_str = o.bytes.toText()
    msg.push_str(bytes_str)
    msg.push_str(" bytes")
    print(msg)
}

fun main() {
    val args = process.args()
    if args.len() < 4 {
        print("usage: download_pool <host> <port> <path>...")
        process.exit(2)
    }
    // The port is checked here; each worker parses its own copy from the command line.
    val port = str.parseU64(args.get(2).as_str()).orExit("bad port").to_u16()

    val w0: int = 0
    val w1: int = 1
    val w2: int = 2
    val w3: int = 3
    val h0 = thread.spawn(fetch_all, w0)
    val h1 = thread.spawn(fetch_all, w1)
    val h2 = thread.spawn(fetch_all, w2)
    val h3 = thread.spawn(fetch_all, w3)

    var total_ok: int = 0
    var total_failed: int = 0
    var total_bytes: u64 = 0

    if let Some(o) = pool.join_or_report<Outcome>(h0) {
        report("worker 0", &o)
        total_ok = total_ok + o.ok
        total_failed = total_failed + o.failed
        total_bytes = total_bytes + o.bytes
    }
    if let Some(o) = pool.join_or_report<Outcome>(h1) {
        report("worker 1", &o)
        total_ok = total_ok + o.ok
        total_failed = total_failed + o.failed
        total_bytes = total_bytes + o.bytes
    }
    if let Some(o) = pool.join_or_report<Outcome>(h2) {
        report("worker 2", &o)
        total_ok = total_ok + o.ok
        total_failed = total_failed + o.failed
        total_bytes = total_bytes + o.bytes
    }
    if let Some(o) = pool.join_or_report<Outcome>(h3) {
        report("worker 3", &o)
        total_ok = total_ok + o.ok
        total_failed = total_failed + o.failed
        total_bytes = total_bytes + o.bytes
    }

    var summary = String.empty()
    summary.push_str("total: ")
    val total_ok_str = total_ok.to_u64().toText()
    summary.push_str(total_ok_str)
    summary.push_str(" ok, ")
    val total_failed_str = total_failed.to_u64().toText()
    summary.push_str(total_failed_str)
    summary.push_str(" failed, ")
    val total_bytes_str = total_bytes.toText()
    summary.push_str(total_bytes_str)
    summary.push_str(" bytes")
    print(summary)

    if total_failed > 0 {
        process.exit(1)
    }
}
