// Kernel stage 23: equality and the `View` surface with no libc behind them.
//
// Two things the freestanding subset could not do before this stage:
//
// * a `datac` with a `String` field. `derive(eq, hash)` writes its `eq` and
//   `hash`, so `==` and a `Map<Pair, i32>` use them. The `String` field is
//   compared through `view()`, and the image needs no hosted `memcmp`.
// * `View.slice`/`View.to_string`. The view accessors were already lowered,
//   but the two `std/str` and `std/regex` are written on had no freestanding
//   body and the type itself was refused. The example slices a `str` view and
//   copies a slice back into an owned `String`.
//
// The regex at the end is the third piece: `std/regex` is pure Kelp over
// `List<u8>`/`List<i32>` and the allocator, and with the two above in place it
// builds and matches with nothing left for `ld.lld` to resolve.
impl "std/str"
impl "std/regex"
impl "std/option"
impl "std/result"
impl "uart" caps(mmio = ["0x10000000+0x100"])

static mut ARENA: [u8; 262144] = [0; 262144]
static mut USED: usize = 0
static mut ALLOCS: usize = 0
static mut DEALLOCS: usize = 0

const PANIC_MSG: [u8; 6] = [112, 97, 110, 105, 99, 10]

// `align` is always a power of two, so the round-up is a divide and multiply:
// v1 has no bitwise operators.
fun align_up(value: usize, align: usize) => usize {
    return ((value + align - 1) / align) * align
}

fun alloc(size: usize, align: usize) => Ptr<u8> {
    val out: Ptr<u8> = unsafe {
        val start: usize = align_up(USED, align)
        if start + size > 262144 {
            Ptr.null()
        } else {
            USED = start + size
            ALLOCS = ALLOCS + 1
            val arena: Ptr<[u8; 262144]> = Ptr.from_mut(ARENA)
            val base: Ptr<u8> = arena.cast<u8>()
            base.byte_offset(start.to_isize())
        }
    }
    return out
}

// The bump allocator frees nothing, so `dealloc` counts only. A null is not an
// allocation, the same rule `free(NULL)` follows, so it is not counted.
fun dealloc(p: Ptr<u8>, _size: usize, _align: usize) {
    unsafe {
        if p.is_null() == false {
            DEALLOCS = DEALLOCS + 1
        }
    }
}

fun realloc(p: Ptr<u8>, old: usize, new: usize, align: usize) => Ptr<u8> {
    val fresh: Ptr<u8> = alloc(new, align)
    if fresh.is_null() { return Ptr.null() }
    if p.is_null() == false {
        var i: int = 0
        while i < old.to_int() {
            unsafe {
                val src: Ptr<u8> = p.byte_offset(i.to_isize())
                val dst: Ptr<u8> = fresh.byte_offset(i.to_isize())
                dst.write(src.read())
            }
            i = i + 1
        }
        dealloc(p, old, align)
    }
    return fresh
}

// A `String` field, so the type is keyable. `derive(eq, hash)` writes the `eq`
// and the `hash` field by field: `==`/`!=` lower to the derived `eq` (H-5), and
// a `Map<Pair, i32>` uses the derived pair.
derive(eq, hash)
datac Pair(val name: String, val id: i32)

// A `Bytes` field, whose equality has to be written by hand: `Bytes` is not a
// `Map` key type, so nothing derives one for it, and the declared `eq` walks
// the two byte slices through the bounds-checked accessor.
datac Blob(val data: Bytes, val tag: i32)

fun Blob.eq(other: &Blob) => bool {
    if self.tag != other.tag || self.data.len() != other.data.len() { return false }
    var i: int = 0
    while i < self.data.len() {
        if self.data.get(i) != other.data.get(i) { return false }
        i = i + 1
    }
    return true
}

fun put_str(text: str) {
    uart.puts(str.ptr(text), str.len(text).to_usize())
}

fun newline() {
    uart.putc(10)
}

fun line(label: str, text: str) {
    put_str(label)
    put_str(text)
    newline()
}

fun copy(text: str) => String {
    return str.concat(text, "")
}

// The derived equality, and the derived key pair behind a `Map<Pair, i32>`.
fun equality_lines() {
    val a = Pair(name = copy("kelp"), id = 7)
    val b = Pair(name = copy("kelp"), id = 7)
    val c = Pair(name = copy("kelv"), id = 8)
    if a == b {
        line(label = "eq same: ", text = "yes")
    }
    if a != c {
        line(label = "eq differ: ", text = "yes")
    }

    var m: Map<Pair, i32> = Map.empty()
    m.insert(a, 1)
    m.insert(c, 2)
    if m.len() == 2 {
        line(label = "map keys: ", text = "2")
    }
    if m.has(b) {
        line(label = "map hit: ", text = "yes")
    }

    val x = Blob(data = Bytes.from_str("kelp"), tag = 1)
    val y = Blob(data = Bytes.from_str("kelp"), tag = 1)
    if x == y {
        line(label = "bytes eq: ", text = "yes")
    }
}

// `View.slice` cuts a `str` view without allocating, and `View.to_string` is
// the one conversion that copies a slice into an owned `String`.
fun view_lines() {
    val text = copy("hello kelp")
    val v = text.view()
    val cut = v.slice(6, 10)
    val word = cut.to_string()
    line(label = "view slice: ", text = word.as_str())
    if v.slice(0, 5).eq("hello".view()) {
        line(label = "view eq: ", text = "yes")
    }
}

// `std/regex`, the whole point of the two pieces above: `Match` and `RegexErr`
// carry a `String`, and the engine reads its input through a `View` and copies
// each match text out with `View.to_string`.
fun regex_lines() {
    val compiled = regex.compile("[a-z]+(\\d+)")
    if let Ok(re) = compiled {
        var rx = re
        val found = rx.find("xx hello42")
        if let Some(m) = found {
            line(label = "regex match: ", text = m.text.as_str())
        }
        val groups = rx.captures("xx hello42")
        if let Some(cc) = groups {
            val first = cc.get(1)
            if let Some(g) = first {
                line(label = "regex group: ", text = g.as_str())
            }
        }
    }
}

section(".text.boot") fun kmain() {
    equality_lines()
    view_lines()
    regex_lines()
    unsafe {
        if ALLOCS == DEALLOCS {
            line(label = "", text = "balanced")
        }
    }
    uart.halt()
}

// The handler `[target] panic` names: every bounds check and the allocator's
// null return call this with the compiler's own message. It prints `panic` and
// loops, because a check that fired has no meaningful continuation.
fun kp_panic(_msg: str) {
    val msg: [u8; 6] = PANIC_MSG
    val bytes: Ptr<[u8; 6]> = Ptr.from_ref(&msg)
    uart.puts(bytes.cast<u8>(), msg.len().to_usize())
    uart.halt()
}
