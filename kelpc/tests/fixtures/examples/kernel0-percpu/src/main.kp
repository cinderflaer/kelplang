//! Kernel stage 8 (MK9-S3-M3): per-CPU storage. `SLOT` is a `percpu static
//! mut`, so the compiler lays out `[target] cpus` copies (two here), each on its
//! own cache line in `.percpu`, and naming it indexes the copy for the CPU whose
//! index is in `tp`.
impl "uart" caps(mmio = ["0x10000000+0x100"])

percpu static mut SLOT: int = 7

fun digit(v: int) => u8 = 48 + v.to_u8()

section(".text.boot") fun kmain() {
    // The register is the kernel's to set: the compiler never writes it.
    unsafe { asm("li tp, 0") }
    unsafe { SLOT = 4 }

    uart.puts("cpu0 ")
    uart.putc(digit(unsafe { SLOT }))
    uart.putc(10)

    // Hand-set the index to 1: naming `SLOT` now reads the other copy, which
    // no code has written.
    unsafe { asm("li tp, 1") }

    uart.puts("cpu1 ")
    uart.putc(digit(unsafe { SLOT }))
    uart.putc(10)

    uart.puts("idx ")
    uart.putc(digit(cpu_index().to_int()))
    uart.putc(10)

    uart.puts("count ")
    uart.putc(digit(cpu_count().to_int()))
    uart.putc(10)

    uart.halt()
}

fun kp_panic(_msg: str) {
    uart.puts("panic\n")
    uart.halt()
}
