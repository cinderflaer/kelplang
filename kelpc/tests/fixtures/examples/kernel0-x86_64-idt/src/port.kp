//! x86 port I/O, the byte form only: `in al, dx` and `out dx, al` are the two
//! instructions the compiler's constraint vocabulary can spell, and it has no
//! fixed-register constraint, so the template parks the port in `dx` and the
//! byte in `al` itself and declares both clobbered. A port is a number, not an
//! address, so nothing here needs an `mmio` grant.

pub fun inb(port: u16) => u8 {
    val v: u8 = unsafe {
        asm(
            "mov dx, {1}\nin al, dx\nmov {0}, al",
            out("r") _,
            in("r") port,
            clobber("ax"),
            clobber("dx")
        )
    }
    return v
}

pub fun outb(port: u16, value: u8) {
    unsafe {
        asm(
            "mov dx, {0}\nmov al, {1}\nout dx, al",
            in("r") port,
            in("r") value,
            clobber("ax"),
            clobber("dx")
        )
    }
}
