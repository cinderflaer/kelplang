//! The COM1 UART QEMU's x86 machine puts at port 0x3F8, plus the integer
//! printing the trap reports need. Poll the Line Status Register at 0x3FD for
//! bit 5 (THR empty) before a byte goes to the Transmit Holding Register at
//! 0x3F8, so the driver never overruns the FIFO.
impl "std/str"
impl "port"

const LSR: u16 = 0x3FD
const THR: u16 = 0x3F8
const THR_EMPTY: u8 = 0x20

pub fun putc(c: u8) {
    while (port.inb(LSR) & THR_EMPTY) == 0 {}
    port.outb(THR, c)
}

pub fun puts(s: str) {
    val n = str.len(s)
    var i: int = 0
    while i < n {
        putc(str.byte(s, i))
        i = i + 1
    }
}

// Decimal, no padding, the shape a vector number and an error code want.
pub fun put_dec(value: int) {
    if value == 0 {
        putc(48)
        return
    }
    var digits: [u8; 20] = [0; 20]
    var n: int = value
    var i: int = 0
    while n > 0 {
        digits.set(i, 48 + (n % 10).to_u8())
        n = n / 10
        i = i + 1
    }
    while i > 0 {
        i = i - 1
        putc(digits.get(i))
    }
}

// Sixteen lowercase hex digits with a `0x` prefix, the shape a `rip` or a `cr2`
// wants: fixed width, so a trap report reads the same whatever address the
// linker chose.
pub fun put_hex(value: u64) {
    puts("0x")
    var shift: u64 = 60
    while true {
        val nib: u8 = ((value >> shift) & 0xF).to_u8()
        if nib < 10 {
            putc(48 + nib)
        } else {
            putc(87 + nib)
        }
        if shift == 0 { return }
        shift = shift - 4
    }
}

// `hlt` has no Kelp spelling, and the compiler's `_start` stub already loops on
// it if the entry returns; this is the same halt written in the language, so
// the kernel names its own stop.
pub fun halt() {
    while true {
        unsafe {
            asm("hlt")
        }
    }
}
