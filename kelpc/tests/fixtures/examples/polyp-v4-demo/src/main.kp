//! The Polyp v4 demo on the hosted headless platform: the deterministic transcript the kernels are
//! compared with. See `app.kp` for the program and `scenario.kp` for the driver.
impl "deps/polyp/backends/soft/soft/headless_platform"
impl "deps/polyp/backends/soft/soft_backend"
impl "deps/v4/app"
impl "deps/v4/scenario"

fun advance(p: mut headless_platform.HeadlessPlatform, ms: u64) {
    p.advance(ms)
}

fun emit_line(line: str) {
    print(line)
}

fun main() {
    var platform = headless_platform.new(width = 320, height = 200)
    var backend = soft_backend.new()
    val final = scenario.drive(backend = backend, platform = platform, advance = advance, emit = emit_line)
    print("-- demo --")
    app.report(final, emit_line)
}
