//! Polyp v3 stage 1's tests, in plain Kelp with no display.
impl "deps/polyp/core/core"
impl "deps/polyp/core/diag"
impl "deps/polyp/backends/headless/headless_backend"
impl "deps/todo/app"
impl "std/env"
impl "std/str"

datac Counts(var create: i32, var update: i32, var remove: i32, var moved: i32)

fun count(patches: List<core.Patch>) => Counts {
    var c = Counts(create = 0, update = 0, remove = 0, moved = 0)
    for item in patches {
        when item {
            Create(_, _, _) -> {
                c.create += 1
            }
            Update(_, _) -> {
                c.update += 1
            }
            Remove(_) -> {
                c.remove += 1
            }
            Move(_, _) -> {
                c.moved += 1
            }
        }
    }
    return c
}

fun show(label: str, old: core.Node<i32>, new: core.Node<i32>) {
    val patches = core.diff(old, new)
    val c = count(patches)
    print(label)
    print(c.create)
    print(c.update)
    print(c.remove)
    print(c.moved)
}

fun rows_reversed() => core.Node<i32> = core.column { k ->
    k.keyed("b") { r -> r.text("two") }
    k.keyed("a") { r -> r.text("one") }
}

fun rows() => core.Node<i32> = core.column { k ->
    k.keyed("a") { r -> r.text("one") }
    k.keyed("b") { r -> r.text("two") }
}

fun rows_with_new() => core.Node<i32> = core.column { k ->
    k.keyed("a") { r -> r.text("one") }
    k.keyed("x") { r -> r.text("inserted") }
    k.keyed("b") { r -> r.text("two") }
}

fun rows_one() => core.Node<i32> = core.column { k ->
    k.keyed("a") { r -> r.text("one") }
}

fun one_text(t: str) => core.Node<i32> {
    val n: core.Node<i32> = core.text(String.from_str(t))
    return n
}

fun empty_column() => core.Node<i32> {
    val out: core.Node<i32> = core.plain_column(List.empty())
    return out
}

fun empty_row() => core.Node<i32> {
    val out: core.Node<i32> = core.plain_row(List.empty())
    return out
}

fun run_diff_tests() {
    // Identical trees: nothing at all.
    show("identical", rows(), rows())
    // A text change: one Update and nothing else.
    show("text", one_text("a"), one_text("b"))
    // A keyed reorder: two Moves, no Create, no Remove, no Update.
    show("reorder", rows(), rows_reversed())
    // An insert: the new keyed row and its Text child, two Creates.
    show("insert", rows(), rows_with_new())
    // A remove: one patch, for the whole subtree.
    show("remove", rows(), rows_one())
    // A kind change: the node is replaced rather than patched.
    show("kind", empty_column(), empty_row())
}

// Keyed rows named by a string each, the first `n` of the five given. The invariant below builds
// its trees from these, so each step is a list of keys in the order the tree holds them.
fun keys(a: str, b: str, c: str, d: str, e: str, n: i32) => List<String> {
    var out: List<String> = List.empty()
    if n >= 1 {
        out.push(String.from_str(a))
    }
    if n >= 2 {
        out.push(String.from_str(b))
    }
    if n >= 3 {
        out.push(String.from_str(c))
    }
    if n >= 4 {
        out.push(String.from_str(d))
    }
    if n >= 5 {
        out.push(String.from_str(e))
    }
    return out
}

fun keyed_rows(names: List<String>) => core.Node<i32> = core.column { k ->
    for item in names {
        val name = item
        k.keyed(name.as_str()) { r -> r.text(name.as_str()) }
    }
}

// The headless tree after the patches of one step must be the tree a fresh backend builds from the
// new view alone. A mismatch stops the program: the invariant is the point of the check.
fun check_same(be: &headless_backend.Headless, tree: &core.Node<i32>, label: str) {
    var fresh = headless_backend.new(script = List.empty())
    val all = core.create_all(tree)
    core.apply_patches(backend = fresh, patches = &all)
    val got = headless_backend.dump(be)
    val want = headless_backend.dump(&fresh)
    if !str.eq(got, want.as_str()) {
        print(got)
        print(want)
        panic("polyp invariant: the patched tree disagrees with the view")
    }
    print("invariant")
    print(label)
    print("ok")
}

// One step of a run: the view changes from `old_names` to `new_names`, the patches are applied to
// the backend, and the tree after them must be the tree the new view builds.
fun step(be: mut headless_backend.Headless, old_names: List<String>, new_names: List<String>, label: str) {
    val old_tree = keyed_rows(old_names)
    val new_tree = keyed_rows(new_names)
    val patches = core.diff(&old_tree, &new_tree)
    core.apply_patches(backend = be, patches = &patches)
    check_same(be, &new_tree, label)
}

// Each run starts from the first list (built by the first patches of a fresh tree) and then takes
// the steps in turn, so a step's patches act on the tree the step before left.
fun run_invariants() {
    // A single swap, a rotation, and the reversal the old pass got wrong (old [a,b,c,d] to new
    // [c,b,d,a] ended [c,d,b,a]).
    val s0 = keys("a", "b", "c", "d", "e", 4)
    val s1 = keys("c", "b", "d", "a", "e", 4)
    val s2 = keys("d", "c", "b", "a", "e", 4)
    val s3 = keys("b", "d", "a", "c", "e", 4)
    // Inserts and removes in the middle of a reorder, then a shrink and a regrow.
    val s4 = keys("e", "c", "x", "b", "d", 5)
    val s5 = keys("x", "d", "a", "e", "e", 2)
    val s6 = keys("a", "b", "c", "d", "e", 5)

    val start = keyed_rows(&s0)
    var be = headless_backend.new(script = List.empty())
    val first = core.create_all(&start)
    core.apply_patches(backend = be, patches = &first)
    check_same(&be, &start, "start")

    step(be, &s0, &s1, "c-b-d-a")
    step(be, &s1, &s2, "d-c-b-a")
    step(be, &s2, &s3, "b-d-a-c")
    step(be, &s3, &s4, "insert-and-move")
    step(be, &s4, &s5, "shrink-to-two")
    step(be, &s5, &s6, "grow-back")
}

// The duplicate-key case, run only when POLYP_TEST=dupkey, because a `panic` ends the process.
fun run_duplicate_key() {
    val a: core.Node<i32> = core.column { k ->
        k.keyed("dup") { r -> r.text("one") }
    }
    val b: core.Node<i32> = core.column { k ->
        k.keyed("dup") { r -> r.text("one") }
        k.keyed("dup") { r -> r.text("two") }
    }
    val patches = core.diff(a, b)
    print(patches.len())
}

// The report's sink: this program prints each line the way `examples/polyp-todo/smoke.sh` reads it.
fun say(line: str) {
    print(line)
}

fun run_headless_todo() {
    var backend = headless_backend.new(script = app.events())
    val final = core.run(
        backend = backend,
        init = app.initial(),
        view = app.view,
        update = app.update,
    )
    // `core.run` leaves the counters behind; the entry texts are `diag`'s snapshot, because a
    // `List<String>` global cannot live in the core (plan/polyp-v3.md, stage 4).
    diag.capture(backend)
    val entry = diag.entry_text(0)
    print("-- todo --")
    app.report(final, entry.as_str(), say)
    print("-- tree --")
    print(headless_backend.dump(backend))
}

fun which() {
    val mode = env.get("POLYP_TEST")
    if str.eq(mode, "dupkey") {
        run_duplicate_key()
        return
    }
    run_diff_tests()
    run_invariants()
    run_headless_todo()
}

fun main() {
    which()
}
