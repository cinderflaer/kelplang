// The trap half of kernel 0: `kmain` installs the vector, takes a machine-mode
// `ecall` (mcause 11), and continues after the handler returns. The `ecall` is
// inline asm in an unsafe block; the handler restores every register it touches,
// so the compiler may keep values live across it with no clobber list.
impl "trap"
impl "uart" caps(mmio = ["0x10000000+0x100"])

const DONE: [u8; 5] = [100, 111, 110, 101, 10]
const PANIC_MSG: [u8; 6] = [112, 97, 110, 105, 99, 10]

section(".text.boot") fun kmain() {
    trap.install()
    unsafe {
        asm("ecall")
    }
    val done: [u8; 5] = DONE
    val bytes: Ptr<[u8; 5]> = Ptr.from_ref(&done)
    uart.puts(bytes.cast<u8>(), done.len().to_usize())
    uart.halt()
}

// The handler `[target] panic` names: every bounds and overflow check the
// compiler emits calls this with the static message the check was written
// with. It prints `panic` and loops, because a check that fired has no
// meaningful continuation.
fun kp_panic(_msg: str) {
    val msg: [u8; 6] = PANIC_MSG
    val bytes: Ptr<[u8; 6]> = Ptr.from_ref(&msg)
    uart.puts(bytes.cast<u8>(), msg.len().to_usize())
    uart.halt()
}
