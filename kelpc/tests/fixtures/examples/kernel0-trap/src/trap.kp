//! The trap vector and the code that installs it. `mtvec` names a naked
//! function (kernel stage 5): it runs with no prologue and no compiler-generated
//! return, because the interrupted code never agreed to a calling convention.
//! Everything the handler disturbs it saves itself, and it ends in `mret`.
impl "uart"

const TRAP_MSG: [u8; 12] = [116, 114, 97, 112, 58, 32, 101, 99, 97, 108, 108, 10]

// The body the naked handler calls. It is ordinary Kelp, so the register save
// around the call is the handler's job, not the callee's.
pub fun report() {
    val msg: [u8; 12] = TRAP_MSG
    val bytes: Ptr<[u8; 12]> = Ptr.from_ref(&msg)
    uart.puts(bytes.cast<u8>(), msg.len().to_usize())
}

// `mtvec`'s low two bits are the vectored mode, so `trap_handler` carries
// `align(4)` and lives in its own section. `install` writes both the vector
// address and, in `mscratch`, the address of the body the handler calls.
pub fun install() {
    unsafe {
        asm("csrw mtvec, {0}", in("r") Ptr.from_fn(trap_handler).addr())
        asm("csrw mscratch, {0}", in("r") Ptr.from_fn(report).addr())
    }
}

section(".text.trap") align(4) naked fun trap_handler() {
    asm("
            csrr t0, mepc
            addi t0, t0, 4
            csrw mepc, t0
            addi sp, sp, -128
            sd ra, 0(sp)
            sd t0, 8(sp)
            sd t1, 16(sp)
            sd t2, 24(sp)
            sd t3, 32(sp)
            sd t4, 40(sp)
            sd t5, 48(sp)
            sd t6, 56(sp)
            sd a0, 64(sp)
            sd a1, 72(sp)
            sd a2, 80(sp)
            sd a3, 88(sp)
            sd a4, 96(sp)
            sd a5, 104(sp)
            sd a6, 112(sp)
            sd a7, 120(sp)
            csrr t0, mscratch
            jalr ra, t0, 0
            ld ra, 0(sp)
            ld t0, 8(sp)
            ld t1, 16(sp)
            ld t2, 24(sp)
            ld t3, 32(sp)
            ld t4, 40(sp)
            ld t5, 48(sp)
            ld t6, 56(sp)
            ld a0, 64(sp)
            ld a1, 72(sp)
            ld a2, 80(sp)
            ld a3, 88(sp)
            ld a4, 96(sp)
            ld a5, 104(sp)
            ld a6, 112(sp)
            ld a7, 120(sp)
            addi sp, sp, 128
            mret
        ")
}
