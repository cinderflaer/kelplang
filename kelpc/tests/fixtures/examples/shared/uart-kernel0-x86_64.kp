//! The COM1 UART QEMU's x86 machine puts at port 0x3F8. The Line Status
//! Register at 0x3FD bit 5 (THR empty) is polled before a byte is written to the
//! Transmit Holding Register at 0x3F8, so the driver never overruns the FIFO.
//! Unlike a memory-mapped device there is no address and no `Ptr`: the byte
//! moves through the `in`/`out` instructions, which is why this module carries
//! the `[unsafe]` listing and the manifest needs no `mmio` grant.
//!
//! Text arrives as a `str`, the same type a hosted program writes, and
//! `str.len`/`str.byte` are the compiler's own byte loops (kernel stage 7,
//! `language/kernel.md` (kelp wiki) gap 1), so no `strlen` and no `[u8; N]` copy sits
//! between the caller and the port.
impl "std/str"

const LSR: u16 = 0x3FD
const THR: u16 = 0x3F8
const THR_EMPTY: u8 = 0x20

// `in al, dx` is the only byte read form, so the port goes to `dx`, the read
// lands in `al`, and `{0}` (a general register the compiler picks) receives it.
fun inb(port: u16) => u8 {
    val v: u8 = unsafe {
        asm(
            "mov dx, {1}\nin al, dx\nmov {0}, al",
            out("r") _,
            in("r") port,
            clobber("ax"),
            clobber("dx")
        )
    }
    return v
}

// `out dx, al` is the only byte write form: the port goes to `dx`, the value to
// `al`, and then out.
fun outb(port: u16, value: u8) {
    unsafe {
        asm(
            "mov dx, {0}\nmov al, {1}\nout dx, al",
            in("r") port,
            in("r") value,
            clobber("ax"),
            clobber("dx")
        )
    }
}

pub fun putc(c: u8) {
    while (inb(LSR) & THR_EMPTY) == 0 {}
    outb(THR, c)
}

pub fun puts(s: str) {
    val n = str.len(s)
    var i: int = 0
    while i < n {
        putc(str.byte(s, i))
        i += 1
    }
}

// `hlt` has no Kelp spelling (kernel stage 5, `language/unsafe.md` (kelp wiki)), and the
// compiler's `_start` stub already loops on it if the entry returns; this is
// the same halt written in the language, so the kernel names its own stop.
pub fun halt() {
    while true {
        unsafe {
            asm("hlt")
        }
    }
}
