// The GTK4 binding Polyp builds its widgets with. Every function is an
// `extern fun` bound to a real symbol by the consumer's coral.toml, whose
// `[extern."deps/polyp/backends/gtk/gtk"]` section is pasted from README.md;
// the header there supplies the C prototypes and `pkg_config = "gtk4"` the
// include and link paths.
//
// GTK spells every `GtkWidget*` as one C type. Kelp's opaque handles are
// nominal, so the shapes the loop actually distinguishes are named after what
// they are and their parent chains say how they relate: a `Window` is a
// `Widget`, a `BoxWidget` is too, and all three are `Object`s, so any of them
// converts up to the base for `g_object_unref`. The ABI is the same pointer
// either way. `gtk_box_new` really returns `GtkWidget*` in the header and is
// declared as the `BoxWidget` it is, which is why `gtk_box_append` takes one
// without a downcast (a `cast` is legal only in the module holding the
// `[extern.*]` section, and the loop is one module up).
pub extern type Object
pub extern type Widget: Object
pub extern type Window: Widget
pub extern type BoxWidget: Widget
pub extern type ScrolledWindow: Widget
pub extern type Viewport: Widget

// `GtkCssProvider` is a `GtkStyleProvider`, and `GdkDisplay` is a GObject; the
// loop only ever holds them as opaque handles and hands them back to GTK, so
// both are named by the role they play. `gtk_css_provider_new` returns
// `GtkWidget*`-shaped pointers at the ABI level either way, which is why the
// return types below can name the concrete handle the way `gtk_box_new` does.
pub extern type Provider: Object
pub extern type Display: Object

// `GMainContext*`, whose null value is the default context.
pub extern type MainContext

pub extern fun gtk_init()
pub extern fun gtk_window_new() => Window
pub extern fun gtk_window_set_title(win: Window, title: str)
pub extern fun gtk_window_set_default_size(win: Window, width: i32, height: i32)
pub extern fun gtk_window_set_child(win: Window, child: Widget)
pub extern fun gtk_window_present(win: Window)
pub extern fun gtk_window_get_focus(win: Window) => Widget

// Setting the focus widget directly. `gtk_widget_grab_focus` on a widget whose
// toplevel is not yet active can be a no-op under a headless server, so the
// focus channel goes through the window instead.
pub extern fun gtk_window_set_focus(win: Window, focus: Widget)

pub extern fun gtk_box_new(orientation: i32, spacing: i32) => BoxWidget
pub extern fun gtk_box_append(box: BoxWidget, child: Widget)
pub extern fun gtk_box_remove(box: BoxWidget, child: Widget)
pub extern fun gtk_box_insert_child_after(box: BoxWidget, child: Widget, sibling: Widget)
pub extern fun gtk_box_reorder_child_after(box: BoxWidget, child: Widget, sibling: Widget)
pub extern fun gtk_box_set_spacing(box: BoxWidget, spacing: i32)

pub extern fun gtk_label_new(text: str) => Widget
pub extern fun gtk_label_set_markup(label: Widget, markup: str)
pub extern fun gtk_button_new_with_label(label: str) => Widget
pub extern fun gtk_button_set_label(button: Widget, label: str)

// A checkbox posts a `Msg` on `toggled`; the application reads the new state
// from its own model, exactly as a button does, so only the active flag is
// ever set from the model side.
pub extern fun gtk_check_button_new_with_label(label: str) => Widget
pub extern fun gtk_check_button_set_label(button: Widget, label: str)
pub extern fun gtk_check_button_set_active(button: Widget, active: i32)

pub extern fun gtk_progress_bar_new() => Widget
pub extern fun gtk_progress_bar_set_fraction(bar: Widget, fraction: f64)

// A separator is oriented: `GTK_ORIENTATION_HORIZONTAL` draws the usual rule
// between stacked rows.
pub extern fun gtk_separator_new(orientation: i32) => Widget

// A scrolled area. Its child is the box the loop patches; the loop never
// replaces the `GtkScrolledWindow` while the model keeps asking for one, which
// is what lets the scroll offset survive a patch.
pub extern fun gtk_scrolled_window_new() => ScrolledWindow
pub extern fun gtk_scrolled_window_set_child(window: ScrolledWindow, child: Widget)
pub extern fun gtk_scrolled_window_get_child(window: ScrolledWindow) => Widget

// Reading the tree back. The backend keeps no widget values: a widget is found from its parent by
// its position among the parent's children, which GTK keeps in the order the tree was built in. These
// three return a child or the null widget, and the window's own child.
pub extern fun gtk_window_get_child(win: Window) => Widget
pub extern fun gtk_widget_get_first_child(widget: Widget) => Widget
pub extern fun gtk_widget_get_next_sibling(widget: Widget) => Widget

// Text input. `gtk_entry_new` returns a `GtkWidget*`; the `GtkEditable`
// set/get pair is the interface on it.
pub extern fun gtk_entry_new() => Widget
pub extern fun gtk_editable_set_text(editable: Widget, text: str)
pub extern fun gtk_editable_get_text(editable: Widget) => str

// A fixed minimum size, used by `Spacer` for its vertical gap.
pub extern fun gtk_widget_set_size_request(widget: Widget, width: i32, height: i32)

// Layout and style: margins, expand, alignment and CSS classes. Every one of
// these is a property of the widget itself, so the loop can set them on an
// existing widget and the change is a patch, not a rebuild.
pub extern fun gtk_widget_set_margin_start(widget: Widget, margin: i32)
pub extern fun gtk_widget_set_margin_end(widget: Widget, margin: i32)
pub extern fun gtk_widget_set_margin_top(widget: Widget, margin: i32)
pub extern fun gtk_widget_set_margin_bottom(widget: Widget, margin: i32)
pub extern fun gtk_widget_set_hexpand(widget: Widget, expand: i32)
pub extern fun gtk_widget_set_vexpand(widget: Widget, expand: i32)
pub extern fun gtk_widget_set_halign(widget: Widget, align: i32)
pub extern fun gtk_widget_set_valign(widget: Widget, align: i32)
pub extern fun gtk_widget_add_css_class(widget: Widget, name: str)
pub extern fun gtk_widget_remove_css_class(widget: Widget, name: str)

// A stylesheet for the whole application, added for the default display. The
// provider is intentionally left alive: it lives as long as the process needs
// the style, and the loader is the only thing that would free it.
pub extern fun gtk_css_provider_new() => Provider
pub extern fun gtk_css_provider_load_from_string(provider: Provider, text: str)
pub extern fun gdk_display_get_default() => Display
pub extern fun gtk_style_context_add_provider_for_display(display: Display, provider: Provider, priority: u32)

// Focus. The loop tracks the toplevel's focus widget by handle and asks
// whether it is inside an entry with `gtk_widget_is_ancestor`; `gtk_widget_is_focus`
// would say no, because GTK points the toplevel at the entry's inner text
// widget rather than at the entry itself.
pub extern fun gtk_widget_is_ancestor(widget: Widget, ancestor: Widget) => i32

// `g_object_unref` takes a `gpointer`, so the one binding takes the base
// `Object` and every widget converts up to it.
pub extern fun g_object_unref(obj: Object)

// `g_main_context_iteration(context, may_block)`: a null `GMainContext*` means
// the default context, and `null_main_context` is how this module spells that
// null handle (`MainContext.null()` is legal only here, where the extern
// section is).
pub extern fun g_main_context_iteration(context: MainContext, may_block: i32) => i32
pub fun null_main_context() => MainContext = MainContext.null()

// `g_signal_connect_data(instance, signal, c_handler, data, destroy, flags)`.
// The closure parameter expands in place into `(c_handler, data, destroy)`,
// which is GLib's own order, so the Kelp signature is the C one with those
// three collapsed into one. The generated call is cast to the expansion's
// types, so `GCallback` and `GClosureNotify` need no cast written here.
//
// Two bindings because the handler's return is part of the closure's type:
// `clicked` wants a `unit` handler, `close-request` a `gboolean`. Both reach
// the same C symbol.
pub extern fun connect(instance: Widget, signal: str, handler: move closure(Widget), flags: i32) => u64
pub extern fun connect_ret(instance: Widget, signal: str, handler: move closure(Window) => i32, flags: i32) => u64

// Blocking a handler by the id `connect` returned is how a patch writes a
// widget's state without that write coming back as a signal. GLib takes the
// instance as a `gpointer`, so the one binding takes the `Widget`.
pub extern fun g_signal_handler_block(instance: Widget, handler_id: u64)
pub extern fun g_signal_handler_unblock(instance: Widget, handler_id: u64)

// `g_timeout_add_full(priority, interval, function, data, notify)`: the closure
// expands into `(function, data, notify)` and the declaration has no argument
// after it. The handler returns `G_SOURCE_REMOVE` (0) to fire once.
pub extern fun g_timeout_add_full(priority: i32, interval: u32, handler: move closure() => i32) => u32

// The three things the loop needs that only this module may write: a null
// handle to start a sibling chain with, the null test, and the downcasts from
// the `Widget` the tree stores to the concrete shapes the box and scrolled
// calls want. Each is a `pub fun` here because `null()`/`is_null()`/`cast` are
// legal only under an `[extern.*]` section.
pub fun null_widget() => Widget = Widget.null()
pub fun is_null_widget(widget: Widget) => bool = widget.is_null()
pub fun as_box(widget: Widget) => BoxWidget = BoxWidget.cast(widget)
pub fun as_scrolled(widget: Widget) => ScrolledWindow = ScrolledWindow.cast(widget)

// GTK wraps a child that cannot scroll itself (a box, say) in a `GtkViewport` when it is set on a
// scrolled area, so the child the scrolled area reports is that viewport, and the box the loop
// patches is the viewport's child. The type is checked first: a child that is not a viewport is
// returned as it is.
pub extern fun gtk_viewport_get_type() => u64
pub extern fun gtk_viewport_get_child(viewport: Viewport) => Widget
pub extern fun g_type_check_instance_is_a(instance: Widget, iface_type: u64) => i32

pub fun as_viewport(widget: Widget) => Viewport = Viewport.cast(widget)
pub fun is_viewport(widget: Widget) => bool = g_type_check_instance_is_a(widget, gtk_viewport_get_type()) != 0
pub fun viewport_child(widget: Viewport) => Widget = gtk_viewport_get_child(widget)

// The box a scrolled area holds its children in: the child the loop set on it, unwrapped from the
// viewport GTK put around it.
pub fun scrolled_child(widget: Widget) => Widget {
    val inner = gtk_scrolled_window_get_child(as_scrolled(widget))
    if !is_null_widget(inner) && is_viewport(inner) { return viewport_child(as_viewport(inner)) }
    return inner
}

// The `index`-th child of a container in GTK's own order, or the null widget when there is no such
// child (or no container). A walk of the sibling chain, so it costs a step per child before it.
pub fun nth_child(parent: Widget, index: int) => Widget {
    if parent.is_null() { return Widget.null() }
    var w: Widget = gtk_widget_get_first_child(parent)
    var i: int = 0
    while i < index {
        if w.is_null() { return w }
        w = gtk_widget_get_next_sibling(w)
        i += 1
    }
    return w
}
