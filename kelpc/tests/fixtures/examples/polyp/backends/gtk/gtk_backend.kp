// Polyp's GTK4 backend: the core's patch list applied to a live GTK widget tree.
//
// This is v2's widget code moved behind the `core.Backend` interface. It holds the widgets, the
// real signal handlers and the counters; it never sees a `Node`, only the `Props` a patch carries,
// so the loop above it has no idea a display is involved at all. `gtk.kp` is the binding and
// `queue.kp` the message ring the signal handlers post into.
//
// A widget handle is never stored. A hosted build refuses a resource value inside a `List`, so the
// tree keeps only scalars: a node's kind, handler, interactive id, key, classes and children. A
// node's widget is found by the scalar that names it, its index among its parent's children, which
// GTK keeps in the order the tree was built in. Every handle is a local, read from the live tree
// when a patch needs it.
impl "deps/polyp/core/core"
impl "deps/polyp/backends/gtk/gtk"
impl "deps/polyp/backends/gtk/queue"
impl "std/fmt"
impl "std/option"
impl "std/str"

// `GTK_ORIENTATION_HORIZONTAL` and `..._VERTICAL`, spelled as the numbers they are for the same
// reason every other GTK value here is: a C `enum` crossing as an `i32` is the ABI, and a Kelp
// `enum` would be a different layout.
pub const HORIZONTAL: i32 = 0
pub const VERTICAL: i32 = 1

// `GtkAlign`, which is what `props.align` has to become on the way into a GTK call. The core's
// codes are its own order, so this is the one place the two numberings meet.
const GTK_ALIGN_FILL: i32 = 0
const GTK_ALIGN_START: i32 = 1
const GTK_ALIGN_END: i32 = 2
const GTK_ALIGN_CENTER: i32 = 3

// `G_PRIORITY_DEFAULT` and `GTK_STYLE_PROVIDER_PRIORITY_APPLICATION`.
const PRIORITY_DEFAULT: i32 = 0
const PRIORITY_APP: u32 = 600

// What the loop tests a polled id against. `polyp_poll` answers -1 for an empty queue, so the quit
// id has to be some *other* negative number: slot ids start at 0 and only grow.
pub const QUIT_ID: i32 = -2

// One live node: what it is, its handler id so a programmatic write can be signal-blocked, its
// interactive id (-1 when it cannot post), its key, the CSS classes currently on it, and its
// children. The widget itself is not here; it is the child at this node's position in its parent.
pub datac Mount(
    var kind: i32,
    var handler: u64,
    var slot: i32,
    var key: Box<core.Key>,
    var kids: List<Mount>,
    var classes: List<String>,
)

pub datac GtkBackend(
    var win: gtk.Window,
    var root: List<Mount>,
    var next_slot: i32,
    var created: i32,
    var updated: i32,
    var removed: i32,
    var entry_builds: i32,
    // The widget the window had focused when this frame's patch list started. A focused entry is
    // the one being edited, so a patch leaves its text alone.
    var focus_before: gtk.Widget,
)

pub fun open(title: str, width: i32, height: i32) => GtkBackend {
    gtk.gtk_init()
    val win = gtk.gtk_window_new()
    gtk.gtk_window_set_title(win, title)
    gtk.gtk_window_set_default_size(win, width, height)
    gtk.connect_ret(win, "close-request", close_handler(), 0)
    gtk.gtk_window_present(win)
    return GtkBackend(
        win = win,
        root = List.empty(),
        next_slot = 0,
        created = 0,
        updated = 0,
        removed = 0,
        entry_builds = 0,
        focus_before = gtk.null_widget(),
    )
}

// The loop's unref on the way out, after `core.run` has returned.
pub fun close(be: mut GtkBackend) {
    gtk.g_object_unref(be.win)
}

// Pango markup for a label. Text is escaped first, so a `&` or `<` in the app's string is shown,
// not parsed; the optional tags wrap the escaped text.
fun label_markup(text: str, size: i32, bold: bool) => String {
    val amp = str.replace(text, "&", "&amp;")
    val lt = str.replace(amp, "<", "&lt;")
    var out = str.replace(lt, ">", "&gt;")
    if size > 0 {
        val pts = fmt.int(size.to_i64())
        val head = str.concat("<span size=\"", pts.as_str())
        val open = str.concat(head, "\">")
        val opened = str.concat(open, out.as_str())
        out = str.concat(opened, "</span>")
    }
    if bold {
        val opened = str.concat("<b>", out.as_str())
        out = str.concat(opened, "</b>")
    }
    return out
}

fun bool_i32(b: bool) => i32 = if b { 1 } else { 0 }

fun no_classes() => List<String> = List.empty()

fun gtk_align(align: i32) => i32 {
    if align == core.ALIGN_START { return GTK_ALIGN_START }
    if align == core.ALIGN_CENTER { return GTK_ALIGN_CENTER }
    if align == core.ALIGN_END { return GTK_ALIGN_END }
    return GTK_ALIGN_FILL
}

// The handler a button, checkbox or entry gets: a closure whose whole environment is the slot id.
// The native side runs it on the loop's own thread, so `polyp_post` is an ordinary store.
fun post_handler(id: i32) => closure(gtk.Widget) {
    return fun (w: gtk.Widget) {
        queue.polyp_post(id)
    }
}

// The handler a `g_timeout_add_full` source gets. It posts once and returns `G_SOURCE_REMOVE`, so
// the source is destroyed after it fires.
fun timeout_handler(id: i32) => closure() => i32 {
    return fun () => i32 {
        queue.polyp_post(id)
        return 0
    }
}

fun set_entry_handler(index: i32, new_text: move String) => closure() => i32 {
    return fun () => i32 {
        queue.polyp_post_edit(index, new_text.as_str())
        return 0
    }
}

fun focus_entry_handler(index: i32) => closure() => i32 {
    return fun () => i32 {
        queue.polyp_post_focus(index)
        return 0
    }
}

// TRUE: the default handler would destroy the window, and the loop still owns the unref it does on
// the way out.
fun close_handler() => closure(gtk.Window) => i32 {
    return fun (w: gtk.Window) => i32 {
        queue.polyp_post(QUIT_ID)
        return 1
    }
}

// Drives a program with no user: the event `core.run` will see, armed for `delay_ms` from now.
pub fun schedule(delay_ms: u32, event: core.Event) {
    when event {
        Post(id) -> {
            val source = gtk.g_timeout_add_full(PRIORITY_DEFAULT, delay_ms, timeout_handler(id))
        }
        Edit(index, text) -> {
            val source = gtk.g_timeout_add_full(PRIORITY_DEFAULT, delay_ms, set_entry_handler(index, String.from_str(text.as_str())))
        }
        Focus(index) -> {
            val source = gtk.g_timeout_add_full(PRIORITY_DEFAULT, delay_ms, focus_entry_handler(index))
        }
        Quit -> {
            val source = gtk.g_timeout_add_full(PRIORITY_DEFAULT, delay_ms, timeout_handler(QUIT_ID))
        }
        Idle -> {}
    }
}

// An application stylesheet. `gtk_init` is idempotent, so calling this before `run` is fine; the
// provider stays alive for the process and styles every widget that carries a matching class.
pub fun css(text: str) {
    gtk.gtk_init()
    val provider = gtk.gtk_css_provider_new()
    gtk.gtk_css_provider_load_from_string(provider, text)
    gtk.gtk_style_context_add_provider_for_display(gtk.gdk_display_get_default(), provider, PRIORITY_APP)
}

fun key_of_path(path: &core.Path) => core.Key {
    if path.segs.is_empty() { return core.Key.None }
    return when path.segs.get(path.segs.len() - 1) {
        Index(_) -> core.Key.None
        Keyed(_, key) -> core.clone_key(key.get())
    }
}

// The box a node's children live in, given the node's own widget: a scrolled area's child box, or
// the widget itself.
fun box_of(w: gtk.Widget, rec: &Mount) => gtk.Widget {
    if rec.kind == core.KIND_SCROLLED { return gtk.scrolled_child(w) }
    return w
}

fun kid_index(kids: List<Mount>, seg: &core.Seg) => i32 {
    var i: int = 0
    while i < kids.len() {
        if core.child_at(seg, kids.get(i).key.get(), i) { return i.to_i32() }
        i += 1
    }
    return -1
}

fun count_nodes(node: &Mount) => i32 {
    var n: i32 = 1
    for item in node.kids {
        n += count_nodes(item)
    }
    return n
}

// The widget a new child goes after so that it lands at position `index`: the child at `index - 1`
// in GTK's order, or the null widget, which GTK reads as "at the front". Appending (`index` equal to
// the child count) goes after the last child.
fun after_index(box: gtk.Widget, index: i32) => gtk.Widget {
    if index <= 0 { return gtk.null_widget() }
    return gtk.nth_child(box, (index - 1).to_int())
}

// The widget a moved child goes after, when it is moved to position `at` of the list it has been
// taken out of. `moved` is the child's position before it was taken out, so the list's index `at - 1`
// is GTK's index `at - 1` when it comes before `moved`, and `at` when it comes after.
fun move_after(box: gtk.Widget, moved: i32, at: i32) => gtk.Widget {
    if at <= 0 { return gtk.null_widget() }
    var g = at - 1
    if g >= moved {
        g += 1
    }
    return gtk.nth_child(box, g.to_int())
}

fun copy_strings(xs: List<String>) => List<String> {
    var out: List<String> = List.empty()
    for item in xs {
        out.push(String.from_str(item.as_str()))
    }
    return out
}

fun text_widget(props: &core.Props) => gtk.Widget {
    val w = gtk.gtk_label_new("")
    val markup = label_markup(props.text, props.size, props.bold)
    gtk.gtk_label_set_markup(w, markup.as_str())
    return w
}

fun spacer_widget(height: i32) => gtk.Widget {
    val w = gtk.gtk_box_new(VERTICAL, 0)
    gtk.gtk_widget_set_size_request(w, -1, height)
    return w
}

fun checkbox_widget(props: &core.Props) => gtk.Widget {
    val w = gtk.gtk_check_button_new_with_label(props.label)
    gtk.gtk_check_button_set_active(w, bool_i32(props.checked))
    return w
}

// The core carries a progress fraction as an integer permille, so the one display that wants an
// `f64` converts it here. Hosted float arithmetic: no bare-metal build emits this module.
fun fraction_of(permille: i32) => f64 = permille.to_f64() / 1000.0

fun progress_widget(props: &core.Props) => gtk.Widget {
    val w = gtk.gtk_progress_bar_new()
    gtk.gtk_progress_bar_set_fraction(w, fraction_of(props.permille))
    return w
}

// The layout and style options of a widget, applied by both create and patch, so a fresh widget and
// a matched one are told the same things.
fun apply_opts(w: gtk.Widget, props: &core.Props) {
    if props.margin >= 0 {
        gtk.gtk_widget_set_margin_start(w, props.margin)
        gtk.gtk_widget_set_margin_end(w, props.margin)
        gtk.gtk_widget_set_margin_top(w, props.margin)
        gtk.gtk_widget_set_margin_bottom(w, props.margin)
    }
    gtk.gtk_widget_set_hexpand(w, bool_i32(props.expand))
    gtk.gtk_widget_set_vexpand(w, bool_i32(props.expand))
    if props.align >= 0 {
        gtk.gtk_widget_set_halign(w, gtk_align(props.align))
        gtk.gtk_widget_set_valign(w, gtk_align(props.align))
    }
}

// The classes currently on the widget off, the wanted ones on. GTK dedups an add, so a class in
// both lists is only a remove-then-add.
fun apply_classes(w: gtk.Widget, old: List<String>, new: List<String>) {
    for item in old {
        gtk.gtk_widget_remove_css_class(w, item.as_str())
    }
    for item in new {
        gtk.gtk_widget_add_css_class(w, item.as_str())
    }
}

// The freshly built widget for a node. Its interactive id and handler are written into `rec`, and
// the widget is returned to the caller, which places it in the tree. A container's children arrive as
// their own patches, so this builds one widget and nothing below it.
fun make_widget(be: mut GtkBackend, kind: i32, props: &core.Props, rec: mut Mount) => gtk.Widget {
    var slot: i32 = -1
    var handler: u64 = 0
    var w: gtk.Widget = gtk.null_widget()
    if kind == core.KIND_COLUMN {
        w = gtk.gtk_box_new(VERTICAL, props.spacing)
    } else if kind == core.KIND_ROW {
        w = gtk.gtk_box_new(HORIZONTAL, props.spacing)
    } else if kind == core.KIND_TEXT {
        w = text_widget(props)
    } else if kind == core.KIND_SPACER {
        w = spacer_widget(props.height)
    } else if kind == core.KIND_ENTRY {
        w = gtk.gtk_entry_new()
        slot = be.next_slot
        be.next_slot += 1
        handler = gtk.connect(w, "changed", post_handler(slot), 0)
        gtk.gtk_editable_set_text(w, props.text.as_str())
        be.entry_builds += 1
    } else if kind == core.KIND_BUTTON {
        w = gtk.gtk_button_new_with_label(props.label)
        slot = be.next_slot
        be.next_slot += 1
        handler = gtk.connect(w, "clicked", post_handler(slot), 0)
    } else if kind == core.KIND_CHECKBOX {
        w = checkbox_widget(props)
        slot = be.next_slot
        be.next_slot += 1
        handler = gtk.connect(w, "toggled", post_handler(slot), 0)
    } else if kind == core.KIND_PROGRESS {
        w = progress_widget(props)
    } else if kind == core.KIND_SEPARATOR {
        w = gtk.gtk_separator_new(HORIZONTAL)
    } else if kind == core.KIND_SCROLLED {
        // A scrolled area. Its child is the implicit box the loop patches, so the scroll offset
        // survives: the area itself is only replaced when the model stops asking for one.
        val sw = gtk.gtk_scrolled_window_new()
        val b = gtk.gtk_box_new(VERTICAL, props.spacing)
        gtk.gtk_scrolled_window_set_child(sw, b)
        w = sw
    }
    apply_opts(w, props)
    val none = no_classes()
    apply_classes(w, none, props.classes)
    rec.slot = slot
    rec.handler = handler
    return w
}

// A matched widget, told the new properties in place. `kind` is known to agree, so only the
// properties that can change are written.
fun apply_props_to(rec: mut Mount, w: gtk.Widget, props: &core.Props, focus: gtk.Widget) {
    // Every write below goes to `w`, and so does the signal block and unblock: a null widget here
    // means the mount and GTK disagree, which is a bug, so it stops the program rather than writing
    // into nothing (GTK would only print a critical and carry on).
    if gtk.is_null_widget(w) {
        panic("polyp gtk: a patch found no widget for a mounted node")
    }
    if rec.kind == core.KIND_COLUMN {
        gtk.gtk_box_set_spacing(gtk.as_box(w), props.spacing)
    } else if rec.kind == core.KIND_ROW {
        gtk.gtk_box_set_spacing(gtk.as_box(w), props.spacing)
    } else if rec.kind == core.KIND_TEXT {
        val markup = label_markup(props.text, props.size, props.bold)
        gtk.gtk_label_set_markup(w, markup.as_str())
    } else if rec.kind == core.KIND_SPACER {
        gtk.gtk_widget_set_size_request(w, -1, props.height)
    } else if rec.kind == core.KIND_ENTRY {
        val current = gtk.gtk_editable_get_text(w)
        // The focused entry is the one being edited: writing the model's text back into it would
        // fight the user's cursor, so a patch leaves it alone until it is not the focus widget. The
        // write is signal-blocked so it is not fed back as a `changed` message.
        if !str.eq(current, props.text.as_str()) && gtk.gtk_widget_is_ancestor(focus, w) == 0 {
            gtk.g_signal_handler_block(w, rec.handler)
            gtk.gtk_editable_set_text(w, props.text.as_str())
            gtk.g_signal_handler_unblock(w, rec.handler)
        }
    } else if rec.kind == core.KIND_BUTTON {
        gtk.gtk_button_set_label(w, props.label.as_str())
    } else if rec.kind == core.KIND_CHECKBOX {
        gtk.gtk_check_button_set_label(w, props.label.as_str())
        gtk.g_signal_handler_block(w, rec.handler)
        gtk.gtk_check_button_set_active(w, bool_i32(props.checked))
        gtk.g_signal_handler_unblock(w, rec.handler)
    } else if rec.kind == core.KIND_PROGRESS {
        gtk.gtk_progress_bar_set_fraction(w, fraction_of(props.permille))
    } else if rec.kind == core.KIND_SCROLLED {
        gtk.gtk_box_set_spacing(gtk.as_box(gtk.scrolled_child(w)), props.spacing)
    }
    apply_opts(w, props)
    apply_classes(w, rec.classes, props.classes)
    rec.classes = copy_strings(props.classes)
}

// The writes are remove, recurse, insert back, so a write through a `mut` borrow never has to move
// a field out of the value it is written through. `box` is the container the sibling list `kids`
// sits in, and `depth` is how far into `path` that list sits.
fun insert_into(kids: mut List<Mount>, path: &core.Path, depth: int, at: i32, node: move Mount, node_w: gtk.Widget, box: gtk.Widget) {
    if depth + 1 == path.segs.len() {
        if gtk.is_null_widget(box) {
            panic("polyp gtk: an insert found no container for a new child")
        }
        var i = at
        if i < 0 {
            i = 0
        }
        if i > kids.len().to_i32() {
            i = kids.len().to_i32()
        }
        gtk.gtk_box_insert_child_after(gtk.as_box(box), node_w, after_index(box, i))
        kids.insert(i.to_int(), node)
        return
    }
    val found = kid_index(kids, path.segs.get(depth))
    if found < 0 {
        panic("polyp gtk: an insert named a child the mount does not have")
    }
    val idx = found.to_int()
    var child = kids.remove(idx)
    val child_w = gtk.nth_child(box, idx)
    val inner_box = box_of(child_w, child)
    insert_into(child.kids, path, depth + 1, at, node, node_w, inner_box)
    kids.insert(idx, child)
}

fun patch_into(kids: mut List<Mount>, path: &core.Path, depth: int, props: &core.Props, focus: gtk.Widget, box: gtk.Widget, n: mut i32) {
    val found = kid_index(kids, path.segs.get(depth))
    if found < 0 {
        panic("polyp gtk: a patch named a child the mount does not have")
    }
    val idx = found.to_int()
    var child = kids.remove(idx)
    val child_w = gtk.nth_child(box, idx)
    if depth + 1 == path.segs.len() {
        *n += 1
        apply_props_to(child, child_w, props, focus)
        kids.insert(idx, child)
        return
    }
    val inner_box = box_of(child_w, child)
    patch_into(child.kids, path, depth + 1, props, focus, inner_box, n)
    kids.insert(idx, child)
}

datac Gone(var count: i32)

// The list passed in is the children of the node one level up, so the box to detach from is the one
// the caller descended with.
fun drop_into(kids: mut List<Mount>, path: &core.Path, depth: int, box: gtk.Widget, gone: mut Gone) {
    val idx = kid_index(kids, path.segs.get(depth))
    if idx < 0 {
        panic("polyp gtk: a remove named a child the mount does not have")
    }
    var child = kids.remove(idx.to_int())
    val child_w = gtk.nth_child(box, idx.to_int())
    if depth + 1 == path.segs.len() {
        if gtk.is_null_widget(child_w) || gtk.is_null_widget(box) {
            panic("polyp gtk: a remove found no widget for a mounted node")
        }
        gone.count += count_nodes(child)
        gtk.gtk_box_remove(gtk.as_box(box), child_w)
        return
    }
    val inner_box = box_of(child_w, child)
    drop_into(child.kids, path, depth + 1, inner_box, gone)
    kids.insert(idx.to_int(), child)
}

fun move_into(kids: mut List<Mount>, path: &core.Path, depth: int, to_index: i32, box: gtk.Widget) {
    val idx = kid_index(kids, path.segs.get(depth))
    if idx < 0 {
        panic("polyp gtk: a move named a child the mount does not have")
    }
    var child = kids.remove(idx.to_int())
    val child_w = gtk.nth_child(box, idx.to_int())
    if depth + 1 == path.segs.len() {
        if gtk.is_null_widget(child_w) || gtk.is_null_widget(box) {
            panic("polyp gtk: a move found no widget for a mounted node")
        }
        var at = to_index
        if at < 0 {
            at = 0
        }
        if at > kids.len().to_i32() {
            at = kids.len().to_i32()
        }
        gtk.gtk_box_reorder_child_after(gtk.as_box(box), child_w, move_after(box, idx, at))
        kids.insert(at.to_int(), child)
        return
    }
    val inner_box = box_of(child_w, child)
    move_into(child.kids, path, depth + 1, to_index, inner_box)
    kids.insert(idx.to_int(), child)
}

fun collect_entries(kids: List<Mount>, out: mut List<i32>) {
    var i: int = 0
    while i < kids.len() {
        val n = kids.get(i)
        if n.kind == core.KIND_ENTRY && n.slot >= 0 {
            out.push(n.slot)
        }
        collect_entries(n.kids, out)
        i += 1
    }
}

fun find_path(kids: List<Mount>, base: &core.Path, id: i32) => option.Option<core.Path> {
    var i: int = 0
    while i < kids.len() {
        val n = kids.get(i)
        val here = core.with_seg(base, core.seg_for(n.key.get(), i.to_i32()))
        if n.slot == id { return option.Option.Some(value = here) }
        when find_path(n.kids, here, id) {
            Some(found) -> {
                return option.Option.Some(value = found)
            }
            None -> {}
        }
        i += 1
    }
    return option.Option.None
}

// The widget of the node whose interactive id is `id`, searched from the children of `box`, or the
// null widget when no live node has that id.
fun slot_widget_in(kids: List<Mount>, box: gtk.Widget, id: i32) => gtk.Widget {
    var i: int = 0
    while i < kids.len() {
        val n = kids.get(i)
        val w = gtk.nth_child(box, i)
        if n.slot == id { return w }
        val found = slot_widget_in(n.kids, box_of(w, n), id)
        if !gtk.is_null_widget(found) { return found }
        i += 1
    }
    return gtk.null_widget()
}

// The interactive id of the node whose widget is an ancestor of `focused` (or is `focused`), searched
// from the children of `box`. A focused entry's text widget is inside the entry, so the test is
// ancestry, not identity.
fun focus_in(kids: List<Mount>, box: gtk.Widget, focused: gtk.Widget) => option.Option<i32> {
    var i: int = 0
    while i < kids.len() {
        val n = kids.get(i)
        val w = gtk.nth_child(box, i)
        if n.slot >= 0 && gtk.gtk_widget_is_ancestor(focused, w) != 0 {
            return option.Option.Some(value = n.slot)
        }
        when focus_in(n.kids, box_of(w, n), focused) {
            Some(found) -> {
                return option.Option.Some(value = found)
            }
            None -> {}
        }
        i += 1
    }
    return option.Option.None
}

fun widget_of(be: &GtkBackend, id: i32) => gtk.Widget {
    if id < 0 || be.root.is_empty() { return gtk.null_widget() }
    val top = be.root.get(0)
    val top_w = gtk.gtk_window_get_child(be.win)
    if top.slot == id { return top_w }
    return slot_widget_in(top.kids, box_of(top_w, top), id)
}

impl core.Backend for GtkBackend {
    fun mut Self.apply(patches: List<core.Patch>) {
        // The focus a patch must not fight is the one the window had before the patch list.
        focus_before = gtk.gtk_window_get_focus(win)
        core.apply_patches(backend = self, patches = patches)
    }

    fun mut Self.make(path: &core.Path, at: i32, kind: i32, props: &core.Props) {
        var rec = Mount(
            kind = kind,
            handler = 0,
            slot = -1,
            key = Box.of(core.Key.None),
            kids = List.empty(),
            classes = copy_strings(props.classes),
        )
        rec.key.set(key_of_path(path))
        val w = make_widget(self, kind, props, rec)
        if path.segs.is_empty() {
            gtk.gtk_window_set_child(win, w)
            root.clear()
            root.push(rec)
        } else {
            var top = root.remove(0)
            val top_box = box_of(gtk.gtk_window_get_child(win), top)
            insert_into(top.kids, path, 0, at, rec, w, top_box)
            root.insert(0, top)
        }
        created += 1
    }

    fun mut Self.patch_widget(path: &core.Path, props: &core.Props) {
        var n: i32 = 0
        val focused = focus_before
        if path.segs.is_empty() {
            if !root.is_empty() {
                var top = root.remove(0)
                apply_props_to(top, gtk.gtk_window_get_child(win), props, focused)
                root.insert(0, top)
                n = 1
            }
        } else {
            var top = root.remove(0)
            val top_box = box_of(gtk.gtk_window_get_child(win), top)
            patch_into(top.kids, path, 0, props, focused, top_box, n)
            root.insert(0, top)
        }
        updated += n
    }

    fun mut Self.drop_widget(path: &core.Path) {
        if path.segs.is_empty() {
            for item in root {
                removed += count_nodes(item)
            }
            root.clear()
            gtk.gtk_window_set_child(win, gtk.null_widget())
            focus_before = gtk.gtk_window_get_focus(win)
            return
        }
        var gone = Gone(count = 0)
        var top = root.remove(0)
        val top_box = box_of(gtk.gtk_window_get_child(win), top)
        drop_into(top.kids, path, 0, top_box, gone)
        root.insert(0, top)
        removed += gone.count
        // A removed widget may have been the focus: the focus read at the start of the patch list
        // can now be a widget GTK has destroyed, so it is read again for the patches that follow.
        focus_before = gtk.gtk_window_get_focus(win)
    }

    fun mut Self.place_widget(path: &core.Path, to_index: i32) {
        if path.segs.is_empty() { return }
        var top = root.remove(0)
        val top_box = box_of(gtk.gtk_window_get_child(win), top)
        move_into(top.kids, path, 0, to_index, top_box)
        root.insert(0, top)
    }

    fun mut Self.pump() {
        // A blocking iteration: it returns when a source fired, and the loop's drain turns whatever
        // that posted into updates.
        gtk.g_main_context_iteration(gtk.null_main_context(), 1)
    }

    fun mut Self.poll() => core.Event {
        val edit = queue.polyp_poll_edit()
        if edit >= 0 { return core.Event.Edit(index = edit, text = queue.polyp_poll_edit_text()) }
        val focus = queue.polyp_poll_focus()
        if focus >= 0 { return core.Event.Focus(index = focus) }
        val id = queue.polyp_poll()
        if id == QUIT_ID { return core.Event.Quit }
        if id >= 0 { return core.Event.Post(id = id) }
        return core.Event.Idle
    }

    fun Self.path_of(id: i32) => option.Option<core.Path> {
        if root.is_empty() { return option.Option.None }
        if root.get(0).slot == id {
            val none = core.Path(segs = List.empty())
            return option.Option.Some(value = none)
        }
        val base = core.Path(segs = List.empty())
        return find_path(root.get(0).kids, base, id)
    }

    fun Self.focus() => option.Option<i32> {
        val focused = gtk.gtk_window_get_focus(win)
        if gtk.is_null_widget(focused) { return option.Option.None }
        if root.is_empty() { return option.Option.None }
        val top = root.get(0)
        val top_w = gtk.gtk_window_get_child(win)
        if top.slot >= 0 && gtk.gtk_widget_is_ancestor(focused, top_w) != 0 {
            return option.Option.Some(value = top.slot)
        }
        return focus_in(top.kids, box_of(top_w, top), focused)
    }

    fun mut Self.set_focus(id: i32) {
        gtk.gtk_window_set_focus(win, widget_of(self, id))
    }

    fun mut Self.set_entry_text(id: i32, text: str) {
        // Writing the entry fires its real `changed` signal, which is the message the loop reads.
        gtk.gtk_editable_set_text(widget_of(self, id), text)
    }

    fun Self.entry_text(id: i32) => String {
        val w = widget_of(self, id)
        if gtk.is_null_widget(w) { return "" }
        return String.from_str(gtk.gtk_editable_get_text(w))
    }

    fun Self.entry_ids() => List<i32> {
        var out: List<i32> = List.empty()
        collect_entries(root, out)
        return out
    }

    fun Self.entries_built() => i32 = entry_builds

    fun Self.stats() => core.Stats = core.Stats(created = created, updated = updated, removed = removed, live = created - removed, memo_hits = 0, memo_misses = 0, view_calls = 0)
}
