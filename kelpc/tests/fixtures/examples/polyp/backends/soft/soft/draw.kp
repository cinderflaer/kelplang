// The drawing primitives (Polyp v3 stage 2).
//
// Every function here clips to `clip.top() ∩ fb.bounds()` before it touches a pixel, and
// returns the number of pixels it wrote, so stage 5 can assert a frame's cost against a budget.
// Nothing allocates: scratch is a stack array in the one function that needs one
// (`blit_mask8`'s caller, `font.draw_glyph`), and everything else is integer arithmetic over
// the `Rect`/`Fb` values `fb.kp` exposes.
//
// The primitives are split so that a full shape is a set of *disjoint* spans: `stroke_rect`
// paints four bands that cannot overlap, `fill_round_rect` paints one span per row, and
// `stroke_round_rect` paints the two spans a row has outside its inner shape. No pixel is
// written twice, which is what makes the returned count exact rather than approximate.
//
// The blend is source-over with an 8-bit alpha, integer and exact. Per 8-bit channel:
//
//     out = (src * a + dst * (255 - a) + 127) / 255
//
// in `u64`, so `a == 255` returns `src` exactly and `a == 0` returns `dst` exactly. All four
// channels blend, alpha included. The `+ 127` is the round-to-nearest term; the test recomputes
// the same expression with full-precision integers and compares pixel for pixel.
//
// This module writes through `fb`'s raw pixel access, so a project that imports it lists it
// under `[unsafe] modules`.
impl "deps/polyp/backends/soft/soft/fb"

pub const MAX_CLIP: int = 8

// A stack of clip rectangles, fixed depth 8 and held inline: the base is the rectangle the
// caller's surface shows, and a `push` intersects with the current top. `top()` is total even
// for a stack that was never pushed, answering the empty rectangle, so a drawing function that
// only has a borrow of a stack never has to check for one.
pub datac ClipStack(var rects: [fb.Rect; 8], var depth: int)

pub fun clip(rect: fb.Rect) => ClipStack {
    var s = ClipStack(rects = [fb.Rect(x = 0, y = 0, w = 0, h = 0); 8], depth = 1)
    s.rects.set(0, rect.dup())
    return s
}

// Two contracts panic rather than silently misbehave: a ninth push and a pop past the base.
fun mut ClipStack.push(rect: fb.Rect) {
    if depth >= MAX_CLIP.to_int() {
        panic("clip stack depth 8 exceeded")
    }
    val merged: fb.Rect = fb.intersect(rects.get(depth - 1), rect)
    rects.set(depth, merged)
    depth += 1
}

fun mut ClipStack.pop() {
    if depth <= 1 {
        panic("clip stack is empty")
    }
    depth -= 1
}

fun ClipStack.top() => fb.Rect {
    if depth == 0 { return fb.empty_rect() }
    return rects.get(depth - 1).dup()
}

fun ClipStack.depth() => int = depth

// What every primitive actually clips to.
fun effective(f: fb.Fb, c: &ClipStack) => fb.Rect = fb.intersect(c.top(), f.bounds())

// One already-clipped horizontal span. Not `pub`: it trusts its bounds, so only the functions
// in this module may call it.
fun put_span(f: fb.Fb, x0: i32, x1: i32, y: i32, color: u32) => int {
    var count: int = 0
    var i: i32 = x0
    while i < x1 {
        unsafe { f.put(i, y, color) }
        count += 1
        i += 1
    }
    return count
}

// One row of `[a, b)` clipped to `cl` vertically and horizontally. `a`/`b`/`py` are widened so a
// rectangle that starts near `i32::MAX` cannot wrap before the clip is applied.
fun paint_row(f: fb.Fb, cl: fb.Rect, py: i64, a: i64, b: i64, color: u32) => int {
    if py < cl.y.to_i64() || py >= cl.bottom() { return 0 }
    var lo: i64 = cl.x.to_i64()
    if a > lo {
        lo = a
    }
    var hi: i64 = cl.right()
    if b < hi {
        hi = b
    }
    if lo >= hi { return 0 }
    return put_span(f, lo.to_i32(), hi.to_i32(), py.to_i32(), color)
}

pub fun fill_rect(f: fb.Fb, c: &ClipStack, x: i32, y: i32, w: i32, h: i32, color: u32) => int {
    val r: fb.Rect = fb.intersect(effective(f, c), fb.Rect(x = x, y = y, w = w, h = h))
    if r.is_empty() { return 0 }
    var count: int = 0
    var j: i32 = 0
    while j < r.h {
        count += put_span(f, r.x, r.x + r.w, r.y + j, color)
        j += 1
    }
    return count
}

pub fun hline(f: fb.Fb, c: &ClipStack, x: i32, y: i32, len: i32, color: u32) => int {
    return fill_rect(f, c, x, y, len, 1, color)
}

pub fun vline(f: fb.Fb, c: &ClipStack, x: i32, y: i32, len: i32, color: u32) => int {
    return fill_rect(f, c, x, y, 1, len, color)
}

// Four disjoint bands: top, bottom, and the two middles left after the corners are taken. Each
// thickness is clamped on its own axis, so a thickness wider than the rectangle fills it once
// instead of overdrawing it.
pub fun stroke_rect(
    f: fb.Fb,
    c: &ClipStack,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    thickness: i32,
    color: u32,
) => int {
    if w <= 0 || h <= 0 || thickness <= 0 { return 0 }
    var top_h: i32 = thickness
    if top_h > h {
        top_h = h
    }
    var bot_h: i32 = thickness
    if bot_h > h - top_h {
        bot_h = h - top_h
    }
    val mid_h: i32 = h - top_h - bot_h
    var lw: i32 = thickness
    if lw > w {
        lw = w
    }
    var rw: i32 = thickness
    if rw > w - lw {
        rw = w - lw
    }
    var count: int = 0
    count += fill_rect(f, c, x, y, w, top_h, color)
    count += fill_rect(f, c, x, y + h - bot_h, w, bot_h, color)
    count += fill_rect(f, c, x, y + top_h, lw, mid_h, color)
    count += fill_rect(f, c, x + w - rw, y + top_h, rw, mid_h, color)
    return count
}

// The exact integer circle the rounded corners use: in doubled coordinates, pixel (i, row) of a
// top-left corner of radius `r` is inside iff
//
//     (2 * (r - 1 - i) + 1)^2 + (2 * (r - 1 - row) + 1)^2 <= (2 * r)^2
//
// which is the pixel-centre test. It is written as one exact comparison rather than the classic
// midpoint error recurrence because the test's reference has to be a full-precision integer
// computation that agrees pixel for pixel, and the recurrence's half-step tie is not one
// closed-form predicate. The answer is the number of columns at each side of the row that fall
// outside the corner.
fun corner_inset(row: i32, r: i32, h: i32) => i32 {
    if r <= 0 { return 0 }
    var in_corner: bool = false
    var a: i32 = 0
    if row < r {
        a = r - 1 - row
        in_corner = true
    } else if row >= h - r {
        a = r - 1 - (h - 1 - row)
        in_corner = true
    }
    if !in_corner { return 0 }
    val dy: i64 = (2 * a + 1).to_i64()
    val lim: i64 = 4 * r.to_i64() * r.to_i64() - dy * dy
    if lim < 0 { return r }
    var i: i32 = 0
    var found: bool = false
    while i < r && !found {
        val dx: i64 = (2 * (r - 1 - i) + 1).to_i64()
        if dx * dx <= lim {
            found = true
        } else {
            i += 1
        }
    }
    return i
}

// The radius a shape of `w` by `h` is allowed to use: never negative and never past half the
// shorter side, so the two corners of a row cannot cross.
fun clamp_radius(radius: i32, w: i32, h: i32) => i32 {
    var r: i32 = radius
    if r < 0 {
        r = 0
    }
    var m: i32 = w
    if h < m {
        m = h
    }
    m = m / 2
    if r > m {
        r = m
    }
    return r
}

pub fun fill_round_rect(
    f: fb.Fb,
    c: &ClipStack,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    radius: i32,
    color: u32,
) => int {
    if w <= 0 || h <= 0 { return 0 }
    val r: i32 = clamp_radius(radius, w, h)
    val cl: fb.Rect = effective(f, c)
    if cl.is_empty() { return 0 }
    var count: int = 0
    var j: i32 = 0
    while j < h {
        val inset: i32 = corner_inset(j, r, h)
        val a: i64 = x.to_i64() + inset.to_i64()
        val b: i64 = x.to_i64() + w.to_i64() - inset.to_i64()
        count += paint_row(f, cl, y.to_i64() + j.to_i64(), a, b, color)
        j += 1
    }
    return count
}

// The outer shape minus the inner one at `(x + t, y + t, w - 2t, h - 2t, r - t)`. Each row is
// two disjoint spans, so nothing is overdrawn and the count is the ring's area.
pub fun stroke_round_rect(
    f: fb.Fb,
    c: &ClipStack,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    radius: i32,
    thickness: i32,
    color: u32,
) => int {
    if w <= 0 || h <= 0 || thickness <= 0 { return 0 }
    val r: i32 = clamp_radius(radius, w, h)
    val t: i32 = thickness
    val iw: i64 = w.to_i64() - 2 * t.to_i64()
    val ih: i64 = h.to_i64() - 2 * t.to_i64()
    var ir: i32 = r - t
    if ir < 0 {
        ir = 0
    }
    val cl: fb.Rect = effective(f, c)
    if cl.is_empty() { return 0 }
    var count: int = 0
    var j: i32 = 0
    while j < h {
        val py: i64 = y.to_i64() + j.to_i64()
        val inset: i32 = corner_inset(j, r, h)
        val o0: i64 = x.to_i64() + inset.to_i64()
        val o1: i64 = x.to_i64() + w.to_i64() - inset.to_i64()
        var has_inner: bool = false
        var i0: i64 = 0
        var i1: i64 = 0
        if iw > 0 && ih > 0 && j >= t && j < h - t {
            val iih: i32 = ih.to_i32()
            val ii: i32 = corner_inset(j - t, ir, iih)
            i0 = x.to_i64() + t.to_i64() + ii.to_i64()
            i1 = x.to_i64() + w.to_i64() - t.to_i64() - ii.to_i64()
            has_inner = true
        }
        if has_inner {
            count += paint_row(f, cl, py, o0, i0, color)
            count += paint_row(f, cl, py, i1, o1, color)
        } else {
            count += paint_row(f, cl, py, o0, o1, color)
        }
        j += 1
    }
    return count
}

// Source-over, channel by channel, with `src`'s alpha. The exact form is in the module header.
pub fun blend_over(dst: u32, src: u32) => u32 {
    val a: u64 = ((src >> 24) & 0xFF).to_u64()
    var out: u32 = channel((src >> 24) & 0xFF, (dst >> 24) & 0xFF, a) << 24
    out = out | (channel((src >> 16) & 0xFF, (dst >> 16) & 0xFF, a) << 16)
    out = out | (channel((src >> 8) & 0xFF, (dst >> 8) & 0xFF, a) << 8)
    out = out | channel(src & 0xFF, dst & 0xFF, a)
    return out
}

fun channel(s: u32, d: u32, a: u64) => u32 {
    val sv: u64 = s.to_u64()
    val dv: u64 = d.to_u64()
    val v: u64 = (sv * a + dv * (255 - a) + 127) / 255
    return v.to_u32()
}

pub fun blend_pixel(f: fb.Fb, c: &ClipStack, x: i32, y: i32, color: u32) => int {
    if !fb.contains_point(effective(f, c), x, y) { return 0 }
    val dst: u32 = unsafe { f.get(x, y) }
    unsafe { f.put(x, y, blend_over(dst, color)) }
    return 1
}

// `mask` is `w * h` tightly packed coverage bytes, one per pixel, row major. A byte `m` blends
// `color` with source alpha `(color.a * m + 127) / 255`; a byte `0` touches nothing and is not
// counted. This is the glyph path, and the only primitive whose mask is a caller buffer.
pub fun blit_mask8(
    f: fb.Fb,
    c: &ClipStack,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    mask: Ptr<u8>,
    color: u32,
) => int {
    if w <= 0 || h <= 0 { return 0 }
    val cl: fb.Rect = effective(f, c)
    val box: fb.Rect = fb.intersect(cl, fb.Rect(x = x, y = y, w = w, h = h))
    if box.is_empty() { return 0 }
    val color_a: u32 = (color >> 24) & 0xFF
    var count: int = 0
    var j: i32 = 0
    while j < box.h {
        var i: i32 = 0
        while i < box.w {
            val px: i32 = box.x + i
            val py: i32 = box.y + j
            val mi: i64 = (py - y).to_i64() * w.to_i64() + (px - x).to_i64()
            val m: u32 = unsafe { mask.offset(mi.to_isize()).read().to_u32() }
            if m != 0 {
                val a: u32 = (color_a * m + 127) / 255
                val src: u32 = (a << 24) | (color & 0x00FFFFFF)
                val dst: u32 = unsafe { f.get(px, py) }
                unsafe { f.put(px, py, blend_over(dst, src)) }
                count += 1
            }
            i += 1
        }
        j += 1
    }
    return count
}

// The classic Bresenham error loop over the major axis: exactly one pixel per major step, so
// `max(|dx|, |dy|) + 1` pixels are considered and a degenerate point is one pixel. The test's
// independent reference is the closed form for the same set (see `plan/polyp-v3.md` stage 2).
pub fun line(
    f: fb.Fb,
    c: &ClipStack,
    x0: i32,
    y0: i32,
    x1: i32,
    y1: i32,
    color: u32,
) => int {
    val cl: fb.Rect = effective(f, c)
    if cl.is_empty() { return 0 }
    var dx: i64 = x1.to_i64() - x0.to_i64()
    var sx: i32 = 1
    if dx < 0 {
        dx = 0 - dx
        sx = -1
    }
    var dy: i64 = y1.to_i64() - y0.to_i64()
    var sy: i32 = 1
    if dy < 0 {
        dy = 0 - dy
        sy = -1
    }
    var x: i64 = x0.to_i64()
    var y: i64 = y0.to_i64()
    val xe: i64 = x1.to_i64()
    val ye: i64 = y1.to_i64()
    var err: i64 = dx - dy
    var count: int = 0
    var done: bool = false
    while !done {
        if fb.contains_point(cl, x.to_i32(), y.to_i32()) {
            unsafe { f.put(x.to_i32(), y.to_i32(), color) }
            count += 1
        }
        if x == xe && y == ye {
            done = true
        } else {
            val e2: i64 = 2 * err
            if e2 > 0 - dy {
                err -= dy
                x += sx.to_i64()
            }
            if e2 < dx {
                err += dx
                y += sy.to_i64()
            }
        }
    }
    return count
}
