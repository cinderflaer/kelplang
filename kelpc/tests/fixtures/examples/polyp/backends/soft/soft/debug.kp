//! Hosted debugging output for the software raster (Polyp v3 stage 2).
impl "deps/polyp/backends/soft/soft/fb"
impl "std/fs"
impl "std/result"

// Push the decimal digits of a non-negative `i64`.
fun push_uint(out: mut Bytes, n: i64) {
    if n <= 0 {
        out.push(48)
        return
    }
    var buf: [u8; 20] = [0; 20]
    var k: int = 0
    var v: i64 = n
    while v > 0 {
        buf.set(k, (48 + (v % 10).to_u8()))
        v = v / 10
        k += 1
    }
    while k > 0 {
        k -= 1
        out.push(buf.get(k))
    }
}

pub fun dump_ppm(f: fb.Fb, path: str) {
    var out: Bytes = Bytes.empty()
    out.push(80)
    out.push(54)
    out.push(10)
    push_uint(out, f.width.to_i64())
    out.push(32)
    push_uint(out, f.height.to_i64())
    out.push(10)
    out.push(50)
    out.push(53)
    out.push(53)
    out.push(10)
    var y: i32 = 0
    while y < f.height {
        var x: i32 = 0
        while x < f.width {
            val p: u32 = unsafe { f.get(x, y) }
            out.push(((p >> 16) & 0xFF).to_u8())
            out.push(((p >> 8) & 0xFF).to_u8())
            out.push((p & 0xFF).to_u8())
            x += 1
        }
        y += 1
    }
    result.expect(fs.write(path, out), "fs.write: the call failed")
}
