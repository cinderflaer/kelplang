//! The damage list (Polyp v3 stage 2).
impl "deps/polyp/backends/soft/soft/fb"

pub const MAX_DAMAGE: int = 16

pub datac Damage(var rects: [fb.Rect; MAX_DAMAGE], var len: int)

pub fun new() => Damage = Damage(rects = [fb.Rect(x = 0, y = 0, w = 0, h = 0); MAX_DAMAGE], len = 0)

fun Damage.count() => int = len

// A copy, so a caller cannot hold a borrow of the list across a later `add`.
fun Damage.at(i: int) => fb.Rect = rects.get(i).dup()

fun mut Damage.clear() {
    len = 0
}

// The one rectangle covering every entry, empty when the list is.
fun Damage.bounds() => fb.Rect {
    val n: int = len
    if n == 0 { return fb.empty_rect() }
    var out: fb.Rect = rects.get(0).dup()
    var i: int = 1
    while i < n {
        val next: fb.Rect = rects.get(i).dup()
        out = fb.union(out, next)
        i += 1
    }
    return out
}

// Steps 1 to 4 above.
fun mut Damage.add(rect: fb.Rect) {
    if rect.is_empty() { return }
    val n: int = len
    val has_room: bool = n < MAX_DAMAGE.to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int().to_int()
    if has_room {
        if self.merge_into_touching(rect) {
            self.coalesce()
            return
        }
        rects.set(n, rect.dup())
        len = n + 1
        return
    }
    if self.merge_into_touching(rect) {
        self.coalesce()
        return
    }
    self.merge_least_waste()
    val m: int = len
    rects.set(m, rect.dup())
    len = m + 1
    self.coalesce()
}

// Replace the first entry that touches `r` with the union, if any does.
fun mut Damage.merge_into_touching(r: fb.Rect) => bool {
    val n: int = len
    var i: int = 0
    while i < n {
        val probe: fb.Rect = rects.get(i).dup()
        val hit: bool = fb.touches(probe, r)
        if hit {
            val merged: fb.Rect = fb.union(probe, r)
            rects.set(i, merged)
            return true
        }
        i += 1
    }
    return false
}

// Merge the pair whose union wastes the least area and remove the second entry. The caller
// guarantees `n >= 2`.
fun mut Damage.merge_least_waste() {
    val n: int = len
    var best_i: int = 0
    var best_j: int = 1
    var best_waste: i64 = 0
    var first = true
    var i: int = 0
    while i < n {
        var j: int = i + 1
        while j < n {
            val a: fb.Rect = rects.get(i).dup()
            val b: fb.Rect = rects.get(j).dup()
            val u: fb.Rect = fb.union(a, b)
            val waste: i64 = u.area() - a.area() - b.area()
            if first {
                best_waste = waste
                first = false
            } else if waste < best_waste {
                best_waste = waste
                best_i = i
                best_j = j
            }
            j += 1
        }
        i += 1
    }
    val bi: int = best_i
    val bj: int = best_j
    val cur: fb.Rect = rects.get(bi).dup()
    val other: fb.Rect = rects.get(bj).dup()
    val merged: fb.Rect = fb.union(cur, other)
    rects.set(bi, merged)
    var k: int = bj
    while k + 1 < n {
        val nxt: fb.Rect = rects.get(k + 1).dup()
        rects.set(k, nxt)
        k += 1
    }
    len = n - 1
}

// Merge touching pairs one at a time until none remain. One merge per pass is deliberate: the
// pass's `n` is stale the moment a pair is removed, so the pass restarts from the new list.
fun mut Damage.coalesce() {
    var changed = true
    while changed {
        changed = false
        val n: int = len
        var i: int = 0
        while i < n && !changed {
            var j: int = i + 1
            while j < n && !changed {
                val a: fb.Rect = rects.get(i).dup()
                val b: fb.Rect = rects.get(j).dup()
                val hit: bool = fb.touches(a, b)
                if hit {
                    val merged: fb.Rect = fb.union(a, b)
                    rects.set(i, merged)
                    var k: int = j
                    while k + 1 < n {
                        val nxt: fb.Rect = rects.get(k + 1).dup()
                        rects.set(k, nxt)
                        k += 1
                    }
                    len = n - 1
                    changed = true
                }
                j += 1
            }
            i += 1
        }
    }
}
