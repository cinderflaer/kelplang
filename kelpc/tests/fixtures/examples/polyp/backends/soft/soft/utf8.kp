//! UTF-8 decoding for the soft backend's text (Polyp v4 stage 2).

impl "std/str"

pub const REPLACEMENT: i32 = 0xFFFD

fun is_cont(b: u8) => bool = b >= 0x80 && b <= 0xBF

// `(len << 32) | codepoint` for the unit starting at byte `i` (which must be inside the string).
pub fun decode(s: str, i: int) => i64 {
    val n = str.len(s)
    val b0 = str.byte(s, i).to_i64()
    if b0 < 0x80 { return (1 << 32) | b0 }
    var need: int = 0
    var min: i64 = 0
    var cp: i64 = 0
    if b0 >= 0xC2 && b0 <= 0xDF {
        need = 1
        min = 0x80
        cp = b0 & 0x1F
    } else if b0 >= 0xE0 && b0 <= 0xEF {
        need = 2
        min = 0x800
        cp = b0 & 0x0F
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
        need = 3
        min = 0x10000
        cp = b0 & 0x07
    } else {
        return (1 << 32) | REPLACEMENT.to_i64()
    }
    var k: int = 0
    while k < need && i + 1 + k < n && is_cont(str.byte(s, i + 1 + k)) {
        cp = (cp << 6) | (str.byte(s, i + 1 + k).to_i64() & 0x3F)
        k += 1
    }
    val len = (1 + k).to_i64()
    if k < need { return (len << 32) | REPLACEMENT.to_i64() }
    if cp < min || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        return (len << 32) | REPLACEMENT.to_i64()
    }
    return (len << 32) | cp
}

pub fun unit_len(r: i64) => int = (r >> 32).to_int()

pub fun unit_cp(r: i64) => i32 = (r & 0xFFFFFFFF).to_i32()

// The number of units (code points, each malformed run counting once) in the whole string.
pub fun count(s: str) => i32 {
    val n = str.len(s)
    var i: int = 0
    var c: i32 = 0
    while i < n {
        i += unit_len(decode(s, i))
        c += 1
    }
    return c
}

// The number of units that start before byte offset `upto`.
pub fun count_before(s: str, upto: int) => i32 {
    val n = str.len(s)
    var i: int = 0
    var c: i32 = 0
    while i < n && i < upto {
        i += unit_len(decode(s, i))
        c += 1
    }
    return c
}

// The byte offset just after the unit that starts at `i` (or `i` itself at the end of the string).
pub fun next_boundary(s: str, i: int) => int {
    if i >= str.len(s) { return str.len(s) }
    return i + unit_len(decode(s, i))
}

// The start of the unit that ends at or before `i`: the largest unit boundary strictly below `i`
// (0 when there is none). Units are defined by scanning from the start, so this scans from there too.
pub fun prev_boundary(s: str, i: int) => int {
    val n = str.len(s)
    var at: int = 0
    var last: int = 0
    while at < n && at < i {
        last = at
        at += unit_len(decode(s, at))
    }
    return last
}

// The largest unit boundary at or below `i`: a caret that sits inside a unit snaps to its start.
pub fun snap_boundary(s: str, i: int) => int {
    val n = str.len(s)
    var at: int = 0
    while at < n {
        val nx = at + unit_len(decode(s, at))
        if nx > i { return at }
        at = nx
    }
    return n
}

// Whether `cp` is a Unicode scalar value (what a platform's `Char` event may legitimately carry).
pub fun is_scalar(cp: i32) => bool = cp >= 0 && cp <= 0x10FFFF && !(cp >= 0xD800 && cp <= 0xDFFF)
