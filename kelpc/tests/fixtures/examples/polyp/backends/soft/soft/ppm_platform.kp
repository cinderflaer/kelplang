//! A headless platform that also writes each presented frame to a PPM file (Polyp v3 stage 3).
impl "deps/polyp/backends/soft/soft/damage"
impl "deps/polyp/backends/soft/soft/debug" caps(fs = ["/**"])
impl "deps/polyp/backends/soft/soft/event"
impl "deps/polyp/backends/soft/soft/fb"
impl "deps/polyp/backends/soft/soft/headless_platform"
impl "deps/polyp/backends/soft/soft/platform"
impl "std/env"
impl "std/fmt"
impl "std/option"
impl "std/str"

pub datac PpmPlatform(var inner: headless_platform.HeadlessPlatform, var dir: String, var n: i32)

pub fun new(width: i32, height: i32) => PpmPlatform = PpmPlatform(
    inner = headless_platform.new(width = width, height = height),
    dir = env.get("POLYP_DUMP_DIR"),
    n = 0,
)

// The frame index the next dump will use, so a test can tell "dumping" from "not".
fun PpmPlatform.dumps() => bool = !dir.is_empty()

fun PpmPlatform.dump_dir() => String = String.from_str(dir.as_str())

fun mut PpmPlatform.push(ev: move event.Event) {
    inner.push(ev)
}

fun mut PpmPlatform.advance(ms: u64) {
    inner.advance(ms)
}

fun mut PpmPlatform.advance_us(us: u64) {
    inner.advance_us(us)
}

fun PpmPlatform.checksum() => u64 = inner.checksum()

fun PpmPlatform.frame_count() => i32 = inner.frame_count()

fun PpmPlatform.presented_count() => int = inner.presented_count()

fun PpmPlatform.pixel(x: i32, y: i32) => u32 = inner.pixel(x, y)

fun mut PpmPlatform.dump(f: fb.Fb) {
    if !dir.is_empty() {
        val head = str.concat(dir, "/frame_")
        val index = fmt.int(n.to_i64())
        val mid = str.concat(head, index.as_str())
        val path = str.concat(mid, ".ppm")
        debug.dump_ppm(f, path.as_str())
        n += 1
    }
}

impl platform.Platform for PpmPlatform {
    fun mut Self.present(fb: fb.Fb, dirty: &damage.Damage) {
        self.dump(fb)
        inner.present(fb, dirty)
    }

    fun Self.now_ms() => u64 = inner.now_ms()

    fun mut Self.now_us() => u64 = inner.now_us()

    fun mut Self.poll_event() => option.Option<event.Event> = inner.poll_event()

    fun Self.framebuffer() => fb.Fb = inner.framebuffer()
}
