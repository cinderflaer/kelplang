// Polyp's backend-neutral core: the tree, the diff and the loop, with no display.
//
// Nothing here names GTK, calls an `extern fun` or uses `unsafe`. What changes between two
// renders is a `List<Patch>` of plain data, and what draws it is a `Backend`. A backend holds
// widgets and knows nothing about the application's `Msg`: it sees `Props`, never `Node`, and the
// events it produces carry an integer id and, for a programmatic edit, a string.
//
// The split is plan/polyp-v3.md. v2's matching rules, keys, builder and counters are unchanged;
// the GTK calls moved to `gtk_backend.kp` and `lib.kp` is the facade the examples import.
impl "deps/polyp/core/anim"
impl "std/atomic"
impl "std/option"
impl "std/str"

// The widget kinds, as the integers a patch carries. A new child is matched to an old one at the
// same position only when these agree, which is what keeps a Button from being patched into a Text.
pub const KIND_COLUMN: i32 = 0
pub const KIND_ROW: i32 = 1
pub const KIND_TEXT: i32 = 2
pub const KIND_SPACER: i32 = 3
pub const KIND_ENTRY: i32 = 4
pub const KIND_BUTTON: i32 = 5
pub const KIND_CHECKBOX: i32 = 6
pub const KIND_PROGRESS: i32 = 7
pub const KIND_SEPARATOR: i32 = 8
pub const KIND_SCROLLED: i32 = 9

// The two timer kinds a `Sub` has (see `Sub`, below).
const SUB_EVERY: i32 = 0
const SUB_AFTER: i32 = 1

// The alignment codes `props.align` carries, in the core's own order: a backend maps them to its
// display's constants.
pub const ALIGN_FILL: i32 = 0
pub const ALIGN_START: i32 = 1
pub const ALIGN_CENTER: i32 = 2
pub const ALIGN_END: i32 = 3

// The counters a smoke run reads. They are atomics because v2's were and the shape cost nothing:
// a nested function cannot hold a passdown the frame also holds (plan/syntax.md 12.5). They are
// `static`s rather than passdowns so a freestanding image carries them too: a `pd`'s initializer
// runs through `kelp_init_pds`, which only the hosted entry point calls, while an `Atomic` static
// is data the linker places and its methods write through a shared borrow, which needs no
// `unsafe`. The entry-text snapshot that is a `List<String>` cannot be a static, so it lives in
// `diag.kp`, which a freestanding project does not import (`plan/polyp-v3.md`, stage 4).
static stat_created: AtomicI32 = AtomicI32.new(0)
static stat_updated: AtomicI32 = AtomicI32.new(0)
static stat_removed: AtomicI32 = AtomicI32.new(0)
static stat_live: AtomicI32 = AtomicI32.new(0)
static stat_entries: AtomicI32 = AtomicI32.new(0)
static stat_memo_hits: AtomicI32 = AtomicI32.new(0)
static stat_memo_misses: AtomicI32 = AtomicI32.new(0)
static stat_view_calls: AtomicI32 = AtomicI32.new(0)
static focus_seen_flag: AtomicBool = AtomicBool.new(false)
static focus_lost_flag: AtomicBool = AtomicBool.new(false)

// The kinds a user can activate, so the kinds a backend gives a widget id and a signal handler.
pub fun interactive(kind: i32) => bool = kind == KIND_ENTRY || kind == KIND_BUTTON || kind == KIND_CHECKBOX

// The alignment names an application writes. `props.align` carries one of the `ALIGN_*` codes (or
// -1 for unset); which number a display's own alignment constant has is the backend's business.
pub enum Align {
    Fill
    Start
    Center
    End
}

fun align_code(a: Align) => i32 = when a {
    Fill -> ALIGN_FILL
    Start -> ALIGN_START
    Center -> ALIGN_CENTER
    End -> ALIGN_END
}

// A child's key. One type per list: an application uses only `Str` keys or only `Int` keys, and
// the two compare unequal. Keys have no derived equality, so `key_eq` below is the comparison and
// it is the one place the rule lives.
pub enum Key {
    None
    Str(val s: String)
    Int(val n: i64)
}

// The layout and style options a child carries. `margin < 0` and `align < 0` mean "unset": the
// widget keeps whatever its platform's default is, and a patch does not touch that property.
//
// v4 adds the visual options an animation drives: `opacity` (permille, 1000 = opaque) and an
// `offset_x`/`offset_y` paint translation, each with an optional `Anim` (`anim.none()` = static),
// and `anim`, the animation of the widget's own value (a `Progress`'s permille, a `Spacer`'s height).
pub datac Opts(
    var margin: i32,
    var expand: bool,
    var align: i32,
    var classes: List<String>,
    var opacity: i32,
    var offset_x: i32,
    var offset_y: i32,
    var anim_main: anim.Anim,
    var anim_opacity: anim.Anim,
    var anim_ox: anim.Anim,
    var anim_oy: anim.Anim,
    // v4 stage 3: a disabled widget takes no pointer or keyboard input, is skipped by Tab, is drawn
    // muted by the soft backend and is reported as disabled in the accessibility tree.
    var disabled: bool,
)

// The tree `view` returns. `M` is the application's `Msg`; the core never inspects one until a
// matched widget's handler posts its id.
//
// The recursion goes through `List`, which is what keeps the type a finite size: a `List` element
// lives in the list's own heap buffer, so `Node<M>` can hold children of its own type. A bare
// `Node<M>` field would be an infinite size.
pub enum Node<M> {
    Column(val children: List<Child<M>>, val spacing: i32)
    Row(val children: List<Child<M>>, val spacing: i32)
    Text(val text: String, val size: i32, val bold: bool)
    Spacer(val height: i32)
    Entry(val text: String, val on_change: fun (String) => M)
    Button(val label: String, val on_click: Box<M>)
    Checkbox(val label: String, val checked: bool, val on_toggle: Box<M>)
    Progress(val permille: i32)
    Separator
    Scrolled(val children: List<Child<M>>, val spacing: i32)
    // A memoised subtree (Polyp v4 stage 4): not built yet. `deps` is everything the subtree is
    // a function of, `build` turns it into the subtree: it is given the deps and a builder and must
    // return exactly one node (see `single`). The loop calls `build` only when `deps`
    // differ from the last frame's for the same key, and otherwise reuses the retained widgets.
    // The widget a backend sees for it is a transparent `Column` whose single child (index 0) is
    // the subtree's root.
    Memo(val deps: Deps, val build: fun (&Deps) => List<Child<M>>)
}

// What a memoised subtree is a function of, as a value with a declared `eq` (so `==` works): a list
// of integers and a list of strings, in the order the application pushes them. Build one from the
// data the subtree displays, `core.deps()` then `push_int`/`push_str`/`push_bool`, and read the
// same values back inside the view function: the function is given `&Deps` and must produce the
// subtree from it alone, which is what makes skipping it sound.
pub datac Deps(var ints: List<i64>, var strs: List<String>)

pub fun deps() => Deps = Deps(ints = List.empty(), strs = List.empty())

// Run a memo's view function: the one node it returns is the subtree's root.
fun run_build<M>(deps: &Deps, build: fun (&Deps) => List<Child<M>>) => Node<M> {
    var items = build(deps)
    if items.len() != 1 {
        panic("polyp: a memo view function must return exactly one node")
    }
    var child = items.remove(0)
    return unbox(child.node)
}

// What a memo view function returns: the nodes the block pushes (exactly one is required), so
// `fun row_view(d: &Deps) => List<Child<Msg>> = core.single { k -> k.row { r -> ... } }`.
pub fun single<M>(block: scoped fun(mut Children<M>)) => List<Child<M>> {
    var c: Children<M> = new_children()
    block(c)
    return c.items
}

fun mut Deps.push_int(n: i64) {
    ints.push(n)
}

fun mut Deps.push_bool(b: bool) {
    if b {
        ints.push(1)
    } else {
        ints.push(0)
    }
}

fun mut Deps.push_str(s: str) {
    strs.push(String.from_str(s))
}

pub fun copy_deps(d: &Deps) => Deps {
    var out = deps()
    for item in d.ints {
        out.ints.push(item)
    }
    for item in d.strs {
        out.strs.push(String.from_str(item.as_str()))
    }
    return out
}

fun Deps.eq(other: &Deps) => bool {
    if ints.len() != other.ints.len() || strs.len() != other.strs.len() { return false }
    var i: int = 0
    while i < ints.len() {
        if ints.get(i) != other.ints.get(i) { return false }
        i += 1
    }
    var j: int = 0
    while j < strs.len() {
        if !str.eq(strs.get(j).as_str(), other.strs.get(j).as_str()) { return false }
        j += 1
    }
    return true
}

// One child of a container: its key, its node, and the options that apply to its widget. A key
// must be unique among the children of one container; a duplicate panics when the container is
// reconciled.
pub datac Child<M>(val key: Box<Key>, val node: Box<Node<M>>, val opts: Opts)

// Moves a value out of a `Box`. A managed datac or enum payload holds a Key, a Node or a message
// only through a Box, because the collector describes an enum only as a heap object.
pub fun unbox<T>(b: move Box<T>) => T {
    var c = b
    return c.take()
}

// The builder a block writes children into. A trailing block is passed to `column`/`row` as a
// `scoped fun(mut Children<M>)`, so the block mutates this value through the exclusive borrow a
// `mut` parameter of a scoped function type already is (kelp wiki page language/functions.md).
//
// The pending key and options are one-shot: every push consumes them and resets them. They live in
// `Box`es because a method's `self` is a borrow, and reading an owned field by value out of a
// borrow is refused; `take()` is the move that is allowed.
pub datac Children<M>(
    var items: List<Child<M>>,
    var spacing: i32,
    var pending_key: Box<Key>,
    var pending_opts: Box<Opts>,
)

fun default_opts() => Opts = Opts(
    margin = -1,
    expand = false,
    align = -1,
    classes = List.empty(),
    opacity = 1000,
    offset_x = 0,
    offset_y = 0,
    anim_main = anim.none(),
    anim_opacity = anim.none(),
    anim_ox = anim.none(),
    anim_oy = anim.none(),
    disabled = false,
)

fun new_children<M>() => Children<M> = Children<M>(
    items = List.empty(),
    spacing = 6,
    pending_key = Box.of(Key.None),
    pending_opts = Box.of(default_opts()),
)

// Key equality: a declared `eq` would give `==`, but a lone comparison is all this needs, and it is
// the one place the "one key type per list" rule is enforced (a Str key never equals an Int key).
pub fun key_eq(a: &Key, b: &Key) => bool = when a {
    None -> when b {
        None -> true
        else -> false
    }
    Str(x) -> when b {
        Str(y) -> str.eq(x.as_str(), y.as_str())
        else -> false
    }
    Int(m) -> when b {
        Int(n) -> m == n
        else -> false
    }
}

pub fun key_is_none(k: &Key) => bool = when k {
    None -> true
    else -> false
}

// `Key` and `Event` declare their own `Map` key pair, which is what stops the compiler emitting the
// derived `kelp_hash_<T>`/`kelp_eq_<T>` pair for them. The derived equality compares a `String`
// field through `kelp_map_key_eq`, a hosted runtime symbol a bare-metal image has no body for, and
// the derived pair is emitted for every keyable type in the program whether or not anything uses it
// as a key (Polyp v3 stage 4; `plan/polyp-v3.md` records the finding). A declared pair is used
// instead of the derived one, so the two below are a real hash and a real field-by-field
// comparison, and a `Map` keyed by either type still works on both backends.

// FNV-1a over a string's bytes, built from the two `str` operations a freestanding image lowers
// itself. Equal strings hash equal, which is the whole contract a key's hash owes.
pub fun hash_str(s: str) => u64 {
    var h: u64 = 14695981039346656037
    val n = str.len(s)
    var i: int = 0
    while i < n {
        h = (h ^ str.byte(s, i).to_u64()) * 1099511628211
        i += 1
    }
    return h
}

fun Key.hash() => u64 = when self {
    None -> 3
    Str(s) -> hash_str(s.as_str())
    Int(n) -> hash_str("int") ^ n.to_u64()
}

fun Key.eq(other: &Key) => bool = key_eq(self, other)

pub fun clone_key(k: &Key) => Key = when k {
    None -> Key.None
    Str(s) -> Key.Str(s = String.from_str(s.as_str()))
    Int(n) -> Key.Int(n = n)
}

fun duplicate_message(k: &Key) => String = when k {
    None -> "polyp: duplicate key among the children of one container"
    Str(s) -> {
        val head = str.concat("polyp: duplicate key '", s.as_str())
        str.concat(head, "' among the children of one container")
    }
    Int(n) -> {
        val shown = str.from_i64(n)
        val head = str.concat("polyp: duplicate key ", shown.as_str())
        str.concat(head, " among the children of one container")
    }
}

// Panics, naming the key, when two children of one container carry it. Run before any widget is
// touched, so a refused tree builds nothing.
fun check_duplicate_keys<M>(children: List<Child<M>>) {
    var i: int = 0
    while i < children.len() {
        if !key_is_none(children.get(i).key.get()) {
            var j: int = i + 1
            while j < children.len() {
                if key_eq(children.get(i).key.get(), children.get(j).key.get()) {
                    panic(duplicate_message(children.get(i).key.get()))
                }
                j += 1
            }
        }
        i += 1
    }
}

pub fun kind_of_node<M>(node: &Node<M>) => i32 = when node {
    Column(_, _) -> KIND_COLUMN
    Row(_, _) -> KIND_ROW
    Text(_, _, _) -> KIND_TEXT
    Spacer(_) -> KIND_SPACER
    Entry(_, _) -> KIND_ENTRY
    Button(_, _) -> KIND_BUTTON
    Checkbox(_, _, _) -> KIND_CHECKBOX
    Progress(_) -> KIND_PROGRESS
    Separator -> KIND_SEPARATOR
    Scrolled(_, _) -> KIND_SCROLLED
    Memo(_, _) -> KIND_COLUMN
}

fun is_memo<M>(node: &Node<M>) => bool = when node {
    Memo(_, _) -> true
    else -> false
}

// The leaf methods of the builder. `text` and `text_styled` take a `str` view so a borrowed
// `String` field (`s.title.as_str()`) can be passed without a copy the caller has to write. Every
// one of them consumes the pending key and options, then resets them.
fun mut Children<M>.push_node(node: move Node<M>) {
    val k = pending_key.take()
    pending_key.set(Key.None)
    val o = pending_opts.take()
    pending_opts.set(default_opts())
    items.push(Child(key = Box.of(k), node = Box.of(node), opts = o))
}

fun mut Children<M>.push_keyed(key: move Key, node: move Node<M>) {
    pending_key.set(Key.None)
    val o = pending_opts.take()
    pending_opts.set(default_opts())
    items.push(Child(key = Box.of(key), node = Box.of(node), opts = o))
}

fun mut Children<M>.text(t: str) {
    self.push_node(Node.Text(text = String.from_str(t), size = 0, bold = false))
}

fun mut Children<M>.text_styled(t: str, size: i32, bold: bool) {
    self.push_node(Node.Text(text = String.from_str(t), size = size, bold = bold))
}

fun mut Children<M>.spacer(height: i32) {
    self.push_node(Node.Spacer(height = height))
}

fun mut Children<M>.button(label: str, on_click: move M) {
    self.push_node(Node.Button(label = String.from_str(label), on_click = Box.of(on_click)))
}

// `on_change` is a plain `fun` value, not a closure capturing state: the loop calls it with the
// entry's new text, and the app writes the constructor that turns that text into its own `Msg`.
fun mut Children<M>.entry(value: str, on_change: fun (String) => M) {
    self.push_node(Node.Entry(text = String.from_str(value), on_change = on_change))
}

fun mut Children<M>.checkbox(label: str, checked: bool, on_toggle: move M) {
    self.push_node(Node.Checkbox(label = String.from_str(label), checked = checked, on_toggle = Box.of(on_toggle)))
}

// The fraction is an integer permille (`0..=1000`), not an `f64`: a f64 comparison on a
// bare-metal riscv64 target is a `__eqdf2` soft-float call, and a view that computed the ratio
// with floats would need a division helper too (`plan/polyp-v3.md`, stage 4).
fun mut Children<M>.progress(permille: i32) {
    self.push_node(Node.Progress(permille = permille))
}

fun mut Children<M>.separator() {
    self.push_node(Node.Separator)
}

fun mut Children<M>.column(block: scoped fun(mut Children<M>)) {
    var inner: Children<M> = new_children()
    block(inner)
    self.push_node(Node.Column(children = inner.items, spacing = inner.spacing))
}

fun mut Children<M>.row(block: scoped fun(mut Children<M>)) {
    var inner: Children<M> = new_children()
    block(inner)
    self.push_node(Node.Row(children = inner.items, spacing = inner.spacing))
}

// A scroll area. The block's children are laid out in an implicit box inside the scroll area; the
// area itself is the widget a patch updates, and the box inside it is reconciled like any other
// container, so the scroll offset survives.
fun mut Children<M>.scrolled(block: scoped fun(mut Children<M>)) {
    var inner: Children<M> = new_children()
    block(inner)
    self.push_node(Node.Scrolled(children = inner.items, spacing = inner.spacing))
}

// A keyed row: the block's children become one `Row` child whose key is the one given, which is
// the shape a list of rows wants (`k.keyed("task-7") { r -> ... }`). `keyed_col` is the same for a
// column, and `with_key` puts a key on the next pushed node of any kind.
fun mut Children<M>.keyed(key: str, block: scoped fun(mut Children<M>)) {
    var inner: Children<M> = new_children()
    block(inner)
    self.push_keyed(Key.Str(s = String.from_str(key)), Node.Row(children = inner.items, spacing = inner.spacing))
}

fun mut Children<M>.keyed_col(key: str, block: scoped fun(mut Children<M>)) {
    var inner: Children<M> = new_children()
    block(inner)
    self.push_keyed(Key.Str(s = String.from_str(key)), Node.Column(children = inner.items, spacing = inner.spacing))
}

fun mut Children<M>.with_key(key: str) {
    pending_key.set(Key.Str(s = String.from_str(key)))
}

// The integer-keyed twins. One list uses one key type, so an application picks the pair that
// matches the identity it has (a name, or an id).
fun mut Children<M>.keyed_int(key: i64, block: scoped fun(mut Children<M>)) {
    var inner: Children<M> = new_children()
    block(inner)
    self.push_keyed(Key.Int(n = key), Node.Row(children = inner.items, spacing = inner.spacing))
}

fun mut Children<M>.keyed_int_col(key: i64, block: scoped fun(mut Children<M>)) {
    var inner: Children<M> = new_children()
    block(inner)
    self.push_keyed(Key.Int(n = key), Node.Column(children = inner.items, spacing = inner.spacing))
}

fun mut Children<M>.with_key_int(key: i64) {
    pending_key.set(Key.Int(n = key))
}

// A memoised subtree under a string key (`k.memo("row-7", deps, row_view)`): the key must be unique
// among the container's children, like any key, and is the subtree's identity across frames.
// Options (`k.expand()`, `k.margin(..)`) given before the call apply to the transparent wrapper
// column; the subtree's own root takes none.
fun mut Children<M>.memo(key: str, deps: move Deps, build: fun (&Deps) => List<Child<M>>) {
    self.push_keyed(Key.Str(s = String.from_str(key)), Node.Memo(deps = deps, build = build))
}

fun mut Children<M>.memo_int(key: i64, deps: move Deps, build: fun (&Deps) => List<Child<M>>) {
    self.push_keyed(Key.Int(n = key), Node.Memo(deps = deps, build = build))
}

// Options. `spacing` is the box being built; the rest apply to the next child pushed, whatever
// kind it is, so `k.expand() k.column { ... }` expands the column.
fun mut Children<M>.spacing(n: i32) {
    spacing = n
}

fun mut Children<M>.margin(n: i32) {
    var o = pending_opts.take()
    o.margin = n
    pending_opts.set(o)
}

fun mut Children<M>.expand() {
    var o = pending_opts.take()
    o.expand = true
    pending_opts.set(o)
}

fun mut Children<M>.align(a: Align) {
    var o = pending_opts.take()
    o.align = align_code(a)
    pending_opts.set(o)
}

fun mut Children<M>.class(name: str) {
    var o = pending_opts.take()
    o.classes.push(String.from_str(name))
    pending_opts.set(o)
}

// Animation and paint options (v4 stage 1). Like the options above they apply to the next child
// pushed. `anim` animates the child's own value: a `Progress`'s permille or a `Spacer`'s height
// (the plain value the node carries is what it shows when it has no animation, and what it shows
// to a backend that ignores animations). `opacity` is a permille; `offset` translates the widget
// and everything inside it when it is painted, without changing the layout.
fun mut Children<M>.anim(a: move anim.Anim) {
    var o = pending_opts.take()
    o.anim_main = a
    pending_opts.set(o)
}

fun mut Children<M>.disabled() {
    var o = pending_opts.take()
    o.disabled = true
    pending_opts.set(o)
}

fun mut Children<M>.opacity(permille: i32) {
    var o = pending_opts.take()
    o.opacity = permille
    pending_opts.set(o)
}

fun mut Children<M>.opacity_anim(a: move anim.Anim) {
    var o = pending_opts.take()
    o.anim_opacity = a
    pending_opts.set(o)
}

fun mut Children<M>.offset(x: i32, y: i32) {
    var o = pending_opts.take()
    o.offset_x = x
    o.offset_y = y
    pending_opts.set(o)
}

fun mut Children<M>.offset_x_anim(a: move anim.Anim) {
    var o = pending_opts.take()
    o.anim_ox = a
    pending_opts.set(o)
}

fun mut Children<M>.offset_y_anim(a: move anim.Anim) {
    var o = pending_opts.take()
    o.anim_oy = a
    pending_opts.set(o)
}

// Block-taking constructors, so app code reads
// `polyp.column { k -> k.text(s.title) k.button("+1", Msg.Inc) }`. The block's captures are shared
// borrows released with this call, which is what lets it read the view's borrowed state.
pub fun column<M>(block: scoped fun(mut Children<M>)) => Node<M> {
    var c: Children<M> = new_children()
    block(c)
    return Node.Column(children = c.items, spacing = c.spacing)
}

pub fun row<M>(block: scoped fun(mut Children<M>)) => Node<M> {
    var c: Children<M> = new_children()
    block(c)
    return Node.Row(children = c.items, spacing = c.spacing)
}

// The plain constructors. `text` and `button` keep their names because the builder's same-named
// items are methods, a separate namespace; `column` and `row` cannot keep them because the
// block-taking constructors above are free functions of the same name and Kelp has no overloading,
// so the plain spelling carries a `plain_` prefix. Both spellings compile.
fun plain_children<M>(nodes: move List<Node<M>>) => List<Child<M>> {
    var out: List<Child<M>> = List.empty()
    var rest = nodes
    while !rest.is_empty() {
        out.push(Child(key = Box.of(Key.None), node = Box.of(rest.remove(0)), opts = default_opts()))
    }
    return out
}

// A memoised root (a whole view that is a function of one `Deps`).
pub fun memo<M>(deps: move Deps, build: fun (&Deps) => List<Child<M>>) => Node<M> = Node.Memo(deps = deps, build = build)

pub fun plain_column<M>(children: move List<Node<M>>) => Node<M> = Node.Column(children = plain_children(children), spacing = 6)
pub fun plain_row<M>(children: move List<Node<M>>) => Node<M> = Node.Row(children = plain_children(children), spacing = 6)
pub fun text<M>(text: move String) => Node<M> = Node.Text(text = text, size = 0, bold = false)
pub fun button<M>(label: move String, on_click: move M) => Node<M> = Node.Button(label = label, on_click = Box.of(on_click))

// A node's address in the tree. The root is the empty path; a segment names a child by its key
// when it has one (`Keyed`) and by its position otherwise (`Index`). Identity is the key for a
// keyed node and the position for an unkeyed one, so a keyed node's path survives a reorder while
// an unkeyed one keeps the index positional matching gave it.
pub enum Seg {
    Index(val i: i32)
    Keyed(val i: i32, val key: Box<Key>)
}

pub datac Path(val segs: List<Seg>)

// The properties of one widget, as plain data: what a backend needs to make or update it and
// nothing else. `margin < 0` and `align < 0` mean unset, exactly as `Opts` does.
pub datac Props(
    var text: String,
    var size: i32,
    var bold: bool,
    var label: String,
    var checked: bool,
    var permille: i32,
    var spacing: i32,
    var height: i32,
    var margin: i32,
    var expand: bool,
    var align: i32,
    var classes: List<String>,
    var opacity: i32,
    var offset_x: i32,
    var offset_y: i32,
    var anim_main: anim.Anim,
    var anim_opacity: anim.Anim,
    var anim_ox: anim.Anim,
    var anim_oy: anim.Anim,
    var disabled: bool,
)

// What one render decided. `diff` emits only these four, and only when something actually changed:
// a matched node whose properties are identical produces nothing.
pub enum Patch {
    Create(val path: Path, val kind: i32, val props: Props)
    Update(val path: Path, val props: Props)
    Remove(val path: Path)
    Move(val path: Path, val to_index: i32)
}

// A widget counter set, reported by a backend after it applies a patch list.
//
// `memo_hits`, `memo_misses` and `view_calls` are the memoisation counters (Polyp v4 stage 4): a
// backend leaves them 0, and `core.stats()` fills them from the loop's last memo frame. `view_calls`
// counts calls of memoised view functions made to build the screen (the same events as the misses).
pub datac Stats(val created: i32, val updated: i32, val removed: i32, val live: i32, val memo_hits: i32, val memo_misses: i32, val view_calls: i32)

// One thing a display produced, or one thing a program asked the loop to do to it.
pub enum Event {
    Idle
    Post(val id: i32)
    Edit(val index: i32, val text: String)
    Focus(val index: i32)
    Quit
}

// A copy of an event, for a caller that holds a list of them and has to hand one out by value.
pub fun clone_event(e: &Event) => Event = when e {
    Idle -> Event.Idle
    Post(id) -> Event.Post(id = id)
    Edit(index, text) -> Event.Edit(index = index, text = String.from_str(text.as_str()))
    Focus(index) -> Event.Focus(index = index)
    Quit -> Event.Quit
}

// The other half of the declared key pair the note above the `Key` one explains.
fun Event.hash() => u64 = when self {
    Idle -> 1
    Post(id) -> hash_str("post") ^ id.to_u64()
    Edit(index, text) -> ((hash_str("edit") ^ index.to_u64()) * 31) ^ hash_str(text.as_str())
    Focus(index) -> hash_str("focus") ^ index.to_u64()
    Quit -> 2
}

fun Event.eq(other: &Event) => bool = when self {
    Idle -> when other {
        Idle -> true
        else -> false
    }
    Post(id) -> when other {
        Post(other_id) -> id == other_id
        else -> false
    }
    Edit(index, text) -> when other {
        Edit(other_index, other_text) -> index == other_index && str.eq(text.as_str(), other_text.as_str())
        else -> false
    }
    Focus(index) -> when other {
        Focus(other_index) -> index == other_index
        else -> false
    }
    Quit -> when other {
        Quit -> true
        else -> false
    }
}

// What a backend is. `apply` is one line in each backend: the walk that turns a path into a widget
// call is `apply_patches` below, so it lives in one place and cannot drift between backends.
pub trait Backend {
    fun mut Self.apply(patches: List<Patch>)
    // `make` and `patch` are the two widget writes; `at` is the place in the parent. A backend
    // gives an interactive widget an id by counting interactive `make` calls from zero, the same
    // rule the loop uses to turn a posted id back into a path.
    fun mut Self.make(path: &Path, at: i32, kind: i32, props: &Props)
    fun mut Self.patch_widget(path: &Path, props: &Props)
    fun mut Self.drop_widget(path: &Path)
    fun mut Self.place_widget(path: &Path, to_index: i32)
    fun mut Self.pump()
    fun mut Self.poll() => Event
    fun Self.path_of(id: i32) => option.Option<Path>
    fun Self.focus() => option.Option<i32>
    fun mut Self.set_focus(id: i32)
    fun mut Self.set_entry_text(id: i32, text: str)
    fun Self.entry_text(id: i32) => String
    fun Self.entry_ids() => List<i32>
    fun Self.entries_built() => i32
    fun Self.stats() => Stats
}

fun empty_path() => Path = Path(segs = List.empty())

pub fun copy_path(p: &Path) => Path {
    var segs: List<Seg> = List.empty()
    for item in p.segs {
        segs.push(clone_seg(item))
    }
    return Path(segs = segs)
}

pub fun clone_seg(s: &Seg) => Seg = when s {
    Index(i) -> Seg.Index(i = i)
    Keyed(i, key) -> Seg.Keyed(i = i, key = Box.of(clone_key(key.get())))
}

pub fun seg_for(key: &Key, i: i32) => Seg = if key_is_none(key) {
    Seg.Index(i = i)
} else {
    Seg.Keyed(i = i, key = Box.of(clone_key(key)))
}

pub fun seg_index(s: &Seg) => i32 = when s {
    Index(i) -> i
    Keyed(i, _) -> i
}

pub fun with_seg(parent: &Path, s: move Seg) => Path {
    var segs: List<Seg> = List.empty()
    for item in parent.segs {
        segs.push(clone_seg(item))
    }
    segs.push(s)
    return Path(segs = segs)
}

pub fun props_default() => Props = Props(
    text = "",
    size = 0,
    bold = false,
    label = "",
    checked = false,
    permille = 0,
    spacing = 0,
    height = 0,
    margin = -1,
    expand = false,
    align = -1,
    classes = List.empty(),
    opacity = 1000,
    offset_x = 0,
    offset_y = 0,
    anim_main = anim.none(),
    anim_opacity = anim.none(),
    anim_ox = anim.none(),
    anim_oy = anim.none(),
    disabled = false,
)

pub fun props_of<M>(node: &Node<M>) => Props {
    var p = props_default()
    when node {
        Column(_, spacing) -> {
            p.spacing = spacing
        }
        Row(_, spacing) -> {
            p.spacing = spacing
        }
        Text(text, size, bold) -> {
            p.text = String.from_str(text.as_str())
            p.size = size
            p.bold = bold
        }
        Spacer(height) -> {
            p.height = height
        }
        Entry(text, _) -> {
            p.text = String.from_str(text.as_str())
        }
        Button(label, _) -> {
            p.label = String.from_str(label.as_str())
        }
        Checkbox(label, checked, _) -> {
            p.label = String.from_str(label.as_str())
            p.checked = checked
        }
        Progress(permille) -> {
            p.permille = permille
        }
        Separator -> {}
        Scrolled(_, spacing) -> {
            p.spacing = spacing
        }
        Memo(_, _) -> {}
    }
    return p
}

fun apply_opts(p: mut Props, o: &Opts) {
    p.margin = o.margin
    p.expand = o.expand
    p.align = o.align
    p.opacity = o.opacity
    p.offset_x = o.offset_x
    p.offset_y = o.offset_y
    p.anim_main = anim.copy(&o.anim_main)
    p.anim_opacity = anim.copy(&o.anim_opacity)
    p.anim_ox = anim.copy(&o.anim_ox)
    p.anim_oy = anim.copy(&o.anim_oy)
    p.disabled = o.disabled
    for item in o.classes {
        p.classes.push(String.from_str(item.as_str()))
    }
}

pub fun child_props<M>(c: &Child<M>) => Props {
    var p = props_of(c.node.get())
    apply_opts(p, &c.opts)
    return p
}

fun opts_eq(a: &Opts, b: &Opts) => bool {
    if a.margin != b.margin || a.expand != b.expand || a.align != b.align { return false }
    if a.disabled != b.disabled || a.opacity != b.opacity || a.offset_x != b.offset_x || a.offset_y != b.offset_y {
        return false
    }
    if !anim.same(&a.anim_main, &b.anim_main) || !anim.same(&a.anim_opacity, &b.anim_opacity) {
        return false
    }
    if !anim.same(&a.anim_ox, &b.anim_ox) || !anim.same(&a.anim_oy, &b.anim_oy) { return false }
    if a.classes.len() != b.classes.len() { return false }
    var i: int = 0
    while i < a.classes.len() {
        if !str.eq(a.classes.get(i).as_str(), b.classes.get(i).as_str()) { return false }
        i += 1
    }
    return true
}

// Whether two nodes of the same kind carry the same properties. The kind is checked first, so a
// call with two different kinds is `false` without reading a field that is not there.
fun node_props_eq<M>(a: &Node<M>, b: &Node<M>) => bool = when a {
    Column(_, sa) -> when b {
        Column(_, sb) -> sa == sb
        else -> false
    }
    Row(_, sa) -> when b {
        Row(_, sb) -> sa == sb
        else -> false
    }
    Text(ta, za, ba) -> when b {
        Text(tb, zb, bb) -> str.eq(ta.as_str(), tb.as_str()) && za == zb && ba == bb
        else -> false
    }
    Spacer(ha) -> when b {
        Spacer(hb) -> ha == hb
        else -> false
    }
    Entry(ta, _) -> when b {
        Entry(tb, _) -> str.eq(ta.as_str(), tb.as_str())
        else -> false
    }
    Button(la, _) -> when b {
        Button(lb, _) -> str.eq(la.as_str(), lb.as_str())
        else -> false
    }
    Checkbox(la, ca, _) -> when b {
        Checkbox(lb, cb, _) -> str.eq(la.as_str(), lb.as_str()) && ca == cb
        else -> false
    }
    Progress(pa) -> when b {
        Progress(pb) -> pa == pb
        else -> false
    }
    Separator -> when b {
        Separator -> true
        else -> false
    }
    Scrolled(_, sa) -> when b {
        Scrolled(_, sb) -> sa == sb
        else -> false
    }
    Memo(_, _) -> when b {
        Memo(_, _) -> true
        else -> false
    }
}

// The first unused old index with this key, or -1.
fun find_key<M>(old: List<Child<M>>, used: List<bool>, key: &Key) => i32 {
    var j: int = 0
    while j < old.len() {
        if !used.get(j) && key_eq(old.get(j).key.get(), key) { return j.to_i32() }
        j += 1
    }
    return -1
}

// The pure matching engine. `old` is the tree the display holds now, `new` the tree `view`
// returned; the result is the minimal patch list that turns one into the other. Matching is key
// first, else position and kind; a duplicate key among one container's children panics, naming the
// key, before any patch is produced.
//
// `diff_into` is the shape a per-frame driver wants: the caller owns one `List<Patch>` and the
// engine clears and refills it, so after the largest frame the list's capacity stays put and no
// frame allocates the patch list again (`plan/polyp-v3.md`, stage 5). `diff` is the one-shot
// convenience the pure tests use; both go through the same engine, so they cannot disagree.
pub fun diff<M>(old: &Node<M>, new: &Node<M>) => List<Patch> {
    var out: List<Patch> = List.empty()
    diff_into(old, new, out)
    return out
}

// `diff_into` knows no memo store, so a `Memo` subtree in either tree is rebuilt every time (correct,
// just not skipped). `diff_memo_into` is the one that skips: see `MemoStore`.
pub fun diff_into<M>(old: &Node<M>, new: &Node<M>, out: mut List<Patch>) {
    var store: MemoStore<M> = new_memo_store()
    diff_memo_into(old, new, out, store)
}

pub fun diff_memo_into<M>(old: &Node<M>, new: &Node<M>, out: mut List<Patch>, store: mut MemoStore<M>) {
    out.clear()
    val root_path = empty_path()
    diff_node(root_path, old, new, out, store)
}

// ---------------------------------------------------------------------------------------------
// Memoisation (Polyp v4 stage 4).
//
// A `Memo` node is a placeholder the view builds cheaply: the deps and the function, not the
// subtree. The retained tree (`current`, which the loop diffs against) holds placeholders only.
// What the previous frame's deps and subtree were lives in the loop's `MemoStore`, one entry per
// memo, keyed by the memo's *identity*: the path to it with the index of every keyed segment left
// out (a keyed node keeps its identity when a reorder moves it). The diff of a matched pair of
// memo nodes asks the store: equal deps is a *hit* (nothing is called, nothing is compared, no
// patch is emitted for the subtree), otherwise a *miss*: the view function runs once, the new
// subtree is diffed against the stored one at `path + [0]`, and the entry is replaced. A memo
// created by the diff builds its subtree and records it; a memo removed (or replaced by something
// else) drops its entry and the entries nested below it.
//
// Counters: `hits`, `misses` and `view_calls` (one per call of a memoised view function made to
// build the screen; `take_message` rebuilds the subtree it needs on a click, which is not counted).
pub datac MemoEntry<M>(var ident: Path, var deps: Deps, var body: Box<Node<M>>)

pub datac MemoStore<M>(var entries: List<MemoEntry<M>>, var hits: i32, var misses: i32, var view_calls: i32, var hint: i32)

pub fun new_memo_store<M>() => MemoStore<M> = MemoStore<M>(entries = List.empty(), hits = 0, misses = 0, view_calls = 0, hint = 0)

// Two paths name the same memo when they have the same length and each segment agrees: keyed
// segments by key (ignoring the index), unkeyed ones by index.
fun ident_eq(a: &Path, b: &Path) => bool {
    if a.segs.len() != b.segs.len() { return false }
    var i: int = 0
    while i < a.segs.len() {
        if !seg_ident_eq(a.segs.get(i), b.segs.get(i)) { return false }
        i += 1
    }
    return true
}

fun seg_ident_eq(a: &Seg, b: &Seg) => bool = when a {
    Index(i) -> when b {
        Index(j) -> i == j
        else -> false
    }
    Keyed(_, ka) -> when b {
        Keyed(_, kb) -> key_eq(ka.get(), kb.get())
        else -> false
    }
}

// Whether `prefix` is `p` or one of its ancestors.
fun ident_prefix(prefix: &Path, p: &Path) => bool {
    if prefix.segs.len() > p.segs.len() { return false }
    var i: int = 0
    while i < prefix.segs.len() {
        if !seg_ident_eq(prefix.segs.get(i), p.segs.get(i)) { return false }
        i += 1
    }
    return true
}

fun mut MemoStore<M>.find(path: &Path) => i32 {
    val n = entries.len()
    var k: int = 0
    while k < n {
        val j = (hint.to_int() + k) % n
        if ident_eq(entries.get(j).ident, path) {
            hint = j.to_i32() + 1
            return j.to_i32()
        }
        k += 1
    }
    return -1
}

// Forget the memo at `path` and every memo nested below it.
fun mut MemoStore<M>.drop_under(path: &Path) {
    var i: int = entries.len()
    while i > 0 {
        i -= 1
        val inside = ident_prefix(path, entries.get(i).ident)
        if inside {
            val gone = entries.remove(i)
        }
    }
}

// A memo with no stored record at `path`: build its subtree, emit its creation at `path + [0]` and
// record it. The wrapper column itself is the caller's to create.
fun memo_build<M>(path: &Path, deps: &Deps, build: fun (&Deps) => List<Child<M>>, out: mut List<Patch>, store: mut MemoStore<M>) {
    store.drop_under(path)
    store.misses += 1
    store.view_calls += 1
    val body = run_build(deps, build)
    val bp = with_seg(path, Seg.Index(i = 0))
    out.push(Patch.Create(path = copy_path(bp), kind = kind_of_node(&body), props = props_of(&body)))
    create_subtree(bp, &body, out, store)
    store.entries.push(MemoEntry(ident = copy_path(path), deps = copy_deps(deps), body = Box.of(body)))
}

// A matched pair of memo nodes: hit, or miss and diff the subtree against the stored one.
fun memo_match<M>(path: &Path, deps: &Deps, build: fun (&Deps) => List<Child<M>>, out: mut List<Patch>, store: mut MemoStore<M>) {
    val at = store.find(path)
    if at >= 0 {
        val same = deps.eq(&store.entries.get(at.to_int()).deps)
        if same {
            store.hits += 1
            return
        }
    }
    if at < 0 {
        // The wrapper widget exists but nothing recorded its subtree (it was created through a
        // diff that had no store): replace the one child.
        val bp = with_seg(path, Seg.Index(i = 0))
        out.push(Patch.Remove(path = copy_path(bp)))
        memo_build(path, deps, build, out, store)
        return
    }
    store.misses += 1
    store.view_calls += 1
    val body = run_build(deps, build)
    val bp = with_seg(path, Seg.Index(i = 0))
    var e = store.entries.remove(at.to_int())
    diff_node(bp, e.body.get(), &body, out, store)
    e.body.set(body)
    e.deps = copy_deps(deps)
    var back = at.to_int()
    if back > store.entries.len() {
        back = store.entries.len()
    }
    store.entries.insert(back, e)
}

fun diff_node<M>(path: &Path, old: &Node<M>, new: &Node<M>, out: mut List<Patch>, store: mut MemoStore<M>) {
    val ko = kind_of_node(old)
    val kn = kind_of_node(new)
    if ko != kn {
        out.push(Patch.Remove(path = copy_path(path)))
        store.drop_under(path)
        out.push(Patch.Create(path = copy_path(path), kind = kn, props = props_of(new)))
        return
    }
    if is_memo(old) != is_memo(new) {
        // A memo and a plain column of the same key and kind: replace the whole widget.
        out.push(Patch.Remove(path = copy_path(path)))
        store.drop_under(path)
        out.push(Patch.Create(path = copy_path(path), kind = kn, props = props_of(new)))
        create_subtree(path, new, out, store)
        return
    }
    if !node_props_eq(old, new) {
        out.push(Patch.Update(path = copy_path(path), props = props_of(new)))
    }
    when old {
        Column(oc, _) -> when new {
            Column(nc, _) -> diff_children(path, oc, nc, out, store)
            else -> {}
        }
        Row(oc, _) -> when new {
            Row(nc, _) -> diff_children(path, oc, nc, out, store)
            else -> {}
        }
        Scrolled(oc, _) -> when new {
            Scrolled(nc, _) -> diff_children(path, oc, nc, out, store)
            else -> {}
        }
        Memo(_, _) -> when new {
            Memo(nd, nb) -> memo_match(path, nd, nb, out, store)
            else -> {}
        }
        else -> {}
    }
}

// A matched child: its own property update, then its subtree.
fun diff_matched<M>(path: &Path, old: &Child<M>, new: &Child<M>, out: mut List<Patch>, store: mut MemoStore<M>) {
    if !node_props_eq(old.node.get(), new.node.get()) || !opts_eq(old.opts, new.opts) {
        out.push(Patch.Update(path = copy_path(path), props = child_props(new)))
    }
    when old.node.get() {
        Column(oc, _) -> when new.node.get() {
            Column(nc, _) -> diff_children(path, oc, nc, out, store)
            else -> {}
        }
        Row(oc, _) -> when new.node.get() {
            Row(nc, _) -> diff_children(path, oc, nc, out, store)
            else -> {}
        }
        Scrolled(oc, _) -> when new.node.get() {
            Scrolled(nc, _) -> diff_children(path, oc, nc, out, store)
            else -> {}
        }
        Memo(_, _) -> when new.node.get() {
            Memo(nd, nb) -> memo_match(path, nd, nb, out, store)
            else -> {}
        }
        else -> {}
    }
}

// One container's children, in the four phases plan/polyp-v3.md fixes: updates and their subtrees,
// then removals from the highest old index down, then creations, then moves. The order is what
// makes every path valid at the moment its patch is applied.
fun diff_children<M>(parent: &Path, old: List<Child<M>>, new: List<Child<M>>, out: mut List<Patch>, store: mut MemoStore<M>) {
    var unmatched_key = false
    var used: List<bool> = List.empty()
    var u: int = 0
    while u < old.len() {
        used.push(false)
        u += 1
    }
    var matches: List<i32> = List.empty()
    var i: int = 0
    while i < new.len() {
        var m: i32 = -1
        if !key_is_none(new.get(i).key.get()) {
            // The common case first: the key is where it was, so no scan is needed (keys are
            // unique within a container, so this finds the same child `find_key` would).
            if i < old.len() && !used.get(i) && key_eq(old.get(i).key.get(), new.get(i).key.get()) {
                m = i.to_i32()
            } else {
                m = find_key(old, used, new.get(i).key.get())
            }
            // A memo and a plain node under one key are different widgets: no match.
            if m >= 0 && is_memo(old.get(m.to_int()).node.get()) != is_memo(new.get(i).node.get()) {
                m = -1
            }
        } else if i < old.len() && !used.get(i) && key_is_none(old.get(i).key.get()) && kind_of_node(new.get(i).node.get()) == kind_of_node(old.get(i).node.get()) {
            m = i.to_i32()
        }
        if m >= 0 {
            used.set(m.to_int(), true)
        } else if !key_is_none(new.get(i).key.get()) {
            unmatched_key = true
        }
        matches.push(m)
        i += 1
    }
    // Duplicate keys are checked only when some keyed child found no old child: two new children
    // with one key cannot both match the (unique-keyed) old list, so a duplicate always lands here,
    // and the common frame, where every key matched, skips an O(n^2) scan. Nothing has been emitted
    // yet, so the panic still comes before any patch.
    if unmatched_key {
        check_duplicate_keys(new)
    }

    // Updates, in new order, each followed by its subtree.
    var i2: int = 0
    while i2 < new.len() {
        val m = matches.get(i2)
        if m >= 0 {
            val p = with_seg(parent, seg_for(new.get(i2).key.get(), i2.to_i32()))
            diff_matched(p, old.get(m.to_int()), new.get(i2), out, store)
        }
        i2 += 1
    }

    // Removals, highest old index first, so a lower index is still the index it was.
    var j: i32 = old.len().to_i32() - 1
    while j >= 0 {
        if !used.get(j.to_int()) {
            val gone = with_seg(parent, seg_for(old.get(j.to_int()).key.get(), j))
            if !store.entries.is_empty() {
                store.drop_under(gone)
            }
            out.push(Patch.Remove(path = gone))
        }
        j -= 1
    }

    // Creations, in new order.
    var k: int = 0
    while k < new.len() {
        if matches.get(k) < 0 {
            val p = with_seg(parent, seg_for(new.get(k).key.get(), k.to_i32()))
            out.push(Patch.Create(path = copy_path(p), kind = kind_of_node(new.get(k).node.get()), props = child_props(new.get(k))))
            create_subtree(p, new.get(k).node.get(), out, store)
        }
        k += 1
    }

    // Moves, only when the matched sequence is not increasing: a monotonic match already keeps its
    // relative order, so nothing has to be reordered.
    var monotonic = true
    var last: i32 = -1
    for item in matches {
        val mm = item
        if mm >= 0 {
            if mm < last {
                monotonic = false
            }
            last = mm
        }
    }
    if !monotonic {
        diff_moves(parent, new, matches, old.len(), used, out)
    }
}

// The moves that put the children in the new order. The backend applies the patches in order, so
// the pass keeps the order the backend will hold: the matched old children in old order, each
// labelled with its new index, with each created child inserted at its new index (a create lands
// where its path says). Then for each target `t` in turn, if the child at `t` is not `new[t]`, that
// child moves to `t`. Positions before `t` are final by then, so each move is one step, whatever
// the old order was.
fun diff_moves<M>(parent: &Path, new: List<Child<M>>, matches: List<i32>, old_len: int, used: List<bool>, out: mut List<Patch>) {
    var old_to_new: List<i32> = List.empty()
    var u: int = 0
    while u < old_len {
        old_to_new.push(-1)
        u += 1
    }
    var i: int = 0
    while i < new.len() {
        val m = matches.get(i)
        if m >= 0 {
            old_to_new.set(m.to_int(), i.to_i32())
        }
        i += 1
    }
    var order: List<i32> = List.empty()
    var o: int = 0
    while o < old_len {
        if used.get(o) {
            order.push(old_to_new.get(o))
        }
        o += 1
    }
    var k: int = 0
    while k < new.len() {
        if matches.get(k) < 0 {
            order.insert(k, k.to_i32())
        }
        k += 1
    }
    var t: int = 0
    while t < new.len() {
        if order.get(t) != t.to_i32() {
            var p: int = t + 1
            while order.get(p) != t.to_i32() {
                p += 1
            }
            val mover = with_seg(parent, seg_for(new.get(t).key.get(), p.to_i32()))
            out.push(Patch.Move(path = mover, to_index = t.to_i32()))
            val lab = order.remove(p)
            order.insert(t, lab)
        }
        t += 1
    }
}

// Every child of a node the old tree did not have, depth first.
fun create_subtree<M>(path: &Path, node: &Node<M>, out: mut List<Patch>, store: mut MemoStore<M>) {
    when node {
        Column(children, _) -> create_children(path, children, out, store)
        Row(children, _) -> create_children(path, children, out, store)
        Scrolled(children, _) -> create_children(path, children, out, store)
        Memo(deps, build) -> memo_build(path, deps, build, out, store)
        else -> {}
    }
}

fun create_children<M>(parent: &Path, children: List<Child<M>>, out: mut List<Patch>, store: mut MemoStore<M>) {
    check_duplicate_keys(children)
    var i: int = 0
    while i < children.len() {
        val p = with_seg(parent, seg_for(children.get(i).key.get(), i.to_i32()))
        out.push(Patch.Create(path = copy_path(p), kind = kind_of_node(children.get(i).node.get()), props = child_props(children.get(i))))
        create_subtree(p, children.get(i).node.get(), out, store)
        i += 1
    }
}

// The whole tree as one create list, for the first render and for a test that wants a fresh tree.
pub fun create_all<M>(node: &Node<M>) => List<Patch> {
    var store: MemoStore<M> = new_memo_store()
    return create_all_memo(node, store)
}

// The first render of a tree that may hold `Memo` nodes: their subtrees are built and recorded in
// `store`, which the loop's later frames must be given.
pub fun create_all_memo<M>(node: &Node<M>, store: mut MemoStore<M>) => List<Patch> {
    var out: List<Patch> = List.empty()
    val p = empty_path()
    out.push(Patch.Create(path = copy_path(p), kind = kind_of_node(node), props = props_of(node)))
    create_subtree(p, node, out, store)
    return out
}

// The walk every backend's `apply` delegates to. It is the only place a path becomes a widget
// call, so the four phases and the id rule cannot drift between backends.
pub fun apply_patches<B: Backend>(backend: mut B, patches: List<Patch>) {
    for item in patches {
        when item {
            Create(path, kind, props) -> {
                // The root's path is empty, so it has no place inside a parent: `at` is 0 there and
                // a backend that owns the top level (a window, a canvas) puts it there.
                var at: i32 = 0
                if !path.segs.is_empty() {
                    at = seg_index(path.segs.get(path.segs.len() - 1))
                }
                backend.make(path = path, at = at, kind = kind, props = props)
            }
            Update(path, props) -> {
                backend.patch_widget(path = path, props = props)
            }
            Remove(path) -> {
                backend.drop_widget(path = path)
            }
            Move(path, to_index) -> {
                backend.place_widget(path = path, to_index = to_index)
            }
        }
    }
}

// The message a widget at `path` would post, taken out of a tree the caller owns. `view` is pure,
// so the loop rebuilds it and moves the message out of that copy: the tree the loop is diffing
// against has to stay whole, and a message cannot be moved out of a borrow.
pub fun take_message<B: Backend, M>(root: move Node<M>, path: &Path, backend: &B, id: i32) => option.Option<M> {
    return take_at(root, path, 0, backend, id)
}

fun take_at<B: Backend, M>(node: move Node<M>, path: &Path, depth: int, backend: &B, id: i32) => option.Option<M> {
    if depth >= path.segs.len() {
        return when node {
            Button(_, msg) -> option.Option.Some(value = unbox(msg))
            Checkbox(_, _, msg) -> option.Option.Some(value = unbox(msg))
            Entry(_, ctor) -> option.Option.Some(value = ctor(backend.entry_text(id)))
            else -> option.Option.None
        }
    }
    when node {
        Column(children, _) -> take_child(children, path, depth, backend, id)
        Row(children, _) -> take_child(children, path, depth, backend, id)
        Scrolled(children, _) -> take_child(children, path, depth, backend, id)
        Memo(deps, build) -> take_memo(deps, build, path, depth, backend, id)
        else -> option.Option.None
    }
}

// A click inside a memoised subtree: the placeholder holds no widgets, so the subtree is built here
// (not counted, and the store is not touched) and the rest of the path is followed into it. The
// wrapper column's only child is segment `Index(0)`.
fun take_memo<B: Backend, M>(deps: &Deps, build: fun (&Deps) => List<Child<M>>, path: &Path, depth: int, backend: &B, id: i32) => option.Option<M> {
    val want = path.segs.get(depth)
    val ok = when want {
        Index(i) -> i == 0
        else -> false
    }
    if !ok { return option.Option.None }
    val body = run_build(deps, build)
    return take_at(body, path, depth + 1, backend, id)
}

fun take_child<B: Backend, M>(children: move List<Child<M>>, path: &Path, depth: int, backend: &B, id: i32) => option.Option<M> {
    val want = path.segs.get(depth)
    var rest = children
    var i: int = 0
    while !rest.is_empty() {
        val c = rest.remove(0)
        if child_at(want, c.key.get(), i) {
            return take_at(unbox(c.node), path, depth + 1, backend, id)
        }
        i += 1
    }
    return option.Option.None
}

pub fun child_at(seg: &Seg, key: &Key, index: int) => bool = when seg {
    Index(i) -> key_is_none(key) && index.to_i32() == i
    Keyed(_, k) -> key_eq(k.get(), key)
}

fun seq() => atomic.Ordering = atomic.Ordering.SeqCst

// Zero the loop's counters before a run. A platform that drives its own frame clock resets them
// itself; `run` does it here so both entries agree.
pub fun reset_stats() {
    stat_created.store(value = 0, order = seq())
    stat_updated.store(value = 0, order = seq())
    stat_removed.store(value = 0, order = seq())
    stat_live.store(value = 0, order = seq())
    stat_entries.store(value = 0, order = seq())
    stat_memo_hits.store(value = 0, order = seq())
    stat_memo_misses.store(value = 0, order = seq())
    stat_view_calls.store(value = 0, order = seq())
    focus_seen_flag.store(value = false, order = seq())
    focus_lost_flag.store(value = false, order = seq())
}

// What one turn of the loop decided, and the tree it leaves behind. A backend that blocks in
// `pump` (GTK) loops on `run`; one whose platform delivers a frame clock calls `frame_step`
// itself and reads the variant. The tree travels by value because a `mut` parameter of an enum
// type cannot be reassigned in place.
pub enum Tick<M> {
    Idle(val tree: Node<M>)
    Changed(val tree: Node<M>)
    Quit(val tree: Node<M>)
}

// One turn: pump the display once, then drain its queue, running `update`/`view`/`diff`/`apply`
// for every message. `Quit` ends the program; `Changed` means at least one patch was applied.
pub fun frame_step<B: Backend, S, M>(backend: mut B, tree: move Node<M>, state: mut S, view: fun (S) => Node<M>, update: fun (mut S, M)) => Tick<M> {
    var scratch: List<Patch> = List.empty()
    return frame_step_into(backend = backend, tree = tree, state = state, view = view, update = update, scratch = scratch)
}

// `frame_step` with a caller-owned patch list: the loop clears and refills `scratch` for every
// message instead of building a fresh `List<Patch>`, so a driver that keeps one list across frames
// stops allocating the patch list once it has seen its largest frame (`plan/polyp-v3.md`, stage 5).
pub fun frame_step_into<B: Backend, S, M>(backend: mut B, tree: move Node<M>, state: mut S, view: fun (S) => Node<M>, update: fun (mut S, M), scratch: mut List<Patch>) => Tick<M> {
    var store: MemoStore<M> = new_memo_store()
    return frame_drain(backend = backend, tree = tree, state = state, view = view, update = update, scratch = scratch, store = store)
}

// `frame_step_into` for a tree that uses `Memo` nodes: the store (created with `new_memo_store`, and
// given to `create_all_memo` for the first render) is the caller's and lives as long as the program.
// The memo counters are published to `core.stats()` after the turn.
pub fun frame_step_memo<B: Backend, S, M>(backend: mut B, tree: move Node<M>, state: mut S, view: fun (S) => Node<M>, update: fun (mut S, M), scratch: mut List<Patch>, store: mut MemoStore<M>) => Tick<M> {
    val t = frame_drain(backend = backend, tree = tree, state = state, view = view, update = update, scratch = scratch, store = store)
    publish_memo(store)
    return t
}

pub fun publish_memo<M>(store: &MemoStore<M>) {
    stat_memo_hits.store(value = store.hits, order = seq())
    stat_memo_misses.store(value = store.misses, order = seq())
    stat_view_calls.store(value = store.view_calls, order = seq())
}

fun frame_drain<B: Backend, S, M>(backend: mut B, tree: move Node<M>, state: mut S, view: fun (S) => Node<M>, update: fun (mut S, M), scratch: mut List<Patch>, store: mut MemoStore<M>) => Tick<M> {
    var current = tree
    var changed = false
    var quitting = false
    // GTK: one blocking main-context iteration, so whatever a source posted is in the queue.
    // Headless: nothing to pump.
    backend.pump()
    var draining = true
    while draining {
        val ev = backend.poll()
        when ev {
            Idle -> draining = false
            Quit -> {
                quitting = true
                draining = false
            }
            Edit(index, text) -> {
                when entry_at(backend, index) {
                    Some(id) -> backend.set_entry_text(id = id, text = text.as_str())
                    None -> {}
                }
            }
            Focus(index) -> {
                when entry_at(backend, index) {
                    Some(id) -> backend.set_focus(id = id)
                    None -> {}
                }
            }
            Post(id) -> {
                when backend.path_of(id) {
                    Some(path) -> {
                        // The message comes from the tree the display is showing now, which
                        // is the state's own view, so it is that view rebuilt and consumed.
                        val probe = view(state)
                        when take_message(probe, path, backend, id) {
                            Some(msg) -> {
                                update(state, msg)
                                val focused = backend.focus()
                                val next = view(state)
                                diff_memo_into(current, next, scratch, store)
                                backend.apply(scratch)
                                current = next
                                snapshot(backend, focused)
                                changed = true
                            }
                            None -> {}
                        }
                    }
                    None -> {}
                }
            }
        }
    }
    if quitting { return Tick.Quit(tree = current) }
    if changed { return Tick.Changed(tree = current) }
    return Tick.Idle(tree = current)
}

// ---------------------------------------------------------------------------------------------
// Timers (Polyp v4 stage 1). An application's `subscriptions(state)` function returns the timers
// that should be running for that state, Elm's shape: the loop calls it after every turn, so a
// timer that is no longer in the list stops and one that appears starts. A `Sub` carries its message
// by value and the loop moves it out when the timer fires, so `M` needs no `clone`: because the list
// is rebuilt from the state each time, every firing gets a fresh message.
//
// A timer's identity is its position in the list, its kind and its period. The same position,
// kind and period on the next turn is the same timer (its schedule is kept); anything else is a new
// timer that starts counting from the clock of the turn it first appears in. A `Sub.After` that
// has fired stays fired for as long as it is still in the list at that position, so it does not
// fire twice; it re-arms when the list changes shape (the usual case: `update` clears the state
// that put it there).
//
// The clock is the platform's, in microseconds, delivered as `Tick` events (`soft/event.kp`); a
// platform that never delivers one has a clock stuck at 0 and no timer ever fires.
pub enum Sub<M> {
    Every(val ms: i32, val msg: Box<M>)
    After(val ms: i32, val msg: Box<M>)
}

// A repeating timer: `msg` is delivered when the period has elapsed, at most once per turn of the
// loop, and a turn that finds the timer several periods late fires it once and skips the missed
// periods (the next firing is the first period boundary after now).
pub fun every<M>(ms: i32, msg: move M) => Sub<M> = Sub.Every(ms = ms, msg = Box.of(msg))

// A one-shot timer: `msg` is delivered once, `ms` milliseconds after the timer first appears.
pub fun after<M>(ms: i32, msg: move M) => Sub<M> = Sub.After(ms = ms, msg = Box.of(msg))

pub datac TimerSlot(var kind: i32, var ms: i32, var due_us: u64, var done: bool)

// The loop's timer table: one slot per entry of the last `subscriptions` list.
pub datac Timers(var slots: List<TimerSlot>, var fired: i32)

pub fun new_timers() => Timers = Timers(slots = List.empty(), fired = 0)

// How many timer firings the table has delivered so far, for a test.
pub fun timers_fired(t: &Timers) => i32 = t.fired

// The clock value, in microseconds, at which the earliest armed timer is due, or -1 when no timer is
// armed. An OS that has gone to sleep wakes at this time (or on input) to run the next turn.
pub fun next_wake_us(t: &Timers) => i64 {
    var best: i64 = -1
    for item in t.slots {
        val sl = item
        if !sl.done {
            val due = sl.due_us.to_i64()
            if best < 0 || due < best {
                best = due
            }
        }
    }
    return best
}

// Reconcile slot `i` with the sub the state now asks for, and say whether it fires at `now`.
fun mut Timers.step(i: int, kind: i32, ms: i32, now: u64) => bool {
    var period_ms = ms
    if period_ms < 1 {
        period_ms = 1
    }
    val period: u64 = period_ms.to_u64() * 1000
    if i >= slots.len() {
        slots.push(TimerSlot(kind = kind, ms = period_ms, due_us = now + period, done = false))
        return false
    }
    val have_kind = slots.get(i).kind
    val have_ms = slots.get(i).ms
    val due = slots.get(i).due_us
    val done_already = slots.get(i).done
    if have_kind != kind || have_ms != period_ms {
        slots.set(i, TimerSlot(kind = kind, ms = period_ms, due_us = now + period, done = false))
        return false
    }
    if done_already || now < due { return false }
    if kind == SUB_EVERY {
        // Catch up by skipping: the next due time is the first boundary strictly after `now`.
        val late = now - due
        val skipped = late / period + 1
        slots.set(i, TimerSlot(kind = kind, ms = period_ms, due_us = due + skipped * period, done = false))
    } else {
        slots.set(i, TimerSlot(kind = kind, ms = period_ms, due_us = due, done = true))
    }
    fired += 1
    return true
}

// Take the messages of the timers that are due at `now`, in list order, and leave the table
// matching the list. A turn delivers a timer's message at most once, however late the turn is.
pub fun collect_due<M>(timers: mut Timers, subs: move List<Sub<M>>, now: u64) => List<M> {
    var out: List<M> = List.empty()
    var rest = subs
    var i: int = 0
    while !rest.is_empty() {
        val s = rest.remove(0)
        when s {
            Every(ms, msg) -> {
                if timers.step(i, SUB_EVERY, ms, now) {
                    out.push(unbox(msg))
                }
            }
            After(ms, msg) -> {
                if timers.step(i, SUB_AFTER, ms, now) {
                    out.push(unbox(msg))
                }
            }
        }
        i += 1
    }
    while timers.slots.len() > i {
        val last = timers.slots.len() - 1
        val dropped = timers.slots.remove(last)
    }
    return out
}

// `frame_step_into` with timers. After the queue is drained, `subs(state)` is asked for the timers
// the state now wants, the table is reconciled with it, and every timer that is due at `now_us`
// delivers its message to `update`; the view is then rebuilt and diffed once for all of them.
pub fun frame_step_full<B: Backend, S, M>(
    backend: mut B,
    tree: move Node<M>,
    state: mut S,
    view: fun (S) => Node<M>,
    update: fun (mut S, M),
    subs: fun (S) => List<Sub<M>>,
    scratch: mut List<Patch>,
    timers: mut Timers,
    store: mut MemoStore<M>,
    now_us: u64,
) => Tick<M> {
    val first = frame_drain(backend = backend, tree = tree, state = state, view = view, update = update, scratch = scratch, store = store)
    var changed = false
    var quitting = false
    var current = when first {
        Idle(t) -> t
        Changed(t) -> {
            changed = true
            t
        }
        Quit(t) -> {
            quitting = true
            t
        }
    }
    if !quitting {
        var due = collect_due(timers, subs(state), now_us)
        if !due.is_empty() {
            while !due.is_empty() {
                update(state, due.remove(0))
            }
            val focused = backend.focus()
            val next = view(state)
            diff_memo_into(current, next, scratch, store)
            backend.apply(scratch)
            current = next
            snapshot(backend, focused)
            changed = true
        }
    }
    publish_memo(store)
    if quitting { return Tick.Quit(tree = current) }
    if changed { return Tick.Changed(tree = current) }
    return Tick.Idle(tree = current)
}

// The counters and the entry count after a run, so a program that drove its own frames reads the
// same values `run` leaves behind. The entry texts are `diag.capture`'s, because the snapshot is a
// `List<String>` and cannot live in this module (plan/polyp-v3.md, stage 4).
pub fun publish<B: Backend>(backend: &B) {
    snapshot(backend, backend.focus())
    val st = backend.stats()
    stat_created.store(value = st.created, order = seq())
    stat_updated.store(value = st.updated, order = seq())
    stat_removed.store(value = st.removed, order = seq())
    stat_live.store(value = st.live, order = seq())
    stat_entries.store(value = backend.entries_built(), order = seq())
}

// What the loop runs on: the state, the tree it last showed, the patches between them, and the
// check that a patch kept the focused widget.
pub fun run<B: Backend, S, M>(backend: mut B, init: move S, view: fun (S) => Node<M>, update: fun (mut S, M)) => S {
    reset_stats()

    var state = init
    var tree = view(state)
    val first = create_all(&tree)
    val f0 = backend.focus()
    backend.apply(&first)
    snapshot(backend, f0)

    var running = true
    while running {
        when frame_step(backend, tree, state, view, update) {
            Idle(next) -> tree = next
            Changed(next) -> tree = next
            Quit(next) -> {
                tree = next
                running = false
            }
        }
    }

    publish(backend)
    return state
}

// The counters after one apply, and the focus check v2 did: a widget focused before a patch must
// still be the focused widget after it.
fun snapshot<B: Backend>(backend: &B, before: option.Option<i32>) {
    val st = backend.stats()
    stat_created.store(value = st.created, order = seq())
    stat_updated.store(value = st.updated, order = seq())
    stat_removed.store(value = st.removed, order = seq())
    stat_live.store(value = st.live, order = seq())
    when before {
        Some(id) -> {
            focus_seen_flag.store(value = true, order = seq())
            when backend.focus() {
                Some(now) -> {
                    if now != id {
                        focus_lost_flag.store(value = true, order = seq())
                    }
                }
                None -> focus_lost_flag.store(value = true, order = seq())
            }
        }
        None -> {}
    }
}

// The id of the index-th entry widget, in tree order, for the programmatic edit and focus
// channels. The `-1` the GTK queue answers with means "none pending", which is the `None` here.
fun entry_at<B: Backend>(backend: &B, index: i32) => option.Option<i32> {
    if index < 0 { return option.Option.None }
    val ids = backend.entry_ids()
    if index.to_int() >= ids.len() { return option.Option.None }
    return option.Option.Some(value = ids.get(index.to_int()))
}

pub fun stats() => Stats = Stats(
    created = stat_created.load(order = seq()),
    updated = stat_updated.load(order = seq()),
    removed = stat_removed.load(order = seq()),
    live = stat_live.load(order = seq()),
    memo_hits = stat_memo_hits.load(order = seq()),
    memo_misses = stat_memo_misses.load(order = seq()),
    view_calls = stat_view_calls.load(order = seq()),
)

// Whether every patch kept the focus widget it found.
pub fun focus_survived() => bool = !focus_lost_flag.load(order = seq())

// Whether a patch ever found a focus widget, so a run can tell "the focus stayed" from "there was
// no focus to keep".
pub fun focus_present() => bool = focus_seen_flag.load(order = seq())

pub fun entries_built() => i32 = stat_entries.load(order = seq())
