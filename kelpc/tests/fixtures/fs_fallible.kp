// MISSING-d6Qy1: the fallible twins of `read`/`read_text`/`open`, for a tree the
// caller did not author. A failure is an `io.IoErr` value carrying the errno and
// its text, not a panic.
impl "std/fs"
impl "std/mem"
impl "std/result"

fun main() {
    val text_path = "/tmp/kelp_fs_try_read.txt"
    val bin_path = "/tmp/kelp_fs_try_read.bin"
    result.expect(fs.writeText(text_path, "hello\n"), "fs.write_text: the call failed")

    // A byte that is not valid UTF-8, so `try_read_text` can be shown failing
    // without a syscall failing.
    var raw = mem.alloc(1)
    raw.set(0, 255)
    result.expect(fs.write(bin_path, raw), "fs.write: the call failed")

    val ok = fs.read(text_path)
    if let Ok(data) = ok {
        print(data)
    }

    val missing = fs.read("/tmp/kelp_fs_no_such_dir/probe")
    if let Err(e) = missing {
        print(e.errno.to_i64())
        print(e.message)
    }

    val text = fs.readText(text_path)
    if let Ok(t) = text {
        print(t)
    }

    val binary = fs.readText(bin_path)
    if let Err(e) = binary {
        print(e.errno.to_i64())
        print(e.message)
    }

    val opened = fs.open(text_path, "r")
    if let Ok(file) = opened {
        print(file.isOpen())
        file.close()
    }

    val bad_mode = fs.open(text_path, "q")
    if let Err(e) = bad_mode {
        print(e.errno.to_i64())
    }

    val no_file = fs.open("/tmp/kelp_fs_no_such_dir/probe", "r")
    if let Err(e) = no_file {
        print(e.errno.to_i64())
    }

    result.expect(fs.remove(text_path), "fs.remove: the call failed")
    result.expect(fs.remove(bin_path), "fs.remove: the call failed")
}
