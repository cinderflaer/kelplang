// Release goal 1, hardening (case g): the server name. The harness gives the
// client a `localhost`-only certificate and starts the server on `127.0.0.1`; the
// client hands `handshake` the name `localhost` even though it dialed the
// address. The server records the name it was actually sent through SNI, and the
// test asserts it is that same string, not the address the socket resolved to.
impl "std/net"
impl "std/process"
impl "std/result"
impl "std/str"
impl "std/tls"

fun err_name(e: move tls.TlsError) => String = when e {
    Untrusted -> String.from_str("untrusted")
    Expired -> String.from_str("expired")
    HostMismatch -> String.from_str("host_mismatch")
    ProtocolTooOld -> String.from_str("protocol_too_old")
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> String.from_str("peer_closed_uncleanly")
    Timeout -> String.from_str("timeout")
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun fail(e: move tls.TlsError) => tls.TlsStream {
    val text = err_name(e)
    panic(text.as_str())
}

fun fail_unit(e: move tls.TlsError) {
    val text = err_name(e)
    panic(text.as_str())
}

fun main() {
    val args = process.args()
    val parsed = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "tls_sni: argv[1] is not a port number",
    )
    val host = args.get(2)
    var s = net.connect("127.0.0.1", parsed.to_u16())
    s.set_timeout(5000)
    val hs = tls.try_handshake(s, host.as_str())
    when hs {
        Ok(t) -> {
            print("ok")
            val sd = tls.try_shutdown(t)
        }
        Err(e) -> print(err_name(e))
    }
    net.close(s)
}
