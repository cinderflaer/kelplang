// Release goal 1: the Ok path of every `try_` function in `std/tls`, against
// the local TLS server. The harness points `SSL_CERT_FILE` at the server's own
// certificate, which is `std/tls`'s default store, so the handshake verifies;
// that the variable is honoured at all is half of what this fixture proves.
impl "std/mem"
impl "std/net"
impl "std/tls"
impl "std/process"
impl "std/str"
impl "std/result"

fun server_port() => u16 {
    val args = process.args()
    val p = result.expect(
        r = str.parseU64(args.get(1).as_str()),
        message = "server_port: argv[1] is not a port number",
    )
    return p.to_u16()
}

fun fail(e: move tls.TlsError) => tls.TlsStream {
    val text = tls.errorText(e)
    panic(text)
}

fun exercise(t: tls.TlsStream) {
    val w = tls.write(t, Bytes.from_str("GET /a HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n"))
    print(result.isOk(r = w))
    val wa = tls.writeAll(t, Bytes.from_str("GET /b HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n"))
    print(result.isOk(r = wa))
    var buf = mem.alloc(64)
    val rd = tls.readInto(t, buf, 0)
    print(result.isOk(r = rd))
    val r = tls.read(t, 64)
    print(result.isOk(r = r))
    val sd = tls.shutdown(t)
    print(result.isOk(r = sd))
}

fun main() {
    var s = result.expect(net.connect("127.0.0.1", server_port()), "net.connect: the call failed")
    s.setTimeout(5000)
    val hs = tls.handshake(s, "127.0.0.1")
    val t = when hs {
        Ok(v) -> v
        Err(e) -> fail(e)
    }
    exercise(t)
    net.close(s)
}
