// Four related rules a real program (an 807-line JSON library, written with no
// access to the compiler) found by compiling it for the first time.
impl "std/str"
impl "std/fmt"
impl "std/result"

enum J {
    S(val x: String)
    N
}

// 1. **A view derived through a pattern binding keeps its provenance.** `s` is
//    a shared borrow of `v`'s payload, so returning a view of it returns a
//    view of `v`, the same thing `v.x.as_str()` (already accepted) returns.
fun as_str(v: &J).return: &str {
    if let S(s) = v {
        return s.as_str()
    }
    // 2. **A `panic` tail diverges**, so it satisfies a borrowed return type:
    //    it is not "the returned value" at all. `infer.rs` has always said so
    //    for the type; the borrow checker's tail check had not learned it.
    panic("not a string")
}

// 3. **`str` and `&str` agree**, and join to the borrow. They are one type at
//    every use site (`str.eq`, `print`, a `str` parameter), `is_str_like` says
//    so, and arm unification was the one place comparing them by identity.
//    A total version of the same accessor, so the arms below can be exercised
//    on either variant without panicking.
fun text_or(v: &J).return: &str {
    if let S(s) = v {
        return s.as_str()
    }
    return "none"
}

fun joined(v: &J, c: bool).return: bool {
    // A borrowed arm and a literal arm in one `if`, which used to be
    // "'if/else branches have different types: '&str' and 'str'".
    val w = if c { text_or(v) } else { "n" }
    return str.eq(w, "hello")
}

//    The same join at a *return*, where the merged root also has to be one
//    owner: `as_str(v)` borrows `v`, and `"d"` is static, so the value has a
//    single owner and that owner is `v`.
fun either(v: &J, c: bool).return: &str {
    return if c { text_or(v) } else { "d" }
}

//    What is *not* expressible, and why: when a whole `when` is the returned
//    value, the arms are checked (and their scopes pop) before the merged root
//    is computed, so a payload binding is gone by then. Return from inside the
//    arm instead, the form `as_str` above uses, and the form every accessor
//    over an owned payload wants.

// 4. **A borrow taken inside an initializer ends with the statement.** The
//    `cand.as_str()` borrow is for the length of one call and nothing of it
//    survives (`Result<i64, _>` owns its data), so `cand` can still be moved
//    a few lines later. Before this the borrow was held to the end of the
//    block and `return cand` was refused.
fun round_trip(n: i64).return: String {
    val cand = fmt.int(n)
    val back = str.parse_i64(cand.as_str())
    if let Ok(v) = back {
        if v == n {
            return cand
        }
    }
    return fmt.int(n)
}

datac P(val text: String, val n: usize)

fun P.tag().return: usize = n

// 5. **A `Copy` value is never moved**, so reading one while a borrow of it is
//    live is allowed, and, before this, `self` (a `&mut P` inside a `mut`
//    method: a pointer, and Copy) was reported as "cannot move 'self' while it
//    is borrowed" for a read that moves nothing.
fun P.check().return: bool {
    val t = text.as_str()
    return str.eq(t, "x") && self.tag() > 0
}

fun main() {
    val s = J.S(x = "hello")
    val n = J.N
    print(as_str(s))
    print(joined(s, true))
    print(joined(n, true))
    print(joined(n, false))
    print(either(s, true))
    print(either(n, true))
    print(round_trip(42))
    val p = P(text = "x", n = 3)
    print(p.check())
    val q = P(text = "y", n = 3)
    print(q.check())
}
