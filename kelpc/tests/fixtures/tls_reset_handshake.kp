// Release goal 1, hardening (case d, half one): the peer resets the TCP
// connection during the handshake. The local server accepts, never reads the
// ClientHello, and closes with it still unread, which is a TCP RST rather than a
// FIN. `try_handshake` must come back as a typed error at once, not hang and not
// claim success.
impl "std/net"
impl "std/process"
impl "std/result"
impl "std/str"
impl "std/tls"

fun err_name(e: move tls.TlsError) => String = when e {
    Untrusted -> "untrusted"
    Expired -> "expired"
    HostMismatch -> "host_mismatch"
    ProtocolTooOld -> "protocol_too_old"
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> "peer_closed_uncleanly"
    Timeout -> "timeout"
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun fail(e: move tls.TlsError) => tls.TlsStream {
    val text = err_name(e)
    panic(text)
}

fun fail_unit(e: move tls.TlsError) {
    val text = err_name(e)
    panic(text)
}

fun arg_port() => u16 {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "tls_reset_handshake: argv[1] is not a port number",
    )
    return p.to_u16()
}

fun main() {
    var s = result.expect(net.connect("127.0.0.1", arg_port()), "net.connect: the call failed")
    s.set_timeout(5000)
    val hs = tls.handshake(s, "127.0.0.1")
    when hs {
        Ok(_) -> print("ok")
        Err(e) -> print(err_name(e))
    }
    net.close(s)
}
