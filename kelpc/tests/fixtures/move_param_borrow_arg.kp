// A-4: a borrow cannot be moved out of. The callee's own parameter `s` is a
// `&String`, so handing it to a `move String` parameter would take ownership
// of something the caller still owns, refused, with the fix named.
fun consume(s: move String) => int = s.len()

fun forward(s: String) => int = consume(s)

fun main() {
    print(forward("x"))
}
