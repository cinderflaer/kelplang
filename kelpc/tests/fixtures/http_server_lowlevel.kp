// st2: the server's request accessors and its low-level API, in one process over
// loopback (the server and the client are both this program, so nothing waits on
// a peer that is not there: every byte is written before it is read).
impl "std/http" caps(net = ["127.0.0.1:*"])
impl "std/net"
impl "std/option"
impl "std/str"
impl "std/result"

fun show_opt(o: move option.Option<String>) => String {
    return when o {
        Some(s) -> s
        None -> "<none>"
    }
}

fun show(o: move option.Option<String>) {
    val s = show_opt(o)
    print(s)
}

fun main() {
    // The defaults every server starts from.
    val lim = http.default_limits()
    print(lim.max_request_line)
    print(lim.max_header_bytes)
    print(lim.max_headers)
    print(lim.max_body)
    print(lim.head_timeout_ms)
    print(lim.body_timeout_ms)
    print(lim.idle_timeout_ms)
    print(lim.max_requests_per_conn)

    // The accessors on a request built by hand.
    var hs: List<http.Header> = List.empty()
    hs.push(http.Header(name = "X-One", value = "1"))
    hs.push(http.Header(name = "x-one", value = "2"))
    val req = http.ServerRequest(
        method = "GET",
        target = "/a/b%20c//d/?x=1&y=%41+b&flag&e=&x=2&bad=%zz",
        path = "/a/b%20c//d/",
        query = "x=1&y=%41+b&flag&e=&x=2&bad=%zz",
        headers = hs,
        body = Bytes.empty(),
    )
    val segs = req.pathSegments()
    print(segs.len())
    print(segs.get(1).as_str())
    print(segs.get(2).as_str())
    show(req.queryParam("x"))
    show(req.queryParam("y"))
    show(req.queryParam("flag"))
    show(req.queryParam("e"))
    show(req.queryParam("bad"))
    show(req.queryParam("missing"))
    val one = req.header("X-ONE")
    print(one)
    print(req.hasHeader("X-one"))
    print(req.hasHeader("x-two"))

    // The low-level loop: accept, read a request, answer, read the next.
    val server = http.listen(0)
    val client = result.expect(net.connect("127.0.0.1", server.port()), "net.connect: the call failed")
    net.sendText(client, "GET /p?q=1 HTTP/1.1\r\nHost: h\r\n\r\nPOST /e HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\n\r\nhi")
    result.expect(net.shutdownWrite(client), "net.shutdown_write: the call failed")
    var conn = result.expect(server.accept(), "accept: the call failed")
    val first = conn.read_request(&lim)
    when first {
        Ok(r) -> {
            print(r.method)
            print(r.path)
            print(r.query)
            val resp = http.okText("one")
            val w = conn.write_response(&resp)
        }
        Err(_) -> print("unexpected error")
    }
    val second = conn.read_request(&lim)
    when second {
        Ok(r) -> {
            print(r.method)
            print(r.body.len())
            val base = http.json("{}")
            val resp = base.withHeader("X-Seen", "yes")
            val w = conn.write_response(&resp)
        }
        Err(_) -> print("unexpected error")
    }
    // The client has shut its side down: a clean end between requests is an
    // error with no status, which `write_error` answers with nothing.
    val third = conn.read_request(&lim)
    when third {
        Ok(_) -> print("unexpected request")
        Err(e) -> {
            print(http.httpErrorStatus(&e))
            val w = conn.write_error(&e)
        }
    }
    print(conn.wants_close())
    conn.close()
    val got = result.expect(net.recv(client, 4096), "net.recv: the call failed")
    print(got)
    net.close(client)

    // A refused request is answered by `write_error` with its status.
    val bad = result.expect(net.connect("127.0.0.1", server.port()), "net.connect: the call failed")
    net.sendText(bad, "GET / HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\nContent-Length: 4\r\n\r\n")
    var conn2 = result.expect(server.accept(), "accept: the call failed")
    val r2 = conn2.read_request(&lim)
    when r2 {
        Ok(_) -> print("unexpected request")
        Err(e) -> {
            print(http.httpErrorStatus(&e))
            val w = conn2.write_error(&e)
        }
    }
    conn2.close()
    val got2 = result.expect(net.recv(bad, 4096), "net.recv: the call failed")
    print(got2)
    net.close(bad)
    server.close()
}
