// Release goal 1, hardening (case e): 64 concurrent TLS clients. Every worker
// opens its own connection, handshakes, sends a request that carries its own id,
// and compares the echo it reads back byte for byte against what it sent: a
// stream that crossed with another worker's either reads a different id or fails
// its handshake. The file-descriptor count of `/proc/self/fd` is taken before any
// worker starts and after every one is joined, so a descriptor that was never
// closed is a difference here rather than a slow leak.
impl "std/fs"
impl "std/net"
impl "std/process"
impl "std/result"
impl "std/str"
impl "std/thread"
impl "std/tls"

// What one worker needs: where to dial and which id it is.
datac Job(val port: i32, val id: i64)

fun fail(e: move tls.TlsError) => tls.TlsStream {
    val text = tls.error_text(e)
    panic(text)
}

fun fail_unit(e: move tls.TlsError) {
    val text = tls.error_text(e)
    panic(text)
}

fun arg_port() => i32 {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "tls_concurrent: argv[1] is not a port number",
    )
    return p.to_u16().to_i32()
}

// How many descriptors this process holds right now, read out of the kernel's own
// listing. The listing call itself opens one directory descriptor and closes it
// again before returning, so the two counts are taken the same way.
fun fd_count() => int {
    val listing = result.expect(fs.list("/proc/self/fd"), "fs.list: the call failed")
    return listing.len()
}

fun worker(j: move Job) => i32 {
    val id_text = str.from_i64(j.id)
    var req = String.with_capacity(64)
    req.push_str("GET /")
    req.push_str(id_text)
    req.push_str(" HTTP/1.1\r\nHost: 127.0.0.1\r\nX-Id: ")
    req.push_str(id_text)
    req.push_str("\r\n\r\n")
    var s = result.expect(net.connect("127.0.0.1", j.port.to_u16()), "net.connect: the call failed")
    s.set_timeout(20000)
    val hs = tls.handshake(s, "127.0.0.1")
    // A failed handshake panics with its own text: the joiner turns that into a
    // mismatch, and the panic names which worker and why rather than a bare 0.
    val t = when hs {
        Ok(v) -> v
        Err(e) -> fail(e)
    }
    val sent = tls.write_all(t, req.clone().into_bytes())
    when sent {
        Ok(_) -> {}
        Err(e) -> fail_unit(e)
    }
    var got = Bytes.empty()
    var reading = true
    while reading {
        val r = tls.read(t, 4096)
        when r {
            Ok(b) -> {
                if b.is_empty() {
                    reading = false
                } else {
                    got.append(b)
                }
            }
            Err(e) -> fail_unit(e)
        }
    }
    val ok = str.eq(got.as_str(), req.as_str())
    val sd = tls.shutdown(t)
    net.close(s)
    if ok {
        return 1
    }
    return 0
}

