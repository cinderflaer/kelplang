// std/regex cost: the patterns that make a backtracking engine take
// exponential time finish at once with the right answer, and the VM's step
// counter grows linearly with the input (up to a 1 MiB scan).
impl "std/regex"
impl "std/option"
impl "std/result"
impl "std/str"

fun compile_or_die(pat: &str) => regex.Regex {
    val r = regex.compile(pat)
    if let Ok(re) = r {
        return re
    }
    panic("bad pattern in the fixture")
}

fun repeated(unit: &str, times: usize, tail: &str) => String {
    var s = String.with_capacity(str.len(unit) * times + str.len(tail))
    var i: usize = 0
    while i < times {
        s.push_str(unit)
        i += 1
    }
    s.push_str(tail)
    return s
}

fun span_of(re: mut regex.Regex, text: &str) => String {
    val m = re.find(text)
    if let Some(x) = m {
        return str.concat("match ", x.text.as_str())
    }
    return String.from_str("none")
}

// The steps one `find` over `text` takes with a fresh counter.
fun steps_of(re: mut regex.Regex, text: &str) => i64 {
    re.reset_steps()
    val m = re.find(text)
    return re.steps()
}

fun main() {
    // Each of these is exponential for a backtracker.
    val bad_a = repeated("a", 30, "b")
    var p1 = compile_or_die("(a+)+$")
    print(p1.is_match(bad_a))
    val s1 = steps_of(p1, bad_a.as_str())
    print(s1 < 5000)
    var p2 = compile_or_die("(a|aa)+$")
    print(p2.is_match(bad_a))
    print(steps_of(p2, bad_a.as_str()) < 5000)
    val bad_x = repeated("x", 30, "")
    var p3 = compile_or_die("(x+x+)+y")
    print(p3.is_match(bad_x))
    print(steps_of(p3, bad_x.as_str()) < 5000)

    // The same patterns, with an input that does match, give the right span.
    val good_a = repeated("a", 30, "")
    print(span_of(p1, good_a.as_str()))
    print(span_of(p2, good_a.as_str()))
    val good_x = repeated("x", 30, "y")
    print(span_of(p3, good_x.as_str()))
    val mid = repeated("a", 20, "b")
    print(span_of(p2, mid.as_str()))

    // Longer inputs of the exponential kind: 200 a's.
    val long_a = repeated("a", 200, "b")
    print(p1.is_match(long_a))
    print(steps_of(p1, long_a.as_str()) < 100000)

    // Linearity on the step counter: doubling the input at most doubles the
    // steps (within a small factor), up to 1 MiB.
    var lin = compile_or_die("(foo|bar)[0-9]+x")
    val unit = "foo123 bar45 baz "
    val t1 = repeated(unit, 15000, "")
    val t2 = repeated(unit, 30000, "")
    val t4 = repeated(unit, 60000, "")
    print(str.len(t4) > 1000000)
    val n1 = steps_of(lin, t1.as_str())
    val n2 = steps_of(lin, t2.as_str())
    val n4 = steps_of(lin, t4.as_str())
    print(n1 > 0)
    print(n2 <= 2 * n1 + 100)
    print(n4 <= 2 * n2 + 100)
    print(n2 >= n1)
    print(n4 <= 40 * str.len(t4).to_i64())
    print(span_of(lin, t4.as_str()))

    // A 1 MiB scan with a capturing pattern and a match at the very end.
    var caps = compile_or_die("(\\d+)-(\\d+)$")
    val big = repeated("ab ", 350000, "12-345")
    val m = caps.captures(big)
    if let Some(c) = m {
        val g1 = c.get(1)
        val g2 = c.get(2)
        if let Some(a) = g1 {
            print(a)
        }
        if let Some(b) = g2 {
            print(b)
        }
    }
    print(caps.steps() <= 80 * str.len(big).to_i64())
}
