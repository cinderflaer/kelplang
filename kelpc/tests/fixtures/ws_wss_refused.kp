// MISSING-k4Nvz: `wss://` is refused by name, because v1 has no TLS. TLS is a
// decision the owner has not made (`MISSING-XkcSp`), so a client that quietly
// spoke `ws://` to a TLS port, or one that parsed the URL and failed later,
// would both be worse than this: the refusal says which scheme is missing and
// why.
//
// The grant is written for the host the URL names, so the refusal cannot be
// the capability check: this program is admitted all the way to `parse_url`,
// and the panic is about the scheme alone.
impl "std/ws" caps(net = ["gateway.discord.gg:443"], rand = [])

fun main() {
    val u = ws.parse_url("wss://gateway.discord.gg/?v=10&encoding=json")
    print(u.host)
}
