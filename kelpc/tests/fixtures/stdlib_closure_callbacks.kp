// A-4 phase E: the stdlib callbacks take *closures*, so a callback can carry a
// binding from the frame that passes it, which is what a closure is for. The
// five callback helpers in `std/option`, `std/result` and `std/list` are
// declared with `closure(...)` parameters, and a plain function value is
// widened into one: a declared `fun` or a non-capturing literal needs a
// generated shim and allocates nothing, while a function value whose identity
// is not known until the call gets a one-field environment and a thunk.
//
// In the AddressSanitizer list: each capturing callback owns an environment,
// and one of them captures an owned `String`.
impl "std/list"
impl "std/option"
impl "std/result"
impl "std/str"

fun inc(x: i32) => i32 = x + 1

fun pick(which: bool) => fun(i32) => i32 {
    if which {
        return inc
    }
    return fun(x: i32) => i32 = x * 10
}

fun main() {
    var xs: List<i32> = List.empty()
    xs.push(1)
    xs.push(2)
    xs.push(3)

    // A capturing callback: the environment carries `factor`, so `map` needs no
    // argument passed twice.
    val factor = 3
    val scaled = list.map(xs, fun(x: &i32) => i32 = x * factor)
    print(scaled.get(0))
    print(scaled.get(2))

    // A capturing predicate, a capturing action, and one that captures an
    // *owned* value, the environment owns it and frees it with the closure.
    val limit = 1
    print(list.any(xs, fun(x: &i32) => bool = x > limit))
    val tag = String.from_str("v")
    list.each(xs, fun(x: &i32) {
        print!(str.concat(tag, "="))
        print!(x)
    })
    print("")

    // A declared function and a non-capturing literal are widened too, the
    // named one through a generated shim, so this allocates nothing.
    print(list.map(xs, inc).get(0))
    print(list.all(xs, fun(x: &i32) => bool = x > 0))

    // A function value whose identity is known only at the call: the wrapper
    // is a heap environment holding the pointer plus a thunk.
    val chosen = pick(true)
    print(list.map(xs, chosen).get(2))

    // The same widening through `option` and `result`.
    val some = option.Option.Some(value = 7)
    val add = 100
    print(option.expect(o = option.map(o = some, f = fun(x: &i32) => i32 = x + add), message = "none"))
    val ok: result.Result<i32, i32> = result.Result.Ok(value = 4)
    val err: result.Result<i32, i32> = result.Result.Err(error = 5)
    print(result.unwrap_err(r = result.map_err(r = err, f = fun(e: &i32) => i32 = e * limit)))
    print(result.expect(r = result.map(r = ok, f = fun(x: &i32) => i32 = x * factor), message = "unreachable"))
}
