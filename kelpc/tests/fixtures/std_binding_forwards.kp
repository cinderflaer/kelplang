// Issue #294: std functions that only forward to a C symbol are bindings
// (`extern fun f(...) => T = "sym"`). Callers see the same names, arguments
// and results as the wrappers they replaced.
impl "std/math"
impl "std/str"

fun main() {
    print(math.floor(x = 2.75) == 2.0)
    print(str.len("héllo"))
    print(str.substring("hello", 2))
    print(str.byte("abc", 1))
    print(math.isNan(x = 0.0))
}
// stdout-begin
// stdout: true
// stdout: 6
// stdout: llo
// stdout: 98
// stdout: false
