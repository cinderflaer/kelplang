impl "std/iter"

fun main() {
    var xs: List<i64> = List.empty()
    xs.push(5)
    xs.push(6)
    xs.push(7)
    xs.push(8)
    var evens = iter.filter(iter.into_iter(xs), fun(x: &i64) => bool = x % 2 == 0)
    var doubled = iter.map(evens, fun(x: &i64) => i64 = x * 10)
    for v in doubled {
        print(v)
    }
    for pair in iter.enumerate(iter.range(10, 13)) {
        val (i, v) = pair
        print(i)
        print(v)
    }
    for p in iter.zip(iter.range(0, 5), iter.range(100, 102)) {
        val (a, b) = p
        print(a + b)
    }
    for c in iter.chain(iter.range(1, 3), iter.range(7, 9)) {
        print(c)
    }
    val words = iter.collect_list(iter.take(iter.skip(iter.range(0, 50), 3), 4))
    print(words.len())
    print(iter.sum_i64(iter.map(iter.range(1, 4), fun(x: &i64) => i64 = x * x)))
}
