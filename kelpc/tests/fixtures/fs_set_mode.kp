// `fs.set_mode` writes the permission bits `Metadata.mode` reads: a file is made
// executable and the new bits are read back, then restored.
impl "std/fs"
impl "std/result"

fun main() {
    val path = "/tmp/kelp_fs_set_mode.txt"
    result.expect(fs.writeText(path, "x"), "fs.write_text: the call failed")
    fs.setMode(path, 420)
    print(fs.metadata(path).mode)
    fs.setMode(path, 493)
    print(fs.metadata(path).mode)
    result.expect(fs.remove(path), "fs.remove: the call failed")
}
