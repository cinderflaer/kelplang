// `select3` with no ready case blocks until one is. Every channel is open and
// empty when the select starts, so it must wait for the worker, which sends on
// channel 2 after a pause. The answer is index 2 with 42, and the two channels
// that stay open never report closed.
impl "std/thread"
impl "std/result"
impl "std/option"
impl "std/sync"

fun late(tx: move sync.Sender<i64>) {
    thread.sleep_ms(30)
    val back = tx.send(42)
}

fun show(p: move sync.Pick<i64>) {
    when p {
        Got(i, v) -> {
            print(i)
            print(v)
        }
        Closed(i) -> {
            print(i)
            print("closed")
        }
    }
}

fun main() {
    val (tx_a, rx_a) = sync.bounded<i64>(1)
    val (tx_b, rx_b) = sync.bounded<i64>(1)
    val (tx_c, rx_c) = sync.bounded<i64>(1)
    val h = thread.spawn(late, tx_c)
    show(sync.select3(&rx_a, &rx_b, &rx_c))
    when thread.join(h) {
        Ok(_) -> {}
        Err(e) -> print(e.message)
    }
}
