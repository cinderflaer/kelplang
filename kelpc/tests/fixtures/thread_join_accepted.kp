// MK9-S3-M1 stage C1: `thread.join` takes a `Thread<T>` handle and hands back
// `Result<T, ThreadErr>`. A handle can only be made by `thread.spawn`, so the
// surface is exercised through a parameter: a `Thread<i64>` is accepted as a
// parameter (and as a `datac` field and an `enum` payload, below), which is what
// the surface says. `consume` is never called, so nothing is joined at run time;
// what this fixture pins is that a handle's own type reaches both backends.
impl "std/thread"
impl "std/result"

datac Holder(val h: Thread<i64>)

enum Job {
    Run(val h: Thread<i64>)
}

fun consume(h: move Thread<i64>) {
    val r = thread.join(h)
    print(0)
}

fun main() {
    print(1)
}
