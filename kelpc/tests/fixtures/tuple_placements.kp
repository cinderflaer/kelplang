// MISSING-z2bB9: a tuple follows the element rules of every position it may
// appear in, so it is a `List` element, a `Map` key and value, a `Box` element,
// an array element, an `enum` payload and a generic argument
// (`plan/syntax.md` 3).
datac Pt(val x: i32, val y: i32)

enum Shape {
    Empty
    Seg(val pair: (i32, i32))
}

fun main() {
    val s = Shape.Seg(pair = (5, 6))
    when s {
        Empty -> print("empty")
        Seg(p) -> {
            val (a, b) = p
            print(a * b)
        }
    }

    var b: Box<(i32, i32)> = Box.of((7, 8))
    val (bx, by) = b.take()
    print(bx + by)

    var arr: [(i32, i32); 2] = [(1, 2), (3, 4)]
    val (ax, ay) = arr.get(i = 0)
    print(ax + ay)

    // A tuple key is keyable by derivation, exactly as a `datac` key is: the
    // derived hash and equality walk the positions in order.
    var m: Map<(i32, i32), i32> = Map.empty()
    m.insert(key = (1, 2), v = 3)
    m.insert(key = (1, 3), v = 4)
    print(m.len())
    print(m.get(key = (1, 3)))
    print(m.has(key = (1, 2)))

    var xs: List<(i32, i32)> = List.empty()
    xs.push((9, 10))
    val (g, k) = xs.pop()
    print(g + k)

    var h: Map<i32, (Pt, i32)> = Map.empty()
    h.insert(key = 1, v = (Pt(x = 1, y = 2), 3))
    val (pt, n) = h.get_or(key = 1, fallback = (Pt(x = 0, y = 0), 0))
    print(pt.x + pt.y + n)
}
