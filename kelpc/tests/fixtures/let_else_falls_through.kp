// plan/syntax.md 4.1: a let-else whose else block falls through is refused,
// because the code after the let would run with the pattern unmatched.
impl "std/option"

fun find(id: i32) => option.Option<i32> {
    if id > 0 {
        return option.Option.Some(value = id * 10)
    }
    return option.Option.None
}

fun main() {
    let Some(user) = find(id = 0) else {
        print("missing")
    }
    print(user)
}
