// S1: building text in ordinary Kelp, concatenation is a function (open item
// 40), replacement is a loop over `starts_with_at`, and number formatting is
// a digit loop over the growable buffer. Only the float format is C.
impl "std/str"
impl "std/result"

fun main() {
    print(str.concat("foo", "bar"))
    print(str.replace("a-b-c", "-", ":"))
    print(str.replace("aaa", "", "x"))
    print(str.from_i64(0))
    print(str.from_i64(145))
    print(str.from_i64(0 - 145))
    // The two live edge cases: `u64`'s maximum and `i64`'s minimum (negating
    // it would overflow), both round-tripped through the parsers. Both have a
    // literal spelling since a `u64` context admitted the whole `u64` range
    // (MISSING-x8Wq3); the parser path is what this fixture is testing.
    val big = str.parseU64("18446744073709551615")
    print(str.from_u64(result.unwrap(r = big)))
    val min = str.parseI64("-9223372036854775808")
    print(str.from_i64(result.unwrap(r = min)))
    print(str.from_u64(9))
}
// stdout-begin
// stdout: foobar
// stdout: a:b:c
// stdout: aaa
// stdout: 0
// stdout: 145
// stdout: -145
// stdout: 18446744073709551615
// stdout: -9223372036854775808
// stdout: 9
