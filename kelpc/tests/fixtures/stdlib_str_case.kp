// M-Xo5Ga: `str.to_upper` and `str.to_lower` apply the Unicode simple case
// mappings, not only ASCII. Each line below is one call, printed on its own line.
impl "std/str"

fun main() {
    // Latin with diacritics, and the sharp s, whose simple uppercase is itself.
    print(str.toUpper("café naïve"))
    print(str.toLower("ÉCOLE Ñandú"))
    print(str.toUpper("straße"))
    // Greek, including the final sigma: its simple uppercase is capital sigma.
    print(str.toUpper("αβγ ωσς"))
    print(str.toLower("ΑΒΓ ΩΣ"))
    // Cyrillic.
    print(str.toUpper("привет ёж"))
    print(str.toLower("ПРИВЕТ ЁЖ"))
    // A dotted capital I lowercases to a plain i under the simple mapping.
    print(str.toLower("İstanbul"))
    // A two-byte letter whose lowercase is three bytes: the output is re-sized.
    print(str.toLower("Ⱥ"))
    print(str.toLower("Ⱥ").len())
}
// stdout-begin
// stdout: CAFÉ NAÏVE
// stdout: école ñandú
// stdout: STRAßE
// stdout: ΑΒΓ ΩΣΣ
// stdout: αβγ ωσ
// stdout: ПРИВЕТ ЁЖ
// stdout: привет ёж
// stdout: istanbul
// stdout: ⱥ
// stdout: 3
