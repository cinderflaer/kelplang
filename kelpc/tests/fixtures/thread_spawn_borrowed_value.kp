// MK9-S3-M1 stage B1, section 5 rule 4: a moved value that contains a borrow
// stays refused. `thread.spawn` opens no hole here, because the value cannot be
// constructed in the first place: a View field needs an earlier String/Bytes
// owner in the same datac, and this constructor supplies none. Lists, Maps,
// references and enum payloads still refuse borrowed stored values.
impl "std/thread"
impl "std/str"

datac Payload(val text: View)

fun worker(p: move Payload) => usize = p.text.len()

fun main() {
    val h = thread.spawn(worker, Payload(text = "x".view()))
    print(0)
}
