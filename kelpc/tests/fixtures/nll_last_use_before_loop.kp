// A borrow whose last use is before a loop is dead before the loop runs, so
// the loop may mutate the owner. The mirror case, a borrow used inside the
// loop, is `nll_borrow_used_next_iteration.kp` and stays refused: a use in a
// loop body keeps the borrow live for the whole loop, because the next
// iteration reaches it.
impl "std/str"

fun main() {
    var names: List<String> = List.empty()
    names.push("alpha")
    val first = names.get(0)
    print(first)
    var i = 0
    while i < 2 {
        names.push("beta")
        i += 1
    }
    print(names.len())
}
// stdout-begin
// stdout: alpha
// stdout: 3
