// M6: a *conditional* move out of an owned local. `s` is moved on one path
// through the `if` only, so it is neither live nor moved at the join: the
// branch that did not move it still owes its value a free, and the branch that
// did has to leave nothing behind for that free to find.
//
// The assignment after the join is the second half of the same rule: the old
// value is freed there, which is correct on both paths for the same reason.
// Before the fix in `borrowck.rs` the move marked the binding moved on *either*
// path and the free disappeared — `memory_gate.rs`'s `std_str_order` finding,
// 10 bytes in 2 blocks.
fun take(s: String) {
    print(s)
}

fun pick(flag: bool).R: String {
    var s = String.from_str("live")
    if flag {
        take(s)
    }
    s = String.from_str("fresh")
    return s
}

fun main() {
    print(pick(flag = true))
    print(pick(flag = false))
}
