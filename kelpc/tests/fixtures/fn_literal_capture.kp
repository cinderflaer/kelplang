// A-4 phase E: the smallest capture there is, a literal that names one
// enclosing binding, which makes it a closure, and the binding is `Copy`, so it
// is copied into the environment and stays usable afterwards.
fun main() {
    val k: i32 = 10
    val f = fun(x: i32) => i32 = x * k
    print(f(1))
    print(k)
}
