// Release goal 1: a peer that completes the handshake and then says nothing.
// `set_timeout` puts the deadline on the socket after the handshake, so the
// blocking read gives up with `TlsError.Timeout`.
impl "std/net"
impl "std/tls"
impl "std/process"
impl "std/str"
impl "std/result"

fun err_name(e: move tls.TlsError) => String = when e {
    Untrusted -> String.from_str("untrusted")
    Expired -> String.from_str("expired")
    HostMismatch -> String.from_str("host_mismatch")
    ProtocolTooOld -> String.from_str("protocol_too_old")
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> String.from_str("peer_closed_uncleanly")
    Timeout -> String.from_str("timeout")
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun main() {
    val args = process.args()
    val parsed = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "tls_timeout_read: argv[1] is not a port number",
    )
    var s = net.connect("127.0.0.1", parsed.to_u16())
    s.set_timeout(4000)
    val t = tls.handshake(s, "127.0.0.1")
    tls.set_timeout(t, 400)
    val r = tls.try_read(t, 64)
    when r {
        Ok(_) -> print("ok")
        Err(e) -> print(err_name(e))
    }
    // The session is ended either way: a stream that failed a read still owns
    // the `SSL*`, and only `try_shutdown` frees it.
    val sd = tls.try_shutdown(t)
    net.close(s)
}
