// A-6: a `datac` whose every field is keyable is a map key. The compiler
// derives the key's hash and equality the same way it derives its order and
// its deep copy, so no comparator or trait is involved.
datac Point(val x: i32, val y: i32)

fun main() {
    var m: Map<Point, i32> = Map.empty()
    m.insert(key = Point(x = 1, y = 2), v = 10)
    print(m.len())
    print(m.get(key = Point(x = 1, y = 2)))
    print(m.has(key = Point(x = 9, y = 9)))
    print(m.has(key = Point(x = 1, y = 3)))
}
// stdout-begin
// stdout: 1
// stdout: 10
// stdout: false
// stdout: false
