impl "std/net"
impl "std/result"

// A single-file program: the entry module implicitly holds every domain with a
// `*` pattern (open item 18), so `net` resolves here with no `caps(...)`
// clause at all, and the runtime check is the whole-resource wildcard `*`,
// which is what the `net` vocabulary had to gain in S3 alongside `host:port`.
//
// One process, loopback, no fixed port: bind 0, ask which port the kernel
// gave, connect to it.
fun main() {
    val l = net.listen(0)
    val port = l.port()
    val c = result.expect(net.connect("127.0.0.1", port), "net.connect: the call failed")
    val s = result.expect(net.accept(l), "net.accept: the call failed")

    net.sendText(c, "hello")
    val got = result.expect(net.recv(s, 32), "net.recv: the call failed")
    print(got)

    net.close(c)
    net.close(s)
    l.close()
}
// stdout-begin
// stdout: hello
