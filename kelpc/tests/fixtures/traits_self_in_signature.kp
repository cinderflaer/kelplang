// `Self` names the implementing type everywhere in a signature, not only in the
// receiver: a parameter (`other: &Self`), a return (`R: Self`), and a bound on a
// generic function over `T` all resolve to the concrete type per instantiation
// (A-12 slice 2).
trait Copyable {
    fun Self.duplicate() => Self
    fun Self.add(other: &Self) => Self
}

datac Point(val x: i32, val y: i32)

impl Copyable for Point {
    fun Self.duplicate() => Self = Point(x = x, y = y)
    fun Self.add(other: &Self) => Self = Point(x = x + other.x, y = y + other.y)
}

fun duplicated<T: Copyable>(x: &T) => T = x.duplicate()

fun main() {
    val p = Point(x = 1, y = 2)
    val q = duplicated(p)
    print(q.x)
    print(p.add(other = q).x)
}
// stdout-begin
// stdout: 1
// stdout: 2
