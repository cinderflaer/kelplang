// A-12 slice 7: a `mut Self` method on an owned trait object holds an exclusive
// borrow of the box for the call, so calling one while a `&dyn` borrowed out of
// the box is still live is refused, exactly as `c.scale(...)` is refused while
// `&c` is live.
trait Shape {
    fun Self.area() => f64
    fun mut Self.scale(f: f64)
}

datac Circle(var r: f64)
impl Shape for Circle {
    fun Self.area() => f64 = r * r * 3.0
    fun mut Self.scale(f: f64) { r = r * f }
}

fun make() => Box<dyn Shape> = Box.of(Circle(r = 1.0))

fun main() {
    var b = make()
    val d = b.get()
    b.scale(2.0)
    print(d.area())
}
