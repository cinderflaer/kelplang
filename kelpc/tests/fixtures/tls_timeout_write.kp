// Release goal 1: the write deadline. The peer completes the handshake and then
// never reads, so a 64 MiB `try_write_all` fills the socket buffers and stalls.
// `set_timeout` puts the send deadline on the socket, so the stall is
// `TlsError.Timeout`, not a hang.
impl "std/encoding"
impl "std/mem"
impl "std/net"
impl "std/process"
impl "std/result"
impl "std/str"
impl "std/tls"

fun err_name(e: move tls.TlsError) => String = when e {
    Untrusted -> "untrusted"
    Expired -> "expired"
    HostMismatch -> "host_mismatch"
    ProtocolTooOld -> "protocol_too_old"
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> "peer_closed_uncleanly"
    Timeout -> "timeout"
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun main() {
    val args = process.args()
    val parsed = result.expect(
        r = str.parseU64(args.get(1).as_str()),
        message = "tls_timeout_write: argv[1] is not a port number",
    )
    var s = result.expect(net.connect("127.0.0.1", parsed.to_u16()), "net.connect: the call failed")
    s.setTimeout(4000)
    val t = result.expect(tls.handshake(s, "127.0.0.1"), "tls.handshake: the call failed")
    tls.setTimeout(t, 500)
    val body = mem.alloc(67108864)
    val r = tls.writeAll(t, body)
    when r {
        Ok(_) -> print("ok")
        Err(e) -> print(err_name(e))
    }
    val sd = tls.shutdown(t)
    net.close(s)
}
