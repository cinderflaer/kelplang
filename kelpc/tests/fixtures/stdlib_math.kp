// M6.3: `std/math`, constants, argument-type overloading, and the C
// library's transcendentals behind one extern each.
impl "std/math"

fun main() {
    print(math.PI)
    print(math.TAU)
    print(math.abs(x = -7))
    print(math.abs(x = -7.5))
    print(math.min(a = 3, b = 9))
    print(math.max(a = 3, b = 9))
    print(math.clamp(x = 15, lo = 0, hi = 10))
    print(math.sqrt(2.0))
    print(math.floor(x = 2.75))
    print(math.sign(x = -3.5))
    print(math.isFinite(x = 1.0))
    print(math.isNan(x = 0.0))
}
// stdout-begin
// stdout: 3.141593
// stdout: 6.283185
// stdout: 7
// stdout: 7.500000
// stdout: 3
// stdout: 9
// stdout: 10
// stdout: 1.414214
// stdout: 2.000000
// stdout: -1.000000
// stdout: true
// stdout: false
