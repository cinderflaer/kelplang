// A-12 slice 6: `?` cannot convert a failure with no `impl From<..>`, and the
// refusal names both payload types and `From`.
impl "std/result"

enum IoErr {
    Bad(val code: i32)
}

enum AppErr {
    Io(val code: i32)
}

fun failing().return: result.Result<i32, IoErr> {
    return result.Result.Err(error = IoErr.Bad(code = 1))
}

fun outer().return: result.Result<i32, AppErr> {
    val v = failing()?
    return result.Result.Ok(value = v)
}

fun main() {
    print(result.is_err(r = outer()))
}
