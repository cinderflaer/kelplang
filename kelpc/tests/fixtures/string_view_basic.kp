// MK7 §5's second heap slice, `View` end to end. `kelp_View` is
// `{const char* ptr; size_t len}`, two eightbytes, so it is the first heap
// type that travels in a register pair (`rdi`/`rsi` in, `rax`/`rdx` out)
// rather than through the hidden pointer. This fixture pins that ABI: a
// `View` parameter, a `View` return, a `View` printed by pointer *and length*
// (a slice has no NUL after it, so `%s` would run past its end), and a slice
// of a slice.
//
// A `View` borrows, so it is never freed; the `String` it becomes through
// `to_string` is, and that is the last thing here to check.
impl "std/str"

// A `View` parameter and a `View` return, both by value.
fun head(text: View, n: usize) => View = text.slice(0, n)

fun count_byte(text: View, want: u8) => usize {
    var i: usize = 0
    var n: usize = 0
    while i < text.len() {
        if text.get(i) == want {
            n += 1
        }
        i += 1
    }
    return n
}

fun main() {
    val src = "the quick brown fox"
    val v = src.view()
    print(v)
    print(v.len())
    print(v.is_empty())
    print(v.get(4) == 'q')

    // A slice is a view of the same text, no `String` is made.
    print(v.slice(4, 9))
    print(v.slice(0, 3))
    print(v.slice(1, v.len()))

    // Equality is length-aware, so a prefix is not equal to the whole.
    print(v.eq(v))
    print(v.eq("the quick brown fox".view()))
    print(v.eq("other".view()))
    print(v.slice(0, 3).eq("the".view()))

    print(head(v, 3))
    print(count_byte(v, ' '))

    val empty = v.slice(3, 3)
    print(empty.is_empty())
    print(empty.len())
    print(empty.eq("".view()))

    // A `View` to an owned `String`: the one length-aware copy out of a slice.
    val owned = v.slice(4, 9).to_string()
    print(owned)
    print(owned.len())

    // A `String`'s own view costs no `strlen`.
    val s = String.from_str("owned text")
    print(s.view())
    print(s.view().slice(6, 10))

    // The byte path back: `Bytes.as_str` is the checked borrow.
    val b = Bytes.from_str("raw")
    print(b)
    print(str.len(b.as_str()))
}
