datac State(var count: i32, var items: List<i32>)

fun each(f: scoped fun(i32)) {
    f(1)
}

fun both(x: mut List<i32>, f: scoped fun(i32)) {
    f(1)
    x.push(100)
}

fun main() {
    var s = State(count = 0, items = List.empty())
    each { a ->
        s.count += a
        both(s.items) { b ->
            s.count += b
        }
    }
    print(s.count)
}
