// Three producers each send 100 Strings "p<id>-<i>" through a bounded channel
// of capacity two to one consumer, which counts them with `for` and sums their
// byte lengths. Each producer sends 10 four-byte strings and 90 five-byte ones,
// so the count is 300 and the total is 3 * 490 = 1470.
impl "std/thread"
impl "std/result"
impl "std/sync"
impl "std/fmt"

/// The text "p<id>-<i>" as one owned String.
fun label(id: i64, i: i64) => String {
    var s = String.from_str("p")
    val a = fmt.int(id)
    s.push_str(a.as_str())
    s.push_str("-")
    val b = fmt.int(i)
    s.push_str(b.as_str())
    return s
}

datac Feed(val tx: sync.Sender<String>, val id: i64)

fun producer(feed: move Feed) {
    var i: i64 = 0
    while i < 100 {
        val back = feed.tx.send(label(feed.id, i))
        i += 1
    }
}

fun main() {
    var (tx, rx) = sync.bounded<String>(2)
    val h1 = thread.spawn(producer, Feed(tx = tx.clone(), id = 0))
    val h2 = thread.spawn(producer, Feed(tx = tx.clone(), id = 1))
    val h3 = thread.spawn(producer, Feed(tx = tx, id = 2))
    var count: i64 = 0
    var bytes: int = 0
    for s in rx {
        count += 1
        bytes += s.len()
    }
    print(count)
    print(bytes)
    when thread.join(h1) {
        Ok(_) -> {}
        Err(e) -> print(e.message)
    }
    when thread.join(h2) {
        Ok(_) -> {}
        Err(e) -> print(e.message)
    }
    when thread.join(h3) {
        Ok(_) -> {}
        Err(e) -> print(e.message)
    }
}
// stdout-begin
// stdout: 300
// stdout: 1470
