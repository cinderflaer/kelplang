// MK9-S3-M1 stage B1: a `thread.spawn` call that passes every section 5 rule is
// checked and then refused, because stage C1 is the stage that lowers it. This
// is the accepted shape, with a declared `fun` as the entry point (the ordinary
// function value). The message names the stage, so no valid call can reach
// codegen before C1 exists.
impl "std/thread"

fun worker(x: move i64).R: i64 = x + 1

fun main() {
    val h = thread.spawn(worker, 41)
    print(0)
}
