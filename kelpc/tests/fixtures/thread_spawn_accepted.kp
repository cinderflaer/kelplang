// MK9-S3-M1 stage C1: the accepted `thread.spawn` shape with a declared `fun`
// as the entry point, which a plain function value is widened from. The call
// passes every section 5 rule and is lowered, and the join proves the worker ran
// the function it was given: `41` in, `42` back.
impl "std/thread"
impl "std/result"

fun worker(x: move i64) => i64 = x + 1

fun main() {
    val h = thread.spawn(worker, 41)
    when thread.join(h) {
        Ok(v) -> print(v)
        Err(e) -> print(e.message)
    }
}
