// `str.less` and `str.is_digit`: the byte-wise ordering and the decimal-digit
// predicate that `std/str` did not have.
//
// `str` cannot use `<` (the same reason it cannot use `==`: `infer.rs::comparable`
// compares pointers), and the module had no ordering function at all, so the
// catalogue grew its own: `fpl/json` carries a private `str_less` with the rule
// written in its doc comment, used by `write_sorted` to order object keys. A
// consumer that wanted to order text had nowhere to turn, a library cannot
// import a sibling library, so every project with a sorted list of words wrote
// the byte loop a third time.
//
// `is_digit` is the same story with five copies: a private one in `fpl/json`, a
// private one in `fpl/decimal`, and bare `c >= 48 && c <= 57` in three places in
// `fpl/encoding` and one in `fpl/httpx`.
//
// The fixture exercises both the way a caller uses them rather than only as
// predicates: a hand-written number parser that has to stop at the first
// non-digit, and an insertion sort over three words. It also pins the two rules
// the doc comments commit to, first differing byte decides, and a prefix is less
// than the text that extends it, because those are the answers a caller's sort
// depends on and the ones a "friendlier" codepoint comparison would change.
impl "std/str"

fun main() {
    // Ordering: the first byte that differs decides.
    print(str.less("apple", "banana"))
    print(str.less("banana", "apple"))
    print(str.less("equal", "equal"))

    // A prefix is less than the text that extends it, so an empty string is less
    // than everything and every list sorts the way a human expects.
    print(str.less("a", "ab"))
    print(str.less("ab", "a"))
    print(str.less("", "a"))
    print(str.less("", ""))

    // Bytes, not codepoints: an upper-case letter sorts before a lower-case one,
    // and a multi-byte character sorts after every ASCII byte. This is the same
    // answer `List<u8>.sort` gives, and the reason the doc comment says bytes.
    print(str.less("Zebra", "apple"))
    print(str.less("z", "é"))

    // The predicate agrees with the literal form it replaces, at both ends.
    print(str.is_digit('0'))
    print(str.is_digit('9'))
    print(str.is_digit('5'))
    print(str.is_digit('/'))
    print(str.is_digit(':'))
    print(str.is_digit('a'))
    print(str.is_digit(' '))

    // A digit check is what a hand-written number parser needs, so the fixture
    // parses one: "12x34" stops at the x with the value it has, and the digit
    // count of a mixed string is the count of its digits.
    val text = "12x34"
    var value: i64 = 0
    var i: int = 0
    var digits: i64 = 0
    while i < str.len(text) {
        val c = str.byte(text, i)
        if !str.is_digit(c) {
            i = str.len(text)
        } else {
            value = value * 10 + (c - '0').to_i64()
            digits = digits + 1
            i = i + 1
        }
    }
    print(value)
    print(digits)

    // And ordering is what a sort needs: an insertion sort over three words and
    // their order afterwards, so the function is exercised the way a caller uses
    // it rather than only as a predicate. The two elements are copied out before
    // the swap because `words.get` returns a borrow and the binding that holds it
    // would keep `words` borrowed while `words.set` needs it exclusively.
    var words: List<String> = List.empty()
    words.push("pear")
    words.push("apple")
    words.push("fig")
    var a: int = 1
    while a < words.len() {
        var b: int = a
        var moved = true
        while b > 0 && moved {
            val left_text = String.from_str(words.get(b - 1).as_str())
            val right_text = String.from_str(words.get(b).as_str())
            // The comparison is bound to a `bool` before the branch: a borrow taken
            // in an `if` condition lives until the end of the block, so comparing
            // inline would keep both texts borrowed while `words.set` needs the
            // list exclusively.
            val needs_swap = str.less(right_text, left_text.as_str())
            if needs_swap {
                words.set(b - 1, right_text)
                words.set(b, left_text)
                b = b - 1
            } else {
                moved = false
            }
        }
        a = a + 1
    }
    var w: int = 0
    while w < words.len() {
        print(words.get(w))
        w = w + 1
    }
}
