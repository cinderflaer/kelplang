// A block inside a block can capture the outer block's exclusive capture: both write `s.count`, one call at a time.
datac State(var count: i32)

fun each(f: scoped fun(i32)) {
    f(1)
}

fun main() {
    var s = State(count = 0)
    each { a ->
        s.count += a
        each { b ->
            s.count += b
        }
    }
    print(s.count)
}
// stdout-begin
// stdout: 2
