// A-4 phase D: the `map`/`and_then`/`or_else`/`each` methods of `Option` and
// `Result`, and the free `result.map`/`map_err`, the helpers
// MK5-S6-M1 recorded as waiting on function values.
//
// Every callback takes a *borrow* of the payload (`fun(&T) => U`), which is
// what makes `map` work at any instantiation, owned payload included, and what
// keeps the callback from taking ownership. What a helper *cannot* do is hand
// the variant it was given back out through a borrow: `result.map` and
// `map_err` rebuild the other side, so they take the result with `move` (A-11)
// and work for an owned payload too. `Option.map` builds a fresh `Some` and
// needs no move, and the helpers whose receiver stays a borrow (`and_then`,
// `or_else`, `each`) are `Copy`-only on the side they rebuild.
//
// In the AddressSanitizer list: `map` builds owned `String`s and frees them.
impl "std/option"
impl "std/result"
impl "std/str"

fun half(n: i32) => option.Option<i32> {
    if n % 2 == 0 {
        return option.Option.Some(value = n / 2)
    }
    return option.Option.None
}

fun parse_positive(n: i32) => result.Result<i32, i32> {
    if n > 0 {
        return result.Result.Ok(value = n)
    }
    return result.Result.Err(error = 0 - n)
}

fun main() {
    // `map` over an owned payload: the callback borrows the `String`, and the
    // result is a fresh owned value. Reading it back out goes through
    // `option.expect`, which takes the option with `move` (A-11).
    val text = option.Option.Some(value = String.from_str("hello"))
    val len = text.map(fun(s: &String) => int = s.len())
    print(option.expect(o = len, message = "none"))

    val shout = text.map(fun(s: &String) => String = str.toUpper(s.as_str()))
    if let Some(s) = shout {
        print(s)
    }

    // Chaining fallible steps does not nest.
    print(option.expect(o = half(8).andThen(half), message = "none"))
    print(option.isNone(o = half(9).andThen(half)))

    // `or_else` needs a `Copy` payload: it rebuilds `Some` from a copy.
    val empty: option.Option<i32> = option.Option.None
    val seven = empty.orElse(fun() => option.Option<i32> = option.Option.Some(value = 7))
    // `each` is the `Unit` case of `map`.
    seven.each(fun(v: &i32) { print(v) })

    // `unwrap_or` takes the option with `move` (A-11), so it is the last use
    // of `seven`; `or_else` above stays a borrow, which is why the binding is
    // still here to observe.
    print(option.unwrapOr(o = seven, fallback = 0))

    // Result: `map`/`map_err` take the result with `move`, so the side they
    // rebuild may be owned; the call hands over a fresh result. `and_then` and
    // `or_else` below keep the borrow receiver, so their rebuilt side is
    // `Copy`.
    val ok = result.map(r = parse_positive(21), f = fun(n: &i32) => i32 = n * 2)
    print(result.expect(r = ok, message = "err"))
    val failed = result.mapErr(r = parse_positive(-5), f = fun(e: &i32) => i32 = e + 100)
    print(result.expectErr(r = failed, message = "ok"))

    // `and_then` chains, `or_else` recovers, `each` observes.
    print(result.expect(r = parse_positive(4).andThen(parse_positive), message = "err"))
    val recovered = parse_positive(-1).orElse(fun(e: &i32) => result.Result<i32, i32> = result.Result.Ok(value = e + 10))
    print(result.expect(r = recovered, message = "err"))
    parse_positive(4).andThen(parse_positive).each(fun(n: &i32) { print(n) })
}
// stdout-begin
// stdout: 5
// stdout: HELLO
// stdout: 2
// stdout: true
// stdout: 7
// stdout: 7
// stdout: 42
// stdout: 105
// stdout: 4
// stdout: 11
// stdout: 4
