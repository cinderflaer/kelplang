// MK7 §5: the *owned*-field half of `heap_field_of_temporary.kp`, and the
// shape the previous slice recorded rather than fixed. `mkName()` returns a
// `datac` that owns two `String`s, and every read below borrows one field of
// the temporary — so the whole temporary owns memory that nothing else can
// free, and freeing only the field that was read would leak the other one.
// The fix stages the temporary itself and drops *it*, which is why a
// two-owned-field `datac` is the interesting case and not a one-field one.
//
// This fixture used to be asm-backend-only, and reported itself so under the
// C backend: the same shape was invalid C there. `codegen_c.rs` emitted
// `(&(kelp_mkName()).kelp_r)`, the address of a field of an rvalue, and `cc`
// rejected it (`heap_field_of_owned_temporary.kp`'s own probe in the slice's
// blockquote). Both backends now stage the temporary and free *it*, so the
// fixture is in the differential sweep and in the leak gate under each of
// them; `memory_gate.rs`'s asm-only branch is the general mechanism for any
// fixture the C backend rejects, and no longer fires for this one.
datac Named(val r: String, val name: String)

// The container spelling of the same rvalue: `kelp_List__i32` is what the
// original probe named, and a `List` field exercises the staged temporary's
// generated drop rather than the builtin `String` one.
datac Bag(val items: List<i32>)

enum Token {
    Word(val text: String)
    Blank
}

fun mkName().R: Named = Named(r = String.from_str("aa"), name = String.from_str("bb"))

fun mkBag().R: Bag {
    var xs: List<i32> = List.empty()
    xs.push(1)
    xs.push(2)
    return Bag(items = xs)
}

// The field of a call's result as a call argument, which is the reported
// shape verbatim: `can't take the address of an rvalue of type
// 'kelp_List__i32'`.
fun count().R: usize = mkBag().items.len()

fun pass(n: move Named).R: Named = n

fun take(s: String) {
    print(s)
}

fun main() {
    // One field of a call temporary, in `print` position: the temporary is
    // dropped, so *both* `String`s are freed (`aa` and `bb`, six bytes).
    print(mkName().r)
    // The other field, as a call argument rather than a `print`.
    take(mkName().name)
    // A method receiver on an owned field of a temporary.
    print(mkName().name.len())
    // A `move` parameter in between: the temporary is already owned by the
    // time its field is read.
    print(pass(mkName()).r)
    // An owned payload of a temporary `enum` scrutinee, bound as a borrow.
    if let Word(t) = Token.Word(text = String.from_str("four")) {
        print(t.len())
    } else {
        print(0)
    }
    // A condition that reads through an owned temporary: dropped on every
    // pass of the loop, not once after it. The bound comes first and the
    // temporary second, and `&&` short-circuits, so the loop terminates after
    // three passes and the temporary is still evaluated — and dropped — on
    // every one of them. (`n` is printed, so `n` is the fixture's own control:
    // this fixture was committed with the temporary as its *only* condition
    // and no test over it, so the loop never terminated and nothing noticed.)
    var n = 0
    while n < 3 && mkName().r.len() > 0 {
        n = n + 1
    }
    print(n)
    // The same read through a `List` field of a temporary, printed and
    // emitted as a call argument, so the staged temporary's own generated
    // drop is the only thing that frees the buffer.
    print(count())
    print(mkBag().items.len())
}
