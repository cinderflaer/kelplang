// A method declared on an `enum` (`fun Shape.label()`) resolves on a binding
// of the enum type, payload and payload-less variants alike.
enum Shape {
    Circle(val r: f64)
    Empty
}

fun Shape.label() => String = when self {
    Circle(_) -> "circle"
    Empty -> "empty"
}

fun main() {
    val a = Shape.Empty
    print(a.label())
    val b = Shape.Circle(r = 2.0)
    print(b.label())
}
