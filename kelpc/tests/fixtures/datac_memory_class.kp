// MK7 §5 item 4, third slice: a `datac` whose C layout is over sixteen bytes
//, SysV `MEMORY` class. Returned through the hidden-pointer convention; not
// supported as a by-value parameter or argument this slice, so `sum_quad`
// takes its `Quad` by reference (the already-working `datac` case), not by
// value.
datac Quad(var a: i64, var b: i64, var c: i64)

fun make_quad(a: i64, b: i64, c: i64).return: Quad {
    return Quad(a = a, b = b, c = c)
}

fun sum_quad(q: Quad).return: i64 {
    return q.a + q.b + q.c
}

fun main() {
    var q = make_quad(1, 2, 3)
    print(q.a)
    print(q.b)
    print(q.c)
    print(sum_quad(q))
    q.c = 30
    print(sum_quad(q))
    q = make_quad(10, 20, 30)
    print(sum_quad(q))
}
