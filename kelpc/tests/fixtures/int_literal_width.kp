// An integer literal that does not fit the type it lands on is refused at its own
// line, not narrowed to that type (BUG-t6Mz2). This is the fixture where the two
// backends used to disagree, because each narrowed the literal itself: the C
// backend emitted the literal text at its full 64-bit value and let C's usual
// arithmetic conversions decide, while the LLVM backend cut every literal to the
// expression's type first. The refusal belongs to the front end, so no backend
// sees a literal that does not fit any more.
//
// One literal wider than its type survives, and it is the one a sign covers:
// `-2147483648` is an `i32` when an `i32` is asked for, and the 2147483648 under the sign is a value no
// `i32` holds on its own. Both backends still have to cut that literal to `i32`
// the same way, which is what the boundary cases below pin.
fun main() {
    // The boundary, with and without the sign that makes it representable. The
    // value without the sign needs an `i64` context, which holds it.
    print(-2147483648)
    print(-2147483648 % 1000000007)
    print(-2147483648 + 1)
    val wide: i64 = 2147483648
    print(wide)
    print(wide % 1000000007)

    // The largest literal an `i32` holds. An unannotated literal is `int` now
    // (issue #275), so the overflow below is written in an `i32` binding, where
    // it still wraps as it always did.
    print(2147483647 % 1000000007)
    val top: i32 = 2147483647
    print(top + 1)

    // Narrow declared types, where the literal still fits.
    val b: u8 = 255
    val w: u16 = 65535
    print(b)
    print(w)

    // The control case: an `i64` context narrows nothing.
    val big: i64 = 1000000000007
    print(big % 1000000007)
}
// stdout-begin
// stdout: -2147483648
// stdout: -147483634
// stdout: -2147483647
// stdout: 2147483648
// stdout: 147483634
// stdout: 147483633
// stdout: -2147483648
// stdout: 255
// stdout: 65535
// stdout: 999993014
