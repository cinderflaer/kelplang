// MK7 S5: a plain `List<f64>` element, and the `List.contains` that goes with
// it. A float element is `Copy`, so the container function set is generated for
// it and `contains` is offered; the element's copy width and its comparison are
// both float-shaped, and the differential fuzzer found that the `contains`
// body fell through to an integer compare and emitted invalid IR. Nothing in
// the curated corpus held a `List<f64>` before this file: `list_element_widths`
// covers `i64`/`bool`/`datac` elements and `float_datac_containers` covers a
// `datac` whose field is a float, so the plain float element is the one shape
// missing.
fun main() {
    var fs: List<f64> = List.empty()
    fs.push(3.5)
    fs.push(1.25)
    fs.push(2.0)
    fs.push(2.0)
    print(fs.len())
    print(fs.get(0))
    print(fs.get(3))
    print(fs.contains(2.0))
    print(fs.contains(9.5))

    fs.sort()
    print(fs.get(0))
    print(fs.get(3))

    val copy = fs.clone()
    print(copy.len())
    val mid = fs.slice(1, 3)
    print(mid.get(0))
    print(mid.get(1))

    fs.set(0, 9.5)
    print(fs.get(0))
    print(fs.remove(0))
    fs.insert(0, 0.5)
    print(fs.get(0))
    print(fs.pop())
    fs.reverse()
    print(fs.get(0))

    // The narrow float goes through the same element path with a four-byte
    // copy and a `float` compare.
    var narrow: List<f32> = List.empty()
    narrow.push(1.5)
    narrow.push(2.5)
    print(narrow.get(1))
    print(narrow.contains(2.5))
    print(narrow.contains(0.5))
}
