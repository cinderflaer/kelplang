// A-20: `impl Trait` in argument position is sugar for a fresh bounded type
// parameter, so this shape compiles; a stored position (a field, a `let`, a
// return) stays refused (`impl_trait_field_refused.kp`,
// `impl_trait_return_refused.kp`).
trait Shape {
    fun Self.area() => f64
}

fun take(s: impl Shape) { }

fun main() { }
