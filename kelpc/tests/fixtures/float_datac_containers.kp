// MK7 §5 item 4, the float-in-aggregate slice: the generated-to-hand-written
// boundary, which is the one place a wrong eightbyte split *is* visible in
// stdout rather than only in the `.s`.
//
// `Box.of`, `Box#set`, `Box#take`, `List#push` and `Map#insert` are routines
// this backend writes by hand, and the caller is generated. If the two ends
// disagree about an `SSE` element, the caller in `xmm0` and the routine in
// `rdi`, say, the value that comes back is wrong, and every assertion here
// compares it against the C backend's own output. `datac V2` is a single
// `f64`, so it is `One(SSE)`: the shape that used to be refused because
// `elem_size` had no answer for a float `datac` at all.
datac V2(val a: f64)

fun main() {
    var b = Box.of(V2(a = 1.5))
    print(b.get().a)
    b.set(V2(a = 2.5))
    print(b.get().a)
    var taken = b.take()
    print(taken.a)

    var xs = List.of(V2(a = 3.5))
    xs.push(V2(a = 4.5))
    print(xs.get(0).a)
    print(xs.get(1).a)
    print(xs.pop().a)
    print(xs.get(0).a)

    var m: Map<i64, V2> = Map.empty()
    m.insert(1, V2(a = 5.5))
    print(m.get(1).a)
}
// stdout-begin
// stdout: 1.500000
// stdout: 2.500000
// stdout: 2.500000
// stdout: 3.500000
// stdout: 4.500000
// stdout: 4.500000
// stdout: 3.500000
// stdout: 5.500000
