// A borrow used only inside an `if` arm is dead after the `if` statement, so
// the owner may be mutated then. The borrow is deliberately treated as live
// for the whole `if` (see `kelp wiki page language/ownership.md`), which is what keeps the arms'
// predecessors and the arm that uses it sound.
impl "std/str"

fun main() {
    var names: List<String> = List.empty()
    names.push("alpha")
    val first = names.get(0)
    if names.len() == 1 {
        print(first)
    }
    names.push("beta")
    print(names.len())
}
// stdout-begin
// stdout: alpha
// stdout: 2
