// MISSING-FZqe6: `std/encoding`, the alphabet-and-codec module. Every decoder
// is exercised once with a good input and once with a bad one, and both
// directions of each codec are checked against a literal.
//
// MISSING-k4Nvz added `sha1` to the module, and the three lines at the end of
// `main` are RFC 3174's own vectors: the empty message, `abc`, and the
// 56-byte message whose padding needs a second block.
impl "std/encoding"
impl "std/str"
impl "std/result"

// The decoded bytes as text, or a marker when the decode was refused. The
// payload is a borrow (`Result`'s header), so the copy is explicit.
fun decoded(r: result.Result<Bytes, encoding.DecodeErr>) => String {
    if let Ok(b) = r {
        return String.from_bytes(b.clone())
    }
    return "<err>"
}

// The decoded text, or the same marker.
fun decoded_text(r: result.Result<String, encoding.DecodeErr>) => String {
    if let Ok(s) = r {
        return s.clone()
    }
    return "<err>"
}

fun main() {
    print(encoding.base64_encode(Bytes.from_str("hello")))
    print(encoding.base64_encode(Bytes.from_str("hi")))
    print(encoding.base64_encode(Bytes.from_str("a")))
    print(encoding.base64_encode(Bytes.empty()))
    print(decoded(r = encoding.base64_decode("aGVsbG8=")))
    print(decoded(r = encoding.base64_decode("aGk=")))
    print(decoded(r = encoding.base64_decode("YQ==")))
    print(result.is_err(r = encoding.base64_decode("aGVsbG8")))
    print(result.is_err(r = encoding.base64_decode("aGVsbG8*")))

    print(encoding.base32_encode(Bytes.from_str("hello")))
    print(encoding.base32_encode(Bytes.from_str("hi")))
    print(decoded(r = encoding.base32_decode("NBSWY3DP")))
    print(result.is_err(r = encoding.base32_decode("NBSWY3D")))
    print(result.is_err(r = encoding.base32_decode("NBSWY3D1")))

    print(encoding.base58_encode(Bytes.from_str("hello")))
    print(encoding.base58_encode(Bytes.from_str("a")))
    print(decoded(r = encoding.base58_decode("Cn8eVZg")))
    print(result.is_err(r = encoding.base58_decode("0OIl")))

    print(encoding.hex_encode(Bytes.from_str("Hi")))
    print(decoded(r = encoding.hex_decode("4869")))
    print(decoded(r = encoding.hex_decode("48656C6C6F")))
    print(result.is_err(r = encoding.hex_decode("4")))
    print(result.is_err(r = encoding.hex_decode("4z")))

    print(encoding.percent_encode("a b/c?d=e&f"))
    print(encoding.percent_encode("plain-._~"))
    print(decoded_text(r = encoding.percent_decode("a%20b%2Fc")))
    print(result.is_err(r = encoding.percent_decode("%2")))
    print(result.is_err(r = encoding.percent_decode("%zz")))

    print(encoding.form_encode("a b+c"))
    print(decoded_text(r = encoding.form_decode("a+b%2Bc")))
    print(result.is_err(r = encoding.form_decode("%")))

    print(encoding.dump(Bytes.from_str("Hi")))
    print(encoding.dump(Bytes.empty()))

    print(encoding.hex_encode(encoding.sha1(Bytes.empty())))
    print(encoding.hex_encode(encoding.sha1(Bytes.from_str("abc"))))
    print(encoding.hex_encode(encoding.sha1(Bytes.from_str(
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    ))))
}
// stdout-begin
// stdout: aGVsbG8=
// stdout: aGk=
// stdout: YQ==
// stdout:
// stdout: hello
// stdout: hi
// stdout: a
// stdout: true
// stdout: true
// stdout: NBSWY3DP
// stdout: NBUQ====
// stdout: hello
// stdout: true
// stdout: true
// stdout: Cn8eVZg
// stdout: 2g
// stdout: hello
// stdout: true
// stdout: 4869
// stdout: Hi
// stdout: Hello
// stdout: true
// stdout: true
// stdout: a%20b%2Fc%3Fd%3De%26f
// stdout: plain-._~
// stdout: a b/c
// stdout: true
// stdout: true
// stdout: a+b%2Bc
// stdout: a b+c
// stdout: true
// stdout: 00000000  48 69                                             |Hi|
// stdout:
// stdout: da39a3ee5e6b4b0d3255bfef95601890afd80709
// stdout: a9993e364706816aba3e25717850c26c9cd0d89d
// stdout: 84983e441c3bd26ebaae4aa1f95129e5e54670f1
