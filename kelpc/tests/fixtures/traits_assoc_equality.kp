// An equality constraint must name an associated type the trait declares; Src
// declares Out, so Missing is refused by name at the call.

trait Src {
    type Out
    fun Self.produce().return: Self::Out
}

datac Feed(val n: i32)

impl Src for Feed {
    type Out = i32
    fun Self.produce().return: Self::Out {
        return self.n
    }
}

fun pick<I: Src<Missing = i32>>(x: I).return: i32 = 0

fun main() {
    print(pick(Feed(n = 1)))
}
