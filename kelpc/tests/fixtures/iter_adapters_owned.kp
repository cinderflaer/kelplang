impl "std/iter"

fun main() {
    var names: List<String> = List.empty()
    names.push("ann")
    names.push("bo")
    names.push("cyrus")
    var long = iter.filter(iter.intoIter(names), fun(s: &String) => bool = s.len() > 2)
    var lens = iter.map(long, fun(s: &String) => int = s.len())
    for n in lens {
        print(n)
    }
    var more: List<String> = List.empty()
    more.push("x")
    more.push("yy")
    for p in iter.enumerate(iter.intoIter(more)) {
        val (i, s) = p
        print(i)
        print(s.len())
    }
}
// stdout-begin
// stdout: 3
// stdout: 5
// stdout: 0
// stdout: 1
// stdout: 1
// stdout: 2
