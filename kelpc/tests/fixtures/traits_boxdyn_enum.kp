// A-12 slice 7: an `enum` payload holds an owned trait object. The live
// variant's payload drops through the vtable when the enum value dies, so the
// concrete type's user `drop` prints from inside the generated enum drop.
trait Shape {
    fun Self.area().R: f64
}

datac Circle(val r: f64)

fun mut Circle.drop() {
    print("drop circle")
}

impl Shape for Circle {
    fun Self.area().R: f64 = r * r * 3.0
}

enum Slot {
    Empty
    Full(val b: Box<dyn Shape>)
}

fun main() {
    var s = Slot.Empty
    when s {
        Empty -> print("empty")
        Full(b) -> print(b.area())
    }
    s = Slot.Full(Box.of(Circle(r = 2.0)))
    when s {
        Empty -> print("empty")
        Full(b) -> print(b.area())
    }
    print("done")
}
