// S1: `std/fmt`. Numbers, hex, padding, and the byte dump that is the only
// way to see binary data today (`print` cannot show a `datac` or a `List`).
impl "std/str"
impl "std/fmt"

fun main() {
    print(fmt.int(0))
    print(fmt.int(0 - 1234))
    print(fmt.uint(4294967295))
    print(fmt.float(3.14159, 3))
    print(fmt.float(1.5, 1))
    print(fmt.hex(0))
    print(fmt.hex(255))
    print(fmt.hex(48879))
    print(fmt.padLeft("7", 3, 48))
    print(fmt.padLeft("long", 3, 32))
    print(fmt.padRight("7", 3, 46))
    print(fmt.bytes(Bytes.from_str("ab")))
    print(fmt.bytes(Bytes.empty()))
    // A `String` is not a `str` (open item 21): the owned result is bound
    // and viewed before it can be concatenated.
    val padded = fmt.padLeft("7", 3, 48)
    print(str.concat(padded, "!"))

    print(fmt.commasU64(0))
    print(fmt.commasU64(999))
    print(fmt.commasU64(1000))
    print(fmt.commasU64(1234567))
    // `u64` max has a literal spelling now (MISSING-x8Wq3); this keeps the
    // arithmetic form `fpl/hash` writes for the FNV offset basis, and each part
    // is bound with its type because a literal that is only the receiver of a
    // method call gets no type from anywhere and defaults to `i32`.
    val unit: u64 = 4294967296
    val mask: u64 = 4294967295
    print(fmt.commasU64(mask * unit + mask))
    print(fmt.commasI64(0 - 1234567))
    print(fmt.humanSize(0))
    print(fmt.humanSize(1023))
    print(fmt.humanSize(1024))
    print(fmt.humanSize(1536))
    print(fmt.humanSize(1099511627776))
}
// stdout-begin
// stdout: 0
// stdout: -1234
// stdout: 4294967295
// stdout: 3.142
// stdout: 1.5
// stdout: 0
// stdout: ff
// stdout: beef
// stdout: 007
// stdout: long
// stdout: 7..
// stdout: 61 62
// stdout:
// stdout: 007!
// stdout: 0
// stdout: 999
// stdout: 1,000
// stdout: 1,234,567
// stdout: 18,446,744,073,709,551,615
// stdout: -1,234,567
// stdout: 0 B
// stdout: 1023 B
// stdout: 1.00 KiB
// stdout: 1.50 KiB
// stdout: 1.00 TiB
