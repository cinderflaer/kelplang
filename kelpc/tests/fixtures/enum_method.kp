// A method declared on an `enum` is called on a value of the enum type, so a
// receiver that builds a variant is refused even though the method exists:
// bind the variant first.
enum Shape {
    Circle(val r: f64)
    Empty
}

fun Shape.label() => String = when self {
    Circle(r) -> "circle"
    Empty -> "empty"
}

fun main() {
    print(Shape.Empty.label())
}
