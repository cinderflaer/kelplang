// The regression fixture for the second wrong-width aggregate load (MK7 §5's
// enum slice, fixed after): a one-eightbyte element handed back by `pop` or
// `remove` via `emit_elem_return`. `List#get` returns a borrow for an
// aggregate element, so it never took the load; `pop`/`remove` hand the
// element's own address to the same helper, which loaded a whole `QWORD`
// whatever the element's width was. A list buffer is `cap * sizeof(T)` bytes
// (rounded up by the allocator), so the QWORD at the *last* element crossed
// the block: the four pushes below fill the initial capacity so both pops
// come off the end, which is the sharpest shape.
//
// `A3` is the three-byte case from the defect report; `S12` is the twelfth-
// byte one, whose *second* eightbyte load also has to be its own width (nine
// to fifteen bytes is a register pair, and eight bytes of the high half is
// only right for sixteen). `I2` is the two-byte element the original probe
// used.
datac I2(val a: u8, val b: u8)
datac A3(val a: u8, val b: u8, val c: u8)
datac S12(val a: i32, val b: i32, val c: i32)

fun s2(v: &I2) => i32 = v.a.to_i32() + v.b.to_i32() * 10
fun s3(v: &A3) => i32 = v.a.to_i32() + v.b.to_i32() * 10 + v.c.to_i32() * 100
fun s12(v: &S12) => i64 = v.a.to_i64() + v.b.to_i64() * 100 + v.c.to_i64() * 10000

fun main() {
    var a: List<A3> = List.empty()
    a.push(A3(a = 1, b = 2, c = 3))
    a.push(A3(a = 4, b = 5, c = 6))
    a.push(A3(a = 7, b = 8, c = 9))
    a.push(A3(a = 1, b = 1, c = 1))
    print(a.len())
    val pa = a.pop()
    print(s3(v = &pa))
    val pb = a.pop()
    print(s3(v = &pb))
    val ra = a.remove(0)
    print(s3(v = &ra))
    print(a.len())

    var b: List<I2> = List.empty()
    b.push(I2(a = 2, b = 3))
    b.push(I2(a = 4, b = 5))
    b.push(I2(a = 6, b = 7))
    b.push(I2(a = 8, b = 9))
    print(b.len())
    val qb = b.pop()
    print(s2(v = &qb))
    val qa = b.pop()
    print(s2(v = &qa))
    print(b.len())

    var c: List<S12> = List.empty()
    c.push(S12(a = 1, b = 2, c = 3))
    c.push(S12(a = 4, b = 5, c = 6))
    c.push(S12(a = 7, b = 8, c = 9))
    c.push(S12(a = 1, b = 1, c = 1))
    print(c.len())
    val pc = c.pop()
    print(s12(v = &pc))
    val pdc = c.pop()
    print(s12(v = &pdc))
    val rc = c.remove(0)
    print(s12(v = &rc))
    print(c.len())
}
// stdout-begin
// stdout: 4
// stdout: 111
// stdout: 987
// stdout: 321
// stdout: 1
// stdout: 4
// stdout: 98
// stdout: 76
// stdout: 2
// stdout: 4
// stdout: 10101
// stdout: 90807
// stdout: 30201
// stdout: 1
