// `str.byte` checks its index without measuring the whole string: the first
// byte, the last byte and the empty string's only index (out of range) all
// keep their answers.
impl "std/str"

fun main() {
    val s = "hello"
    print(str.byte(s, 0))
    print(str.byte(s, 4))
    print(str.len(s))
    val empty = ""
    print(str.len(empty))
}
// stdout-begin
// stdout: 104
// stdout: 111
// stdout: 5
// stdout: 0
