// A-12 slice 7: a `Box<dyn Trait>` field of a `datac` moves out like any other
// owned field, so the whole value cannot be read afterwards.
trait Shape {
    fun Self.area().return: f64
}

datac Circle(val r: f64)
impl Shape for Circle {
    fun Self.area().return: f64 = r * r * 3.0
}

datac Holder(val shape: Box<dyn Shape>)

fun make().return: Box<dyn Shape> = Box.of(Circle(r = 1.0))

fun main() {
    val h = Holder(shape = make())
    val s = h.shape
    print(s.is_empty())
    print(h.shape.is_empty())
}
