// Release goal 1: a peer that accepts the TCP connection and then never
// answers the ClientHello. `try_handshake_timeout` puts `SO_RCVTIMEO` and
// `SO_SNDTIMEO` on the socket before the handshake, so the blocking
// `SSL_connect` gives up with `TlsError.Timeout` instead of hanging.
impl "std/net"
impl "std/tls"
impl "std/process"
impl "std/str"
impl "std/result"

fun err_name(e: move tls.TlsError) => String = when e {
    Untrusted -> "untrusted"
    Expired -> "expired"
    HostMismatch -> "host_mismatch"
    ProtocolTooOld -> "protocol_too_old"
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> "peer_closed_uncleanly"
    Timeout -> "timeout"
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun main() {
    val args = process.args()
    val parsed = result.expect(
        r = str.parseU64(args.get(1).as_str()),
        message = "tls_timeout_handshake: argv[1] is not a port number",
    )
    var s = result.expect(net.connect("127.0.0.1", parsed.to_u16()), "net.connect: the call failed")
    val hs = tls.handshakeTimeout(s, "127.0.0.1", 400)
    when hs {
        Ok(_) -> print("ok")
        Err(e) -> print(err_name(e))
    }
    net.close(s)
}
