// Release goal 1: a peer that accepts the TCP connection and then never
// answers the ClientHello. `try_handshake_timeout` puts `SO_RCVTIMEO` and
// `SO_SNDTIMEO` on the socket before the handshake, so the blocking
// `SSL_connect` gives up with `TlsError.Timeout` instead of hanging.
impl "std/net"
impl "std/tls"
impl "std/process"
impl "std/str"
impl "std/result"

fun err_name(e: move tls.TlsError).R: String = when e {
    Untrusted -> String.from_str("untrusted")
    Expired -> String.from_str("expired")
    HostMismatch -> String.from_str("host_mismatch")
    ProtocolTooOld -> String.from_str("protocol_too_old")
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> String.from_str("peer_closed_uncleanly")
    Timeout -> String.from_str("timeout")
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun main() {
    val args = process.args()
    val parsed = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "tls_timeout_handshake: argv[1] is not a port number",
    )
    var s = net.connect("127.0.0.1", parsed.to_u16())
    val hs = tls.try_handshake_timeout(s, "127.0.0.1", 400)
    when hs {
        Ok(_) -> print("ok")
        Err(e) -> print(err_name(e))
    }
    net.close(s)
}
