// M5.3: `_alias` substitution. Inline declarations, a chain (one alias's
// text referencing another), a reference inside a plain string literal, a
// longer name that starts with a shorter one, and a `%` that is still modulo.
//
// `_doubled` prints 44, not 84: substitution is pure text, so
// `_answer * 2` becomes `40 + 2 * 2`. That is the tradeoff the plan
// states explicitly (no hygiene, no parameters), write the parens into the
// alias text if you want the other grouping.
alias _answer = 40 + 2
alias _doubled = _answer * 2
alias _word = aliasword
alias _ans = 1

fun main() {
    print(_answer)
    print(_doubled)
    print("say _word")
    print(_answer + _ans)
    print("_ans and _answer")
    print(17 % 5)
}
// stdout-begin
// stdout: 42
// stdout: 44
// stdout: say aliasword
// stdout: 43
// stdout: 1 and 40 + 2
// stdout: 2
