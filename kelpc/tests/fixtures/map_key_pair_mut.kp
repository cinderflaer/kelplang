// A-12: a key pair is called on a shared borrow of a key the map owns, so a
// `mut` receiver cannot be written on either half.
datac Key(val x: i32)

fun mut Key.hash().return: u64 = self.x.to_u64()

fun Key.eq(other: &Key).return: bool = self.x == other.x

fun main() {
    var m: Map<Key, i32> = Map.new()
    m.insert(key = Key(x = 1), v = 1)
}
