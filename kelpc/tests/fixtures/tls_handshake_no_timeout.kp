// Release goal 1, hardening (case f, without any deadline): the peer accepts and
// never answers, so a `try_handshake` with the default options has no deadline at
// all. The server holds the socket open for a fixed span and then closes it, so
// the process still ends: the error it ends with is `PeerClosedUncleanly` rather
// than `Timeout`, which is what proves no deadline was quietly supplied.
impl "std/net"
impl "std/process"
impl "std/result"
impl "std/str"
impl "std/tls"

fun err_name(e: move tls.TlsError) => String = when e {
    Untrusted -> "untrusted"
    Expired -> "expired"
    HostMismatch -> "host_mismatch"
    ProtocolTooOld -> "protocol_too_old"
    HandshakeFailed(reason) -> str.concat("handshake_failed ", reason.as_str())
    PeerClosedUncleanly -> "peer_closed_uncleanly"
    Timeout -> "timeout"
    Io(reason) -> str.concat("io ", reason.as_str())
}

fun fail(e: move tls.TlsError) => tls.TlsStream {
    val text = err_name(e)
    panic(text)
}

fun fail_unit(e: move tls.TlsError) {
    val text = err_name(e)
    panic(text)
}

fun arg_port() => u16 {
    val args = process.args()
    val p = result.expect(
        r = str.parse_u64(args.get(1).as_str()),
        message = "tls_handshake_no_timeout: argv[1] is not a port number",
    )
    return p.to_u16()
}

fun main() {
    var s = result.expect(net.connect("127.0.0.1", arg_port()), "net.connect: the call failed")
    val hs = tls.handshake(s, "127.0.0.1")
    when hs {
        Ok(_) -> print("ok")
        Err(e) -> print(err_name(e))
    }
    net.close(s)
}
