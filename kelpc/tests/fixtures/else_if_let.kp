// BUG-6: `else if let` behind a *plain* `if` is not an `if` expression to the
// checker. `parse_if_let` desugars the link to a block, the same way the first
// link of an `if let ... else if let ...` chain does, and the arm that assumed
// `Expr::If` panicked with "internal error: entered unreachable code" on a
// shape `syntax.md` 6.1 documents. A chain whose *first* link is an `if let`
// was covered (`if_let_basic.kp`, `if_let_chain_same_scrutinee.kp`); the plain
// `if` in front was not.
enum Maybe {
    Yes(val n: i64)
    No
}

fun pick(limit: i64) => i64 {
    val m = Maybe.Yes(n = 3)
    var best: i64 = 0
    if limit < 0 {
        best = 0
    } else if let Yes(n) = m {
        best = n
    }
    return best
}

// A payload-free variant, the second shape the panic covered, and an `else if
// let` whose pattern does not match. The chain's tail is then the value of the
// `if`, with nothing else in it.
fun label(m: Maybe) => i64 {
    if false {
        return -1
    } else if let No = m {
        return 0
    } else if let Yes(n) = m {
        return n
    }
    return -2
}

fun otherwise(m: Maybe) => i64 {
    var seen: i64 = 1
    if false {
        seen = 2
    } else if let No = m {
        seen = 3
    }
    return seen
}

// The same link used as a *value*: the `if` produces an `i64`, so the else-if
// branch's block has a tail and the join runs over the two branch types.
fun classify(b: bool, m: Maybe) => i64 {
    if b {
        1
    } else if let Yes(n) = m {
        n
    } else {
        0
    }
}

fun main() {
    print(pick(10))
    print(pick(-1))
    print(label(Maybe.Yes(n = 5)))
    print(label(Maybe.No))
    print(otherwise(Maybe.Yes(n = 9)))
    print(otherwise(Maybe.No))
    print(classify(true, Maybe.No))
    print(classify(false, Maybe.Yes(n = 7)))
    print(classify(false, Maybe.No))
}
