// Language-completeness 5: a generic function's body is checked once per
// instantiation, so the operators resolve against the concrete type exactly as
// a method call does. The bound makes the instantiation legal; the operator
// itself is the same desugar, on `Vec2` once `T` is bound to it.
impl "std/ops"

datac Vec2(val x: i32, val y: i32)

impl ops.Add for Vec2 {
    fun Self.add(rhs: &Self).R: Vec2 = Vec2(x = x + rhs.x, y = y + rhs.y)
}

impl ops.Ord for Vec2 {
    fun Self.cmp(other: &Self).R: i32 {
        if x < other.x {
            return -1
        }
        if x > other.x {
            return 1
        }
        if y < other.y {
            return -1
        }
        if y > other.y {
            return 1
        }
        return 0
    }
}

fun sum<T: ops.Add>(a: T, b: T).R: T = a + b

fun smaller<T: ops.Ord>(a: T, b: T).R: bool = a < b

fun main() {
    val a = Vec2(x = 1, y = 2)
    val b = Vec2(x = 3, y = 5)

    val total = sum<Vec2>(a = a, b = b)
    print(total.x)
    print(total.y)

    print(smaller<Vec2>(a = a, b = b))
    print(smaller<Vec2>(a = b, b = a))
}
