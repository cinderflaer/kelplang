// A-19: a `const` may call a plain `fun`. The call is evaluated while the
// compiler runs, with parameters bound like any other call, so a constant can
// be *computed* by code that is written once and reviewed like the rest of the
// program, including a loop and a recursive call. The function does not have
// to be declared before the `const` that calls it, which is why these are all
// at the top where canonical order puts them.
const ENTRIES_PER_PAGE: int = 3
const PAGES: int = 8

const TABLE_ENTRIES: int = entries_for(pages = PAGES)
const FIVE_FACTORIAL: int = factorial(n = 5)
const PADDED: int = rounded_up(n = 100, step = 64)

fun entries_for(pages: int) => int {
    var total: int = 0
    var i: int = 0
    while i < pages {
        total += ENTRIES_PER_PAGE
        i += 1
    }
    total
}

fun factorial(n: int) => int {
    if n <= 1 {
        return 1
    }
    n * factorial(n - 1)
}

fun rounded_up(n: int, step: int) => int {
    if n % step == 0 {
        return n
    }
    n + (step - n % step)
}

fun main() {
    print(TABLE_ENTRIES)
    print(FIVE_FACTORIAL)
    print(PADDED)
    // A const is a literal at every use site, so its type is the declared one
    // and it composes with everything arithmetic does.
    print(TABLE_ENTRIES + FIVE_FACTORIAL)
}
