impl "std/iter"

fun main() {
    var xs: List<i32> = List.empty()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    xs.push(4)
    xs.push(5)
    for x in iter.into_iter(xs) {
        print(x)
    }
    print(iter.count(iter.take(iter.range(0, 100), 7)))
    print(iter.sum_i64(iter.skip(iter.range(0, 10), 7)))
}
// stdout-begin
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 4
// stdout: 5
// stdout: 7
// stdout: 24
