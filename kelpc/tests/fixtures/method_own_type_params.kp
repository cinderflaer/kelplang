datac Box2(val v: i32)

fun Box2.map<U>(f: fun(i32) => U) => U {
    return f(v)
}

datac Pair<A, B>(val a: A, val b: B)

fun Pair<A, B>.map_first<C>(f: fun(A) => C) => Pair<C, B> {
    return Pair(a = f(a), b = b)
}

fun Pair<A, B>.swap_with<C>(c: C) => Pair<B, C> {
    return Pair(a = b, b = c)
}

fun main() {
    val b = Box2(v = 2)
    print(b.map(fun(x: i32) => i32 = x + 1))
    print(b.map(fun(x: i32) => bool = x > 1))
    val p: Pair<i32, i32> = Pair(a = 1, b = 2)
    val q = p.map_first(fun(x: i32) => bool = x == 1)
    print(q.a)
    print(q.b)
    val r = q.swap_with(7)
    print(r.a)
    print(r.b)
}
// stdout-begin
// stdout: 3
// stdout: true
// stdout: true
// stdout: 2
// stdout: 2
// stdout: 7
