// A-12 slice 4: a `&dyn` cannot be returned, because v1 has no lifetime syntax
// to name what it borrows.
trait Shape {
    fun Self.area().return: f64
}

datac Circle(val r: f64)
impl Shape for Circle { fun Self.area().return: f64 = r * r }

fun make(c: &Circle) .return: &dyn Shape = &c

fun main() { }
