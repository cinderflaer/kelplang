// A-6: a `datac` key with an owned field. The derived equality compares the
// `String` field length-aware, the derived hash hashes its bytes, and the
// entry owns a deep copy of the key, so nothing aliases the caller's text.
impl "std/str"

datac Name(val text: String, val id: i32)

fun main() {
    var m: Map<Name, i32> = Map.empty()
    m.insert(key = Name(text = String.from_str(s = "alpha"), id = 1), v = 10)
    m.insert(key = Name(text = String.from_str(s = "beta"), id = 2), v = 20)
    print(m.len())
    print(m.get(key = Name(text = String.from_str(s = "alpha"), id = 1)))
    print(m.has(key = Name(text = String.from_str(s = "alpha"), id = 2)))
    print(m.get(key = Name(text = String.from_str(s = "beta"), id = 2)))
    print(m.remove(key = Name(text = String.from_str(s = "alpha"), id = 1)))
    print(m.len())
    print(m.has(key = Name(text = String.from_str(s = "beta"), id = 2)))
}
