// `int` is its own integer type of the target's native width (issue #275). It
// converts to and from every other integer type with `as`, in both directions,
// and takes the same operators as `i64`.
fun wide(x: i64) => i64 = x * 2

fun main() {
    val n = 3000000000
    print(n)
    print(wide(n as i64))
    val k: i64 = 7
    val m = k as int
    print(m)
    print(m + 1)
    print(m as i32)
    val u: u8 = 200
    print(u as int + 100)
}
