// MISSING-cK4hT and BUG-a9Km4: `fs.is_symlink` and `fs.read_link` see a link as
// a link, `fs.walk` reports one without descending it, and `fs.remove_all`
// unlinks it instead of walking into what it points at.
impl "std/fs"
impl "std/path"

fun main() {
    val root = "/tmp/kelp_fs_symlink_kind"
    val target = "/tmp/kelp_fs_symlink_kind_target"
    if fs.exists(root) {
        fs.remove_all(root)
    }
    if fs.exists(target) {
        fs.remove_all(target)
    }

    fs.mkdir_all(root)
    fs.mkdir_all(target)
    val keep = path.join(target, "keep.txt")
    fs.write_text(keep, "keep\n")

    val note = path.join(root, "note.txt")
    val sub = path.join(root, "sub")
    val inner = path.join(sub, "inner.txt")
    val file_link = path.join(root, "file-link")
    val dir_link = path.join(root, "dir-link")
    val out_link = path.join(root, "out")
    val back = path.join(root, "back")
    val dangling = path.join(root, "dangling")
    val missing = path.join(root, "missing")

    fs.write_text(note, "kept\n")
    fs.mkdir(sub)
    fs.write_text(inner, "inner\n")
    fs.symlink(target = note.as_str(), link = file_link.as_str())
    fs.symlink(target = sub.as_str(), link = dir_link.as_str())
    fs.symlink(target = target, link = out_link.as_str())
    fs.symlink(target = root, link = back.as_str())
    fs.symlink(target = missing.as_str(), link = dangling.as_str())

    // A link answers `true` here and resolves through the other predicates.
    print(fs.is_symlink(file_link))
    print(fs.is_file(file_link))
    print(fs.is_dir(dir_link))
    print(fs.is_symlink(note))
    print(fs.read_link(file_link))
    // A broken link still has a target text.
    print(fs.is_symlink(dangling))
    print(fs.exists(dangling))

    // `back` points at `root` itself and `dir-link` at `sub`; neither is walked
    // into, so this terminates and holds each entry once.
    val found = fs.walk(root)
    print(found.len())

    fs.remove_all(root)
    print(fs.exists(root))
    // The link to `target` was unlinked, not descended: the target's own file
    // is still there.
    print(fs.exists(keep))

    fs.remove_all(target)
    print(fs.exists(target))
}
