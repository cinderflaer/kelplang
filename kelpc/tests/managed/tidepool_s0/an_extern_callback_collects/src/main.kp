// Step 0 (D53, check C4): a closure that captures a heap value crosses to C
// through a `move closure(...)` parameter for the duration of one call. The
// callback runs a collection (the test sets KELP_GC_STRESS=1 and
// KELP_GC_VERIFY=1, so the allocations below clear the heap), and then reads
// the captured String. Each call must still print the captured value.
impl "helper" caps(env = ["*"])

datac Cell(val n: i64, val next: Box<Cell>)

fun churn(count: i64).return: i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < count {
        val c = Cell(n = i, next = Box.of(Cell(n = i + 1, next = Box.empty())))
        total = total + c.n + c.next.get().n
        i = i + 1
    }
    return total
}

fun main() {
    val tag = String.from_str("captured")
    val f = fun(x: i32) {
        val total = churn(2000)
        if total < 0 {
            print("corrupt")
        }
        print(tag)
        print(x)
    }
    print(helper.kelp_call_twice(f, 3))
}
