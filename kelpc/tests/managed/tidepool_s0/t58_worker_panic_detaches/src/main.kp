impl "std/thread"
impl "std/result"
datac Cell(val n: i64, val next: Box<Cell>)

fun churn(count: i64).return: i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < count {
        val c = Cell(n = i, next = Box.of(Cell(n = i + 1, next = Box.empty())))
        total = total + c.n + c.next.get().n
        i = i + 1
    }
    return total
}

// Step 0 (T58, section 18.9): a worker that panics after collections has left
// the collector when it ends, so main's later collections do not wait for it.
fun worker(n: i64) {
    val total = churn(n)
    panic("worker stops")
}

fun main() {
    val t = thread.spawn(worker, 300000)
    when thread.join(t) {
        Ok(_) -> print("ok")
        Err(e) -> print("err")
    }
    print(churn(600000))
}
