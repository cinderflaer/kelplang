// mixed-pool (gc bench 4): a thread pool of four workers runs 2000 jobs. Each job builds a binary
// tree (allocation), builds and splits a string (string descriptors), and adds its checksum to a
// shared atomic. Several threads allocate and reach safepoints at once, so every collection is a
// multi-thread stop-the-world. Prints the total, which must not depend on scheduling.
impl "std/pool"
impl "std/atomic"
impl "std/str"

pd val total: AtomicI64 = AtomicI64.new(0)

datac Node(val left: Box<Node>, val right: Box<Node>)

fun make(d: i32) => Node {
    if d == 0 {
        return Node(left = Box.empty(), right = Box.empty())
    }
    return Node(left = Box.of(make(d - 1)), right = Box.of(make(d - 1)))
}

fun check(n: &Node) => i64 {
    if n.left.is_empty() {
        return 1
    }
    return 1 + check(n.left.get()) + check(n.right.get())
}

fun job(k: i64) => i64 {
    val t = make(12 + (k % 3).to_i32())
    var s = String.empty()
    var i: i64 = 0
    while i < 800 {
        s.push_str("q")
        val num = str.from_i64(i * k)
        s.push_str(num)
        s.push_str(",")
        i = i + 1
    }
    val parts = str.split(s, ",")
    return check(t) + parts.len().to_i64() + k
}

fun add(n: i64) {
    total.fetch_add(value = n, order = atomic.Ordering.SeqCst)
}

fun main() {
    var p = pool.new(4)
    var i: i64 = 0
    while i < 2000 {
        val k = i
        p.spawn(fun() { add(job(k)) })
        i += 1
    }
    p.join()
    print("mixed-pool ${total.load(order = atomic.Ordering.SeqCst)} ${p.panicked()}")
}
