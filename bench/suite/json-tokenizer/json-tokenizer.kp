// json-tokenizer: generate a JSON-style text of at least n bytes (records
// {"id":I,"name":"userJ","tags":["a","b\"c"],"score":K.5,"ok":true,"n":null}, one per line), then
// tokenize it with a byte-at-a-time state machine, counting punctuation, strings, numbers and
// literals and hashing the token stream. Generation is included in the timing, in every language.
// Size = n bytes (default 20000000).
// The Kelp tokenizer reads through a View (O(1) length-aware bounds check): str.byte(s, i) scans i+1
// bytes to prove the index is in range, which makes a byte loop over a long str quadratic.
impl "std/process"
impl "std/str"
impl "std/result"

fun size_arg(default: i64).R: i64 {
    if process.arg_count() < 2 {
        return default
    }
    val args = process.args()
    val r = str.parse_i64(args.get(1).as_str())
    return when r {
        Ok(v) -> v
        Err(e) -> default
    }
}

fun is_digit(c: u8).R: bool = c >= 48 && c <= 57

fun is_num_char(c: u8).R: bool {
    return (c >= 48 && c <= 57) || c == 46 || c == 101 || c == 69 || c == 43 || c == 45
}

fun is_alpha(c: u8).R: bool = c >= 97 && c <= 122

fun main() {
    val target = size_arg(20000000).to_usize()
    var s = String.empty()
    var i: i64 = 0
    while s.len() < target {
        s.push_str("{\"id\":")
        val a = str.from_i64(i)
        s.push_str(a.as_str())
        s.push_str(",\"name\":\"user")
        val b = str.from_i64(i % 1000)
        s.push_str(b.as_str())
        s.push_str("\",\"tags\":[\"a\",\"b\\\"c\"],\"score\":")
        val c = str.from_i64(i % 97)
        s.push_str(c.as_str())
        s.push_str(".5,\"ok\":true,\"n\":null},\n")
        i = i + 1
    }
    val text_len = s.len()
    val t = s.view()
    var punct: i64 = 0
    var strings: i64 = 0
    var numbers: i64 = 0
    var literals: i64 = 0
    var errors: i64 = 0
    var str_bytes: i64 = 0
    var h: u64 = 0
    var p: usize = 0
    while p < text_len {
        val ch = t.get(p)
        if ch == 32 || ch == 10 || ch == 13 || ch == 9 {
            p = p + 1
        } else if ch == 123 || ch == 125 || ch == 91 || ch == 93 || ch == 58 || ch == 44 {
            punct = punct + 1
            h = h * 31 + ch.to_u64()
            p = p + 1
        } else if ch == 34 {
            p = p + 1
            val start = p
            while p < text_len && t.get(p) != 34 {
                if t.get(p) == 92 {
                    p = p + 1
                }
                p = p + 1
            }
            strings = strings + 1
            str_bytes = str_bytes + (p - start).to_i64()
            h = h * 31 + 34
            p = p + 1
        } else if is_digit(ch) || ch == 45 {
            while p < text_len && is_num_char(t.get(p)) {
                p = p + 1
            }
            numbers = numbers + 1
            h = h * 31 + 48
        } else if is_alpha(ch) {
            val start = p
            while p < text_len && is_alpha(t.get(p)) {
                p = p + 1
            }
            literals = literals + 1
            h = h * 31 + (p - start).to_u64()
        } else {
            errors = errors + 1
            p = p + 1
        }
    }
    print("json-tokenizer $target $text_len $punct $strings $str_bytes $numbers $literals $errors $h")
}
