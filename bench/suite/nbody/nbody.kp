// nbody: the Benchmarks Game n-body simulation, 5 bodies. Size = steps (default 5000000).
impl "std/process"
impl "std/str"
impl "std/result"
impl "std/math"

const PI: f64 = 3.141592653589793
const SOLAR_MASS: f64 = 4.0 * PI * PI
const DAYS: f64 = 365.24

fun size_arg(default: i64) => i64 {
    if process.arg_count() < 2 {
        return default
    }
    val args = process.args()
    val r = str.parse_i64(args.get(1).as_str())
    return when r {
        Ok(v) -> v
        Err(e) -> default
    }
}

datac Body(val x: f64, val y: f64, val z: f64, val vx: f64, val vy: f64, val vz: f64, val mass: f64)

fun initial() => [Body; 5] {
    var b: [Body; 5] = [Body(x = 0.0, y = 0.0, z = 0.0, vx = 0.0, vy = 0.0, vz = 0.0, mass = 0.0); 5]
    b.set(0, Body(x = 0.0, y = 0.0, z = 0.0, vx = 0.0, vy = 0.0, vz = 0.0, mass = SOLAR_MASS))
    b.set(1, Body(x = 4.84143144246472090, y = -1.16032004402742839, z = -0.103622044471123109,
            vx = 0.00166007664274403694 * DAYS, vy = 0.00769901118419740425 * DAYS,
            vz = -0.0000690460016972063023 * DAYS, mass = 0.000954791938424326609 * SOLAR_MASS))
    b.set(2, Body(x = 8.34336671824457987, y = 4.12479856412430479, z = -0.403523417114321381,
            vx = -0.00276742510726862411 * DAYS, vy = 0.00499852801234917238 * DAYS,
            vz = 0.0000230417297573763929 * DAYS, mass = 0.000285885980666130812 * SOLAR_MASS))
    b.set(3, Body(x = 12.8943695621391310, y = -15.1111514016986312, z = -0.223307578892655734,
            vx = 0.00296460137564761618 * DAYS, vy = 0.00237847173959480950 * DAYS,
            vz = -0.0000296589568540237556 * DAYS, mass = 0.0000436624404335156298 * SOLAR_MASS))
    b.set(4, Body(x = 15.3796971148509165, y = -25.9193146099879641, z = 0.179258772950371181,
            vx = 0.00268067772490389322 * DAYS, vy = 0.00162824170038242295 * DAYS,
            vz = -0.0000951592254519715870 * DAYS, mass = 0.0000515138902046611451 * SOLAR_MASS))
    return b
}

fun offset_momentum(b: mut [Body; 5]) {
    var px: f64 = 0.0
    var py: f64 = 0.0
    var pz: f64 = 0.0
    var i: int = 0
    while i < 5 {
        val bi = b.get(i)
        px = px + bi.vx * bi.mass
        py = py + bi.vy * bi.mass
        pz = pz + bi.vz * bi.mass
        i = i + 1
    }
    val s = b.get(0)
    b.set(0, Body(x = s.x, y = s.y, z = s.z, vx = 0.0 - px / SOLAR_MASS, vy = 0.0 - py / SOLAR_MASS,
        vz = 0.0 - pz / SOLAR_MASS, mass = s.mass))
}

fun advance(b: mut [Body; 5], dt: f64) {
    var i: int = 0
    while i < 5 {
        var j: int = i + 1
        while j < 5 {
            val bi = b.get(i)
            val bj = b.get(j)
            val dx = bi.x - bj.x
            val dy = bi.y - bj.y
            val dz = bi.z - bj.z
            val d2 = dx * dx + dy * dy + dz * dz
            val mag = dt / (d2 * math.sqrt(d2))
            b.set(i, Body(x = bi.x, y = bi.y, z = bi.z, vx = bi.vx - dx * bj.mass * mag,
                vy = bi.vy - dy * bj.mass * mag, vz = bi.vz - dz * bj.mass * mag, mass = bi.mass))
            b.set(j, Body(x = bj.x, y = bj.y, z = bj.z, vx = bj.vx + dx * bi.mass * mag,
                vy = bj.vy + dy * bi.mass * mag, vz = bj.vz + dz * bi.mass * mag, mass = bj.mass))
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < 5 {
        val bi = b.get(i)
        b.set(i, Body(x = bi.x + dt * bi.vx, y = bi.y + dt * bi.vy, z = bi.z + dt * bi.vz,
            vx = bi.vx, vy = bi.vy, vz = bi.vz, mass = bi.mass))
        i = i + 1
    }
}

fun energy(b: &[Body; 5]) => f64 {
    var e: f64 = 0.0
    var i: int = 0
    while i < 5 {
        val bi = b.get(i)
        e = e + 0.5 * bi.mass * (bi.vx * bi.vx + bi.vy * bi.vy + bi.vz * bi.vz)
        var j: int = i + 1
        while j < 5 {
            val bj = b.get(j)
            val dx = bi.x - bj.x
            val dy = bi.y - bj.y
            val dz = bi.z - bj.z
            e = e - bi.mass * bj.mass / math.sqrt(dx * dx + dy * dy + dz * dz)
            j = j + 1
        }
        i = i + 1
    }
    return e
}

fun main() {
    val steps = size_arg(5000000)
    var bodies = initial()
    offset_momentum(bodies)
    val e0 = str.from_f64(energy(bodies), 9)
    var s: i64 = 0
    while s < steps {
        advance(bodies, 0.01)
        s = s + 1
    }
    val e1 = str.from_f64(energy(bodies), 9)
    print("nbody $steps $e0 $e1")
}
