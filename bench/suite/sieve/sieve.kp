// sieve: sieve of Eratosthenes over a byte-per-number table; prints the prime count.
// Size = limit (default 50000000).
impl "std/process"
impl "std/str"
impl "std/result"
impl "std/mem"

fun size_arg(default: i64) => i64 {
    if process.arg_count() < 2 {
        return default
    }
    val args = process.args()
    val r = str.parse_i64(args.get(1).as_str())
    return when r {
        Ok(v) -> v
        Err(e) -> default
    }
}

fun main() {
    val n = size_arg(50000000)
    val len = (n + 1).to_int()
    var composite = mem.alloc(len)
    var i: i64 = 2
    while i * i <= n {
        if composite.get(i.to_int()) == 0 {
            var j: i64 = i * i
            while j <= n {
                composite.set(j.to_int(), 1)
                j = j + i
            }
        }
        i = i + 1
    }
    var count: i64 = 0
    i = 2
    while i <= n {
        if composite.get(i.to_int()) == 0 {
            count = count + 1
        }
        i = i + 1
    }
    print("sieve $n $count")
}
